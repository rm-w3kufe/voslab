#!/usr/bin/env bash
# vsctl — epistemic CLI (EPISTEMIC-CERT-001, EP-2/EP-3).
# Usage:
#   vsctl route <claim.json|claim-id>   route one claim through claim-gate
#   vsctl route --all                   route every claim in the store
#   vsctl decide --question Q --alternatives a,b --impact I [--approved]
#   vsctl learn-round [--dry-run]       R5 round close: emit learn events (M1)
#   vsctl manifest declare <paths...>    EP-4 D1: declare artifact digests
#   vsctl manifest observe [paths...]    EP-4 D1: verify digests (rc1=drift)
#   vsctl workspace declare <root> --id ID --kind K [--note N]
#   vsctl workspace list / check <path>  EP-4 D2: declared external workspaces
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export PYTHONPATH="$ROOT/packages/framework${PYTHONPATH:+:$PYTHONPATH}"
case "${1:-}" in
  learn-round|learn)
    shift
    exec python3 -m vos_kernel.learn_emitter "$@"
    ;;
  manifest)
    shift
    exec python3 -m vos_kernel.delivery "$@"
    ;;
  workspace)
    shift
    exec python3 -m vos_kernel.workspaces "$@"
    ;;
  *)
    exec python3 -m vos_kernel.router "$@"
    ;;
esac
