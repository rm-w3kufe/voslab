[Unit]
Description=VSF S5 CA Monitor — root key expiry + witness chain health (A1c)
Documentation=ref://TASK_INDEX.vsm task(A1c)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/s5_ca_monitor.py
StandardOutput=journal
StandardError=journal
Environment="S5_CA_CONFIG=/etc/vsf/s5_ca.json"
Environment="NATS_HOST=10.10.20.20"
Environment="NATS_PORT=4222"
Environment="VSF_ID=alpha"

# Thresholds
Environment="THRESHOLD_YELLOW=180"
Environment="THRESHOLD_ORANGE=90"
Environment="THRESHOLD_RED=30"

# Sandboxing
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
