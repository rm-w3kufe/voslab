[Unit]
Description=VSF BBS Decisions Bridge — S4 thoughts → φ↓ actions (whitelist-gated)
Documentation=file:///root/vsf/docs/WRITER_READER_DECIDER_MATRIX.md
After=network-online.target vsf-s5-algedonic.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/bbs_decisions_bridge.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

Environment="NATS_HOST=10.10.20.20"
Environment="NATS_PORT=4222"
Environment="VSF_ID=alpha"
Environment="BBS_BRIDGE_LOG=/root/algedonic/bbs_bridge.jsonl"

NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/root/algedonic

MemoryMax=64M
CPUQuota=5%
TasksMax=8

[Install]
WantedBy=multi-user.target
