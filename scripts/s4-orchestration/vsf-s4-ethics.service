[Unit]
Description=VSF S4/EV — Ethics Vigilance (A0 watchdog + Qwen advisory)
After=network.target vsf-nucleus-operational.service
Wants=vsf-nucleus-operational.service

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStart=/usr/bin/python3 /root/vsf-scripts/A0_classifier.py \
    --events /run/vsf/vsf_nucleus/events.jsonl \
    --signal-out /run/vsf/ethics_signal.json \
    --signal-out-s4 /run/vsf/s4_intelligence.json \
    --cycle-s 300
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vsf-s4-ethics
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
