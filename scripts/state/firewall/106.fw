[OPTIONS]
enable: 1
policy_in: DROP

[RULES]
IN ACCEPT -source 10.10.20.10/32 -p tcp -dport 4222 -log nolog # NATS: 101 s3s4-nucleus (phi-up publisher + phi-down subscriber + AC)
IN ACCEPT -source 10.10.20.104/32 -p tcp -dport 4222 -log nolog # NATS: 104 s5-policy (algedonic subscriber + g6 sink + bbs-bridge)
IN ACCEPT -source 10.10.30.110/32 -p tcp -dport 4222 -log nolog # NATS: 105 s1-bbh (R6-gated; pre-authorized per C2.e plan)
IN ACCEPT -source 10.10.20.30/32 -p tcp -dport 4222 -log nolog # NATS: 107 s3star-audit (kpi exceptions publisher)
IN ACCEPT -source 10.10.20.108/32 -p tcp -dport 4222 -log nolog # NATS: 108 dev-sandbox (tests)
IN ACCEPT -source 10.10.20.109/32 -p tcp -dport 4222 -log nolog # NATS: 109 s5-opsroom (view modules)
IN ACCEPT -source 10.10.20.1/32 -p tcp -dport 4222 -log nolog # NATS: n02 host (vsf-tunnels + service_watchdog)
IN ACCEPT -source 10.10.20.1/32 -p tcp -dport 8222 -log nolog # NATS monitoring: host/tunnel only
IN ACCEPT -source 10.10.20.10/32 -p tcp -dport 8600 -log nolog # bbs-api: 101 s3s4-nucleus
IN ACCEPT -source 10.10.20.104/32 -p tcp -dport 8600 -log nolog # bbs-api: 104 s5-policy (bbs-bridge)
IN ACCEPT -source 10.10.20.1/32 -p tcp -dport 8600 -log nolog # bbs-api: n02 host (watchdog poll)
IN ACCEPT -source 192.168.0.0/24 -p tcp -dport 22 -log nolog # SSH mgmt LAN only (A4: no sibling SSH; recovery = pct exec)
IN ACCEPT -source 10.10.20.112/32 -p tcp -dport 4222 -log nolog # NATS: 112 s1-clima (φ↑ publisher)
IN ACCEPT -source 10.10.20.113/32 -p tcp -dport 4222 -log nolog # NATS: 113 s1-econ (φ↑ publisher — EXP-LL-01)
IN ACCEPT -source 10.10.20.30/32 -p tcp -dport 8222 -log nolog # NATS monitoring: 107 s3star-audit (broker_probe tier2)
IN ACCEPT -source 10.10.20.1/32 -p icmp -log nolog # ICMP diagnostics from host
