[Unit]
# Standalone host power alarm. Deliberately NOT part of the cybernetic loop —
# same pattern as vsf-thermal-watchdog. AC loss -> battery drain -> total host
# death is a hard BINARY failure with a real countdown. If AC disconnects with
# nobody watching, ALL ~15 LXCs go down together with zero warning.
Description=VSF battery watchdog (host-level power alarm, not an Ω input)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/vsf-battery-watchdog.py
