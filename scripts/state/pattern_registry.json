{
  "//": "pattern_registry.json — PATTERN-RUNNER-v1 (design: docs/spec_revision/design-sources/pattern-runner-v1/pattern_runner.vsm). Policy declares, instrument interprets (R16): adding a trigger = editing THIS file, never pattern-runner.ts. Fields: id, on (event), match[] (AND, deterministic R10), run (repo-relative), args, timeout_ms, driver (Sn owner), consent (read-only|advisory|needs-nod; needs-nod = R17 refusal without S5 nod), desc. Doctrine C (deploy/firewall/publishing/LLM) stays OUT by design.",
  "version": 1,
  "rules": [
    {
      "id": "version-scan",
      "on": "session.idle",
      "match": [],
      "run": "scripts/vsl/tools/version_scan.py",
      "args": [],
      "timeout_ms": 15000,
      "driver": "S3",
      "consent": "read-only",
      "desc": "Scan corpus for @vsm version coherence"
    },
    {
      "id": "debt-register",
      "on": "session.idle",
      "match": [],
      "run": "scripts/vsl/tools/debt_register.py",
      "args": ["--json"],
      "timeout_ms": 10000,
      "driver": "S3",
      "consent": "read-only",
      "desc": "Scan corpus for debt markers"
    },
    {
      "id": "dep-graph",
      "on": "session.idle",
      "match": [],
      "run": "scripts/vsl/tools/dep_graph.py",
      "args": ["--cycles"],
      "timeout_ms": 10000,
      "driver": "S3",
      "consent": "read-only",
      "desc": "Check for dependency cycles"
    },
    {
      "id": "vsm-logic",
      "on": "session.idle",
      "match": [],
      "run": "scripts/vsl/tools/vsm_logic.py",
      "args": [],
      "timeout_ms": 10000,
      "driver": "S3",
      "consent": "read-only",
      "desc": "Verify VSM structural logic"
    },
    {
      "id": "manifest-canon",
      "on": "session.idle",
      "match": [],
      "run": "scripts/vsl/tools/manifest_canon.py",
      "args": ["check"],
      "timeout_ms": 10000,
      "driver": "S3",
      "consent": "read-only",
      "desc": "Verify boot manifest canon"
    }
  ]
}
