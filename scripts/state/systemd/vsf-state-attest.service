[Unit]
Description=VSF AX-STATE host attester (PROD-A1a — tamper-evident state.db: deploys + coupling_registry)
After=network.target

[Service]
Type=oneshot
# One verify+attest+emit pass. ALWAYS exits 0 — a tamper finding is emitted algedonically (DEGRADE,
# never halt — correction C5); the agent's own failure must not self-DoS via a failed unit.
ExecStart=/usr/bin/python3 /usr/local/bin/vsf-state-attest --agent
SuccessExitStatus=0
