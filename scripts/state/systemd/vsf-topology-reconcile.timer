[Unit]
Description=Run VSF S3* topology reconcile every 5 min (periodic census → algedonic on anomaly)

[Timer]
# Periodic census is the antidote to silent accumulation (FIND-NUC-ORPHANS learning l3):
# a new orphan is now caught within ~5 min of appearing, not after 9 days.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
