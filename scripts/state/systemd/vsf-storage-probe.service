[Unit]
Description=VSF Storage Probe — check LVM data_percent thresholds
Documentation=file:///root/vsf/docs/plan/MASTER_PLAN.vsm#ALGEDONIC-STORAGE-BLINDSPOT
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vsf-storage-probe.sh
StandardOutput=journal
StandardError=journal
