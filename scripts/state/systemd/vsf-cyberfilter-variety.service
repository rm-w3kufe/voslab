[Unit]
Description=VSF F3.d — Cyberfilter variety accounting (Ashby attenuation ratio → state.db)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/vsf-cyberfilter-variety.py
# Non-zero exit = WARN-level attenuation anomaly (healthy signalling), not a unit failure
SuccessExitStatus=0 1
