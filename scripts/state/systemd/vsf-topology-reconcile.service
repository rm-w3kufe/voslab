[Unit]
# S3* topology audit — bidirectional model≡reality census (anti-orphan + flap detection).
# The reverse-direction complement to G-D.4 (vsf-state-populate, which is declared→running only).
# Born from FIND-NUC-ORPHANS (2026-06-03): a 9-day orphan nucleus undetected because no audit
# checked running→declared. Emits algedonics to the operator inbox on HARD anomalies.
Description=VSF S3* topology reconcile (model≡reality census, anti-orphan)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/vsf-topology-reconcile.py --emit
# Read-only census + best-effort algedonic emit; never blocks. Non-zero exit = anomalies found
# (expected/healthy signalling), so do not treat exit-1 as a unit failure.
SuccessExitStatus=0 1
