# design: docs/design/sources/driver-topology-v1/driver_topology.vsm
# (G5-reading: read-only host health consumers — throttle, PSI, memory, OOM, disk)
# route: monitoring_runners.vsm §flota — familia de timers vsf (T7-F2: el manifest registra cada unit)
# verify: check systemd-units-fresh (T1-F2) + smoke systemctl start en su env real (checklist T4-F2 del plan)
[Unit]
Description=VSF Syshealth Watch — read-only host health consumers
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vsf_syshealth_watch.py
User=root
StandardOutput=journal
StandardError=journal
