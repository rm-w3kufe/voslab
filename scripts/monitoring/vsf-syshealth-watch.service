# (G5-reading: read-only host health consumers — throttle, PSI, memory, OOM, disk)
[Unit]
Description=VSF Syshealth Watch — read-only host health consumers
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vsf_syshealth_watch.py
User=root
StandardOutput=journal
StandardError=journal
