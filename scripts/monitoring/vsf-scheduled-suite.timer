# design: docs/design/sources/shadow-scheduled-suite-design.vsm
# route: monitoring_runners.vsm §flota — familia de timers vsf (T7-F2: el manifest registra cada unit)
# verify: check systemd-units-fresh (T1-F2) + smoke systemctl start en su env real (checklist T4-F2 del plan)
[Unit]
Description=Run VSF scheduled suite hourly at :17 (gates+census+external)
[Timer]
OnCalendar=*-*-* *:17:00
Persistent=true
[Install]
WantedBy=timers.target
