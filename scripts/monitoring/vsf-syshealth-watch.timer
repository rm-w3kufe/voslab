# design: docs/spec_revision/design-sources/driver-topology-v1/driver_topology.vsm
# (G5-reading: 5 min cadence matches watchdog; PSI/throttle windows need it)
# route: monitoring_runners.vsm §flota — familia de timers vsf (T7-F2: el manifest registra cada unit)
# verify: check systemd-units-fresh (T1-F2) + smoke systemctl start en su env real (checklist T4-F2 del plan)
[Unit]
Description=Run VSF Syshealth Watch every 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target
