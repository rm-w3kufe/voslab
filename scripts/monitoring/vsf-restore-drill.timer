[Unit]
Description=Run VSF restore drill weekly Sunday 05:00 local (1h after gates-weekly)

[Timer]
# Bare datetime = LOCAL time (systemd rule) — same convention as
# vsf-gates-weekly (Sun 04:00 local). Keeps the "after weekly" ordering.
OnCalendar=Sun *-*-* 05:00:00
Persistent=true

[Install]
WantedBy=timers.target
