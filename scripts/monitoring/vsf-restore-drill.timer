# design: docs/spec_revision/design-sources/monitoring_runners.vsm
# route: monitoring_runners.vsm §flota — familia de timers vsf (T7-F2: el manifest registra cada unit)
# verify: check systemd-units-fresh (T1-F2) + smoke systemctl start en su env real (checklist T4-F2 del plan)
[Unit]
Description=Run VSF restore drill weekly Sunday 05:00 local (1h after gates-weekly)

[Timer]
# Bare datetime = LOCAL time (systemd rule) — same convention as
# vsf-gates-weekly (Sun 04:00 local). Keeps the "after weekly" ordering.
OnCalendar=Sun *-*-* 05:00:00
Persistent=true

[Install]
WantedBy=timers.target
