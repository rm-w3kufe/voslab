[Unit]
Description=VSF Diverse Verifier — second-opinion Merkle chain check (daily deep verify)
Documentation=docs/spec/self_audit/diverse_verifier.spec.vsm
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vsf-diverse-verify.sh
User=root
Group=root
# Always exits 0 — findings travel via algedonic, not systemd failure
# But we still allow systemd to track execution failure for shell/JQ errors
Restart=no
StandardOutput=journal
StandardError=journal
