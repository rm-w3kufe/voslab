[Unit]
Description=VSF Diverse Verifier — daily 04:30 UTC deep chain check
Documentation=docs/spec/self_audit/diverse_verifier.spec.vsm

[Timer]
# 04:30 UTC — offset from topology-reconcile (5min cadence);
# this is a deep check, not a heartbeat.
OnCalendar=*-*-* 04:30:00
Persistent=true

[Install]
WantedBy=timers.target
