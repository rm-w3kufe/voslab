[Unit]
Description=VSF Network Housekeeping — dead service/tunnel audit (n02 host, report-only)
Documentation=file:/usr/local/bin/vsf-net-housekeeping
After=network-online.target

[Service]
Type=oneshot
# n02 is REPORT-ONLY per operator decision 2026-05-31 — no --apply here.
# --scope=local audits the host this runs on (Proxmox host listeners + tunnels).
ExecStart=/usr/local/bin/vsf-net-housekeeping --scope=local
StandardOutput=append:/var/log/vsf-net-housekeeping.log
StandardError=append:/var/log/vsf-net-housekeeping.log
