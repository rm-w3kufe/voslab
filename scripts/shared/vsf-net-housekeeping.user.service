[Unit]
Description=VSF Network Housekeeping — local audit + safe auto-clean (WSL)
Documentation=file:%h/vsf/scripts/net-housekeeping/README.md

[Service]
Type=oneshot
# Local WSL: full audit + SAFE auto-clean (--apply); n02 side reported (read-only).
ExecStart=%h/vsf/scripts/net-housekeeping/vsf-net-housekeeping.sh --scope=all --apply
StandardOutput=append:%h/.local/state/vsf/net-housekeeping.log
StandardError=append:%h/.local/state/vsf/net-housekeeping.log
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/vsf
