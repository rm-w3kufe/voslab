[Unit]
Description=VSF Beacon — Ed25519-attested registration (beacon_activation.spec.vsm)
Documentation=https://vsf.u2738.org/wiki/
After=network.target

[Service]
User=vsf
WorkingDirectory=/opt/vsf-beacon
ExecStart=/opt/vsf-beacon/venv/bin/uvicorn vsf_beacon_main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=CA_PUBKEY_PATH=/opt/vsf-beacon/ca.pubkey.hex
Environment=REGISTRY_PATH=/opt/vsf-beacon/registry.jsonl
Environment=COVENANT_PATH=/opt/vsf-beacon/covenant.vsm

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
