# PERIPHERAL-HEALTH-CENSUS (2026-07-03) — continuous end-to-end health probe.
# Runs on n02 host (the monitoring node), probes n01 peripherals from outside.
# Pattern: vsf-topology-reconcile (oneshot, exits cleanly, non-zero = anomalies found).
[Unit]
Description=VSF peripheral health probe (end-to-end liveness + algedonic)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/vsf-peripheral-health.py
# Non-zero exit = anomalies found (expected/healthy signalling)
SuccessExitStatus=0 1
