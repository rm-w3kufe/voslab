// ── SFT RESOURCE OPTIMIZATION (Kaggle weekly quota) ────────────────────
sft_plan = {
  method: "LoRA r=16 alpha=32 on attn q/k/v/o, bf16, seq_len 768,
           lr 1e-4 cosine, warmup 3%%, 2 epochs, early-stop on held-out",
  dataset: {
    source: "1000 competition training + D4 synthetic augment
             (flip_h/v, rot90/180/270, transpose — deterministic seeds)",
    format: "chat messages (user=grid prompt, assistant=output grid text)",
    split: "BY TASK hash 80/20 (no pair-level leakage)",
    builder: "agi2/sft_prepare.py — runs on LXC 114 (CPU) AND in-kernel",
    size_target: "~100-200k examples, ~20-40M tokens",
  },
  budget: {
    est_per_iter: "3-5h GPU on L4 (LoRA 4B, packing, max_len 768)",
    quota_reserve: "validation 1-2h + SFT it1 ~5h + eval 1h + SFT it2 ~5h
                    => ~13-18h of ~60-90h available before 2026-11-02",
    gates: "adapter ships ONLY if held-out p@1 beats zero-shot by >= 2pp",
    artifact: "peft adapter ~100-200MB -> Kaggle dataset -> peft load at infer",
  },
  fallbacks: ["Qwen3-1.7B SFT (half time) if 4B quota starved",
