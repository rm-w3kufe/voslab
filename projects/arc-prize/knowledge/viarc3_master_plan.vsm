@vsm 1.2.1
@status active

// ViArc-3 MASTER PLAN — AGI-3 track built ON the AGI-2 base, optimized
// for interactive reasoning. S5 order 2026-10-17: go parallel with AGI-2
// (same final deadline 2026-11-02, entry 2026-10-26). Study canonical:
// knowledge/arc_agi3_study.vsm. Identity (ratified): ViArc-3 =
// interactive homeostat — act -> observe -> re-plan, algedonic + S4.

task("VIARC3-MASTER-PLAN") = {
  status: active,
  decision_by: "rmw3/S5",
  decided_at: "2026-10-17",
  parallel_with: "AGI-2 ViArc-2 track (same machine, separate kernels)",
}

// ── CROSSOVER: AGI-2 base -> AGI-3 use ─────────────────────────────────
reuse = {
  reuse_direct: [
    "covenant.py runtime — domain-agnostic budget/algedonic/gates;
     decide_budget now runs PER LEVEL (action budget 5x human median);
     algedonic signals = wasted-action pressure (RHAE^2 is unforgiving)",
    "VSM runtime wiring (solve.py runtime_state pattern) — homeostat
     loop IS decide->act->observe->re-decide; S5 identity lands whole",
    "RSI tool pipeline (propose_tool_code + sandbox + LOO certify +
     pattern memory write-back) — AGI-3 counts internal ops as FREE,
     so generated analysis tools are pure upside (Duke pattern: python
     history retrieval); certify gate = tool generalizes ACROSS episodes",
    "checks.py 6-gate harness — rebody gates (world-model retrodiction
     pass, action-budget respect, no-deadline-blow, license-clean…)",
    "build_notebook.py MODULES embedding + RUN_CELL gates — same kernel
     build pattern, new modules",
    "Kaggle infra: staging datasets, kernel-metadata, CLI, submission
     flow — identical machinery, new competition slug",
    "tests harness (32 NC pattern) + bench harness structure — new
     bench = arc-agi play-local scorecards over 25 publics",
  ],
  reuse_adapt: [
    "llm_harness prompts — certify V1/V2 rewritten: mechanic inference
     from observed transition history (few-shot examples = action/frame
     traces, not I/O grids); ensemble_decide over ACTION candidates",
    "frame serializer — 64x64x16 grids do NOT fit context naively;
     build COMPRESSION layer (diff-frames, region abstraction, run-length
     or object-list encoding) — context compression is THE documented
     bottleneck (Duke/Arcgentica/Kepler)",
    "covenant thresholds — certify >=0.5 (static pairs) becomes
     retrodiction accuracy >= threshold on held-out transitions;
     LOO <=2/task becomes cross-episode tool validity",
    "pattern memory — from grid-transform rules to MECHANIC facts per
     game (objects, actions effects, win-condition hypotheses), with
     cross-game prior seeding (composition priors)",
  ],
  not_reuse: [
    "symbolic transform stack (static-puzzle world; no analogue)",
    "grid ensemble of rotations/fills (wrong domain)",
    "AGI-2 SFT dataset (format transfers, data does not — D4-aug idea
     may later generate lookalike ENV trajectories, careful: domain
     overfitting is explicitly fought by the official leaderboard)",
    "certify V1/V2 prompt text (rewritten from scratch)",
  ],
}

// ── ARCHITECTURE: homeostat over the game loop ────────────────────────
architecture = {
  loop: "perceive (compressed frame diff) -> world-model hypotheses ->
         goal-infer (win-condition candidates) -> plan -> act; every
         observation retro-validates models (S3 certifier)",
  s1_operators: [
    "perception: frame diff + object extraction (persistent entities)",
    "model: executable hypothesis objects (predict next frame given
     action; Kepler-style transition checks keep only survivors)",
    "goal-infer: rank win-condition hypotheses from terminal frames +
     scorecard signals; tutorial level (L1) is the orientation cue",
    "planner: short action sequences toward best hypothesis; undo
     (ACTION7) as cheap exploration rollback",
  ],
  s2_coordination: "orchestrator + specialist subagents returning
    COMPRESSED summaries (Arcgentica) + python-retrieval history tools
    (Duke) — bounded context by design",
  s3_control: "world-model certifier (retrodiction on observed
    transitions) + covenant action budget per level + algedonic
    wasted-action alarms (reset when hypothesis thrash detected)",
  s4_intelligence: "per-game mechanic memory (write-back via RSI) +
    cross-game prior library (25 publics => composition priors) +
    S4 recursion: at each level, re-rank all priors against new frames",
  s5_policy: "intrinsic drive = complete all levels with minimal actions
    (RHAE); identity doc = this plan; hard rules: no domain-specific
    hacks targeting specific public games (official-board spirit)",
  rsi: "tool proposer generates analysis tools (history queries, frame
    diffs, object trackers); sandbox+certify by cross-episode validity;
    memory write-back per game",
}

// ── HARDWARE / MODELS (shared with AGI-2 ladder) ──────────────────────
compute = {
  dev_loop: "WSL (Python 3.14 + uv) — arc-agi local engine, seconds/game;
             LXC 114 NOT usable (3.11 < 3.12 requirement)",
  kaggle: "starter default T4 (x2); cpu for LLM-less ablations;
           rtx6000 ONLY if final-window push (exclusive, quota-hungry)",
  models: "same ladder: Qwen2.5-3B staged -> Qwen3-4B + Coder-3B (upload
           in flight) for mechanic-inference + tool coding; no API models
           (internet OFF on eval)",
}

// ── TIMELINE (parallel with AGI-2 windows) ────────────────────────────
timeline = {
  "2026-10-17..18": "M0 bootstrap: uv venv + arc-agi, fork Kaggle Starter
      into projects/arc-prize/agi3/, API key (anon ok for publics),
