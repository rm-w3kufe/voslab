  "2026-11-02":   "FINAL SUBMISSION both tracks (11:59 PM UTC)",
}

// ── GATES (deterministic, R10) ─────────────────────────────────────────
gates = {
  m0: "play-local runs >=1 real game end-to-end (any score); repo cloned
       + venv green; frame serializer produces compressed repr",
  m1: "homeostat completes tutorial levels on 3 publics; scorecard
       harness covers 25 publics deterministically",
  m2: "retrodiction certifier rejects corrupted hypotheses (NC test);
       mechanic memory persists across episodes of same game",
  m3: "Kaggle smoke: notebook runs Phase A (Save&Run) green on cpu/t4",
  entry: "rules accepted in UI before 2026-10-26 (S5 action)",
  final: "open-source repo (MIT-0/CC0) published before private eval
          score receipt (competition requirement)",
}

// ── RISKS ──────────────────────────────────────────────────────────────
risks = [
  "focus split AGI-2/AGI-3 in final week — mitigated: CPU dev vs GPU
    AGI-2 windows do not contend; separate kernels/slugs",
  "public set saturated by specialist solvers (schema-routed agents hit
    100% on 3 publics) but hidden eval is OOD — generalist homeostat +
    RSI is the bet; specialists may plateau on private",
  "context compression quality is the ceiling — if frames still blow
