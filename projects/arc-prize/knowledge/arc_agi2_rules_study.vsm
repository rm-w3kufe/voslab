limits("AGI-2-CODE") = {
  hardware:          "4x L4 (L4x4, 24GB each); L4 quota 2x; L4 internet OFF only",
  runtime:           "<= 12h CPU and GPU notebooks (times obfuscated)",
  internet:          "disabled during evaluation (no API models)",
  external_data:     "freely + publicly available ALLOWED incl. pre-trained models",
  submission_file:   "submission.json",
  scoring:           "exact-match, 2 attempts per test output",
  submissions:       "1 per day; up to 2 Final Submissions for judging",
}

rules("AGI-2-BUSINESS") = {
  entry_deadline:    "2026-10-26 (also team merge)",
  final_deadline:    "2026-11-02; results 2026-12-04",
  prizes:            "Progress $275k + Grand $275k + Bonus $150k (>=85%)",
  open_source:       "CC0/MIT-0 for own code before private eval scores",
  third_party:       ">= permissive OS license (Apache-2.0, GPLv3, ...)",
  no_apis:           "guaranteed by no-internet eval",
}

evidence("LEADERBOARD-PUBLIC-2026-10-16") = {
  top_public:        "qwen3_4b_grids15_sft139: 33.89 (fine-tuned Qwen3-4B on grid serialization)",
  others:            "Qwen3-8b: 29.31; qwen3.4b v02: 29.86; gpt-oss-20b: 2.92",
  conclusion:        "dominant approach = small Qwen SFT'd on grids; S5 hypothesis confirmed by the board itself",
}

opportunities("LLM+HARNESS") = {
  m1: "harness LOO-certify + Qwen zero-shot (days): grid<->text serialize, K samples/puzzle, our verify_loo_fraction picks the certified candidate; attempt_2 = 2nd family. No training. Est ~15-20%.",
  m2: "own SFT of Qwen3-1.7B/4B on grids + synthetic augment (D4+palette over 1000 training), trained on Kaggle GPU notebook (quota, not daily). Stacks under m1 certify. Est ~25-35%.",
  m3: "test-time-training per-puzzle (LoRA adapt at inference, NVARC-2025 pattern). Weeks, highest ceiling, most schedule risk.",
  constraint: "no local GPU (WSL CPU-only) — real LLM iterations run as Kaggle GPU kernels (free dev quota; only daily.sh submits burn the 1/day).",
}
