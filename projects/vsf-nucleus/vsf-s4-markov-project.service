[Unit]
Description=VSF S4 Markov Projection — ITEM_17.1 τ(t+n) excursion probability
After=network.target vsf-bbh-s1-clima.service
Wants=vsf-bbh-s1-clima.service

[Service]
Type=simple
WorkingDirectory=/opt/vsf-clima
EnvironmentFile=/etc/default/vsf-clima
ExecStart=/opt/vsf-clima/bin/python /usr/local/bin/markov_project.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vsf-s4-markov-project
MemoryMax=128M
CPUQuota=10%
TasksMax=8

[Install]
WantedBy=multi-user.target
