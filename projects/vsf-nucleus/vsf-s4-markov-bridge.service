[Unit]
Description=VSF S4 Markov Bridge — ITEM_17.2 projection → nucleus context file
After=network.target vsf-nucleus-operational.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/s4_markov_bridge.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vsf-s4-markov-bridge
MemoryMax=64M
CPUQuota=5%
TasksMax=8

[Install]
WantedBy=multi-user.target
