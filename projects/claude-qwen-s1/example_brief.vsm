@vsm 1.0
// Example VSL Brief — S2 Coordination Protocol
// design: projects/claude-qwen-s1/vsl_brief_spec.vsm
// domain_context: {target=vsf, env=VSF-session, layer=S2}
// Purpose: working example brief — task: summarise a file in ~/vsf/docs/

brief(example_summarise):
  title:  "Summarise docs/concepts.md for external audience"
  input: {
    file: "docs/concepts.md"
    audience: "technical reader unfamiliar with VSM/Cybersyn"
  }
  output_format: {
    summary: "≤200 words — what VSF is and why it matters"
    key_concepts: "bulleted list of S1-S5 definitions (1 line each)"
    cybersyn_patterns: "one-paragraph mapping of Cybernet→CHECO→Opsroom"
  }
  constraints: [
    "read-only — do NOT edit docs/concepts.md",
    "English only",
    "no new files — output is JSON response only",
    "do not reference internal session notes or HANDOFF files",
  ]
  flag_if: [
    "docs/concepts.md not found — file path may have changed",
    "file exceeds 500 lines — scope too large for summarisation brief",
  ]
  context: "This summary will be used for the public landing page at vsf.u2738.org/wiki/"
  success_criteria: "summary ≤200 words, all 5 S-levels defined, Cybersyn patterns mapped"

⟦ example_summarise | VSL-BRIEF-02 | vsm-1.0 | 2026-05-05 ⟧
