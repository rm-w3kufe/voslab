  },
  {
    "id": "SRC-PARAMETER-REGISTRY-6f54c9c2-C060",
    "type": "theorem",
    "subject": "docs/reference/parameter_registry.vsm",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "Three artifacts (decision, tool args, check constants) that must move in lockstep -- the check red is the only thing that has noticed so far.\" },",
    "text_hash": "152b32a2b53d8d2726b2ee2161a78ef479ff281876e60ddb1a5e7717128b21a4",
    "provenance": "claim_ingest deterministic:quantifier",
    "method": "deterministic",
