    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "A viable system, by Beer's definition, must respond to environmental",
    "text_hash": "6a003ce6fa7877e7439436e15a3aa48f05ac825f3aa55d2159d74207d2f7be77",
    "provenance": "claim_ingest deterministic:quantifier",
