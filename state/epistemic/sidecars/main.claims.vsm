    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "\\S\\ref{sec:closure}) demonstrates all five layers engaging together, but as a",
    "text_hash": "e4dfae9c874ee94e28c7d472d69d1e6cd1d235d676598cc162c2412ac56bd4e7",
