    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "actually-measured state and cannot be fabricated.",
    "text_hash": "7e5c893d835534c30ca62b79b6a3f5d6cc3e33623ca5263103288420d7e1df36",
    "provenance": "claim_ingest deterministic:quantifier",
