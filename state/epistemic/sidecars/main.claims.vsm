  {
    "id": "SRC-MAIN-7848849e-C248",
    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "VSM realisation & simulated in one process & none structural --- adopts the logic & the most literal: S1 = tools, S2 = protocol/harness, S3 = control loop, S3* = reconcilers, S4 = LM + memory, S5 = covenant \\\\",
