    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "governs \\emph{what kind} of component may sit in the enforcement layer at all.",
    "text_hash": "7083a430cf1b418e09b6b5317ab1e3c7ae758ecd5f89d6b09538ae3bf3b0b556",
    "provenance": "claim_ingest deterministic:quantifier",
