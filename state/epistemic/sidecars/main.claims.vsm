    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "This is a stronger and more honest claim than ``S5 is always required.'' S5 is a",
    "text_hash": "f0b3ebdd9e86b4ff54bd25168d960047f44c47c164fe74aa72b7a87bc427875f",
