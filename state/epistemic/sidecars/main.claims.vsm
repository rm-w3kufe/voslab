    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "We run the complete kernel with all levels live and ask: under an external",
    "text_hash": "5e80ec95950c1a863259407c7f95b6a9308c1825c6d8be8e3708375b11a75a90",
