  },
  {
    "id": "SRC-MAIN-7848849e-C357",
    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "Any $\\tau$ trades the two error directions but cannot eliminate both",
    "text_hash": "ac84497ef8c88bd9cf2cdab56c482f1c9f674bbd8fdb4bee719cc197b338a504",
    "provenance": "claim_ingest deterministic:quantifier",
