    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "removed; this final experiment establishes what \\emph{engages} when every layer is",
    "text_hash": "1dedb15288d6e773f5d2fcaac34c61517c3d5e8edcda96540da1786417bf7cfc",
    "provenance": "claim_ingest deterministic:quantifier",
