  },
  {
    "id": "SRC-MAIN-7848849e-C354",
    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "the functional that certifies it need never know that is what it is doing.",
    "text_hash": "488c1408f3ff62b72390b2c6df51112d577576eb86c8fd80687024560220d96f",
    "provenance": "claim_ingest deterministic:quantifier",
    "method": "deterministic",
