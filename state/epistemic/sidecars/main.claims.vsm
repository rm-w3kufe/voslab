    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "classifier can \\emph{recommend} enforcement but cannot \\emph{constitute} it.",
    "text_hash": "8e38620e1f449ff17a492e22319920bc0e52e2c45ccc1e547bd820fbac6fa1fc",
    "provenance": "claim_ingest deterministic:quantifier",
