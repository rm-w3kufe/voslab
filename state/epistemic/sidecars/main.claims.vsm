    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "every tick at an unstructured floor ($0.777$), and without S5 the system",
    "text_hash": "1c4196dca91c3ac7e0deb4937e8a525890446a4d2ad4fb28ee63307056b6c343",
    "provenance": "claim_ingest deterministic:quantifier",
