  },
  {
    "id": "SRC-MAIN-7848849e-C360",
    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "The final experiment closes the loop the architecture is built for: with all five",
    "text_hash": "bfc11d913bacd62f0775c66b08b5c42c07c5b0ceac092c9f8989ab49805d5876",
    "provenance": "claim_ingest deterministic:quantifier",
