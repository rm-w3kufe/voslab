  },
  {
    "id": "SRC-MAIN-7848849e-C353",
    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "Modes 2--3, where the substrate cannot be measured directly, the integrity loop",
    "text_hash": "e35963b352261ae9d738d7a76f29b986c8b277698daebf5d7a3c3d161ac594e8",
    "provenance": "claim_ingest deterministic:quantifier",
