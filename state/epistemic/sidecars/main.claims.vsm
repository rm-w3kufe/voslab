    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "(veto enforced); the \\texttt{CovenantChecker} ran every tick and correctly did",
    "text_hash": "9ff8145c9d3df2d20b0cd91dc6c3394c535729ca5cd6fd2a2e8be1f383f1d9b4",
    "provenance": "claim_ingest deterministic:quantifier",
