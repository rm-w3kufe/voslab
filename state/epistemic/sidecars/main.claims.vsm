    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "None of them, on its own, answers the",
    "text_hash": "eedb6d3d1e220ce56b48e56b63686937fe6e014d31e8a420bc000e6fa2c0cc6a",
    "provenance": "claim_ingest deterministic:quantifier",
