    "negated": true
  },
  {
    "id": "SRC-MAIN-7848849e-C358",
    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "on a non-trivial violation set, so the contract ``every violation sets the bit''",
    "text_hash": "241e597a3035ccf0f7172f7d5a83af5c5ca2e9657082c9e840d242b5b66aba8f",
    "provenance": "claim_ingest deterministic:quantifier",
