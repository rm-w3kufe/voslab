    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "$\\hat{\\sigma}_\\lambda = 2.9\\times 10^{-16}$, is at machine precision: a",
    "text_hash": "02e21cdef24067a08e49f22a319277c7fce95983612cbaec3c96d7c580a8c24e",
    "provenance": "claim_ingest deterministic:num_eq",
