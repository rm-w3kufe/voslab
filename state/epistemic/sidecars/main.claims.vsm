    "type": "number",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "(the watchdog writes \\texttt{dims[53/54]}); the language model is confined to S4",
    "text_hash": "b78231f745d0308fc98320373e4689c637a13d17b923430dc518b86f4d92c680",
    "provenance": "claim_ingest deterministic:ratio",
