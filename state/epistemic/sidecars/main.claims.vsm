    "type": "theorem",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "trust comes from \\emph{measurement} --- one cannot forge $\\lambda_\\text{max}$.",
    "text_hash": "8dd28117f26cf07be345cbb181f956c3ff2306b5a72bbd7fa097f62297681d54",
    "provenance": "claim_ingest deterministic:quantifier",
