    "type": "number",
    "subject": "docs/papers/attractor_convergence/main.tex",
    "risk": "exploratory",
    "status": "DECLARED",
    "text": "\\texttt{dims[53/54]} atomically to a \\texttt{tmpfs} signal file that the",
    "text_hash": "489fdbcdc865f5c4d54fa148db6c3ee5c963911c3def1df3035f155ff3bfbd10",
    "provenance": "claim_ingest deterministic:ratio",
