    "risk": "exploratory",
    "status": "DECLARED",
    "text": "of each $\\lambda_i$ is flat at $-0.010050$ at every checkpoint",
    "text_hash": "eeeb523c6f4298bb494233f5acdc87ed9019292c19d10ef1e5a3b4fab862d287",
