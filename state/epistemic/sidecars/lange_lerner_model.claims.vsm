    "text": "⃗λt ≥ 0,        νt ≥ 0.",
    "text_hash": "cde54c6401813f8857cd9091c13c0772c791de0cc3ee4793662b2aa1e34be9ab",
    "type": "number",
    "value": "0"
  },
  {
    "certs": [],
    "checkable": "machine",
    "falsifier": false,
    "id": "SRC-LANGE-LERNER-MODEL-e2b101c0-C044",
    "method": "deterministic",
