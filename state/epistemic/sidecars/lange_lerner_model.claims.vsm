    "subject": "/root/augmented-lange-lerner/docs/Lange–Lerner_Model.pdf",
    "text": "This decomposition is central to the planning mechanism: the information that must reside with the planner or coordinator is precisely that required to solve the master problem, while households and firms solve their respective sub-problems independently given the prices broadcast by the planner.",
    "text_hash": "62edabf52dbdb25ff1fea859b0c58eacce61effef60e9a033c53d69eef601b3b",
    "type": "theorem"
  },
  {
    "certs": [],
    "checkable": "machine",
    "falsifier": true,
    "id": "SRC-LANGE-LERNER-MODEL-e2b101c0-C028",
    "method": "deterministic",
    "op": "=",
    "provenance": "claim_ingest deterministic:num_eq",
    "quantity": "t",
    "risk": "exploratory",
    "scope": "out_of_scope",
    "scope_reason": "control-chars",
    "section": "body",
