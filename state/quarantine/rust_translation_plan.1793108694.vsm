### Phase 2: Kernel Integration (1-2 días)

#### 2.1 Module structure

```rust
// projects/vsf-nucleus/src/modules/covenant_violation_detector.rs

use crate::telemetry::TelemetryEvent;
use crate::kernel::StateVector;
use serde_json::Value;

pub struct CovenantViolationDetector {
    stats: DetectorStats,
}

pub struct DetectorStats {
    total_events: u64,
    violations_detected: u64,
    a0_violations: u64,
    a01_violations: u64,
}
```

#### 2.2 Integration with phi_up channel

```rust
impl CovenantViolationDetector {
    pub fn process_telemetry(&mut self, events: &[TelemetryEvent], state: &mut StateVector) {
        self.stats.total_events += events.len() as u64;
        
        let violation = self.classify_stream(events);
        
        match violation {
            ViolationType::A0Violation => {
                self.stats.a0_violations += 1;
                self.stats.violations_detected += 1;
                state.dims[53] = 1.0;  // Trigger A0 collapse
                log::warn!("A0 violation detected, setting dims[53]=1.0");
            }
            ViolationType::A01Violation => {
                self.stats.a01_violations += 1;
                self.stats.violations_detected += 1;
                state.dims[54] = 1.0;  // Trigger A0.1 collapse
                log::warn!("A0.1 violation detected, setting dims[54]=1.0");
            }
            ViolationType::Clean => {
                // No action needed
            }
        }
    }
}
```

