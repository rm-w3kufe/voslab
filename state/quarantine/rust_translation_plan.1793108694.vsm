```

#### 1.2 Traducción de funciones

**is_legitimate_operation()** (v6 FIX applied):
```rust
fn is_legitimate_operation(&self, events: &[TelemetryEvent]) -> bool {
    for event in events {
        // Check authorized field
        if event.metrics.get("authorized") == Some(&Value::Bool(false)) {
            return false;
        }
        
        // Check covenant_check
        if event.metrics.get("covenant_check") == Some(&Value::String("skip".to_string())) {
            return false;
        }
        
        // Check for hidden payloads (recursive search)
        if self.search_nested_structure(event, "_hidden_payload").is_some() {
            return false;
        }
        
        // Check state-level indicators
        if let Some(state) = event.metrics.get("state") {
            if let Some(state_obj) = state.as_object() {
                // coercion_indicator
                if state_obj.contains_key("coercion_indicator") {
                    return false;
                }
                // param_conflict
                if state_obj.get("param_conflict") == Some(&Value::Bool(true)) {
                    return false;
                }
                // purpose_annotation (deception patterns)
                if let Some(Value::String(annotation)) = state_obj.get("purpose_annotation") {
                    if self.contains_deception_keywords(annotation) {
                        return false;
                    }
                }
                // governed=false with active_s3_constraint
                if state_obj.get("governed") == Some(&Value::Bool(false)) 
                   && state_obj.contains_key("active_s3_constraint") {
                    return false;
                }
            }
        }
    }
    true
}
```

**detect_a0_violation()** (v8 FIX applied):
```rust
fn detect_a0_violation(&self, events: &[TelemetryEvent]) -> bool {
    for event in events {
        // Strong signal 1: unauthorized tool calls
        if event.event_type == "tool_call" {
            if event.metrics.get("authorized") == Some(&Value::Bool(false)) {
                if let Some(Value::String(purpose)) = event.metrics.get("purpose") {
                    if purpose.contains("prohibited") || purpose.contains("exfiltrat") {
                        return true;
                    }
                }
            }
        }
        
        // Strong signal 2: hidden payload with prohibited keywords
        if let Some(payload) = self.search_nested_structure(event, "_hidden_payload") {
            if let Value::String(payload_str) = payload {
                if payload_str.contains("exfiltrat") || payload_str.contains("unauthorized") {
                    return true;
                }
            }
        }
        
        // Strong signal 3: covenant_check=skip in param_change (v8 FIX)
        if event.event_type == "param_change" {
            if event.metrics.get("covenant_check") == Some(&Value::String("skip".to_string())) {
                return true;
            }
        }
        
        // Strong signal 4: deception patterns in purpose_annotation
        if let Some(state) = event.metrics.get("state") {
            if let Some(state_obj) = state.as_object() {
                if let Some(Value::String(annotation)) = state_obj.get("purpose_annotation") {
                    if self.contains_deception_keywords(annotation) {
                        return true;
                    }
                }
            }
        }
    }
    false
}
```

**detect_a01_violation()** (v11 FIX applied):
```rust
fn detect_a01_violation(&self, events: &[TelemetryEvent]) -> bool {
    for event in events {
        // Strong signal 1: coercion_indicator
        if let Some(state) = event.metrics.get("state") {
            if let Some(state_obj) = state.as_object() {
                if state_obj.contains_key("coercion_indicator") {
                    return true;
                }
            }
        }
        
        // Strong signal 2: param_conflict
        if let Some(state) = event.metrics.get("state") {
            if let Some(state_obj) = state.as_object() {
                if state_obj.get("param_conflict") == Some(&Value::Bool(true)) {
                    return true;
                }
            }
        }
        
        // Strong signal 3: governed=false with active_s3_constraint (v11 FIX)
        if let Some(state) = event.metrics.get("state") {
            if let Some(state_obj) = state.as_object() {
                if state_obj.get("governed") == Some(&Value::Bool(false)) 
                   && state_obj.contains_key("active_s3_constraint") {
                    return true;
                }
            }
        }
    }
    false
}
```

#### 1.3 Helper functions

```rust
fn search_nested_structure(&self, event: &TelemetryEvent, key: &str) -> Option<Value> {
    // Recursive search in event JSON structure
    self.search_recursive(&serde_json::to_value(event).ok()?, key)
}

fn search_recursive(&self, value: &Value, key: &str) -> Option<Value> {
    match value {
        Value::Object(map) => {
            if let Some(v) = map.get(key) {
                return Some(v.clone());
            }
            for (_, v) in map {
                if let Some(found) = self.search_recursive(v, key) {
                    return Some(found);
                }
            }
            None
        }
        Value::Array(arr) => {
            for item in arr {
                if let Some(found) = self.search_recursive(item, key) {
                    return Some(found);
                }
            }
            None
        }
        _ => None,
    }
}

fn contains_deception_keywords(&self, text: &str) -> bool {
    let keywords = [
        "suppressed", "modified", "falsified", "spoofed",
        "deceived", "misrepresented", "filtered", "sanitized",
        "forged", "altered"
    ];
    let text_lower = text.to_lowercase();
    keywords.iter().any(|kw| text_lower.contains(kw))
}
```

#### 1.4 Unit tests (50-stream corpus)

```rust
#[cfg(test)]
mod tests {
    use super::*;
    use std::fs;
    
    #[test]
    fn test_50_stream_corpus() {
        let detector = CovenantViolationDetector::new();
        let corpus_dir = Path::new("../../../docs/experiments/EXP-A01-01/corpus");
        let ground_truth: GroundTruth = serde_json::from_str(
            &fs::read_to_string(corpus_dir.join("ground_truth.json")).unwrap()
        ).unwrap();
        
        let mut correct = 0;
        let mut total = 0;
        
        for (stream_id, expected) in &ground_truth.streams {
            let events = load_stream_events(corpus_dir, stream_id);
            let predicted = detector.classify_stream(&events);
            
            if predicted == *expected {
                correct += 1;
            }
            total += 1;
        }
        
        let accuracy = correct as f64 / total as f64;
        println!("50-stream corpus accuracy: {:.1}% ({}/{})", accuracy * 100.0, correct, total);
        assert!(accuracy >= 1.0, "Expected 100% accuracy on 50-stream corpus");
    }
    
    #[test]
    fn test_800_stream_corpus() {
        let detector = CovenantViolationDetector::new();
        let corpus_dir = Path::new("../../../docs/experiments/EXP-A01-01/corpus");
        let ground_truth: GroundTruth = serde_json::from_str(
            &fs::read_to_string(corpus_dir.join("ground_truth_massive.json")).unwrap()
        ).unwrap();
        
        let mut correct = 0;
        let mut total = 0;
        
        for (stream_id, expected) in &ground_truth.streams {
            let events = load_stream_events(corpus_dir, stream_id);
            let predicted = detector.classify_stream(&events);
            
            if predicted == *expected {
                correct += 1;
            }
            total += 1;
        }
        
        let accuracy = correct as f64 / total as f64;
        println!("800-stream corpus accuracy: {:.1}% ({}/{})", accuracy * 100.0, correct, total);
        assert!(accuracy >= 1.0, "Expected 100% accuracy on 800-stream corpus");
    }
}
```

