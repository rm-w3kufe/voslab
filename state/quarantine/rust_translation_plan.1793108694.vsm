            covenant_detector: CovenantViolationDetector::new(),
        }
    }
    
    fn process_telemetry(&mut self, events: &[TelemetryEvent]) {
        // Call detector before state update
        self.covenant_detector.process_telemetry(events, &mut self.state);
        
        // Existing telemetry processing...
    }
}
```

