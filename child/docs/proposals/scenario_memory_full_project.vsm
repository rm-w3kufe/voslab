⟦ scenario_memory_full_project | PROPOSAL-v1 | vsm-1.2.1 | 2026-08-26T19:15:00Z ⟧

@vsm 1.2.1
@status active

// ═══════════════════════════════════════════════════════════════════════════
// Scenario Memory — Extensión Completa del Proyecto
// ═══════════════════════════════════════════════════════════════════════════
//
// Author: vsf-s1-executor
// Scope: Full project — Phase 1, 2, 3 + integración
// Paradigm: Second-order cybernetics — autonomy through self-observation

// ─── 1. VISIÓN GENERAL ────────────────────────────────────────────────────

// 1.1 Problema Actual

problem = "El sistema toma decisiones socráticas pero NO aprende de sus propias decisiones. Cada evaluación es independiente — no hay memoria entre sesiones."

// 1.2 Solución

solution = "Un layer de memoria procedimental que permita al sistema: 1. Observar sus propias decisiones (Fase 1), 2. Reconocer patrones similares (Fase 2), 3. Adaptarse basado en outcomes pasados (Fase 3)."

// 1.3 Paradigma

paradigm = "Cibernética de 2do orden: El observador es parte del sistema. El sistema observa sus propias decisiones y aprende de sí mismo."

// ─── 2. ARQUITECTURA OBJETIVO ─────────────────────────────────────────────

target_architecture = {
  components: [
    "scenario-memory.ts (nuevo) — store(), match(), adapt(), learn()",
    "procedure-memory/ (directorio de datos) — procedures/, lessons/, patterns/",
    "socratic-shell (pre-evaluación)",
    "event-router (post-decisión)",
    "learning-cycle (post-outcome)"
  ]
}

// ─── 3. FASES DE IMPLEMENTACIÓN ───────────────────────────────────────────

// Fase 1: Observación (sin cambio de comportamiento)

phase1 = {
  name: "Observación",
  objective: "Registrar decisiones y outcomes",
  duration: "2-3 sesiones",
  risk: "Bajo — solo observa, no actúa",
  components: [
    "socratic-shell.ts (extendido) — Emitir outcome post-evaluación",
    "log-activation.ts (extendido) — Incluir outcome en JSONL",
    "learning_records/procedures/ (nuevo directorio)",
    "learning_stats.py (extendido) — Métricas de procedimientos",
    "session_learning_scan.sh (extendido) — Incluir procedures en scan"
  ],
  flow: "socratic-shell → evaluate → act → outcome → log-activation → procedures/"
}

// Fase 2: Matching (búsqueda por similaridad)

phase2 = {
  name: "Matching",
  objective: "Encontrar procedimientos pasados para contextos similares",
  duration: "4-5 sesiones",
  dependency: "Fase 1 completada",
  risk: "Medio — necesita threshold para evitar false positives",
  components: [
    "scenario-memory.ts (nuevo handler en operational/)",
    "procedure-match.tree.vsm (nuevo árbol socrático)",
    "matching.ts (nuevo módulo)",
    "event-router.ts (extendido) — Registrar scenario-memory handler",
    "learning_stats.py (extendido) — Métricas de matching"
  ],
  flow: "session.idle → event-router → scenario-memory → match() → sugerir/continuar"
}

// Fase 3: Adaptación (aprendizaje autónomo)

phase3 = {
  name: "Adaptación",
  objective: "Ajustar procedimientos basado en outcomes",
  duration: "6-8 sesiones",
  dependency: "Fase 2 completada",
  risk: "Alto — necesita safeguards contra bucles infinitos",
  components: [
    "scenario-memory.ts (extendido) — Funciones adapt() y learn()",
    "adaptation.tree.vsm (nuevo árbol)",
    "procedure-generator.ts (nuevo módulo)",
    "confidence-tracker.ts (nuevo módulo)",
    "learning_stats.py (extendido) — Métricas de adaptación"
  ],
  flow: "scenario-memory → learn(outcome) → adapt(procedure, context) → generate new"
}

// ─── 4. INTEGRACIÓN CON COMPONENTES EXISTENTES ────────────────────────────

integration_map = {
  "socratic-shell.ts": {
    "Fase 1": "Agregar outcome post-evaluación",
    "Fase 2": "Consultar scenario-memory antes de evaluar",
    "Fase 3": "Recibir sugerencias de adaptación"
  },
  "event-router.ts": {
    "Fase 1": "Sin cambios",
    "Fase 2": "Registrar scenario-memory handler",
    "Fase 3": "Priorizar handlers basado en confianza"
  },
  "learning-cycle handler": {
    "Fase 1": "Incluir procedures en scan",
    "Fase 2": "Agregar matching metrics",
    "Fase 3": "Agregar adaptation metrics"
  },
  "gap-resolver.ts": {
    "Fase 1": "Sin cambios",
    "Fase 2": "Reusar matching si es beneficial",
    "Fase 3": "Contribuir a pattern detection"
  },
  "log-activation.ts": {
    "Fase 1": "Campo outcome opcional",
    "Fase 2": "Campo match opcional",
    "Fase 3": "Campo adaptation opcional"
  }
}

// ─── 5. ESTRUCTURA DE DIRECTORIOS ─────────────────────────────────────────

directory_structure = {
  "learning_records/procedures/": "Fase 1 — procedimientos exitosos",
  "learning_records/lessons/": "Fase 3 — lecciones aprendidas",
  "learning_records/patterns/": "Fase 3 — patrones detectados",
  "learning_records/learning-record/": "existente",
  "learning_records/.pending/": "existente"
}

// ─── 6. TIPOS DE MEMORIA ──────────────────────────────────────────────────

memory_types = [
  { type: "Procedimiento exitoso", phase: "1", example: "Cuando hay 3+ gaps, ejecutar batch-reclassify", retention: "Alta" },
  { type: "Lección aprendida", phase: "1", example: "No ejecutar governance si n02 no reachable", retention: "Permanente" },
  { type: "Atajo", phase: "2", example: "Si contexto idéntico, reusar decisión", retention: "Media" },
  { type: "Anti-pattern", phase: "3", example: "Nunca hacer X en contexto Y", retention: "Permanente" },
  { type: "Patrón emergente", phase: "3", example: "Tendencia de clasificación en sandbox", retention: "Media" }
]

// ─── 7. RIESGOS Y MITIGACIONES ────────────────────────────────────────────

risks = [
  { risk: "Complejidad excesiva", phase: "1-3", mitigation: "Fase 1 sin cambio de comportamiento" },
  { risk: "False positives en matching", phase: "2", mitigation: "Threshold alto (0.8) + review humano" },
  { risk: "Bucle de feedback infinito", phase: "3", mitigation: "Max 3 adaptaciones por procedimiento" },
  { risk: "Consumo de recursos", phase: "2-3", mitigation: "Matching solo en session.idle" },
  { risk: "Overfitting", phase: "3", mitigation: "Diversidad de contextos requerida" }
]

// ─── 8. MÉTRICAS GLOBALES ─────────────────────────────────────────────────

global_metrics = {
  learning: [
    { metric: "total_procedures", phases: "1,2,3" },
    { metric: "success_rate", phases: "1,2,3" },
    { metric: "hit_rate", phases: "2,3" },
    { metric: "reuse_rate", phases: "2,3" },
    { metric: "adaptation_rate", phases: "3" },
    { metric: "autonomy_score", phases: "3" }
  ],
  performance: [
    { metric: "avg_evaluation_ms", description: "Tiempo promedio de evaluación socrática" },
    { metric: "avg_matching_ms", description: "Tiempo promedio de matching" },
    { metric: "memory_usage_mb", description: "Uso de memoria del scenario-memory" },
    { metric: "disk_usage_mb", description: "Uso de disco en procedures/" }
  ],
  quality: [
    { metric: "false_positive_rate", description: "% matches que fallaron" },
    { metric: "confidence_accuracy", description: "Correlación entre confianza y éxito" },
    { metric: "pattern_coverage", description: "% contextos con patrones detectados" }
  ]
}

// ─── 9. CRITERIOS DE ACEPTACIÓN ───────────────────────────────────────────

acceptance_criteria = {
  phase1: [
    "outcome se registra correctamente en JSONL",
    "procedure-*.json se crea con formato correcto",
    "learning_stats.py incluye métricas de procedimientos",
    "Backwards compatible (sin breaking changes)",
    "Todas las pruebas existentes pasan",
    "Documentación completa"
  ],
  phase2: [
    "scenario-memory handler registrado en event-router",
    "matching.ts ejecuta matching correctamente",
    "procedure-match.tree.vsm evalúa correctamente",
    "hit_rate > 50% en pruebas",
    "false_positive_rate < 10%",
    "Performance: matching < 100ms"
  ],
  phase3: [
    "adapt() ajusta procedimientos correctamente",
    "learn() actualiza confianza correctamente",
    "procedure-generator genera nuevos procedimientos",
    "Bucle de feedback controlado (max 3 adaptaciones)",
    "autonomy_score > 30% (sin intervención humana)",
    "Documentación completa"
  ]
}

// ─── 10. CRONOGRAMA ───────────────────────────────────────────────────────

timeline = {
  "Fase 1 completada": "2-3 sesiones (2026-08-28)",
  "Fase 1 estable": "1 semana (2026-09-04)",
  "Fase 2 completada": "4-5 sesiones (2026-09-08)",
  "Fase 2 estable": "1 semana (2026-09-15)",
  "Fase 3 completada": "6-8 sesiones (2026-09-22)",
  "Proyecto completo": "2026-09-29"
}

// ─── 11. PRINCIPIOS CLAVE ─────────────────────────────────────────────────

key_principles = [
  "1. Observar antes de actuar — Fase 1 es observación pura",
  "2. Aprendizaje gradual — Cada fase agrega capacidades",
  "3. Safeguards siempre — Bucles infinitos, false positives, resource limits",
  "4. Backwards compatible — Sin breaking changes en ninguna fase",
  "5. Autonomía incremental — Cada fase aumenta la autonomía del sistema"
]

// ─── 12. RELACIÓN CON CIBERNÉTICA DE 2DO ORDEN ───────────────────────────

cybernetics_relation = [
  "Observador es parte del sistema — El sistema observa sus propias decisiones",
  "Auto-referencia — Las decisiones pasadas informan decisiones futuras",
  "Auto-organización — El sistema genera sus propios procedimientos",
  "Autonomía — El sistema aprende sin intervención humana"
]

