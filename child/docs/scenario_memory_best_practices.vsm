@vsm 1.2.1
@status active

// ═══════════════════════════════════════════════════════════════════════════
// Scenario Memory — Best Practices Guide
// ═══════════════════════════════════════════════════════════════════════════
//
// Author: vsf-s1-executor
// Date: 2026-08-27
// Status: BEST PRACTICES DOCUMENTATION

// ─── 1. VISIÓN GENERAL ────────────────────────────────────────────────────

overview = "
Scenario Memory es un sistema de aprendizaje procedimental que permite al
agente aprender de sus propias decisiones. Este documento describe las
mejores prácticas para usar y mantener el sistema.
"

// ─── 2. CUÁNDO USAR SCENARIO MEMORY ───────────────────────────────────────

when_to_use = "
USE Scenario Memory cuando:
- El agente toma decisiones socráticas frecuentes
- Hay patrones repetitivos en las evaluaciones
- Se necesita aprender de éxitos y fallos
- Se quiere mejorar la autonomía del agente

NO USE Scenario Memory cuando:
- Las decisiones son únicas (no hay patrones)
- El contexto cambia radicalmente entre evaluaciones
- Se necesita respuesta inmediata (el matching toma tiempo)
"

// ─── 3. CÓMO FUNCIONA EL FLUJO ────────────────────────────────────────────

flow = "
1. OBSERVACIÓN: Cada evaluación socrática registra un procedimiento
2. MATCHING: En session.idle, busca procedimientos similares
3. ADAPTACIÓN: Si confidence < 0.6, adapta el procedimiento
4. APRENDIZAJE: Genera IRs si hay patrones significativos
"

// ─── 4. MÉTRICAS CLAVE ────────────────────────────────────────────────────

metrics = "
autonomy_score: % de decisiones autónomas (target: >30%)
  - reused: Procedimientos reutilizados exitosamente
  - adapted: Procedimientos adaptados (Phase 3)
  - new: Procedimientos nuevos (no del historial)

success_rate: % de procedimientos exitosos (target: >80%)

confidence_levels:
  - high (>=0.8): Reutilizar procedimiento
  - medium (0.6-0.8): Adaptar procedimiento
  - low (<0.6): Crear procedimiento nuevo
"

// ─── 5. MEJORES PRÁCTICAS ─────────────────────────────────────────────────

best_practices = "
1. MONITOREO REGULAR
   - Ejecutar scenario_memory_monitor.sh semanalmente
   - Revisar autonomy_score y success_rate
   - Identificar tendencias en métricas

2. ANÁLISIS DE PATRONES
   - Revisar procedures/ para patrones frecuentes
   - Identificar instrumentos con mayor uso
   - Detectar fallos recurrentes

3. OPTIMIZACIÓN DE CONFIANZA
   - Mantener confidence levels altos para procedures exitosos
   - Adaptar procedures con confidence media
   - Crear nuevos procedures para contextos nuevos

4. INTEGRACIÓN CON GAP-RESOLVER
   - Usar procedures pasados para resolver gaps similares
   - Reutilizar soluciones exitosas
   - Adaptar soluciones cuando el contexto cambia

5. LIMPIEZA PERIÓDICA
   - Archivar procedures antiguos (>30 días)
   - Consolidar procedures similares
   - Eliminar procedures con bajo rendimiento
"

// ─── 6. COMANDOS ÚTILES ──────────────────────────────────────────────────

commands = "
# Ver estado actual
bash scripts/state/monitoring/scenario_memory_dashboard.sh

# Crear snapshot de métricas
bash scripts/state/monitoring/scenario_memory_monitor.sh snapshot

# Ver cambios entre snapshots
bash scripts/state/monitoring/scenario_memory_monitor.sh diff

# Ejecutar tests
bash tests/adversarial/test_scenario_memory.sh
bash tests/adversarial/test_scenario_memory_e2e.py
bash tests/adversarial/test_scenario_memory_real_data.sh
bash tests/adversarial/test_gap_resolver_scenario_memory.sh

# Ver métricas detalladas
python3 scripts/state/monitoring/learning_stats.py --procedures
python3 scripts/state/monitoring/learning_stats.py --procedures --json
"

// ─── 7. TROUBLESHOOTING ───────────────────────────────────────────────────

troubleshooting = "
PROBLEMA: No hay procedures registrados
SOLUCIÓN: Verificar que socratic-shell está usando logActivation(outcome)

PROBLEMA: confidence score bajo
SOLUCIÓN: Revisar si el contexto cambia mucho entre evaluaciones

PROBLEMA: autonomy_score bajo
SOLUCIÓN: Más evaluaciones socráticas = más oportunidades de reutilizar

PROBLEMA: adaptation no funciona
SOLUCIÓN: Verificar R17 safeguard (max 3 adaptations per procedure)
"

// ─── 8. MÉTRICAS DE ÉXITO ─────────────────────────────────────────────────

success_metrics = "
DESPUÉS DE 1 SEMANA:
- autonomy_score > 10%
- success_rate > 70%
- Al menos 5 procedures registrados

DESPUÉS DE 1 MES:
- autonomy_score > 30%
- success_rate > 80%
- Al menos 20 procedures registrados
- Patrones identificables en procedures/
"

// ─── 9. PRÓXIMOS PASOS ────────────────────────────────────────────────────

next_steps = "
1. Integrar con más instruments socráticos
2. Crear dashboard web para visualización
3. Implementar alertas para métricas anómalas
4. Agregar soporte para multi-agente (compartir procedures)
"

