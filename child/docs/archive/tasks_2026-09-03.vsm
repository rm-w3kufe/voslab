fact("child-mcp-instance-path-must-be-absolute") = {
  body: "state-canon-mcp's per-instance file (e.g. tasks_provider.py) must
      be declared in child/opencode.json with an ABSOLUTE path, never a
      relative one. mcp_server.py resolves the instance path against the
      process cwd; under child/ a relative path like 'tasks_provider.py'
      is not found and the MCP server dies at boot with 'Connection closed'.",
  why:  "Observed 2026-08-11 — state-canon MCP failed to load in the child
      session for exactly this reason. The relative declaration worked only
      when the cwd coincidentally lined up; child/ runs make that fragile.
      Parent (vsf-s3-validator) fixed it in commit 6826858f using the same
      pattern already established for state-canon-infra
      (ssh_sqlite_ops.py absolute in opencode.json).",
  apply: "Whenever adding a new state-canon-mcp instance or modifying an
      existing one in child/opencode.json (or the parent's opencode.json):
      use an absolute path. Do NOT use '~/' or relative — expand fully.
      This is now a structural invariant, not a one-off fix.",
}

