// Source: 2026-09-01 design session with rmw3
// ═══════════════════════════════════════════════════════════════════

task("RSI-L3-AUTONOMOUS") = {
  agent: [S],
  priority: high,
  status: proposed,
  gate: rmw3-approval,
  description: "Build autonomous L3 cycle: detect complex faults → GA generates strategies → shadow mode validates → activate with rollback. The system operates proactively without agent invocation. Bridge to L4: shadow mode = fitness evaluation, rollback = natural selection.",
  effort: "3-4 sessions",
  depends_on: ["RSI-L3-SEMANTIC", "RSI-L3-BEHAVIORAL-VALIDATION"],
  output: "rsi_autonomous_l3.py, rsi_fault_detector.py, rsi_shadow_mode.py, rsi_rollback.py, tests/test_autonomous_l3.py",
  design: {
    architecture: "4-component cycle: Detector → Generator → Shadow → Activator",
    safety_layers: [
      "1. AST validation (block code injection)",
      "2. Shadow mode (10 evals before activate)",
      "3. Threshold ≥10% improvement to activate",
      "4. Auto-rollback if degrades after 50 evals"
    ],
    complexity_filter: "Same error ≥3 in 10 evals, latency >10ms, coverage <50%, BLOCKING class",
    ga_params: "5-10 strategies per fault, mutation + crossover, AST validation",
    shadow_params: "10 real evals, compare baseline, ≥10% improvement to promote",
    rollback_params: "50 eval window, auto-revert if accuracy drops below baseline",
    transition_to_L4: "Shadow mode = fitness eval, rollback = natural selection, populations = multiple strategies competing"
  },
  acceptance: [
    "Fault detector identifies complex faults (not solvable by L1/L2)",
    "GA generates 5-10 valid socratic trees per fault",
    "Shadow mode runs 10 evals and compares to baseline",
    "Activation only if ≥10% improvement",
    "Rollback triggers if accuracy drops after activation",
    "All existing tests pass (no regression)",
    "≥20 new tests for autonomous cycle"
  ],
}

