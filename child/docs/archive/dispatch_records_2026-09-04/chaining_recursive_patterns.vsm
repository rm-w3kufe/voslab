        "patch-detect.tree.vsm",
        "quality-gate.tree.vsm",
        "dependency-check.tree.vsm",
        "conflict-detect.tree.vsm",
      ],
    },

    opportunity_2_lifecycle_recursion: {
      name: "Lifecycle Recursion",
      description: "Recursive lifecycle management for projects",
      example: "draft → design → implementing → testing → consolidating → stable → archived",
      implementation: {
        root_node: "Project state",
        branches: [
          "Forward progression",
          "Regression (if issues found)",
