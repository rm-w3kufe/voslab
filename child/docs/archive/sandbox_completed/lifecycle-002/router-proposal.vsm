// ═══════════════════════════════════════════════════════════════
// 8. SEGMENTACIÓN ESTRUCTURAL (tu propuesta)
// ═══════════════════════════════════════════════════════════════

// La segmentación propuesta se implementa via `phase` en el
// registry. No es ubicación física, es ownership lógico.

segmentacion = {

  "plugin-core": {
    phase: "PRE | VALIDATION | CLASSIFICATION | POST",
    desc: "Scripts que ejecutan la lógica de verificación del agente",
    ubicacion_actual: "scripts/vsl/, .opencode/plugins/scripts/",
    ubicacion_futura: "Se quedan donde están — el UER los referencia por ID",
    ejemplos: [
      "write_gate_orchestrator.py (POST)",
      "socratic_engine.py (CLASSIFICATION)",
      "tokenizer.py (PRE)",
    ],
  },

  "operational": {
    phase: "OBSERVATION | none (timer-only)",
    desc: "Scripts operacionales que corren en timers o deploy",
    ubicacion_actual: "scripts/state/, scripts/s{1,3,4,5}-*/",
    ubicacion_futura: "Se quedan donde están — no son parte del UER",
