}

// ═══════════════════════════════════════════════════════════════
// 9. MIGRACIÓN: ACTUAL → UER
// ═══════════════════════════════════════════════════════════════

// El UER es backward-compatible — los plugins actuales pueden
// funcionar sin cambios mientras se migran gradualmente.

migracion = {

  "Fase 0": {
