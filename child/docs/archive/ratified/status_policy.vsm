⟦ status_policy | POLICY-v1 | vsm-1.2.1 | 2026-08-27T21:35:00Z ⟧

@vsm 1.2.1
@status archived

// Status Policy for system/ documents
// Defines when to use each @status archived

map(STATUS-POLICY) {

  // ─── PURPOSE ───
  purpose: "Define when to use proposed, active, ratified, and archived statuses",

  // ─── STATUS VALUES ───
  statuses: {
    proposed: {
      description: "Document is a proposal, not yet approved",
      when_to_use: [
        "New document being drafted",
        "Major changes being proposed",
        "Awaiting review or approval",
      ],
      characteristics: [
        "May be incomplete",
        "Subject to change",
        "Not yet binding",
      ],
      example: "New theory document awaiting review",
    },
    active: {
      description: "Document is approved and in use",
      when_to_use: [
        "Document has been reviewed and approved",
        "Document is being actively used",
        "Document is binding on the system",
      ],
      characteristics: [
        "Complete and reviewed",
        "Binding on the system",
        "Subject to versioning",
      ],
      example: "boot_manifest.vsm, hard_rules.vsm",
    },
    ratified: {
      description: "Document has been formally ratified",
      when_to_use: [
        "Document has gone through formal approval process",
        "Document is stable and unlikely to change",
        "Document has external attestation",
      ],
      characteristics: [
        "Formally approved",
        "Stable and final",
        "May have external attestation",
      ],
      example: "covenant.vsm (docs/governance/)",
    },
    archived: {
      description: "Document is no longer active",
      when_to_use: [
        "Document has been superseded",
        "Document is no longer relevant",
        "Document is kept for historical reference",
      ],
      characteristics: [
        "Read-only",
        "Not binding",
        "Historical reference only",
      ],
      example: "Old versions, deprecated documents",
    },
  },

  // ─── TRANSITIONS ───
  transitions: {
    allowed: [
      "proposed → active (approval)",
      "active → ratified (formal ratification)",
      "active → archived (deprecation)",
      "ratified → archived (superseded)",
    ],
    not_allowed: [
      "archived → active (must be re-proposed)",
      "archived → ratified (must be re-proposed)",
      "proposed → ratified (must go through active)",
    ],
  },

  // ─── RULES ───
  rules: [
    {
      id: "SR-1",
      rule: "Every document MUST have @status archived header",
      enforcement: "vsl-check-on-write validates on every write",
    },
    {
      id: "SR-2",
      rule: "Status transitions MUST be documented",
      enforcement: "Manual review",
    },
    {
      id: "SR-3",
      rule: "Archived documents MUST NOT be modified",
      enforcement: "Manual review",
    },
    {
      id: "SR-4",
      rule: "Ratified documents MUST have external attestation",
      enforcement: "Manual review",
    },
    {
      id: "SR-5",
      rule: "Status changes MUST be announced in commit message",
      enforcement: "Manual review",
    },
  ],

  // ─── EXAMPLES ───
  examples: {
    new_document: {
      status: "proposed",
      example: "New theory document: @status archived",
    },
    approved_document: {
      status: "active",
      example: "boot_manifest.vsm: @status archived",
    },
    formal_document: {
      status: "ratified",
      example: "covenant.vsm (governance/): @status archived",
    },
    deprecated_document: {
      status: "archived",
      example: "Old version: @status archived",
    },
  },
}

⟦ /status_policy ⟧

⟦ /status_policy ⟧
