⟦ vsl_basics | KNOWLEDGE-v1 | vsm-1.2.1 | 2026-09-04T02:00:00Z ⟧

@vsm 1.2.1
@status active

// Minimal VSL reference for the agent. Full spec: boot/vsl_language_primer.vsm

vsl_basics {

  header: "
    Get current: bash scripts/helpers/vsm_header.sh <name> <TYPE>
    Output:
      ⟦ name | TYPE-v1 | vsm-<version> | <timestamp> ⟧
      @vsm <version>
      @status proposed|active|ratified|archived
      content...
      ⟦ /name ⟧
  "

  types: "PROPOSAL, ANALYSIS, ARCHITECTURE, ROADMAP, FACT, SESSION, KNOWLEDGE"

  timestamp: "bash scripts/helpers/vsm_timestamp.sh"
  version: "bash scripts/helpers/vsm_version.sh"

  symbols: "
    ∀ ∃ ¬ ∧ ∨ ⟹ ⟺ ∈ ∉ ⊂ ⊆
    ⊤ ⊥  := true, false
    ⟦ ⟧  := document header/footer
    ✓ ◐ ✗ ?  := verified · partial · failed · unknown
  "

  session_block: "
    session('YYYY-MM-DD-id') = {
      summary: '...',
      result: pass|fail,
      commits: [...],
      verify: 'command → output',
      next: [...],
    }
  "

  task_block: "
    task('ID') = {
      description: '...',
      agent: [S]|[P],
      priority: P0|P1|P2,
      gate: pass|fail|pending,
      status: open|done|blocked,
    }
  "
}

⟦ /vsl_basics ⟧
