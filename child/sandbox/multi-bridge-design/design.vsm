// design.vsm — Multi-Bridge Architecture for socratic-engine
// Status: draft (SANDBOX-EXPLORATORY)
// Created: 2026-08-24
// Purpose: Design + working journal for the multi-bridge system

@vsm 1.2.1
@status active

// ═══════════════════════════════════════════════════════════════════════════
// §1 — PROBLEM STATEMENT
// ═══════════════════════════════════════════════════════════════════════════

problem: "
  The socratic-engine's StateCanonBridge currently wraps a SINGLE provider
  (VsmStateProvider → TASKS.vsm). This limits certification to 4 domains
  (tasks, sessions, focus, meta). Meanwhile:

  - state.db (SSH n02) has 25+ domains (services, lxcs, components, deploys,
    audits, chain_state, coupling_registry, s5_policy, variety_metrics, ...)
  - VSM documentation (filesystem) has structured specs (boot/, s1-operations/,
    s2-coordination/, s3-control/, s4-intelligence/, s5-policy/)

  The engine cannot certify across these sources. A multi-bridge architecture
  enables cross-domain certification: 'is the service running AND the spec
  current AND the deployment matching the declaration?'
"

// ═══════════════════════════════════════════════════════════════════════════
// §2 — CURRENT ARCHITECTURE (as-is)
// ═══════════════════════════════════════════════════════════════════════════

current_arch: "
  socratic-engine (pip package at ~/socratic-engine/)
    ├── engine.py          — SocraticEngine (predicates, evaluate, diagnose)
    ├── tree.py            — SocraticTreeBuilder (JSON/VSL parser)
    ├── mcp_server.py      — SocraticMCP (stdio JSON-RPC 2.0)
    ├── bridge_statecanon.py — StateCanonBridge (single provider)
    └── cli.py             — CLI entry point

  child/socratic_mcp_with_bridge.py
    └── Thin wrapper: imports VsmStateProvider, creates SocraticMCP(provider)

  Provider interface (implicit contract):
    query(domain: str, filter: dict) → list[dict]
    list_domains() → list[str]
"

// ═══════════════════════════════════════════════════════════════════════════
// §3 — PROPOSED ARCHITECTURE (to-be)
// ═══════════════════════════════════════════════════════════════════════════

proposed_arch: "
  ┌─────────────────────────────────────────────────────────┐
  │                   socratic-engine                       │
  │                                                         │
  │  SocraticMCP                                           │
  │    ├── socratic_evaluate    (builtin)                   │
  │    ├── socratic_diagnose    (builtin)                   │
  │    ├── socratic_build       (builtin)                   │
  │    └── MultiBridge                                           │
  │          ├── canon_query(domain, filter)                 │
  │          ├── canon_matches(domain, filter, expected)     │
  │          ├── canon_field_equals(domain, filter, f, v)    │
  │          ├── canon_drift(domain, filter, decl, obs)      │
  │          ├── canon_domains()          → list[str]        │
  │          └── canon_providers()        → list[dict]       │
  │                │                                         │
  │                ├── VsmStateProvider    (child/TASKS.vsm) │
  │                │     domains: tasks, sessions, focus, meta│
  │                │                                         │
  │                ├── SshSqliteProvider   (SSH n02 state.db)│
  │                │     domains: services, lxcs, components,│
  │                │              deploys, audits, ...        │
  │                │                                         │
  │                └── VsmDocProvider      (filesystem)      │
  │                      domains: boot, s1-operations,       │
  │                               s2-coordination, ...       │
  └─────────────────────────────────────────────────────────┘
"

// ═══════════════════════════════════════════════════════════════════════════
// §4 — PROVIDER INTERFACE (contract)
// ═══════════════════════════════════════════════════════════════════════════

provider_contract: "
  Every provider MUST implement:

    query(domain: str, filter: dict) → list[dict]
      - Returns records matching filter in the given domain
      - Empty list = no records (NOT an error)
      - Raises ValueError/KeyError/TypeError on invalid filter

    list_domains() → list[str]
      - Returns all domains this provider handles

  Optional:
    schema(domain: str) → dict
      - Returns field names and types for a domain

  The MultiBridge routes queries to the correct provider by domain.
  Unknown domain → returns UNKNOWN (not an error, R9: no silent concession).
"

// ═══════════════════════════════════════════════════════════════════════════
// §5 — DATA SOURCES (inventory)
// ═══════════════════════════════════════════════════════════════════════════

data_sources: "

  source_1: VsmStateProvider (EXISTING)
    location: child/TASKS.vsm
    domains: tasks, sessions, focus, meta
    access: local filesystem
    freshness: reload-on-mtime (already implemented)
    notes: 3 sessions, 1 focus, 1 meta currently

  source_2: SshSqliteProvider (EXISTING in state-canon-mcp)
    location: root@n02:/var/lib/vsf-state/state.db
    domains: alert_counts, deploys, specs, algedonic_ledger,
             kpi_manifests, spot_checks, audits, lxcs,
             storage_probe_state, autopilot_rules, node_profiles,
             task_drift, chain_state, opsroom_sessions, tasks,
             checkpoint_stats, peripheral_health, v_open_blockers,
             components, recon_allowlist, v_services_summary,
             coupling_registry, s5_policy, variety_metrics,
             cyberfilter_health, services
    access: SSH + sqlite3
    freshness: real-time (queried on demand)
    notes: 130 services records verified

  source_3: VsmDocProvider (NEW — to implement)
    location: ~/vsf/docs/spec_revision/system/
    domains: boot, s1-operations, s2-coordination, s3-control,
             s4-intelligence, s5-policy
    access: local filesystem
    freshness: on-demand (read at query time)
    notes: parse VSM headers for metadata, full content for doc_has
"

// ═══════════════════════════════════════════════════════════════════════════
// §6 — CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════

config: "
  bridge_config.json (lives alongside the MCP wrapper):

  {
    'bridges': [
      {
        'name': 'agent-state',
        'provider': 'VsmStateProvider',
        'module': 'instances.tasks_provider',
        'args': {'vsm_path': '/path/to/TASKS.vsm'},
        'domains': ['tasks', 'sessions', 'focus', 'meta']
      },
      {
        'name': 'infra-state',
        'provider': 'SshSqliteProvider',
        'module': 'instances.ssh_sqlite_ops',
        'args': {'host': 'root@n02', 'db': '/var/lib/vsf-state/state.db'},
        'domains': ['services', 'lxcs', 'components', ...]
      },
      {
        'name': 'vsm-docs',
        'provider': 'VsmDocProvider',
        'module': 'socratic_engine.providers.vsm_doc',
        'args': {'root': '/home/rmw3/vsf/docs/spec_revision/system'},
        'domains': ['boot', 's1-operations', ...]
      }
    ]
  }

  Environment variable: SOCRATIC_BRIDGE_CONFIG=/path/to/bridge_config.json
  Fallback: single-provider mode (backward compatible)
"

// ═══════════════════════════════════════════════════════════════════════════
// §7 — IMPLEMENTATION PLAN
// ═══════════════════════════════════════════════════════════════════════════

implementation: "

  Phase 1: MultiBridge core (in socratic-engine package)
    1.1 Create socratic_engine/multi_bridge.py
        - MultiBridge class: dict[domain→provider] routing
        - register() method to add providers
        - Same 4 canon_* predicates as StateCanonBridge
        - New: canon_domains(), canon_providers()
    1.2 Tests for MultiBridge (mock providers)
    1.3 Backward compatibility: StateCanonBridge still works

  Phase 2: VsmDocProvider (new provider)
    2.1 Create socratic_engine/providers/vsm_doc.py
        - Parse VSM headers (⟦ name | id | version | date ⟧)
        - list_domains() from directory structure
        - query() returns header metadata + file stats
    2.2 Integration with existing engine predicates (type_prefix, etc.)

  Phase 3: MCP integration
    3.1 Update socratic_mcp_with_bridge.py to load config
    3.2 Add config loading to SocraticMCP constructor
    3.3 New MCP tools: socratic_canon_domains, socratic_canon_providers

  Phase 4: Testing + documentation
    4.1 End-to-end test: query across all 3 sources
    4.2 Cross-domain certification example
    4.3 Update ARCHITECTURE.md
"

// ═══════════════════════════════════════════════════════════════════════════
// §8 — GAPS + RISKS
// ═══════════════════════════════════════════════════════════════════════════

gaps: "

  GAP-1: SshSqliteProvider is in state-canon-mcp, not in socratic-engine
    risk: cross-package dependency (R6: internal first)
    mitigation: import lazily (already done in bridge_statecanon.py),
                or duplicate the SSH query logic (simpler, ~40 lines)
    status: RESOLVED — lazy import works, tested

  GAP-2: VsmDocProvider doesn't exist yet
    status: RESOLVED — implemented, 382/382 tests pass

  GAP-3: Provider error handling
    status: RESOLVED — all errors → UNKNOWN (R9 compliant)

  GAP-4: Config format not yet standardized
    status: RESOLVED — versioned JSON with fallback to env vars

  GAP-5: R16 (impl with design)
    status: THIS DOCUMENT is the design source

  GAP-6 (NEW): Provider health not exposed [HIGH]
    risk: users can't tell if a provider is actually connected
    status: OPEN — need health/last_error fields in canon_providers

  GAP-7 (NEW): No routing observability [MEDIUM]
    risk: can't debug which provider served a query
    status: OPEN — need _routing trace in evidence

  GAP-8 (NEW): VSL parsing broken in MCP path [MEDIUM]
    risk: agents can't send VSL-formatted trees through MCP
    status: OPEN — parse_socratic_block() returns None

  GAP-9 (NEW): UNKNOWN cascades through AND [LOW, by design]
    risk: one broken provider makes entire AND tree UNKNOWN
    status: OPEN — correct behavior, but GAP-6 helps users understand WHY

  GAP-10 (NEW): certified=False for UNKNOWN domains [DESIGN]
    risk: semantic question — is "no data" a certification failure?
    status: OPEN — S5 decision needed
"

