// ═══════════════════════════════════════════════════════════════════
// SECTION 2: REAL LIMITATIONS (registered as tasks)
// ═══════════════════════════════════════════════════════════════════

limitation("LIMITATION-1-L3-TEMPLATE-BASED") = {
  what: "L3 predicate generation uses fixed templates, not semantic generation",
  risk: medium,
  impact: "Generated predicates are syntactically valid but semantically shallow",
  task: "RSI-L3-SEMANTIC",
  approach: "Extend templates with context-aware heuristics; add behavioral validation beyond AST parse",
}

limitation("LIMITATION-2-BRIDGE-COVERAGE") = {
  what: "bridge_statecanon.py has 23% test coverage",
  risk: high,
  impact: "Most likely point of silent failure when MCP changes",
  task: "RSI-BRIDGE-COVERAGE",
  approach: "Add tests for: MCP available, MCP unavailable, MCP timeout, MCP partial response",
  resolution: "RESOLVED — already has 27 tests with 100% coverage (2026-09-01 verification)",
}

limitation("LIMITATION-3-COUPLING") = {
  what: "vsf-rsi depends on internal structures of socratic-engine (signature, types)",
  risk: high,
  impact: "Internal changes in SE can break RSI silently until CI catches it",
  task: "RSI-CONTRACT",
  approach: "Define explicit Protocol/interface between packages; feature-detect at runtime (already done for enforce_limits)",
}

limitation("LIMITATION-4-SYNTHETIC-BENCHMARKS") = {
  what: "All testing uses synthetic data, not real agent workloads",
  risk: medium,
  impact: "Unknown behavior under production load",
  task: "RSI-REAL-BENCHMARKS",
  approach: "Record real agent sessions; replay through RSI pipeline; measure improvement",
}

limitation("LIMITATION-5-L3-VALIDATION-DEPTH") = {
  what: "L3 validation is AST parse only, no behavioral testing",
  risk: medium,
  impact: "A predicate can parse correctly but produce wrong results",
  task: "RSI-L3-BEHAVIORAL-VALIDATION",
  approach: "Run generated predicate against known-good inputs; check output matches expectation",
}

