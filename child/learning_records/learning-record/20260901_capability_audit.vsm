learning("LEARN-MOCK-SIGNATURE-MISMATCH") = {
  finding: "vsf-rsi integration tests used mocks that didn't mirror real SE signature",
  root_cause: "enforce_limits param added to real engine, mocks not updated",
  impact: "10 integration tests failed in CI (passed locally with real engine)",
  fix: "feature-detect with inspect.signature instead of hardcoding",
  applies_to: ["all cross-package tests", "any mock of external API"],
}

learning("LEARN-ADVISORY-NOT-FAILURE") = {
  finding: "session-report counted 'advisory' outcomes as failures",
  root_cause: "outcome != 'success' treated as failure, no 'advisory' bucket",
  impact: "50% of actions appeared to fail — misleading metrics",
  fix: "add 'advisory' outcome type to session-report",
  applies_to: ["all metric systems", "any outcome classification"],
}

learning("LEARN-CI-INSTALL-GAP") = {
  finding: "CI clones socratic-engine but doesn't pip install it",
  root_cause: "workflow step missing 'pip install -e ~/socratic-engine'",
  impact: "CI uses PyPI version (old) instead of latest code",
  note: "currently works because vsf-rsi feature-detects; but fragile",
  applies_to: ["CI pipeline design", "cross-repo dependency management"],
}

