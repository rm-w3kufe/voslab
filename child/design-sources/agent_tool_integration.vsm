⟦ agent_tool_integration | DESIGN-v1 | vsm-1.2.1 | 2026-08-31T14:30:00Z ⟧

@vsm 1.2.1
@status proposed

// Agent Tool Integration — socratic-engine, state-canon, vsf-rsi as integral
// parts of the agent's cognition, not additions to the improvement cycle.

@context {
  // Current agent writes .vsm files with format errors (footer 4-field instead
  // of NAME-ONLY). The safety net (vsl-check-on-write) has a path bug and
  // doesn't catch it. The root cause: the agent treats format rules as external
  // constraints to check AFTER writing, not as part of the writing process.
  //
  // Deeper issue: the agent uses grep + python3 for all work. socratic-engine,
  // state-canon, and vsf-rsi exist but are not integral to cognition. They
  // should be the PRIMARY tools, with grep/python3 as fallbacks.
}

@scope {
  domain: "agent_architecture",
  modules: ["socratic_engine", "state_canon", "vsf_rsi"],
  target: "agent_cognition"
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 1: Root Cause Analysis
// ═══════════════════════════════════════════════════════════════════════════════

§1.1 why_agent_writes_badly {
  // The agent's current writing process:
  
  current_process = {
    step1: "Think about what to write",
    step2: "Write the file",
    step3: "Hope it's correct",
    step4: "Maybe check with parser later"
  }
  
  problems = {
    p1: {
      name: "no_internalized_format",
      description: "Agent treats VSM format as external constraint, not internal knowledge",
      example: "Copied header format (4 fields) to footer, didn't know footer is NAME-ONLY"
    },
    p2: {
      name: "no_pre_write_validation",
      description: "Agent writes first, validates never",
      example: "Skipped vsl-check-on-write, didn't run parser"
    },
    p3: {
      name: "tools_not_integral",
      description: "socratic-engine, state-canon, vsf-rsi are optional extras",
      example: "Used grep/python3 for everything, didn't consult tools"
    }
  }
}

§1.2 what_tools_should_do {
  // Tools should be COGNITIVE PROCESSES, not external checks
  
  socratic_engine = {
    current: "Optional evaluator for specific questions",
   应该: "Primary decision-making process for EVERY action",
    example: "Before writing: evaluate 'is this format correct?' with a tree"
  }
  
  state_canon = {
    current: "Optional tracker for specific state",
   应该: "Continuous state awareness for EVERY action",
    example: "After writing: record 'file X now has version Y' in canon"
  }
  
  vsf_rsi = {
    current: "Optional learner for specific patterns",
   应该: "Continuous learning from EVERY outcome",
    example: "After success/failure: record pattern for future detection"
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 2: New Agent Architecture
// ═══════════════════════════════════════════════════════════════════════════════

§2.1 cognitive_loop {
  // The agent's new cognitive loop: think → evaluate → act → record → learn
  
  loop = {
    think: {
      description: "Understand the task and context",
      tools: ["state_canon (query current state)", "socratic_engine (evaluate options)"],
      output: "intention"
    },
    
    evaluate: {
      description: "Check if intention is correct before acting",
      tools: ["socratic_engine (evaluate decision tree)"],
      output: "certified_intention"
    },
    
    act: {
      description: "Execute the intention",
      tools: ["grep/python3 (implementation)"],
      output: "action_result"
    },
    
    record: {
      description: "Record what happened in state canon",
      tools: ["state_canon (record state change)"],
      output: "recorded_state"
    },
    
    learn: {
      description: "Learn from the outcome for future",
      tools: ["vsf_rsi (record pattern)"],
      output: "learned_pattern"
    }
  }
}

§2.2 tool_as_cognition {
  // Each tool becomes a cognitive process, not an external check
  
  socratic_engine_as_thinking = {
    before_writing: {
      question: "Is this format correct?",
      tree: {
        predicate: "and",
        children: [
          {predicate: "header_has_4_fields", args: {line: "$first_line"}},
          {predicate: "footer_is_name_only", args: {line: "$last_line"}},
          {predicate: "version_declared", args: {line: "$second_line"}}
        ]
      },
      action: "If not certified, fix BEFORE writing"
    },
    
    before_deciding: {
      question: "Is this the right approach?",
      tree: {
        predicate: "and",
        children: [
          {predicate: "aligns_with_purpose", args: {action: "$action"}},
          {predicate: "within_autonomy", args: {action: "$action"}},
          {predicate: "no_destructive_without_consent", args: {action: "$action"}}
        ]
      },
      action: "If not certified, reconsider approach"
    }
  }
  
  state_canon_as_memory = {
    after_every_action: {
      question: "What state changed?",
      action: "Record in state_canon",
      example: "file X: version 1.2 → 1.2.1"
    },
    
    before_every_action: {
      question: "What is current state?",
      action: "Query state_canon",
      example: "What version is file X? What files need migration?"
    }
  }
  
  vsf_rsi_as_learning = {
    after_every_outcome: {
      question: "What pattern should I remember?",
      action: "Record in vsf_rsi",
      example: "fault: wrong_footer → fix: name_only → outcome: success"
    },
    
    before_every_action: {
      question: "Have I seen this before?",
      action: "Match in vsf_rsi",
      example: "This looks like 'wrong_version' pattern → apply known fix"
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: Implementation
// ═══════════════════════════════════════════════════════════════════════════════

§3.1 phase_1_cognitive_foundation {
  // Make tools integral to cognition (1-2 sessions)
  
  deliverables = [
    "Rewrite agent's writing process: think → evaluate → write → record → learn",
    "Create decision tree for VSM format validation",
    "Register all current state in state_canon",
    "Record current patterns in vsf_rsi"
  ],
  
  verification = [
    "Agent evaluates format BEFORE writing (not after)",
    "Agent records state changes in state_canon",
    "Agent learns from each success/failure"
  ]
}

§3.2 phase_2_cognitive_integration {
  // Deepen cognitive integration (3-4 sessions)
  
  deliverables = [
    "Integrate socratic-engine into EVERY decision point",
    "Integrate state-can on into EVERY state change",
    "Integrate vsf-rsi into EVERY outcome",
    "Create feedback loops between tools"
  ],
  
  verification = [
    "Agent uses socratic-engine for all decisions (not just some)",
    "Agent records all state changes (not just migrations)",
    "Agent learns from all outcomes (not just fixes)"
  ]
}

§3.3 phase_3_cognitive_mastery {
  // Master cognitive integration (5+ sessions)
  
  deliverables = [
    "Agent automatically detects when tools are not being used",
    "Agent self-corrects to use tools appropriately",
    "Agent improves tool usage over time"
  ],
  
  verification = [
    "Agent notices when it's using grep instead of socratic-engine",
    "Agent notices when it's not recording state",
    "Agent notices when it's not learning from outcomes"
  ]
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: Success Criteria
// ═══════════════════════════════════════════════════════════════════════════════

§4.1 success_criteria {
  
  phase_1 = [
    "Agent evaluates format BEFORE writing (not after)",
    "Agent records state changes in state_canon",
    "Agent learns from each success/failure"
  ],
  
  phase_2 = [
    "Agent uses socratic-engine for ALL decisions",
    "Agent records ALL state changes",
    "Agent learns from ALL outcomes"
  ],
  
  phase_3 = [
    "Agent automatically detects tool non-usage",
    "Agent self-corrects to use tools",
    "Agent improves tool usage over time"
  ]
}

⟦ /agent_tool_integration ⟧