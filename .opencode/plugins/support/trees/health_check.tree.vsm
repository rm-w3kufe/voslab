⟦ health_check | SOCRATIC-TREE-v1 | vsm-1.2.1 | 2026-10-04T02:42:58Z ⟧

@vsm 1.2.1
@status active

// design: docs/spec_revision/design-sources/plugin-class-taxonomy-v1/plugin_class_taxonomy.vsm
// Migrated from ~/vsf 2026-10-04 (S5 containment); @vsm + timestamp
// normalized on write (vsm-1.2.1, real UTC, no :00).

// AUTO-CONVERTED decision()->socratic() (priority-preserving OR).
// Health check: any failed probe → critical/warning.
// Predicates: service_active, nats_reachable, nats_authenticated, disk_ok,
//   alerts_db_ok (in health_predicates module, loaded by service_watchdog).

socratic("health_check") = {
  op: OR,
  children: [
    { op: NOT, children: [ { predicate: "service_active", args: ["$ctx"] } ], home: "critical" },
    { op: NOT, children: [ { predicate: "nats_reachable", args: ["$ctx"] } ], home: "critical" },
    { op: NOT, children: [ { predicate: "nats_authenticated", args: ["$ctx"] } ], home: "critical" },
    { op: NOT, children: [ { predicate: "disk_ok", args: ["$ctx"] } ], home: "warning" },
    { op: NOT, children: [ { predicate: "alerts_db_ok", args: ["$ctx"] } ], home: "warning" }
  ],
  else_home: "unmatched"
}

⟦ /health_check ⟧
