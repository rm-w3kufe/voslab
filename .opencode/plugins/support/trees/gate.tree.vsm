// authority: BLOCKING (S3) — the only class with veto
//
// R10: every predicate here is a DETERMINISTIC builtin (certified=True)
// R9: UNKNOWN → '?' visible, never silent else_home
//
// v2 (2026-08-24, BUG-005 fix):
//   - VSL comments stripped by parse_socratic_block before evaluation
//   - ctx_equals/ctx_not_has registered in socratic_engine.py
//   - All predicates use $ctx explicit first arg (ctx_* convention)

socratic("GATE-TREE") = {
  op: AND,
  children: [
    { predicate: "ctx_has", args: ["$ctx", "staged_files"] },
    {
      op: OR,
      children: [
        {
          op: AND,
          children: [
            { predicate: "ctx_has", args: ["$ctx", "r18_check"] },
            { predicate: "ctx_equals", args: ["$ctx", "r18_check", "pass"] },
          ],
          home: "pass",
        },
        {
          op: AND,
          children: [
            { predicate: "ctx_has", args: ["$ctx", "r16_check"] },
            { predicate: "ctx_equals", args: ["$ctx", "r16_check", "pass"] },
          ],
          home: "pass",
        },
        {
          op: AND,
          children: [
            { predicate: "ctx_has", args: ["$ctx", "d7_check"] },
            { predicate: "ctx_equals", args: ["$ctx", "d7_check", "pass"] },
          ],
          home: "pass",
        },
        {
          op: AND,
          children: [
            { predicate: "ctx_not_has", args: ["$ctx", "r18_check"] },
            { predicate: "ctx_not_has", args: ["$ctx", "r16_check"] },
            { predicate: "ctx_not_has", args: ["$ctx", "d7_check"] },
          ],
          home: "pass",
        },
      ],
    },
  ],
  else_home: "fail",
}
