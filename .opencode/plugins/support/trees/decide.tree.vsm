socratic("DECIDE-TREE") = {
  op: AND,
  children: [
    { predicate: "ctx_has", args: ["$ctx", "decision"] },
    {
      op: OR,
      children: [
        { predicate: "ctx_has", args: ["$ctx", "alternatives"] },
        { predicate: "ctx_equals", args: ["$ctx", "skip_alternatives", "true"] },
      ],
    },
    {
      op: OR,
      children: [
        { predicate: "ctx_has", args: ["$ctx", "impact"] },
        { predicate: "ctx_equals", args: ["$ctx", "skip_impact", "true"] },
      ],
    },
    {
      op: OR,
      children: [
        { predicate: "ctx_equals", args: ["$ctx", "reversible", "true"] },
        {
          op: AND,
          children: [
            { predicate: "ctx_equals", args: ["$ctx", "reversible", "false"] },
            { predicate: "ctx_has", args: ["$ctx", "approved"] },
          ],
        },
        { predicate: "ctx_equals", args: ["$ctx", "skip_approval", "true"] },
      ],
    },
  ],
  else_home: "reject",
}
