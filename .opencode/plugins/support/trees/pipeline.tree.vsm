⟦ pipeline_triage | CLASS-PIPELINE-TRIAGE-v1 | vsm-1.2.1 | 2026-09-11T04:16:51Z ⟧

@vsm 1.2.1
@status active

// pipeline.tree.vsm — Sequential composition (nesting patterns).
// Source pattern: child pipeline_classify (classify -> route -> act).
// Stages share one verdict: every stage must pass (AND). Formalizes the
// pre-check composition as a named, reusable artifact (R10: deterministic).
// NOTE: predicate args take values ($tool/$file/$command resolve from ctx);
// recent_actions flows via kwargs where the caller provides it.
// TYPE convention: CLASS-* routes home='plugin' (support trees live here).
socratic("PIPELINE-TRIAGE") = {
  op: AND,
  children: [
    { predicate: "action_forbidden", args: ["$tool", "$file"], kwargs: {"command": "$command"} },
    { predicate: "path_forbidden", args: ["$file"], kwargs: {"tool": "$tool"} },
    { predicate: "write_scope_ok", args: ["$tool", "$file"] },
    { predicate: "not_redundant", args: ["$tool", "$file", "$command"] },
  ],
}
⟦ /pipeline_triage ⟧
