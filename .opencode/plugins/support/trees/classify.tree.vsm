        { predicate: "type_prefix", args: ["$type", "THEORY-DYN-"], home: "s4-intelligence" },
        { predicate: "type_prefix", args: ["$type", "THEORY-TS-"], home: "experiment" },
        { predicate: "type_prefix", args: ["$type", "THEORY-"], home: "system" },
        { predicate: "type_prefix", args: ["$type", "BOOT-ONTOLOGY-PATTERN-"], home: "sandbox" },
        { predicate: "type_prefix", args: ["$type", "BOOT-"], home: "boot" },
        { predicate: "type_prefix", args: ["$type", "S5-"], home: "s5-policy" },
