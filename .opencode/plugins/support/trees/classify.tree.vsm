        // consolidated study of this repo's ecosystem lives as a sandbox
        // (S5 q3 promotion lineage) — was falling to else_home=internal.
        { predicate: "type_prefix", args: ["$type", "CODEBASE-ECOSYSTEM-"], home: "sandbox" },
