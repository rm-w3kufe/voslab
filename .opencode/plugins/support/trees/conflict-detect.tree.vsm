⟦ conflict_detect_tree | CLASS-CONFLICT-DETECT-v1 | vsm-1.2.1 | 2026-09-29T14:15:25Z ⟧

@vsm 1.2.1
@status active

// conflict-detect — gap-engine tree (conflict-detection.gap.json).
// (FND-GAP-TREES-01: authored 2026-09-29; referenced file did not exist.)
//
// inputs (ctx, ACTUAL keys): content, exports, hasConflictMarkers
// (+ fileName, directory, ...). The def's hasConflict/conflictType keys
// are produced by NO gatherer — this tree uses what exists.
// Only base-engine predicates; booleans UNQUOTED (see classify-plugin).
//
// FUNCTION_OVERLAP on merge markers: '<<<<<<<' delimits two overlapping
// divergent versions of the same region — the single-file-visible form of
// an overlap. Cross-file overlap (two files exporting the same name) and
// semantic duplicates are NOT detectable with per-file context + current
// predicates (no array-duplicate or cross-file predicate exists) —
// documented limit, not silent: anything else => UNKNOWN (R9).

socratic("CONFLICT-DETECT") = {
  op: OR,
  children: [
    {
      op: AND,
      children: [
        { predicate: "ctx_has", args: ["$ctx", "content"] },
        { predicate: "ctx_contains", args: ["$ctx", "content", "<<<<<<<"] },
      ],
      home: "FUNCTION_OVERLAP",
    },
  ],
  else_home: "UNKNOWN",
}

⟦ /conflict_detect_tree ⟧
