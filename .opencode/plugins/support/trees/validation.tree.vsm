// validation.tree.vsm — Cross-domain regression tree (ported 2026-09-10).
// Source: ~/vsf/child/sandbox/multi-bridge-design/validation_tree.json
// Adapted domains: services/tasks/boot(child) -> tasks/queue(vOSlab).
// Semantics: AND( OR(data-source has records), OR(known-true, NOT(unknown)) ).
// Unknown domains MUST yield UNKNOWN (R9); NOT(UNKNOWN)=UNKNOWN propagates.
// Run: evaluate with an engine carrying canon_query (vsf_predicates.py).
socratic("VALIDATION-TREE") = {
  op: AND,
  children: [
    {
      op: OR,
      children: [
        { predicate: "canon_query", args: ["$ctx", "tasks", {}] },
        { predicate: "canon_query", args: ["$ctx", "queue", {"status": "pending"}] },
      ],
    },
    {
      op: OR,
      children: [
        { predicate: "canon_query", args: ["$ctx", "tasks", {"status": "done"}] },
        {
          op: "NOT",
          children: [
            { predicate: "canon_query", args: ["$ctx", "zzz_nonexistent", {}] },
          ],
        },
      ],
    },
  ],
}
