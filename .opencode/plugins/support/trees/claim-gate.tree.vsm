⟦ claim_gate | CLASS-CLAIM-GATE-v1 | vsm-1.2.1 | 2026-09-28T01:15:47Z ⟧

@vsm 1.2.1
@status active

// claim-gate — epistemic router tree (EPISTEMIC-CERT-001, EP-2, plan S3).
// Every proposition enters here; the winning child's home IS the route.
// Deterministic (R10), substrate-agnostic (S7: no substrate nouns).
// NOTE: comments live ABOVE the socratic block — the VSL mini-parser does
// not strip // inside the block (words would become sibling nodes).
//
// inputs (ctx, all strings):
//   claim_type          one of epistemic.CLAIM_TYPES
//   checkable           machine | partial | none
//   falsifier           true | false
//   risk                exploratory | internal | delivery
//   cert_present        true | false (hash-matched CRT in the store)
//   independent_source  true | false (evidence from 2 independent channels)
//
// routes (priority order = child order):
//   R0 RECYCLE       cert_present => link the existing CRT; no claim is
//                    certified twice (variety to the minimum)
//   R3 INTERPRETIVE  type=interpretation BEFORE the machine route: the
//                    semantic ceiling must never ascend via FORMAL/PREDICATE
//   R4 DECISION      type=decision => decide.tree (H2); blocked => FAIL
//   R1 MACHINE       checkable=machine => CRT FORMAL|PREDICATE.
//                    F16: type=conformance ^ risk=delivery requires
//                    independent_source=true (spec-expression vs
//                    implementation-expression; one desensitized channel
//                    proves self-consistency, not health)
//   R1-FAIL          the F16 violation itself: monocanal conformance@delivery
//                    => route R1, status FAIL, verdict FAIL, exit 1
//   R2 OBSERVED      falsifier=true => CRT PREDICATE|IDENTITY, ceiling
//                    OBSERVED (never CERTIFIED without FORMAL)
//   else R5 UNKNOWN  checkable=none ^ no falsifier => declared UNKNOWN
//
// output (router): { claim_id, route, status, verdict, required_certs[],
// f16, trace_id } — the trace lands in tree_traces with
// tree_shape=claim_gate(...).
//
// q (per node, F4 2026-09-30): the literal HUMAN QUESTION each node asks —
// persisted as node.question so a trace reads as questions, not only as
// formulae. Display layer (Spanish, engine-docstring convention); the
// predicate/args remain the machine form.

socratic("CLAIM-GATE") = {
  op: AND,
  q: "¿Qué ruta epistémica le corresponde a este claim?",
  children: [
    { predicate: "ctx_equals", args: ["$ctx", "cert_present", "true"], home: "R0",
      q: "¿Existe ya un certificado con hash coincidente (reciclar CRT, nunca certificar dos veces)?" },

    { predicate: "ctx_equals", args: ["$ctx", "claim_type", "interpretation"], home: "R3",
      q: "¿Es una proposición de interpretación? (techo semántico: jamás asciende a CERTIFIED)" },

    { predicate: "ctx_equals", args: ["$ctx", "claim_type", "decision"], home: "R4",
      q: "¿Es una decisión que debe pasar por decide.tree?" },

    {
      op: AND,
      q: "¿Puede ascender por la ruta máquina?",
      children: [
        { predicate: "ctx_equals", args: ["$ctx", "checkable", "machine"],
          q: "¿Es comprobable por máquina?" },
        {
          op: OR,
          q: "¿Evita ser conformance@delivery, o bien tiene segunda fuente?",
          children: [
            {
              op: NOT,
              q: "¿NO es conformance@delivery?",
              children: [
                {
                  op: AND,
                  q: "¿Es conformance en riesgo de entrega?",
                  children: [
                    { predicate: "ctx_equals", args: ["$ctx", "claim_type", "conformance"],
                      q: "¿Es un claim de conformance?" },
                    { predicate: "ctx_equals", args: ["$ctx", "risk", "delivery"],
                      q: "¿Está en riesgo de entrega?" },
                  ],
                },
              ],
            },
            { predicate: "ctx_equals", args: ["$ctx", "independent_source", "true"],
              q: "¿Tiene una segunda fuente independiente (escape F16)?" },
          ],
        },
      ],
      home: "R1",
    },

    {
      op: AND,
      q: "¿Es conformance@delivery monocanal (F16 violado)?",
      children: [
        { predicate: "ctx_equals", args: ["$ctx", "checkable", "machine"],
          q: "¿Es comprobable por máquina?" },
        { predicate: "ctx_equals", args: ["$ctx", "claim_type", "conformance"],
          q: "¿Es un claim de conformance?" },
        { predicate: "ctx_equals", args: ["$ctx", "risk", "delivery"],
          q: "¿Está en riesgo de entrega?" },
        { predicate: "ctx_equals", args: ["$ctx", "independent_source", "false"],
          q: "¿Carece de fuente independiente?" },
      ],
      home: "R1-FAIL",
    },

    { predicate: "ctx_equals", args: ["$ctx", "falsifier", "true"], home: "R2",
      q: "¿Tiene falsificador explícito? (vía R2, techo OBSERVED: nunca CERTIFIED sin FORMAL)" },
  ],
  else_home: "R5",
}
⟦ /claim_gate ⟧
