⟦ dependency_check_tree | CLASS-DEPENDENCY-CHECK-v1 | vsm-1.2.1 | 2026-09-29T14:15:25Z ⟧

@vsm 1.2.1
@status active

// dependency-check — gap-engine tree (dependency-validation.gap.json).
// (FND-GAP-TREES-01: authored 2026-09-29; referenced file did not exist.)
//
// inputs (ctx, ACTUAL keys): content, imports, dependencies (+ fileName,
// directory, ...). The def's missingDependencies key is produced by NO
// gatherer; imports/dependencies are ARRAYS and no predicate inspects
// array elements (ctx_contains is membership-only) — so this tree works
// on the content STRING.
// Only base-engine predicates; booleans UNQUOTED (see classify-plugin).
//
// MISSING_DEPENDENCY on absolute-path imports (from '/x', require('/x'):
// unresolvable outside the author's machine — portability breakage, the
// closest single-file-visible form of a missing dependency. LIMIT,
// documented: double-quoted variants (from "/x) are INEXPRESSIBLE — VSL
// strings are "..." with no escapes, so a pattern containing a double
// quote cannot be written (parser gap, follow-up). VERSION_MISMATCH needs
// environment introspection (no such gatherer/predicate) — unreachable,
// documented. Else UNKNOWN (R9).

socratic("DEPENDENCY-CHECK") = {
  op: OR,
  children: [
    {
      op: AND,
      children: [
        { predicate: "ctx_has", args: ["$ctx", "content"] },
        {
          op: OR,
          children: [
            { predicate: "ctx_contains", args: ["$ctx", "content", "from '/"] },
            { predicate: "ctx_contains", args: ["$ctx", "content", "require('/"] },
          ],
        },
      ],
      home: "MISSING_DEPENDENCY",
    },
  ],
  else_home: "UNKNOWN",
}

⟦ /dependency_check_tree ⟧
