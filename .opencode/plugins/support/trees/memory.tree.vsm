⟦ memory_route | CLASS-MEMORY-ROUTE-v1 | vsm-1.2.1 | 2026-09-11T04:16:51Z ⟧

@vsm 1.2.1
@status active

// memory.tree.vsm — Stateful routing on history (nesting patterns).
// Source pattern: child memory_classify (ctx.memory.past_results).
// Ours: recent_actions via inject_context (_context). A prior failure
// routes to ESCALATE (human review); otherwise PROCEED. Memory advises,
// never auto-acts. Engine injects _context when inject_context is set.
// TYPE convention: CLASS-* routes home='plugin' (support trees live here).
socratic("MEMORY-ROUTE") = {
  op: OR,
  children: [
    {
      op: AND,
      children: [
        { predicate: "prior_failure", args: ["$tool", "$file", "$command"], inject_context: true, result: {"home": "escalate"} },
      ],
      result: {"home": "escalate"},
    },
    { predicate: "not_redundant", args: ["$tool", "$file", "$command"], result: {"home": "proceed"} },
  ],
  result: {"home": "proceed"},
}
⟦ /memory_route ⟧
