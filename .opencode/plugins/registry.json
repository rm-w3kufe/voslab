{
  "$schema": "https://opencode.ai/registry.json",
  "version": "1.0.0",
  "description": "vOSlab plugin registry — declarative catalog of all plugins",
  "plugins": {
    "core": {
      "dir": "core",
      "plugins": {
        "vsl-check-on-write": {
          "file": "vsl-check-on-write.ts",
          "type": "daemon",
          "trigger": "tool.execute.after",
          "tools": ["write", "edit"],
          "scope": "*.vsm",
          "description": "R18 write-time conformance — validates VSM format on every write"
        },
        "vsl-measure-before-write": {
          "file": "vsl-measure-before-write.ts",
          "type": "advisory",
          "trigger": "tool.execute.before",
          "tools": ["write"],
          "scope": "*.vsm",
          "description": "Measure document metrics before write"
        },
        "vsf-naming-enforcer": {
          "file": "vsf-naming-enforcer.ts",
          "type": "daemon",
          "trigger": "tool.execute.after",
          "tools": ["write", "edit"],
          "scope": "*",
          "description": "Enforce naming conventions"
        },
        "vsf-policy-enforcer": {
          "file": "vsf-policy-enforcer.ts",
          "type": "daemon",
          "trigger": "tool.execute.after",
          "tools": ["write", "edit"],
          "scope": "*",
          "description": "Enforce policy compliance"
        }
      }
    },
    "manual": {
      "dir": "manual",
      "plugins": {
        "vsf-agent-vsl-gate": {
          "file": "vsf-agent-vsl-gate.ts",
          "type": "gate",
          "trigger": "manual",
          "description": "Agent VSL compliance gate"
        },
        "vsf-classify-on-write": {
          "file": "vsf-classify-on-write.ts",
          "type": "daemon",
          "trigger": "tool.execute.after",
          "tools": ["write"],
          "scope": "*.vsm",
          "description": "Classify document on write"
        },
        "vsf-script-classify-on-write": {
          "file": "vsf-script-classify-on-write.ts",
          "type": "daemon",
          "trigger": "tool.execute.after",
          "tools": ["write"],
          "scope": "*.py,*.ts,*.sh",
          "description": "Classify scripts on write"
        },
        "vsf-scripts-manifest-updater": {
          "file": "vsf-scripts-manifest-updater.ts",
          "type": "daemon",
          "trigger": "tool.execute.after",
          "tools": ["write", "edit"],
          "scope": "scripts/**",
          "description": "Update scripts manifest on change"
        },
        "vsf-hook-instances": {
          "file": "vsf-hook-instances.ts",
          "type": "advisory",
          "trigger": "tool.execute.after",
          "description": "Track hook instances"
        },
        "vsl-relocate-on-write": {
          "file": "vsl-relocate-on-write.ts",
          "type": "daemon",
          "trigger": "tool.execute.after",
          "tools": ["write"],
          "scope": "*.vsm",
          "description": "Relocate VSM files to canonical directory"
        }
      }
    },
    "operational": {
      "dir": "operational",
      "plugins": {
        "vsf-event-router": {
          "file": "vsf-event-router.ts",
          "type": "router",
          "trigger": "session.*",
          "description": "Central event router for handlers"
        },
        "vsf-onboard-reminder": {
          "file": "vsf-onboard-reminder.ts",
          "type": "reminder",
          "trigger": "session.idle",
          "description": "Remind about onboarding tasks"
        },
        "cycle": {
          "file": "cycle.ts",
          "type": "lifecycle",
          "trigger": "session.*",
          "description": "Session lifecycle management"
        },
        "remind": {
          "file": "remind.ts",
          "type": "reminder",
          "trigger": "session.idle",
          "description": "General reminder system"
        },
        "observe": {
          "file": "observe.ts",
          "type": "observer",
          "trigger": "tool.execute.after",
          "description": "Observe tool executions"
        },
        "gap-resolver": {
          "file": "gap-resolver.ts",
          "type": "resolver",
          "trigger": "session.idle",
          "description": "Detect and resolve autonomy gaps"
        },
        "lifecycle-autopilot": {
          "file": "lifecycle-autopilot.ts",
          "type": "lifecycle",
          "trigger": "session.*",
          "description": "Automated lifecycle management"
        },
        "lifecycle-discovery": {
          "file": "lifecycle-discovery.ts",
          "type": "discovery",
          "trigger": "session.init",
          "description": "Discover lifecycle components"
        },
        "tool-integration": {
          "file": "tool-integration.ts",
          "type": "integration",
          "trigger": "tool.execute.*",
          "description": "Tool integration bridge"
        },
        "backbone": {
          "file": "backbone.ts",
          "type": "integration",
          "trigger": "session.*",
          "description": "Integration backbone"
        },
        "learning-cycle-scan": {
          "file": "learning-cycle-scan.ts",
          "type": "scanner",
          "trigger": "session.idle",
          "description": "Scan for learning opportunities"
        },
        "scenario-memory": {
          "file": "scenario-memory.ts",
          "type": "memory",
          "trigger": "tool.execute.after",
          "description": "Scenario memory system"
        },
        "scenario-memory-gap-bridge": {
          "file": "scenario-memory-gap-bridge.ts",
          "type": "bridge",
          "trigger": "session.idle",
          "description": "Bridge scenario memory gaps"
        },
        "test-patch": {
          "file": "test-patch.ts",
          "type": "advisory",
          "trigger": "tool.execute.after",
          "description": "Test patch analysis"
        },
        "decide": {
          "file": "decide.ts",
          "type": "decision",
          "trigger": "tool.execute.before",
          "description": "Decision evaluation via socratic engine"
        }
      }
    },
    "support": {
      "dir": "support",
      "plugins": {
        "vsf-socratic-shell": {
          "file": "vsf-socratic-shell.ts",
          "type": "engine",
          "trigger": "manual",
          "description": "Socratic engine shell interface"
        }
      }
    }
  },
  "handlers": {
    "dir": "operational/handlers",
    "files": [
      "attestation.ts",
      "core-scripts.ts",
      "cyberfilter.ts",
      "gap-resolution.ts",
      "governance.ts",
      "hook-analytics.ts",
      "learning-cycle.ts",
      "lifecycle.ts",
      "services.ts",
      "session-hygiene.ts",
      "session-init.ts",
      "shared.ts",
      "state-reconcile.ts",
      "tasks.ts"
    ]
  },
  "trees": {
    "dir": "support/trees",
    "files": [
      "classify.tree.vsm",
      "gate.tree.vsm",
      "quality-gate.tree.vsm",
      "decide.tree.vsm",
      "adaptation.tree.vsm",
      "procedure-match.tree.vsm"
    ]
  },
  "gap-definitions": {
    "dir": "operational/gap-definitions",
    "files": [
      "code-classification.gap.json",
      "patch-detection.gap.json",
      "quality-gates.gap.json",
      "dependency-validation.gap.json",
      "conflict-detection.gap.json"
    ]
  }
}
