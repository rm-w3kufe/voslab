{
  "id": "code-classification",
  "name": "Code Classification",
  "description": "Classify new code and ensure it's in the correct directory. Uses socratic tree to determine proper category (core/operational/manual/support).",
  "trigger": {
    "type": "file-created",
    "patterns": [
      "*.ts",
      "*.py",
      "*.sh",
      ".tree.vsm",
      ".gap.json"
    ],
    "directories": [
      ".opencode/plugins/",
      "scripts/state/"
    ]
  },
  "context": {
    "gatherers": [
      {
        "type": "read-content",
        "lines": 100
      },
      {
        "type": "parse-imports"
      },
      {
        "type": "extract-exports"
      },
      {
        "type": "git-status"
      },
      {
        "type": "file-info"
      }
    ]
  },
  "evaluation": {
    "type": "socratic-tree",
    "tree": ".opencode/plugins/support/trees/classify-plugin.tree.vsm",
    "inputs": [
      "filePath",
      "fileName",
      "directory",
      "content",
      "imports",
      "exports",
      "gitStatus",
      "fileInfo"
    ]
  },
  "actions": [
    {
      "condition": "decision === 'WRONG_DIR'",
      "action": "move-file",
      "params": {
        "target": "recommendedDirectory"
      }
    },
    {
      "condition": "decision === 'UNKNOWN'",
      "action": "alert-conflict",
      "params": {
        "message": "Could not classify code - manual review needed"
      }
    },
    {
      "condition": "true",
      "action": "log-success"
    }
  ],
  "logging": {
    "destination": "agent-plugin-log",
    "format": "gap-resolution"
  }
}
