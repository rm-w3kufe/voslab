// ─── BRECHA: φ↑ pipeline clima→nucleus (2026-07-01) ───────────────────────
// Hallazgo: el pipeline de φ↑ desde S1-clima hacia el núcleo Rust (LXC 101)
// está declarado en los coupling manifests pero nunca fue cableado.
// Documentación completa para resolución con Claude Opus.

brecha("PHI-UP-PIPELINE", priority=CRITICAL, discovered="2026-07-01"):
  summary = "φ↑ pipeline S1-clima → nucleus: manifests declarados, pipeline no cableado"
  status = open

  context:
    // El coupling manifest de vsf-clima-kernel declara stasis_cos como sensor
    // con source=vsf.clima.continental.phi_up y read_kind=nats_subject.
    // El binario Rust de vsf-nucleus-operational tiene el código para cargar
    // coupling manifests (src/coupling_registry.rs) y subscribirse a NATS,
    // pero el pipeline está roto en tres niveles.

  findings = [

    "(1) Directorio de coupling manifests no existe en LXC 101",
    "    - Binario espera /etc/vsf/couplingsensors/ o $VSF_COUPLING_DIR",
    "    - Solo existen /etc/vsf/covenant.vsm y /etc/vsf/keys/",
    "    - No hay VSF_COUPLING_DIR en el entorno",
    "    - Evidencia: pct exec 101 -- find /etc/vsf -type d → solo keys/",
    "",
    "(2) Coupling manifests nunca desplegados",
    "    - 4 archivos .coupling.json existen en scripts/state/coupling_manifests/",
    "      (vsf-clima-kernel, vsf-econ-kernel, vsf-nucleus-operational, vsf-s3-star)",
    "    - Nunca fueron copiados a LXC 101",
    "    - No existe script deploy_coupling_manifests.sh",
    "",
    "(3) Rust kernel reports 0 manifests, 0 sensors en runtime",
    "    - Kernel tick events muestran manifests:0, sensors:0",
    "    - El código src/coupling_registry.rs existe pero encuentra directorio vacío",
    "    - Sin manifests → sin NATS subscriptions a vsf.clima.*",
    "",
    "(4) s4_clima_bridge.py es un workaround incompleto",
    "    - Bridge Python subscribe a vsf.clima.s4_context y escribe bundle a disco",
    "    - Bundle contiene stasis_cos=0.654, regime=quiescent, 4384 msgs recibidas",
    "    - Pero el kernel Rust nunca lee s4_clima_bundle.json",
    "    - 0 referencias a 'clima' en 1165 eventos de events.jsonl",
    "",
    "(5) Stasis_cos del nucleus es 100% interno, no agregado de S1",
    "    - stasis_cos=0.9998 basado en cpu_pressure, mem_pressure, invariant checks",
    "    - No incluye stasis_cos reportado por clima (0.654) ni por econ",
    "    - VAR-1 mide variety_delta interna, no stasis de dominio",
    "    - Lyapunov l_x=0.137 (divergencia local acotada, sistema bounded)",
    "",
    "(6) NATS subscriptions del nucleus no incluyen S1 φ↑",
    "    - Subs activas: vsf.<id>.phi_down.params, bbh.>, s5.covenant_halt",
    "    - NO hay subscription a vsf.clima.* ni vsf.econ.*",
    "    - nats_subH1 es handler de homeostasis interna, no de S1",

  ]  // end findings

  root_causes = [
    "A. INFRAESTRUCTURA — coupling manifests nunca desplegados al target",
    "   (no existe deploy step para coupling manifests en el pipeline CI/deploy)",
    "",
    "B. ARQUITECTURA — stasis_cos del kernel diseñado como métrica local interna",
    "   (Lyapunov sobre cpu_pressure + variedad interna, no sobre stasis de S1)",
    "",
    "C. INTEGRACIÓN — manifest-driven NATS subscriptions no implementadas",
    "   (código de carga de manifests existe pero subscriptions a S1 no fueron cableadas)",
    "",
    "D. WORKAROUND — s4_clima_bridge.py como bypass Python que nobody completa",
    "   (bridge escribe a disco, kernel nunca lee — pipeline termina en dead end)",
  ]

  impact:
    // El nucleus no puede detectar excursiones de S1-clima a través de stasis_cos.
    // EXP-S4-01-STRESS estresó LXC 101 (nucleus) y stasis_cos SUBIÓ a 0.9998
    // en vez de bajar — porque el S1-clima real está en LXC 112.
    // El sistema tiene un punto ciego: el S3 homeostático no recibe φ↑ de S1.
    "stasis_cos no refleja salud de S1 → S3 no puede bargainear recursos basado en estado real de clima",
    "Algedonic channel no recibe S1 φ↑ → S5 ciego a excursiones de dominio",
    "S4-MULTI-S1 cross-domain synthesis no puede funcionar sin pipeline de φ↑",
    "EXP-S4-01-STRESS inconcluso: estresó target incorrecto (LXC 101 vs LXC 112)",

  resolution_path:
    "Requiere Opus (arquitectura + diseño). Posibles enfoques:",
    "  A. Deploy coupling manifests + cablear manifest-driven NATS subscriptions",
    "  B. Que kernel lea s4_clima_bundle.json como fallback mientras se implementa A",
    "  C. Incorporar S1 stasis en stasis_cos del kernel como dimensión adicional",
    "Dependencias: src/coupling_registry.rs, src/ingest.rs, deploy scripts",
    "→ Para Claude Opus: revisar src/coupling_registry.rs y decidir ruta de integración"

  evidence:
    verify: [
      "strings /root/vsf-nucleus-operational | grep 'coupling_registry\|VSF_COUPLING_DIR'",
      "→ src/coupling_registry.rs, VSF_COUPLING_DIR — código existe",
      "",
      "ls -la /etc/vsf/couplingsensors/ 2>&1",
      "→ No such file or directory — directorio nunca creado",
      "",
      "python3 /tmp/pipeline_audit.py (deployed ds-n session)",
      "→ Clima global_stasis_cos=0.654, Nucleus stasis_cos=0.9998",
      "→ 0 referencias a clima en 1165 eventos",
      "",
      "strings /root/vsf-nucleus-operational | grep -E 'vsf\\.' | sort -u",
      "→ vsf.<id>.phi_down.params, bbh.>, s5 — NO vsf.clima.*",
      "",
      "cat /var/lib/vsf/vsf_nucleus/s4_clima_bundle.json | head -3",
      "→ Bundle existe con datos frescos pero nobody lo consume",
    ]

