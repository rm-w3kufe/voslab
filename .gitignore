# runtime logs (host/session data) — D-23 fixed 2026-10-06: the 3 live
# logs were tracked and hidden only by a local skip-worktree bit (lost on
# re-clone -> tree dirty -> boot gate red); they are UNTRACKED now so this
# rule actually applies. Committed .gz snapshots stay tracked, new
# rotations land ignored; view_log.py (code) stays tracked.
logs/

# RSI pipeline runtime state — learned weights, rewritten on every run
packages/public/vsf-rsi/adaptive_weights.json

# S5 containment (2026-10-04): vendored-package runtime state — metrics and
# scenario records are REWRITTEN on every verification/RSI run (same doctrine
# as adaptive_weights: knowledge snapshots live in state/, runtime stays out
# of git so the tree does not dirty on every operation).
packages/public/state/monitoring/
packages/public/state/l3_autonomous/
packages/public/state/rollback/
packages/public/state/shadow/
packages/public/learning_records/scenarios/
# test-generated forests: regenerated with fresh timestamps on every pytest
packages/.opencode/plugins/support/trees/forests/version_probe/
packages/.opencode/plugins/support/trees/forests/test_pred/
packages/.opencode/plugins/support/trees/generated/

# pip install -e artifacts
*.egg-info/

# ── state/: KNOWLEDGE tracked, RUNTIME excluded ──────────────────────────
# rmw3 2026-09-30 (luz verde): this instance (~/vOSlab) will NOT go public,
# but the next iteration ships as a package — keep the runtime/knowledge
# split clean so extraction moves only knowledge state (PACKAGING workstream).
# Never track key material.

# private key material — NEVER track
state/rsi/keys/
# runtime attestation blobs (74M)
state/rsi/attestations/
# shadow-eval runtime
state/rsi/shadow/
# gate-suite manifest cache (F3a run_gates live cache)
state/cache/
# learned weights (rewritten on runs)
state/rsi/l3/
# runtime traces / telemetry
state/rsi/tree_traces.jsonl
state/rsi/observer_actions.jsonl
state/rsi/alerts.jsonl
state/rsi/pleasure.jsonl
state/rsi/trust_spill.jsonl
state/rsi/read_sizes.jsonl
# runtime counters and registers
state/rsi/eval_counter.json
state/rsi/l3_budget.json
state/rsi/l3_sightings.json
state/rsi/detected_faults.json
state/rsi/.ga_last
state/rsi/.evolution_daily
state/rsi/.attest_prune_last
# workflow in-flight (consumed by rsi)
state/rsi/queue/
# per-event runtime registers (rewritten on every rsi cycle —
# demoted right after they proved churn in 90e26a6)
state/rsi/faults/
state/rsi/rollback/
# focus long-note archive (runtime; contract in docs/specs/focus_format.vsm)
state/focus_details/
# backbone lifecycle runtime (regenerate: python3 -m vos_kernel.backbone.integrate_modules)
state/backbone_events.jsonl
state/metrics/
state/backbone_status.json
state/component_registry.json
# lifecycle-autopilot runtime project state (D-28 — auto-written on
# session.created/idle + tracked writes; runtime, not knowledge)
state/lifecycle/
# socratic probe fixtures written by test_rsi_cycle t11/t12 (test
# runtime, not knowledge — same class as logs/ per D-32 hygiene)
packages/public/state/queue/

# runtime history
state/health_history.jsonl
state/integration_log.jsonl
# instrument-loader runtime (INSTRUMENT-OPERATOR-001: loader cursor +
# occasion-miss log — rewritten on every loader run)
state/instrument_loader_state.json
state/instrument_misses.jsonl
# runtime mirror of the root state tree (pre-migration leftover)
system/state/

# scripts/state: the CODE is tracked; runtime outputs are not
# plugin runtime outputs (metrics written cwd-relative)
.opencode/scripts/
scripts/state/**/__pycache__/
scripts/state/monitoring/*.json
scripts/state/monitoring/*.jsonl

