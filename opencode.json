{
 "$schema": "https://opencode.ai/config.json",
  "instructions": [
   "RULES.md"
  ],
 "model": "opencode/mimo-v2.6-flash-free",
 "default_agent": "vos-kernel",
 "references": {
  "focus": {
   "path": "current_focus.json",
   "description": "Active work tracking — what's happening RIGHT NOW"
  },
    "scripts": {
     "path": "scripts",
     "description": "Shared deploy scripts, state onboard, coupling manifests (internal since vsf decommission migration)"
    },
    "projects": {
     "path": "projects/vsf-nucleus/src",
     "description": "Rust kernel source (snapshot migrated 2026-10-06 — builds on LXC 108)"
    },
    "docs": {
     "path": "docs",
     "description": "VOSlab docs — START at docs/index.md: papers (attractor_convergence), theory, spec, glossary. Read papers via paper_data.vsm first"
    },
    "manifests": {
     "path": "scripts/state/coupling_manifests",
     "description": "DSN-COUPLE-01 coupling manifests (*.coupling.json) incl. vsf-clima-kernel"
    }
 },
 "mcp": {
  "state-canon-infra": {
   "type": "local",
   "enabled": true,
   "command": [
    "setsid",
    "-w",
    "bash",
    "-ic",
    "exec python3 \"$STATE_CANON_PATH/mcp_server.py\" --instance \"$STATE_CANON_PATH/instances/ssh_sqlite_ops.py:root@$VSF_N02,$VSF_STATE_DB\" --journal \"$VOSLAB_PATH/state_journal_infra.db\""
   ],
   "description": "State canon infrastructure (SSH to n02)"
  },
  "state-canon-mcp": {
   "enabled": true,
   "type": "local",
   "command": [
    "setsid",
    "-w",
    "bash",
    "-ic",
    "exec python3 \"$STATE_CANON_PATH/mcp_server.py\" --instance \"$VOSLAB_PATH/scripts/state/canon/voslab_instance.py:$VOSLAB_PATH/current_focus.json\" --journal \"$VOSLAB_PATH/state_journal.db\" --focus \"$VOSLAB_PATH/current_focus.json\" --schema-evo \"$VOSLAB_PATH/state/schema_evo.json\""
   ],
   "description": "State canon MCP (tasks + journal + focus + claim_states)"
  },
  "socratic-engine": {
   "type": "local",
   "enabled": true,
   "command": [
    "setsid",
    "-w",
    "bash",
    "-ic",
    "exec python3 \"$VOSLAB_PATH/.opencode/mcp/socratic_mcp_with_bridge.py\""
   ],
   "timeout": 60000
  },
  "parse-query": {
   "type": "local",
   "enabled": true,
   "command": [
    "setsid",
    "-w",
    "bash",
    "-ic",
    "exec python3 \"$VOSLAB_PATH/.opencode/mcp/parse_query_mcp.py\""
   ]
  }
 },
 "permission": "allow",
 "plugin": [
  ".opencode/plugins/core/vsl-check-on-write.ts",
  ".opencode/plugins/core/vsl-measure-before-write.ts",
  ".opencode/plugins/core/vsf-naming-enforcer.ts",
  ".opencode/plugins/core/vsf-policy-enforcer.ts",
  ".opencode/plugins/operational/vsf-agent-vsl-gate.ts",
  ".opencode/plugins/operational/vsf-classify-on-write.ts",
  ".opencode/plugins/operational/vsf-script-classify-on-write.ts",
  ".opencode/plugins/operational/vsf-scripts-manifest-updater.ts",
  ".opencode/plugins/operational/vsf-hook-instances.ts",
  ".opencode/plugins/operational/vsl-relocate-on-write.ts",
   ".opencode/plugins/operational/epistemic-claims-on-write.ts",
   ".opencode/plugins/operational/analytic-on-read.ts",
   ".opencode/plugins/operational/vsf-onboard-reminder.ts",
  ".opencode/plugins/operational/vsf-event-router.ts",
  ".opencode/plugins/operational/tool-integration.ts",
  ".opencode/plugins/operational/session-lifecycle.ts",
  ".opencode/plugins/operational/backbone.ts",
  ".opencode/plugins/operational/learning-cycle-scan.ts",
  ".opencode/plugins/operational/lifecycle-autopilot.ts",
  ".opencode/plugins/operational/lifecycle-discovery.ts",
  ".opencode/plugins/operational/decide.ts",
  ".opencode/plugins/support/vsf-socratic-shell.ts"
 ]
}
