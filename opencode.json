{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "../RULES.md"
  ],
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "vos-kernel",
  "references": {
    "focus": {
      "path": "current_focus.json",
      "description": "Active work tracking — what's happening RIGHT NOW"
    },
    "scripts": {
      "path": "../scripts",
      "description": "Shared deploy scripts, state onboard, coupling manifests"
    },
    "projects": {
      "path": "../projects/vsf-nucleus/src",
      "description": "Rust kernel source (read-only — builds on LXC 108)"
    },
    "docs": {
      "path": "../docs",
      "description": "Shared VSM specs, glossary, experiments, papers"
    },
    "manifests": {
      "path": "../scripts/state/coupling_manifests",
      "description": "DSN-COUPLE-01 coupling manifests (*.coupling.json)"
    }
  },
  "mcp": {
    "state-canon-infra": {
      "type": "local",
      "enabled": true,
      "command": [
        "python3",
        "${STATE_CANON_PATH}/mcp_server.py",
        "--instance",
        "${STATE_CANON_PATH}/instances/ssh_sqlite_ops.py:root@${VSF_N02:-n02},${VSF_STATE_DB:-/var/lib/vsf-state/state.db}"
      ],
      "description": "State canon infrastructure (SSH to n02)"
    },
    "state-canon-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "python3",
        "${STATE_CANON_PATH}/mcp_server.py",
        "--instance",
        "${STATE_CANON_PATH}/instances/tasks_provider.py:${VOSLAB_PATH}/current_focus.json",
        "--journal",
        "${VOSLAB_PATH}/state_journal.db",
        "--focus",
        "${VOSLAB_PATH}/current_focus.json"
      ],
      "description": "State canon MCP (tasks + journal + focus)"
    },
    "socratic-engine": {
      "type": "local",
      "enabled": true,
      "command": [
        "python3",
        "${VOSLAB_PATH}/.opencode/mcp/socratic_mcp_with_bridge.py"
      ]
    },
    "parse-query": {
      "type": "local",
      "enabled": true,
      "command": [
        "python3",
        "${VOSLAB_PATH}/.opencode/mcp/parse_query_mcp.py"
      ]
    }
  },
  "permission": "allow",
  "plugin": [
    ".opencode/plugins/core/vsl-check-on-write.ts",
    ".opencode/plugins/core/vsl-measure-before-write.ts",
    ".opencode/plugins/core/vsf-naming-enforcer.ts",
    ".opencode/plugins/core/vsf-policy-enforcer.ts",
    ".opencode/plugins/operational/vsf-agent-vsl-gate.ts",
    ".opencode/plugins/operational/vsf-classify-on-write.ts",
    ".opencode/plugins/operational/vsf-script-classify-on-write.ts",
    ".opencode/plugins/operational/vsf-scripts-manifest-updater.ts",
    ".opencode/plugins/operational/vsf-hook-instances.ts",
    ".opencode/plugins/operational/vsl-relocate-on-write.ts",
    ".opencode/plugins/operational/vsf-onboard-reminder.ts",
    ".opencode/plugins/operational/vsf-event-router.ts",
    ".opencode/plugins/operational/cycle.ts",
    ".opencode/plugins/operational/remind.ts",
    ".opencode/plugins/operational/observe.ts",
    ".opencode/plugins/operational/lifecycle-autopilot.ts",
    ".opencode/plugins/operational/lifecycle-discovery.ts",
    ".opencode/plugins/operational/tool-integration.ts",
    ".opencode/plugins/operational/session-lifecycle.ts",
    ".opencode/plugins/operational/backbone.ts",
    ".opencode/plugins/operational/learning-cycle-scan.ts",
    ".opencode/plugins/operational/scenario-memory.ts",
    ".opencode/plugins/operational/decide.ts",
    ".opencode/plugins/operational/socratic-hook-engine.ts",
    ".opencode/plugins/support/vsf-socratic-shell.ts"
  ]
}
