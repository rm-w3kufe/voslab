  answer(T1.R.selection, "Resolution choice"):
    selection: "R1 — Detailed balance applies ONLY to stochastic operator η, NOT to control operator f₀"
    justification:
      "Ax_SplitOperator: x(t+1) = f₀(x(t)) + σ(t)·η(t);
       f₀ encodes VSM asymmetry (directed φ↑/φ↓), η is isotropic gaussian (reversible);
       Lyapunov descent uses η-symmetry for noise bound, f₀-contraction for drift"

  answer(T1.Q1, "Preservation of ergodicity + E[ΔL]≤0 + asymmetry"):
    selection: "R1 satisfies all three"
    justification:
      "Ergodicity: η has full support on ℝ¹²⁸ ⇒ chain irreducible;
       E[ΔL]≤0: Thm_DirectExpansion uses ∇L·(f₀(x)-x)≤-ε + ½σ²‖∇²L‖_F bound;
       Asymmetry: f₀'s P(s|x) encodes directed VSM hierarchy; no reversibility required"

  answer(T1.Q2, "Markovian vs deterministic P(s|x) in f₀"):
    selection: "P(s|x) can be deterministic policy driven by trust/Ω-check"
    justification:
      "Def_PolicyMixing: f₀(x) = Σ_s 𝟙{policy(x)=s}·μ_s;
       policy: ℝ¹²⁸→{S1..S5} deterministic given trust, Ω, lifecycle;
       stochasticity enters ONLY via η; preserves E[ΔL]≤0 proof structure"

  answer(T1.Q3, "Status of π(x) ∝ exp(-λ·L(x)) under R1"):
    selection: "π exists as stationary measure of full chain, but NOT as Boltzmann of L alone"
    justification:
      "Ax_QuasiStationary: π satisfies π = π·(f₀+η) but π(x) ≁ exp(-λ·L(x)) due to f₀ asymmetry;
       Lyapunov proof does NOT require π to be Boltzmann; only requires contraction + bounded noise"

  new_definitions:
    Def_SplitOperator: "x(t+1) = f₀(x(t)) + σ(t)·η(t); f₀: asymmetric policy, η: isotropic reversible"
    Def_PolicyMixing: "f₀(x) = Σ_s 𝟙{policy(x)=s}·μ_s; policy: ℝ¹²⁸→{S1..S5} deterministic given Ω, trust"
    Ax_QuasiStationary: "π exists s.t. π = π·(f₀+η); π not Boltzmann; ergodicity via η full support"

  commitment:
