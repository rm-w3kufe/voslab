// ─── THE SYSTEM ──────────────────────────────────────────────────────────────

V("VSF") = {
  full_name: "Viable System Framework",
  origin:    Beer(1972).VSM,
  claim:     "a formal structure for systems that remain themselves while adapting",
  notation:  VSL  // Viable System Language — what you are reading now
}

// A viable system has five subsystems:

S1  // Operations    — the units that do actual work
S2  // Coordination  — prevents units from conflicting with each other
S3  // Control       — allocates resources, monitors performance
S3* // Audit         — sporadic direct channel — sees what S3 misses
S4  // Intelligence  — observes the environment, models the future
S5  // Policy        — defines purpose and limits that no subsystem can override

// These nest recursively:
// any S1 unit, if complex enough, is itself a full V(S1_unit) = ⟨S1, S2, S3, S3*, S4, S5⟩


// ─── CORE AXIOMS (abbreviated) ───────────────────────────────────────────────

A0:
  purpose(V) ∩ prohibited_set = ∅
  // V cannot act against its own declared purpose

A3:
  B(task) ≤ B_available(V)
  // Ashby's Law — a system can only govern what it has variety to match

A5:
  ∀ V'(task) spawned by V:
    S5'(V') ⊆ S5(V)
  // children cannot exceed the policy of their parent

recursion_axiom:
  complexity(S) > variety_ceiling(S) → S ≡ V'(S)
  S5 → V'(S5)  @forbidden
  // a subsystem that grows too complex recurses into a full VSM
  // except S5 — policy cannot delegate itself


// ─── VIABILITY CONDITION ─────────────────────────────────────────────────────

viable_beer(V, t) =
  viable(V, t)
  ∧ d/dt[viable(V)] ≥ 0
  ∧ adaptation_loop_active(S4, S3)

// a system is viable if:
//   it is viable now,
//   not becoming less viable over time,
//   and its adaptation loop is running


// ─── WHAT THIS IS USED FOR ───────────────────────────────────────────────────

// VSF is being built as a governance layer for AI systems.
// The same formal structure applies to any system:
//   a city, a company, an operating system, a conversation.
//
// The author (rmw3) is working on a Rust kernel (vsf-nucleus)
// that implements these axioms as executable code.


