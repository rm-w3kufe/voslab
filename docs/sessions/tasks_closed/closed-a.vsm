// ─── P0 DESTRUCTIVE: propuesta R17 (regla universal — decisión S5 rmw3) ─
task("R17-DESTRUCTIVE-EXPLICIT-CONSENT", priority=P0, agent=[S5], gate="S5 rmw3 — doble-loop (declarar regla en el canon boot)") = {
  status: done,
  recursion: "system → kernel (canon boot)",
  organ: "S5 (política) — propuesta preparada por S3",
  what: "PROPUESTA: declarar R17 en hard_rules.vsm (canon boot, PROTOCOL_VERSION
      3) — 'toda acción destructiva (kill-session, kill PID, pct destroy,
      rm -rf, git reset --hard fuera del propio branch) requiere confirmación
      EXPLÍCITA de rmw3 de ESA acción específica, en el MISMO turno, antes
      de ejecutar. Preguntar, esperar la respuesta.' Hoy solo es convención
      + task (DESTRUCTIVE-ACTION-EXPLICIT-OK); como regla universal de
      comportamiento de agentes encaja en hard_rules (no es instancia/
      state.db — gobierna al agente, declarada por S5, R7 rules wins).
      Precedente: R16 declarada 2026-08-14 (norma interna, no
      regulation_layer). Si se aprueba: añadir R17 tras R16 + fila en
      RULES.md + re-baseline primer + boot_manifest hashes.",
  done_when: "rmw3 decide: aprobar (R17 declarada + RULES.md + re-baseline)
      o rechazar (se mantiene convención + task, sin canon).",
  progress: "2026-08-15: propuesta preparada desde la auditoría de
      implementación (impl_audit_2026_08_15) — hallazgo (b): la política
      no está en el canon.
      APROBADA por rmw3 S5 2026-08-15 ('apruebo P0 - R17'). EJECUTADA:
      R17_destructive_explicit_consent declarada en hard_rules.vsm tras R16
      (con lección 2026-08-11 y nota R7 rules wins); fila R17 añadida en
      RULES.md (pointer → hard_rules.R17_destructive_explicit_consent,
      rationale DESTRUCTIVE-ACTION-EXPLICIT-OK); verify_boot_primer --update
      (6 hashes re-baselineados — RULES.md 0e748c3c→nuevo, producción
      BLOCKING verde). EVIDENCIA: vsl_parser --strict VALID (hard_rules);
      verify_boot_primer → '✓ sources unchanged'; R4.1 al commit.",
}

