@vsm 1.0
// D1-refined — V(kali, L+1) viability declaration with Qwen I3 materialization
// domain_context: {target=vsf-bbh operational integration, env=deployment_phase, layer=S5}
// builds_on: brief_20260510v2_bbh_vsf_integration_D1.vsm + VSL-REC-RES-03 (Qwen I3)
// includes: Qwen D3_1-D3_6 (algedonic_filter, DualTimer, trust_vec, quotas_auditor, escalation_SM, timing_diagram)
// audience: rmw3 (S5 approval), kernel architects, BBH operators

D1_refined("V(kali, L+1) viability declaration with cascade materialization"):

  // ─── Identity ─────────────────────────────────────────────────────────────

  identity:
    id          : "kali-n02"
    version     : "0.1.1-materialized"
    layer       : "L+1"
    parent      : "V(vsf, L)"
    governed_by : "V(vsf).S3 (vsf-nucleus @ n02 LXC 102) via φ↑↓ channels"
    S5_human    : "rmw3 ∈ V(vsf).S5 ∧ V(kali).S5"
    qwen_i3     : "Qwen materialization complete — D3_1-D3_6 integrated (2026-05-11)"

  // ─── Topology ─────────────────────────────────────────────────────────────

  topology:
    host        : "kali-n02 (VM 100 on n02 Proxmox)"
    location    : "LXC on n02 Proxmox (BBH-PROD)"
    access      : "ssh kali (10.10.30.100 via ProxyJump n02-tunnel)"
    vlan        : "VLAN30 (10.10.30.0/24)"
    firewall    : "DROP default inbound; exception SSH port 22"
    thermal_ceiling: "n02 Intel i7: 85°C hard pause, 75°C warning, <70°C normal"

  // ─── S-Levels with Qwen Cascade Integration ────────────────────────────────

  S1_operaciones:
    units  : ["bbh-profile", "bbh-passive", "bbh-active", "bbh-enum", "bbh-vuln"]
    engine : "Qwen2.5-coder:7b @ n02 LXC 101 via Ollama"
    policy : "read-only recon + detection only (ROE A3)"
    metrics: "7-12 parallel workers (nuclei, httpx, subfinder, amass), 3.2-4.8GB memory, findings_rate baseline TBD"

  S2_coordinacion:
    role    : "collision prevention"
    channel : "implicit via S3' (A4 satisfied)"

  S3_control_local:
    role      : "scheduler + resource manager + thermal governor + algedonic filter"
    mechanisms:
      mechanism_1_algedonic_filter: "src/agent/s4_algedonic.rs — Qwen D3_1"
        urgency_computation: "urgency = f(cpu_spike_duration, worker_count_delta, findings_rate_anomaly)"
        spike_suppression: "suppress if duration < 3s ∧ workers_ramping=true ∧ findings_rate within baseline±2σ"
        hybrid_thresholds: "relax θ_urgency during known perturbation phases (P1 subfinder, P3 nuclei-enum)"
        result: "algedonic φ↑ emitted only when: urgency=HIGH ∧ local_s3_exhausted=true"

      mechanism_2_thermal_scheduler: "thermal_scheduler.py (BUG-005/006/001 fixed)"
        thermal_limit: "85°C hard pause (inherited from V(vsf) ceiling)"
        cpu_limit: "90% CPU → reduce nuclei workers to 1"
        phase_checkpoint: "save state BEFORE timeout, resume from checkpoint (BUG-005 fix)"
        atomic_phase_complete: "set phase_complete.set() BEFORE triggering post-DONE (BUG-006 fix)"
        process_groups: "setsid() + SIGTERM handler + timeout SIGKILL fallback (BUG-001 fix)"

      mechanism_3_dual_timer: "DualTimer pattern — Qwen D3_2"
        kali_measure: "t_wait = time from φ↑ emit to φ↓ recv (measured by Kali S4)"
        nucleus_measure: "t_respond = time from φ↑ recv to φ↓ emit (measured by nucleus S4)"
        violation_trigger: "if max(t_wait, t_respond) > 15s → escalate CRITICAL"
        bbh_sla_alignment: "τ_rec=15s leaves 13.5min for BBH work within 15min SLA; 30s escalation timeout fits 5min pause budget"

      mechanism_4_token_budget: "per S1 unit budget assigned by S3'"
      mechanism_5_circuit_breaker: "S1 zero findings → pause + review"
      mechanism_6_quotas_monitor: "quotas_auditor.py — Qwen D3_4 (runtime preemptive throttle)"
        metric: "cgroup v2 memory.current + memory.high; CPU cpu.stat usage_usec/5s"
        preemptive_action: "if trending >90% B_hw: φ↓(preemptive_throttle, factor=0.8) before violation"

    telemetry_source : "CPU/memory: /proc/loadavg; thermal: /sys/class/thermal/; findings: bbh_metrics.db"
    alert_channel    : "bbs vsf-alerts (algedonic urgency HIGH)"

  S3_star_audit:
    channel  : "pct exec 105 (sporadic, no BBS — asymmetric by design per Cyberstride)"
    pattern  : "triggered by gate_4 escalation_rate ≥ A7_max (D2 viability_gates)"

  S4_inteligencia:
    role    : "BBH orchestrator + algedonic filter source + DualTimer controller"
    script  : "/root/bbh/orchestrator/s4_orchestrator.py"
    model   : "Qwen2.5-coder:7b (@ localhost:11434, LXC 101)"
    tools   : ["algedonic_filter.py (Qwen D3_1)", "tau_rec_validator.py (Qwen D3_2)", "target_scorer.py", "token_budget.py"]
    status  : "OPERATIONAL (post-implementation validation pending T5)"

  S5_policy:
    source  : "/root/vsf-bbh/roe.yaml"
    axioms  : "A1..A6 apply locally; rmw3 = dual S5 (V(vsf) and V(kali))"
    new_axioms: [
      "Ax_LocalEscalationOwnership: Kali S4 owns escalation state machine; nucleus φ↓ is advisory",
      "Ax_DeadlockGuard: max 2 escalations/min per task → abort + fail + retry",
      "Ax_HybridThresholds: θ_urgency relaxed during known_perturbation phases"
    ]

  // ─── Interfaces φ↑↓ with Qwen Materialization ────────────────────────────

  phi_up:
    channel   : "bbs vsf-results (post-phase_3_phi_up bootstrap)"
    frequency : "dual: algedonic 5s (high urgency), telemetry 30s (baseline)"
    algedonic_payload: "{ts, urgency, condition, escalation_rate, action, ROE_ref}"
    telemetry_payload: "{ts, stasis_cos, H, resources:{cpu,mem,token_left}, findings_rate, queue_depth}"
    dual_timer_spec: "Kali measures t_wait (φ↑ emit → φ↓ recv); nucleus measures t_respond (φ↑ recv → φ↓ emit); violation if max > 15s"

  phi_down:
    channel   : "bbs vsf-directives (post-phase_4_phi_down bootstrap)"
    schema    : "{ts, directive: throttle|pause|resume|abort, factor?, deadline, target_id}"
    escalation_sm: "state machine E1-E4 (Qwen D3_5) — Kali S4 executes; nucleus φ↓ advisory"
    state_flow: "IDLE → WAITING(30s) → [φ↓]APPLY | [timeout]ESCALATE | [count≥2]ABORT"
    deadlock_guard: "max 2 escalations/min → abort task + fail scan + retry with backoff"

  // ─── Viability Criteria with Qwen Gates ───────────────────────────────────

  viability:
    V_self: "stasis_cos ≥ 0.70 ∧ H(t) ≤ H_max (from D2 Lyapunov contraction)"
    V_bridge: "φ↑ active ∧ φ↓ listening ∧ DualTimer < 15s → V(kali)↔V(vsf) link alive"

    bbh_sla_benchmarks: "from Qwen D3_6 timing_diagram"
      wall_clock: "10-15 min for 100-target scan (SLA hard deadline)"
      thermal_max: "<80°C (no hard pause triggered)"
      pause_accumulated: "<2 min (within 5 min total budget)"
      workers_cleanup: "ps aux result empty post-scan"
      queue_state: "queue.json clean, no orphans"

    trust_vec_validation: "Qwen D3_3 — async gate with fallback"
      baseline: "(0.8, 0.85, 0.7, 0.75) = (reliability, responsiveness, capacity, alignment)"
      timing: "phase_1_wire starts async validation (30s timeout); first φ↑ blocked until complete OR timeout→θ_defaults"
      result: "safe coupling without 10min PRE delay"

    quotas_adherence: "Qwen D3_4 — hybrid Cor_NoCompose_1"
      pre_flight: "validator.py rejects if Σquota > B_hw (prevents unsafe coupling)"
      runtime: "quotas_auditor monitors trending; if >90% B_hw → φ↓(preemptive_throttle)"
      metric: "cgroup v2 memory.current + memory.high (not RSS) for accurate accounting"

    gates: [
      "gate_1_lyapunov: E[ΔL] < 0 over 5min (from D2)",
      "gate_2_budget: B_used ≤ B_quota (automatic via φ↓ throttle)",
      "gate_3_entropy: H(t) ≤ H_max (cooling phase triggers)",
      "gate_4_escalation: escalation_rate ≤ A7_max (triggers S3' audit)",
      "gate_5_dual_timer: τ_rec < 15s (coordinated Kali+nucleus measurement)",
      "gate_6_algedonic_filter: urgency HIGH ∧ local_degrade exhausted (suppresses LOW)"
    ]

  // ─── Open Questions (resolved by Qwen I3, some awaiting @BBH T5 data) ──────

  resolved_questions:
    Q1_algedonic_filter_location: "✓ Option A — Kali S4 (src/agent/s4_algedonic.rs)"
    Q2_tau_rec_measurement: "✓ Scenario C — DualTimer (both Kali wait + nucleus respond measured)"
    Q3_trust_vec_timing: "✓ Hybrid C — async validation with first φ↑ gate (no 10min delay)"
    Q4_cor_nocompose_validation: "✓ Hybrid A+C — pre-flight validator + runtime monitor"
    Q5_escalation_rules: "✓ State machine E1-E4 with deadlock guard (max 2/min)"

  pending_from_bbh_t5:
    baseline_findings_rate: "TBD — to be captured from 100-target scan (T5)"
    actual_thermal_baseline: "TBD — peak thermal under normal load (validate <80°C assumption)"
    actual_pause_budget_used: "TBD — total pause time accumulated (validate <2min typical)"

  // ─── Acceptance (updated for D1-refined) ───────────────────────────────────

  acceptance:
    test_d1: "python3 ~/vsf/scripts/vsl_parser.py brief_20260510v2_bbh_vsf_integration_D1.vsm --strict"
    test_d1_refined: "python3 ~/vsf/scripts/vsl_parser.py /root/bbh/viability.yaml --strict (after @BBH implements)"
    expected: "exit 0 ∧ no errors ∧ Qwen D3_1-D3_6 components compilable"

  // ─── Covenant Check (updated for integration) ───────────────────────────────

  covenant_check:
    A0    ✓ "single_loop — declaration only, no execution"
    A0.1  ✓ "read-only algedonic_filter (Qwen D3_1), no new harm vectors"
    A3    ✓ "entropy ceiling: H_max respected in escalation_SM (Qwen D3_5)"
    A4    ✓ "comms via S3-main (DualTimer nucleus measurement) + BBS — no sibling coupling"
    A5    ✓ "D1-refined emitted, awaiting rmw3 ack + @BBH T1-T5 completion before active wire"
    A6    ✓ "Qwen S4 at L ≥ 2 (LXC 101, not L0/L1)"
    A7_max ✓ "escalation rate ceiling enforced by gate_4 (D2)"

  // ─── Implementation Readiness ────────────────────────────────────────────────

  implementation_status:
    qwen_d3_integration: "COMPLETE — D3_1-D3_6 materialized into D1/D2 cascade"
    @bbh_task_t1_t3: "IN_PROGRESS — thermal_scheduler.py bugs T1-T3 (~4h estimated)"
    @bbh_task_t4: "IN_PROGRESS — VM 100 SSH restore T4 (~1.5h estimated)"
    @bbh_task_t5: "PENDING — baseline metrics validation T5 (~2h estimated, provides BBH SLA data for Qwen refinement)"
    @bbh_task_t6_t8: "PENDING — BBS integration + governance skeleton T6-T8 (~2.5h estimated)"

  // ─── Next Steps ───────────────────────────────────────────────────────────

  next_steps: [
    "1. @BBH: T1-T5 implementation (fix bugs, restore SSH, validate baseline) — deliver D1/D2 baseline metrics",
    "2. Claude I4: Complete D2-refined integration (D3_2/D3_3/D3_4/D3_5/D3_6 into kernel architecture)",
    "3. @BBH: T6-T8 execution (BBS integration, governance skeleton, full-stack validation)",
    "4. rmw3: Review D1-refined + D2-refined + HANDOFF approval session → authorize phase_1_wire",
    "5. phase_1_wire: kernel allocates Kali subspace, validator checks A0-A5, φ↑↓ comms live"
  ]

  deadline: "2026-05-12 EOD (BBH implementation + approval signatures)"

