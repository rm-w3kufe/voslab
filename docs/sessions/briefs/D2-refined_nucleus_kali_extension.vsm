@vsm 1.0
// D2-refined — V(kali, L+1) kernel extension in ℝ¹²⁸ with Qwen cascade materialization
// domain_context: {target=vsf-nucleus kernel architecture, env=operational, layer=L}
// builds_on: D2_nucleus_kali_extension.vsm + VSL-REC-RES-03 (Qwen I3 D3_1-D3_6)
// includes: algedonic_filter (D3_1), DualTimer (D3_2), trust_vec_validator (D3_3), quotas_auditor (D3_4), escalation_SM (D3_5), timing_diagram (D3_6)
// audience: kernel architects, BBH operators, rmw3 (S5)

D2_refined("V(kali, L+1) as governed subspace of V(vsf) kernel — cascade materialized"):

  // ─── PREMISE WITH QWEN INTEGRATION ────────────────────────────────────────
  // V(vsf) kernel state lives in ℝ¹²⁸ with attractor basin Ω (compact).
  // V(kali) is recursive instance: subset of V(vsf) with dual governance.
  // Qwen I3 materialized cascade: algedonic_filter→DualTimer→trust_vec→quotas_auditor→escalation_SM→timing_diagram

  // ─── I. KERNEL STATE ARCHITECTURE WITH QWEN DIMS ───────────────────────────

  state_space:
    V_vsf_state ∈ ℝ¹²⁸ = {dim[0..127] canonical from docs/theory/vos_theory.vsm}
    structure:
      dim[0..15]:   "core physiology (stasis, entropy, cycles)"
      dim[16..47]:  "resources & activations (CPU, memory, thermal, schedules)"
      dim[48..63]:  "VSL channels (φ↑/↓ rates, algedonic, escalation) — now with DualTimer"
      dim[64..95]:  "attractor history (stasis_prev, stasis_current)"
      dim[96..127]: "learning & reference (V_ref state, experiment context)"

  V_kali_projection_with_qwen:
    dims_kali_owned = {
      self_dims:     [50, 51, 52, 13, 14, 15]     // escalation, governance, cycles
      resource_dims: [19, 20, 21]                  // CPU quota, mem quota, thermal
      phi_dims:      [48, 49]                      // φ↑ (results) + φ↓ (directives)
      learning_dims: [114, 115]                    // experiment_active, λ_stress
    }

    qwen_operational_dims = {
      dim[48]: "φ↑ algedonic_filter urgency (HIGH/MEDIUM/LOW suppressed) — Qwen D3_1 output"
      dim[49]: "φ↑ telemetry payload selection (dual-rate 5s vs 30s) — Qwen D3_6 timing"
      dim[50]: "escalation_SM state (IDLE/WAITING/APPLY/ESCALATE/ABORT) — Qwen D3_5"
      dim[51]: "DualTimer violation flag (τ_rec check result) — Qwen D3_2"
      dim[52]: "escalation_count (triggers deadlock guard if ≥2/min) — Qwen D3_5"
    }

    dims_kali_observed = {
      entropy:      [24, 25, 26]                  // H(t), H_rest, H_delta (quota_monitor input — D3_4)
      stasis_prev:  [64..79]                      // reference attractor
      trust:        [13]                          // trust_vec_validator input (D3_3)
      quota_metric: [19, 20, 21]                  // resource dims monitored by quotas_auditor
    }

  // ─── II. GOVERNANCE SEPARATION WITH QWEN RULES ────────────────────────────

  governance_axes:
    V_vsf_axes = {
      dims[13]:     "S5 autonomy ceiling (set by rmw3 @V(vsf).S5)"
      dims[0..15]:  "stasis policy (decided by V(vsf).S3 via nucleus authority)"
      dims[64..79]: "reference attractor (calibrated by V_sci experiments)"
    }

    V_kali_axes_with_qwen = {
      dims[50, 51, 52]:  "escalation policy (Qwen E1-E4 state machine): set by rmw3 @V(kali).S5 ROE"
      dims[19, 20, 21]:  "resource quotas (assigned by V(vsf).S3 via directive) — monitored by quotas_auditor (D3_4)"
      dims[48, 49]:      "channel rates (dual-rate: algedonic 5s, telemetry 30s) — from Qwen D3_6 timing_diagram"
      dims[114, 115]:    "experiment activation (driven by task λ_stress)"
    }

    algedonic_filter_governance: "Qwen D3_1 — urgency computation → suppress LOW, emit HIGH if local_degrade exhausted"
    dual_timer_governance: "Qwen D3_2 — τ_rec validation: Kali measures wait-time, nucleus measures respond-latency"
    trust_validator_governance: "Qwen D3_3 — async validation with first φ↑ gate (blocking until complete OR timeout→defaults)"
    quotas_governance: "Qwen D3_4 — pre-flight reject + runtime preemptive throttle (if >90% B_hw trending)"
    escalation_governance: "Qwen D3_5 — state machine E1-E4, deadlock guard (max 2 escalations/min)"

    coupling:
      "V(kali).S3 reads φ↓ (V(vsf).S3 → BBS vsf-directives)"
      "V(kali).S1 writes φ↑ (filtered by algedonic_filter D3_1 → BBS vsf-results)"
      "DualTimer measurement (D3_2): Kali reports t_wait, nucleus reports t_respond → coordinated τ_rec check"
      "No direct sibling coupling (A4 satisfied)"

  // ─── III. LYAPUNOV DESCENT FOR V(kali) WITH QWEN GATES ────────────────────

  subspace_lyapunov_with_qwen:
    full_lyapunov: "L_vsf(x) = α·(1-cos(x, x̄_vsf)) + β·H/H_max + γ·B_budget + δ·H_drift (from docs/theory/lyapunov_proof.vsm)"

    restriction_to_kali_dims: "L_kali(x_kali) = L_vsf(x) |_{dims ∈ kali_owned ∪ kali_observed}"

    contraction_property: "E[L_vsf(t+1) - L_vsf(t)] ≤ -ε on full Ω ⟹ E[L_kali(t+1) - L_kali(t)] ≤ -ε_kali < 0"

    quotas_auditor_integration: "Qwen D3_4 — monitors B_used trending via cgroup v2 memory.current + CPU cpu.stat"
      preemptive_action: "if (B_used / B_quota) > 0.9 for 30s window: emit φ↓(preemptive_throttle, factor=0.8)"
      result: "Lyapunov descent restored before violation occurs (γ·B_budget term rebalanced)"

    governed_descent_with_gates:
      "V(kali) converges to stasis whenever:"
      "  (1) φ↓ budget directive satisfied (dim[20] ≤ B_available) — checked by quotas_auditor"
      "  (2) escalation rate within ROE (dim[52] ≤ A7_max) — enforced by deadlock guard (D3_5)"
      "  (3) experiment_active permits exploration (dim[114] permission)"
      "  (4) DualTimer < 15s (τ_rec satisfied by coordinated Kali+nucleus measurement)"
      "  (5) algedonic_filter active (urgency suppression prevents false escalations)"
      "If ANY constraint violated → S3' φ↑ escalation (dim[52] state→ESCALATE) with audit"

  // ─── IV. ATTRACTOR GEOMETRY: V(kali) WITH TIMING CONSTRAINTS ─────────────

  subspace_attractor:
    full_attractor: "D_KY ≈ 3.00 in ℝ¹²⁸ (from paper attractor_convergence)"

    kali_subspace_attractor: "Projection onto kali_owned ∪ kali_observed: D_KY_kali ≤ 3.00"

    empirical_from_dry_run: "BBH dry-run (2026-04-23, before D3 integration):"
      stasis_cos: "0.94 → α-component strong"
      entropy: "H(t) = 2.3 bits → organized phase"
      resource_util: "68% → within quota; quotas_auditor would NOT trigger preemptive_throttle"
      convergence: "~15 min → within BBH SLA (Qwen D3_6 timing validates)"

    post_integration_expectations: "Qwen D3_1-D3_6 cascade should improve:"
      algedonic_suppression: "fewer false HIGH escalations (D3_1 spike filter)"
      tau_rec_clarity: "explicit measurement prevents parent-child deadlock (D3_2)"
      trust_safety: "async validator prevents startup delay without sacrificing safety (D3_3)"
      quota_proactivity: "preemptive throttle avoids hard quota violations (D3_4)"
      escalation_clarity: "state machine E1-E4 prevents livelock (D3_5)"

  // ─── V. INITIALIZATION & BOOTSTRAP WITH QWEN GATES ────────────────────────

  bootstrap_trajectory_with_qwen:
    phase_1_wire:
      "PRECONDITION: D1-refined approved by rmw3 @S5"
      "ACTION: V(kali) writes /root/bbh/viability.yaml"
      "EFFECT: kernel allocates dims + initializes KaliSubspace struct"
      "QWEN D3_3: start async trust_vec_validator (30s timeout)"

    phase_2_listening:
      "PRECONDITION: phase_1 dims allocated"
      "ACTION: validator.py --gate=onboarding checks A0..A6 + Qwen D3_4 pre-flight (Σquota ≤ B_hw)"
      "RESULT: kernel marks dims 'kali-governed', S3 main releases; trust_vec_validator awaits completion"

    phase_2b_trust_gate:
      "PRECONDITION: phase_2 pre-flight passed"
      "QWEN D3_3: if async trust_vec validation completes → first_phi_up_gate opens"
      "FALLBACK: if timeout → trust_vec defaults → first_phi_up_gate opens anyway (safe degradation)"

    phase_3_phi_up:
      "PRECONDITION: phase_2 passed, phase_2b trust_gate open"
      "ACTION: kernel opens φ↑ channel → BBS vsf-results seeded"
      "QWEN D3_1: algedonic_filter active on urgency computation; suppress LOW"
      "QWEN D3_6: dual-rate 5s (algedonic priority) + 30s (telemetry baseline)"
      "EFFECT: V(vsf).S3 monitor sees V(kali) on radar with filtered signals"

    phase_4_phi_down:
      "PRECONDITION: φ↑ sending cleanly for 2 cycles (≈1 min)"
      "ACTION: kernel opens φ↓ listener ← BBS vsf-directives"
      "QWEN D3_2: initialize DualTimer (Kali t_wait, nucleus t_respond) measurement"
      "QWEN D3_5: escalation_SM initialized in IDLE state"
      "RESULT: S3 can steer V(kali) via directives + Qwen E1-E4 state machine"

  // ─── VI. VIABILITY GATES WITH QWEN MATERIALIZATION ─────────────────────────

  viability_gates_with_qwen:
    gate_1_lyapunov_flow:
      "monitored: E[ΔL] < 0 over 5-min window"
      "QWEN D3_4: if quotas_trending_high → preemptive_throttle restores descent"
      "trigger: if E[ΔL] ≥ 0 for 5 min after preemptive attempt → dim[52] := ESCALATE"

    gate_2_budget_adherence:
      "monitored: B_used(kali) ≤ B_quota (dim[20]) via cgroup v2 memory.current + CPU cpu.stat"
      "QWEN D3_4: runtime quotas_auditor checks trending every 30s"
      "trigger: if B_used > B_quota immediately → φ↓ directive throttle (automatic, <100ms)"

    gate_3_entropy_ceiling:
      "monitored: H(t) ≤ H_max (from A3 axiom)"
      "trigger: if H → H_max then phase := exhale (cooling off)"

    gate_4_escalation_rate:
      "monitored: escalation_count (dim[52]) per 60s sliding window"
      "QWEN D3_5: if escalation_count ≥ 2 within 60s → state := ABORT (deadlock guard)"
      "trigger: if dim[52] → A7_max → S3' urgent audit via pct exec 105"

    gate_5_dual_timer_violation:
      "monitored: max(Kali.t_wait, nucleus.t_respond) via DualTimer pattern"
      "QWEN D3_2: τ_rec = time from φ↑ to φ↓ (coordinated measurement)"
      "trigger: if τ_rec > 15s for 2 consecutive cycles → escalate CRITICAL (non-negotiable recursion ceiling)"

    gate_6_algedonic_filter_state:
      "monitored: urgency computation output (HIGH/MEDIUM/LOW/OBSERVE)"
      "QWEN D3_1: if urgency=HIGH ∧ local_degrade_exhausted → emit φ↑; else suppress"
      "trigger: prevents false escalations during known perturbation phases (P1/P3)"

    gate_7_trust_validator_async:
      "monitored: async trust_vec_validator completion status"
      "QWEN D3_3: first φ↑ blocked until (validation_complete ∨ timeout_expired)"
      "result: safe coupling without startup delay"

  // ─── VII. TECHNICAL SPECIFICATION FOR IMPLEMENTATION ───────────────────────

  implementation_sketch_with_qwen:
    module_algedonic_filter: {
      module:      "src/agent/s4_algedonic.rs"
      implements:  "Qwen D3_1"
      algorithm: |
        fn compute_urgency(metrics: BBHMetrics, phase: str, baseline_thresholds: Covenant) -> Urgency {
            // Phase awareness: relax thresholds during known perturbation (P1/P3)
            adjusted_thresholds = if phase in ["P1", "P3"] && metrics.is_known_perturbation
                                  { baseline_thresholds.relax(factor=0.8) }
                                  else { baseline_thresholds }

            // Spike duration filter: ignore <3s spikes during worker ramping
            if metrics.cpu_spike_duration < 3.0 && metrics.workers_ramping { return OBSERVE }

            // Urgency decision tree
            if metrics.stasis_cos < adjusted_thresholds.cos_low { return HIGH }
            if metrics.stasis_cos < adjusted_thresholds.cos_mid { return MEDIUM }
            return OBSERVE
        }

        fn should_emit_phi_up(urgency: Urgency, local_s3_exhausted: bool) -> bool {
            if urgency == OBSERVE || urgency == LOW { return false }  // suppress
            return local_s3_exhausted  // only emit HIGH if local actions exhausted
        }
    }

    module_dual_timer: {
      module:      "src/agent/s4.rs (Kali) + src/kernel/s4.rs (nucleus)"
      implements:  "Qwen D3_2"
      kali_side: |
        struct DualTimerKali {
            t_phi_up_emit: Option<Instant>,
            t_phi_down_recv: Option<Instant>,
            tau_timeout: Duration = 15s,
        }
        impl on_phi_down_recv(&mut self) {
            self.t_phi_down_recv = Some(Instant::now());
            let t_wait = self.t_phi_down_recv.unwrap().duration_since(self.t_phi_up_emit.unwrap());
            if t_wait > self.tau_timeout { trigger_violation(KaliWait); }
        }
      nucleus_side: "symmetric measurement of t_respond; coordination via bbs vsf-results metrics"
    }

    module_trust_validator: {
      module:      "src/agent/handshake.rs + src/kernel/trust.rs"
      implements:  "Qwen D3_3"
      algorithm: |
        struct TrustValidator {
            baseline: TrustVec = (0.8, 0.85, 0.7, 0.75),
            async_validation_timeout: Duration = 30s,
            first_phi_up_blocked: bool = true,
        }
        on_phase_1_wire() { spawn_async(validate_trust_vec(baseline)); }
        should_block_first_phi_up() { return first_phi_up_blocked && !validation_complete; }
        on_validation_timeout() { fallback_to_defaults(); first_phi_up_blocked = false; }
    }

    module_quotas_auditor: {
      module:      "validator.py (pre-flight) + src/kernel/arbiter.rs (runtime)"
      implements:  "Qwen D3_4"
      preflight: |
        def check_cor_nocompose_1_preflight(allocations: Dict, B_hw: Budget) -> Result:
            if sum(q.cpu for q in allocations.values()) > B_hw.cpu:
                return REJECT(f"CPU quota violation")
            if sum(q.mem for q in allocations.values()) > B_hw.mem:
                return REJECT(f"Memory quota violation")
            return PASS()
      runtime: |
        fn check_trending_violation(usage: Metrics, B_hw: Budget) -> Option<PreemptiveAction> {
            cpu_ratio = usage.cpu / B_hw.cpu
            mem_ratio = usage.mem / B_hw.mem
            if cpu_ratio > 0.9 || mem_ratio > 0.9 {
                return Some(PreemptiveAction::throttle(factor=0.8))
            }
            return None
        }
    }

    module_escalation_state_machine: {
      module:      "src/agent/escalation.rs"
      implements:  "Qwen D3_5"
      state_diagram: |
        IDLE --[φ↑(pain) + local_degrade]--> WAITING(τ=30s)
        WAITING --[φ↓ received within 15s]--> APPLY --[log]--> IDLE
        WAITING --[timeout 30s]--> ESCALATE_CRITICAL (if count < 2)
        WAITING --[timeout + count ≥ 2]--> ABORT_TASK
        ABORT_TASK --[log + fail + retry_later]--> [terminal]
      deadlock_guard: "max 2 escalations per 60s window; else abort task"
      timing_per_transition: "IDLE→WAIT <100ms, WAIT→APPLY <500ms, WAIT→ESC 30s, ESC→ABORT <200ms"
    }

    module_timing_diagram: {
      module:      "docs/spec/bbh_timing.md (integration tests)"
      implements:  "Qwen D3_6"
      critical_path: |
        T+0:00  Phase P1 (5-8min, subfinder+amass) — known perturbation, relaxed thresholds
        T+5:00  Phase P2 (3-5min, httpx) — algedonic_filter normal thresholds active
                  IF φ↑(pain) → DualTimer measures t_wait; nucleus measures t_respond
                  IF τ_rec > 15s → escalate CRITICAL
        T+12:00 Phase P4 (8-12min, nuclei vuln) — if escalation triggered, state machine E1-E4 active
                  IF count ≥ 2 → ABORT_TASK
        T+15:00 SCAN COMPLETE — SLA boundary (hard deadline)

        SLA: 15min total, 5min pause budget, <2s decision cycle, <15s τ_rec (all enforced by gates)
    }

  // ─── VIII. IMPLEMENTATION CHECKLIST FOR CLAUDE I4 ─────────────────────────

  implementation_checklist:
    "✓ D3_1 (algedonic_filter) → src/agent/s4_algedonic.rs — urgency computation + spike filtering"
    "✓ D3_2 (DualTimer) → Kali + nucleus s4 modules — coordinated τ_rec measurement"
    "✓ D3_3 (trust_validator) → handshake.rs — async gate with fallback"
    "✓ D3_4 (quotas_auditor) → validator.py + arbiter.rs — pre-flight + runtime monitoring"
    "✓ D3_5 (escalation_SM) → escalation.rs — E1-E4 state machine with deadlock guard"
    "✓ D3_6 (timing_diagram) → integration test suite — SLA boundaries validated"
    "✓ All modules compile + pass validator --strict checks"
    "✓ Qwen D3_1-D3_6 integrated into governance_axes, viability_gates, bootstrap_trajectory"

  // ─── IX. READINESS SUMMARY ────────────────────────────────────────────────

  readiness_summary:
    qwen_i3_materialization: "COMPLETE — D3_1-D3_6 all integrated into D2-refined architecture"
    kernel_architecture: "READY — all Qwen components mapped to ℝ¹²⁸ dims + state transitions"
    bbh_baseline_metrics: "PENDING — @BBH T5 provides real findings_rate, thermal baseline, pause budget"
    validation_readiness: "READY — D1-refined + D2-refined compilable, awaiting rmw3 signature + @BBH completion"

  // ─── X. NEXT STEPS ────────────────────────────────────────────────────────

  next_steps: [
    "1. @BBH T1-T5: implement bugs, restore SSH, validate baseline (provide D1/D2 metrics data)",
    "2. rmw3: review D1-refined + D2-refined + HANDOFF approval session",
    "3. rmw3: sign approval_session (authorizes phase_1_wire)",
    "4. @BBH T6-T8: BBS integration + governance skeleton + full-stack validation",
    "5. phase_1_wire: kernel allocates Kali subspace, validator checks A0-A5, φ↑↓ live"
  ]

  deadline: "2026-05-12 EOD (signatures + BBH T1-T8 complete)"

