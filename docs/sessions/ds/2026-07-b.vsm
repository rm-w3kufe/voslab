session("2026-07-27-ds-investigation") = {
  summary: "MERKLE-BREAK-POST-FIX-CLUSTER investigation — 8 merkle_break sev=10 events traced to serde_json dep skew",
  result:  pass,
  resolved: [
    "MERKLE-BREAK-POST-FIX-CLUSTER — per-event investigation complete.
     All 8 events: CLEAN per independent verifier (verify_chain_diverse.py).
     Root cause: serde_json 1.0.149 (nucleus) vs 1.0.150 (s3-star).
     Cargo.lock differs between the two builds → same serde_json source code
     ('=1') resolved to different patch versions. canonical_hash computation
     depends on serde_json serialization order; v1.0.150 produces different
     bytes than v1.0.149 for the same event → recomputed hash ≠ stored hash.
     NOT real tamper. NOT buffer drift. Build/dependency skew.",
  ],
  data_collected: [
    "All 8 events located in LXC 101 events.jsonl at lines 519095-521071",
