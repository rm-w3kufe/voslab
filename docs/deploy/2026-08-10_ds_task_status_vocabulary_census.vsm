closed_vocabulary("proposal-v1") = {
  note: "8 tokens. seeded collapses to open (seed semantics live in the
      what:/comment, not the status). dropped is reserved (no current uses)."
  token_open:        "work exists, not started, no external dependency"
  token_in_progress: "work underway (incl. partial/design/skeleton/dispatch states)"
  token_blocked:     "stopped by unmet internal precondition"
  token_gated:       "stopped awaiting an external decision (S5/rmw3/[O] review, deploy prep)"
  token_done:        "complete; archive-decidable"
  token_superseded:  "absorbed/obsoleted/folded/stale — keep record, not actionable"
  token_dropped:     "abandoned (reserved; none currently in file)"
  token_legacy:      "historical bookkeeping entry, never actionable"
}

