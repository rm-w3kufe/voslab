  // ═══════════════════════════════════════════════════════════════════════

  bug_1_cadence: {
    diagnosis: {
      config_file: "/etc/vsf/s5_policy.json (LXC 107)",
      legacy_field: "channel_rate_limits.audit_sample_rate_per_24h = 0.01
