        rate: "86400 / (20 × 60) = 72/day → mean interval 1200s. Verified
            against docs/spec/s3star_epistemic_independence.vsm tier_3
            intent (Poisson sampling for independent recomputation), NOT
            a blind copy of the stale note's '24'.",
      },
    },

    fix_applied: {
      backup: "cp /etc/vsf/s5_policy.json /etc/vsf/s5_policy.json.bak-dualbug-20260804",
      change: "python3 set s3_star.sample_rate_per_24h = 72 (was 24),
          appended _sample_rate_note",
      verified_config: "python3 -c json load → 'after 72'",
      restart: "systemctl restart vsf-s3-star on 107 → MainPID 13221",
