// preserved as earliest observation.

report(q17.phase_1) = {
  status:        "deployed and unverified (tunnel drop precluded restart)",
  deployed_sha:  "b1393246 (repo = deployed, LXC 104 /usr/local/bin/vsf_s5_ledger.py)",
  deploy_lxc:    104,
  service:       "vsf-s5-ledger (inactive at last check — needs restart)",
  acceptance_A1: "not verified — service was not running during tunnel window",
  acceptance_A2: "not verified — same reason",
  acceptance_A3: "not verified — same reason",
  note:          "The schema was already ALTERed in a prior migration: fingerprint,
                  dup_count, first_ts, evidence_json columns exist on the live
                  algedonic_ledger. The phase_1 code references them correctly.
                  Acceptance requires the service to be running and processing
                  live algedonic events for at least one full 5-min cycle.",
