⟦ relocate_vsm_spec | RELOCATE-VSM-v1 | vsm-1.2.1 | 2026-08-17T02:58:03Z ⟧

@vsm 1.2.1
@status active
// docs/spec_revision/design-sources/relocate-vsm-v1/relocate_vsm_spec.vsm
// PROMOTED 2026-08-15 (A5 rmw3) — from sandbox/relocate-vsm-plugin/ to
// design-sources/ (PROMOTE-AGENT-POLICY; RELOCATED from
// system/s5-policy/agent-policy/design-sources/ 2026-08-17 per
// CLASSIFICATION-POLICY-PLAN — design-sources/ is level-1, NOT policy).
// @status: active.
// RELOCATE-VSM — proposal for the automatic relocation hook/plugin of
// documents @vsm 1.0. Sandbox rail (rectification 2026-08-14): the
// proposal is validated BEFORE implementing in .opencode/plugins/.
// Owner: S3 plan · Recursion: system/L1 · Organ: S2 (prevent footguns
// between agents when moving docs) · Channels: φ↓ S5 directive → φ↑ proposal.

// ─── MOTIVATION (incident 2026-08-14, DIR-SCHEMA-RECURSIVE) ────────────────
fact("incident-2026-08-14") = {
  body: "Moving 29 docs @vsm 1.0 (matryoshka schema) took ~90% of the
        effort in re-locating pinned refs: internal headers + refs in
        revision_plan/ledger/census_docs/worklist/instance/validation/sandbox/
        child + hash re-baselining. All manual, error-prone (2 thermal_stress
        refs stayed broken for a commit).",
  why:  "Without automation, every future restructure repeats the cost and
        risks broken refs that the gates detect late.",
  apply: "Moving a .vsm MUST be an automatic task: a hook remaps, the human
         only decides WHERE the document goes."
}

// ─── DESIGN ─────────────────────────────────────────────────────────────────
design("relocate-vsm") = {
  hook:     "tool.execute.after — .opencode/plugins/vsl-relocate-on-write.ts
             intercepts bash when the command contains 'git mv' + a .vsm",
  script:   "scripts/docs/relocate_vsm.py — deterministic engine:
             args: --from <path> --to <path> [--dry-run]",
  corpus:   ["docs/spec_revision/", "docs/experiments/", "docs/plan/",
             "TASKS.vsm", "child/sandbox/", "scripts/"],
  exclude:  ["docs/archive/", "docs/sessions/", "child/docs/archive/",
             "node_modules/", ".git/"],
  steps: {
    s1: "git mv --from --to (the plugin assumes the user already moved it or the script does it)",
    s2: "internal header: // <old_path> → // <new_path> in the moved doc",
    s3: "corpus remap: grep -rl '<old_path>' corpus → sed to '<new_path>'",
    s4: "re-baseline hash in boot_manifest.vsm if the doc is declared",
    s5: "post-move census: 0 new broken refs (verify_claim instrument)",
  },
  verify: {
    v1: "selftest: move a test doc docs/spec_revision/sandbox/ → system/
        and back → refs remapped, 0 broken",
    v2: "python3 scripts/vsl/verify_boot_ontology.py → clean",
    v3: "not_prose_gate → PASS (the sed does not introduce ¬ prose)",
    v4: "checks R4.1 → green",
  },
  gate2: "Promotion to .opencode/plugins/ requires: selftest PASS + verifier
          green + S3/S5 approval (this validated proposal).",
}

// ─── EXPLICIT SCOPE (what it does NOT do) ───────────────────────────────────
scope("not-do") = {
  n1: "DOES NOT move files by itself — the plugin decides the destination
       ONLY if the git mv command already specifies it; never guesses paths.",
  n2: "DOES NOT touch docs/archive/, docs/sessions/ (historical records — R5).",
  n3: "DOES NOT remap refs outside the declared corpus (docs/theory/ v1,
       docs/papers/ are a historical tree, they stay).",
  n4: "DOES NOT rewrite semantics: only file paths (refs to .vsm).",
}

// ─── ACCEPTANCE CRITERIA ────────────────────────────────────────────────────
done_when: "selftest PASS (test doc moved round-trip, 0 broken refs) ∧
            verifier green ∧ plugin registered in opencode.json ∧
            post-move re-census check integrated ∧ proposal promoted from
            the sandbox."
⟦ /relocate_vsm_spec ⟧