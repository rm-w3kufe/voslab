@vsm 1.2.1
@status active

// sandbox/vsf_event_logging_design.vsm — design spec for event-driven logging.
// This is the R16 design source for: event-log.sh, event-log.ts,
// vsf-event-router.ts, handlers/*.ts

overview: "compact event logging for VSF plugin system",

design: {
  format: "pipe-separated tuple, one record per line",
  files: {
    summary: "logs/events.jsonl — 1 line per event",
    trace: "logs/events_verbose.jsonl — 1 line per handler (optional)",
    legacy: "logs/agent_plugin.jsonl — backward compat (JSON)",
  },
  fields: {
    summary: "ts|event_id|hook|handlers_total|handlers_ok|handlers_skip|duration_ms|summary",
    trace: "ts|event_id|hook|handler|result|duration_ms|detail",
  },
  principle: "logging is automatic — scripts write, agent never touches logs",
},

architecture: {
  router: "vsf-event-router.ts — pure routing, classify → execute → log",
  handlers: [
    "learning-cycle.ts — session.idle, priority 1",
    "session-hygiene.ts — session.idle, priority 2",
    "state-reconcile.ts — session.idle, priority 3",
    "session-init.ts — session.start, priority 1",
  ],
  logging: "event-log.ts + event-log.sh — compact pipe-separated format",
},

⟦ /vsf_event_logging_design ⟧
