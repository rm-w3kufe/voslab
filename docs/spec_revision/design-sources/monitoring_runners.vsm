⟦ monitoring_runners | HARDENING-GAPS-v1 | vsm-1.2.1 | 2026-10-21T07:04:05Z ⟧

@vsm 1.2.1
@status active

// MONITORING RUNNERS — design unico de la flota de timers vsf + registro
// en lote de scripts/monitoring (T4-F1 + T7-F2, plan structural-tensions
// 2026-10-20). Evidencia T4: la brecha dev-shell vs systemd duro >=2 dias
// existio porque NINGUN modelo de S4 declaraba env/cwd/deps de cada
// runner. Contrato de unidades: los .service NO fijan Environment ni
// WorkingDirectory (cwd = $HOME del user manager) — todo runner debe
// auto-localizarse (walk-up/absoluto) y no depender del env heredado.
// T7: este doc ES el manifest de registro — cada header `# route:` de los
// runners y units apunta a su entrada aqui (registro en lote 2026-10-21).

// Entrada canonica: <u>.service ExecStart = entry_point; el par
// ~/.config/systemd/user/<u> es symlink -> scripts/monitoring/<u> (linked
// + enabled). OnCalendar BARE = hora LOCAL (regla systemd; sin sufijo Z).

flota = [
  { u: "vsf-scheduled-suite.timer", horario: "cada hora en :17 (local)",
    entry_point: "vsf-scheduled-suite.service -> vsf-scheduled-suite.sh -> exec scheduled_suite.py",
    env: "PATH del user manager; KAGGLE_CONFIG_DIR por defecto $HOME/.kaggle; SIN VOSLAB_PATH (corrida strippada por diseno — el canary D-SA3 vive en este ciclo)",
    cwd: "$HOME (unit sin WorkingDirectory) — scheduled_suite.py rutea todo por ruta absoluta VOS=/home/rmw3/vOSlab (inmune a cwd y env)",
    python: "python3 via PATH del user manager",
    deps: "run_gates + variety_census + external_detectors + pytest canary (3 tests D-SA3) + state/monitoring/*.json + logs/agent_plugin.jsonl + ~/.kaggle (external-run)",
    checks: "ciclo horario: run-gates (86 live + 27 NC) + variety-census + external-run + env-parity-canary; shadow 7 ciclos log-only -> alert HEALTH algedonica",
    design: "shadow-scheduled-suite-design.vsm (ratificado S5 2026-10-20)",
    verify: "test_atomic_writers (stamp atomico) + check systemd-units-fresh" },
  { u: "vsf-gates-daily.timer", horario: "06:15 local (Description 'UTC' era stale — corregido 2026-10-21)",
    entry_point: "vsf-gates-daily.service -> vsf-gates-daily.sh",
    env: "user manager; sin vars extra; el script solo exporta KAGGLE no — no aplica",
    cwd: "$HOME — el script no hace cd: los checks self-locan via BASH_ROOT walk-up (T1 runner-parity)",
    python: "python3 (heredoc inline para append de alerta)",
    deps: "checks/plan-tree-valid, dir-schema-valid, classification-valid; state/rsi/alerts.jsonl (append)",
    checks: "trio rapido de consistencia doc diario; PASS silencioso, FAIL append UNA alerta gates_daily_fail",
    design: "driver-topology-v1/driver_topology.vsm",
    verify: "sin test unitario propio — verificacion = rc + alerta fail-loud + smoke T4-F2 (deuda visible, comentario en el .sh)" },
  { u: "vsf-docs-reconcile.timer", horario: "06:45 local (Description 'UTC' era stale — corregido 2026-10-21)",
    entry_point: "vsf-docs-reconcile.service -> vsf-docs-reconcile.sh",
    env: "user manager; sin vars extra",
    cwd: "$HOME — rutas absolutas al repo en el script",
    python: "python3 scripts/shared/docs_reconcile.py --check",
    deps: "arbol docs/ + state/doc_tracking (model≡reality); alerts.jsonl (append)",
    checks: "drift de inventario de docs diario; FAIL append UNA alerta docs_reconcile_fail + rc",
    design: "driver-topology-v1/driver_topology.vsm",
    verify: "sin test unitario propio — verificacion = rc + alerta fail-loud + smoke T4-F2 (deuda visible)" },
  { u: "vsf-gates-weekly.timer", horario: "domingo 04:00 local (Persistent=true; Description/UTC stale corregido 2026-10-21)",
    entry_point: "vsf-gates-weekly.service -> vsf-gates-weekly.sh",
    env: "user manager — sin VOSLAB_PATH (la pierna pytest corre strippada por diseno)",
    cwd: "cd $REPO_ROOT DENTRO del script (fix A4 2026-10-20: 4 reds desde HOME — lesson registrada)",
    python: "python3 (run_gates) + python3 -m pytest corpus con --import-mode=importlib",
    deps: "run_gates.py + corpus packages/ + system/kernel/ (1 deselect honesto KNOWN-RED); alerts.jsonl (append)",
    checks: "suite completa semanal + pytest corpus (~3.5min); FAIL append UNA alerta gates_weekly_fail (class HEALTH/REVERIFY en alert_triage)",
    design: "PENDING -> monitoring_runners.vsm (unit + .sh sin design propio, se adhieren al unico)",
    verify: "test_alert_triage (clase gates_weekly_fail) + canary env-parity horario" },
  { u: "vsf-restore-drill.timer", horario: "domingo 05:00 local (1h despues del weekly; intencion explicita en el unit)",
    entry_point: "vsf-restore-drill.service -> vsf-restore-drill.sh -> restore_drill.py --dest /tmp/vsf-restore-drill/<ts>",
    env: "user manager; sin vars extra",
    cwd: "$HOME — rutas absolutas; destino efimero en /tmp (sin rm: tmpfiles del OS, R17)",
    python: "python3 scripts/state/monitoring/restore_drill.py",
    deps: "state/rsi/snapshots/ + index.jsonl (fuente solo-lectura); alerts.jsonl (append)",
    checks: "ensayo G-07 de RTO semanal; rc!=0 (incl. rc=2 no-snapshot) append UNA alerta restore_drill_fail",
    design: "pattern-runner-v1/pattern_runner.vsm (script) + monitoring_runners.vsm (unit)",
    verify: "sin test unitario propio — verificacion = rc + alerta fail-loud + smoke T4-F2 (deuda visible)" },
]

// ── helpers (sin timer instalado — registro T7-F2) ──────────────────────
helpers = [
  { s: "scripts/monitoring/vsf-disk-trend-watch.{sh,service,timer}",
    estado: "DORMANT — units en repo pero NO instaladas en ~/.config/systemd/user (list-unit-files no las ve)",
    env: "user manager si se instalara; cwd=$HOME (script self-locate)",
    design: "monitoring_runners.vsm (nuevo)", verify: "sin test — deuda visible en comentario" },
  { s: "scripts/monitoring/vsf_syshealth_watch.py + unit pair",
    estado: "DORMANT — no instaladas", design: "monitoring_runners.vsm (nuevo)",
    verify: "sin test — deuda visible en comentario" },
  { s: "scripts/monitoring/vsf-log-feedback.py",
    estado: "sin unit — invocado manualmente/ad-hoc",
    design: "monitoring_runners.vsm (nuevo)", verify: "sin test — deuda visible en comentario" },
]

// ── fuera de flota (declarado para no inventar alcance) ─────────────────
fuera_de_flota = [
  "vsf-net-housekeeping.{service,timer}: units externas (%h/vsf/scripts/...), timer DISABLED — familia distinta, intencional",
  "vsf-opsroom.service: DISABLED, unit plano externa (sin source en repo)",
  "gcr-ssh-agent.*: sesion de escritorio, no del sistema",
]

// ── observaciones para S5 (registro de realidad, sin fix unilateral) ────
observaciones = [
  "Descriptions 'UTC' en gates-daily/docs-reconcile/gates-weekly + headers .sh: stale (OnCalendar bare = local) — textos corregidos en el batch 2026-10-21 al tocar los units",
  "alert_type gates_daily_fail / docs_reconcile_fail / restore_drill_fail NO estan en las tablas TYPE de alert_triage.py (solo gates_weekly_fail = HEALTH/REVERIFY) — clasifican con impacto default; tension futura, fuera de T4/T7",
  "state/backbone_status.json solo tiene 3 keys (claim_ingest) — los runners pre-existen al plugin backbone; el registro canonico de esta familia ES este manifest (headers # route:)",
]

// T4-F2 convencion (checklist smoke en plan): unidad nueva = headers de
// registro + smoke real (systemctl start) en su env + is-enabled + ver en
// list-timers + sumar a la lista TIMERS del check systemd-units-fresh.
⟦ /monitoring_runners ⟧
