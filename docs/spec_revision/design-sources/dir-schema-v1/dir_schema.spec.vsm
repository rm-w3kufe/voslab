// dir_schema.spec.vsm — POLÍTICA DE ORDEN EXPLÍCITA (ontología consultable).
// DIR-SCHEMA-RECURSIVE-2026-08-14 (decisión S5 rmw3 2026-08-14): las categorías
// SON los directorios (muñecas rusas); cada documento vive dentro de su sistema;
// la política implícita → explícita → lógica ejecutable determinista (ontología).
// Este spec DECLARA la política de pertenencia; scripts/vsl/verify_dir_schema.py
// la INTERPRETA (single source of truth — el check nunca duplica reglas en código).
//
// SEMÁNTICA:
//   - Cada .vsm de docs/spec_revision/ pertenece a EXACTAMENTE UNA categoría.
//   - `types`  = la regla general: todo archivo cuyo TYPE (2º slot del header
//     ⟦ name | TYPE | vsm-1.0 | date ⟧) esté en la lista pertenece a este dir.
//   - `files`  = asignación explícita por path (para THEORY-* cuyo contenido
//     decide el dir — decisión S5 2026-08-14, movimiento 3820690a).
//   - Un archivo coincide por type O por files; si ambos, files gana (más específico).
//   - Violación: archivo sin categoría, o en dir ≠ el que su type/files prescribe.

spec(DIR-SCHEMA) {

  scope: "docs/spec_revision/",
  policy: "las categorías son los directorios; cada documento en el dir de su órgano VSM; el TYPE del header es la llave de clasificación; excepción THEORY-* asignada por contenido (S5 2026-08-14)",

  // ── MODELO DEL ÁRBOL: rama-naturaleza (directiva rmw3 S5 2026-08-15) ──
  // Conceptualización del árbol: cada nodo = (nivel Ln, naturaleza N).
  // La RAMA (directorio) define la CLASE, no el nivel; el nivel se deriva
  // por PROFUNDIDAD ESTRUCTURAL (L0=system/, L1=órgano, L2=rama,
  // L3=sub-rama...). Implementado por scripts/vsl/docs_spec_index.py
  // (nature_of/level_of — S3* report-only); este spec lo DECLARA como
  // política consultable; verify_dir_schema interpreta solo `categories`.
  tree_model: {
    node: "cada nodo del árbol = (nivel Ln, naturaleza N) — L por
           profundidad estructural, N por la rama que lo aloja",
    rama_defines_class: "la rama define la CLASE (qué tipo de contenido
           aloja), NO el nivel; agent-policy/ es L2, design-sources/ bajo
           ella es L3, ambos naturaleza agent-layer",
    instance_is_live: "instance/ (instance.vsm, infra_ops.vsm, templates/)
           = instance-config — ESTADO VIVO, flexible, mecanismo de cambio
           por configuración; el RESTO de system/ = canon ratificado
           (mecanismos de cambio por revisión/aprobación)",
    nature_by_rama: [
      "root (system/ raíz) · canon-boot (boot/) · instance-config
       (instance/infra, instance/templates) · instance (instance/ raíz) ·
       kernel-theory (kernel/) · s1-pattern (s1-operations/ raíz) ·
       runtime-s1 (s1-operations/s1-*) · s2-organ · s3-organ ·
       s3star-organ · s4-organ · policy (s5-policy/ raíz) ·
       agent-layer (s5-policy/agent-policy/) · language
       (s5-policy/vsl-language/) · ledger · learning (learning_records/) ·
       sandbox · other",
    ],
    level_by_depth: "L0 = system/ (o raíz spec_revision); L1 = órgano
           (boot, kernel, s1-operations, s2-coordination, s3-control,
           s3star-audit, s4-intelligence, s5-policy, instance, ledger,
           learning_records, sandbox, spec, plan); L2 = rama dentro del
           órgano (agent-policy, vsl-language, s1-bbh/clima/econ,
           infra, templates); L3 = sub-rama (design-sources/)",
  },

  categories: [
    // ── . — categoría del árbol (clasificación materializada) ──
    category("docs/spec_revision", role="classification-category", static=true) {
      types: [""],
      files: [
        "docs/spec_revision/readme.vsm",
      ],
    },

    // ── archive — categoría del árbol (clasificación materializada) ──
    category("docs/spec_revision/archive", role="classification-category", static=true) {
      types: [""],
      files: [
        "docs/spec_revision/archive/index.vsm",
        "docs/spec_revision/archive/readme.vsm",
        "docs/spec_revision/archive/classification.local.vsm",
      ],
    },

