@vsm 1.2.1
@status active

// F1 (second-order-loop): designación del loop de feedback CANÓNICO.
// Resuelve la "triple competencia" del diseño: en código rsi_cycle YA orquesta
// los otros 3 — aquí se formaliza: UNO canónico en el harness S5.S3*, los
// demás delegan como sub-loops. Sin rewire (la delegación ya existe).

canonical_feedback = {
  module: "system/kernel/rsi_cycle.py",
  class: "RSICycle",
  nested_fn: "S5.S3*",
  role: "loop de feedback canónico — fault→fix→shadow→activate→journal",
  driver: "phi_down_directive",  // S5.S3* audit/attest, coherente con B4
  status: "active",
}

// Sub-loops que el canónico orquesta (delegación, no competencia):
delegates = [
  { module: "packages/public/vsf-rsi/vsf_rsi/rsi_feedback_loop.py",
    fn: "RSIFeedbackLoop.adjust_thresholds",
    role: "RL1 auto-optimización de umbrales de predicados",
    called_by: "rsi_cycle._maybe_run_feedback_loop" },
  { module: "system/kernel/feedback_loop.py",
    fn: "FeedbackLoop.generate_report",
    role: "Capa-3 session-health (traces→health_history→patterns)",
    called_by: "rsi_cycle._maybe_run_feedback_loop" },
  { module: "scripts/vsl/tools/health_scan.py",
    fn: "run_scan",
    role: "Capa-3 corpus-scan (spec_revision → health_history corpus rows → Omega drift/stability)",
    scope: "docs/spec_revision/** (canon tree mantenible; el glob docs/** original ahoga la serie con archive/deploy/sessions)",
    called_by: "rsi_cycle._maybe_run_feedback_loop" },
  { module: "packages/framework/vos_kernel/pleasure_emitter.py",
    fn: "emit",
    role: "canal PLURE (placer), asimétrico del dolor (F2 ratified)",
    called_by: "rsi_cycle (line ~1303)" },
]

// Un canal dolor (F1 acceptance): dolor y placer son CANALES SEPARADOS
// (asimetría F2), ambos alimentan el canónico.
channels = {
  pain: "state/rsi/alerts.jsonl",      // 1 canal dolor (pattern-runner, handoff, Layer A)
  pleasure: "state/rsi/pleasure.jsonl", // 1 canal placer (pleasure_emitter; F2: nunca toca alerts)
}

// Seeds F2 (instrument_manifest loader): esta entrada es el primer registro
// (Sn=S5.S3*, función-anidada=feedback) que el loader de F2 consumirá.
