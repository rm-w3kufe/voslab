⟦ vsl_encoding_cycle_design | VSL-ENCODING-CYCLE-DESIGN-v1 | vsm-1.2.1 | 2026-08-22T15:17:13Z ⟧

@vsm 1.2.1
@status proposed

system(vsl_encoding_cycle_design) {

  synthesis: "Diseño del ciclo de encoding VSM 1.2 — verificación de headers,
              timestamps, y encoding byte-level. FASE-1-ENFORCEMENT: timestamp
              requerido, date-only rechazado.",

  structure: [
    dir("verify_encoding.py", role="instrument", desc="byte-level certification: UTF-8, NFC, BOM, invisible, header, timestamp"),
    dir("vsl-encoding-valid", role="check", desc="encoding cycle discriminator (pass/fail)"),
    dir("vsl-timestamp-required", role="check", desc="FASE-1-ENFORCEMENT: timestamp required, date-only rejected"),
  ],

  contracts: [
    contract("timestamp-required", rule="all .vsm headers MUST use UTC timestamp", effect="date-only REJECTED"),
    contract("encoding-valid", rule="encoding cycle discriminates correctly", effect="RE_DATE_ONLY + RE_TIMESTAMP present"),
  ],

}

⟦ /vsl_encoding_cycle_design ⟧
