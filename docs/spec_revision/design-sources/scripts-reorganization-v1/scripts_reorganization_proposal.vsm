    "s3star_spotcheck.py: systemd/ → monitoring/",
  ],
  state_systemd_a_shared: [
    "vsf_nats.py: systemd/ → shared/",
  ],
  state_s5_a_governance: [
    "Rename s5/ → governance/",
  ],
  state_systemd_a_services: [
    "Rename systemd/ → services/",
  ],
  state_core_to_core: [
    "state_attest.py: core/ → core/ (correct)",
    "witness_verify.py: core/ → attestation/ (mejor)",
  ],
}

