// ═══════════════════════════════════════════════════════════════════════════
// SCRIPTS REORGANIZATION PROPOSAL
// directiva S5 rmw3 (2026-08-23): rehacer la propuesta de orden y
// clasificación de scripts/ — el estado actual es un desorden
// ═══════════════════════════════════════════════════════════════════════════

// RESUMEN EJECUTIVO
// ═══════════════════════════════════════════════════════════════════════════
//
// El estado actual de scripts/ tiene problemas estructurales:
//   1. state/ tiene subcategorías que se superponen
//   2. Scripts en dominios incorrectos
//   3. Falta claridad en la separación de responsabilidades
//   4. Subcategorías creadas no son consistentes con el diseño original
//
// Esta propuesta reorganiza scripts/ por FUNCIONALIDAD, no por categoría
// arbitraria. Cada dominio tiene una responsabilidad clara y los scripts
// están en el lugar correcto.
//
// ═══════════════════════════════════════════════════════════════════════════
// ESTADO ACTUAL (PROBLEMAS)
// ═══════════════════════════════════════════════════════════════════════════

problemas_actuales() {
  state_superposicion: "core/ vs attestation/ vs systemd/ — scripts cruzan fronteras",
  scripts_desubicados: [
    "learning_stats.py en systemd/ — es S4 learning cycle",
    "algedonic_pub.py en systemd/ — es algedonic publisher",
    "vsf_nats.py en systemd/ — es shared infrastructure",
  ],
  subcategorias_incorrectas: [
    "state/core/ tiene witness_verify.py que es attestation",
    "state/attestation/ tiene check_agent_log.py que es S5 governance",
    "state/systemd/ tiene scripts que no son systemd",
  ],
  total_scripts: 201,
  distribucion: "state/ 43, vsl/ 36, audit/ 20, s1-kernel/ 19, algedonic/ 9, analysis/ 12, deploy/ 4, llm/ 3, tests/ 10, shared/ 10",
}

// ═══════════════════════════════════════════════════════════════════════════
// PROPUESTA: ESTRUCTURA PARA state/
// ═══════════════════════════════════════════════════════════════════════════

propuesta_state() {
  estructura: "
    scripts/state/
    ├── core/                    # Core state management (.sh)
    │   ├── bootstrap.sh        # One-time install
    │   ├── populate.sh         # Refresh tables
    │   ├── q.sh                # Query wrapper
    │   ├── onboard.sh          # Agent session start
    │   ├── rotate_nats_token.sh
    │   ├── session_learning_scan.sh
    │   └── vsf-storage-probe.sh
    ├── attestation/            # Verification & integrity
    │   ├── state_attest.py     # AX-STATE-01 dogfood
    │   ├── witness_verify.py   # CA-rooted verification
    │   ├── check_agent_log.py  # Agent activation log
    │   ├── check_binary_integrity.py
    │   └── verify_covenant_hash.py
    ├── cyberfilter/            # Variety & projection
    │   ├── cyberfilter_variety.py
    │   ├── vsf_l2_projection_history_logger.py
    │   └── vsf_l3_l2_aggregator.py
    ├── governance/             # S5 governance
    │   ├── s5_ca.py           # Offline CA
    │   ├── s5_caution.py      # Caution mode
    │   ├── s5_inbox.py        # Terminal inbox
    │   ├── read_crl_next_update.py
    │   └── apply_bbs_whitelist.py
    ├── tasks/                  # Task management
    │   ├── tasks_archive.py
    │   ├── tasks_reconcile.py
    │   ├── tasks_validate.py
    │   ├── handoff_archive.py
    │   └── maintain.py
    ├── services/               # systemd service scripts (.py)
    │   ├── service_watchdog.py
    │   ├── vsf-compact.py
    │   └── vsf_cgroup_reallocate.py
    ├── monitoring/             # Monitoring & stats
    │   ├── learning_stats.py   # S4 learning cycle
    │   ├── monitor_reconcile.py
    │   ├── topology_reconcile.py
    │   ├── variety_accounting.py
    │   └── s3star_spotcheck.py
    ├── algedonic/              # Algedonic
    │   └── algedonic_pub.py    # Algedonic publisher
    ├── shared/                 # Shared infrastructure
    │   ├── vsf_nats.py
    │   └── sync_covenant_hash.sh
    ├── systemd/                # systemd unit files
    │   ├── *.service           # Service files
    │   └── *.timer             # Timer files
    ├── sql/                    # SQL files
    │   ├── schema.sql
    │   ├── seed.sql
    │   └── *.sql
    ├── config/                 # Config files
    │   └── peripherals.manifest.json
    ├── data/                   # Data files
    │   └── vsf_deps.db
    ├── coupling_manifests/     # Coupling manifests
    │   └── *.coupling.json
    ├── firewall/               # Firewall rules
    │   └── *.fw
    └── tests/                  # Test scripts
        ├── _agent_injection_test.py
        ├── test_consumer_watchdog.py
        ├── test_nats_resilience.py
        ├── test_nucleus_realdata_wiring.py
        ├── test_systemd_watchdog.py
        └── test_vsf_cgroup_reallocate.py
  ",
  cambios: [
    "s5/ → governance/ (claridad)",
    "systemd/ → services/ (claridad)",
    "learning_stats.py: systemd/ → monitoring/",
    "algedonic_pub.py: systemd/ → monitoring/ → algedonic/",
    "vsf_nats.py: systemd/ → shared/",
    "monitor_reconcile.py: core/ → monitoring/",
    "topology_reconcile.py: core/ → monitoring/",
    "variety_accounting.py: core/ → monitoring/",
    "s3star_spotcheck.py: systemd/ → monitoring/",
    "maintain.py: services/ → tasks/",
    "sync_covenant_hash.sh: state/ → shared/",
    "*.service, *.timer: state/ → systemd/",
    "*.sql: state/ → sql/",
    "*.json: state/ → config/",
    "*.db: state/ → data/",
    "*.sh: state/ → core/",
  ],
}

