// ═══════════════════════════════════════════════════════════════════════════
// CRITERIOS DE CLASIFICACIÓN
// ═══════════════════════════════════════════════════════════════════════════

criterios_clasificacion() {
  principio: "Cada dominio tiene una RESPONSABILIDAD CLARA — un script va al dominio que mejor describe su función principal",
  reglas: [
    "1. Si el script gestiona state.db → state/core/",
    "2. Si el script verifica integridad → state/attestation/",
    "3. Si el script es S5 governance → state/governance/",
    "4. Si el script es monitoreo/estadísticas → state/monitoring/",
    "5. Si el script es infrastructure compartida → shared/",
    "6. Si el script es test → tests/ o domain/tests/",
    "7. Si el script es algedonic → algedonic/",
    "8. Si el script es análisis → analysis/",
    "9. Si el script es auditoría → audit/",
    "10. Si el script es kernel → s1-kernel/",
  ],
  discriminacion: "NEW script vs MODIFICATION — el plugin vsf-script-classify-on-write.ts ya implementa esta lógica",
}

