@status active

// RECTIF-PLUGIN-SANDBOX-AUDIT — retro-active design source (S5 decision
// 2026-08-14, option (c) mixed).
//   Trace: vsl-check-on-write, vsl-measure-before-write (1:1 ports).
//   Redo via sandbox: vsf-agent-vsl-gate.ts.
//
// OBSERVATION PRISM: systemic view (VSM). Each cybernetic hook maps to an
// organ of the viable system — S1 (operational unit), S2 (coordination),
// S3 (control with veto), S3* (sporadic audit), S4 (intelligence/model),
// S5 (policy). Each hook's cybernetic function is its CAPACITY in the
// system: variety attenuation (Ashby), state transduction, deviation
// detection, channel regulation.
// The systemic correspondence is the lens: a hook is not a script — it is
// the organ that materializes a VSM capacity.
//
// Audit finding (R4, git-verified): 3/4 plugins violated the sandbox rail
// in their day; only vsf-onboard-reminder.ts followed it (M3 sandbox child
// → promotion b111ae9d) and vsl-relocate-on-write.ts followed it later
// (RELOCATE-VSM-SPEC → promotion 10942729). This task repairs the
// traceability or the design per the S5 decision.

// ═══════════════════════════════════════════════════════════════════════════
// SYSTEMIC CORRESPONDENCE MAP — the boot hooks as a VSM
// ═══════════════════════════════════════════════════════════════════════════
// Recursion (Beer): the plugin-system is a complete VSM inside the system.
// This map is the S3* observation of the hook system itself — which organ
// each one is, what capacity it materializes, through which channel it acts.

vsm_map(PLUGIN_SYSTEM_VSM) {
  s1:  "each plugin is an S1 — a verification operation: remind,
        measure, check, gate, relocate",
  s2:  "coordination between plugins — TODAY ABSENT (no record of who fires
        what, on which event, with which veto). This absence is the root of
        D1/D5/D6 (two reminders, no RESUMED branch). The sandbox rail
        promised to be the coordination mechanism; the 3 plugins that
        violated it created the breach",
  s3:  "vsf-agent-vsl-gate.ts = S3 (veto) — the ONLY one with blocking
        authority; the rest are advisory. The asymmetry is design, but it
        must be declared (the manifest did not distinguish veto from
        advisory — P3 of the RELOCATE-GATE-SPEC spec)",
  s3_star: "vsf-onboard-reminder, vsl-measure-before-write,
        vsl-check-on-write = S3* auditors — they see what the operator does
        not: the improvised boot order, the file state before the edit, the
        keystroke-level conformance",
  s4:  "the boot ontology (boot_manifest.vsm, this spec) = S4 — the
        model of what the boot loads and why",
  s5:  "rmw3 decides which mechanisms exist and with what authority — D6
        (retire bash reminder) and any veto change are S5 calls",
  collision_rule: "two mechanisms with the same function at the same point
        of the loop = redundancy (D1); two conflicting definitions of the
        same type = incoherence (D2)",
}

// ═══════════════════════════════════════════════════════════════════════════
// TRACES — 1:1 ports (S5 decision (c): trace)
// ═══════════════════════════════════════════════════════════════════════════

plugin_trace(TRACE_CHECK_ON_WRITE) {
  plugin:  ".opencode/plugins/vsl-check-on-write.ts",
  script:  ".opencode/plugins/scripts/vsl-check-on-write",
  origin:  "1:1 port of the Claude Code hook .claude/hooks/vsl-check-on-write
           (git ancestor: commit c66c4715 'grammar gate can now fail')",
  port:    "commit 21f8d17f — port + shared scripts to OpenCode plugins",
  fixes:   [
    "09b66fcb — path as ARGUMENT not stdin (OpenCode TTY deadlock)",
    "486c37bd — path bug + stderr propagation",
  ],
  function: "PostToolUse conformance attenuator — runs when writing .vsm
             (zero latency), advisory, never blocks (the pre-commit gate
             remains the authority)",
  organ:   "S3* — sporadic conformance auditor",
  capacity: "DEVIATION DETECTION at the keystroke (Ashby: reduces the
             variety of defects reaching the commit — the loop closes where
             the writing happens, not where the commit happens)",
  channel: "φ↑ (reads the written file, reports to the agent; never blocks)",
  rail:    "TRACED retro-actively (S5 decision (c)): documented origin,
           equivalence verified by git ancestor, fixes recorded",
}

plugin_trace(TRACE_MEASURE_BEFORE_WRITE) {
  plugin:  ".opencode/plugins/vsl-measure-before-write.ts",
  script:  ".opencode/plugins/scripts/vsl-measure-before-write",
  origin:  "1:1 port of the Claude Code hook .claude/hooks/vsl-measure-before-write
           (git ancestor: commit c66c4715, same family as check)",
  port:    "commit 21f8d17f — port + shared scripts to OpenCode plugins",
  fixes:   [
    "09b66fcb — path as ARGUMENT not stdin",
  ],
  function: "PreToolUse measure-before-acting — reads the CURRENT state of the
             .vsm before Write/Edit; the discipline 'before acting, measure'
             (rmw3 2026-08-10); advisory, never blocks",
  organ:   "S3* — sporadic prior-state auditor",
  capacity: "STATE TRANSDUCTION (converts the file state into a legible
             signal BEFORE the change — reduces the variety of decisions
             made on an unread state)",
  channel: "φ↑ (reads the file to edit, informs the agent; never blocks)",
  rail:    "TRACED retro-actively (S5 decision (c)): documented origin,
           equivalence verified by git ancestor, fixes recorded",
}

// ═══════════════════════════════════════════════════════════════════════════
// REDO — vsf-agent-vsl-gate.ts (S5 decision (c))
// ═══════════════════════════════════════════════════════════════════════════

// The gate is the ONLY S3 organ of the boot (veto). That is why it deserves
// its own spec: a mechanism with blocking authority cannot be the only one
// without a design source. See RELOCATE-GATE-SPEC.vsm (proposal validated in
// this same sandbox). Redoing it through the rail materializes the
// systemic correspondence that today is only implicit: the veto is S3, and
// S3 must be auditable against its specification.

