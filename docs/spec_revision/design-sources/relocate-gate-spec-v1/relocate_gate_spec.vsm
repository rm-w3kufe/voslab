@vsm 1.2.1
@status active

// RECTIF-PLUGIN-SANDBOX-AUDIT — REDO of vsf-agent-vsl-gate.ts via
// sandbox (S5 decision 2026-08-14, option (c) mixed).
//
// Why redo: the current plugin (created directly, commit 4c2f34f9) is the
// ONLY mechanism with veto in the boot (S3) and has no design source — a
// gate cannot be audited without the specification of its intent. The rail
// demands: sandbox proposal → validation → implementation → promotion.
//
// The existing code is functional and cites core_boot_primer.comms
// (correct, PROTOCOL_VERSION 3). This spec does NOT discard its behavior:
// it specifies it, detects improvements, and defines how to verify it. The
// new implementation may reuse the logic if it passes the acceptance tests.

gate_spec(GATE_R15_V2) {
  name: "vsf-agent-vsl-gate.ts (v2, redone via sandbox)",
  // ── systemic correspondence (VSM) ──
  organ:   "S3 — control with veto: the ONLY boot mechanism that can
           block an action (the others are S3* advisory)",
  capacity: "VARIETY REGULATION of the inter-agent channel (Ashby): the
           tmux parent↔child channel is high-variety (free prose);
           the gate ATTENUATES it by demanding VSL — reduces the variety of
           non-verifiable messages to the variety of verifiable envelopes.
           It is the variety amplifier on the sender side (the VSL message
           is self-verifiable by the receiver)",
  channel: "φ↓/φ↑ (blocks at sending — acts on inter-agent transmission; veto)",
  authority: "S5 (rmw3) delegates the enforcement of R15 to this S3; the gate
           does not decide policy, it executes the one declared in
           core_boot_primer.comms",
  // ── observable behavior ──
  channel_tmux: "inter-agent (parent ↔ child, future ones) via tmux send-keys",
  rule:   "R15 (core_boot_primer.comms, PROTOCOL_VERSION 3) — inter-agent
          exchanges must be VSL, never loose prose",
  behavior: [
    "B1 block bash sending a ≥120-char message to an agent tmux session
        WITHOUT a VSL marker (.vsm path, phi(), @vsm, directive,
        envelope, dispatch, guardrail_critico, φ)",
    "B2 allow short acks (<120 chars) and control sequences
        (Enter, C-c, C-d, Escape, ok, done, ack)",
    "B3 allow ANY tmux use that is not sending to an agent session
        (local panels, non-agent sessions)",
    "B4 block with an actionable message: name the correct envelope
        pattern (child/docs/deploy/… parent→child, docs/deploy/… S3→S1)",
    "B5 NEVER block outside tool.execute.before of bash (minimal
        scope: does not interfere with other tools)",
  ],
  invariants: [
    "I1 the gate is S3 (veto) — the other plugins are advisory (S3*)",
    "I2 the source of truth lives in the repo; the global dir has a symlink
        (root + child load the SAME gate)",
    "I3 the gate never blocks boot nor non-bash tools",
  ],
}

// ── detectable improvements over the current code ──

improvements(IMP) {
  existing: [
    "E1 cites core_boot_primer.comms (already fixed post-D4, correct)",
    "E2 handles φ and φ(↑|↓) as markers (covers the VSL envelope)",
    "E3 actionable error message with the correct path patterns",
  ],
  proposed: [
    "P1 extract VSL_MARKER/CONTROL_ONLY/SEND_KEYS into named constants
        with a why comment (currently inline regex literals)",
    "P2 automated acceptance test: checks/vsl-gate-valid with message
        fixtures (prose→block, ack→allow, envelope→allow,
        non-agent→allow) — today NO gate test exists",
    "P3 record the gate's S3/veto role in the manifest (boot_manifest.vsm)
        (yesterday the manifest did not distinguish veto from advisory)",
    "P4 document channel R13: bbh-wsl is read-only (φ↑ reads) — the
        gate applies to the parent↔child channel, not to bbh",
  ],
  non_goals: [
    "NG1 DO NOT redesign the envelope format (out of scope)",
    "NG2 DO NOT change the 120-char threshold without new evidence",
    "NG3 DO NOT touch the other plugins (traced in PLUGIN-AUDIT-DESIGN)",
  ],
}

// ── verification plan ──

verification(V) {
  acceptance: [
    "A1 checks/vsl-gate-valid pass: fixture prose ≥120 chars → BLOCK (rc=1)",
    "A2 checks/vsl-gate-valid fail: fixture short ack → ALLOW (rc=0) —
        discriminates the negative control",
    "A3 fixture envelope .vsm path → ALLOW (no false positive)",
    "A4 fixture non-agent tmux → ALLOW (no false positive)",
    "A5 the plugin loads in root + child (symlink) and the boot load test
        passes",
  ],
  gate: "promotion of the spec to system/ only after implementation +
         A1-A5 green (sandbox rail: implementation FIRST, R14)",
}

⟦ /relocate_gate_spec ⟧