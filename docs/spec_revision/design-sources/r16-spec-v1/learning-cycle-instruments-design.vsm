⟦ LEARNING-CYCLE-INSTRUMENTS-DESIGN | R16-SPEC-v1  | vsm-1.2.1 | 2026-08-19T22:40:44Z ⟧

@vsm 1.2.1
@status proposed
// sandbox/learning-cycle-instruments-design.vsm
// DISEÑO DE ESTRUCTURA de los instrumentos del ciclo de aprendizaje
// (2026-08-16). R16_impl_with_design: los artefactos que enforcean el
// ciclo cumplen ellos mismos la regla. Recursividad (rmw3): el
// instrumento que fuerza el ciclo es él mismo parte del ciclo.
// Árbol: (L1 s5-policy) → sandbox/ — naturaleza: sandbox (diseño en
// elaboración; los instrumentos ya operan, la spec los declara).

instruments("LEARNING-CYCLE-INSTRUMENTS-v1") {

  session_learning_scan: "
    where_lives:  scripts/state/session_learning_scan.sh
    role:         S3/S4 gate — detecta aprendizajes detectados SIN persistir
                  (drafts en learning_records/.pending/) → BLOCKS commit
                  (guard F) y session-close (plugin session.idle).
    artifacts_consumes: learning_records/.pending/*.vsm (drafts)
    artifacts_creates:  nada (reporta); estado: exit code
    enforced_by:  guard (F) en scripts/docs/git_pre_commit.sh + plugin
                  .opencode/plugins/learning-cycle-scan.ts (session.idle)
    verified_by:  fixture modo fail (draft → exit 1)"
  ,

  learning_stats: "
    where_lives:  scripts/state/monitoring/learning_stats.py
    role:         S4 — mecanismo estadístico del ciclo (trace):
                  PUEBLA la ventana (agrega IRs por family/class/organ/
                  status/date) y LEE bajo condición (--check: novel >= N
                  en W días → TRIGGER decisión S4/S5 de inversión).
                  A+C (S5 2026-10-16): el trigger mide decisión
                  PENDIENTE — firmas adjudicadas en el ledger del
                  envelope learn_budget (approved / rejected_*) salen
                  del novel set (read-side, determinista R10). La
                  decisión sigue siendo de S5 vía el envelope; el
                  instrumento solo la respeta (R9: nada se limpia sin
                  decisión registrada).
    artifacts_consumes: docs/spec_revision/learning_records/*.vsm,
                  state/rsi/learn_ledger.jsonl (adjudicaciones)
    artifacts_creates:  reporte (stdout/stderr); estado: exit code
    enforced_by:  guard (G) en git_pre_commit.sh + plugin session.idle
    verified_by:  populate muestra ventana; --check rc=0 (N no alcanzado
                  o firmas adjudicadas) y rc=1 (N alcanzado — discrimina)"
  ,

  plugin_learning_cycle_scan: "
    where_lives:  .opencode/plugins/learning-cycle-scan.ts
    role:         Gatillo automático en vivo (session.idle) — ejecuta
                  session_learning_scan.sh + learning_stats.py --check;
                  reporta drafts pendientes y triggers S4. Determinista
                  (R10): solo ejecuta y reporta, no decide.
    artifacts_consumes: scripts/state/session_learning_scan.sh,
                  scripts/state/learning_stats.py, learning_records/
    artifacts_creates:  logs de consola (reporte visual)
    enforced_by:  auto-discovery de opencode (.opencode/plugins/*.ts)
    verified_by:  session.idle emite el scan; los scripts retornan rc"
  ,
}

⟦ /LEARNING-CYCLE-INSTRUMENTS-DESIGN ⟧