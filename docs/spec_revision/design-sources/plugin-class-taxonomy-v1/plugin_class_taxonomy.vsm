// PLUGIN-CLASS-TAXONOMY-v1 — design of plugin classes + single socratic engine.
//
// EXTENDS plugin-audit-design-v1 (A6: same organ, not a duplicate). That
// design mapped each hook to its VSM organ and capacity. This one answers
// the structural question: what CLASSES of plugins exist, and how can a
// single socratic engine navigate any circumstance (the plugins' trees)?
//
// PROPOSAL (rmw3 2026-08-18):
//   1. Every plugin is an instance of exactly one CLASS (trigger + question
//      + authority). The class is declared as policy (design doc), not as
//      a naming convention.
//   2. The decision logic of every plugin is its socratic TREE (AND/OR of
//      predicates, else='?' visible — socratic_engine.py, EXP-SOCRATIC-TREE).
//      The TS plugin becomes a thin SHELL: resolve the tree for its class,
//      evaluate it with the engine, act on the certified answer.
//   3. The engine is model-agnostic (R10): certification comes from
//      structural evidence (certified=True), never from LLM opinion.
//      llm_judge may PROPOSE; it does not CERTIFY.
//   4. Write-time universal: the same engine evaluates the tree of ANY
//      document being created/saved (classification, R18 conformance,
//      design presence, D7 language) — the socratic questionnaire IS the
//      write-time gate.

// ═══════════════════════════════════════════════════════════════════════════
// CLASSES — the taxonomy
// ═══════════════════════════════════════════════════════════════════════════

// A class = (trigger, socratic question, authority, channel). The QUESTION
// is what the plugin's tree answers; the AUTHORITY is whether the class can
// block (S3 veto) or only advise (S3* audit).

class_map: [

  class_def(CLASS-CLASSIFY) {
    trigger:   "tool.execute.before (write/edit/create)",
    question:  "¿este documento va aquí? ¿cumple su nivel?",
    authority: "advisory (S3*) — reports; never blocks",
    channel:   "φ↑ (reads file before change, informs agent)",
    plugins:   [
      "vsl-measure-before-write.ts (state transduction)",
      "vsl-check-on-write.ts (deviation detection at keystroke)",
      "vsl-relocate-on-write.ts (relocation motor on git mv)",
    ],
  }

  class_def(CLASS-GATE) {
    trigger:   "commit / pre-commit",
    question:  "¿esto puede pasar? ¿viola R18/R16/D7?",
    authority: "BLOCKING (S3) — the only class with veto",
    channel:   "φ↓ (blocks the commit; the pre-commit hook is the authority)",
    plugins:   [
      "vsf-agent-vsl-gate.ts (R16/R18 write-time conformance)",
    ],
  }

  class_def(CLASS-CYCLE) {
    trigger:   "session.idle / cycle hooks",
    question:  "¿el ciclo está vivo? ¿hay aprendizaje que registrar?",
    authority: "advisory (S2/S3*/S4 observability)",
    channel:   "φ↑ (surfaces scan output; decision lives in the scan)",
    plugins:   [
      "learning-cycle-scan.ts (session.idle → session_learning_scan.sh)",
    ],
  }

  class_def(CLASS-REMIND) {
    trigger:   "session.start / idle fail-safe",
    question:  "¿falta algo declarado? (D2 fail-safe)",
    authority: "advisory (fail-safe reminder)",
    channel:   "φ↑ (reminds the agent of declared state)",
    plugins:   [
      "vsf-onboard-reminder.ts (boot state reminder)",
    ],
  }

  class_def(CLASS-OBSERVE) {
    trigger:   "any activation (A6 helper, not a registered plugin)",
    question:  "¿quién corrió y qué pasó?",
    authority: "log-only (S5 directiva: observa y mejora)",
    channel:   "φ↑ (deterministic JSONL activation record)",
    plugins:   [
      "log-activation.ts (agent-plugin-log)",
    ],
  }
]

// ═══════════════════════════════════════════════════════════════════════════
// SINGLE ENGINE — the socratic navigator
// ═══════════════════════════════════════════════════════════════════════════

// Each plugin DECLARES its tree (prototype: socratic_hooks.py — AND of
// dimensions, else='?' visible, 9/9 cases ✓). The engine evaluates:
//   - Truth trivaluado (TRUE/FALSE/UNKNOWN) + certified (structural
//     evidence) — R10: the LLM may propose, never certify.
//   - tree_home: UNKNOWN → '?' visible, never silent else_home (R9).
//   - diagnose(): find_failure_traces + guilty children — actionable
//     root-cause feedback when a tree fails (cybernetic S3*).
//
// The TS plugins collapse to a SHELL: (1) resolve the class tree (VSL),
// (2) evaluate with the engine, (3) act on the certified answer. A behavior
// change = editing the VSL tree, not the TS.

// ═══════════════════════════════════════════════════════════════════════════
// IMPLEMENTATION (fase a — materializado 2026-08-18)
// ═══════════════════════════════════════════════════════════════════════════

// 1. CLI eval-tree en socratic_engine.py — el contrato del shell:
//    python3 scripts/vsl/socratic_engine.py eval-tree <tree.vsm|tree.json>
//      --doc-type <TYPE> [--context '<json>']
//    → {"truth":"TRUE|FALSE|UNKNOWN","certified":bool,"home":"...","explain":...}
// 2. Parser VSL recursivo (parse_socratic_block reescrito) — soporta árboles
//    anidados (AND/OR/NOT, kwargs, homes), no solo listas planas.
// 3. Semántica epistemológica: type_* con sujeto vacío → UNKNOWN (sin sujeto
//    no hay juicio, R10); ctx_has guardián del contexto; tree_home desciende
//    en sub-árboles TRUE sin home propio.
// 4. Shell TS: .opencode/plugins/vsf-socratic-shell.ts (socraticShell factory)
//    — resuelve árbol + contexto, evalúa con el motor, actúa, loguea.
// 5. Primera instancia: .opencode/plugins/vsf-classify-on-write.ts (CLASSIFY,
//    write-time advisory) + árbol .opencode/plugins/trees/classify.tree.vsm.
//
// FUTURE (fase b): engine packaging as a model-agnostic library (pyproject)
// + MCP server exposing socratic_evaluate / socratic_diagnose /
// socratic_build — the state-canon-mcp of decision trees, publishable to
// GitHub after certification here.

// ═══════════════════════════════════════════════════════════════════════════
// WRITE-TIME UNIVERSAL — the questionnaire applies to any document
// ═══════════════════════════════════════════════════════════════════════════

// Same engine, any document being created or saved:
//   - classification: "¿este doc va en este nivel?" (tree per level — the
//     local classification.local.vsm IS the socratic tree of that level)
//   - R18 conformance: "¿este doc cumple la versión canónica del protocolo?"
//   - R16 design presence: "¿este artefacto tiene design source?"
//   - D7 language: "¿este doc de system/ está en inglés?"
//   - certification: "¿tiene evidence estructural (certified) o solo opinión?"
//
// The socratic questionnaire is the write-time gate; diagnose() tells the
// agent WHY a save failed — root cause, not symptom (directiva S5:1).

⟦ /plugin_class_taxonomy ⟧