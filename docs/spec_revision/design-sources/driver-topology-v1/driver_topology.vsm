@vsm 1.2.1
@status proposed

// spec/driver_topology.vsm — DRIVER TOPOLOGY: un driver unico por Sn,
// S3* como canal transversal, niveles recursivos completos, refuerzo algedonico.
// Status: DESIGN (proposed) — R16 design source. No redeclara canon:
// cita covenant, primer, regulation, s5_policy_core, s5_algedonic,
// s3star_audit, s3_allocation, s4_anticipation. La logica vive alli;
// aqui solo la topologia driver↔canal↔nivel y el plan de cierre.

spec(DRIVER-TOPOLOGY) {

  scope: "toda herramienta, plugin, script, check o servicio nuevo del
    sistema vOS: antes de integrar debe declarar Sn + driver unico +
    canal algedonico efectivo + variedad requerida. Lo existente en
    system/ se mapea, no se reescribe.",

  // ── 1. BASE CANONICA (citas, no redefiniciones) ──
  canon_basis: [
    "V ::= ⟨S1,S2,S3,S4,S5⟩ @ E(L); S3* es CANAL, no subsistema; canales
     φ↑ φ↓ ψ S3* α σ; recursion S1(L)={V_i(L+1)}; viable(V) iff state(V)
     en Omega con banda precautionary (covenant + primer).",
    "A6 Ashby parametrico por measure(Var); VSF declara suma sobre ejes,
     luego combinacion aditiva. A8 absorcion por nivel. A10 urgency
     LOW→S3 MEDIUM→S4 HIGH→S5; α binario por severity, sin escalera.",
    "A5 autonomy ceiling + D4-L2 autonomo (parameter_drift) / D4-L3
     siempre humano (axiom/topology Δ). Tick: S2, S3, S1, S4, φ↑.",
    "R10 LLM solo en sintesis de interfaz; R10.1 tacticas proactivas bajo
     covenant floor determinista + auditoria S3* + escalation duty +
     autonomia graduada; intent desde LLM, enforcement siempre determinista.",
    "R16 toda implementacion trae design + enforcing check o no integra
     (detector-first). R17 consentimiento explicito S5 misma-turno para
     destructivos. R18 conformidad en escritura, version canonica al editar.",
    "Ax_S5CautionVeto severity mayor o igual a 8.0 o categoria critica
     implica caution_mode; clear por S5 explicito o duracion acotada;
     fail_safe sin veto fantasma. Ax_TraceabilityClosure bidireccional
     versionada. Patron SPOF monoruta.",
    "Estrategia humana ENDS double-loop / tactica maquina MEANS single-loop
     graduada / reflex determinista sin LLM; frenos B1 auditoria S3*
     independiente, B2 escalation HiTL con propuesta inerte hasta ratificar,
     B3 irreversibilidad HiTL; autonomia por clase tau con lambda
     compartida, gates c1-c5, fase tutored a full, demotion AUTOMATICA;
     expandir requiere humano, contraer es automatico.",
  ],

  // ── 2. S3* COMO CANAL TRANSVERSAL ──
  s3star_channel: {
    model: "S3* esporadico directo, bypass de φ↑, sin aviso; audita ACROSS
      levels con fuentes que el auditado no controla. No es sexto elemento
      del tuple. Corrije defecto de modelarlo como subsistema.",
    dimensions: [
      "fisica: realidad sustrato leida desde LXC distinto al del nucleo",
      "emision: lo que el broker recibio vs lo que el log local afirma",
      "semantica: re-derivar significado publicado contra Omega
       sostenida independientemente",
    ],
    suite: "triage_evidence con Evidence{question,probe,observed,supports};
      autoimmune con chain virginity y cierre honesto; diverse_verifier
      independiente del crate auditado; recon_bidirectional; dyn_llm_grant
      donde LLM es paciente no doctor.",
  },

  // ── 3. NIVELES RECURSIVOS COMPLETOS Y SUBNIVELES ──
  recursion: {
    law: "cada S1 puede ser V completo con su S1-S5; techo de autonomia
      heredado no mayor que el padre; politica del hijo contenida en la
      del padre; visibilidad unidireccional padre lee φ↑ hijo, hijo no lee
      estado padre.",
    sublevels_seen: [
      "s1-operations con s1-bbh, s1-clima, s1-econ, s1-template: cada uno
       candidato a V completo con su propio bargain y floor",
      "s4-intelligence con anticipation, visualization, theory-ap,
       theory-dyn, theory-s4l: proyector vs teoria vs vista",
      "s5-policy con agent-policy, vsl-language, algedonic, comms,
       learning-cycle, lifecycle: politica vs lenguaje vs canal",
      "s3star-audit con s3star-audit-01, theory-dvp-01, self-audit-01,
       phi-down-audit-01: auditoria operativa vs teoria vs self-audit",
    ],
    rule: "un subnivel con complejidad mayor que el techo de variedad de
      su rol se promueve a V completo con su S5 local; su S5 local queda
      contenido en el S5 padre. La promocion la ratifica S5.",
  },

  // ── 4. DRIVER UNICO POR Sn ──
  drivers: [
    driver("S1", "phi_up_direct",
      "canal: telemetria directa φ↑; variedad: baja; autonomia: total;
       ejecuta Task a Result; gobernado iff tiene φ↓ y emite φ↑;
       dolor: silencio o FALSE mezclado sin discriminar"),
    driver("S2", "event_coordinator",
      "canal: events.jsonl + broadcast sigma read-only; variedad: media;
       impide interferencia destructiva entre S1 sin acoplo directo;
       dolor: perdida de eventos o flapping no declarado"),
    driver("S3", "invariant_guard",
      "canal: s5-alerts.db + caution_mode + bargain single-loop resize
       ONLY sin start/stop/create/destroy; pool con reserva y zonas;
       variedad: alta; dolor: invariante violado o pool exhausto"),
    driver("S3*", "audit_scanner",
      "canal: s4_ethics_scan + audit chain + ledger; variedad: alta;
       esporadico sin aviso con fuente independiente; dolor: divergencia
       broker vs log, recomputo vs afirmado, o silencio de forwarding"),
    driver("S4", "projector_directive",
      "canal: proyeccion Markov + directiva anticipatoria + s3_pre_grant;
       variedad: alta; activo iff drift mayor a epsilon; H1 lead, H2
       prevencion load-bearing, H3 precision, H4 regimen guard;
       prerrequisito pipeline φ↑ fluyendo; dolor: directiva sin lead o
       actuacion fuera de distribucion"),
    driver("S4", "llm_probe",
      "canal: digest + audit_flag advisory siempre; variedad: critica;
       nunca en path de señal; bajo floor covenant + auditoria S3* +
       escalation + autonomia graduada; dolor: LLM en path rapido o
       auto-cierre narrativo sin evidencia"),
    driver("S5", "consent_gate",
      "canal: decision flow con firma encadenada a root + session block;
       variedad: critica un bit por sesion; veto caution, ratificacion
       de clases y niveles, llaves offline; dolor: bloqueo total hasta
       decision explicita"),
  ],
  uniqueness: "un nivel, un driver principal. Un segundo driver en el
    mismo nivel es defecto de modelado: o es subnivel recursivo con su
    propio driver, o es secundario subordinado al principal.",

  // ── 5. RUTEO R128 ADOPTADO (no inventado) ──
  routing_r128: [
    "dimension Omega reservada rara de viabilidad core",
    "input de bargain S3 como restriccion fisica junto a CPU/RAM/disco",
    "single-loop algedonico auto sin humano para correccion segura conocida",
    "double-loop con escalado sin respuesta segura conocida o forma nueva",
    "pasivo/auditoria S3* bajo demanda",
  ],
  thesis: "gobernado sin humano supervisando cada organo; humano en
    POLICY, no en el trigger single-loop.",

  // ── 6. BRECHAS LOGICAS Y SU CIERRE ──
  gaps: [
    gap("G1", "tres instrumentos degradan local sin escalar: refresh
      silencioso, out_of_norm solo local, log-only fuera de state",
      "cierre: cablear cada uno a su driver con path algedonico
       verificado nuevo-hallazgo implica nueva-fila; silencio de record
       no implica silencio de mundo; verificar detector vivo en fuente,
       no solo timestamps"),
    gap("G2", "independencia epistemica incompleta: broker_probe sin
      construir, shadow_recompute sin implementar",
      "cierre: broker compara recibido vs afirmado por ventana con
       hallazgos emit_silence, emit_count_divergence, emit_stale;
       recompute esporadico 1-en-K re-deriva significado contra Omega
       S5-held con hallazgo por encima de epsilon; sin esto S3* solo
       confirma el relato del auditado"),
    gap("G3", "PHI-UP-PIPELINE roto en tres niveles: manifests no
      desplegados, kernel no suscrito a clima, bridge escribe a disco
      que el kernel no lee",
      "cierre: manifests desplegados, suscripcion kernel a phi_up y
       proyeccion, lectura efectiva verificada por frescura; sin esto
       S3 no tiene sobre que pre-otorgar y S4 prescriptivo es teatro"),
    gap("G4", "decision PKI confia en pubkey del propio record: trail
      UNTRUSTED, bloquea supervision B3",
      "cierre: pin de root S5 desde fuente confiable, cert encadenado
       a root, firma verificada contra cert, fail closed con algedonico
       en mala firma; rescatar B1 persist stream y A review surface sin
       esperar B3"),
    gap("G5", "S3 sin boundary fisico: cpu.max y memory.max en max, io.max
      vacio, io.weight no-op bajo mq-deadline, PSI acumulando sin
      consumidores",
      "cierre: cablear consumidores PSI existentes antes de nuevos
       instrumentos; io.max por unidad como boundary real; documentar
       scheduler efectivo antes de tunear pesos; matriz captured/logged/
       alerted/governs como tablero"),
    gap("G6", "kill policy abierta: axioma resize ONLY vs emergencia que
      pide kill; consumo distinto de expendability probado en vivo",
      "cierre: kill sigue double-loop humano; rescatar de S5: ventana de
       gracia, orden de prioridad ratificado por adelantado, alcance
       mas alla de S1, salto de tiers, umbral CRITICAL exacto"),
  ],

  // ── 7. BREACHES Y PLAN DE ALINEACION AL CANON ──
  breaches: [
    breach("B1", "mapa de severidad canonico en doc proposed mientras
      veto ya enforcea en codigo",
      "alineacion: ratificar s5_algedonic o mover mapa a regulation con
       trazabilidad versionada; mientras tanto citar, no re-declarar"),
    breach("B2", "spec S3 control en proposed mientras bargain corre live",
      "alineacion: misma regla; citar axioma resize-ONLY desde el doc
       vivo hasta ratificar, sin duplicar numeros"),
    breach("B3", "riesgo de segundo checker paralelo violando no-organos-
      paralelos",
      "alineacion: nuestro validator delega en impl-with-design-valid
       para design y enforcing_check; solo añade driver unico + canal
       efectivo + evidencia R12; una autoridad por clase"),
    breach("B4", "vocabulario de roles heredado vs roles Sn del plan",
      "alineacion: tabla de mapeo old_role a {Sn, driver, canal}
       ratificada una vez por S5; el validator la lee parametrico;
       clasificacion local por nivel declara sus motores; sin tabla no
       hay migracion, solo deuda PAUSE con veredicto"),
  ],

  // ── 8. APLICACION: QUE EXIGIR A CADA HERRAMIENTA NUEVA ──
  application: [
    "declarar Sn + driver unico + canal efectivo + variedad; sin esto no integra (R16)",
    "demostrar canal efectivo no declarado: consumer real leyendo,
     frescura acotada, path algedonico probado con hallazgo real",
    "evidencia R12 machine-checkable para cerrar señales; auto-escalado
     al intentar cerrar narrativo; escalar siempre seguro sin evidencia",
    "tacticas LLM bajo los cuatro guardias con tau por clase y demotion
     automatica; expandir requiere humano, contraer es automatico",
    "destructivos y cambios de estructura solo con consentimiento S5
     misma-turno y firma encadenada verificada antes de actuar",
    "prohibido tunear pesos sin verificar scheduler efectivo; prohibido
     silenciar para reparar; reparar, no enmascarar; estado honesto
     pendiente es valido, oculto no",
  ],

  // ── 9. PUERTAS ABIERTAS ──
  open_gates: [
    "tabla old_role a driver ratificada por S5",
    "broker_probe y shadow_recompute construidos y aceptados por tiers",
    "decision PKI llevado al estandar beacon con cadena a root",
    "PHI-UP-PIPELINE fluyendo con chequeo de frescura",
    "orden de prioridad S1 y ventana de gracia para emergencia",
    "decision-key operacional S5 emitida en ceremonia con root offline",
  ],
}
