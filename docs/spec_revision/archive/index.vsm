// docs/spec_revision/archive/index.vsm — EL ÍNDICE DE archive/.
// DECISIÓN S5 rmw3 2026-08-17 (ARCHIVE-POLICY): todo lo archivado,
// clasificado por clase + nivel + identidad + función. UNA entrada por
// documento, actualizada en el MISMO commit que archiva (doc_sync).
// Enforcement: check archive-index-valid (BLOCKING) — el índice cubre
// 100% de archive/; un .vsm en archive/ sin entrada = violación.

index(ARCHIVE-index) {

  synthesis: "cada entrada = (clase, nivel, identidad, función, linage).
              El índice ES el estado de archive/ — leerlo primero,
              nunca listar el directorio a ciegas (A6: el que conoce el
              mapa distribuye mejor sus recursos).",

  entries: [

    // ── measurements/ — mediciones, surveys, censos (DATED RECORD) ──
    entry(
      class="measurements",
      level="L2 (archive/ → measurements/)",
      identity="restructure_survey.vsm (RESTRUCT-SURVEY-v1)",
      function="medición de la propuesta de re-structure 4 pasos (2026-08-10) — 'antes de actuar, medir'; survey cumplido, acciones absorbidas por revision_plan",
      lineage="degradado desde sandbox/ 2026-08-17 (R4: ni política ni spec — medición cumplida)",
    ),

    // ── examples/ — worked examples, demos (DATED RECORD) ──
    entry(
      class="examples",
      level="L2 (archive/ → examples/)",
      identity="vsm_logic_demo.vsm (VSM-LOGIC-DEMO-v1)",
      function="worked example: ¿puede decidirse la lógica VSM? OWL 2 RL deriva 3/3 violaciones; bloqueador = declaración (2026-08-09)",
      lineage="degradado desde sandbox/ 2026-08-17 (R4: ejemplo, ¬spec — la respuesta ya está dada)",
    ),

    // ── superseded/ — docs superados por otro (DATED RECORD, linage) ──
    entry(
      class="superseded",
      level="L2 (archive/ → superseded/)",
      identity="creative_leaps.vsm (THEORY-CL-01)",
      function="semilla de THEORY-SID-01 (2026-07-05); superado por plan/seven_ideas_deep.vsm (2026-07-08) — mismo orden, desarrollado; retenido como linage",
      lineage="degradado desde plan/ 2026-08-17 (R4: DATED RECORD — plan/ solo planes ACTIVOS)",
    ),
    entry(
      class="superseded",
      level="L2 (archive/ → superseded/)",
      identity="ph00_boot_coherence_review.vsm (PH-00-BOOT-COHERENCE)",
      function="PH-00 boot coherence review (CONTENT scope) — output de PH-00, ejecutado 2026-08-06; superado por la revisión continua del arco de revisión (revision_plan → plan/vsf-vsl-revision/root.vsm)",
      lineage="reclasificado desde spec_revision root 2026-08-17 (CLASSIFICATION-POLICY-PLAN S3: ESTADO→PASADO→archive/superseded/)",
    ),
    entry(
      class="raiz",
      level="L1 (archive/)",
      identity="classification.local.vsm (DIR-CLASSIFICATION-LOCAL)",
      function="política local de clasificación de archive/ (EXP-RECURSIVE-
                ENGINE v6): asigna la clase (examples/measurements/superseded)
                de sus registros; interpretada por classify.py",
      lineage="creado 2026-08-17 — cobertura completa de spec_revision/
               (26 políticas locales nuevas; plan/ y system/ ya existían)",
    ),
  ],

  policy: "cualquier archivo nuevo en archive/ → entrada aquí en el mismo
           commit (doc_sync flipped); el check archive-index-valid
           verifica que el índice cubre 100% (censo de archivos vs
           entradas — nada huérfano, nada fantasma).",
}
