  // ─── 5.2 LEDGER-DEAF-P3 (P0, 2026-07-17) — root cause: async-nats publish lost ───
  LEDGER_DEAF_P3 = {
    id: "LEDGER-DEAF-P3"
    owner: "DS [S] impl  ·  Claude [O] if async-nats internals"
    date: "2026-07-17"
    priority: "P0 root cause — deaf until S3* findings reach the broker"
    diagnosis_recap:
      "Double fault. Fault 1 (fixed): vsf-s5-ledger ran a STALE PID until DS restarted it
       (PID 141327); it now connects+auths+subscribes (3 subjects) but in_msgs=0.
       Fault 2 (THE bug, open): S3* (Rust vsf-s3-star, async-nats 0.49.1) logs
       '[s3_star.algedonic] FIRED (transport=nats)' but the publish NEVER reaches the
