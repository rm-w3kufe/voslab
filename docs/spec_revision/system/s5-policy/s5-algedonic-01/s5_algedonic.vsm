// ─── 1. WHAT THE ALGEDONIC CHANNEL IS ───
//
// The algedonic channel (from Greek ἀλγηδών "pain") is S5's sporadic escalation path:
// how urgent signals reach rmw3. It is the CAUTION_MODE trigger line — distinct from S3's
// routine monitoring (φ↑ → S3 homeostasis) and from S3*'s regular audit (events.jsonl chain).
// Algedonic = pain signals, by design INFREQUENT and HIGH-severity.
//
// Anatomy (LXC 104, services from CLAUDE.md):
//   ┌─ vsf-s5-algedonic    (triage classifier 60s; consumes NATS algedonic subjects)
//   ├─ vsf-g6-algedonic-sink (forwards S3* findings → ledger)
//   ├─ vsf-s5-ledger       (persists findings to @algedonic_ledger)
//   └─ vsf-s5-covenant     (covenant-floor enforcement; the ax_S5CautionVeto enforcer)
// Path-of-fire: S1/S3* finding → NATS algedonic subject → sink → triage classifier
//                → ledger.db INSERT → severity ≥ 8.0 ⟹ caution_mode := active
//                (ALWAYS_INSERT_EVENTS + cycle_summary skip in q17_backfill).
//
// Severity map (canonical, from @ledger_py SEVERITY_MAP):
//   covenant_halt       8.0   ← always inserts (vsf.vsf.s5.covenant_halt subject)
//   semantic_divergence 7.0   ← S3* shadow_recompute vs nucleus stasis_cos mismatch
//   emit_silence        6.0
//   invariant_breach    5.0
//   algedonic           5.0   ← generic
//   signal_escalated    4.0
//   drift_alert         3.0
//
// DRIFT RESOLVED (claude_review 2026-08-07): semantic_divergence = 7.0. THE CODE IS
// RIGHT AND THE SPEC WAS WRONG.
//   @ledger_py:52 records 7.0, and `git log -p --all` shows 7.0 is the ONLY value ever
//   committed ⟹ the 'spec pre-dates a recalibration' hypothesis is FALSE.
//   The `sev-8` in @dir_algedonic_spec NOISE-FAMILY-EVIDENCE:33 is a loose label inside a
//   triage checklist, ¬a severity declaration.
//   STRUCTURAL reason 7.0 is correct: caution_mode fires at severity ≥ 8.0. With 133
//   semantic_divergence signals, at 8.0 EVERY ONE would suspend all S3 decisions for
//   1800s ⟹ permanent caution mode. 7.0 sits deliberately below the veto line.

// ─── 2. CAUTION_MODE — the S5 veto (from covenant_ops §caution_mode) ───

caution_mode = {
  trigger:   "∀ algedonic event e:
                severity(e) ≥ 8.0
                ∨ category(e) ∈ {service_down, covenant_drift,
                                 covenant_ops_binding_drift, s5_stress}
              ⟹ S5.caution_mode := active"
  while_active:
    "∀ a ∈ s3_decision: suspend(a)
     log(a) as s3_caution_hold ∈ D4-L2, observable (NOT hidden)
     ¬suppress(s3_escalation)   // caution amplifies urgency, S3-Claude escalation flows"
  clear:
    "s5_clear(explicit) ∨ t ≥ CAUTION_DURATION_S (1800s)"
  fail_safe:
    "disconnect(NATS) ⟹ caution_mode := false   // no phantom veto on isolation"
  authority:   "S5 (Beer: S5 can veto S3 autonomy; this is the operational ceiling)"
  enforced_by:
    ["vsf_algedonic_subscriber.py#CautionState (LXC 104 state machine + HTTP :8091/caution)",
     "ac_algedonic.py#_check_caution_mode (blocks RC-3/RC-4 auto-revert + phi_down when active; 2026-06-26)",
     "s5_caution.rs#start_caution_subscriber + operational.rs#s3_caution_hold (Rust, pending)"]
  trigger_cli:    "@s5_stress_cli [activate|clear|status] — WSL CLI for rmw3(S5)"
  m7_chain:       "vsf_algedonic.jsonl HMAC-SHA256 chain; key=@alg_hmac_key; epoch 2026-06-26"
  axiom_ref:      "covenant_ops.vsm#§regulation.caution_mode (compressed into boot/regulation_layer.vsm)"
}

// ─── 3. HARD RULES (from RULES.md / R4-R12-R10) ───

hard_rules = {
  R4:  "Claim ≠ evidence. An automated triage classifier may close a signal ONLY with
        attached machine-checkable evidence; narrative-only dismissal is BANNED (was R12 —
        merged into R4 2026-08-03). This is WHY the 164-signal backlog exists: triage could
        not close them with evidence → escalated pending_human."
  R10: "No LLM in the algedonic path. The triage classifier is a decision tree
        (ac_classifier.py, 23 tests); Qwen was removed from the algedonic path 2026-06-10
        (cost minutes/classification + 5-gap reliability harness; the decision tree does
        the same in milliseconds)."
  R4_deploy:
    "deploy ≡ stop → verify(PID gone, ps) → push → start
              → verify(/proc/<pid>/exe) → prove end-to-end:
                NEW finding ⟹ NEW ledger row
     src: @dir_incidents 2026-08-02_clima_nats_observability_incident phase D"
}

// ─── 4. CROSS-CUTTING PRINCIPLES (from the 6 incident specs) ───

principles = {
  detector_liveness:
    "silence(RECORD) ≢ silence(WORLD).
     ¬recent ledger row ⟹ ¬conclude ¬recurrence. FIRST confirm:
       (a) the DETECTOR still emits this type at SOURCE (S3* chain events.jsonl)
       (b) source → ledger forwarding is live: new finding ⟹ new ledger row
     map ≢ territory; check the surveyor, ¬only the map.
     cost of the trap: ledger LOOKED healthy 5.5 days while S3* was firing
     (LEDGER-DEAF-FIX)"
  repair_not_silence:
    "repair ≻ silence.
     ε ← 0.03 to kill semantic_divergence ⟹ blinds the audit on 0-0.03 ⟹ REJECTED (A).
     fix the capture phase (C) ⟹ RESTORES the audit.
     same principle as merkle ▪ f64 ▪ wail: repair, never mask
     (SEMANTIC-DIVERGENCE-FIX)"
  honest_state:
    "A 'pending' in enforced_by is an HONEST state (axiom not yet code-linked), not a
     failure state. Same for caution state machine — undeployed pieces are named, not
     hidden. (Ax_TraceabilityClosure via regulation_layer.vsm)"
  minimum_diff:
    "Nucleus fixes ship with the MINIMUM diff possible. Cosmetic display precision
     ({:.6} → {:.9}) stays a separate companion, NOT in the fix commit.
     (SEMANTIC-DIVERGENCE-FIX §companion)"
}

