// write_gates.vsm — WRITE-TIME GATE REGISTRY
// Agent-agnostic: gates discovered via vos_discover.py

map(AGENT-WRITE-GATES) {

  gates: [

    // R18 conformance
    gate("r18-conformance") {
      cmd: "python3 scripts/vsl/validator/check.py",
      mode: per-file,
      label: "R18",
      block_on: "contains:R18-BLOCK",
      advisory: false,
      owner: "S3* auditor",
      desc: "R18 write-time conformance",
    },

    // SOCRATIC-CLASSIFY (BLOCKING since 2026-09-10, S5 promotion:
    // HOMES recalibrated for docs/plans/+archive, verified both directions;
    // unknown homes fail open by design (rc 0), mismatches quarantine+throw)
    gate("socratic-classify") {
      cmd: "python3 scripts/vsl/classifier/socratic_gate.py",
      mode: per-file,
      label: "SOCRATIC-CLASSIFY",
      block_on: "nonzero",
      advisory: false,
      owner: "S3* auditor",
      desc: "CLASSIFY tree vs real dir; UNKNOWN advisory (R9), mismatch blocks",
    },

    // VSM signature normalize (advisory — S5 rmw3 approved 2026-09-09,
    // design docs/plans/write_hook_autofix.vsm; never blocks)
    gate("vsm-normalize-suggest") {
      cmd: "python3 scripts/vsl/tools/vsm_normalize.py",
      mode: per-file,
      label: "VSM-NORMALIZE",
      block_on: "nonzero",
      advisory: true,
      owner: "S3* auditor",
      desc: "Suggest signature-only repairs as unified diff",
    },

  ]
}

