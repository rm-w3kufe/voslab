@vsm 1.2.1
@status active
// docs/spec_revision/system/s5-policy/readme.vsm — ROLE AND FUNCTION OF s5-policy/.
// S5 DECISION rmw3 2026-08-14 (translated from Spanish) (DIR-readme-POLICY +
// reinforcement policy): s5-policy/ = the policy — the criteria we always
// fall back to.
// This readme is the directory's gate: read it before entering.

system(readme) {

  synthesis: "s5-policy/ := the recursion's POLICY — criteria nobody can
              override (identity, covenant, hard rules, agent policy,
              learning cycle). All PERMANENT technical material of a policy
              lives here (mirror: vsl-language/ reference set, 14 specs).",

  structure: [
    dir("s5_policy_core.vsm",  role="core",      desc="root principles — 0. PRINCIPLE (S5-POLICY-CORE-01)"),
    dir("vsl-language/",       role="ref-set",   desc="vsl_language reference set — 14 specs (VSL-LANG-*), index index.vsm"),
    dir("learning_cycle.vsm",  role="policy",    desc="learning cycle (LEARNING-CYCLE-POLICY-01) — detect→classify→persist→fix→verify→trace"),
    dir("agent-policy/",       role="policy",    desc="LLM agent policy (AGENT-POLICY-v1, active A5 2026-08-15) + agent_map (census) + agent_instruments (organelles). design-sources/ MOVED OUT 2026-08-17 → docs/spec_revision/design-sources/ (level 1; live design authority for R16, NOT policy — CLASSIFICATION-POLICY-PLAN S2)"),
  ],

  policy: "
    a transversal system criterion → lives here (s5-policy/)
    the permanent technical material of a policy → subdirectory here
    (vsl-language/, agent-policy/, learning_cycle/) — NEVER in sandbox
    (ephemeral rail — dir_schema says so)
    an S5 policy demands S5-local: verifier + checks + gates (policy-and-
    praxis doctrine, translated from Spanish) — it is not a declaration, it
    is implemented
    agent policy → DO NOT fragment by organ (common scope);
    NO parallel dir (it is the upper recursion)",

  verification: "dir-schema-valid (BLOCKING) + boot-manifest-valid (if boot is touched)",
}

⟦ /readme ⟧