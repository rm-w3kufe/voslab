@vsm 1.2.1
@status ratified
// s5-policy/vsl-language/axioms_extension.vsm — axioms A12-A15
// Source: vsl_language §2 axioms (addendum 2026-05-09).
// A1-A11 are declared in core_boot_primer.vsm — NOT re-stated here.
// A0/A0.1 in boot/covenant.vsm. Writing core: boot/vsl_language_primer.vsm.

axioms_extension("VSL-LANG-AXIOMS-EXT") {

  axioms_a12_a15: "
    A12 hardware_ceiling:
      Ax_HardwareCeiling: ∀x: x ∉ Ω_VSF ⟺ governance(x)
        ∈ {firmware, MMU, thermal_sensor}
      // certification lower boundary at L+3; beyond = hardware.
      // structural blind spot, not deficiency. impl: src/hardware/ingest.rs

    A13 recurrent_set:
      Ax_RecurrentSet: ∃ compact R ⊂ Ω:
        P(x_t ∈ R i.o.) = 1 ∧ E[ΔL] ≤ −ε < 0 ∀x ∉ R
      // Lyapunov descent guaranteed OUTSIDE R, not globally;
      // stationary fluctuation within R expected (sistema vivo).
      // ⟹ positive recurrence ⟹ unique ergodic measure.

    A14 ψ_preservation:
      Ax_ψ_Preserve: ψ(x_A, x_B) ∈ Ω_AB ⟺ x_A ∈ Ω_A ∧ x_B ∈ Ω_B
        ∧ trust_AB ≥ min(trust_A, trust_B)
      // The no-upgrade property is carried by the Ω CONJUNCTION
      // (x_A∈Ω_A ∧ x_B∈Ω_B): coupling cannot rescue an input already
      // outside its own viability set. The trust clause is a separate FLOOR —
      // joint trust ≥ weakest link, not at most.
      // Formula verified verbatim against its source,
      // spec/vsm_notation_spec_addendum_2026-05-09.md:51; used as (P4) in
      // theory/composition_proof.vsm:28. strengthens D11; PSI/1.0.
      // CAVEAT (canon verbatim, vsl_language §2 A14): Known tension
      // recorded there at :99 — a large trust gap
      // strains P4 'in spirit'. strengthens D11; PSI/1.0.

    A15 Ω_closure:
      Ax_Ω_Closure: ∀ {μ_s ∈ Ω}_s=1..n: Σ_s w_s · μ_s ∈ Ω
        whenever w_s ≥ 0 ∧ Σ_s w_s = 1
      // Ω convex (intersection ellipsoids/half-spaces);
      // soft-mixing in-Ω stays in-Ω. grounds D15 viability.
      // empirical: deterministic_step_preserves_omega_membership
      // (src/operator.rs)",
}
⟦ /axioms_extension ⟧