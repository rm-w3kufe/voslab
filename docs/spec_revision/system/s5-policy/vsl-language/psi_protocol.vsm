@vsm 1.2.1
@status ratified
// s5-policy/vsl-language/psi_protocol.vsm — Perimeter of Stability Intervention
// Source: vsl_language §17 (psi_protocol/spec.vsm). Item of the reference
// set. Writing core: boot/vsl_language_primer.vsm. D4-Ln cited, not re-stated.

psi_protocol("VSL-LANG-PSI") {

  PSI: "
    PSI(\"Perimeter of Stability Intervention\") = {
      purpose:   when S4 (LLM) may observe and optionally support stressed S1
      principle: intervention = support under stress, not rescue from collapse
      covenant:  A0.1 — S4 may propose, never impose
    }
    θ_PSI = 0.79 (cosine stasis_cos; angle 37.9°) — PRECAUTIONARY, not failure
      threshold; basin floor under max activation perturbation (δ=1.0, 300 ticks)
      upper_bound 0.9377 (critical angle, thermal) | floor 0.70 (sv.viable())
      // WORKING VALUE — calibrates (S5 2026-06-22); numbers calibrate,
      // protocol shape stable. Q2: may become time-varying (senescence)
    trigger(PSI):
      primary: stasis_cos < θ_PSI
      secondary: sustained N_SUSTAINED=3 consecutive ticks
      inhibit: recovering (dcos/dt > 0)
      emergency: viable_full = false
    intervention_levels:
      INT-L1_observe: stasis_cos < 0.90 — monitoring, no φ↓. fully automatic.
      INT-L2_support: stasis_cos < θ_PSI sustained — φ↓ suggestion to S3
                  (reduce load/reallocate). S4-autonomous within pre-authorized
                  bounds (D4-L2). suggestion, not command.
      INT-L3_escalate: stasis_cos < 0.72 ∨ viable_full=false — human via algedonic.
                  requires_human for EXPANDING action. CONTRACTING fail-safe
                  pre-authorized. S4 NEVER 'takes charge'.
    fail_safe_asymmetry:
      autonomous emergency action ONLY for CONTRACTING moves (shed load,
      reduce scope, halt cleanly), NEVER EXPANDING (novel, acquire, policy)
      // contraction can not seize authority → pre-authorisable; expansion always
      // can → always human. human approval = DESIGN-time act, not execution-time.
      // no_llm: executed by deterministic reflex layer (Rust), not S4/Qwen (D6/R10)
    fail_safe_ladder (precondition: D4-L3 ∧ not human-ack within T_ack ∧ still degrading):
      T_ack = 300s (WORKING VALUE — calibrates)
      S1 — shed all non-critical load (maximal D4-L2; deterministic; reversible)
      S2 — quiesce to minimal viable kernel
      S3 — if STILL inviable: clean halt with state snapshot preserved
      properties: monotone_contracting ▪ deterministic ▪ bounded (clean halt) ▪
        reversible (human-return ∨ recovery exits) ▪ state_preserved (snapshot) ▪
        non_harm (halt = sleep, not death)
      algedonic: keeps firing on ALL channels through ladder (full trace waits)
    angustia_signal (φ↑ events.jsonl, type=angustia):
      { tick, stasis_cos, level: L1|L2|L3, dcos_dt, viable_full,
        entropy_phase: stasis|inhale|degen|exhale }
    recovery: stasis_cos ≥ θ_PSI for 5 ticks → PSI deactivates; outcomes logged
      (recovered | escalated | spontaneous)
    covenant: A0 support-only ▪ A0.1 no scope expansion ▪ A5 ceiling ▪
      D4-L2+contraction = class_execution | D4-L3 expansion = policy_change ▪
      D6 deterministic Rust (not LLM in safety path)",
}
⟦ /psi_protocol ⟧
