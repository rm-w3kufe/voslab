  source_spec: "SEC-001; docs/spec/bbh_lab/*.spec.vsm; scripts/audit/*; scripts/state/firewall,cyberfilter; s5_governance.",
  validation_gates: "G1: attack-surface-expansion + policy-atomization + finding-validation-gate + program-intel-canonical all modeled; G2: adversarial red-team tests.",
