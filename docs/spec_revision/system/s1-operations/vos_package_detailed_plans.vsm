  source_spec: "NONE in ~/vsf (only vsf_nats client + rsi_pattern_detector exist) -> BUILD FROM SCRATCH.",
  validation_gates: "G1: event bus + CQRS command/query separation; G2: NATS publisher/subscriber round-trip using vsf-nats client; G3: adversarial — dropped message MUST be detected.",
}
