  status: pinned,
  purpose: "Public recursive-evaluation engine. HARD dep of vsf-rsi (P2).",
  source_spec: "PyPI socratic-engine; scripts/vsl/classifier/socratic_*.py (vsf bridge) + support/trees.",
  validation_gates: "G1: evaluate(socratic_tree) certified; G2: adversarial — contradictory tree MUST be flagged.",
