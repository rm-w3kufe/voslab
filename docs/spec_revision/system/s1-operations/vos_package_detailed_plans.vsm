// ───────────────────────────────────────────────────────────────────────────
// §4b scenario-memory — PROCEDURAL LEARNING (design, rmw3 2026-08-29 "hagamos 1 y 2")
// Full narrative proposals already exist (docs/scenario_memory_*.vsm,
// docs/proposals/scenario_memory_*.vsm — status implemented/ratified). This plan
// makes the package GATE-AUDITABLE (P5): a resolvable source_spec + adversarial
// validation gates. Build deferred until autonomy guarantee is certified.
// ───────────────────────────────────────────────────────────────────────────
plan("scenario-memory") = {
  status: implementing,
  purpose: "Procedural / scenario learning: the system observes its own socratic decisions and outcomes, stores them as reusable scenarios (IRs + scenario records), and matches/adapts procedures for similar future contexts. Realizes second-order cybernetics — the observer is part of the system. Together with the autonomy-guarantee, it closes the self-correcting loop (the observer that watches the watcher).",
  source_spec: "child/docs/scenario_memory_*.vsm child/docs/proposals/scenario_memory_*.vsm child/scripts/vsl/check_principle_gate_trace.py child/scripts/vsl/scenario_memory.py",
  validation_gates: "G1: every stored scenario cites a concrete decision+outcome (no silent memory); G2: matching MUST retrieve a relevant past scenario for a novel context (negative-control: unseen context returns UNKNOWN, not a hallucinated match); G3: adversarial — a corrupted/forged scenario MUST be rejected by the gate; G4: scenario writes go through verify_child (hook-enforced).",
  depends_on: ["socratic-engine", "gate-suite"],
}

// ───────────────────────────────────────────────────────────────────────────
// §5 NEXT
// ───────────────────────────────────────────────────────────────────────────
next("build-order") = {
  order: "vsf-rsi (rebuild, highest risk) -> vsf-predicates -> vsf-patterns -> vsf-security ->
          vsf-intelligence -> vos-kernel -> gate-suite -> state-canon-infra/agent.",
  rule: "Each built per §0 discipline; certified before pinning into vOSLAB. Nothing passes
         from ~/vsf to ~/vOSlab without conformance + adversarial certification (P4/P5/P6).",
}
