@vsm 1.2.1
@status active

@binding user(rmw3 S5) 2026-08-29 + child/docs/vos_packaging_principles.vsm (P1-P6)

// DETAILED PLANS per vOSLAB package. Each package is validated with HARD tests
// against (a) its OWN spec AND (b) the ~/vsf source specs of the scripts/plugins
// it derives from (P5). NO script/plugin in ~/vsf is left without a home (P4).
// ALL validation is adversarial before acceptance (P6): model vs reality, certify.

// ───────────────────────────────────────────────────────────────────────────
// §0 VERIFICATION DISCIPLINE (P6) — applied to EVERY package below
// ───────────────────────────────────────────────────────────────────────────
verify_discipline("per-package") = {
  step_1_model_vs_reality: "R7: declared behavior == observed. Never trust recall or state-canon alone (it is a compass).",
  step_2_adversary: "Take adversary role: hunt gaps, holes, technical debt, contradictions, bugs. Negative-control tests MUST exist and MUST be able to fail.",
  step_3_dual_spec: "Tests prove the package fulfills (a) its package spec AND (b) the ~/vsf source spec of each source script/plugin.",
  step_4_certify: "Only after 1-3 passes is the package CERTIFIED. Speed irrelevant; completeness mandatory.",
}

// ───────────────────────────────────────────────────────────────────────────
// §1 CORRECTED PACKAGE REGISTRY (supersedes voslab_packaging_proposal where conflict)
// ───────────────────────────────────────────────────────────────────────────
registry("voslab") = {
  note: "vsf-rsi-core + vsf-rsi-vsf MERGED -> vsf-rsi (single public pkg, socratic-engine hard dep) per P2.",
  public: [
    "vsf-common        (done; README+lic; 4 tests)      -> stable",
    "vos-chassis       (done; README+lic; 3 tests)      -> stable",
    "vsf-tools         (done; de-VS extract; 5 tests)   -> stable",
    "vsf-rsi           (REBUILD; merged core+vsf; socratic-engine hard dep) -> design",
    "vsf-patterns      (build-from-scratch; no ~/vsf source) -> design",
    "vsf-predicates    (from scripts/vsl/classifier/*_predicates.py) -> design",
    "vsf-security      (from SEC-001 / bbh_lab specs)   -> design",
    "vsf-intelligence  (from forecaster / omega specs)  -> design",
    "socratic-engine   (PyPI pin; external, reused)     -> pinned",
    "state-canon-mcp   (PyPI pin; external, partial)    -> pinned",
  ],
  framework: [
    "vos-kernel        (from s1-kernel/s3/s4/s5 + vos_kernel_spec) -> design",
    "gate-suite        (from .opencode/plugins gap-* + handlers)   -> design (built in vOSLAB)",
    "state-canon-infra (from scripts/state/* infra subset)          -> design",
    "state-canon-agent (from scripts/state/* agent subset)          -> design",
  ],
}

// ───────────────────────────────────────────────────────────────────────────
// §2 vsf-rsi — DETAILED PLAN (corrected: single public package)
// ───────────────────────────────────────────────────────────────────────────
plan("vsf-rsi") = {
  purpose: "Recursive self-modification / cybernetic-ACTION engine. Its recursive engine is
            socratic-engine: RSI generates decision structures (trees/predicates) in socratic()
            format; socratic-engine evaluates them; RSI evolves them via GA and closes the loop
            on the live system (feedback_loop). L1 Auto-Optimization, L2 Auto-Modification,
            L3 Auto-Generation, L4 Auto-Evolution (rsi_roadmap.vsm).",
  status: "audit-6-gaps (2026-08-30) — built at child/vOSlab/vsf-rsi/ v0.2.0 but 6 structural
           gaps found in audit. See rsi_roadmap.vsm §GAP-1 through GAP-6. NOT ready for
           promotion to ~/packages/public/ until gaps are closed.",
  dependency: "socratic-engine (PyPI, HARD dep) — declared in pyproject [project.dependencies].",
  audit_gaps: [
    "GAP-1: code duplication (scripts/ vs child/vOSlab/vsf-rsi/src/vsf_rsi/)",
    "GAP-2: _load_manifest placeholders in 4 files (write-only, no read-back)",
    "GAP-3: no automated tests (demo scripts, not pytest)",
    "GAP-4: forest fitness=0.0 (loop not closed)",
    "GAP-5: no system integration (event-router, coupling, gap-resolver)",
    "GAP-6: scenario-memory not connected to RSI",
  ],
  source_spec_conformance: [
    "@rsi_roadmap",
    "@rsi_generated_predicates",
    "@rsi_generated_trees",
    "@rsi_forests",
    "@rsi_level1-4_results",
    "scripts/vsl/classifier/rsi_*.py (13 files) — component inventory below",
  ],
  component_inventory: [
    "rsi_metrics.py             -> RSIMetrics (L1 measurement)",
    "rsi_genetic_algorithm.py   -> RSIGeneticAlgorithm (L2/L3 evolution)",
    "rsi_genetic_algorithm_v2.py-> RSIGeneticAlgorithmV2 (improved operator set)",
    "rsi_tree_generator.py      -> TreeGenerator (L3 tree synthesis)",
    "rsi_advanced_tree_generator.py -> AdvancedTreeGenerator (L4)",
    "rsi_predicate_generator.py -> PredicateGenerator (L3 predicate synthesis)",
    "rsi_component_registry.py  -> ComponentRegistry (registry of RSI parts)",
    "rsi_tree_registry.py       -> TreeRegistry (registry of generated trees)",
    "rsi_forest_generator.py    -> ForestGenerator (rsi_forests.vsm)",
    "rsi_gap_detector.py        -> GapDetector (finds system gaps to close)",
    "rsi_feedback_loop.py       -> FeedbackLoop (closes loop on live system)  [THE CYBERNETIC ACTION HALF omitted in vsf-rsi-core]",
    "rsi_pattern_detector.py    -> PatternDetector (pattern recognition)",
    "rsi_demo.py / test_rsi_level*.py -> demos + level tests (L1-L4)",
  ],
  rebuild_notes: "The deleted vsf-rsi-core captured ONLY metrics+GA (the sensor half) and was
            de-VS-ed to 'agnostic', severing the socratic-engine coupling. Rebuild vsf-rsi with
            ALL 13 components above + socratic-engine hard dep + end-to-end cybernetic loop.",
  validation_gates: [
    "G1 (own spec): all 4 levels (L1-L4) instantiable and runnable from a single entrypoint.",
    "G2 (source spec): generated trees/predicates EVALUATE under socratic-engine (import socratic_engine; evaluate(tree) returns certified truth).",
    "G3 (adversarial, P6): end-to-end test — generate tree -> evaluate via socratic-engine -> evolve via GA -> MEASURABLE improvement on a metric (accuracy/latency/gap-count). Negative-control: feeding a broken tree MUST fail evaluation.",
    "G4 (no orphan): every rsi_*.py maps to a vsf-rsi component; nothing left in scripts/ unclaimed.",
  ],
}

// ───────────────────────────────────────────────────────────────────────────
// §3 COMPLETENESS AUDIT — map EVERY ~/vsf script/plugin to a package (P4)
// ───────────────────────────────────────────────────────────────────────────
// First-pass mapping from survey 2026-08-29. OPEN items = gaps requiring a
// package or build-from-scratch decision. This audit is the anti-orphan gate.
audit("scripts") = {
  vsl_classifier_rsi:   "scripts/vsl/classifier/rsi_*.py (13) -> vsf-rsi",
  vsl_classifier_pred:  "scripts/vsl/classifier/*_predicates.py (analytics,chain,governance,health,vsf_hooks,vsf) -> vsf-predicates",
  vsl_classifier_socr:  "scripts/vsl/classifier/socratic_*.py + vsf_socratic_engine.py -> socratic-engine (vsf bridge)",
  vsl_classifier_misc:  "scripts/vsl/classifier/classify.py, A0_classifier.py, demo_*.py, eval_tree_vsf.py, generated/ -> vsf-predicates / socratic-engine (OPEN: split)",
  vsl_core:             "scripts/vsl/parser, validator, tools, templates, benchmarks -> socratic-engine (VSL tooling) + vsf-common (shared helpers) (OPEN: split)",
  shared_gen:           "scripts/shared/gen_index.py, http_server_mixin.py -> vsf-tools (DONE)",
  shared_canon:         "scripts/shared/canon_census.py, docs_reconcile.py, relocate_vsm.py, sd_digest.py, update_manifest_*.py, verify_scripts_manifest.py -> vsf-common (canon tooling)",
  shared_git:           "scripts/shared/git_commit_msg.sh, git_pre_commit.sh, event-log.sh -> vos-chassis (git hooks) / vsf-common",
  shared_net:           "scripts/shared/vsf-net-housekeeping.* -> vsf-security or vos-chassis (OPEN)",
  state_all:            "scripts/state/* (agent-plugin-log, algedonic, attestation, config, core, coupling_manifests, cyberfilter, data, firewall, governance, lifecycle, monitoring, services, session_learning_scan.sh, shared, sql, systemd, tasks, tests) -> state-canon-infra + state-canon-agent + state-canon-mcp (OPEN: partition by consumer)",
  s1_kernel:            "scripts/s1-kernel/* -> vos-kernel (S1 kernel)",
  s3_alloc:             "scripts/s3-allocation/* -> vos-kernel (S3 allocation) / vsf-intelligence",
  s4_orch:              "scripts/s4-orchestration/* -> vos-kernel (S4 orchestration)",
  s5_gov:               "scripts/s5-governance/* -> vos-kernel (S5 governance) / vsf-security",
  algedonic:            "scripts/algedonic/* -> vos-kernel (algedonic channel)",
  analysis:             "scripts/analysis/* -> vsf-intelligence (analytics)",
  audit:                "scripts/audit/* -> vsf-security (audit)",
  deploy:               "scripts/deploy/* -> vos-chassis (deploy) / vsf-security",
  docs_exp_legacy_llm_plan_tests: "scripts/docs,exp,legacy,llm,plan,tests -> TBD per content (OPEN)",
}

audit("plugins") = {
  core:       ".opencode/plugins/core/* (vsl-check-on-write, vsl-measure-before-write, naming-enforcer) -> vos-kernel (core gates)",
  operational: ".opencode/plugins/operational/* (event-router, lifecycle-autopilot, handlers/*, gap-resolver, gap-definitions, gap-context, gap-actions) -> gate-suite + state-canon-* (OPEN: partition)",
  manual:     ".opencode/plugins/manual/* (classify-on-write, agent-vsl-gate, relocate-on-write) -> vos-kernel (manual gates) / vsf-common",
  support:    ".opencode/plugins/support/* (socratic-shell, trees/*) -> socratic-engine (trees) + vos-kernel",
  scripts_dir: ".opencode/plugins/scripts/* -> vsf-tools / vos-chassis (OPEN)",
}

// ───────────────────────────────────────────────────────────────────────────
// §4 OTHER PACKAGES — intent + source-spec conformance + validation gates
// ───────────────────────────────────────────────────────────────────────────
plan("vsf-common") = {
  status: done,
  purpose: "Cross-package coupling contract (CouplingSpec) + shared canon tooling.",
  source_spec: "scripts/shared/canon_*.py, update_manifest_*.py, verify_scripts_manifest.py; kernel coupling spec.",
  validation_gates: "Already 4 tests; adversarial: a rejected coupling MUST raise; valid coupling MUST register.",
}
plan("vos-chassis") = {
  status: done,
  purpose: "Load endpoints + wire couplings; deploy/orchestration substrate.",
  source_spec: "scripts/deploy/*; s1_lifecycle_coupling.spec.vsm; coupling_manifests/*.coupling.json.",
  validation_gates: "3 tests; adversarial: missing endpoint file MUST raise FileNotFoundError; rejected coupling MUST raise.",
}
plan("vsf-tools") = {
  status: done,
  purpose: "Leaf utilities (http mixin, index generator) de-VS-ed.",
  source_spec: "scripts/shared/http_server_mixin.py, gen_index.py.",
  validation_gates: "5 tests; adversarial negative-control for unquoted frontmatter scalar.",
}
plan("vsf-patterns") = {
