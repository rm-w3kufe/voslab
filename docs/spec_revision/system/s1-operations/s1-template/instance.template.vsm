@vsm 1.2.1
@status template
// system/s1-operations/s1-template/instance.template.vsm
// The S1 INSTANCE schema — what one unit of work IS.
//
// PUBLICATION-SAFE. Shape ∄ values.
//
// Pairs with contract.template.vsm beside it:
//   instance  → what the unit IS       (here)
//   contract  → what it is coupled TO
// Both are required. An S1 with one of them is half-declared, and validation
// checks for the PAIR, ¬for either alone.

s1_instance("<S1-ID>") {

  identity: {
    unit:        "<name>",
    domain:      "<the slice of the world this unit regulates>",
    is_a:        "a full V with its own S1..S5 — ¬a subsystem of its parent",
    purpose:     "<what it does ▪ why ▪ WHAT FAILS IF IT IS ABSENT>",
    // The third clause earns the unit its resources.
    // Absence that breaks nothing is absence nobody funds.
  },

  substrate: {
    execution:   "<where it runs — kind of unit, ¬an address>",
    isolation:   "<crash domain ▪ network boundary ▪ resource boundary>",
    services:    "<the processes that constitute it>",
    scale:       "<how many of each, and what DRIVES the count>",
    // A new S1 gets its OWN crash domain.
    // Co-locating two means one failure takes both,
    // and the topology stops matching the model.
  },

  // ── VIABILITY — how this unit knows it is alive ──
  viability: {
    signal:      "<the scalar it reports as its own health>",
    omega:       "<the viable set IN THIS DOMAIN — ¬the parent's>",
    threshold:   "<below which it is ¬viable>",
    measured_by: "<what computes it ▪ is that INDEPENDENT of what it grades?>",
    // Work and grade from one codebase ⟹ SELF-REPORT. Say so.
    // A self-report is evidence, just weaker.
    // Pretending otherwise IS the defect.
  },

  // ── TOPICS — what it publishes, under the grammar ──
  topics: {
    grammar:     "<the subject namespace this unit writes under>",
    rule:        "a unit writes its OWN subtree, reads ∄ sibling's (A4)",
    phi_up:      "<telemetry subjects>",
    algedonic:   "<the emergency subject — bypasses every filter BY DESIGN>",
    cadence:     "<per subject: period, and what a GAP means>",
  },

  // ── PARAMETERS — the tunable surface ──
  parameters: {
    declared:    "<∀ parameter: {name, value, unit, source, who may change it}>",
    source_rule: "∄ source ⟹ a GUESS with a decimal point.
                  measured | derived | assumed.
                  If derived: from WHAT.",
    drift_class: "<which may move autonomously (single-loop),
                  which need a human (double-loop)>",
    // Derived values carry their FORMULA, ¬a rounded literal.
    // Two documents here rounded one quantity differently;
    // neither could follow its input.
  },

  autonomy: {
    ceiling:     "<highest class it may act on alone — ≤ the parent's>",
    single_loop: "<what it does without asking>",
    double_loop: "<what it escalates, ALWAYS>",
    refuses:     "<what it will ¬do even when instructed>",
  },

  lifecycle: {
    start:       "<preconditions before it may run>",
    healthy:     "<steady state, in measurable terms>",
    degraded:    "<the honest reduced mode, and what it stops guaranteeing>",
    stop:        "<who may stop it, and by which loop class>",
    // Stopping a unit is a TOPOLOGY change.
    // S3 may only RESIZE ⟹ stopping is double-loop:
    // authority to allocate ≠ authority to end.
  },

  gate: "<the condition under which this unit may operate.
         State the CURRENT closure criterion.
         A precondition already MET is ¬the blocker.
         Citing one opens the gate by accident:
         the next reader checks it, finds it green, starts>",

  contract_ref: "<this unit's contract document — the pair is mandatory>",
}

⟦ /instance.template ⟧
