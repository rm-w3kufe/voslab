@status conjecture
// system/s4-intelligence/anticipatory_prevention.vsm — the anticipatory prevention theorem
// role: CONDITIONAL mathematics — true independent of empirical validation
// feeds: @src_s4_anticipation §formal ▪ the AC paper §2.5 continuation
// author: Claude (Opus 4.8), 2026-07-14. Reuses the Foster-Lyapunov /
//         convexity-free machinery of the Fierro addendum — there existence
//         and contraction, here the SAME tool proves prevention.
//
// CERTIFIED 2026-08-08. Two symbol collisions with the canon were resolved —
// see notation. Both were central symbols, ¬incidental ones.

thesis: "the Perron-Frobenius projection of AC §2.5 is DESCRIPTIVE — it
         predicts excursions. The anticipatory pre-grant makes it
PRESCRIPTIVE: a pre-grant inducing viable drift provably does not
         increase, and under a drift condition strictly reduces, the excursion
         probability.  prediction → prevention, on one machinery."

notation = {
  L:   "the Foster-Lyapunov function, L: S → [0,∞)",
  // WAS V. V is the VIABLE SYSTEM in the canon — V(id, L) — and it appears in
  // every document in this corpus. `V(σ)` read as "the viable system at σ".
  // The canon already names this object L(x); the document's own prose calls
  // it a Lyapunov supermartingale. Convention loses to canon when the canon
  // symbol is that central, and here the canon symbol was ALSO the right one.
  Exc: "the excursion set",
  // WAS E. E(L) is the ENVIRONMENT in ⟨S1..S5⟩ @ E(L), and 𝐄 is expectation
  // three lines away — E and 𝐄 differ by weight alone. Exc collides with
  // ∄ canon symbol and reads at a glance.
  P:   "transition kernel — KEPT. P is the convention in Markov-chain
        literature and this is a probability document. It collides only with
        the positional argument P of VSM_Execute, a different arity in a
        different context. Declared here so a sweep ¬reports it",
  𝐄:  "expectation ▪ 𝐏 probability ▪ ℱ_k the filtration",
}

// ─── SETUP ───────────────────────────────────────────────────────────────

setup = {
  state_space: "finite, viability-ordered
                S = {σ_1 ≺ σ_2 ≺ … ≺ σ_K}, increasing stasis-cos
                σ_K = most viable
                ≡ the Markov-state binning of stasis_cos per zone, AC §2.5",
  excursion:   "Exc = {σ_1 … σ_m} — the m least-viable states, cos < θ_viable.
                Exc is a DOWN-SET (order ideal): y ∈ Exc ∧ x ⪯ y ⟹ x ∈ Exc",
  kernels:     "P   = base transition kernel, ERA5-fitted, row-stochastic
                P_Δ = the kernel under an anticipatory pre-grant of resource
                      margin Δ to the zone",
  target:      "n-step excursion probability under kernel Q:
                q_n^Q(σ) = 𝐏_σ^Q(τ_Exc ≤ n) ▪ τ_Exc = inf{k ≥ 0 : X_k ∈ Exc}",
}

definitions = {
  stochastic_order: "for laws μ, ν on the ordered S:
                     μ ⪯ ν  ⟺  μ(U) ≤ ν(U) ∀ UP-SET U",
  domination:       "P_Δ ⪰ P  ⟺  P_Δ(σ,·) ⪰ P(σ,·) ∀ σ
                     ⟹ from every state the pre-grant pushes more mass toward
                       viability. This IS the formal content of 'a pre-grant
                       biases local dynamics toward the viable direction'",
  monotone_kernel:  "Q is stochastically monotone ⟺ σ ⪯ σ′ ⟹ Q(σ,·) ⪯ Q(σ′,·)",
}

// ─── THEOREM 1 — monotone prevention, parameter-free ──────────────────────

theorem(Thm_MonotonePrevention) = {
  given:  "P_Δ ⪰ P ∧ both P, P_Δ stochastically monotone",
  then:   "q_n^{P_Δ}(σ) ≤ q_n^{P}(σ)   ∀ σ ∈ S, ∀ n ≥ 0",
  reads:  "the anticipatory pre-grant NEVER increases excursion probability,
           at ANY horizon",
  proof: [
    "Strassen ⊕ monotonicity ⟹ ∃ a Markov coupling (X_k, Y_k) with
     X_0 = Y_0 = σ ▪ X ~ P ▪ Y ~ P_Δ ▪ X_k ⪯ Y_k ∀k a.s.
     — the monotone coupling; domination is preserved step by step",
    "Exc is a DOWN-SET ⟹ Y_k ∈ Exc ⟹ X_k ⪯ Y_k ∈ Exc ⟹ X_k ∈ Exc",
    "at k = τ_Exc^Y we have X_k ∈ Exc ⟹ τ_Exc^X ≤ τ_Exc^Y a.s.",
    "⟹ {τ_Exc^Y ≤ n} ⊆ {τ_Exc^X ≤ n}
     ⟹ q_n^{P_Δ}(σ) = 𝐏(τ_Exc^Y ≤ n) ≤ 𝐏(τ_Exc^X ≤ n) = q_n^{P}(σ)  ∎",
  ],
  reading: "a safety floor with ∄ free parameter — the pre-grant CANNOT
            backfire. Observed harm would falsify the DOMINATION premise
            P_Δ ⪰ P — a mis-specified grant — ¬the theorem",
}

// ─── THEOREM 2 — quantitative prevention, Foster-Lyapunov ─────────────────

theorem(Thm_QuantitativePrevention) = {
  given:  "L: S → [0,∞) nondecreasing toward Exc ▪ L_Exc := min_{σ∈Exc} L(σ)
           ∧ the pre-grant makes L SUPERHARMONIC outside Exc:
             (P_Δ L)(σ) ≤ L(σ)   ∀ σ ∈ Exc^c                          (†)",
  then:   "q_n^{P_Δ}(σ) ≤ L(σ) / L_Exc    ∀ σ ∈ Exc^c, ∀ n",
  strict: "if additionally (P_Δ L)(σ) ≤ L(σ) − ε, ε > 0, on Exc^c
           ⟹ the P_Δ-chain is positive recurrent with stationary mass off Exc
           ⟹ the bound extends to n = ∞",
  proof: [
    "M_k := L(X_{k∧τ_Exc}) under P_Δ",
    "k < τ_Exc ⟹ 𝐄[M_{k+1} | ℱ_k] = (P_Δ L)(X_k) ≤ L(X_k) = M_k  by (†)
     ⟹ (M_k) is a nonnegative SUPERMARTINGALE",
    "optional stopping ⟹ 𝐄[M_{n∧τ_Exc}] ≤ L(σ)",
    "on {τ_Exc ≤ n}: M_{n∧τ_Exc} = L(X_{τ_Exc}) ≥ L_Exc, since X_{τ_Exc} ∈ Exc",
    "⟹ L_Exc · 𝐏(τ_Exc ≤ n) ≤ 𝐄[M_{n∧τ_Exc}] ≤ L(σ)
     ⟹ q_n^{P_Δ}(σ) ≤ L(σ) / L_Exc  ∎",
    "the strict-drift extension is standard Foster-Lyapunov positive
     recurrence",
  ],
  reading: "the Markov/maximal inequality via a Lyapunov supermartingale — the
            SAME drift tool the Fierro addendum uses for convergence, here
            bounding the HITTING probability of the excursion set",
}

// ─── THE GAP — why anticipation helps at all ──────────────────────────────

the_gap = {
  argument: "the bound L(σ)/L_Exc holds for P_Δ BECAUSE the pre-grant enforces
             (†). The un-granted P need ¬satisfy it: on the pre-excursion
             approach, environmental forcing can make (P L)(σ) > L(σ) — drift
             TOWARD Exc — so q_n^{P}(σ) is ¬controlled by L(σ)/L_Exc and can
             be materially larger",
  measurable: "q_n^{P}(σ) − q_n^{P_Δ}(σ) ≥ 0 by Thm_MonotonePrevention IS the
               benefit of anticipation. Thm_QuantitativePrevention makes the
               P_Δ side small whenever L(σ) ≪ L_Exc",
}

// ─── LEAD-TIME COROLLARY — H1 is NECESSARY for H2 ─────────────────────────

corollary(Cor_LeadTime) = {
  statement: "prevention (q_n^{P_Δ}(σ) < θ_alert) is achieved whenever the
              pre-grant fires while L(σ) < θ_alert · L_Exc — while the state
              is still deep in the viable core",
  is_about: "LEAD TIME. L increases toward Exc, so the antecedent is a
             condition on WHEN the directive fires, ¬on how strong it is",
  links: "the two pre-registered hypotheses: prevention (H2) is achievable
          ONLY if the projection supplies genuine lead (H1) ⟹ H1 is NECESSARY
          for H2",
  sharp: "a projection firing ≤1 tick ahead has L(σ) ≈ L_Exc and cannot
          satisfy the antecedent. ∄ theorem rescues nowcasting",
}

// ─── RELATION TO THE PAPER ────────────────────────────────────────────────

paper_relation = {
  contribution: "AC §2.5 proves the Markov projection EXISTS — Perron-Frobenius
                 stationary π, spectral gap. This adds the prescriptive half:
                 a viable-drift pre-grant cannot RAISE, and under (†) provably
                 LOWERS, the excursion probability ⟹ the governor turns a
                 projection into control",
  reuse: "∄ new machinery. Strassen coupling (monotonicity) ⊕ Foster-Lyapunov
          supermartingale (drift) — the exact convexity-free toolkit of the
          Fierro addendum, used prescriptively",
  gate: "the CONDITIONAL theorems are unconditionally true and may be stated
         NOW. The EMPIRICAL claim — that the deployed S3 pre-grant satisfies
         domination ∧ (†) and realises the gap on the live system — is
         validated by EXP-S4-01_full (H1 ∧ H2). Until that confirms, this is
         internal theory, ¬a paper claim",
  // debt(AC-25-CONTINUATION, class=doc, owner=rmw3, gate=EXP-S4-01)
  // The AC §2.5 prescriptive continuation is written ONLY when EXP-S4-01_full
  // confirms H1 ∧ H2. The THEOREMS here are unconditionally true and may be
  // stated now; the claim that the DEPLOYED pre-grant realises them may ¬be.
  // Declared so the gate is a debt with an owner, ¬a sentence in a comment
  // that a future writer reads as permission.
  gate_state: "CLOSED as of 2026-08-08 — s4_anticipation carries H1∧H2∧H3∧H4
               as PENDING, and the +0.9 A is credited ONLY on H2. The AC §2.5
               continuation stays unwritten. EXP-MODES-01 discipline",
  // Verified against the fused s4_anticipation, ¬assumed. A gate whose state
  // is asserted rather than read is how a claim gets written early.
}

