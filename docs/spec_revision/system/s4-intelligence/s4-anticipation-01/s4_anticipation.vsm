// ─── 1. CONSTITUTIONAL CORE — the S4 path from DESCRIPTIVE to PRESCRIPTIVE ───

s4_core = {
  thesis: "Perron-Frobenius projection (AC §2.5) now DESCRIPTIVE — predicts
           excursions. This spec makes it
             PRESCRIPTIVE — projection drives pre-emptive
             S3
           allocation, provably reducing excursion probability
             BEFORE stasis_cos drops.
           Prediction → prevention. That closure = the +0.9 A-jump (S4 models the future,
           ¬S3* reacting to the present — Beer's actual S4). Closes ITEM_17.2 (Brecha 2,
           S4 +0.9 A).",

  canon_basis: {
    Beer:         "S4 models future of system-in-environment. ¬future model acted upon ⟹ S4 =
                     glorified S3*. Anticipatory allocation =
                     full form.",
    von_Foerster: "Projection over EXTERNAL channel (ERA5, ONI) — Shannon, independent
                   environment — epistemically honest, NOT
                     observer self-reference.",
    Fierro:       "Prevention claim reuses addendum's CONVEXITY-FREE Foster-Lyapunov drift
                   argument. Same machinery that proves convergence (existence + contraction)
                   proves drift-increasing pre-grant lowers hitting
                     probability of the
                   excursion set.",
  },

  formal_setup: "Per zone z, stasis_cos c_z(t) ∈ [-1,1] binned into K Markov states {σ1..σK};
               σK = most viable; E = {σi : c < θ_viable} = excursion set. P (K×K
               row-stochastic) estimated from ERA5 1991-2020 (markov_train.py). AC §2.5: P
               irreducible + aperiodic ⟹ unique
                 stationary π and spectral gap
                 1−|λ_2|.",

  projection_descriptive: {
    // what markov_project.py already computes
      (the historical/descriptive side)
    q_n:          "excursion probability within n ticks: q_n(σ) = P(c hits E within n ticks |
                   σ(t)=σ) = 1 − (P_¬E^n · 1)_σ where P_¬E = P with the E-complement absorbing.
                // ¬E, ¬E-with-circumflex: the alphabet
                  declares that mark as
                // ESTIMATE (see vsl_language §alphabet). Reusing it for set
                // complement gave one mark
                  two meanings; ¬ is already declared
                // and reads correctly here.
                  Naming the character instead of
                // writing it keeps this
                  comment from tripping its own
                  gate.",
    lead_time:    "τ_θ(σ) = min{ n : q_n(σ) ≥ θ_alert }. Directive fires when τ_θ finite,
                   ≤ horizon H, sustained ≥ DIRECTIVE_THRESHOLD ticks.",
  },

  prescription: {
    // the NEW claim: projection
      → prevention via staggered allocation
    pre_alloc:    "Anticipatory margin Δ granted to
                    zone z biases local transition kernel
                   toward the viable direction: P
                     → P_Δ, P_Δ stochastically dominates P in the
                   viable order (more mass toward σK).",
    theorem:      "Let V(σ_i)=K−i (decreasing Lyapunov fn
                    toward viability). If Δ satisfies the
                   DRIFT CONDITION — under P_Δ, E[V(σ_{t+1})|σ_t] − V(σ_t) ≤ −ε for σ∉σK (strict
                   negative drift toward the viable core) — then the anticipated excursion
                   probability is strictly reduced: q_n^Δ(σ) ≤ q_n(σ) − g(ε,n), g>0. Foster-Lyapunov,
                   convexity-free, = Fierro addendum machinery.",
    proof_ref:    "FULL PROOF: @src_anticip_prevent
                   (Theorem 1 monotone prevention · parameter-free coupling; Theorem 2 quantitative
                   super-harmonic bound q_n^Δ ≤ V(σ)/V_E; lead-time corollary — H1 is NECESSARY
                   for H2, proven).",
    falsifiable:  "Under matched ERA5 forcing: anticipation-ON
                    produces strictly fewer/shallower
                   excursions than anticipation-OFF. If not: either no lead (H1 fails) or Δ is
                   weaker than the drift bound requires (H2 fails). Both are diagnosable, neither
                   is a paper claim.",
  },

  prerequisite: {
    name: "PHI-UP-PIPELINE (HARD prereq)",
    why: "Loop CANNOT close until kernel
                    actually receives clima state + the projection.
          EXP-S4-01-STRESS (2026-07-01) confirmed pipeline broken at 3 levels:",
    broken_at: [
      "(a) coupling manifests never deployed to DNE → 0 manifests loaded / seen by the kernel",
      "(b) Rust kernel subscribes to φ↓ + S5 subjects but NOT vsf.clima.*",
      "(c) s4_*_bridge.py writes the bundle/projection to disk but the kernel never reads it",
    ],
    // debt(PHI-UP-PIPELINE, class=kernel, owner=DS, gate=system_certified)
    // The kernel does not read vsf.clima.<zone>.phi_up nor
    // s4_markov_projection.json. Until it does, S3 has NOTHING to pre-grant
    // on: the whole anticipatory arc is built, tested, and disconnected.
    // This is the root blocker — the other S4 debts sit behind it.
    gate: "ITEM-17.2 wiring BLOCKED on PHI-UP-PIPELINE.
                    S3 has nothing to pre-grant
                    on until the
           kernel reads vsf.clima.<zone>.phi_up AND s4_markov_projection.json.
             Fix the pipeline FIRST.",
    update_2026_10_13: "RE-VERDICT (live evidence, vos-kernel audit — the
      three break levels as written above no longer describe reality:
      (a) manifests PRESENT at /etc/vsf/coupling/ (5 files) AND loaded by
      the running kernel with 0 rejections (journal Oct 10 boot:
      5 manifests, 24 sensors, 0 rejections); (b) kernel never subscribed
      vsf.clima.* because the design EVOLVED to file-bundle delivery
      (s4_clima_bundle.json fresh daily, read by clima_bundle_reader.rs;
      60s+ latency accepted trade-off) — not broken, redesigned, with the
      directive subscriber ready on vsf.<id>.s4.anticipatory_directive;
      (c) bridge writes FLOWING (s4_markov_projection + l2 + clima/econ
      bundles all fresh same-day). Kernel read path (refresh_stasis_cos,
      fail-closed) present in the Oct-10 binary and executes ONLY on
      directive receipt — zero directives in 7d journal = healthy regime
      (stasis ~0.994), not evidence of breakage. REMAINING, honestly:
      end-to-end proof needs a directive (synthetic or real excursion) =
      EXP-S4-01_full sandbox harness (pre-registered, gated, never prod
      poking); go-live flip stays D-GOLIVE-ANTICIPATION-01 (S5).",
  },
}

// ─── 1°. PRE-REGISTERED EXPERIMENT — EXP-S4-01_full (spec.vsm §hypotheses/outcomes/experiment) ───
// Frozen params carried VERBATIM
  from source (spec.vsm §frozen, 2026-07-14).
  Do NOT recalibrate
// without an experiment. This
  is the validation gate for
  the prescription (§1): H2 is load-bearing.
experiment: {
  hypotheses: {
    H1_lead:       "the projection has genuine LEAD:
                    median τ_θ ≥ N_min ticks
                    before c crosses θ_viable.
                    FALSIFIED if directives fire ≤ 1 tick ahead (nowcasting, not forecasting).",
    H2_prevention: "LOAD-BEARING: under matched forcing, anticipation-ON
                    excursion count < OFF control
                    (pre-registered effect size / p < 0.05). The claim that earns the +0.9 A.",
    H3_precision:  "no pre-grant STORM: false-grant rate
                    in calm (non-excursion) regimes < ρ. FALSIFIED
                    if S3 pre-grants spuriously (DIRECTIVE_THRESHOLD too loose).",
    H4_honesty:    "when regime_lambda exceeds the training-regime
                    band (ERA5 out-of-distribution), the
                    system flags projection_invalid and does NOT act on a stale Markov (= 17.4).",
  },

  outcomes: {   // pre-registered map — no post-hoc reinterpretation
    H1∧H2∧H3_confirmed: "Anticipation EARNED (+0.9 A); AC §2.5 prescriptive continuation + the
                    negative-control figure. Defensible live-control result.",
    H1_fails:  "projector lead-time bug — projection
                    is nowcasting. Fix projector, re-run.
                    No paper claim.",
    H2_fails:  "lead OK but no prevention
                    → control coupling (Δ or
                    envelope) too weak. Design revision,
                    NOT a paper claim.",
    H3_fails:  "recalibrate DIRECTIVE_THRESHOLD; precision gate before
                    any autonomy.",
    H4_fails:  "projection acted out-of-distribution — 17.4
                    (regime guard) MANDATORY before 17.2
                    ships.",
  },

  design: "TWO matched runs, identical forcing.
                    Forcing = ERA5-replay of a
                    known multi-zone excursion
           episode OR synthetic multi-zone excursion
             generated by the SAME ERA5-fitted Markov
           (monte_carlo double-use, valid because fitted to real data).",
  arms: { arm_A: "anticipation ON — S3 consumes directive, pre-grants within envelope.",
          arm_B: "control OFF — S3 reacts
            only AFTER c drops (current
            reactive behavior)." },
  protocol: "PAIRED design to kill forcing
                    variance: generate K excursion episodes from the
             ERA5-Markov, each with a fixed seed; run EACH seed through BOTH arms (same seed → same
             forcing path). K ≥ 30 seeded episodes. Arms differ ONLY in whether S3 acts on the
             anticipatory directive. Randomise arm order
               per seed to avoid drift.",

  telemetry_required: [   // REQUIREMENT ON THE CONSUMER — else H1/H2 are unmeasurable
    "s3_pre_grant { ts, zone, delta, envelope_slack_before/after, directive_id } — each grant",
    "the directive carrying { ts_fired, zone, tau_theta (predicted lead ticks), q_n } — lead =
         ts_cross(θ) − ts_fired measurable (H1)",
    "per-tick stasis_cos per zone (already in clima φ↑) — excursion count/depth/area (H2)",
  ],
  metrics: "excursion count · max depth
                    (min cos) · integrated excursion
                    area (∫ max(0,θ−cos) dt) ·
            recovery time · pre-grant precision/recall · lead-time distribution (H1).",
  analysis: "H2 (primary): paired one-sided test
                    on excursion count A vs
                    B across the K seeds
             (Wilcoxon signed-rank; pre-registered α=0.05, one-sided A<B). Report effect size
             (median paired reduction) + CI, not just p. H1: median lead > N_min ticks (N_min from the
             theorem's corollary). H3: false-grant rate in the non-excursion seeds < ρ. The theorem
             makes H1 NECESSARY for H2 — a null H2 with
               failed H1 is a projector-lead
               defect, not a
             control-coupling defect.",
  primary: "H2: arm_A excursion count strictly
                    < arm_B, paired, pre-registered.",
  gate:    "SANDBOX/clima-testbed only. No production autonomy
                    until H1∧H2∧H3∧H4 pass.",

  frozen: {   // FROZEN 2026-07-14 — no parameter guessed, no post-hoc adjustment
    provenance:   "deployed per-zone Markov models (/var/lib/vsf-clima/markov/{zone}.json,
                    ERA5
                   1991-2020) + the live projection rule. The forcing IS the fitted model.",
    state_bins:   "5 percentile bins per zone
                    (verified antofagasta): 5=OPTIMAL[.887,1.01]
                   4=HEALTHY[.774,.887] 3=DRIFTING[.575,.774] 2=EXCURSION[.246,.575] 1=SEVERE[-1.01,.246]
                   (per-zone edges).",
    excursion_set_E: "bins {1,2} (stasis_cos below the
                    DRIFTING floor). Viable core =
                    bins {4,5}.",
    tick:         "1 tick = 1 day
                    (ERA5/climate timescale). The pre-grant is
                    held over the climate
                   horizon.",
    forcing:      "K=30 SEEDED episodes. Each =
                    a multi-zone trajectory sampled from the per-zone
                   fitted Markov T over a
                     30-tick horizon. SAME seed →
                     identical trajectory in BOTH
                   arms (paired). An episode 'counts' as an excursion episode if ≥ 1 zone enters E.",
    directive_rule: "IDENTICAL to production: fires when p_excursion(7) ≥ P7_AT_RISK (0.15) sustained
                   for SUSTAIN_ALERTS consecutive ticks; multi_zone_alert when ≥ 3 zones.",
    H1_lead_bar:  "PASS iff (a) median lead ≥ 1 tick AND (b)
                    the directive fires while current_bin
                    ≥ 3
                   (DRIFTING or healthier) in ≥ 80% of episodes — it PRECEDES entry to E. FALSIFIED if
                   directives fire at current_bin ≤ 2 (nowcasting). [Theorem corollary: the grant must
                   fire while V(σ) < θ_alert·V_E → bin ≥ 3.]",
    H2_test:      "PRIMARY. Paired Wilcoxon signed-rank, ONE-SIDED (A<B), α=0.05, on the
                   excursion-tick-count (#ticks a zone spends in E, summed over zones) per seed, arm_A
                   vs arm_B across the 30
                     seeds. PASS iff A<B and
                     p<0.05. REPORT the median paired
                   reduction + 95% CI (effect size), not p alone.",
    H3_precision: "false-grant rate on the NON-excursion
                    seeds (never enter E) <
                    0.10.",
    H4_regime:    "inject 1 out-of-training-band episode (regime_lambda
                    beyond ERA5 range); PASS iff the
                   consumer logs projection_invalid and does NOT reallocate.",
    analysis_frozen: "@exp_s4_01_analysis — reads s3_pre_grant + per-zone bin telemetry
                   from both arms, computes the
                     metrics + the Wilcoxon test,
                     emits the verdict per
                   outcomes{}. WRITTEN BEFORE THE RUN. The verdict is mechanical.",
  },

  paper: "AC §2.5 continuation — 'From
                    projection to prevention: prescriptive Perron-Frobenius
          control'. WRITTEN ONLY IF EXP-S4-01_full confirms H1∧H2 (gated exactly like EXP-MODES-01).
          No pre-claiming. The prevention CLAIM
            is validated on the live
            system, not asserted from
          the forecast.",
  execution: {
    "[O] Claude": "spec (done) · formal prevention-theorem statement for the paper · gated AC §2.5
                   draft · outcome interpretation",
    "[S] DS":     "PHI-UP-PIPELINE fix (prereq) · Rust S3 consumer + loop_gate + safety_invariant ·
                   regime_lambda in projector (H4) · EXP-S4-01_full two-arm harness · run · results.vsm",
  },
  done_when: "S3 observably pre-grants on a
                    Markov directive within envelope (s3_pre_grant in φ↑);
              EXP-S4-01_full run with matched forcing; outcome mapped per outcomes{} — NO post-hoc
