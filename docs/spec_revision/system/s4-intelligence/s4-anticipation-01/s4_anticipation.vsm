// ─── 2. THE CONSUMER + REALLOCATION DESIGN (Component A + two-part actuation) ───
// The kernel (LXC 101) DECIDES; a host-level actuator (LXC 0 / n02 host) EXECUTES. Why:
// namespace isolation — a
  kernel in LXC 101 cannot
  reach LXC 112's cgroup hierarchy.
// Design reviewed by Claude A5 (2026-07-14) — verdict APPROVED + refinements R1-R5.

consumer: {
  directive_in: {
    choice:    "NATS vsf.alpha.s4.anticipatory_directive — subscribed via
                    the vsf_agent::nats::connect
                 token-auth path (async-nats v0.49.1 ignores URL auth)",
    rationale: [
      "the kernel already subscribes to 5+ subjects (s5-covenant, s5-caution, s5-approval,
       phi_down) — adding one is a 5-line extension",
      "NATS is real-time (no file-polling latency). The anticipatory directive LEAKS value with
       delay — the point is
         to act BEFORE the excursion",
      "The bundle path (clima_bundle_reader.rs) adds 60s+ latency (written once per tick): enough
       for H1 (lead) but misses H2 (prevention) because it is too coarse",
    ],
  },

  zone_cgroup_map: {
    verified:  "LXC 112, 2026-07-14: cgroup v2,
                    CPU controller active. cpu.weight=100 default.
                systemd-cgls shows the service tree.",
    hierarchy: "system.slice/ system-α-l2.slice/ vsf-clima-l2@<zone>.service (8 zones:
                mediterranea · subpolar · semiarida · templada-humeda · tropical-arida ·
                  humboldt ·
                pacifico-sur-medio · enso-tropical) + system-α-l3.slice/ vsf-clima-l3@<node>
                (87 nodes, not rate-limited).",
    granularity:"Reallocation is at L2-zone granularity
                    (the Markov projection's unit), cascading
                to child L3 units. NOT
                  LXC-level: reallocation between S1 LXCs would require
                host-level cgroup writes — out
                  of scope for v1.",
  },

  actuation: {
    constraint: "The Rust kernel (LXC 101)
                    CANNOT directly write LXC 112's cgroups (kernel
                 namespace isolation). pct exec runs on the host (n02), not inside any LXC.",
    two_components: {
      component_A: {  // DECISION — LXC 101, kernel
        where:  "LXC 101 — existing s3_alloc / new anticipation module",
        what:   "subscribe NATS directive → donor
          selection → emit s3_pre_grant to core →
                 write a reallocation order to
                   the shared dir → trigger
                   host timer",
        safety: "envelope check (Σ shares =
          const) BEFORE writing the order;
          if no donor can
                 spare / donor would fall
                   below floor → write NO
                   order, escalate to
                 algedonic_ledger via the s5-algedonic path (double-loop)",
      },
      component_B: {  // EXECUTION — n02 host
        where:   "n02 host — new systemd
          timer vsf-cgroup-reallocate (analogous to
                  vsf-topology-reconcile.timer)",
        trigger: "poll /var/lib/vsf-state/reallocate/pending.json (shared dir bind-mounted into
                  LXC101 at /var/lib/vsf/reallocate)",
        action:  "read {zone, donor, delta_cpu_weight, directive_id, ts}. Execute:
                  pct exec 112 -- systemctl
                    set-property vsf-clima-l2@<zone>.service
                  CPUWeight=<current+delta> AND the donor unit CPUWeight=<current-delta>.
                  Verify via cgroup readback. Log
                    to done/<id>.json + syslog.",
        safety:  "read the order ONCE. On
          failure it does NOT retry
          — writes failure to done/
                  for audit; the kernel re-evaluates
                    next tick. Prevents reallocation storms.",
      },
    },
    bind_mount: {
      host_path:      "/var/lib/vsf-state/reallocate/",
      container:      "101",
      container_path: "/var/lib/vsf/reallocate",
      pct_config:     "pct set 101 --mp0 /var/lib/vsf-state/reallocate:mp=/var/lib/vsf/reallocate",
                    },
    fallback: "For EXP-S4-01_full (sandbox) the reallocation
                    is SYNTHETIC — simulate the cgroup
               write in the kernel (log only). The harness verifies the s3_pre_grant event, not the
               physical cgroup effect.",
  },

  envelope: {
    location: "New Rust module s3_anticipation.rs in
                    the nucleus src/ tree.",
    struct:   "AnticipationState { zone_shares: HashMap<ZoneId, CpuWeight>; directive:
                Option<AnticipatoryDirective>; envelope_sum_last: u64; basin_floor: HashMap<ZoneId,
                CpuWeight>; }",
    init:     "At boot: synthetic defaults (100
                    per zone, 8 zones =
                    800 total). EXP-S4-01_full:
                harness injects synthetic shares; production:
                  reallocator seed reads live cpu.weight
                from LXC 112 on first run.",
    donor_rule: { algorithm:
      "for directive(d): 1) target=directive.zone; 2) for each zone z ≠ target compute
       slack_z = zone_shares[z] − basin_floor[z]; 3) sort by slack_z descending; 4) pick first
       z with slack_z ≥ directive.delta; 5) if none → double_loop (escalate to pending_human);
       6) zone_shares[target] += delta · 7) zone_shares[donor] −= delta; 8) assert Σ unchanged;
       9) emit s3_pre_grant → φ↑ + write reallocation order.",
      basin_floor: "per-zone min CPU share from
        calibration.rs. Sandbox floor = 50 (half default);
                    PRODUCTION floor = donor real stasis_cos ≥ 0.875 — see §5 R2."
    },
    telemetry: "s3_pre_grant { ts, target_zone, donor_zone, delta_share, envelope_sum_before,
                envelope_sum_after (must be equal), target_margin_before, target_margin_after,
                directive_id } — required by the EXP-S4-01_full harness. Escalation events to
                algedonic_ledger on double-loop.",
  },

  safety_invariant: "Σ cpu_shares = CONST (800), checked before ANY grant. The kernel NEVER writes
               an order that would change
                 the sum. The host reallocator
                 re-verifies the sum before
               applying. Compiler-level type safety: the
                 donor deduction and target addition are in
               the same borrow-checked atomic update.
                 D4 loop gate: if donor slack ≥ delta →
               SINGLE-loop (autonomous); if NOT → DOUBLE-loop (pending_human via algedonic).",

  regime_guard_17_4: "If the directive carries regime_lambda
                    out-of-training-band, the consumer:
               flags projection_invalid, does NOT reallocate,
                 logs to φ↑ with status=
               projection_invalid. H4 enforced BEFORE H1/H2 are credited.",

  design_review_claude_2026_07_14: {
    verdict: "APPROVED (DS surface, Claude hardens).
                    Two-component design correct; zero-sum
              reallocation makes the A5 safety_invariant AUTOMATIC. Refinements:",
    R1_validating_executor: "host reallocator is a VALIDATING
                    executor, not a trusting one
                    —
                              independently re-checks (i) Σ unchanged, (ii) donor post-transfer ≥ its
                              floor, (iii) freshness (ts window, directive_id not already applied) —
                              BEFORE applying. Reject+log otherwise. A
                                privileged host actuator never
                              blindly executes a file the
                                kernel wrote.",
    R2_production_floor: "sandbox = cpu.weight 50 PROXY;
                    PRODUCTION donor-guard = real stasis_cos
                    ≥
                              0.875 (calibration.rs) read from the live φ↑ — flagged as the
                              production-hardening gate and later built (see §5 gap_1).",
    R3_runtime_property: "use systemctl set-property --runtime (TRANSIENT; never persistent) — a
                              reallocation that changes every tick
                                must not accumulate config drift
                                /
                              stale artifacts (the classic trap this project keeps hitting).",
    R4_declare_actuator: "vsf-cgroup-reallocate is a NEW privileged
                    host actuator — DECLARE in
                              state.db (services) + the coupling registry (it writes cgroups = real
                              coupling). model≡reality. Joins the host S3* timers.",
    build_gate: "build+test on dev-sandbox (LXC108) first,
                    synthetic path; show Claude the diff of
                              the zero-sum invariant plus the
                                R1 validating executor BEFORE the
                                101
                              deploy. EXP-S4-01_full runs synthetic →
                                validates the DECISION logic
                              (H1/H2), not the physical cgroup effect.",
  },
}

// ─── 3. OMEGA-MARGIN GROUNDING — the hardware envelope that shapes the design ───
omega_margin: {
  finding: "OMEGA-MARGIN (deployed 2026-07-14) proves calibration.rs
                    L55-60: the BINDING constraint
           is A3_cpu (cgroup_headroom), g=0.102 — the CPU feasibility margin IS the practical limit
           of the 2-core i7-7600U, and live cgroup_headroom≈0 (danger face).",
  consequence: "The system runs at ~0
                    CPU headroom → S3 has
                    NO FREE CPU to grant → a NET
               anticipatory pre-grant is IMPOSSIBLE on
                 this host. This is not
                 a bug; it is the
               hardware ceiling the ollama saga
                 exposed.",
  design_decision: "Pre-grant = REALLOCATION (zero-sum within
                    the fixed CPU envelope), the ONLY
               action available: Σ(cpu shares over zones) = CONST; on a directive for zone Z S3
               transfers cpu.weight FROM the slackest zone (still ≥ its floor) TO Z. Correct
               because: (a) only action available; (b) Σ net = 0 makes the safety invariant
               automatic (cannot exceed the envelope); (c) matches the prevention theorem (shifting
               share toward Z biases P → P_Δ), i.e. the drift condition of Theorem 2 → the donor
               must stay above its own
                 viable floor — do not
                 rob a zone into excursion to save
               another.",
}

// ─── 4. COMPONENT B — HOST REALLOCATOR (the independent validating executor) ───
// Claude spec 2026-07-26 —
  design DONE; build gated: build+test
  in isolation only, no live wiring.
component_b: {
  identity: {
    system_id: "vsf-cgroup-reallocate", kind: "bare_process (host-level, coupling
                    manifest enum)",
    vantage:   "lxc:0 (host pseudo-node) — a
                    NEW privileged actuator, joins the
                    host S3* timers",
    privilege: "root on plaintext (host) —
                    the only tier that can
                    see every LXC's cgroup path from
                outside without a privileged in-guest
                  helper",
  },

  transport: {
    pattern: "inverse of the events.jsonl bind-mount:
                    LXC101 write + host read",
    host_dir: "/var/lib/vsf-anticipation/orders/ on n02 host (bind-mounted RW into 101
               at /mnt/anticipation-orders; host already reads its own fs)",
    order_lifecycle: "kernel writes <directive_id>.json → orders/pending/.
                    Component B picks up,
               validates, applies/rejects, moves to orders/done/<id>.json with appended
               {status: applied|rejected, reason, applied_at} — or orders/rejected/<id>.json when
               independent validation fails. NEVER delete an order (append-only discipline)",
    cadence: "polling systemd-timer ~30-60s (matches S4_CYCLE_INTERVAL order-of-magnitude — the
              kernel emits at most one order per anticipation cycle)",
  },

  order_format: {
    fields: "directive_id (string — the freshness/dedup
                    key), ts (RFC3339, when the
                    kernel decided),
             donor_zone, target_zone, delta (int, cpu.weight units), kernel_claimed_donor_stasis_cos
             (float — what the kernel THINKS the donor's viability was), kernel_claimed_sum_after
             (int — what the kernel computes the sum to be post-grant; always 800/ENVELOPE_SUM)",
    note: "The claimed fields are NOT
                    trusted — they exist so
                    a MISMATCH between claimed and
           re-derived is itself detectable + loggable (a kernel bug shows as claimed != re-derived,
           a stronger signal than either value alone).",
  },

  validation_R1: {
    principle: "never blindly apply an order:
                    re-derive EVs checks from SOURCES
                    INDEPENDENT of the
                order file's own claims —
                  verify the order is consistent
                  with REALITY, not
                self-consistent.",
    check_1_sum_unchanged: "read current cpu.weight of every
                    known zone unit directly from the
                host's cgroup view, sum them; confirm applying Δ keeps the sum at ENVELOPE_SUM(800);
                if the LIVE sum already ≠ 800 → REJECT (do not apply on top of a bad baseline)",
    check_2_donor_floor: "read the donor's CURRENT stasis_cos
                    independently (the same source the
                kernel would use: s4_markov_projection.json on host) and confirm
                donor_stasis_cos − implied_impact ≥ BASIN_FLOOR (0.875); if the projection file is
                stale (mtime > 2× the normal refresh cadence) REJECT — a validation against stale
                reality is not a validation",
    check_3_freshness: "directive_id must not already exist
                    in orders/done/ or orders/rejected/
                (replay protection); ts must be within a bounded window of now (120s — reject an
                order that sat unprocessed too long, the world may have changed)",
    on_any_failure: "REJECT → write to orders/rejected/
                    with the reason → emit a typed φ↑ event …
                escalate to algedonic_ledger status=pending_human if
                  this is the SECOND consecutive
                rejection for the same donor/target pair within N minutes (single rejections are
                healthy — they show the
                  validation working; a PATTERN of
                  rejections is a structural
                problem a human should see)",
  },

  actuation_transient: "systemctl set-property --runtime (never a
                    persistent drop-in) — a transient
                resets to the unit's file
                  default on restart, correct for a reallocation that
                changes frequently (R3). Two calls: donor −Δ, target +Δ. If the SECOND fails after
                the first succeeded, detect on the NEXT cycle (check_1 sum would catch a
                mid-transfer inconsistency) and self-heal by reverting the first — never leave
                half-applied state silent.",

  declaration: "new coupling manifest @coupling_reallocate,
                identity.kind=bare_process, vantage=lxc:0, channels.auth={mechanism:none} (no NATS —
                reads a local bind-mount, writes
                  cgroups locally: smaller attack surface by
                construction). Declare in state.db services — an actuator this privileged must never
                be an undeclared orphan.",

  tests_required: [
    "stale directive_id replayed → rejected, not re-applied",
    "order ts older than the freshness window → rejected",
    "independently-read Σ != 800 BEFORE applying → rejected",
    "donor independently-read stasis_cos < 0.875 → rejected even though the order's own claimed
         field says fine — THE
           test that proves R1",
    "malformed/corrupted order file → rejected, does not crash the reallocator, does not block
         subsequent valid orders",
    "second set-property fails after the first succeeded → self-heal by reverting the first on the
         next cycle",
  ],

  boundary: "Design + BUILD + TEST
                    in isolation (synthetic order files)
                    only. No live wiring of
                    A→B,
             no production cgroup writes — both gated behind the SAME rmw3 (S5) sign-off as
             go_live_runbook §5 (this component raises the bar higher: a decision becomes a
             physical effect here).",
}

// ─── 5. PRODUCTION HARDENING GATE — 5 items, all now DONE (shadow mode), 2026-07-26 ───
// Checked STRATEGIC_PROJECTION_2026-07-16 §stability-as-method against
  the real code — 3 of 5
// genuinely missing at first.
  All 3 closed + verified
  live on dev-108. Shadow→live is NOT
// authorized by this gate
  (separate rmw3 decision; §6 runbook).
hardening_gate: {
  items: {
    item_1_negative_control: "DONE — H4 guard (regime_lambda out-of-band → projection_invalid,
                verified by stress test)",
    item_2_viability_floor:  "DONE (was MISSING) — gap_1",
    item_3_shadow_first:     "DONE — runs SYNTHETIC: logs 'SYNTHETIC' on every grant",
    item_4_reversibility:    "DONE (was MISSING) — gap_2",
    item_5_audit_and_ack:    "DONE — human ACK (double-loop pending_human in algedonic_ledger) +
                S3* audit (gap_3)",
  },

  gap_1_viability_floor: {
    what: "donor gating was BASIN_FLOOR_SANDBOX=50, a
                    cpu.weight PROXY. R2 explicitly required the
             PRODUCTION donor-guard = the donor's REAL stasis_cos ≥ BASIN_FLOOR (0.875, calibration.rs)
             from the live projection data
               — built tonight: select_donor applies the real
             stasis_cos ≥ 0.875 filter.",
    tests: "adversarial: (i) an unhealthy donor
                    (sc < 0.875) with plenty
                    of slack is NEVER selected;
             (ii) when all candidates are unhealthy → prefers double-loop escalation, never a silent
             grant. Weight-based floor passing does
               not suffice once the real
               floor is wired in.",
  },

  gap_2_reversibility: {
    source: "Pollutes roadmap 'any viability drop
                    reverts the action' — a drop AFTER a
             grant must UNDO it. NOT the INV-SUM rollback (internal accounting); this is a
             harm-triggered monitor.",
    pattern: "s3_resource_alloc.py (live since 2026-06-29) hysteresis
                    shape reused: N consecutive
             ticks past a threshold before
               acting. Uses ViabilityTracker with HYSTERESIS_TICKS=5
             window. Inverted condition: donor or
               target below floor for a
               full hysteresis window
             post-grant → REVERT (weights restored to pre-grant).",
    tests: "grant → N consecutive degraded
                    ticks → weights revert exactly
                    + reversal event emitted;
             also the NEGATIVE case: fewer
               than N ticks or an
               early recovery does NOT trigger a
             revert (same false-positive discipline as the window exists to prevent)",
  },

  gap_3_audit_wiring: {
    source: "grep for s3_pre_grant across s3-star:
                    zero hits — S3* has
                    no awareness of this
             channel. per R13/A5 and all S3* (audit must be independent, DO NOT log the kernel's
             own claim as true).",
    impl:   "New anticipation_probe in s3-star (same
                    shape as host_probe/broker_probe): reads
             s3_pre_grant from the shared event stream: (i) re-verifies Σ(weights)==800 from the
             event stream; (ii) re-verifies no zone in the emitted state is below its claimed
             floor; (iii) flags discontinuities between a grant and the PRIOR grant for the same
             zone. Tested by feeding a deliberately-corrupted event (Σ != 800) → probe raises a
             Finding (single same-session pattern for every S3* channel, BBS retired).",
  },

  runbook_ref: "fetch the runbook → go_live_runbook
                    §2 preflight gate. This gate
                    is the evidence
             the hardening is real; it
               is NOT the authority to
               flip.",
}

// ─── 6. NUCLEUS REAL-DATA WIRING — close a genuine gap found 2026-07-27 ───
// The kernel's viability floor
  was never populated with real
  data (set_zone_stasis_cos() called
// ONLY, in tests). Without
  this fix, production donor selection
  falls back permanently to
// ALLOW — the fail-OPEN
  class of bug from bbh_policy_gate.py.
  Fix: fail-CLOSED + real feeding.
realdata_wiring: {
  finding: "grep s3_anticipation.rs: set_zone_stasis_cos() called ONLY
                    from #[test] fns (≈lines
            1290-1349); never from the directive subscriber or any production path. select_donor's
            fallback when floor-metrics-data is absent
              is 'allow' — meant for
              tolerable async lag,
            but permanent in production →
              viability floor certified against unit
              tests, not against
            anything that runs LIVE. Same
              bug shape as bbh_policy_gate.py's 'unparsed
              → fail-open'.",

  nucleus_projection_contract: {
    format: "{ ts: RFC3339, zones: [
                    {name: <one of the 8
                    L2 zone names>, current_sc: float},
                    ... ] }",
    path:   "/var/lib/vsf/vsf_nucleus/s4_markov_projection.json on LXC101 (the SAME path both
             components already reference — no new path introduced). Whatever produces it for real
             (a clima-side L2 aggregator, deferred) must write EXACTLY this shape.",
    not_this: "Component B's read_projection_stasis_cos() code does
                    NOT need to change — it already
             reads this contract. What changes
               is Component A: it never
               read the file for real.",
  },

  fail_closed_correction: {
    where: "select_donor (~line 221-223): when self.stasis_cos
                    maps misses a zone, the filter
             falls through true ('graceful degradation — data may arrive asynchronously'). In
             production today NOTHING populates the
               map → permanent fall-through = permanent
             permission.",
    fix:   "In production mode (!self.synthetic): a
                    zone with NO stasis_cos entry
                    — OR a STALE one
             past a freshness threshold —
               must be EXCLUDED from donor
               selection, not allowed.
             Missing/stale safety data must never read as permission (same bug class as the
             prohibited_methods_status unparsed → fail-closed — cite that fix in the commit).",
    caveat: "The FIRST grant after a
                    restart/outage will more often do
                    nothing (no donors) →
             D4 double-loop escalation — the
               CORRECT conservative default. Temporary inability to
             grant << silent permanent bypass
               of the floor.",
  },

  component_a_changes: {
    new_function: "refresh_stasis_cos(&mut self, projection_path: &str) → Result<(), String>:
             read the contract file, parse,
               set zone stasis_cos for each recognized L2 zone;
             unknown zone names are ignored (debug log), not an error.",
    freshness:   "track the file mtime (or
                    its ts) — STALE threshold
                    should MATCH Component B's
             own STALE_PROJECTION_SECS (600s) — a deliberate shared constant, not a coincidence.
             A stale read is a
               form of ABSENCE, not presence:
               treat every zone as unpopulated.",
    call_site:   "call refresh_stasis_cos ONCE per loop
                    iteration (before handle_directive), at the
              same cadence as the directive poll (or cheaper — reasoning note recorded).",
    error_handling: "read/parse failure must NOT crash
                    the subscriber loop: log the
                    error, treat
              as no-fresh-data-this-cycle (same fail-closed), keep going. The kernel staying up
              matters more than any single
                cycle's freshness.",
  },

  order_emission: {
    what: "after the existing emit_grant_event, ALSO
                    write an order file to
                    the bind-mount dir in
             EXACTLY the order_format of Component B (directive_id, ts, donor, target, delta,
             kernel_claimed_donor_stasis_cos, kernel_claimed_sum_after).",
    when: "EMIT IN BOTH SYNTHETIC AND
                    PRODUCTION mode — this makes
                    true shadow-first possible:
             Component B in --dry-run against
               REAL orders from synthetic Component A proves the
             pipeline end to end with
               zero actuation risk. Add kernel_mode:
               synthetic|production to
             the order (small addition — confirm Component B's Order class ignores the extra field
             gracefully, not an error).",
    path: "same bind-mount dir as Component
                    B: host /var/lib/vsf-anticipation/orders/, LXC side
             via the NEW rw bind-mount (does not exist yet — deployment_prep below).",
  },

  deployment_prep: {
    bind_mount: "pct set 101 --mpN /var/lib/vsf-anticipation/orders,mp=/mnt/anticipation-orders,ro=0
             (rw — Component A WRITES there). REAL infra change — flag for explicit confirmation
             before applying. mkdir -p the orders/{pending,done,rejected} dirs on the host first;
             check 101's unprivileged UID range
               can write into them.",
    still_not_authorized: "With this, still NO component
