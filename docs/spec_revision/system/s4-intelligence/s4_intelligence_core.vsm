@vsm 1.2.1
@status active

// S4 — INTELLIGENCE SUBSYSTEM (VSM)
// Status: active core description

role = "The S4 subsystem handles the system's lookahead, environmental
    monitoring, and second-order learning. It is the 'intelligence' organ
    that observes both the external environment (papers, tools) and the
    internal state (RSI patterns, drift)."

core_components = {
  socratic_engine: "Recursive evaluation of actions against registered predicates.",
  state_canon: "Canonical state provider (declared vs observed truth).",
  vsf_rsi: "Recursive Self-Improvement: pattern learning, autonomic adjustment.",
  anticipation: "Component A/B host-level cgroup reallocator (S4 lookahead).",
}

viability = "S4 viability is defined by its ability to detect and resolve
    divergences before they collapse the system. It consumes algedonic
    signals (pain) and produces knowledge (claims/certs)."

governance = "S4 logic is gated by S5 (policy). All learned predicates
    require S5 ratification (ritual R1)."
