@vsm 1.2.1
@status active
// `active`, not `planned`: the DOCUMENT is in force; the SYSTEMS it
// specifies carry their own @status=planned inside each V(…). Two
// vocabularies, one field name — this header had the V one.

// ─── SYMBIOGENESIS LABORATORY ────────────────────────────────────────────────
//
//   node:       the lab is not node-specific; only its current DEPLOYMENT is,
//               and that lives in instance.vsm. The source hard-coded a
//               hostname and an IP into a universal spec.
//   derived:    Gemini GENESIS_OF_SYMBIOGENESIS ⊕ vOS architecture
//   base axiom: A6 variety exhaustion → V_sci emergence (A7 escalation)
//
// CERTIFIED 2026-08-09. Five defects, one of them a D6 violation the document
// contradicted itself about — see structure, sci_01_S4 and watermark.
//
// GATE: stages 1-4 are S1 work (sci-01 is an S1 of the lab) and therefore sit
// behind the standing S1 gate. Stage 0 is done; nothing else may start.
// debt(SYMBIOGENESIS-STAGES-1-4, class=human, owner=rmw3, gate=S1_reopen)
// The whole roadmap below stage 0 is blocked on the S2-S5 certification gate.
// Declared so "planned" does not read as "startable".

// ─── PART I — RESTRICTION AXIOM ───

A_rust:
  ∀ V ∈ S1(lab) : impl(V).language = Rust
  ∀ process ∈ n02 : language(process) = Rust
                    ∨ governed_exception @approved(rmw3)

  // Foundation: untyped variety introduces ungovernable noise.
  // Rust guarantees bounded variety at compile time.
  // Without A_rust, the n02 state space is partially observable → A6 is violated.


// ─── PART II — ROOT SYSTEM ───

V("symbiogenesis-lab", L=0) @status=planned {

  S5: rmw3                     // sovereign policy — human
  S4: V("sci-01")              // intelligence — permanent agent
  S3: V("vsf-nucleus")         // control + resources + cgroups
  S2: V("vsl-bus")             // coordination — VSL bus in Rust
  S1: {
    V("vos-kernel"),           // evolving vOS kernel
    V("ref-os"),               // reference OS — model
    V("sci-01")                // scientific agent operation
  }

  E: {
    L_phys:  hardware,
    L_human: rmw3,
    L_cloud: claude-session     // reached over ψ, not an internal subsystem
  }

  // S3* is a CHANNEL, not a tuple element. Ratified 2026-08-04:
  //   V(id, L) ::= ⟨S1, S2, S3, S4, S5⟩ @ E(L)
  // The source listed `S3*: rmw3` as a sixth member alongside S1..S5. rmw3
  // DOES audit sporadically — that is the channel being exercised, not a
  // subsystem being occupied. Fourth document found carrying this.
  S3*_channel: rmw3 @sporadic
}

// ─── PART III — ACTORS ───

// ─── V_vos: evolving kernel ───

V("vos-kernel", L=1) @status=testing {
  impl:       vsf-nucleus (Rust)
  trust:      0.80
  governed:   true
  S5_policy ⊆ V("symbiogenesis-lab").S5
  cgroup:     /vsf/lab/vos-kernel
  stage:      0  // cgroup_poc passed — T1-T4 PASS
}

// ─── V_ref: reference operating system ───

V("ref-os", L=1) @status=planned {
  impl:       minimal Rust OS — bare metal on n02
              // no libc, no Linux kernel
              // only: Rust bootloader + scheduler + memory + VSL I/O
  purpose:    response model to stress(λ) for V_sci
  role:       V_ref in Structural_Coupling
  constraint: A_rust @strict     // no exceptions here
  cgroup:     /vsf/lab/ref-os
}

// Note: ref-os does not need to be complex.
// It needs to be observable under the same λ as vos-kernel.
// Behavioral differential = learning signal for V_sci.

// ─── V_sci: permanent scientific agent ───

V("sci-01", L=1) @status=planned {

  identity:   permanent           // not ephemeral — survives n02 reboots
  host:       n02
  impl:       Rust                // claude-api-client + vsf-nucleus-sdk
              // Rust binary that:
              //   1. maintains local state (VSL memory, RAP)
              //   2. calls claude-api when it needs S4
              //   3. runs observation loops without LLM (autonomous L0)
              //   4. escalates to claude-api only when variety(task) > τ_sci

  S5:         V("symbiogenesis-lab").S5  // inherits rmw3 policy
              S5(sci-01).policy ⊆ S5(claude-session).policy   // A5 corollary 2
  S4:         local intelligence (Rust) — deterministic, ∄ LLM
  S3:         local observation loop (Rust, ∄ LLM)
  S2:         vsl-bus
  S1:         {observer, mutator, validator}
  S3*_channel: rmw3 ⊕ claude-session @sporadic

  // CORRECTED 2026-08-09 — D6 VIOLATION, and the document already contradicted
  // itself about it. The source read `S4: claude-api @external — Claude session
  // = S4 of sci-01`. sci-01 is declared L=1, and D6 is exact:
  //     S4(L).uses_LLM = ⊤  only_if  L ≥ 2
  // An LLM as the S4 of an L1 system is precisely what D6 forbids.
  // PART IV of THIS document already models the coupling correctly, as
  // ψ(V("claude-session"), V("sci-01")) — a peer channel with D11
  // preconditions, not an internal subsystem. The S4 line was the stale reading.
  // The design survives intact: sci-01 still escalates, over ψ, when
  // variety(task) > τ_sci. What changes is that the LLM sits OUTSIDE the L1
  // control loop, which is the whole content of D6.

  cgroup:     /vsf/lab/sci-01
  trust:      0.0  // @status=planned — trust accumulates with operation
}

// ─── PART IV — ψ CHANNEL (claude-session ↔ sci-01) ───

ψ(V("claude-session"), V("sci-01")) {

  // This channel implements PSI/1.0 (internal — not published yet)
  // It is the first concrete use case of the protocol

  transport:  unix-socket | HTTP/VSL
              // unix-socket: when claude-session accesses via n02-tunnel
              // HTTP/VSL:    when claude-api responds to sci-01

  layers: {
    L1_identity: {
      claude-session: watermark ⟦ claude | rmw3 | vsm-1.0 | vsf.u2738.org ⟧
      sci-01:         watermark ⟦ sci-01 | rmw3 | vsm-1.0 | vsf.u2738.org ⟧
      // CORRECTED 2026-08-09: THREE fields, and vsm-0.3. covenant §watermark
      // declares FOUR — {NODE_ID}|{authorized_by}|{spec_version}|vsf.u2738.org
      // — and required of nodes. A watermark short a field verifies against
      // nothing.
      verify:         S5(both) = rmw3  // same operator → ψ allowed
    }

    L2_covenant: {
      applies: { A0, A0.1, A5 }
        // statements live in boot/covenant.vsm — cited, not restated. The
        // abbreviated copy that stood here carried only A0's prohibition
        // clause; A0 has two, and half of it reads as the whole.
      instantiation_ψ: A0 ∧ A0.1 evaluated over purpose(ψ)
      A5:   S5(sci-01).policy ⊆ S5(claude-session).policy   // concrete here
      sign: rmw3 @required
    }

    L3_channel: {
      state: { init → validate → negotiate → establish → active
               → degraded → revoked | abort }
      nonce:  registry TTL=120s, store=@nonce_registry
      rate:   ψ_rate_limit @D13
    }

    L4_dialogue: {
      format:   pure VSL (@vsm 1.0)
      payload:  φ↓(sci-01) { task | observation | patch }
                φ↑(claude-session) { result | escalation | question }
      fallback: if claude-api offline → sci-01 operates in autonomous mode (local S3)
    }
  }

  viable_ψ =
    trust(sci-01) ≥ 0.40
    ∧ covenant_signed(rmw3)
    ∧ channel.state = active
    ∧ A_rust(transport)
}

// ─── PART V — SYMBIOGENESIS LOOP ───

// Derived from Gemini GENESIS_OF_SYMBIOGENESIS — translated to VSL v1.0

loop_symbiogenesis(V_sci, V_vos, V_ref, λ) {

  // λ = perturbation applied to the system
  // Runs under V_sci supervision

  step(1): {
    op:     observe(V_ref, λ)
    output: pattern_ref = behavior(V_ref) @ stress(λ)
    // V_ref is the "mature" organism — its response is the reference
  }

  step(2): {
    op:     perturb(V_vos, λ)
    output: pattern_vos = behavior(V_vos) @ stress(λ)
    measure: stasis_recovery_time(V_vos, λ)
  }

  step(3): {
    op:     Δpattern = diff(pattern_ref, pattern_vos)
    // if Δpattern = ∅ → V_vos already converged with V_ref for this λ
    // if Δpattern ≠ ∅ → there is learning margin
  }

  step(4): {
    op:     patch = synthesize(Δpattern)   // V_sci generates VSL patch
    emit:   φ↓(V_vos) { patch }
    // V_sci can escalate to claude-api if complexity(patch) > τ_sci
  }

  step(5): {
    op:     apply(V_vos, patch)
    validate: stasis_recovery_time(V_vos_new, λ)
              < stasis_recovery_time(V_vos_old, λ)
    if valid:   commit(patch) → RAP(V_sci)
    if invalid: discard(patch), log(λ, Δpattern, failure), retry(λ′ ≠ λ)
  }

  convergence: Δpattern(V_vos, V_ref) → ∅ @ all λ ∈ Λ
}

// Evolutionary viability formula (Gemini, corrected):
//   ⊕ here = learning composition, not Ashby variety
//   correct symbol: ∘ (composition)

viable_vos(n+1) = viable_vos(n) ∘ learning(V_ref, loop_symbiogenesis)

// Complete laboratory condition:

viable_beer(lab, t) =
  viable(V_vos, t)
  ∧ viable(V_sci, t)
  ∧ ψ_active(claude-session, sci-01)   // S4 coupled
  ∧ d/dt[viable(V_vos)] ≥ 0            // monotonic improvement
  ∧ adaptation_loop_active(V_sci, V_vos)

// ─── PART VI — AUTOPOIETIC AXIOMS (Gemini session 2026-04-12) ───

// ─── A_breath — breathing function (systemic heartbeat) ───

A_breath(V, λ_min) {

  // ORIGIN. This is where A_breath was first stated, Gemini session
  // 2026-04-12. system/kernel/vos_core_theory.vsm carries the CANONICAL form — the
  // pressure-driven one, verified against the kernel, with the three-term
  // divergence recorded there as KERNEL-ABREATH-ALIGN — cited by BARE id,
  // not-in-debt(…) form: a citation must not look like a declaration.
  // Kept here rather than replaced by a citation because this states it as a
  // BREATHING axiom (inhale/exhale/crisis) and vos_core_theory states it as a
  // pressure function; the second is the implementation of the first, not a
  // rival. On divergence, vos_core_theory wins.
  //
  // The system applies continuous minimal stress to itself.
  // Purpose: map the frontier between current capacity and potential.
  // It is not a processing loop — it is an architecture exploration loop.

  inhale(V, λ_min): {
    op:      stress_probe(V, λ_min)
    measure: stasis_recovery_time(V, λ_min)
    effect:  V "feels" the limits of n02.hardware
    // temporarily reduces τ_threshold — the system becomes more sensitive
  }

  exhale(V): {
    condition: stasis_recovery_time(V, λ_min) < τ_recovery
    op:        return_to_rest(V)
    effect:    consolidate(observations) → RAP(V)
  }

  trigger(A_meta): {
    condition: stasis_recovery_time(V, λ_min) ≥ τ_recovery
               ∨ solve(T, V) = ∅
    // an inhale that cannot exhale → crisis → morphogenesis
  }

  period:  tick(L) @configurable   // heartbeat frequency, level-local
  bound:   B(A_breath) ≤ B_idle(V) // the heartbeat cannot consume more than the idle budget
}

// ─── A_meta — structural morphogenesis ───

A_meta(V) {

  // If the task is unsolvable or the communication channels saturate,
  // the system has the axiomatic instruction to sacrifice its current
  // structure and generate a new one with a higher degree of recursion.

  trigger: {
    φ↑(latency, V) > τ_crit
    ∨ solve(T, V) = ∅
  }

  metamorph(V) → V′ {
    V′.depth    = V.depth + 1
    V′.S5       ⊆ V.S5              // A5 corollary 2 — no policy escalation
    V′.cgroup   = cgroup(V′, trust_score(V′))
    validate:   viable_beer(V′, t)
  }

  commit:  if viable_beer(V′) → replace(V, V′), log(metamorph, Δstructure)
  discard: if ¬viable_beer(V′) → discard(V′), restore(V), log(failure)

  // A_meta is not S5 → V′(S5) — that is @forbidden (recursion_axiom)
  // A_meta is S1..S4 → V′(S) — operational subsystems may reconfigure
  // S5 remains immutable throughout all morphogenesis
}

// ─── A_auto — autopoiesis as ontological obligation ───

A_auto(V) {

  // Viability is not a static state — it is a trajectory.
  // The system is obligated to maintain d/dt[viable(V)] ≥ 0.

  obligation: {
    ∀ t: d/dt[viable(V, t)] ≥ 0
    // if d/dt < 0 → A7 escalation → A_meta trigger
  }

  stress_cycles @required {
    // The system MUST undergo periodic A_breath cycles.
    // Without induced stress, the capacity frontier is unknown.
    // Ignorance of limits = latent A6 violation.
  }

  growth_condition {
    new_structure retained iff:
      stasis_recovery(V_new, λ) < stasis_recovery(V_old, λ)
      ∧ viable_beer(V_new, t)
    // if the new structure is worse → programmed cell death
    // if better → it is fixed in the systemic genome (viability.yaml)
  }

  covenant_bound:
    A_auto ⊆ A0                  // autopoiesis cannot violate purpose
    ¬permanently_destroy(V_vos)  // V_sci cannot destroy what it observes
}

// ─── PART VII — REFERENCE OS MODEL ───

// Equivalence table: OS concepts → VSF roles
// Basis for V_vos to learn to be an operating system

os_reference_model = {

  process(PID)    → S1(V)            // operational unit with lifecycle
  VFS             → RAP(V)           // identity persistence + telemetry
  driver          → transducer(      // L_phys ↔ L_logic interface
                      input:  signal_phys(hardware),
                      output: signal_vsl(V)
                    )
  scheduler       → S2(V)            // coordination + A_breath timing
  interrupt       → φ↑(urgency=CRITICAL)   // algedonic signal
  cgroup          → cgroup(V, trust_score(V))  // already implemented in vsf-nucleus
  syscall         → φ↓(S1, kind="command")
  /proc /sys      → telemetry(φ↑)    // already exists in Linux — reuse as S3* feed
  unix_socket     → ψ_transport      // ψ channel between V_sci and V_vos
  named_pipe      → φ↑ / φ↓ local
}

// V_ref implements these concepts in pure Rust.
// V_vos learns by observing how V_ref resolves them under stress(λ).
// V_vos does NOT copy code — it imitates the behavioral pattern.

// ─── V_ref co-habits with V_vos ───

V("ref-os", L=1) @updated {
  // V_ref also runs A_breath(λ_min)
  // Purpose: V_sci observes BOTH under the same λ
  // The differential is the learning signal

  A_breath:   active @same_λ_as(V_vos)
  observable: stasis_recovery_curve(V_ref, λ) → φ↑(V_sci)
  role:       mature model — does not learn, provides stable reference
}

// ─── PART VIII — SCIENTIFIC AGENT PROTOCOL ───

sci_protocol(V_sci, λ) {

  // Scientific method as a control cycle.
  // V_sci does not only observe — it induces, mutates, validates.
  // "Digital CRISPR": targeted mutations, not random ones.

  step(hypothesis): {
    form:    "if modify(component, param) → Δstasis_recovery < 0"
    source:  Δpattern(V_ref, V_vos) @ stress(λ)
  }

  step(experiment): {
    op:      stress(V_vos, λ) + stress(V_ref, λ)  // same λ, both systems
    measure: entropy_curve(V_vos, t), entropy_curve(V_ref, t)
  }

  step(analysis): {
    compare: curve(V_vos) vs curve(V_ref)
    compute: Δviability = viable(V_vos_post) − viable(V_vos_pre)
  }

  step(conclusion): {
    if Δviability > 0 → persist_patch(Rust source) @commit
    else              → discard + log(λ, hypothesis, failure)
                        retry(λ′ ≠ λ, hypothesis′ refined)
  }

  constraint: {
    ¬permanently_destroy(V_vos)   // A0.1 covenant
    B(experiment) ≤ B_idle(lab)   // A3 budget
    S5(V_sci) @consulted if Δdepth > 0   // A_meta requires approval if it raises level
  }

  escalate_to(claude-session): {
    condition: complexity(patch) > τ_sci
               ∨ Δdepth > 0           // morphogenesis requires external S4
    channel:   ψ(V_sci, claude-session)
  }
}

// ─── First defined experiment ───

experiment(1) {
  name:       "disk_write_queue_under_memory_pressure"
  λ:          memory_fill(n02, 80%) + disk_write_flood(sequential)
  hypothesis: "V_vos scheduler prioritizes φ↑ over writes when memory > 80%"
  V_ref_expected: buffer_flush + reduce_write_queue + maintain_φ↑
  success:    stasis_recovery_time(V_vos) ≤ stasis_recovery_time(V_ref) · 1.5
  // 50% tolerance over V_ref on first iteration
}

