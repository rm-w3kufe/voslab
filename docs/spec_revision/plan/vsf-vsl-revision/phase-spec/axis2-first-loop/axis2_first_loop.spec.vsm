@status active
// axis2_first_loop.spec.vsm — AXIS 2: the FIRST certified autonomous control loop.
// author: Claude/Fable [O] 2026-07-03. Gate: AXIS 1 (all nucleus instruments calibrated) DONE.
// Frame: calibration_autonomy_strategy.vsm — RETIRED/HISTORICAL 2026-07-31 (≈95%
// executed; recorded in plans_active.vsm records). Cited for lineage, ¬authority.
// @status active (epistemic). transform: move — PH-11 move carries content
// VERBATIM (¬compressed); density N/A per revision_plan move_vs_migrate. Over
// target BY DESIGN, declared (2026-08-09).

spec(AXIS2-FIRST-LOOP) {

  gate_met:
    "AXIS 1 CLOSED 2026-07-03 — every nucleus instrument now DISCRIMINATES (stasis_cos, margin_free,
     entropy→inhale, trust×4, variety, lyapunov, vr). We may now close a loop on these signals."

  the_loop(S3_AUTONOMOUS_ALLOC):
    what: "certify s3_resource_alloc's grant/revert as the FIRST fully-autonomous control loop: the machine
           detects → decides → acts → verifies → reverts, WITHOUT a per-grant human decision. It already
           auto-grants to S1 (clima/econ) on stasis_cos; Axis 2 = (a) CERTIFY it now that the signal is
           calibrated, and (b) EXTEND the trigger to the calibrated margin_free (act BEFORE stasis drops)."
    cycle: [
      "DETECT   — a CALIBRATED signal crosses a policy threshold: stasis_cos < STRESS (existing) OR the
                  now-discriminating margin_free shrinks toward the danger frontier (NEW early-warning trigger).",
      "DECIDE   — grant = f(stress_depth) (the existing proportional bargain, safety_margin 20%).",
      "ACT      — Proxmox cgroup resize (cores/RAM). A5 gate holds: NO lifecycle ops (start/stop/create).",
      "VERIFY   — recovery: stasis_cos ≥ RECOVERY for RECOVERY_TICKS (existing RESTORE).",
      "REVERT   — return to baseline; log the whole loop to the S3* audit chain.",
    ]

  guardrails(R10.1):  // the machine owns the MEANS; the human owns the ENDS
    [ "CALIBRATED-SIGNAL GATE — act ONLY on instruments that passed Axis-1 P3 (never on an uncalibrated gauge).",
      "COVENANT FLOOR — grants stay within A3 budget bounds; the deterministic covenant check is unchanged.",
      "S3* AUDIT — every autonomous grant/revert is recorded on the audit chain (auditable after the fact).",
      "ESCALATION DUTY — a grant beyond ESCALATE_THRESHOLD (e.g. pool > 80% RED zone, or a novel pattern)
                         escalates to the human instead of acting (A5 double-loop preserved).",
      "20% SAFETY RESERVE — S3 keeps management resource (Beer); never allocate the whole pool." ]

  human_role:
    "rmw3 (S5) sets the POLICY — thresholds, grant sizes, the escalate threshold, which loops are autonomized.
     The machine executes the tactics within that policy. Strategy/tactics gradient (strategic_tactical_authority.vsm)."

  policy_ratified:  // rmw3 RATIFIED 2026-07-03 — Claude/Fable recommended defaults (S5 may tune):
    { autonomize_first:     "ONLY the S3 resource-alloc grant/revert loop this phase. NOTHING else auto
                             (lyapunov drift-correction + beacon onboarding stay in next_loops).",
      escalate_threshold:   "escalate (hold, do NOT act) if ANY of: pool utilization > 80% (RED zone); a
                             single grant > +512M RAM or > +1 core; cumulative grants to one target > +1024M;
                             a stress signature not seen before (novel pattern).",
      margin_early_warning: "anticipatory grant when margin_free < 0.05 (STRESS_MARGIN, tunable — live range
                             ~0.02–0.09); fires BEFORE stasis_cos drops.",
      grant_size:           "unchanged — the existing proportional bargain f(stress_depth) + 20% safety reserve.",
      recovery:             "unchanged — revert when stasis_cos ≥ RECOVERY for RECOVERY_TICKS." }

  impl: {
    "1 [S]": "add the margin_free early-warning trigger (< 0.05) to s3_resource_alloc.py — anticipatory grant.",
    "2 [S]": "wire every autonomous grant/revert to the S3* audit chain (so the loop is auditable).",
    "3 [S]": "the ESCALATE_THRESHOLD path (ratified thresholds above): RED-zone / big-grant / novel → emit
              algedonic + HOLD (don't act).",
  }

  acceptance:
    "s3_resource_alloc closes the grant/revert loop autonomously on calibrated signals; a margin_free
     early-warning triggers an anticipatory grant; every action is on the S3* audit chain; a RED-zone/novel
     case ESCALATES instead of acting. Then S3 regulation is CONTINUOUS + autonomous for this loop → DEBT_S3
     downgrades from 'human regulates' to 'machine regulates, human governs' for the resource loop."

  next_loops:  // Axis 2 continues, one calibrated loop at a time
    "after this: drift-correction on lyapunov (diverging → S4 tactical action), then the beacon-attested
     onboarding (a new S1 self-onboards when its instruments pass Axis-1) — the recursion (ITEM-21)."

  owner: "Claude/Fable [O] (this design + policy defaults with rmw3) → DS [S] (impl). rmw3 (S5): ratify
          the escalate threshold + which loops to autonomize first."
  status: "RATIFIED 2026-07-03 — policy locked (defaults above). AXIS 2 open. First loop = S3 autonomous
           alloc. → DS [S] impl (items 1-3). No further rmw3 gate for this loop."
}

