⟦ version_change_plan | VERSION-CHANGE-PLAN-v1 | vsm-1.2.1 | 2026-08-16T20:30:00Z ⟧

@vsm 1.2.1
@status active
// plan/version_change_plan.vsm — the FORMAL plan for the version-change
// cycle of language/grammar documents. GENERIC: it governs ANY bump of
// the protocol version (vsm-1.2 today; vsm-1.3, vsm-2.0, … tomorrow),
// not only this instantiation. First instantiation: 2026-08-16 (v1.0→1.2).
//
// Status lives in TASKS.vsm (doc_sync discipline). This doc is the
// framing/rationale/strategy — the WHY and the HOW, not the status.

// ─── PART I — PRINCIPLE ─────────────────────────────────────────────────────

principle:
  "A version bump in a language/grammar doc is a CHANGE TO THE CANON:
   every doc that depends on it must re-commit to the new version —
   mechanically gated, humanly reviewed. The instrument must catch the
   bump BEFORE any doc can pass gates on stale requirements (order:
   instrument first, migrate second). The process must be GENERIC:
   built once, fired by any future bump."

  // Why the process is generic, not version-specific (S5 rmw3, 2026-08-16):
  //   - the canonical version is READ FROM the primer header (parametric
  //     checks), never hard-coded in a check
  //   - the gates re-fire automatically when the primer's version line
  //     changes — no check edit needed for the next bump
  //   - the migration steps are the same regardless of target version:
  //     dimension universe → migrate docs → propagate to dependents →
  //     verify → close

// ─── PART II — THE CYCLE (generic, 6 stages) ────────────────────────────────

cycle:
  stages: {
    S0: "DECLARE — bump the version in the canonical source
         (vsl_language_primer header: @vsm + timestamp). The primer
         self-applies its own policy (timestamp protocol).",
    S1: "INSTRUMENT — BEFORE migrating any doc, ensure the gates catch
         the new version: checks/ratified-version-current (parametric:
         reads canonical from primer header), vsm-version-coherent,
         vsl-encoding-valid, boot-manifest-valid, dir-schema-valid.
         Any doc passing gates while NOT meeting the new requirement
         = stale instrument = worthless review (rmw3 order).",
    S2: "DIMENSION — run checks/ratified-version-current pass to list
         every @status ratified doc still on the old version. This is
         the universe; migrate ALL of it (not only boot/ — s5-policy
         reference set and s3star included).",
    S3: "MIGRATE — per doc: header/footer + @vsm line to new version,
         timestamp → UTC ISO 8601 (T…Z, no space). Protocol-ID line
         (VSL-LANG-*-v0.1, VSL-AGENT-ONBOARDING-v3, …) moves on its
         OWN line (two-line versioning: protocol vs language, same as
         primer). Covenant: co-signature — its @vsm bump is mechanical
         evidence the review against the new policy was executed (S5
         2026-08-16); watermark footer untouched (constitutional seal).",
    S4: "PROPAGATE — the bump ripples to dependents. Update:
         boot_manifest.vsm artifact hashes (re-derive sha256[:16] —
         mechanical, never hand-invented),
         dir_schema.spec.vsm type lines (dir-schema gate catches
         UNCOVERED),
         .primer_sources_manifest.json (re-baseline AFTER diff-verified
         content: R4 — only version lines may have changed).",
    S5: "VERIFY — full battery before commit: parser --strict ∀ doc,
         encoding, ratified-version-current, vsm-version-coherent,
         boot-manifest-valid, dir-schema-valid, plan-tree-valid,
         verify_boot_primer. THEN commit with Verified-By listing the
         checks that pass corpus-wide.",
  },

  gates: {
    "S1 before S3":  "instrument first, migrate second — a doc passing
                      with a stale instrument is a false pass",
    "R4 before re-baseline": "diff-verify the changed sources BEFORE
                      verify_boot_primer.py --update; content must be
                      version-lines-only, else the primer section needs
                      real review",
    "covenant co-signature": "covenant @vsm bump = mechanical evidence
                      of review; never auto-skip it",
    "generic, not one-off": "next bump: no new instrument design needed
                      — the parametric checks re-fire; only S2-S5
                      re-execute",
  },

// ─── PART III — INSTANTIATION 2026-08-16 (v1.0 → vsm-1.2) ──────────────────

instantiation_2026_08_16: {
  status: done,
  commits: [
    "0a780a5a — S1: instrument gap closure (ratified-version-current,
       compression-drift-valid, pre-commit BLOCK/REPORT gates)",
