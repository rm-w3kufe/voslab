       + 1 s3star); boot_manifest 19 hashes, dir_schema 14 types,
       primer_sources_manifest re-baselined",
  ],
  universe: "21 ratified docs on v1.0 (dimensioned by ratified-version-current)",
  evidence: {
    ratified:   "./checks/ratified-version-current pass → PASS (all ratified at vsm-1.2)",
    coherent:   "./checks/vsm-version-coherent pass → 84 vsm-1.0 + 23 vsm-1.2",
    encoding:   "./checks/vsl-encoding-valid pass → PASS",
    manifest:   "./checks/boot-manifest-valid pass → PASS",
    dir_schema: "./checks/dir-schema-valid pass → clean",
    parser:     "python3 scripts/vsl_parser.py --strict → 22 VALID / 0 INVALID",
