⟦ readme | PLAN-readme-v1 | vsm-1.2.1 | 2026-08-17T08:25:21Z ⟧

@vsm 1.2.1
@status active
// docs/spec_revision/plan/readme.vsm — ROL Y FUNCIÓN DE plan/.
// DECISIÓN S5 rmw3 2026-08-14 (DIR-readme-POLICY) + censo AUDIT-PLAN-SANDBOX-SPEC
// 2026-08-15: plan/ = planes ACTIVOS, paralelo a sandbox, NO doc permanente.
// PLAN-TREE-S4 2026-08-17 (CLASSIFICATION-POLICY-PLAN PART III): plan/ es un
// ÁRBOL — tronco fractal + cada plan es una carpeta root + fases; los specs
// viven DENTRO del plan, nunca huérfanos. Este readme es la puerta del
// directorio: se lee antes de entrar.

system(readme) {

  synthesis: "plan/ := los PLANES ACTIVOS de VSF — framing/rationale/strategy
              de lo que se está ejecutando; NO el backlog (eso es CLAUDE.md /
              TASKS.vsm). Un plan que no se ejecuta es un DATED RECORD, no
              un doc permanente (doc-sync 2026-07-31).",

  structure: [
    dir("plans_active.vsm",      role="índice",    desc="el TRONCO fractal del árbol — índice fusión de planes activos (PLAN-01) + arcos derivados (plan_tree.py); leer primero"),
    dir("vsf-vsl-revision/",     role="plan-carpeta", desc="PLAN VSF-VSL-REVISION-v1 como CARPETA (PART III): root.vsm + phase-spec/ — los 4 experimentos viven DENTRO del plan (plan/<plan>/<fase>/)"),
    dir("revision_arc_tree.vsm", role="plan",      desc="árbol del arco de revisión system/ (REVISION-ARC-TREE) — derivado por plan_tree.py"),
    dir("version_change_plan.vsm", role="plan",    desc="plan FORMAL del ciclo de cambio de versión del protocolo (VSM12) — genérico, any bump"),
    dir("classification_policy_plan.vsm", role="plan", desc="plan FORMAL de la política de clasificación documental — el árbol de decisión socrático (cuestionario) → directorio canónico; instrumento checks/classification-valid"),
    dir("seven_ideas_deep.vsm",  role="conjecture", desc="7 conjeturas sobre el sistema en ejecución (developing)"),
    dir("h_rest_senescence.vsm", role="research",  desc="pregunta de investigación abierta: ¿qué ley gobierna H_rest?"),
    dir("symbiogenesis_lab.vsm", role="lab",       desc="laboratorio de simbiogénesis — stages 1-4 tras gate S1 (A5)"),
    // creative_leaps.vsm MOVED → archive/superseded/ 2026-08-17 (DATED RECORD,
    // superado por seven_ideas_deep; plan/ = solo planes ACTIVOS — ARCHIVE-index)
    // ESPEC DENTRO DE PLAN (S5 2026-08-17, classification_policy_plan PART III):
    // un spec normalmente es parte de un plan — plan/ = árbol: raíz + fases;
    // no debería haber spec sin plan (VIOLACIÓN si huérfano)
  ],

  tree: "
    plan/ es un ÁRBOL (S5 rmw3 2026-08-17):
      tronco   plans_active.vsm — índice fractal: TODOS los planes con sus
               fases/etapas; las tasks deben ser reconocibles desde plan/
               (tensión TASKS↔plan: declarada, no resuelta — plan como árbol)
      cada plan = CARPETA: <plan>/root.vsm + <plan>/phase-01/, phase-02/…
      un spec es normalmente parte de un plan: los specs viven en las
               subcarpetas de fase (plan/<plan>/<fase>/), NUNCA huérfanos
      ciclo de vida: plan completo → (1) síntesis MÁXIMA a system/ (un doc,
               un bloque, o UNA LÍNEA dentro de un doc existente); (2) el
               resto → archive/superseded/ con index entry",
  // Implementación física progresiva: los planes actuales son archivos
  // simples (sin fases propias); cuando un plan crece a fases con specs,
  // SE CONVIERTE en carpeta plan/<plan>/ con root.vsm + phase-*/ — la
  // estructura física sigue al árbol, no al revés.

  policy: "
    un plan vivo → vive aquí con su estado en TASKS.vsm (doc-sync: status
    SOLO en TASKS.vsm, flipped en el mismo commit que cierra el trabajo)
    un plan que se retira → DATED RECORD (citado por linaje, ¬autoridad);
    MASTER_PLAN → retired 2026-07-31 (precedente)
    una propuesta sin validar → sandbox/ (NO plan/)
    un spec de eje/experimento sin plan padre → sandbox/ hasta engancharse
    (VIOLACIÓN si huérfano — spec sin plan, plan sin spec)",

  verification: "dir-schema-valid (BLOCKING) — type PLAN-01 declarado",
}

⟦ /readme ⟧
