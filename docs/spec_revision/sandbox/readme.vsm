@vsm 1.2.1
@status active
// docs/spec_revision/sandbox/readme.vsm — ROL Y FUNCIÓN DE sandbox/.
// DECISIÓN S5 rmw3 2026-08-14 (DIR-readme-POLICY + rail sandbox):
// sandbox/ = propuestas en validación. RAIL: nada canónico aquí.
// Este readme es la puerta del directorio: se lee antes de entrar.

system(readme) {

  synthesis: "sandbox/ := el RAIL de validación — una propuesta entra AQUÍ,
              se valida, y SOLO entonces se promueve a system/ (canon) o se
              descarta. El rail exige: propuesta → validación → implementación
              → promoción. Nada en sandbox/ es canónico (dir_schema 62-68:
              'rail; nada canónico aquí').",

  structure: [
    dir("system_ontology_master.vsm", role="orquestador", desc="THE MASTER — orquesta tasks de ontología; check ontology-master-trace enforcea"),
    dir("boot_ontology_pattern.vsm", role="propuesta", desc="patrón ontología boot M1-M7 (proposed)"),
    dir("conformance_attenuator.vsm", role="propuesta", desc="atenuador de conformidad — specs bajo test (proposed)"),
    // restructure_survey.vsm → archive/measurements/ ; vsm_logic_demo.vsm →
    // archive/examples/ 2026-08-17 (R4: ni política ni spec — DATED RECORD;
    // sandbox/ = SOLO docs a promover a system/, ARCHIVE-POLICY S5)
  ],

  policy: "
    una propuesta en validación → vive aquí (rail)
    un doc que un doc canónico cita como FUENTE → debe PROMOVERSE a system/
    (kernel_map PROMOVIDO 2026-08-15 A5 — precedente aplicado)
    un design source validado → se promueve a system/s5-policy/agent-policy/
    design-sources/ (PROMOTE-AGENT-POLICY — 3 promovidos 2026-08-15 A5)
    un spec de eje/experimento → plan/<plan>/<fase>/ si tiene plan padre
    (NODO 3 — los specs viven DENTRO de su plan, nunca huérfanos; sin plan
    padre → sandbox/ hasta engancharse a un plan. spec/ como categoría raíz
    ELIMINADA 2026-08-17 — no hay spec sin plan, PART III)
    el material técnico permanente de una política → system/s5-policy/<política>/
    (NO sandbox/ — espejo de vsl-language/)
    un DATED RECORD (medición, ejemplo, superado) → archive/<clase>/ CON
    entrada en archive/index.vsm en el mismo commit (ARCHIVE-POLICY S5
    2026-08-17 — archive-index-valid BLOCKING; plan/ y sandbox/ quedan
    solo con docs de PROMOCIÓN o PLAN ACTIVO, nunca records)
    todo doc .vsm editado → versión canónica del protocolo (R18 — demonio
    vsl-check-on-write BLOCKING en versión; ver RULES.md fila R18)",

  verification: "dir-schema-valid (BLOCKING) + learning-record-valid (BLOCKING, si hay learning_records)",
}

⟦ /readme ⟧
