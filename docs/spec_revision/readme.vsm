⟦ readme | SPEC-REVISION-readme-v1 | vsm-1.2.1 | 2026-08-17T02:58:03Z ⟧

@vsm 1.2.1
@status active
// docs/spec_revision/readme.vsm — ROL Y FUNCIÓN DE docs/spec_revision/ (raíz).
// DECISIÓN S5 rmw3 2026-08-14 (DIR-readme-POLICY): 'organización de la
// estructura y definir instrucciones de uso al comienzo de los directorios
// para no acumular documentación sin destino'.
// Este readme es la puerta del directorio raíz: se lee antes de entrar.
// Patrón: system/readme.vsm (SYSTEM-readme-v1, 0782fe09).

system(readme) {

  synthesis: "spec_revision/ := el CANON del sistema documental — toda la
              especificación VSM en forma consultable; la raíz es solo un
              índice de puertas: cada subdirectorio tiene su rol y su readme.
              La correspondencia con n02 vive en system/ (mapa); aquí vive
              el ORDEN de los documentos (qué va dónde).",

  structure: [
    dir("system/",   role="sistema",      desc="la raíz del sistema documental — correspondencia con n02 (10 órganos, cada uno con su rol). PUERTA: system/readme.vsm"),
    dir("spec/",     role="specs",        desc="specs de ejes/experimentos (axis2, EXP-*), dir_schema, system_map. PUERTA: spec/readme.vsm"),
    dir("plan/",     role="planes",       desc="planes ACTIVOS — no doc permanente; lo cumplido se archiva o promueve. PUERTA: plan/readme.vsm"),
    dir("sandbox/",  role="rail",         desc="propuestas en validación — NADA canónico aquí; el rail exige: propuesta→validación→implementación→promoción. PUERTA: sandbox/readme.vsm"),
    dir("ledger/",   role="ledger",       desc="registros contables del árbol (compression_ledger). PUERTA: ledger/readme.vsm"),
    dir("learning_records/", role="ciclo",desc="registros del ciclo de aprendizaje (IRs, learning_records) — estándar §6 de learning_cycle.vsm. Enforcement: checks/learning-record-valid"),
  ],

  policy: "
    cada directorio tiene un rol → usa su puerta (readme) antes de crear doc
    nuevo archivo sin categoría declarada en dir_schema → violación
    (dir-schema-valid BLOCKS — ver spec/dir_schema.spec.vsm)
    un doc que describe un órgano de n02 → system/<organo>/
    un doc que es propuesta sin validar → sandbox/ (rail, nada canónico)
    un doc que es spec de eje/experimento → spec/
    un plan que no se ejecuta → DATED RECORD (no doc permanente) → plan/
    un learning_record → learning_records/ con estándar §6",

  verification: "dir-schema-valid (BLOCKING) + learning-record-valid (BLOCKING, learning_records/)",
}

⟦ /readme ⟧
