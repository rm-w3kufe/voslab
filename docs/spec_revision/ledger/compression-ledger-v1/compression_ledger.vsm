@vsm 1.2.1
@status active
// ledger/compression_ledger.vsm — registro de operaciones de traducción/compresión VSL
// purpose: PUBLISHABLE metric for the docs/spec_revision/ process — FORMA density +
//   semantic coverage per operation, aggregable (scripts/vsl/compression_metrics.py)
// compression_standard: FORMA — referencia core_boot_primer.vsm; método [1]-[6]
//   exclusions: data values verbatim + instance/ paths
// scope: PH-01 META + PH-02 THEORY (ops 1-3) — extends to PH-03.. and the plan's branches
// retroactive 2026-08-06: data reconstructed from git history (commits 008bcb4..3bf0a2a)
// RE-BASELINE 2026-08-16 (VSM12-COMPRESSION-DRIFT-BUG): 24 ops re-baselined to disk
//   truth (docs edited after their fuse without ledger update; ledger must
//   reflect reality, R7 model≡reality). Spurious drift fixed in
//   scripts/vsl/compression_metrics.py: drift applies only to ops DECLARING
//   fuse_lines (16 CERT/review/RESTRUCT ops no longer flagged).

metric_definition("density_FORMA") = {
  formula:   "1 − fuse_lines / src_lines",
  note:      "metric of the compression_standard — FORMA (VSL structure), not % of words",
  reference: "core_boot_primer.vsm (the corpus density target)",
  applies:   "∀ op() in this ledger; derivable from the script, explicit on each op",
}

metric_definition("coverage_semantic") = {
  formula:   "1 − losses / checks   (token-diff R4)",
  note:      "proporción de checks semánticos sin pérdida genuina; 1.0 = compresión fiel",
  method:    "parser ✓ VALID + closure 50 glyphs + token-diff per operation (R4)",
  caveat:    "losses = GENUINE losses; regex false positives are discarded with a note",
}

