  // ════ COLISIONES / REDUNDANCIAS (verificado R4) ════
  collisions: [
    collision("boot_manifest vs SYSTEM-SPEC-index",
      verdict: "NO COLISIÓN — frontera clara: boot/ (36 artifacts) vs
               system/ 13 rutas (34-41 archivos). SYSTEM-SPEC-index ya la
               declara. Pendiente: decidir manifest hermano vs extensión.",
      action: "resolver en SYSTEM-SPEC-index (decisión S5 pendiente)"),
    collision("BOOT-CONSOLIDATION vs SYSTEM-SPEC-index",
      verdict: "SUPERPOSICIÓN PARCIAL — ambos refieren indexación, pero
               consolidar boot ≠ indexar system/. Mantener separados; el
               maestro los orquesta.",
      action: "ninguna — el maestro es la capa que los une"),
    collision("boot_ontology_pattern vs maestro",
      verdict: "NO DUPLICAR — boot_ontology_pattern es la capa hija (M1-M7);
               el maestro es la capa superior. Si el maestro re-cita M1-M7
               en detalle, degrada a redundancia.",
      action: "el maestro CITA por referencia, no re-escribe"),
    collision("sandbox specs (5)",
      verdict: "NO COLISIONAN — propósitos distintos verificados: survey=
               medición, kernel_map=censo, vsm_logic_demo=ejemplo,
               conformance_attenuator=política, boot_ontology_pattern=plan.",
      action: "ninguna"),
    collision("sandbox executor (child/sandbox 3 dirs)",
