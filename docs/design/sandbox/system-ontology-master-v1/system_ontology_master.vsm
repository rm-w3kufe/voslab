// docs/design/sandbox/system-ontology-master-v1/system_ontology_master.vsm
// THE MASTER — orquestación de la consolidación ontológica del sistema.
//
// Decisión S5 rmw3 (2026-08-14): "un maestro para orquestar las tareas del
// boot; evaluar si dentro de las especificaciones hay colisiones o
// redundancias; enmarcar todo dentro de VSM; cada tarea nueva con su spec
// y trazado a este maestro."
//
// RELACIÓN CON LOS EXISTENTES (verificado R4, censo 2026-08-14):
//   - boot_ontology_pattern.vsm  = consolidación del BOOT (M1-M7) — capa
//     hija de este maestro; NO se duplica. RECTIFICADO 2026-08-14: de vuelta
//     en sandbox/ bajo test (prosa 72%, promoción anulada).
//   - boot_manifest.vsm          = índice de 36 artifacts del boot (M1,
//     producción) — capa hija.
//   - SYSTEM-SPEC-index          = índice de consulta de 13 rutas system/
//     (P2, open) — capa hermana, se integra aquí al existir.
//   - Este maestro = la capa SUPERIOR: cataloga, traza, detecta colisiones.
//   El maestro CLASIFICA y TRAZA (S3*); nunca reemplaza los records.

master("SYSTEM-ONTOLOGY-MASTER") {

  // ════ PROPÓSITO ════
  purpose: "Consolidar los ASPECTOS ONTOLÓGICOS del sistema (boot, notación,
      estructura, estados @status, plantillas, recursión) en un solo mapa
      orquestable: qué specs existen, qué tareas los implementan, dónde
      colisionan, y qué enmarca el VSM. Cada spec nueva se TRAZA aquí
      (spec → task → gate) para que nada quede huérfano ni duplicado.",

  // ════ ENMARQUE VSM (todo spec = órgano con recursión) ════
  vsm_frame: "
    El sistema V(vsf, L=1). Cada spec de system/ es un ÓRGANO del sistema —
    pertenece a una recursión y a un nivel (S1-S5, S3*) y se comunica por
    canales φ↑/φ↓. El maestro mapea:
      recursion:  system (L=1) → kernel (L=2, vsf-nucleus) → subsistema
      organ:      S1 ops · S2 coord · S3 control · S3* audit · S4 intel ·
                  S5 policy
      channel:    φ↑ reporte del spec al maestro · φ↓ directiva del maestro
                  al spec (vía task gate)
    Regla: toda spec nueva DECLARA su órgano y recursión en el maestro antes
    de existir como archivo — el backlog es el mapa (mandato S3).
    A4/A5: la autonomía de cada spec queda en su nivel; el maestro nunca
    ejecuta (S3* report-only).",

  // ════ CATÁLOGO DE SPECS (censo 2026-08-14, R4) ════
  catalog: [
    // ── BOOT (canon ratified) ──
    spec("boot/", recursion="system/L1", organ="S5 canónico", status="ratified",
         trace: ["boot_manifest.vsm (M1, done)", "verify_boot_ontology.py (M2, done)",
                 "BOOT-CONSOLIDATION-PLUGINS (M1-M7, in_progress)"]),
    spec("boot/boot_manifest.vsm", recursion="system/L1", organ="S5 índice",
         status="ratified", trace: ["M1 done 4b557b9b", "check boot-manifest-valid"]),
    spec("boot/covenant.vsm", recursion="system/L1", organ="S5 contrato",
         status="ratified v1.2 (control)", trace: ["ceremonia kernel post-graduación"]),
    // ── NOTACIÓN / LENGUAJE (ratified) ──
    spec("s5-policy/vsl-language/ (14)", recursion="system/L1", organ="S5 notación",
         status="ratified", trace: ["vsl_language_primer", "verify_boot_primer.py"]),
    // ── SYSTEM (ratified) ──
    // (rectificación 2026-08-14: promoción ANULADA — boot_ontology_pattern
    //  vuelve a sandbox/ bajo test; no hay entradas SYSTEM promovidas del
    //  arco boot hasta re-trabajo de compresión semántica)
    // ── SANDBOX (proposed — bajo test, promovibles) ──
    spec("sandbox/boot-ontology-pattern-v1/boot_ontology_pattern.vsm", recursion="system/L1", organ="S3 plan",
         status="proposed", trace: ["BOOT-CONSOLIDATION-PLUGINS (M1-M7)", "RECTIFICADO 2026-08-14: prosa 72%, no listo"]),
    spec("archive/measurements/restructure_survey.vsm", recursion="system/L1", organ="S3* medición",
         status="archived", trace: ["medición restructure 4 pasos, 2026-08-10",
         "ARCHIVADO 2026-08-17: degradado a archive/measurements/ (ARCHIVE-index-v1)"]),
    spec("system/kernel/kernel-map-v1/kernel_map.vsm", recursion="kernel/L2", organ="S3* censo kernel",
         status="active", trace: ["131 pub-const names, claude_review CLOSED",
         "PROMOVIDO de sandbox 2026-08-15 A5 (PROMOTE-AGENT-POLICY)"]),
    spec("archive/examples/vsm_logic_demo.vsm", recursion="system/L1", organ="S3* demo",
         status="archived", trace: ["¿puede decidirse la lógica VSM? — OWL 2 RL",
         "ARCHIVADO 2026-08-17: degradado a archive/examples/ (ARCHIVE-index-v1)"]),
    spec("sandbox/sandbox-atten-01/conformance_attenuator.vsm", recursion="system/L1", organ="S2 política",
         status="proposed", trace: ["política de directorios sandbox→system"]),
    spec("design-sources/r16-spec-v1/spec-review-arc-design.vsm", recursion="system/L1", organ="S3* arco revisión",
         status="design", trace: ["R16_impl_with_design primera instanciación (2026-08-15)",
         "SYSTEM-SPEC-index (P2, open) — spider + triage por arco",
         "promovido sandbox→design-sources 2026-08-17 (árbol de clasificación)"]),
    spec("design-sources/r16-spec-v1/learning-cycle-instruments-design.vsm", recursion="system/L1", organ="S3* ciclo",
         status="design", trace: ["R16 de los instrumentos del ciclo de aprendizaje (2026-08-16)",
         "session_learning_scan.sh + learning_stats.py + plugin learning-cycle-scan.ts",
         "LEARNING-CYCLE-NO-AUTO-TRIGGER (IR 3647b660) — auto-trigger + S4 stats",
         "promovido sandbox→design-sources 2026-08-17 (árbol de clasificación)"]),
    spec("design-sources/plan-tree-design/plan_tree_design.vsm", recursion="system/L1", organ="S3 planificación",
         status="design", trace: ["PLAN-TREE-MECHANISM-2026-08-15 (directiva rmw3: plan como árbol",
         "programable — derivado del estado real, gate anti-drift en pre-commit",
         "checks/plan-tree-valid; command vsf-plan; 2 arcos reconciliados",
         "promovido sandbox→design-sources 2026-08-17 (árbol de clasificación)"]),
    spec("design-sources/vsl-encoding-cycle-design-v1/vsl_encoding_cycle_design.vsm", recursion="system/L1", organ="S3* encoding",
         status="design", trace: ["R16 del refuerzo del ciclo de encoding VSM 1.2 (2026-08-16)",
         "VSM11-CASCADE-ENCODING — verify_encoding valida date|timestamp ISO 8601,",
         "primer self-aplica el timestamp (checks/vsl-encoding-valid)",
         "promovido sandbox→design-sources 2026-08-17 (árbol de clasificación)"]),
    spec("sandbox/vsf-instance-layer/instance_layer_proposal.vsm", recursion="system/L1", organ="S3* instancia",
         status="design", trace: ["propuesta de capa de instancias (INSTANCE-LAYER-v1)",
         "reclasificado desde spec_revision root 2026-08-17 (CLASSIFICATION-POLICY-PLAN S3:",
         "NORMA→ESPEC→INVESTIGACIÓN→sin plan→sandbox/)"]),
    spec("sandbox/exp-recursive-engine/recursive_engine.vsm", recursion="system/L1", organ="S3-R41",
         status="proposed", trace: ["experimento EXP-RECURSIVE-ENGINE",
         "motor recursivo de clasificación (concepto) — TreeOfContents.php como lógica",
         "el clasificador actual NO es recursivo (actual=\"${rel%%/*}\" — 1 nivel);",
         "el motor baja hasta la hoja con naturaleza LOCAL por nodo (muñecas rusas)",
         "primera tarea del enfoque recursivo — validar → delegar (RECURSIVE-ENGINE-VALIDATE)"]),
    spec("plan/vsf-vsl-revision/phase-spec/axis2_first_loop.spec.vsm", recursion="system/L1", organ="S4 eje axis2",
         status="active", trace: ["experimento AXIS2-FIRST-LOOP",
         "plan padre = VSF-VSL-REVISION-v1 (PH-11-SPEC SPEC-01)",
         "reclasificado spec/→plan/vsf-vsl-revision/phase-spec/ 2026-08-17 (PART III:",
         "no hay spec sin plan — los specs viven dentro del plan, en su fase)"]),
    spec("plan/vsf-vsl-revision/phase-spec/axis2_second_loop.spec.vsm", recursion="system/L1", organ="S4 eje axis2",
         status="active", trace: ["experimento AXIS2-SECOND-LOOP",
         "plan padre = VSF-VSL-REVISION-v1 (PH-11-SPEC SPEC-02)",
         "reclasificado spec/→plan/vsf-vsl-revision/phase-spec/ 2026-08-17 (PART III:",
         "no hay spec sin plan — los specs viven dentro del plan, en su fase)"]),
    spec("plan/vsf-vsl-revision/phase-spec/exp-arduino-s1.spec.vsm", recursion="system/L1", organ="S1 experimento",
         status="active", trace: ["experimento exp-arduino-s1",
         "plan padre = VSF-VSL-REVISION-v1 (PH-11-SPEC SPEC-03)",
         "reclasificado spec/→plan/vsf-vsl-revision/phase-spec/ 2026-08-17 (PART III:",
         "no hay spec sin plan — los specs viven dentro del plan, en su fase)"]),
    spec("plan/vsf-vsl-revision/phase-spec/exp-token-grounding.spec.vsm", recursion="system/L1", organ="S4 grounding",
         status="active", trace: ["experimento exp-token-grounding",
         "plan padre = VSF-VSL-REVISION-v1 (PH-11-SPEC SPEC-04)",
         "reclasificado spec/→plan/vsf-vsl-revision/phase-spec/ 2026-08-17 (PART III:",
         "no hay spec sin plan — los specs viven dentro del plan, en su fase)"]),
    spec("sandbox/system-ontology-master-v1/system_ontology_master.vsm", recursion="system/L1", organ="S3 orquesta",
         status="proposed", trace: ["ESTE documento — andamio, no ratificado (D7: solo covenant bilingüe)"]),
    // ── POLÍTICAS LOCALES DE CLASIFICACIÓN (v6 EXP-RECURSIVE-ENGINE) ──
    // Cada nivel declara SU test local (classification.local.vsm); el árbol
    // completo de spec_revision/ (30 niveles) tiene el suyo (2026-08-17).
    // El instrumento interpreta (classify.py/classification-valid delegan);
    // la política declara (R16) — sin GAPs: todo doc clasifica a su hoja.
    spec("sandbox/classification.local.vsm", recursion="system/L1", organ="S3-R41 clasificación",
         status="active", trace: ["EXP-RECURSIVE-ENGINE v6 — cada directorio declara SU test",
         "26 políticas locales añadidas 2026-08-17 (plan/ y system/ ya existían)",
         "classify.py + classification-valid delegan al motor recursivo",
         "el motor baja a la hoja: ej. hard_rules → system/boot; creative_leaps → archive/superseded"]),
    spec("design-sources/vsf-event-logging/vsf_event_logging_design.vsm", recursion="system/L1", organ="S3 orquesta",
