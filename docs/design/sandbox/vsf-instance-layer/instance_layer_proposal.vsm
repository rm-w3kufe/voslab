@status proposed
// */spec_revision/instance_layer_proposal.vsm
// PROPOSAL (non-destructive) — instance layer for VSF documentation.
// Status: proposal — NOT canonical. Lives in docs/spec_revision/ pending ratification.
// If ratified: becomes canonical structure. Non-destructive: touches no existing doc.

proposal("INSTANCE-LAYER-v1", source="VSF-VSL-WORKLIST-v1", status=proposal) = {
  non_destructive: true,

  // ── PRINCIPLE — three layers ──
  principle: "
    universal:   VSL language, axioms, theory, protocols — constitutional.
                 Ratified once; exceptionally modified thereafter.
    instance:    per-system values: dim(R), telemetry, system characteristics,
                 S1 parameters, coupling contracts, horizontal protocols.
                 Modified for each system where the model installs.
    agent:       live operational state: TASKS, ROADMAP, HANDOFF, BRIEFING,
                 RULES — belong to the agent's root, NOT to docs/.
                 They are a different layer and do not live here.
    separation:  nothing non-universal lives in the model-defining docs;
                 implementation values run on a separate rail.",

  // ── LAYER PLACEMENT ──
  layers: {
    universal: "system/ — constitutional docs, one system dir per S-function",
    instance:  "instance/ — values + coupling contracts per system installation",
    agent:     "agent root (repo root) — TASKS/ROADMAP/HANDOFF/BRIEFING/RULES
                are agent-layer, ratified as working docs, never in system/",
  },

  // ── ROOT NAMING ──
  root: {
    current:  "docs/",
    proposed: "system/  (universal) + instance/ (instance)",
    rationale: "'system/' is the proposed universal root name; 'instance/'
                the instance rail. Boot docs flatten: boot/agent_protocol/
                → boot/. Agent docs (TASKS/ROADMAP) stay at repo root —
                a distinct layer, not part of the doc tree.",
  },

  // ── PATH CONVENTION — root-agnostic paths ──
  paths: {
    current_line:   "// docs/spec/agent_protocol/vsl_core_boot_primer_v1.vsm",
    proposed_line:  "// */boot/vsl_core_boot_primer_v1.vsm",
    rationale:      "paths declared relative to the root (*). Renaming the root
                     must not require editing every document's path line.
                     Boot docs flatten: boot/agent_protocol/ → boot/.",
    root_symbol: {
      symbol:  "*",
      defined_in: "instance/instance.vsm — the config doc declares the root of the
                   specification-document tree for THIS installation",
      resolution: "instance.vsm is the configuration file; * resolves to whatever
                   the instance declares as its spec-doc root (e.g. 'system/').
                   Universal docs reference * symbolically; the instance binds * to
                   a concrete root. No universal doc carries a concrete path.",
    },
    publication:    "UNIVERSAL docs (boot/meta/theory/ramas) must be publication-safe:
                     they ship to GitHub, so no instance-bound path may appear —
                     only logical tree-relative paths (// */...). * resolves via instance.vsm.
                     instance_template/ — same rule: publication-safe, no params.
                     INSTANCE config docs (instance/) are instance-bound BY DESIGN:
                     concrete paths allowed (// instance/...). instance.vsm itself
                     also carries the validation doc reference (see validation).",
  },

  // ── FULL PROPOSED TREE (rmw3 2026-08-05) ──
  tree: {
    agent_root: {
      // reference only — agent layer, lives at repo root, NOT created in workspace
      "TASKS.vsm":      "backlog — agent layer",
      "ROADMAP.vsm":    "roadmap — agent layer",
      "HANDOFF.vsm.md": "session continuity — agent layer",
      "BRIEFING.vsf.md": "agent operating protocol — agent layer",
      "RULES.md":       "hard rules mirror — agent layer",
    },
    system: {
      boot: [
        "vsl_core_boot_primer_v1.vsm",
        "vsl_regulation_layer_v1.vsm",
        "vsl_hard_rules_v1.vsm",
        "vsl_communication_protocol.vsm",
      ],
      meta:              ["system/boot/vsl_language_primer.vsm",
                          "system/s5-policy/vsl-language/"],  // promoted 2026-08-13, replaces single vsl_language.vsm
      "s5-policy":       ["s5_policy_core.vsm", "s5_policy_annex.vsm",
                          "s5_comms_protocol.vsm", "s5_algedonic.vsm",
                          "bbh_lab_contract.vsm"],
      "s4-intelligence": ["s4_anticipation.vsm"],
      "s3-control":      ["s3_allocation.vsm"],
      "s3star-audit":    ["s3star_audit.vsm"],
      "s2-coordination": ["s2_nats.vsm"],
      "s1-operations":   ["s1_spec.vsm"],
      theory:            ["vos_core_theory.vsm", "vos_proofs.vsm",
                          "domain_validation_protocol.vsm",
                          "dynamics_choice.vsm",
                          "anticipatory_prevention.vsm", "creative_leaps.vsm",
                          "h_rest_senescence.vsm", "lagrange_reduction.vsm",
                          "s4_local_lyapunov.vsm", "seven_ideas_deep.vsm",
                          "symbiogenesis_lab.vsm", "thermal_stress.vsm",
                          "viable_compressor.vsm"],
      infra:             ["infra_ops.vsm"],
      plan:              ["plans_active.vsm"],
      spec:              ["axis2_first_loop.spec.vsm", "axis2_second_loop.spec.vsm",
                          "exp-arduino-s1.spec.vsm", "exp-token-grounding.spec.vsm"],
    },
    instance: {
      templates: {
        dir:    "instance_template/",            // releaseable templates — NO params
        root:   "instance_template/instance.template.vsm",
        s1_dir: "instance_template/s1/s1-template/",
        s1_files: [
          "instance_template/s1/s1-template/contract.template.vsm",
          "instance_template/s1/s1-template/instance.template.vsm",
        ],
        validation: "instance_template/validation.template.vsm
                      — template: full check schema, no params, publication-safe",
        publication_safe: "templates ship to GitHub — no instance-bound path",
      },
      root:     "instance/instance.vsm",      // OUR instance config — concrete paths
                                              // (VSF on n02; path line: // instance/...)
      per_s1:   "instance/s1/<s1>/",          // one folder per S1 unit
      s1_files: {
        contract: "<s1>.contract.vsm",        // horizontal coupling contract — SINGLE source
                                              // for this S1's contracts (never duplicated)
        instance: "<s1>.instance.vsm",        // per-S1 values: domain, lxc, services, topics
      },
      validation: "instance/validation.vsm — closes the configuration with a
                   machine-checkable validation pass: every template has an
                   instantiated counterpart in instance/, * resolves via
                   instance.vsm to a concrete root, all universal docs parse
                   VALID, no contract is duplicated, S1 pairs are complete.
                   Pairs with the template's validation.template.vsm (per-instance
                   check schema that each installation fills in)",
      two_track: {
        releaseable: "instance_template/ — full instance schema (root +
                      s1-template pair + validation), parameter-less,
                      publication-safe, universal across installations",
        ours:        "instance/ — OUR values: dim(R)=128, LXCs, state.db, nats, llm;
                      concrete paths allowed here (instance-bound by design);
                      validation.vsm certifies OUR closure",
        boot_ref:    "at ratification completion, boot/ references instance/instance.vsm
                      so the constitutional layer points at the precise instance it governs",
      },
    },
  },

  // ── INSTANCE LAYER STRUCTURE — one doc per recursion level ──
  instance_tree: {
    recursion: {
      rule:      "one instance doc per recursion level",
      root:      "1 doc for the root system (instance.vsm)",
      s1:        "1 folder per S1 (s1-clima/, s1-econ/, s1-bbh/); computational
                  recursion (nested containers/VMs) inside an S1 is established
                  in that S1's doc",
      ordering:  "from most general to most particular",
      nested:    "each recursive S1 carries specifications for each superior
                  recursion level",
    },
  },

  // ── CONTENT OF AN INSTANCE DOC ──
  instance_doc_content: {
    space:      "dim(R), state vector — e.g. Ω = {x ∈ ℝ¹²⁸ | Ax ≤ b}",
    telemetry:  "measured signals, channel, event types, integrity (merkle)",
    system:     "LXCs, state_db, nats, llm — substrate characteristics",
    root_decl:  "declares the spec-doc root (*) for this installation — binds the
                 universal-doc wildcard to a concrete path on this instance",
    coupling:   "horizontal coupling between instances, protocols, contracts
                 (φ↑/φ↓/ψ per core/connection_schema.json) — configured in the
                 root instance doc (instance.vsm) and per-S1 contract docs",
    s1_params:  "per-S1: domain, lxc, services, phi_up topic, coupling status",
  },

  // ── VALIDATION DOC (closes the configuration) ──
  validation_doc: {
    template: "instance_template/validation.template.vsm — check schema, NO params,
               publication-safe; lists the validations an installation must pass",
    config:   "instance/validation.vsm — OUR validation pass, machine-checkable;
               instance-bound (paths concrete)",
    checks: [
      "every template in instance_template/ has an instantiated counterpart in instance/
       (no parameter left blank)",
      "* resolves via instance.vsm root_decl to a concrete path; every universal doc
       uses // */... (no concrete path leaked into a publication-safe doc)",
      "parser: python3 scripts/vsl_parser.py <each doc> → VALID (boot/meta/theory/
       ramas/instance_template/instance/)",
      "no contract duplicated: each contract lives in exactly one place
       (instance.vsm OR s1 contract, never both)",
      "S1 pairs complete: each S1 has BOTH contract.vsm and instance.vsm",
      "contract hierarchy respected: horizontal contracts in S1, vertical contracts
       in root instance.vsm",
      "census/inventory regenerates cleanly; index.md auto-updates",
    ],
  },

  // ── CONTRACT PLACEMENT RULE (rmw3 2026-08-05) ──
  // Each contract lives in ONE place — never duplicated.
  // Location is decided by the hierarchy level of the coupling it describes.
  contracts: {
    rule:            "a contract lives in exactly one doc; no duplication",
    instance_vsm: {
      scope:         "contracts NOT tied to a specific S1",
      direction:     "couplings toward EQUAL or HIGHER hierarchy levels
                      (other instances, parent/meta-system, root system)",
      example:       "instance↔instance, instance→meta, φ↑/φ↓ root contracts",
    },
    s1_contract_vsm: {
      scope:         "contracts specific to one S1 unit",
      direction:     "HORIZONTAL couplings — external or internal systems
                      of EQUAL or LOWER hierarchy level (peer S1s, external
                      systems, nested components, coordination channels)",
      example:       "s1-clima↔sensors, s1-clima↔s1-econ (via S3 per A4),
                      s1-clima↔S2 broker channel",
      note:          "the A4 rule (no direct sibling coupling — via S3 parent)
                      constrains HOW the contract is enacted, not WHERE it lives",
    },
    spec_requirement: "the contract-placement rule itself MUST be specified in
                       the new documentation this proposal defines (contract
                       semantics are part of the instance-layer spec, not an
                       external convention)",
  },

  // ── WORKSPACE ──
  workspace: {
    proposal_lives_in: "docs/spec_revision/",
    non_destructive:   "does NOT modify existing docs or structures",
    ratification_gate: "rmw3 approval → proposal becomes canonical structure",
  },

  // ── EXECUTION STATUS (synced 2026-08-15, SPEC-REVISION-ORDER-PLAN censo) ──
  // The proposed structure is LIVE: docs/spec_revision/system/ (60+ docs:
  // boot/ ratified ×7, s1-s5 ramas, kernel/, s5-policy/ + vsl-language/ ×14,
  // s3star/domain_validation_protocol ratified) + instance/ (metasystem:
  // instance.vsm, validation.vsm, infra/, templates/) + plan/ + spec/ +
  // sandbox/ + ledger/. Ratified 2026-08-06..2026-08-14 via revision plan PH
  // phases (see compression_ledger ops + dir_schema.spec.vsm as the live
  // structural authority). PROPOSAL → EXECUTED; kept as dated record.
  execution_status: "EXECUTED — system/ + instance/ structure live since 2026-08-14
                     (directorio recursivo restructure, 29 docs moved). See
                     dir_schema.spec.vsm (category system role=system) for the
                     live classification, not this dated proposal.",
  open: [
    "what exactly does instantiating a VSM mean — needs deeper study",
    "how contract semantics encode A4 (sibling coupling via S3 parent)
     in the s1_contract_vsm direction field",
  ],
  open_note: "OPEN QUESTIONS carried to system/instance/vsf-instance-v1/instance.vsm + validation.vsm —
              resolved or tracked there; the proposal record itself is closed.",

  // ── RELATION TO EXISTING INDEXES ──
  indexes: {
    census:   "VSF-DOC-CENSUS-v1 — complete inventory (updated 2026-08-15 with progress_note)",
    worklist: "VSF-VSL-WORKLIST-v1 — translate/fuse/migrate plan (updated 2026-08-15 with progress block)",
    instance_layer: "ADDED — carries implementation values that structural
                     docs must not carry",
  },
}

⟦ /instance_layer_proposal ⟧
