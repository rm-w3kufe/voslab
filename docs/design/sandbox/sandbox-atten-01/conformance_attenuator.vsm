@status proposed
// sandbox/sandbox-atten-01/conformance_attenuator.vsm — the conformance attenuator
//
// FIRST DOCUMENT IN sandbox/. The rail itself is proposed here, rmw3 (S5)
// 2026-08-09: a place for specifications UNDER TEST, between spec_revision and
// production. Validated ⟹ promoted into a branch of system/.
//
// PLACED AS A SIBLING of system/, ¬inside it, and the reason is mechanical:
// all nine gates scan CORPUS = system/ RECURSIVELY. A sandbox inside would be
// gated as canon — blocking work in progress — or exempted, and an exemption
// inside system/ is a hole in the one property that makes system/ mean
// anything. "31 of 31 certified" would become "31 of 35, and 4 do not count".
// The precedent already holds: agent_layer, ledger and the rubric are all
// siblings. Moving it is one `git mv` if rmw3 decides otherwise.

sandbox_rail = {
  purpose:   "specifications UNDER TEST. A spec here is written in the corpus
              language and follows its conventions, but is not certified and not
              published.",
  not_gated: "the CERTIFICATION gates read system/ only. Work here does not block
              a commit and does not count toward certification.",
  but_findable: "the DEBT REGISTER reads sandbox/ too. The distinction is not
              which rail a document sits on, it is what the tool is FOR:
              certification is SCOPED, findability is not.
              A debt declared in a spec under test is still a debt, and a
              register that cannot see it recreates the backlog it exists to
              prevent. Found the moment this file was written — its four debts
              were invisible on the first run.",
  promotion: "sandbox → a branch of system/ WHEN the spec has an implementation
              that passes its own acceptance, ∧ the document passes the rubric.
              Implementation FIRST: a spec promoted on argument alone is the
              declared-¬demonstrated failure (R14) with extra steps.",
  demotion:  "a promoted spec that fails in production returns HERE, ¬to a
              backlog. The rail is bidirectional or it is a one-way ratchet.",
}

// ═══════════════════════════════════════════════════════════════════════════

instrument("ATTENUATOR") {

  // ── WHAT IT IS ──────────────────────────────────────────────────────────
  name: "CONFORMANCE ATTENUATOR. Both words carry weight:
         ATTENUATOR — the corpus's OWN word for the function, ¬a borrowed one.
           A8: |Sig(L)| ≤ |Sig(L+1)|·(1 − r). It absorbs signal so less
           reaches the level above. That is exactly what this does to a
           reviewer.
         CONFORMANCE — WHAT it attenuates. `attenuator` alone says how much
           passes and ∄ word about what. The file was first named
           `instrument`, which named the CATEGORY and ¬the thing: everything
           here is an instrument.
         Still open, rmw3 (S5) twice: 'atenuador aún tiene algo de vago'.
         The test a better name must pass: it says what is absorbed AND what
         is deliberately let through.",

  purpose: "absorb the MECHANICAL variety of the corpus so that a reviewer's
            variety is spent on MEANING.",

  restated_testably: "∀ finding class C:
                        C decidable from characters, structure or a join
                          ⟹ a component decides it, ∧ the reviewer never sees it
                        C ¬decidable
                          ⟹ the reviewer sees it, ∧ ∄ component claims it",
  // The second clause is the load-bearing one. A component that CLAIMS a class
  // it cannot decide is worse than ∄ component: the reviewer stops looking.

  // ── THE INVARIANT ───────────────────────────────────────────────────────
  invariant: "∀ component: its BLIND SPOTS are declared IN the component.
              A gate whose limits are unlisted gets trusted for what it never
              examined.",
  evidence:  "this cycle, four checks were found that COULD NOT FAIL — a
              dangling test written as `v ∉ bound ∧ v ∈ bound`, a JSON key that
              did not exist, a `grep -qv` on empty stdin returning 0, and a
              grammar gate whose parser says VALID to literal garbage. Three
              were caught before shipping. One reached a commit.",

  // ── COMPONENTS ──────────────────────────────────────────────────────────
  // FIELDS: reads ▪ decides ▪ blind ▪ blocking
  components: {

    secret_guard: {
      reads:    "staged content",
      decides:  "hex-32 token anchored to NATS context ▪ pwgen-shaped candidate
                 carrying its special INSIDE the token",
      blind:    "history. A secret removed from the tree stays in the log.",
      blocking: ⊤,
    },

    verify_encoding: {
      reads:    "∀ .vsm in spec_revision",
      decides:  "UTF-8 ▪ NFC ▪ ¬BOM ▪ ¬invisible ▪ ⟦4-field⟧ header ∧ footer
                 ▪ six pictographic ranges",
      blind:    "dash and prime discipline — ADVISORY, because a regex cannot
                 tell a closing quote from a prime",
      blocking: ⊤,
    },

    symbol_table: {
      reads:    "∀ .vsm in system/",
      decides:  "--undeclared glyph ∉ any declared alphabet ▪ non-Latin script
                 ▪ --d7 Spanish ▪ --paths explicit paths, @var both directions,
                 identifiers cited ∧ declared nowhere ▪ --density ▪ --dupes",
      blind:    "D7 detects SPANISH and nothing else — French, CJK and German
                 pass. ▪ definition-vs-citation is POSITIONAL and cannot
                 separate a declaration from a wrapped continuation.
                 ▪ orphan-line share is REPORTED, ¬gated: three discriminators
                 were built and all three put the calibration baseline at the
                 top, which is the signal absent, ¬a threshold to tune.",
      blocking: "--undeclared only",
    },

    debt_register: {
      reads:    "debt() markers in system/",
      decides:  "unique id ▪ class ∈ 6 ▪ owner ▪ body ≥ 3 words. The register is
                 DERIVED: ∄ list to maintain, ∄ second place to forget.",
      blind:    "whether the debt is being WORKED. Only that it is findable.",
      blocking: ⊤,
    },

    spec_kernel_reconcile: {
      reads:    "system/ + the kernel sources",
      decides:  "cited file exists ▪ cited line in range ▪ asserted constant ≡
                 the Rust const",
      blind:    "whether a citation points at the RIGHT line. Five versions
                 tried; each reported correct citations as stale and bred a new
                 false positive. ¬decidable from tokens.",
      blocking: ⊤,
    },

    verify_primer_closure: {
      reads:    "the boot primer",
      decides:  "∀ glyph the primer uses ∈ the alphabet the primer declares",
      blind:    "term closure — advisory, 37 false positives",
      blocking: ⊤,
    },

    verify_boot_primer: {
      reads:    "source hashes",
      decides:  "whether a source changed since the last recorded verification",
      blind:    "whether the re-reading CONCLUDED anything. --update without
                 re-reading defeats it entirely.",
      blocking: "production track only",
    },

    vsl_parser: {
      reads:    "one .vsm",
      decides:  "∄ class cleanly, TODAY — see open.tokenizer",
      blind:    "the grammar it is named for. Without --strict it accepts a
                 missing header, a missing @vsm, unbalanced braces and literal
                 garbage. With --strict, 13 of 40 CERTIFIED documents are
                 INVALID and every class is a known exception or a false
                 positive.",
      blocking: ⊥,
    },

    compression_metrics: {
      reads:    "the ledger",
      decides:  "source lines → fused lines, per operation",
      blind:    "whether the compression LOST anything",
      blocking: ⊥,
    },
  },

  // ── THE LOOP ────────────────────────────────────────────────────────────
  loop: {
    closes_at: "commit. The hook runs, a blocking component aborts, the author
                corrects, the author retries.",
    is_closed: "⊤ — demonstrated, ¬asserted. This cycle: the debt guard aborted
                a commit of mine over a citation written in declaration form;
                the script gate aborted DS over two Cyrillic letters, then over
                CJK; the secret guard aborted twice on a hash list and was
                itself corrected rather than overridden.",
    latency:   "THE DEFECT. Commit is the LATEST possible point. DS wrote 600
                lines before the reflow was measured; I wrote four templates
                before the density read. Feedback arrives after the work, so a
                finding is rework by construction.",
    open:      "run the components DURING authoring, ¬only at commit. That is
                a delivery question, ¬a new component: every one of them is
                already a command that takes a path.",
  },

  // ── WHAT NO COMPONENT DOES ──────────────────────────────────────────────
  not_covered: {
    semantics: "≈70% of what this cycle found. CPU_PRESSURE means scheduler
                pressure, ¬a temperature ratio. A formula contradicts itself two
                lines down. A gate cites a precondition already satisfied. A
                service declared dead ten weeks ago is running.",
    stance:    "this is ¬a gap to close, it is the DIVISION OF LABOUR. The nine
                components exist so reading is ¬spent on the mechanical.",
    measure:   "the number that decides whether to add a component is how much
                it LOWERS the semantic remainder, ¬how much it catches.",
  },

  // ── OPEN ────────────────────────────────────────────────────────────────
  open: {
    tokenizer: {
      what:  "the parser counts CHARACTERS where it must read STRUCTURE — it
              does not know where a string begins and ends, nor where a block
              does.",
      closes: [
        "vsl_parser: brace depth on math literals {x : L(x) ≤ τ} and
         intervals [a,b) — 4 false positives",
        "vsl_parser: label scope — Q1..Q3 as field names in sibling blocks
         read as reused labels, 6 false positives",
        "symbol_table: definition-vs-citation, rewritten THREE times and still
         unable to separate `Ax_QuasiStationary:` (a declaration inside a
         quoted block) from `D6: removing the LLM` (wrapped prose)",
        "symbol_table: quote parity, which desyncs on any line with an odd
         count and then poisons every line after it",
        "the orphan-line metric, abandoned because 'short line' cannot be
         separated from 'dense notation' without knowing what continues",
      ],
      why_it_matters: "five open items, ONE root cause. Today I write regex
              heuristics and get them wrong; with structure I would stop.",
      // VSL-TOKENIZER — CLOSED 2026-08-09. scripts/vsl/tokenizer.py, one
      // structural read shared by every tool, 8/8 selftest, and the promotion
      // criterion this rail declares was MET the hard way: it found real
      // defects nothing else could see.
      //   2 unterminated strings inside CERTIFIED documents (s3star_audit,
      //     s4_visualization) — one had LOST TEXT at fuse time and every gate
      //     stayed green for two days
      //   1 lost field key in the ledger
      // It also cost a real regression before it paid: requiring the operator
      // adjacent to the name dropped `defined` 116 → 57, because the canon
      // declares by JUXTAPOSITION (`A1   S1(L) = { V_i(L+1) }`) inside quoted
      // blocks. Measured, ¬assumed: 112 defined ▪ 24 cited-only, and D6 is now
      // defined in exactly ONE place, which is the right answer.
      // Wired: symbol_table (definition-vs-citation) + a BLOCKING
      // structure gate in the pre-commit hook, negative-tested both ways.
      residual: "label scope + the orphan metric are ¬wired yet — the tokenizer
              carries the facts they need (depth, kind), nothing consumes them",
    },

    vsi_layers_undeclared: {
      what: "VSI-L1..VSI-L4 are CITED across the corpus and DECLARED nowhere.
             vsl_language declares the CLASS `VSI-Ln` and glosses the four in
             prose; ∄ document declares the layers themselves.",
      found_by: "the tokenizer rewrite — the old positional rule read the
              prose gloss as their declaration",
      // CLOSED 2026-08-09 — the canon DECLARES them, beside VSI-Ln:
      // VSI-L1..L4 ≜ identity/covenant/channel/dialogue and INT-L1..L3 ≜
      // observe/support/escalate. First option of the two taken; the
      // members were already used as if declared, so declaring them
      // changed ∄ meaning — it made the corpus say what it meant.
      // D6-TACTICAL-UNDECLARED stays OPEN: that one is a real canon
      // decision (does D6 admit a tactical refinement?), ¬a transcription.
    },

    grammar_gate_now_blocking: {
      was: "report-only, because --strict called 13 of 40 CERTIFIED documents
            INVALID and ∄ error class gated cleanly",
      now: "BLOCKING on staged files. 1 of 48 remains and it is a REAL defect
            in a document that is rmw3's to amend.",
      what_the_13_actually_were: "every class was the GRAMMAR being narrower
            than its own canon, ¬the documents being wrong:
              7  `layer` declared as a subsystem; the corpus writes a LOCUS
                 (subsystem | level | level_span | channel)
             13  @ref fired on PROSE ABOUT @ref — inside the very document
