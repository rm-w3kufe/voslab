⟦ structural_integrity_checks | STRUCTURAL-INTEGRITY-CHECKS-v1 | vsm-1.2.1 | 2026-08-22T23:46:32Z ⟧

@vsm 1.2.1
@status active
// docs/design/sources/structural-integrity-checks-v1/structural_integrity_checks.vsm
// DESIGN: 5 structural integrity checks for operational autonomy

@purpose "Define 5 checks that ensure structural integrity of the agent layer"

context: """
  These checks address 5 gaps detected during the 2026-08-22 audit cycle:
  1. Policy propagation (GAP 1)
  2. Classification tree coverage (GAP 2)
  3. Enforcement consistency (GAP 3)
  4. Task format quality (GAP 4)
  5. Plugin behavior verification (GAP 5)
"""

checks: [
  {
    name: "task-format-valid"
    claim: "every task() in TASKS.vsm has canonical format"
    file: "checks/task-format-valid"
    verifies: [
      "status indented (2 spaces)",
      "no trailing commas",
      "unique id",
      "no duplicates"
    ]
  },
  {
    name: "classification-tree-valid"
    claim: "classification tree covers all file types"
    file: "checks/classification-tree-valid"
    verifies: [
      "all .vsm files have a rule",
      "key directories exist",
      "classification.local.vsm exists in key dirs"
    ]
  },
  {
    name: "policy-propagation-valid"
    claim: "policy changes propagate to dependent artifacts"
    file: "checks/policy-propagation-valid"
    verifies: [
      "timestamp policy propagated",
      "encoding policy propagated",
      "classification policy propagated",
      "gate consistency"
    ]
  },
  {
    name: "plugin-behavior-valid"
    claim: "plugins block/adhere as declared"
    file: "checks/plugin-behavior-valid"
    verifies: [
      "VETO plugins have enforcement",
      "advisory plugins don't throw",
      "plugin scripts exist"
    ]
  },
  {
    name: "enforcement-consistency-valid"
    claim: "enforcement is consistent between mechanisms"
    file: "checks/enforcement-consistency-valid"
    verifies: [
      "timestamp enforcement consistent",
      "plugin enforcement consistent",
      "all gates have negative control"
    ]
  }
]

implementation: """
  Each check:
  - Has a pass mode (verifies the claim)
  - Has a fail mode (negative control)
  - Is executable (chmod +x)
  - Has an R16 design header
"""

⟦ /structural_integrity_checks ⟧
