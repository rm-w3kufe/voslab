@vsm 1.2.1
@status active
// docs/design/sources/readme.vsm — ROL Y FUNCIÓN DE design-sources/.
// DECISIÓN S5 rmw3 2026-08-17 (CLASSIFICATION-POLICY-PLAN, S2):
// design-sources/ es directorio de PRIMER nivel bajo spec_revision/,
// hermano de archive/ — los design sources son VIVOS y autoridad de
// diseño (R16); archive/ es DATED RECORD citado por linaje, ¬autoridad.
// NO viven bajo system/ (no son política) ni bajo sandbox/ (no son
// propuestas sin validar — son instrumentos aprobados que corren).
// Este readme es la puerta del directorio: se lee antes de entrar.

system(readme) {

  synthesis: "design-sources/ := los DISEÑOS AUTORIZADOS de instrumentos
              que CORREN (scripts, checks, plugins, hooks). Son la
              autoridad de diseño para la implementación (R16_impl_with_design:
              instrumento interpreta, política declara; detector-first:
              el check se construye antes de que la regla se declare).
              NO son política (eso vive en system/s5-policy/) ni
              experimentos (eso vive en plan/<plan>/<fase>/).",

  structure: [
    dir("index.vsm",                 role="índice",    desc="cobertura 100% de design-sources/ — leer primero"),
    dir("certification_rubric.vsm",  role="design",    desc="rúbrica de certificación de todo doc en spec_revision (VSF-CERT-RUBRIC-v1) — instrumento de certificación"),
    dir("plugin_audit_design.vsm",   role="design",    desc="diseño del plugin de auditoría de ciclo agente (PLUGIN-AUDIT-DESIGN-v1)"),
    dir("relocate_gate_spec.vsm",    role="design",    desc="spec del gate de relocación de documentos (RELOCATE-GATE-SPEC-v1)"),
    dir("relocate_vsm_spec.vsm",     role="design",    desc="spec del hook/plugin de relocación automática @vsm 1.0→1.2 (RELOCATE-VSM-v1)"),
    // MOVED 2026-08-17 from system/s5-policy/agent-policy/design-sources/
    // (CLASSIFICATION-POLICY-PLAN S2 — son autoridad de diseño, NO política);
    // certification_rubric RELOCATED from root (S3 — instrumento de
    // certificación, vive fuera de system/ para nombrar paths: R_ref_resolution)
  ],

  policy: "
    un diseño autorizado → vive aquí con su index entry
    un diseño aún sin validar → sandbox/ (NO design-sources/)
    una regla de comportamiento → system/<órgano>/ (NO design-sources/)
    un experimento/eje de investigación → plan/<plan>/<fase>/ (NO design-sources/)
    un diseño que se retira → archive/superseded/ con index entry
    (design-sources/ = LIVE authority for R16 — nunca DATED RECORD mientras
    el instrumento corra)",

  verification: "design-sources-index-valid (BLOCKING) — cobertura 100% +
              dir-schema-valid — type DESIGN-SOURCES-readme-v1 declarado",
}

⟦ /readme ⟧