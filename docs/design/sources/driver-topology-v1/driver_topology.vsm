    map("INST-VALIDATION-01", sn="S3", driver="invariant_guard", canal="state.db + s5-alerts.db",
      note="metasystem config operada por S3; valores atados en instance"),
    map("VSF-INSTANCE-v1", sn="S3", driver="invariant_guard", canal="state.db + s5-alerts.db",
      note="metasystem config operada por S3; politica via S5 donde aplique"),
    map("VSF-INST-TPL-VALIDATION", sn="S3", driver="invariant_guard", canal="state.db",
