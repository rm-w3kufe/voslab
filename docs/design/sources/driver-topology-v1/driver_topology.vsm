    map("VSF-INST-TPL-S1-CONTRACT", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="plantilla de contrato S1"),
    map("MANIFEST-v1", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="WIP parent en s1-operations, asi lo declara dir_schema"),
    map("RESULTS-v1", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="WIP parent en s1-operations, asi lo declara dir_schema"),
    map("ROADMAP-v1", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="WIP parent en s1-operations, asi lo declara dir_schema"),
    map("ARCHITECTURE-v1", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="WIP parent en s1-operations, asi lo declara dir_schema"),
    map("PLUGIN-ARCH-POLICY-v1", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="WIP parent en s1-operations, asi lo declara dir_schema"),
    // —— S2 · driver event_coordinator · canal sigma + ruteo ——
    map("S2-NATS-01", sn="S2", driver="event_coordinator", canal="sigma + subjects NATS",
      note="coordinacion entre unidades, sin acoplo directo"),
