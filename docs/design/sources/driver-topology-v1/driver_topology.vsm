    map("S1-ECON-INSTANCE-01", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="unidad S1 econ: instancia"),
    map("VSF-INST-TPL-S1", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
