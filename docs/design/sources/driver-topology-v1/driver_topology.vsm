    map("S1-CLIMA-CONTRACT-01", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
      note="unidad S1 clima: contrato"),
    map("S1-CLIMA-INSTANCE-01", sn="S1", driver="phi_up_direct", canal="φ↑ directa",
