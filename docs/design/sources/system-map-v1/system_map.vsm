// spec/system_map.vsm — EL TEOREMA DEL MAPA: formalización del rol de system/.
// DECISIÓN S5 rmw3 2026-08-14 (b): la reflexión sobre system/ se formaliza como
// teorema — el agente que conoce su ecosistema distribuye mejor sus recursos.
// Profundización teórica: docs/design/sources/system-map-v1/system_map_paper.vsm (THEORY-SYSTEM-MAP-v1).
// Síntesis operativa: system/readme.vsm (SYSTEM-readme-v1). Este spec es la
// versión normativa: definiciones + teorema + corolarios, en notación del primer.

spec(SYSTEM-MAP) {

  scope: "docs/spec_revision/system/ + el agente que lo consulta",

  // ── Definiciones (glifos del primer: A3, A6, R7) ──────────────────────
  definitions: [
    def("D",    "árbol documental (docs/spec_revision/)"),
    def("d",    "documento; d ∈ D"),
    def("τ(d)", "TYPE del header ⟦ name | TYPE | vsm-1.0 | date ⟧ — la llave de clasificación"),
    def("σ(d)", "categoría: σ(d) ∈ C (las categorías del dir_schema)"),
    def("λ(d)", "nivel de recursión (boot=0, system/instance=1, s1..s5=2)"),
    def("w(d)", "peso del documento (tokens) — el costo de cargarlo al contexto"),
    def("A",    "agente LLM"),
    def("B(A)", "presupuesto de contexto: B(L) = min(B_tokens, B_compute, B_time)  [A3]"),
    def("M",    "el MAPA del ecosistema: síntesis + índice + estructura (M ⊆ D)"),
    def("N",    "state.db — la realidad operativa de n02"),
    def("Φ",    "correspondencia system/ → N: Φ(d) = la realidad que d describe"),
    def("C",    "subconjunto de contexto que A decide cargar: C ⊆ D"),
  ],

  // ── El teorema del mapa ─────────────────────────────────────────────────
  theorem(Thm_Map, "el agente que conoce el mapa distribuye mejor sus recursos") {

    setting: "
      A con presupuesto finito B(A) debe elegir C ⊆ D tal que Σ_{d∈C} w(d) ≤ B(A).
      M ⊂ D es el mapa del ecosistema: |M| ≪ B(A) y ∀ d ∈ D: alcanzable(M, d).",

    claim: "
      (a) Con M:  decisión de C* es O(log|D|) — búsqueda dirigida por coordenadas
                  (τ, σ, λ): A sabe dónde vive cada tipo de conocimiento.
      (b) Sin M:  decisión de C* es O(|D|) — búsqueda ciega; A no puede saber
                  qué le falta, paga búsqueda con variedad que debía usar en control.
      (c) Condición de optimalidad: Var(E(L)) ≤ Var(S3(L)) ⊕ Var(S2(L))  [A6]
                  ⟹ conocer M da a A la variedad sobre el ecosistema sin pagar
                  el costo de memoria de cargar todo D (M se carga una vez en
                  boot; el resto es on-demand por coordenadas).",

    proof: "
      Ashby (A6): la variedad del regulador debe cubrir la variedad del entorno.
      El entorno de A incluye D. Sin M, A enfrenta Var(D) entera con su sola
      capacidad; con M, el problema de selección C* se reduce a un lookup por
      (τ,σ,λ) — variedad comprimida en el mapa. La restricción de memoria (A3)
      hace que cargar D entero sea inviable ⟹ M es la única vía de alcanzar
      Var(D) ≥ necesaria sin exceder B(A). ∎",

    corollaries: [
      cor("el boot mínimo es el mapa de primer nivel: los 6 docs + manifest se
          cargan (|M_boot| ≪ B), el resto on-demand"),
      cor("la clasificación τ/σ/λ (dir_schema) ES la estructura de índices del
          mapa: conocerla ⟹ lookup O(log|D|)"),
      cor("la correspondencia Φ valida el mapa: si Φ(d) ≢ reality(N), el mapa
          miente (drift ≠ 0) y A decide mal — de ahí R7 y los checks"),
    ],
  },

  // ── El loop de correspondencia (system ↔ n02) ────────────────────────────
  correspondence: "
    system valida n02:   D_system → N      (model ≡ reality)
    n02 valida system:   N → D_system      (la realidad confirma/refuta; R7: N gana)
    estable ⟺ ∀ d ∈ system/: Φ(d) ≡ reality(N)   (drift(documentación) = 0)",

  synthesis: "system/ := map(S3,S5 → operate n02) @ Φ(n02) — correspondencia
              cibernética: doc ↔ reality se validan en loop (R7); el agente que
              conoce el mapa distribuye mejor sus recursos (A6)",
}

⟦ /system_map ⟧
