  registration: "scripts/state/pattern_registry.json → regla dep-graph (on=session.idle, consent=read-only, driver=S3)",
  consumption: "pattern-runner ejecuta la regla y publica el resultado; NUEVOS ciclos → handoff advisory (N02/N03), nunca auto-fix",
  r16_triple: {
    where_lives: "scripts/vsl/tools/dep_graph.py + regla dep-graph en pattern_registry.json",
    artifacts: "stdout JSON únicamente — instrumento read-only",
    enforcing_check: "modo allowlist interno: digests de ciclos S5-ratificados (P-DEP-CYCLE, 2026-10-15, 90 digests, commit af7f52e) — ciclo nuevo = exit 1; ausible vacío = todo falla (pre-allowlist)",
  },
  lineage: "P-EV dep-cycle_verdict aceptó el grafo como diseño (2026-10-15) — este doc formaliza su design decl (R16 P1).",
