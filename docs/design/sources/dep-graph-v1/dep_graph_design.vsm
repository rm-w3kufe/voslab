// de asumirlas (R_dep_graph); emite ciclos como handoff advisory —
// sin enforcement automático (R10: tactics, no enforcement).

dep_graph_design = {
  tool: "scripts/vsl/tools/dep_graph.py",
  problem: "las dependencias del sistema se asumían — medir el grafo import-to-import y exponer sus ciclos",
  ops: [
    "scan(roots) → aristas import→module determinísticas (regex, R10)",
    "cycles() → componentes cíclicos, salida JSON {cycles, count} a stdout (read-only, sin escritura de archivos)",
