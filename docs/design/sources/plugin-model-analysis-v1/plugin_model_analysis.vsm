// ═══════════════════════════════════════════════════════════════════════════
// ANÁLISIS REAL DEL MODELO DE PLUGINS
// Verificación: Diseño Original vs Implementación Actual (VERIFICADO R4)
// ═══════════════════════════════════════════════════════════════════════════

// RESUMEN EJECUTIVO (VERIFICADO R4)
// ═══════════════════════════════════════════════════════════════════════════
//
// El diseño original (PLUGIN-CLASS-TAXONOMY-v1) definía 5 clases de plugins.
// La implementación ACTUAL es PARCIALMENTE correcta:
//
// ✓ LO QUE SÍ ESTÁ IMPLEMENTADO:
//    - vsf-socratic-shell.ts (factory centralizado) - EXISTE
//    - socratic_engine.py (motor de evaluación) - EXISTE
//    - classify.tree.vsm (árbol de CLASSIFY) - EXISTE
//    - vsf-classify-on-write.ts (usa el shell) - FUNCIONA
//    - tool.execute.before hook (en vsf-agent-vsl-gate.ts) - FUNCIONA
//
// ✗ LO QUE FALTA:
//    - gate.tree.vsm, cycle.tree.vsm, remind.tree.vsm, observe.tree.vsm
//    - Integrar vsf-agent-vsl-gate.ts con el shell socrático
//
// ? LO QUE ESTÁ DESALINEADO:
//    - vsf-agent-vsl-gate.ts: usa tool.execute.before pero NO el shell
//    - vsf-naming-enforcer.ts: tiene veto pero NO es CLASS-GATE
//    - vsf-scripts-manifest-updater.ts: no tiene clase definida
//
// VEREDICTO: El diseño ES real e implementable, pero está INCOMPLETO.
//
// ═══════════════════════════════════════════════════════════════════════════
// PARTE 1: DISEÑO ORIGINAL (PLUGIN-CLASS-TAXONOMY-v1)
// ═══════════════════════════════════════════════════════════════════════════

diseno_original() {
  // Principios fundamentales
  principios: [
    "1. Cada plugin es instancia de exactamente una CLASE (trigger + question + authority)",
    "2. La lógica de decisión es un árbol SOCRÁTICO (AND/OR de predicados)",
    "3. El motor es model-agnostic (R10): certificación viene de evidencia estructural",
    "4. Write-time universal: el mismo motor evalúa CUALQUIER documento",
  ],

  // Las 5 clases definidas
  clases: {
    "CLASS-CLASSIFY": {
      trigger: "tool.execute.before (write/edit/create)",
      question: "¿este documento va aquí? ¿cumple su nivel?",
      authority: "advisory (S3*) — reports; never blocks",
      channel: "φ↑ (reads file before change, informs agent)",
      plugins: [
        "vsl-measure-before-write.ts (state transduction)",
        "vsl-check-on-write.ts (deviation detection at keystroke)",
        "vsl-relocate-on-write.ts (relocation motor on git mv)",
      ],
    },
    "CLASS-GATE": {
      trigger: "commit / pre-commit",
      question: "¿esto puede pasar? ¿viola R18/R16/D7?",
      authority: "BLOCKING (S3) — the only class with veto",
      channel: "φ↓ (blocks the commit; the pre-commit hook is the authority)",
      plugins: [
        "vsf-agent-vsl-gate.ts (R16/R18 write-time conformance)",
      ],
    },
    "CLASS-CYCLE": {
      trigger: "session.idle / cycle hooks",
      question: "¿el ciclo está vivo? ¿hay aprendizaje que registrar?",
      authority: "advisory (S2/S3*/S4 observability)",
      channel: "φ↑ (surfaces scan output; decision lives in the scan)",
      plugins: [
        "learning-cycle-scan.ts (session.idle → session_learning_scan.sh)",
      ],
    },
    "CLASS-REMIND": {
      trigger: "session.start / idle fail-safe",
      question: "¿falta algo declarado? (D2 fail-safe)",
      authority: "advisory (fail-safe reminder)",
      channel: "φ↑ (reminds the agent of declared state)",
      plugins: [
        "vsf-onboard-reminder.ts (boot state reminder)",
      ],
    },
    "CLASS-OBSERVE": {
      trigger: "any activation (A6 helper, not a registered plugin)",
      question: "¿quién corrió y qué pasó?",
      authority: "log-only (S5 directiva: observa y mejora)",
      channel: "φ↑ (deterministic JSONL activation record)",
      plugins: [
        "log-activation.ts (agent-plugin-log)",
      ],
    },
  },

  // Motor Socrático
  motor_socratico: {
    contrato: "python3 scripts/vsl/socratic_engine.py eval-tree <tree.vsm|tree.json> --doc-type <TYPE> [--context '<json>']",
    salida: '{"truth":"TRUE|FALSE|UNKNOWN","certified":bool,"home":"...","explain":...}',
    semantica: "type_* con sujeto vacío → UNKNOWN; ctx_has guardián del contexto; tree_home desciende en sub-árboles TRUE",
    shell_ts: ".opencode/plugins/vsf-socratic-shell.ts (socraticShell factory)",
  },
}

