      ubicacion: "scripts/vsl/classifier/socratic_engine.py",
      funcion: "Motor de evaluación de árboles VSL",
      evidencia: "find . -name 'socratic_engine.py'",
    },
    "classify.tree.vsm": {
      estado: "✓ EXISTE",
      ubicacion: ".opencode/plugins/trees/classify.tree.vsm",
      funcion: "Árbol de decisión para CLASS-CLASSIFY",
      evidencia: "ls .opencode/plugins/trees/",
    },
    "vsf-classify-on-write.ts": {
      estado: "✓ FUNCIONA",
      ubicacion: ".opencode/plugins/vsf-classify-on-write.ts",
      funcion: "Instancia de CLASS-CLASSIFY que usa el shell",
      evidencia: "head -40 .opencode/plugins/vsf-classify-on-write.ts",
      trigger: "tool.execute.after",
    },
    "vsf-agent-vsl-gate.ts": {
      estado: "✓ USA tool.execute.before",
      ubicacion: ".opencode/plugins/vsf-agent-vsl-gate.ts",
      funcion: "Gate de bash commands",
      evidencia: "grep -A 5 'tool.execute.before' .opencode/plugins/vsf-agent-vsl-gate.ts",
      trigger: "tool.execute.before",
      nota: "Pero NO usa el shell socrático",
    },
  },

  // Plugins registrados en opencode.json
  plugins_registrados: [
    "vsf-event-router.ts",
    "vsf-agent-vsl-gate.ts",
    "vsf-naming-enforcer.ts",
    "vsf-script-classify-on-write.ts",
    "vsf-scripts-manifest-updater.ts",
    "vsl-measure-before-write.ts",
    "vsl-check-on-write.ts",
    "vsl-relocate-on-write.ts",
    "vsf-classify-on-write.ts",
  ],

  // Triggers utilizados (verificados)
  triggers_verificados: {
    "tool.execute.before": [
      "vsf-agent-vsl-gate.ts (bash commands)",
    ],
    "tool.execute.after": [
      "vsf-classify-on-write.ts (.vsm files)",
    ],
    "file.write": [
      "vsf-naming-enforcer.ts (.vsm naming)",
      "vsf-script-classify-on-write.ts (scripts)",
      "vsf-scripts-manifest-updater.ts (manifest)",
    ],
    "session.idle": [
      "handlers/learning-cycle.ts",
      "handlers/session-hygiene.ts",
      "handlers/state-reconcile.ts",
    ],
    "session.start": [
      "handlers/session-init.ts",
    ],
  },

  // Autoridad implementada
  autoridad_implementada: {
    "VETO": [
      "vsf-agent-vsl-gate.ts (bash commands)",
      "vsf-naming-enforcer.ts (.vsm naming)",
    ],
    "ADVISORY": [
      "vsf-classify-on-write.ts (CLASSIFY)",
      "vsf-script-classify-on-write.ts (scripts)",
    ],
    "AUTO-UPDATE": [
      "vsf-scripts-manifest-updater.ts",
    ],
  },
}

