  gap: "TypeScript never imports Python kernel. It shells out to scripts/ instead.",
}

// ═══════════════════════════════════════════════════════════════
// 2. OPCIÓN A: CONECTAR EL KERNEL AL RUNTIME
// ═══════════════════════════════════════════════════════════════

option_a = {
  name: "Wire the kernel",
  approach: "Make TypeScript plugins call Python kernel instead of raw scripts",
  steps: [
    "1. Fix backbone path: change ../vsf/child/ → correct path to vos_kernel/backbone/",
    "2. Create CLI wrappers: vos_kernel/covenant.py → scripts/covenant_check.py (thin CLI)",
    "3. Wire RegulationLayer: register invariants from invariants.py into regulation.py",
    "4. Connect RSI bridge: RSIBridge._improve_*() → real vsf-rsi calls",
    "5. Test: each plugin → kernel module → real effect",
  ],
  pros: "Single source of truth for logic. Python kernel becomes real.",
  cons: "Complex. Two languages to maintain. PyO3 dependency still missing.",
  effort: "MEDIUM — 2-3 days focused work",
  risk: "PATH MISMATCH may hide deeper design disconnect",
}

// ═══════════════════════════════════════════════════════════════
// 3. OPCIÓN B: MIGRAR LOGICA A SCRIPTS
// ═══════════════════════════════════════════════════════════════

option_b = {
  name: "Scripts are the truth",
  approach: "Accept that scripts/vsl/*.py + system/kernel/*.py ARE the kernel",
  steps: [
    "1. Move real logic from vos_kernel/ to scripts/ (or keep where it is)",
    "2. Update check.py to import from scripts/ directly",
    "3. Create thin CLI wrappers for any module TypeScript needs",
    "4. Delete or archive vos_kernel/ scaffolding",
    "5. Document: 'kernel = scripts/ + system/kernel/'",
  ],
  pros: "Simpler. No new integration layer. Matches what actually runs.",
  cons: "Loses the clean vos_kernel/ abstraction. Two locations for logic.",
  effort: "LOW — 1 day refactoring",
  risk: "LOW — we're just formalizing what already works",
}

// ═══════════════════════════════════════════════════════════════
// 4. OPCIÓN C: REPLICA MINIMAL
// ═══════════════════════════════════════════════════════════════

option_c = {
  name: "Minimal bridge",
  approach: "Keep both layers. Add thin bridge module that TypeScript can call.",
  steps: [
    "1. Create vos_kernel/bridge_cli.py — CLI interface for kernel modules",
    "2. TypeScript plugin calls: execFile('python3', ['-m', 'vos_kernel.bridge_cli', 'covenant', file])",
    "3. bridge_cli.py imports CovenantEnforcer, calls evaluate(), outputs JSON",
    "4. Gradually migrate logic from scripts/ to kernel modules",
    "5. Keep scripts/ as fallback until kernel is proven",
  ],
  pros: "Incremental. Both layers survive. Can validate kernel piece by piece.",
  cons: "Three layers (TypeScript → bridge_cli → kernel). More moving parts.",
  effort: "MEDIUM — 1-2 days for bridge, then incremental",
  risk: "LOW — bridge is thin, easy to remove if it doesn't work",
}

