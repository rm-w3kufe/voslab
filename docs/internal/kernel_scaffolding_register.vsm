// ── SIZE LEGEND ──────────────────────────────────────────────────────────────
size_legend:
  S = "small — localized, <1 session, low risk, no re-validation"
  M = "medium — 1-2 sessions + certify on 108; may touch a paper claim"
  L = "large — multi-session, OR open research (theory undecided), OR new hardware/toolchain"

// ── ARTIFACT TAXONOMY ────────────────────────────────────────────────────────
taxonomy:
  CONSTANT    = "a compile-time constant standing in for a quantity that should be dynamic"
  SHADOW      = "computed but not used to drive state (runs alongside the canonical path)"
  PLACEHOLDER = "hand-set values marked 'calibration TBD' — not measured/derived"
  PROXY       = "a cheap approximation of a quantity with an exact definition elsewhere"
  UNWIRED     = "module built+tested but not connected to the live loop"
  UNRUN       = "experiment designed (binary exists) but not executed"
  ABSENT      = "planned arc with no code yet"

// ─── THE REGISTER (sized by reading the code 2026-06-22) ─────────────────────

