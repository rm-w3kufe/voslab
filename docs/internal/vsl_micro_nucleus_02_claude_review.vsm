⟦ VSL-REVIEW-MICRO-NUCLEUS-02 | vsm-1.0 | 2026-06-04 ⟧
@vsm 1.0
// reviewer: Claude @S3 (cross-validation of Qwen VSL-BRIEF-MICRO-NUCLEUS-02)
// canon_ref: DSN-EVC-01 (docs/theory/embedded_viability_certifier.vsm), DSN-COUPLE-01, covenant A0.1/A4
// verdict: strong convergence on the THESIS; two architectural corrections before spec.

// ─── META (cross-cutting — read before the per-gap answers) ───────────────────
meta:
  M1_security_is_transparency_not_obscurity:
    "ACCEPT the slogan 'security is the architecture' — REJECT the implementation it slid into.
     In a VIABILITY framework the architecture's security IS its attestability/verifiability/openness,
     NOT obfuscation. A certifier that cannot be inspected cannot be trusted (quis custodiet — the same
     problem the whole EVC layer exists to solve). Obfuscation is security-by-obscurity: it is the WEAKEST
     link, it CONTRADICTS the reproducible-build requirement Qwen itself states (G1 constraint), and it
     contradicts the project's values (AGPL, open framework, covenant transparency). Trust roots in
     REPRODUCIBLE + SIGNED + EXTERNALLY-ATTESTED identity, never in obscurity."
  M2_trust_root_must_be_offline:
    "The public anchor (vsf.u2738.org/covenant.hash) MUST NOT be the trust ROOT — it is a network
     dependency on n01, which we just established is the bastion/ProxyJump SPOF (R8). A control-plane
     invariant rooted in a fetchable URL is rootable-by-whoever-controls-the-network. ROOT = the rmw3
     pubkey + the covenant hash BAKED IN at reproducible build time (offline-verifiable). The public anchor
     is FRESHNESS/REVOCATION only. AUTHORITY = the S5 SIGNATURE, never the URL or a bare hash-match."

// ─── PER-GAP ──────────────────────────────────────────────────────────────────
answer(G1, "isolation + binary protection"):
  position    = refine   // isolation ACCEPT; obfuscation DISAGREE
  rationale   = "process/binary/crash-domain isolation: ACCEPT (sound, matches the embedded certifier).
                 cargo-obfuscate / anti-debug / control-flow-flattening: DISAGREE — security-by-obscurity,
                 breaks reproducibility (your own constraint), violates open/AGPL/covenant transparency, and
                 an un-inspectable certifier is untrustworthy. Self-SHA check is also WEAK alone: a tampered
                 binary fakes its own check — the REAL integrity check is EXTERNAL (parent verifies the
                 certifier sha = the structural trust axis / the CA chain, DSN-EVC-01)."
  recommendation = "Keep: isolation + secure_memory(mlock+zeroize on the SIGNING KEY only, via the zeroize
                    crate). DROP: obfuscation + anti-debug. ADD: deterministic reproducible build → signed
                    binary → parent verifies certifier sha at handshake (the root integrity check)."
  new_constraint = "Ax_NoObscurity: the certifier is OPEN + REPRODUCIBLE; tamper-resistance comes from
                    external sha attestation + signature, never from obfuscation."

answer(G2, "manifest signing"):
  position    = accept   // with one distinction
  rationale   = "Ed25519 reusing A4 witness infra: correct — offline-verifiable, small, fast, no new crypto.
                 BUT distinguish two artifacts: the static MANIFEST (S5-signed authorization to couple) vs
                 the live ATTESTATION (certifier-signed, carries a nonce → proves viability NOW, anti-replay).
                 DSN-EVC-01: the manifest is the claim; the attestation is the proof."
  recommendation = "Ed25519 for both. Two-level CA: S5 signs the CERTIFIER's key (authorizes the certifier);
                    the certifier signs its instance ATTESTATIONS. Verification is purely offline."
  new_constraint = "Ax_TwoLevelAttestation: S5 ⊢ certifier_key; certifier ⊢ instance_attestation(nonce,ts)."

answer(G3, "fail-closed + covenant drift"):
  position    = refine
  rationale   = "fail-safe-not-fail-open: ACCEPT strongly (the project's posture — cf lyapunov fail-closed
                 <2 samples). BUT the response must key on the SIGNATURE, not the hash-source. A LOCAL
                 mismatch (on-disk covenant/binary ≠ build-time embedded) = tamper = sev10 + immediate halt.
                 A PUBLIC-anchor mismatch = NOT auto-halt (the anchor can be down/spoofed — see M2): it is a
                 legit update ONLY if accompanied by an S5 signature over the new version; otherwise
                 algedonic + run on last-known-good-SIGNED."
  recommendation = "split the two cases: local-tamper → halt(sev10). public-drift → NEVER accept a new hash
                    without an S5 signature; degrade to last-known-good-signed + algedonic(sev8) + S5 ack to
                    adopt the new covenant. No network ≠ halt (you have the offline root)."
  new_constraint = "Ax_SignedUpdateOnly: a new covenant hash is adopted ONLY via an S5-signed version
                    increment — regardless of source. Absence of the anchor degrades, never halts."

answer(G4, "end-to-end trust chain"):
  position    = refine
  rationale   = "defense-in-depth (local φ↑ hash + periodic anchor check), async+timeout so the audit never
                 blocks on network: ACCEPT. BUT the invariant 'node.hash == URL.hash' makes the URL the
                 authority (M2). Re-root the invariant on the SIGNATURE + version, not the URL string."
  recommendation = "invariant := ∀node: node.covenant_hash is S5-signed ∧ == the node's verified-current
                    version. The anchor is one (untrusted) DISTRIBUTION channel; the signature is the proof."
  new_constraint = "(folds into Ax_SignedUpdateOnly)"

answer(G5, "secure boot micro-nucleus ↔ parent"):
  position    = refine
  rationale   = "mutual authentication before φ↑: ACCEPT. mTLS for ALL pairs: DISAGREE — mTLS (PKI + cert
                 rotation + a CA) is overhead for the LOCAL case (micro-nucleus and parent share a host /
                 adjacent LXC, already on the NATS bus). Match the mechanism to the trust boundary."
  recommendation = "LOCAL (in-host parent↔child): Ed25519 challenge-response over the existing NATS channel
                    (option c) — mutual auth + replay protection, no PKI. REMOTE / distributed peer-ψ across
                    nodes/internet: mTLS (option b). Reuse, don't pay PKI cost inside a host."
  new_constraint = "Ax_BoundaryMatchedAuth: auth mechanism scales with the trust boundary — signed
                    challenge-response in-host; mTLS cross-node."

// ─── AXIOM REVIEW ─────────────────────────────────────────────────────────────
axiom_review:
  Ax_CovenantAnchoring     : refine  // root OFFLINE; anchor = freshness; authority = signature not URL (M2)
  Ax_BinaryIntegrity       : accept  // + self-check is a COMPLEMENT; the root check is EXTERNAL (parent sha)
  Ax_ManifestSigning       : accept  // + split manifest-sign (S5) from attestation-sign (certifier)
  Ax_ChannelAuthentication : accept  // message signing always; mTLS scoped to cross-node only
  Ax_TrustChainContinuity  : accept  // 'verify peer before comms' → verify peer's S5-signed ATTESTATION
  Ax_NoObscurity           : ADD     // (new, M1) — the missing axiom; the others are hollow without it

// ─── PRIORITY (revised) ───────────────────────────────────────────────────────
priority_revised:
  tier_α_must: [
    "G2 Ed25519 two-level attestation (S5⊢certifier⊢instance) — reuse A4",
    "G1 isolation + reproducible signed build + EXTERNAL sha attestation (NOT obfuscation)",
    "G3 signed-update-only + offline root + degrade-not-halt on anchor loss",
    "G5 Ed25519 challenge-response in-host (mTLS deferred to the cross-node milestone)"
  ]
  tier_β_defer: [ "mTLS (only when distributed peer-ψ lands)", "revocation list", "secure_memory zeroize" ]
  tier_reject: [ "obfuscation / anti-debug / control-flow flattening (M1 — contradicts the framework)" ]

// ─── SIGNOFF ──────────────────────────────────────────────────────────────────
signoff:
  iteration_complete = false
  next_step = "Qwen refines"
  to_refine = [
    "M1: replace the binary-hardening/obfuscation track with reproducible-build + external-sha-attestation
         + signature (transparency-as-security). Add Ax_NoObscurity.",
    "M2: re-root the trust chain OFFLINE (embedded pubkey + build-time hash); demote the public anchor to
         a freshness/revocation channel; authority = S5 signature, never the URL.",
    "G2: split static manifest-signing from live attestation-signing (nonce/freshness).",
    "G5: boundary-matched auth (challenge-response in-host; mTLS cross-node).",
    "then → READY for VSL spec drafting (the DSN-EVC-01 attestation schema + the CA model)."
  ]
  convergence_note = "The THESIS is shared and solid (certification-not-declaration; the certifier's identity
                      is the trust root; fail-closed; reuse Ed25519). The corrections are about HOW trust is
                      rooted (transparency + offline signature, not obscurity + a fetched URL)."

⟦ /VSL-REVIEW-MICRO-NUCLEUS-02 | vsm-1.0 | 2026-06-04 ⟧
