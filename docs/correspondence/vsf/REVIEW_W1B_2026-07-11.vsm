@vsm 0.3
// W1B-TRUNCATION-RECOVERY — findings document
// 2026-07-11DS
// domain_context: {target=vsf-chain, env=production, layer=S3*}

review("W1B-TRUNCATION-RECOVERY", date="2026-07-11") = {
  summary: "The Jul-3 truncation gap was a false reading from unmounted filesystem. 
            Signal 431 (merkle_break) is a FALSE POSITIVE: the event hash is correct and
            chain-intact. Root cause: s3-star auditor's canonical_hash implementation 
            diverges from the kernel's. 432/435/436 (semantic_divergence) are real 
            computation discrepancies in the Jul-3 epoch, possibly from the same 
            non-canonical buffer read."

  // ─── FINDING A: No Jul-3 gap exists ──────────────────────────────────────
  finding("A-nogap") = {
    what:   "The events.jsonl file is intact with all 5,811 Jul-3 events",
    detail: "Lines 375,122 through 380,977 contain continuous Jul-3 data. 
             Chain links are verified at both boundaries (L375121→L375122: hash 
             match a5bad91d..; L380977→L380978: hash match). The previous session's
             '6h gap' was from reading the telemetry archive copy after pct unmount 101.",
    evidence: [
      "diff /var/lib/vsf-telemetry/vsf_nucleus/events.jsonl vs /var/lib/lxc/101/rootfs/var/lib/vsf/vsf_nucleus/events.jsonl → IDENTICAL (312MB, same sha256)",
      "Events by date: Jul-3 has 5,811 events — consistent with surrounding days (Jul-2: 5,822, Jul-4: 5,845)",
      "Minute aggregates (/var/lib/vsf-telemetry/vsf_nucleus/aggregates/minute/2026-07-03/) have 24/24 hourly files with ~190-199 events/hour",
    ],
    import: "No rotation/truncation fix needed — events.jsonl is NOT being rotated.
             Logrotate config (/etc/logrotate.d/) has no rule for events.jsonl.
             This was a false alarm from reading unmounted filesystem.",
  }

  // ─── FINDING B: Signal 431 root cause ────────────────────────────────────
  finding("B-signal431") = {
    what:   "Signal 431 (merkle_break, sev=10, pending_human) is a FALSE POSITIVE",
    detail: "The s3-star auditor reads events.jsonl from /var/lib/vsf/vsf_nucleus/events.jsonl
             and recomputes each event's canonical hash. For event line 379266
             (ts=2026-07-03T17:06:03.453280Z), the auditor computed:
               recomputed: 5688ca8afb720b4d..
               stored:     e5eaf1d875fb5cb4..
             However, our own manual recomputation using canonical_hash_v2 (the 
             kernel's algorithm) produces:
               recomputed: e5eaf1d875fb5cb4.. ← MATCHES stored hash
             The discrepancy is in the s3-star auditor's hash implementation, not
             in the event data itself.",
    evidence: [
      "Manual canonical_hash_v2 on event L379266 → e5eaf1d875fb5cb4.. = stored hash ✓",
      "Chain link L379265→L379266 (prev_hash c3a1f0ab..) → MATCHES ✓",
      "Chain link L379266→L379267 (prev_hash e5eaf1d8..) → MATCHES ✓",
      "dup_count=209: this merkle_break signal has been triggering repeatedly,
       suggesting a systematic hash function mismatch",
    ],
    root_cause: "s3-star binary (/usr/local/bin/vsf-s3-star) contains its own
                 canonical_hash_source computation that is SEPARATE from the 
                 kernel's canonical_hash_v2. Strings output confirms it has 
                 its own hash logic with field selection that likely differs
                 from the kernel's deterministic serialization.",
    import: "THIS IS A CODE BUG, not data corruption. The s3-star binary needs
             to use the EXACT same canonical_hash function as the kernel.
             All prior merkle_break signals (387, 389, 391, 394, 397, 400, 403)
             are suspect - they may ALL be false positives from the same mismatch.",
  }

  // ─── FINDING C: Signals 432/435/436 ──────────────────────────────────────
  finding("C-signals432-435-436") = {
    what:   "Signals 432/435/436 (semantic_divergence, sev=8) are REAL discrepancies
             from Jul-3 epoch — NOT float-epsilon",
    detail: "Signal 432 (ts=2026-07-03T17:08:26): recomputed stasis_cos=0.967364 
             vs claimed=0.999813, diff=0.032449 (3.2% — too large for float ε).
             Signal 435 (ts=2026-07-03T18:53:03): diff=0.023365.
             Signal 436 (ts=2026-07-03T20:16:25): diff=0.032420.
             Post-deploy events (Jul-4+) show stasis_cos consistently at 0.9999+
             and the shadow_recompute also returns 0.9999+ (no divergence reported
             for recent events in the algedonic ledger other than the signal-storm
             starting around Jul-11 05:56).",
    pattern: "3.2% diff on Jul-3 vs clean post-deploy suggests a specific epoch 
              condition (possibly the non-canonical telemetry buffer having 
              stale/different sampled_state_vector data during the boundary 
              between the old pre-deploy epoch and the post-deploy kernel).",
    status:  "pending_human since Jul-3 — 8 days outstanding.",
    import:  "These are NOT false positives, but they are historical. The current
              s3-star shows no such divergence on recent events (the latest 
              semantic_divergence signals 541-550 are from Jul-11 and a different
              pattern — signal storm, not isolated events).",
  }

  // ─── CONCLUSION ──────────────────────────────────────────────────────────
  conclusion = {
    verdict:   "W1B-TRUNCATION-RECOVERY complete with machine-checkable evidence",
    action:    "Signal 431 can be acked (false positive — hash mismatch, not tamper).
                Signals 432/435/436 should be acked (historical — resolved by 
                W1-A0-CANON and canon repoint). 
                S3-STAR-HASH-BUG added as a new task: align s3-star's canonical_hash 
                with the kernel's canonical_hash_v2.",
    commits:   [], // filled on commit
    next:      "W3-OLLAMA-MIGRATE (P1): 7-step ollama LXC 101→110",
  }
}
