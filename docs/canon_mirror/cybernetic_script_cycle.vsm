@vsm 1.2.1
@status proposed

// Cybernetic Cycle for New Scripts (Second-Order)
// Meta-process that governs how new scripts are created and integrated

map(CYBERNETIC-SCRIPT-CYCLE) {

  // ─── PURPOSE ───
  purpose: "Govern how new scripts are created, ensuring cybernetic reinforcement and proper coupling",

  // ─── CYCLE STEPS ───
  cycle: {
    "1_need_detection": {
      name: "Need Detection",
      questions: [
        "What problem does this solve?",
        "Is it a new problem or existing?",
        "Is there already a script that solves this?",
      ],
      output: "Problem definition + existing solutions analysis",
    },
    "2_socratic_evaluation": {
      name: "Socratic Evaluation (Priority 1)",
      questions: [
        "Is it domain-agnostic?",
        "Is it an epistemic question?",
        "Does an existing predicate/tree solve it?",
        "Can it be resolved with existing engine?",
      ],
      decision: {
        yes: "→ Use socratic-engine (add predicate/tree)",
        no: "→ Evaluate other mechanisms",
      },
      output: "Socratic-engine decision + justification",
    },
    "3_mechanism_evaluation": {
      name: "Mechanism Evaluation (If Not Socratic)",
      questions: [
        "Is it validation? → scripts/vsl/validator/",
        "Is it a plugin? → .opencode/plugins/",
        "Is it domain logic? → scripts/domains/",
        "Is it infrastructure? → scripts/shared/",
      ],
      output: "Mechanism selection + location",
    },
    "4_coupling_analysis": {
      name: "Coupling Analysis",
      questions: [
        "What does it couple with?",
        "What interfaces does it expose?",
        "What depends on it?",
      ],
      output: "Coupling diagram + interface specification",
    },
    "5_implementation": {
      name: "Implementation",
      actions: [
        "Create script following conventions",
        "Document using VSL format",
        "Add to manifest",
      ],
      output: "Implemented script + documentation",
    },
    "6_integration": {
      name: "Integration",
      actions: [
        "Hook into existing cycles",
        "Register in manifest",
        "Connect with other components",
      ],
      output: "Integrated script + connections",
    },
    "7_validation": {
      name: "Validation",
      actions: [
        "Test that it works",
        "Verify integration",
        "Measure impact",
      ],
      output: "Validation results + impact analysis",
    },
    "8_learning": {
      name: "Learning",
      questions: [
        "What worked?",
        "What didn't work?",
        "What to learn for next time?",
      ],
      output: "Learning record + improvements",
    },
    "9_improvement": {
      name: "Improvement",
      actions: [
        "Adjust detectors",
        "Improve processes",
        "Update policies",
      ],
      output: "Improved cycle + updated policies",
    },
  },

  // ─── APPLICATION TO CURRENT WORK ───
  application: {
    "1_need_detection": {
      problem: "Duplications and overlaps in scripts",
      type: "Code consolidation",
      existing_solutions: "routing_component.py (partial)",
    },
    "2_socratic_evaluation": {
      domain_agnostic: "NO — VSF-specific",
      epistemic_question: "NO — implementation question",
      existing_predicate: "NO — no consolidation tree",
      existing_engine: "PARTIAL — routing script",
      decision: "NOT socratic-engine → Evaluate other mechanisms",
    },
    "3_mechanism_evaluation": {
      is_validation: "NO",
      is_plugin: "NO",
      is_domain: "NO",
      is_infrastructure: "YES — shared code",
      decision: "scripts/shared/",
    },
    "4_coupling_analysis": {
      couples_with: "Scripts using run_once(), NATS connections",
      exposes: "General-purpose functions",
      depends_on: "Migrated scripts",
    },
  },

  // ─── REFINED PLAN ───
  refined_plan: {
    "1_use_existing_nats": {
      action: "Use vsf_nats.py instead of creating new module",
      scripts: [
        "scripts/algedonic/vsf_algedonic_subscriber.py",
        "scripts/algedonic/bbs_decisions_bridge.py",
        "scripts/state/algedonic/algedonic_pub.py",
      ],
      effort: "Low",
      impact: "Medium",
    },
    "2_create_http_mixin": {
      action: "Create HttpServerMixin for log suppression",
      scripts: [
        "scripts/algedonic/vsf_algedonic_subscriber.py",
        "scripts/audit/compliance/vsf-audit-logger.py",
      ],
      effort: "Low",
      impact: "Low",
    },
    "3_skip_task_runner": {
      action: "Skip TaskRunner — false positive",
      reason: "24 run() functions do different things",
    },
    "4_skip_domain_modules": {
      action: "Skip domain modules — not needed yet",
      reason: "Scripts are already organized by directory",
    },
  },

  // ─── LESSONS LEARNED ───
  lessons: [
    "Not all duplications are problems",
    "run() functions are not necessarily duplications",
    "Existing solutions should be used before creating new ones",
    "Socratic-engine is for epistemic questions, not implementation",
    "Cybernetic cycles need learning and improvement steps",
    "Raw TCP sockets vs nats-py are different approaches, not duplications",
    "Legacy code should be migrated to modern patterns",
    "HTTP log suppression is a real duplication — extract to mixin",
    "Async/await patterns require careful migration from synchronous code",
  ],

  // ─── REFINED EXECUTION PLAN ───
  refined_execution: {
    "1_migrate_nats": {
      action: "Migrate algedonic scripts to nats-py",
      scripts: [
        "scripts/algedonic/vsf_algedonic_subscriber.py → use nats-py ✅ COMPLETED",
        "scripts/algedonic/bbs_decisions_bridge.py → use nats-py ✅ COMPLETED",
      ],
      keep: "scripts/state/algedonic/algedonic_pub.py (already uses nats-py)",
      effort: "Medium",
      impact: "High — removes legacy code, adds resilience",
      status: "COMPLETED",
    },
    "2_create_http_mixin": {
      action: "Create HttpServerMixin for log suppression",
      scripts: [
        "scripts/algedonic/vsf_algedonic_subscriber.py → updated to use mixin ✅ COMPLETED",
        "scripts/audit/compliance/vsf-audit-logger.py → NOT YET UPDATED",
      ],
      effort: "Low",
      impact: "Low — code reuse",
      status: "PARTIALLY COMPLETED",
    },
    "3_document_learning": {
      action: "Document lessons learned",
      files: [
        "cybernetic_script_cycle.vsm → UPDATED",
        "duplication_analysis.vsm → EXISTING",
      ],
      effort: "Low",
      impact: "Medium — prevents future mistakes",
      status: "COMPLETED",
    },
  },
}

⟦ /cybernetic_script_cycle ⟧

⟦ /cybernetic_script_cycle ⟧
