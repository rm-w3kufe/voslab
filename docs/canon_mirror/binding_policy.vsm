⟦ binding_policy | POLICY-v1 | vsm-1.2.1 | 2026-10-01T11:53:17Z ⟧

@vsm 1.2.1
@status ratified



// Binding Policy for instance.vsm
// Defines which files need bindings and why

map(BINDING-POLICY) {

  // ─── PURPOSE ───
  purpose: "Define which files in system/ need bindings in instance.vsm and the criteria for inclusion",

  // ─── CRITERIA ───
  criteria: {
    mandatory: [
      {
        name: "Referenced by @var",
        description: "If a file is referenced by @var in another file, it MUST have a binding",
        example: "doc_write_gates is referenced by agent_instruments.vsm",
      },
      {
        name: "Boot artifact",
        description: "All boot/ files MUST have bindings (core_boot_primer, vsl_language, hard_rules, etc.)",
        example: "doc_core_boot_primer, doc_vsl_language, doc_hard_rules",
      },
      {
        name: "Policy document",
        description: "All policy documents MUST have bindings (s5-policy/ files)",
        example: "doc_agent_instruments, doc_agent_map, doc_write_gates",
      },
    ],
    recommended: [
      {
        name: "Theory document",
        description: "Theoretical documents SHOULD have bindings (theory-*/ files)",
        example: "doc_vos_core_theory, doc_viable_compressor",
      },
      {
        name: "Specification document",
        description: "Specification documents SHOULD have bindings (s1_spec, kernel_map, etc.)",
        example: "doc_s1_spec, doc_kernel_map",
      },
      {
        name: "Important results",
        description: "Important results SHOULD have bindings (RSI level results, etc.)",
        example: "doc_rsi_level1, doc_rsi_level2",
      },
    ],
    optional: [
      {
        name: "Classification files",
        description: "classification.local.vsm files MAY have bindings (not required)",
        example: "classification.local.vsm in each subdirectory",
      },
      {
        name: "Template files",
        description: "Template files MAY have bindings (not required)",
        example: "contract.template.vsm, instance.template.vsm",
      },
      {
        name: "readme.vsm files",
        description: "readme.vsm files MAY have bindings (not required)",
        example: "s5-policy/readme.vsm",
      },
    ],
  },

  // ─── NAMING CONVENTION ───
  naming: {
    rule: "Use descriptive names with doc_ prefix for documents, dir_ for directories, src_ for sources",
    examples: {
      document: "doc_core_boot_primer, doc_vsl_language, doc_agent_instruments",
      directory: "dir_boot, dir_vsl_language, dir_kernel",
      source: "src_relocate_gate, src_plugin_audit, src_classification_plan",
      gate: "gate_closure, gate_encoding, gate_staleness",
      state: "state_db, state_seed",
    },
  },

  // ─── ENFORCEMENT ───
  enforcement: {
    rule: "All @var references MUST resolve to bindings in instance.vsm",
    validation: "Use @gate_symbols --paths to verify no dangling references",
    exception: "VSL keywords (@status, @vsm, @param, etc.) are not references",
  },

  // ─── CURRENT STATE ───
  current_state: {
    total_bindings: 159,
    total_vsm_files: 113,
    coverage: "141%",
    notes: "More bindings than files because some files have multiple bindings (e.g., boot artifacts have both dir and doc bindings)",
  },
}
⟦ /binding_policy ⟧
