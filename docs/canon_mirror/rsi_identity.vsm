⟦ rsi_identity | IDENTITY-v1 | vsm-1.2.1 | 2026-09-04T07:18:09Z ⟧

@vsm 1.2.1
@status active

// rsi_identity.vsm — A3: Identidad del agente RSI
// Formaliza qué es RSI, su propósito, y condiciones de viabilidad.

rsi_identity {

  identity: "RSI-AGENT"
  
  purpose: "auto-mejora continua de sistemas de decisión"
  
  description: "
    RSI (Recursive Self-Improvement) es un agente que mejora
    iterativamente la precisión de modelos de decisión mediante:
    - Detección de fallos (fault detection)
    - Generación de soluciones (GA evolution)
    - Evaluación de patrones (pattern detection)
    - Ajuste de umbrales (feedback loop)
  "

  // ─── VIABILITY SET Ω(RSI) ──────────────────────────────────────
  // El agente es viable cuando todos los siguientes invariantes se cumplen.
  // Fuera de Ω → modo precaución (S5 caution).

  viability: {
    omega: "Ω(RSI) = { state : accuracy ≥ 0.7 ∧ drift ≤ 0.1 ∧ stability ≥ 0.8 }",
    
    dimensions: {
      accuracy: {
        min: 0.7,
        description: "Precisión del modelo de decisión",
        metric: "correct_predictions / total_predictions",
      },
      drift: {
        max: 0.1,
        description: "Deriva del modelo respecto a datos nuevos",
        metric: "|accuracy_new - accuracy_baseline|",
      },
      stability: {
        min: 0.8,
        description: "Estabilidad de las predicciones",
        metric: "1 - std_dev(accuracy_window)",
      },
    },
    
    margin: {
      description: "Distancia al borde de Ω — alerta antes de salir",
      threshold: 0.05,
      action: "degrade() — reducir variedad (menos mutación)",
    },
  },

  // ─── VSM LEVELS ────────────────────────────────────────────────
  // Mapeo de componentes RSI a niveles VSM (A1).

  levels: {
    S1: {
      name: "Ejecutores",
      components: ["RSIGeneticAlgorithm", "RSIFaultDetector", "RSITreeRegistry"],
      role: "Generar soluciones, detectar fallos, almacenar árboles",
    },
    S2: {
      name: "Coordinadores",
      components: ["RSIMetrics", "RSIObserver", "RSIPipeline"],
      role: "Coordinar mediciones, clasificar eventos, orquestar módulos",
    },
    S3: {
      name: "Control",
      components: ["RSIFeedbackLoop", "RSIGapDetector", "RSIPatternDetector"],
      role: "Decidir ajustes, detectar gaps, detectar patrones",
    },
    S3Star: {
      name: "Auditoría",
      components: ["RSIObserver (audit mode)"],
      role: "Auditar decisiones, detectar anomalías, escalar",
    },
    S4: {
      name: "Anticipación",
      components: ["RSIScenarioBridge", "scenario_memory", "RSIGeneticAlgorithmV2"],
      role: "Conectar scenarios, recordar soluciones, evolucionar con diversidad",
    },
    S5: {
      name: "Política",
      components: ["caution_mode", "viability_check"],
      role: "Definir identidad, activar precaución, verificar viabilidad",
    },
  },

  // ─── CHANNELS ──────────────────────────────────────────────────
  // Canales de comunicación (A2 — minimal, sin NATS aún).

  channels: {
    phi_up: "rsi.metrics.update — reportar métricas a S5",
    phi_down: "rsi.caution.activate — S5 activa modo precaución",
    lateral: "rsi.fault.detected — S1 reporta fallo a S3",
  },

  // ─── CAUTION MODE ──────────────────────────────────────────────
  // Safety mechanism (A5).

  caution: {
    trigger: "accuracy < 0.5 OR stability < 0.5",
    effect: "Suspender GA evolution, reducir exploración",
    clear: "S5 explicit clear — accuracy recovery confirmado",
  },
}

⟦ /rsi_identity ⟧
