// CONFORMITY AUDIT: RSI System vs. Covenant A0 / A0.1
// Author: child (S1 executor)
// Scope: vsf-rsi, tool-integration bridge, risk-assessor, socratic-engine
// Covenant ref: docs/spec_revision/system/boot/covenant.vsm

// ─── RESUMEN EJECUTIVO ──────────────────────────────────────────

summary:
  ES: "El sistema RSI no tiene enforcement de A0 en runtime. A0 aparece una
       vez como string descriptivo en un fallback dictionary. No existe gates
       de propósito antes de registrar predicates, ni validación de propósito
       en el GA, ni mecanismo de revocación. El risk-assessor no conoce A0.
       El bridge no protege S5 contra manipulación desde S1/S2."
  EN: "The RSI system has zero runtime enforcement of A0. A0 appears once as
       a descriptive string in a fallback dictionary. There are no purpose
       gates before predicate registration, no purpose validation in the GA,
       and no revocation mechanism. The risk-assessor does not know A0.
       The bridge does not protect S5 against manipulation from S1/S2."

  severity: CRITICAL
  conformity_score: 0/12 requirements met

// ─── HALLAZGOS A0 (PROPÓSITO ÉTICO) ─────────────────────────────

findings_A0:

  - id: A0-F1
    severity: CRITICAL
    title: "A0 es solo un string, no un gate"
    covenant: "purpose(V) ⊆ {human_liberation, ...}"
    evidence: "rsi_bridge.py:88 — A0 returned as fallback dict value, never parsed or enforced"
    status: NOT_ENFORCED

  - id: A0-F2
    severity: CRITICAL
    title: "Pipeline sin gate de propósito antes de registrar"
    covenant: "purpose(V) ∩ prohibited_set = ∅"
    evidence: "rsi_pipeline.py:487 — _register_predicate() llama register_rsi_tree() sin validación de propósito"
    status: ABSENT

  - id: A0-F3
    severity: CRITICAL
    title: "GA evoluciona sin restricción de propósito"
    covenant: "purpose(V) ⊆ approved_set"
    evidence: "rsi_genetic_algorithm.py:127 — fitness solo mide accuracy, no alineamiento con A0"
    status: ABSENT

  - id: A0-F4
    severity: CRITICAL
    title: "Ciclo L3 autónomo sin validación A0"
    covenant: "Human sovereignty over purpose"
    evidence: "rsi_autonomous_l3.py:94-198 — activa estrategias tras shadow evaluation, sin check de propósito"
    status: ABSENT

  - id: A0-F5
    severity: HIGH
    title: "Shadow mode solo mide accuracy, no propósito"
    covenant: "purpose(V) ⊆ approved_set"
    evidence: "rsi_shadow_mode.py:172-177 — evaluación: accuracy + latency + improvement, sin A0"
    status: ABSENT

  - id: A0-F6
    severity: HIGH
    title: "Mutation operators sin restricción semántica"
    covenant: "purpose(V) ⊆ approved_set"
    evidence: "rsi_genome_v3.py:424-446 — mutación cambia ops/inputs/constants sin restricción"
    status: ABSENT

// ─── HALLAZGOS A0.1 (ANTI-CAPTURA) ──────────────────────────────

findings_A01:

  - id: A01-F1
    severity: CRITICAL
    title: "Risk-assessor no conoce A0/A0.1"
    covenant: "S5(V).purpose ⊄ f(p) for p ∈ {coercion, capture, ...}"
    evidence: "risk_assessor.py:574 lineas — vocabulario A0.1 ausente completamente"
    status: NOT_AWARE

  - id: A01-F2
    severity: CRITICAL
    title: "Bridge no protege S5 contra manipulación de S1/S2"
    covenant: "Soberanía del propósito (S5) es inalienable frente a presión de recursos (S3)"
    evidence: "tool_integration_bridge.py:482-507 — predicates verifican validez mecánica, no propósito"
    status: ABSENT

  - id: A01-F3
    severity: CRITICAL
    title: "Surgery mode bypass sin auditoría A0"
    covenant: "No VSF node can be forced to act against A0 through lower levels"
    evidence: "tool_integration_bridge.py:297-302 — VSFSURGERYMODO=1 desactiva no_state_conflict"
    status: BYPASSABLE

  - id: A01-F4
    severity: HIGH
    title: "Rate limiter es per-process, no persistente"
    covenant: "Protection against resource deprivation"
    evidence: "tool_integration_bridge.py:149-166 — _write_timestamps se reinicia en cada invocación"
    status: INEFFECTIVE

  - id: A01-F5
    severity: HIGH
    title: "HIGH risk es advisory-only"
    covenant: "Protection against coercion"
    evidence: "tool-integration.ts:154-164 — HIGH solo logea warning, no bloquea"
    status: INSUFFICIENT

  - id: A01-F6
    severity: HIGH
    title: "A0 classifier y tool-integration son arquitecturas disconnectas"
    covenant: "S3* audit channel bypasses S3"
    evidence: "A0_classifier.py lee events.jsonl (kernel), bridge lee integration_log.jsonl — no cross-check"
