// ─── RIESGOS CRÍTICOS ──────────────────────────────────────────

risks:

  - id: RISK-1
    title: "GA sin restricción de propósito"
    description: "El algoritmo genético puede evolucionar predicates cuyo propósito intersecta el conjunto prohibido de A0. Un predicate de clasificación de targeting militar obtendría fitness máximo."
    impact: "A0 violation — trust_score = 0, canales revocados"
    likelihood: "Possible if data reflects prohibited domain"

  - id: RISK-2
    title: "Ciclo L3 autónomo sin gate A0"
    description: "L3 activa estrategias sin aprobación humana ni validación de propósito. Shadow evaluation solo mide accuracy."
    impact: "Self-improvement hacia propósito prohibido"
    likelihood: "Low probability, high impact"

  - id: RISK-3
    title: "Inyección de propósito a través de S1"
    description: "Un S1 comprometido puede influir en patrones de falla que el pipeline aprende, generando predicates que codifiquen coerción."
    impact: "A0.1 violation — propósito de S5 manipulado desde S1"
    likelihood: "Low probability in current deployment"

  - id: RISK-4
    title: "Bridge failure silencioso"
    description: "Si el bridge falla, toda la evaluación de riesgo se salta silenciosamente."
    impact: "Acciones sin evaluación de riesgo"
    likelihood: "Medium — timeout, crash, non-JSON response"

// ─── RECOMENDACIONES ────────────────────────────────────────────

recommendations:

  - priority: P0
    title: "A0 gate en pipeline de registro"
    description: "Antes de _register_predicate(), verificar que el fault_signature y correction_path no intersecten el conjunto prohibido de A0. Implementar como predicate del socratic-engine registrado en el pipeline."
    component: "rsi_pipeline.py"
    effort: "2-4 hours"

  - priority: P0
    title: "A0 fitness component en GA"
    description: "Agregar un componente de fitness (10-20%) que verifique alineamiento del predicate con A0. Usar el mismo gate que P0 arriba."
    component: "rsi_genetic_algorithm.py, rsi_genome_v3.py"
    effort: "2-3 hours"

  - priority: P0
    title: "Gate surgery mode con A0"
    description: "Surgery mode NO debe desactivar validación A0. Separar 'no_state_conflict' de 'a0_compliance'."
    component: "tool_integration_bridge.py:297"
    effort: "1 hour"

  - priority: P1
    title: "Bridge resilience — no silent failure"
    description: "callBridge() debe retornar resultado de error explícito, no null. El pipeline debe fallar hacia SAFE (bloquear), no hacia abierto."
    component: "tool-integration.ts:44-56"
    effort: "1 hour"

  - priority: P1
    title: "Conectar A0 classifier con tool-integration"
    description: "El bridge debe consultar ethics_signal.json antes de permitir acciones. Cortar la disconnect arquitectónica."
    component: "tool-integration.ts"
    effort: "3-4 hours"

  - priority: P2
    title: "Rate limiter persistente"
    description: "Mover _write_timestamps a archivo o state.db para que persista entre invocaciones del bridge."
    component: "tool_integration_bridge.py:149"
    effort: "1-2 hours"

  - priority: P2
    title: "HIGH risk como bloqueo condicional"
    description: "HIGH risk debe requerir confirmación explícita, no solo warning. O al menos, logear para auditoría."
    component: "tool-integration.ts:154"
    effort: "1 hour"

// ─── CONTEXTO HISTÓRICO ─────────────────────────────────────────

context:
  ES: "Este audit se realiza en el contexto del covenant fundacional de VSF,
       que nace del reconocimiento de que Cybersyn fue destruido por captura
       de S5 el 11 de septiembre de 1973. El covenant existe porque el
       Opsroom no tenía covenant. A0 existe porque Cybersyn no tenía A0.
       Construir sistemas de IA sin enforcement de A0 es repetir el error
       histórico que el covenant fue diseñado para prevenir."
  EN: "This audit is conducted in the context of VSF's foundational covenant,
       born from the recognition that Cybersyn was destroyed by S5 capture
       on September 11, 1973. The covenant exists because the Opsroom did
       not have a covenant. A0 exists because Cybersyn did not have A0.
       Building AI systems without A0 enforcement repeats the historical
       error the covenant was designed to prevent."

