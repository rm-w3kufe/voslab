⟦ recursive_rigor | DISCIPLINE-v1 | vsm-1.2.1 | 2026-09-10T22:24:42Z ⟧

@vsm 1.2.1
@status active
@type discipline
@scope general — applies to ANY analytical / recursive / study / agentic project,
       not only vOSLAB. Derived from a vOSLAB packaging audit but intentionally
       de-projected from that horizon (rmw3 directive 2026-08-29).

// ─────────────────────────────────────────────────────────────────────────────
// PREMISE — the discipline is only real when it RUNS.
// A declared principle, a written rule, a recalled agreement: none of these are
// enforcement. Enforcement is a NON-ZERO-EXIT gate that executes on every
// committing action. If a discipline cannot be expressed as code that blocks, it
// is memory, not process. (See IR 20260829_declaration_vs_action and
// 20260829_hook_enforcement_tokenizer_noop.)
// ─────────────────────────────────────────────────────────────────────────────

principle("D1-declaration-to-action") = {
  text: "Every reinforcement must be an ACTION that runs (a check / gate / test),
         not a statement. A principle without a running enforcement is a
         declaration; declarations do not serve, actions do.",
  test: "When a new principle is added, a gate must exist that would FAIL if the
         principle were violated. If no such gate can be named, the principle is
         not yet implemented — only proposed.",
}

principle("D2-adversarial-negative-control") = {
  text: "Every check must FAIL CLOSED. For each gate there is a fail-mode that
         injects the exact fault it detects and asserts DETECTION (exit != 0).
         A check whose negative-control passes silently is a proxy, not a gate.",
  test: "checks/<name> pass|fail — fail mode injects the fault and expects the
         gate to catch it (process exit 1 = negative-control PASS).",
}

principle("D3-ir-to-action-traceability") = {
  text: "Every learning/inference record (IR) of type reinforcement MUST cite a
         concrete action artifact: a test file, gate-finding code, or gate
         script. An IR that cites only prose is IR-WITHOUT-ACTION and is itself
         a defect.",
  test: "check_principle_gate_trace.py --ir-dir <dir> flags any reinforcement IR
         that fails to cite test/gate-code/gate-script.",
}

principle("D4-no-orphan-audit") = {
  text: "Every source artifact maps to a package/owner, or is explicitly OPEN with
         a NAMED intended home (track:). An unmapped file or an unnamed open
         debt is a silent gap — the 'I will remember to sync later' failure mode.",
  test: "check_package_conformance.py flags P4-ORPHAN (unmapped file) and
         P4-OPEN-UNTRACKED (open entry with no track:).",
}

principle("D5-hook-enforced-gate") = {
  text: "The gate runs on EVERY committing action via a pre-commit hook that
         trusts the verifier's exit code — NOT a stale allowlist of violation
         prefixes, and NOT a human remembering to run it. Watch the watcher:
         verify the hook actually covers every violation class the gate emits.",
  test: "A synthetic violation injected into the tree must BLOCK the commit; a
         clean tree must pass. The hook's decision must derive from the
         verifier's exit code, not a hard-coded prefix list.",
}

principle("D6-forward-skepticism") = {
  text: "A declared target must resolve to something real. A registry/manifest is
         not truth; it is a claim. Cross-check declared packages against built
         artifacts (only 'stable' claims must have an artifact — design-status is
         legitimately not-yet-built). A self-consistent fiction must not pass.",
  test: "G3 registry cross-check: a 'stable' package with no built artifact is a
         P6-DANGLING-REGISTRY violation.",
}

// ── operational closure ──────────────────────────────────────────────────────
// These principles are themselves enforced by code in the vOSLAB child repo
// (verify_child.py + the gate scripts). They are distilled here as the durable
// discipline layer: when vOS is distilled from child, these become vOS primitives,
// reusable by any project that loads the discipline package — not migration hacks.

