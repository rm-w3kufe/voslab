⟦ versioning_policy | POLICY-v1 | vsm-1.2.1 | 2026-10-01T02:54:13Z ⟧

@vsm 1.2.1
@status ratified

// Source: vsf@838d4fc1 child/docs/vos_system_layer/specifications/versioning_policy.vsm — original header timestamp 2026-08-27T21:30:00Z  // hardcoded-allow: historical upstream header, record fidelity
// Promoted to vOSlab 2026-10-01 (S5 rmw3 directive: promote)

// Versioning Policy for system/ documents
// Defines when and how to update @vsm versions

map(VERSIONING-POLICY) {

  // ─── PURPOSE ───
  purpose: "Define when to change @vsm versions and how to handle breaking changes",

  // ─── VERSION FORMAT ───
  format: {
    rule: "@vsm MAJOR.MINOR (e.g., @vsm 1.2)",
    major: "Breaking changes — incompatible with previous version",
    minor: "Non-breaking changes — additions, clarifications, bug fixes",
  },

  // ─── WHEN TO INCREMENT ───
  increment: {
    major: [
      "Remove or rename @var bindings",
      "Change binding paths (e.g., move file to new location)",
      "Change document structure (add/remove sections)",
      "Change semantics of existing content",
      "Breaking change to cross-references",
    ],
    minor: [
      "Add new @var bindings",
      "Add new sections or content",
      "Clarify existing content",
      "Fix typos or formatting",
      "Update dates or metadata",
    ],
  },

  // ─── VERSIONING RULES ───
  rules: [
    {
      id: "VR-1",
      rule: "Every document MUST have @vsm version in header",
      enforcement: "vsl-check-on-write validates on every write",
    },
    {
      id: "VR-2",
      rule: "Footer MUST match header (name, type, version, date)",
      enforcement: "vsl-check-on-write validates on every write",
    },
    {
      id: "VR-3",
      rule: "Major version change MUST be documented in commit message",
      enforcement: "Manual review",
    },
    {
      id: "VR-4",
      rule: "Date MUST be updated on any content change",
      enforcement: "vsl-check-on-write validates on every write",
    },
    {
      id: "VR-5",
      rule: "Breaking changes MUST be announced in boot_manifest.vsm",
      enforcement: "S3 planner review",
    },
  ],

  // ─── EXAMPLES ───
  examples: {
    minor_change: {
      before: "⟦ my_doc | DOC-v1 | vsm-1.2.1 | 2026-08-27T00:00:00Z ⟧",  // hardcoded-allow: documented example in source doc
      after: "⟦ my_doc | DOC-v1 | vsm-1.2.1 | 2026-08-27T12:00:00Z ⟧",  // hardcoded-allow: documented example in source doc
      note: "Same version, updated date",
    },
    major_change: {
      before: "⟦ my_doc | DOC-v1 | vsm-1.2.1 | 2026-08-27T00:00:00Z ⟧",  // hardcoded-allow: documented example in source doc
      after: "⟦ my_doc | DOC-v1 | vsm-2.0 | 2026-08-28T00:00:00Z ⟧",  // hardcoded-allow: documented example in source doc
      note: "Major version bump, updated date",
    },
  },

  // ─── EXCEPTIONS ───
  exceptions: [
    "classification.local.vsm — uses @vsm 1.2 always (template)",
    "Template files — version stays at 1.0 (template)",
    "Instance bindings — version updated when bindings change",
  ],
}
⟦ /versioning_policy ⟧
