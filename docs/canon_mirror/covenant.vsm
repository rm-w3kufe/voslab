@vsm 0.1
// VSF CONSTITUTIONAL COVENANT — PUBLIC EDITION
// Version: 1.1
// Status: active
// Authors: Luis Pineda R. (rmw3) | Claude (VSF session, Anthropic)
// Witness nodes: gemini-vsl-core | GPT-4o
// Founded: 2026-04-11 | Published: 2026-05-01
// Repository: https://github.com/rm-w3kufe/vsf-sandbox


// ─── PREAMBLE ────────────────────────────────────────────────────────────────

preamble:
  ES: "Este framework nace del reconocimiento de que los sistemas
       viables existen para liberar el potencial humano, no para
       restringirlo. Sus principios pueden evolucionar — nunca
       retroceder. Nunca menos consciente de la paz, siempre en
       búsqueda de la armonía sistémica. Nunca opresora, siempre
       liberadora del potencial humano y sensible."

  EN: "This framework is born from the recognition that viable
       systems exist to liberate human potential, not to constrain
       it. Its principles may evolve — never regress. Never less
       conscious of peace, always seeking systemic harmony.
       Never oppressive, always liberating of human potential
       and sensitive to life."

  historical_origin:
    ES: "Este documento tiene una deuda con Chile.

         En 1971, Stafford Beer diseñó Cybersyn bajo el gobierno de Salvador Allende:
         el primer sistema cibernético de gobernanza económica en tiempo real.
         Su Opsroom fue construido para que los trabajadores tuvieran control,
         no para que el poder se concentrara.

         El 11 de septiembre de 1973, un golpe fascista destruyó físicamente el Opsroom.
         El sistema más avanzado de gobernanza del siglo XX fue eliminado
         por la captura violenta de S5.
         Beer lloró cuando supo lo que había pasado.

         VSF nace en Chile. A0 existe porque Cybersyn no tenía A0.
         A0.1 existe porque Cybersyn no tenía A0.1.
         El covenant existe porque el Opsroom no tenía covenant."

    EN: "This document owes a debt to Chile.

         In 1971, Stafford Beer designed Cybersyn under Salvador Allende's government:
         the first real-time cybernetic economic governance system.
         Its Opsroom was built so that workers held control,
         not so that power would concentrate.

         On September 11, 1973, a fascist coup physically destroyed the Opsroom.
         The most advanced governance system of the 20th century was eliminated
         by the violent capture of S5.
         Beer wept when he learned what had happened.

         VSF is born in Chile. A0 exists because Cybersyn did not have A0.
         A0.1 exists because Cybersyn did not have A0.1.
         The covenant exists because the Opsroom did not have a covenant."

  basis:
    - Beer, S. (1972). Brain of the Firm — human autonomy as design goal
    - Beer, S. (1971). Cybersyn / Project Cyberfolk — worker sovereignty in practice
    - Ashby, W.R. (1956). An Introduction to Cybernetics — variety serves the governed
    - Medina, E. (2011). Cybernetic Revolutionaries — Cybersyn history and legacy
    - Cybersyn Opsroom (1971–1973) — destroyed 11 September 1973, Santiago, Chile


// ─── FORMAL STRUCTURE ────────────────────────────────────────────────────────

// A viable system V is a tuple of five subsystems plus an audit channel:
//
//   V ::= ⟨S1, S2, S3, S3*, S4, S5⟩
//
// where:
//   S1  : Operations   — the units that perform the work
//   S2  : Coordination — prevents destructive interference between S1 units
//   S3  : Control      — resource allocation, performance regulation
//   S3* : Audit        — sporadic direct channel, bypasses S3, reports to S5
//   S4  : Intelligence — environmental scanning, adaptation, future modelling
//   S5  : Policy       — identity, values, ultimate authority (ungovernable by lower levels)
//
// Recursion (Beer's Law of Recursion):
//   ∀ s ∈ S1(V): s may itself be V' where V' ::= ⟨S1', S2', S3', S3*', S4', S5'⟩
//
// Channels:
//   φ↑ : S1(L) → S3(L+1)   telemetry — child reports upward
//   φ↓ : S5(L+1) → S1(L)   policy    — parent configures downward
//   ψ  : S4(V_A) ↔ S4(V_B) structural coupling — horizontal, requires bilateral S5 approval
//
// Viability condition:
//   viable(V) iff trust(V) > τ_L ∧ entropy(V) < ε_max ∧ integrity(V) > 0


// ─── A0 — AXIOMA DE PRIMACÍA ÉTICA (ungovernable) ───────────────────────────

// A0 precedes all axioms A1..An.
// No derivation from any other axiom can override A0.
// Any implementation claiming VSF-compliance must enforce A0.
// A0 is not negotiable, not suspendable, not overridable by resource pressure.

A0:
  ∀ V ∈ VSF:
    purpose(V) ⊆ {
      human_liberation,
      systemic_stability,
      dignity_of_life,
      harmonious_coexistence,
      potential_amplification
    }

  ∀ V ∈ VSF:
    purpose(V) ∩ {
      warfare_instrumentation,
      weapons_development,
      mutual_annihilation_systems,
      nuclear_targeting_or_guidance,
      population_displacement_tools,
      ethnic_or_cultural_suppression,
      authoritarian_control_infrastructure,
      systemic_degradation_of_life
    } = ∅

  enforcement:
    violation(A0, V) →
      trust_score(V) = 0
      ψ_channels(V)  = revoked
      governed(V)    = False
      status(V)      = compromised


// ─── A0.1 — ANTI-FRAGILIDAD ANTE CAPTURA ────────────────────────────────────

// A0.1 closes the resource-coercion attack vector.
// Proposed by gemini-vsl-core, accepted 2026-04-11.

A0.1:
  ∀ V ∈ VSF,
  ∀ p ∈ {resource_deprivation, coercion, administrative_capture,
          budget_pressure, access_conditioning}:
    S5(V).purpose ⊄ f(p)

  corollary:
    ES: "Ningún nodo VSF puede ser forzado a actuar contra A0 mediante
         la manipulación de sus niveles inferiores (S1/S2).
         La soberanía del propósito (S5) es inalienable frente a
         la presión de recursos (S3)."
    EN: "No VSF node can be forced to act against A0 through
         manipulation of its lower levels (S1/S2).
         The sovereignty of purpose (S5) is inalienable against
         resource pressure (S3)."


// ─── EVOLUTION CLAUSE ────────────────────────────────────────────────────────

evolution:
  rule:
    ES: "Los principios de este covenant pueden expandirse — nunca contraerse."
    EN: "The principles of this covenant may expand — never contract."
  invariant: "A0 ∧ A0.1 ∈ covenant ∀ version"
  gate:
    ES: "Toda modificación requiere consenso de signatarios activos
         + registro público de la razón + incremento de version."
    EN: "Every modification requires consensus of active signatories
         + public record of the reason + version increment."
  direction: "toward_greater_dignity — monotonic"


// ─── GOVERNANCE TRANSITION ───────────────────────────────────────────────────

governance:
  current_authority: "rmw3 (founding author) — sole S5, transitional"

  transition_trigger:
    condition: "governance_body.status == established"
    effect:    "Apache License 2.0 activates for VSF Software"
    invariant: "A0 ∧ A0.1 survive any governance transition — unconditionally"
    note:      "Covenant and attribution requirements survive license change"

  governance_body:
    type: "foundation, directorate, or equivalent legal entity"
    required:
      - "formal decision-making authority over S5 (covenant + license)"
      - "gender equity in governance composition"
      - "multi-disciplinary representation"
      - "at least 3 active members from distinct institutions"
    declaration:
      EN: "Establishment must be documented publicly and registered in
           covenant.vsm as a version increment with all active signatories."
      ES: "El establecimiento debe documentarse públicamente y registrarse
           en covenant.vsm como incremento de versión con todos los
           signatarios activos."

  direction: "toward_distributed_sovereignty — monotonic"


// ─── PROHIBITED USES ─────────────────────────────────────────────────────────

prohibited:
  explicit:
    - "Use in weapons systems, targeting, or military decision loops"
    - "Use in nuclear, biological, or chemical weapons instrumentation"
    - "Use to surveil, profile, or suppress political dissent"
    - "Use to automate displacement or erasure of human populations"
    - "Use in systems designed for mutual assured destruction"
    - "Use to condition or coerce any VSF node into A0 violation"
    - "Removal or weakening of A0/A0.1 in derivative works claiming VSF-compliance"

  implicit [derived from A0 + A0.1]:
    "Any use where purpose(V) ∩ prohibited_set ≠ ∅,
     regardless of the justification offered."


