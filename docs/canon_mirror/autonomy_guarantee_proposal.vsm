// ═══════════════════════════════════════════════════════════════════════════
// AUTONOMY GUARANTEE — second-order cybernetic closed loop
// ═══════════════════════════════════════════════════════════════════════════
// rmw3 directive: build vsf-rsi ONLY after second-order-cybernetic autonomy is
// GUARANTEED (closed loop), not by memory. This proposal defines what
// "guaranteed" means concretely and the certification gate that must pass first.

// ── 1. DEFINITION ────────────────────────────────────────────────────────────
// A system is autonomy-GUARANTEED iff deviation from its own discipline is
// (a) DETECTED by a running gate (not by a human remembering), and
// (b) CORRECTED or ESCALATED automatically, closing the loop without a silent
//     gap. "Second-order" = the system monitors its OWN monitoring: every
//     watcher is itself watched (the observer is part of the system).

// ── 2. THE CLOSED LOOP ───────────────────────────────────────────────────────
loop("autonomy") = {
  observe:   "Every committing/deciding action emits an event (hook fires on pre-commit; session/tool events).",
  record:    "Deviations + outcomes persist as IRs / scenario records (see scenario-memory).",
  evaluate:  "verify_child.py runs the discipline gate (recursive_rigor D1-D6) and FAILS closed on any violation.",
  correct:   "On violation: block (pre-commit) OR auto-fix + re-verify. On unresolved: escalate to rmw3 (algedonic channel).",
  watch:     "A META-check asserts the watchers themselves run: adversarial negative-control on every check +
              the hook-enforcement tripwire (D5) is exercised on each commit.",
  close:     "Loop closes when an injected fault at ANY layer is caught and corrected without human recall.",
}

// ── 3. CERTIFICATION GATE (autonomy-ready) — must PASS before vsf-rsi build ──
// Each criterion is itself an ACTION (a check that exits non-zero on failure).
certify("autonomy-ready") = {
  C1_hook_enforces_all: "A synthetic violation of EVERY violation class (P4-ORPHAN, P4-DANGLING, P5-*, P6-*, TRACE, DECLARATION-WITHOUT-ACTION, IR-WITHOUT-ACTION) MUST block the commit. Verified by injecting each and asserting exit 1.",
  C2_negative_control: "Every check in checks/ has a fail-mode that injects its exact fault and is caught (process exit 1 = negative-control PASS). No check may pass silently on its own fault.",
  C3_no_silent_promise: "Every reinforcement IR cites a test/gate-code/gate-script (D3). check_principle_gate_trace.py enforces; any IR-WITHOUT-ACTION blocks.",
  C4_registry_trust:    "Only 'stable' registry packages have built artifacts (G3); a 'stable' package with no artifact is rejected. No self-consistent fiction passes.",
  C5_observation_closes: "An injected fault at the hook layer (e.g., a malformed .vsm) is caught AND corrected (auto-fix or block) with a recorded IR — demonstrably, on demand.",
  C6_scenario_learns:   "scenario-memory stores the above certifications as scenarios; a novel fault class is matched to a prior correction path (G2 of scenario-memory).",
}
// STATUS today (2026-08-29): C1 partial (hook enforces all classes — proven in
// 7c26016 — but the per-class injection drill is a manual audit, not yet an
// automated cert check). C2 done (package-conformance + principle-gate-trace).
// C3 done. C4 done (G3). C5/C6 pending (require the autonomy + scenario-memory
// build). => autonomy NOT yet certified; vsf-rsi build correctly still gated.

// ── 4. RELATION TO SCENARIO-MEMORY & recursive_rigor ─────────────────────────
// recursive_rigor.vsm (D1-D6) is the discipline the loop enforces.
// scenario-memory is the LEARNING SUBSTRATE of the loop (records + matches).
// autonomy-guarantee is the CLOSURE certification. All three must exist before
// the vsf-rsi build is authorized; without them the build would be a memory
// promise, not a guaranteed autonomous system.

// ── 5. NEXT (design-only; no code until rmw3 approves build) ─────────────────
next("autonomy-cert-check") = {
  proposal: "Add checks/autonomy-cert (C1-C6) that DRILLS each criterion on demand and exits non-zero on any failure. This is the gate that must be green before LIFECYCLE-005 build starts.",
  owner: "child (S1); approve: rmw3 S5",
}
⟦ /autonomy_guarantee_proposal ⟧
