// LOCAL POLICY OF LEVEL incidents/ — this level declares ITS OWN categories:
// born subcategories (with their own motors) are rules with home=<sub>;
// direct docs live here, home=".".

dir_classification: [

  rule("SEED-INCIDENT-REGISTER-v1", type="*INCIDENT-REGISTER-v1*", home="."),
  // contract leaf (Sep 23) — was an uncovered gap the moment this level
  // declared its own policy; INCIDENT-v1 is its own type, not the register's.
  rule("SEED-INCIDENT-SESSION-CONTRACT-v1", type="*INCIDENT-v1*", home="."),
]
