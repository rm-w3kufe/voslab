// Evidence: streak 1968, p~0.996, zero behavioral consumers (2026-10-12).

question = "should sustained high success-streak raise graduated autonomy, and streak collapse trigger caution?"

option_a = "streak-gated tiers: streak above N for M days unlocks pre-approved low-risk classes (same classes as R1 queue ritual)"
option_b = "RPE-triggered review: large negative RPE excursion pages S5 review instead of changing behavior automatically"
option_c = "no coupling: pleasure stays ledger-only narrative (status quo, defensible)"

goodhart = "once streak gates autonomy, work optimizes the streak: easy tasks first, risky tasks deferred, failures hidden. Mitigations: streak computed over ALL units incl. failures (already true), tier unlock requires S5 countersign, collapse triggers review not punishment."

asymmetry = "upward moves (more autonomy) need S5 countersign; downward moves (collapse -> review) are automatic and cheap. Matches F2 asymmetry spirit: pain auto-surfaces, pleasure never auto-acts."

proposed_gates = "IF adopted: tier unlocks only via L4 queue with S5 approve (existing machinery); collapse review via caution-signal advisory (R5 verb exists); quarterly streak-integrity audit in evolution report"

verdict = "DEFERRED TO S5: adopt (pick option), shelve with reason, or request instrumented trial"
