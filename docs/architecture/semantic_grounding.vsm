// Source: vsf@838d4fc1 child/docs/design/semantic_grounding.vsm — original header timestamp 2026-09-01T18:30:00Z  // hardcoded-allow: historical upstream header, record fidelity
// Promoted to vOSlab 2026-10-01 (S5 rmw3 directive: promote)

// PROBLEMA: Los predicados del RSI carecen de anclaje semantico
// Los arboles manipulan simbolos (ctx_equals, value, 0.7) sin saber que significan

// SOLUCION: Metadata semantica por predicado

predicate_semantics = {
  "ctx_equals($ctx, 'value', 0.7)": {
    domain: "infrastructure",
    field_description: "CPU usage percentage",
    threshold_meaning: "Critical load threshold",
    outcome_explanation: {
      "critical": "Server overload imminent",
      "warning": "High load detected",
      "ok": "Normal operation"
    },
    real_world_example: "When CPU hits 70%, the server may crash in 5 minutes",
    causal_chain: "high_cpu -> slow_response -> timeout -> service_degradation"
  }
}

// CAMBIOS NECESARIOS:

1. rsi_forest.json -> agregar semantics por branch
2. Dashboard -> mostrar descriptions, no solo symbols
3. Evolution -> track "did this predicate prevent a real incident?"
4. Fitness -> basado en impacto real, no solo accuracy numerica

// METRICA CLAVE:
// semantic_fitness = (predicciones_correctas * impacto_real) / total_evaluations
⟦ /semantic_grounding ⟧
