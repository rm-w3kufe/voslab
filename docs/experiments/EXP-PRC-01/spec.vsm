@vsm 1.0
// EXP-PRC-01 — Perturbation-channel Recovery Census (a.k.a. cyberfilter census v3)
// PRE-REGISTERED 2026-07-03 · author: Claude/Fable + rmw3 · status: FROZEN, NOT RUN.
// Applies pattern(longitudinal_cyberfilter_census) Axis-B to the paper's RETURN movement.
// Origin: census v2 (33ff910) found 0 organic excursions in stasis_cos over 18h → the
// regulated variable is the WRONG observable (EXP-S4-02); RETURN must be measured in the
// PERTURBATION CHANNEL. This spec is written BEFORE the run so the claim is a test, not a story.

experiment(EXP-PRC-01) {

  question:
    "Under ORGANIC perturbation (not injected), does the perturbation channel show an
     excursion that RETURNS while the regulated variable (stasis_cos) stays invariant —
     i.e., does the contraction demonstrably absorb organic disturbances, longitudinally?"

  motivation:
    "The RETURN evidence is NOT in stasis_cos (regulated to invariance — EXP-S4-02, re-confirmed
     longitudinally by census v2). It is in the transient of mean_l / omega.margin_free as the
     contraction absorbs a disturbance. EXP-S4-02 showed this under INJECTED stress-ng; EXP-PRC-01
     is its ORGANIC, longitudinal complement, on live operation."

  observables: {
    perturbation_drive:  "Block-B aggregate: cpu+mem+io_pressure (the disturbance INPUT)",
    response_channel:    "mean_l (Lyapunov mean; distance-from-recurrent-set) + omega.margin_free",
    regulated_control:   "stasis_cos, trust (must stay invariant — the EXP-S4-02 signature)",
  }

  perturbation_event_def:
    "a contiguous post-warmup window (tick > 15) where Block-B aggregate pressure rises above
     (run-median + δ), bracketed by baseline before and after. δ PRE-REGISTERED = 0.20.
     Organic = occurs in live operation, not injected.
     SECONDARY sources if Block-B is too quiet: (i) S3 resource-grant events to LXC 101 (the nucleus
     IS a grant target), (ii) restart boundaries (already covered by census v2 warmup = global attraction).
     If NO source yields ≥ 5 events → see null H0_1 (honest: idle environment, organic RETURN unshown)."

  hypotheses: {
    H_PRC1: "for each perturbation event, mean_l shows a transient rise then descent back to within
             ε of the pre-event baseline in a FINITE recovery time τ_r. PASS iff ≥ 80% of events
             recover with finite τ_r. Deliverable = the τ_r distribution (not a single number).",
    H_PRC2: "stasis_cos stays invariant across events (|Δstasis_cos| < 0.01) — EXP-S4-02 confirmed
             on ORGANIC disturbance, longitudinally. This is 'absorbed WITHOUT leaving', distinct
             from 'left and returned' (which census v2 showed does NOT happen organically at this scale).",
    H_PRC3: "omega.margin_free shrinks during the event and recovers → a usable early-warning signal.
             CONTINGENT on OMEGA-MARGIN-BINDING-DIAG landing (else margin_free is entropy-floored and
             this sub-hypothesis is inconclusive, report as such).",
  }

  null: {
    H0_1: "mean_l excursions do NOT return (τ_r unbounded), OR there are < 5 measurable organic
           perturbation events (environment too quiet) → organic RETURN is UNSUPPORTED from idle
           operation; report honestly, restart-recovery (census v2, 7/9, global attraction) remains
           the only in-situ evidence and injected perturbation (EXP-S4-02) covers the rest.",
    H0_2: "stasis_cos moves with perturbation (|Δ| ≥ 0.01) → EXP-S4-02 does not hold organically.",
  }

  method: {
    tool:     "scripts/analysis/cyberfilter_census.py --channel <mean_l|margin_free> — census v3;
               extend axis_b_excursions to a configurable channel (the --channel flag TODO'd in v2).
               FREEZE the analysis code with this spec commit (no post-hoc tuning of δ/ε/τ_r).",
    data:     "nucleus events.jsonl (φ↑), a window ≥ 48h pulled AFTER DS FASE-1 settles.",
    params:   { delta: 0.20, epsilon: 0.005, warmup_skip: 15, min_events: 5 },
    run_gate: "run ONLY after DS FASE-1 lands (esp. ENTROPY-SATURATION-REVIEW P2-A persist-p so the
               entropy transient stops resetting, and OMEGA-MARGIN-BINDING-DIAG so margin_free is
               informative). Pre-register NOW; run later. Do NOT run mid-batch (redeploys pollute it).",
  }

  paper_role:
    "grounds the RETURN movement of the main.tex intro arc in a longitudinal §sec:closure extension.
     PASS (H_PRC1+H_PRC2) → 'the contraction absorbs organic disturbance with the regulated variable
     held invariant, over N days' — the honest organic RETURN claim. H0 → report the limitation; only
     global-attraction (restart) evidence stands in situ, injected perturbation (EXP-S4-02) covers the
     rest. Either outcome is publishable and honest. semantic_divergence → forward-ref P_phi (DETECT)."

  honesty_guardrails: [
    "the response channel (mean_l/margin) is the RESPONSE, never confuse a Block-B spike (the drive)
     with the return (the response).",
    "report the τ_r DISTRIBUTION, not one number.",
    "distinguish 'absorbed without leaving' (stasis_cos invariant) from 'left and returned' (does not
     occur organically at this scale, per census v2) — the paper must state which it is showing.",
    "do NOT frame an idle environment (few events) as a positive result; H0_1 is a legitimate outcome.",
  ]

  status: "PRE-REGISTERED 2026-07-03 (FROZEN before run — claim discipline). NOT run. Gated on DS FASE-1."
}
