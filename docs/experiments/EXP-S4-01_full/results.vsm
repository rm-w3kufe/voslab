    h2_w_statistic: 0,
    h2_p_value: 8.15615599836228e-07,
    h2_median_paired_reduction: 41.5,
    h2_ci_lower_95: 29.0,
    h2_ci_upper_95: 51.0,
    h2_pass: true,
    h2_note: "PASS (A < B, p=0.0000 < α=0.05)",
  },

  h3_precision: {
