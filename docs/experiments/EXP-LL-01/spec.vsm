@vsm 1.0
// EXP-LL-01 — Lange-Lerner tâtonnement: convergence under VSM structure
// status: SEED — terrain prep for external collaboration (Discord, Lange-Lerner dynamics)
// created: 2026-06-28 (Opus design session, rmw3 + claude)
// origin: a Discord collaborator studies Lange-Lerner dynamics; rmw3 proposes it as the
//         socioeconomic S1 domain (ITEM_22) AND as a calibration of VSF domain-agnosticism.

⟦ spec | EXP-LL-01 | vsm-1.0 | 2026-06-28 | SEED ⟧

meta:
  title      = "Lange-Lerner tâtonnement as a VSM control loop — does VSM structure expand
                the basin of convergence?"
  status     = "LIVE — s1-econ-kernel running on LXC 113, stasis=0.999 clearing.
+                 EXP-LL-01-COPPER: real copper price feed (Yahoo Finance HG=F) replacing synthetic sine wave."
  priority   = "★★ — instantiates the ITEM_22 socioeconomic S1; second genuine S1 domain
                (alongside EXP-S1-CLIMA-01) → enables multi-S1 contention for S3-PROPORTIONAL-ALLOC"
  model      = [O]   // design Opus; execution Sonnet
  host       = "LXC 112 (s1-clima venv has numpy) for reference sim; nucleus LXC 101 for live S1"
  depends_on = [ITEM_20 (S3 resource bargain certified), EXP-S1-CLIMA-01 (sibling S1 domain pattern)]
  collaborator = "external (Discord), not yet formalized. Spec written to be a clean interface
                  they can plug their model / questions into. See §collaboration_interface."

// ── INTELLECTUAL LINEAGE (why this is native to VSF, not a stretch) ─────────────
lineage:
  chain = "Lange-Lerner (1936, theory of market socialism / socialist calculation debate)
           → Beer VSM (1972) → Cybersyn (Chile 1971, Allende — the applied attempt)
           → VSF (now)."
  claim = "VSF is a descendant of the same project: Beer built Cybersyn to OPERATIONALLY solve
           the problem Lange posed THEORETICALLY — can a central regulator govern an economy
           without markets, using only signals (price tâtonnement = negative feedback loop)?"
  hayek_as_ashby = "Hayek's knowledge-problem critique IS Ashby's Law of Requisite Variety:
                    does the regulator (CPB) have enough variety to match the variety of the
                    economy it regulates? This experiment makes the calculation debate EMPIRICAL."

// ── THE ECONOMIC MODEL ──────────────────────────────────────────────────────────
model:
  goods        = "n goods; reference case n=3 (Scarf), generalizable"
  price_vector = "p ∈ ℝⁿ_{++}, set by the CPB (S3), normalized to the simplex Σpᵢ = n"
  firms        = "each good produced by a firm/sector = one S1 unit. Lange manager rules:
                  (1) produce where P = MC  → supply qᵢˢ(pᵢ) = MCᵢ⁻¹(pᵢ);
                  (2) choose scale at min AC → plant operates at cost-minimizing output."
  demand       = "consumers (environment E) with demand qᵢᵈ(p), downward-sloping"
  excess_demand= "zᵢ(p) = qᵢᵈ(p) − qᵢˢ(p). This is the φ↑ signal (observed inventory Δ).
                  Walras' law: p·z(p) = 0. Homogeneous degree 0."
  tatonnement  = "CPB rule (Lange): ṗᵢ = kᵢ·zᵢ(p). Discrete: pᵢ(t+1) = pᵢ(t) + kᵢ·zᵢ(p(t)).
                  Raise price where excess demand > 0, lower where surplus. = negative feedback."
  equilibrium  = "p* with z(p*) = 0 (markets clear)."

  two_generators = {
    gross_substitute: "Cobb-Douglas exchange economy → aggregate excess demand has the
                       gross-substitute property → tâtonnement GLOBALLY convergent
                       (Arrow-Block-Hurwicz 1959). The 'easy' case — regulator succeeds.",
    scarf: "Scarf (1960) 3-good economy, Leontief (complementary) consumers, cyclic endowments.
            Excess demand:
              z₁ = −p₂/(p₁+p₂) + p₃/(p₃+p₁)
              z₂ = −p₃/(p₂+p₃) + p₁/(p₁+p₂)
              z₃ = −p₁/(p₃+p₁) + p₂/(p₂+p₃)
            Eq at (1,1,1). Continuous tâtonnement orbits a CLOSED CURVE forever — never
            converges (conserves a quantity on the simplex). The 'hard' case — naive
            regulator FAILS. This is the canonical socialist-calculation counterexample."
  }

// ── VSM MAPPING (the whole point: structure the economy as a viable system) ──────
vsm_mapping:
  S1 = "firms/sectors. Local viability: covering costs (pᵢ ≥ ACᵢ)? near min-AC scale?
        per-firm stasis analog = proximity to cost-minimizing equilibrium output."
  S2 = "anti-oscillation coordination. The cobweb / Scarf cycle IS an S2 failure: units
        over-respond to lagged shared signals and oscillate. S2 = model-free damping
        (EMA on z + step-size reduction on sign-flip detection). Adds dissipation →
        breaks Scarf's conservation law → drives the orbit inward."
  S3 = "the Central Planning Board. Runs the tâtonnement / price-setting = the resource
        bargain. STRUCTURALLY IDENTICAL to ITEM_20 (S3 watches stress signal, adjusts
        allocation under fixed budget). We already certified a working tâtonnement
        controller — here the commodity is goods, not CPU cores."
  S4 = "anticipation. Model-based: estimate Jacobian J(p) of excess demand, take a
        Newton-ish / trend-projected step → pre-adjusts before disequilibrium widens.
        Addresses the dynamic critique. Couples to ITEM_17 (Markov projection)."
  S5 = "policy = the Ω Doughnut (Raworth). Inner radius = social floor (essential goods'
        quantities ≥ floor); outer radius = ecological ceiling (aggregate resource use ≤
        limit). The CPB must converge to a p* whose allocation lands INSIDE Ω, not just
        any market-clearing point."

// ── HYPOTHESES ──────────────────────────────────────────────────────────────────
hypotheses:
  H_LL1 = "CORE: adding VSM structure (S2 damping ± S4 anticipation) expands the basin of
           convergence of the tâtonnement. Concretely: ∃ economies (Scarf-type) where naive
           tâtonnement (S3 only) cycles/diverges, but tâtonnement + S2 (+S4) converges to Ω.
           = 'requisite variety in the regulator stabilizes an otherwise-divergent regulator.'"
  H_LL0 = "NULL / negative control: VSM structure makes no difference to convergence (S2/S4
           are decorative), OR narrows the basin. Tested via EXP-NC pattern (ablation)."
  H_LL2 = "Ω non-convexity: the Doughnut (annulus) is non-convex, so even a contracting
           tâtonnement may converge to a market-clearing p* that sits OUTSIDE the social-just
           ring. Convergence ≠ justice. S5 must actively steer, not just clear markets."
  H_LL3 = "domain-agnosticism: the SAME machinery (Lyapunov/contraction, stasis, Ω, Fierro
           Q1-Q3) that validated the climate domain validates the economic domain — with the
           convexity assumption (Q1) genuinely STRESSED (a real calibration of the framework)."

// ── FIERRO Q1-Q3 DOMAIN VALIDATION (this is the 'calibrate our system' part) ─────
fierro_domain_validation:
  note = "The Fierro gate IS the convergence analysis. Calibrating the economic domain =
          answering the Scarf question for our specific economies. Method mirrors
          EXP-S1-CLIMA-01/fierro_q123.py exactly."
  Q1_omega_convex = "the Doughnut viability region. EXPECTED TO FAIL naive convexity (annulus).
                     Finding, not bug: economic Ω is non-convex (cf. climate's percentile box,
                     which is convex). Report convex feasible sub-region + implications."
  Q2_contraction  = "AR(1) coefficient α on distance-to-equilibrium ‖p(t)−p*‖ → λ = log(α).
                     λ<0 ⟺ converges. Scarf S3-only: λ≈0 (orbit). Scarf +S2: λ<0 (expected).
                     Gross-sub: λ<0 always. This is the headline measured result."
  Q3_sigma_max    = "max singular value of the linearized tâtonnement operator (I + k·J(p*)),
                     and of the S2/S4-augmented operators. σ_max<1 ⟺ local stability."

// ── EXECUTION MATRIX ──────────────────────────────────────────────────────────────
matrix:
  rows = [gross_substitute, scarf]
  cols = [S3_only, S3+S2, S3+S2+S4]
  measure_each = [converges?, steps_to_ε, λ (Q2), σ_max (Q3), lands_in_Ω? (S5)]
  headline = "cell[scarf, S3_only] = cycles; cell[scarf, S3+S2] = converges → H_LL1 confirmed
              if the transition holds."

// ── NEGATIVE CONTROLS (EXP-NC discipline) ───────────────────────────────────────
negative_controls:
  NC1 = "shuffle z signs randomly → S2 damping should NOT manufacture spurious convergence."
  NC2 = "S2 with β=0 (no memory) must reduce to naive S3 (no free lunch from relabeling)."
  NC3 = "gross-sub economy with VSM structure must not converge SLOWER than naive (structure
          is not allowed to hurt the easy case beyond a small constant)."

// ── COLLABORATION INTERFACE (terrain prep) ──────────────────────────────────────
collaboration_interface:
  what_vsf_contributes = "the cybernetic/structural lens: the calculation debate reframed as a
                          requisite-variety + Lyapunov-basin experiment; working VSM-layered
                          tâtonnement; Fierro calibration machinery; live φ↑/φ↓ on the nucleus."
  what_we_need_from_them = [
    "What specifically do they study? (convergence/stability · information requirements ·
     market comparison · intertemporal/capital accumulation?)",
    "Do they have a model/tool already? (agent-based · ODE system · notebook?) → decides
     whether VSF wraps their model or we co-build.",
    "Collaboration shape: VSF lens onto THEIR paper · joint simulations · new co-authored work?",
  ]
  plug_points = "econ.py exposes economy generators (excess_demand callable) + a tatonnement
                 driver with toggleable S2/S4. A collaborator drops in their own excess_demand(p)
                 and inherits the full VSM analysis + Fierro gate for free."

// ── PHASES ──────────────────────────────────────────────────────────────────────
phases:
  P0 = "THIS SESSION: spec + reference simulator (langelerner.py) + first Fierro Q1-Q3 on both
        economies × {S3, S3+S2}. Demonstrate the Scarf cycle → VSM convergence transition."
  P1 = "S5 Ω Doughnut: define social-floor / ecological-ceiling, test H_LL2 (convergence vs justice)."
  P2 = "Wire as live S1 on the nucleus: emit φ↑ in VSF event format (like CLIMA), so S3
        (LXC 101) regulates it via the certified resource bargain. Second S1 domain online."
  P3 = "S4 anticipation (couple ITEM_17 Markov). Multi-S1 contention with CLIMA → exercise
        S3-PROPORTIONAL-ALLOC (the safety-margin bargain) for real."
  P4 = "(if collaboration formalizes) integrate collaborator's economy/questions; consider paper."

// ── OPEN QUESTIONS ──────────────────────────────────────────────────────────────
open_questions:
  q1 = "Which S2 damping is most 'Beer-faithful' (model-free) vs which S4 is most faithful
        (model-based)? EMA+sign-flip for S2, Jacobian-Newton for S4 are first choices."
  q2 = "Is Walras-law normalization (simplex projection) part of S2 or a pre-S1 invariant?"
  q3 = "How to render the social-floor/ecological-ceiling in price/quantity space such that
        Q1 convexity is meaningfully tested (not trivially passed/failed)?"
  q4 = "Incentive problem (why would S1 managers truthfully report MC?) — out of scope for
        the dynamical experiment, but a real Hayek critique; note for the collaborator."

⟦ end spec | EXP-LL-01 ⟧
