@vsm 1.0
// EXP-LL-01 — P0 calibration findings (Fierro Q2/Q3 on the economic domain)
// run: 2026-06-28, LXC 113 (s1-econ), numpy 1.24.2, SEED=7
// ref: docs/experiments/EXP-LL-01/spec.vsm · raw: ll01_results.json

⟦ findings | EXP-LL-01 | P0 | 2026-06-28 ⟧

setup:
  host       = "LXC 113 (s1-econ) — distinct crash-domain from LXC 112 (s1-clima)"
  method     = "numéraire formulation (pin pₙ=1) → reduced (n−1)² Jacobian non-singular;
                Newton equilibrium finder + spectral analysis well-posed (the simplex-renorm
                first cut gave z(p*)=1.7 — a broken equilibrium; numéraire fixed it to z(p*)≈0)"
  economies  = { scarf: "z(p*)=0 at p*=(1,1,1)", gross_substitute: "z(p*)=2e-14, Cobb-Douglas" }

results_matrix:
  // converged? · basin (200 random starts) · σmax (Q3) · λ (Q2)
  scarf = {
    S3_only: { converged: false, basin: "0%",   sigma_max: 1.0003, verdict: "spirals out — Scarf counterexample reproduced" }
    S3+S2:   { converged: false, basin: "0%",   sigma_max: 1.0000, gamma: 0.9, verdict: "model-free PD damping insufficient (stays on the margin)" }
    S3+S4:   { converged: true,  basin: "100%", sigma_max: 0.9000, verdict: "model-based Newton rescues completely" }
  }
  gross_substitute = {
    S3_only: { converged: true,  basin: "100%", sigma_max: 0.9563, verdict: "converges unaided (easy case, as theory predicts)" }
    S3+S2:   { converged: false, basin: "0%",   sigma_max: 1.1437, gamma: 0.1, verdict: "PD damping DESTABILIZES the easy case — NC3 confirmed" }
    S3+S4:   { converged: true,  basin: "100%", sigma_max: 0.8000, verdict: "converges" }
  }

headline:
  H_LL1 = "CONFIRMED with discrimination: VSM structure expands the basin (Scarf 0%→100%),
           but specifically via S4 (model-based anticipation), NOT S2 (model-free damping).
           This is stronger than 'structure helps' — it says WHICH structure wins the
           calculation debate: a MODEL of the economy, i.e. genuine requisite variety."
  H_LL3 = "CONFIRMED: the Fierro Q2/Q3 machinery (λ contraction, σmax spectral) transferred
           UNCHANGED from the climate domain to the economic domain → domain-agnosticism."
  NC3   = "FIRED (a real effect): S2 PD damping made the already-contracting gross-sub economy
           DIVERGE (σmax 0.956→1.144). Structure is not free; the wrong structure hurts."

hayek_lange_reading:
  "Naive price-groping (S3) fails on complementary-goods economies (Scarf). Model-free
   anti-oscillation (S2) is not enough and can backfire. Only when the regulator carries a
   model of the economy's structure (S4 = requisite variety) does central price-setting
   converge. Lange needs Hayek's knowledge encoded as S4, not just faster tâtonnement."

caveats:
  s2_mechanism = "the NEGATIVE S2 result is for the SPECIFIC mechanism tested (PD/derivative
                  damping, γ swept). A different model-free S2 (e.g. symplectic/midpoint
                  integration, or variety-attenuating aggregation) might do better. See
                  spec §open_questions q1. Do NOT over-read as 'S2 is useless'."
  q1_deferred  = "Q1 (Ω convexity) deferred to P1 — needs the Doughnut definition. The annulus
                  is non-convex (H_LL2), so convergence≠justice is the P1 question."

next = "P1: define Ω Doughnut (social floor / ecological ceiling), test H_LL2 (does a
        market-clearing p* land inside the just ring?). P2: wire live s1-econ daemon emitting
        φ↑ on the nucleus + coupling_registry (DSN-COUPLE-01) → second S1 for S3 contention."

⟦ end findings | EXP-LL-01 | P0 ⟧
