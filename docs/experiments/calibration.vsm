@vsm 1.0
// calibration.vsm — CANONICAL registry of empirically-calibrated kernel constants (E→C loop).
// Human/registry mirror of projects/vsf-nucleus/src/calibration.rs (the code source of truth).
// domain_context: {target=vsf-nucleus, env=calibration, layer=S3}
// date: 2026-06-02 | rule: every confirmed experiment constant has ONE home + a known consumer;
//        heuristics are flagged with the loop that would confirm them. See execution_plan.vsm Part 4.

registry:
  // name              value     source_EXP    consuming_module(s)                      status
  VIABLE_THRESHOLD:   "0.70   | (definitional) | sv.viable, calibration helpers          | confirmed"
  THETA_PSI:          "0.79   | EXP-TP-01      | reframe.rs, lyapunov(recert), s4.rs, vr | confirmed"
  THETA_PSI_UPPER:    "0.9377 | EXP-CA-01      | (paper §6; unwired)                      | confirmed"
  BASIN_FLOOR:        "0.875  | EXP-AB-01+MC-01| calibration::within_resilience_envelope  | confirmed (worst-case; MC-01 vol≈1.0, rand-dir floor 0.945)"
  RESILIENCE_MARGIN:  "0.175  | EXP-AB-01      | (= BASIN_FLOOR − VIABLE_THRESHOLD)        | confirmed (worst-case; rand-dir ≈0.245)"
  DIP_FLOOR:          "0.942  | EXP-TC-01/NC   | algedonic signature                      | confirmed"
  TAU_REC:            "50t    | EXP-TC-01      | reframe DEFAULT_TAU_REC (τ_recert=2·τ)   | confirmed"
  VR_EPSILON_COSINE:  "0.30   | EXP-TDA-01     | vr_complex.rs                            | confirmed"
  VR_PERSIST_FLOOR:   "0.05   | EXP-TDA-01     | scripts/tda/tda_calibrate.py             | confirmed"
  D_EFF:              "3.00   | EXP-SB-01      | (active-dim heuristic; NOT KY-dim)       | confirmed"
  LAMBDA_MAX:         "-0.01005| EXP-LY-01     | (rigorous λ_max=ln(0.99); point sink)    | confirmed"
  TRUST_TAU_THRESHOLD:"0.20   | EXP-TRUST-01   | coupling Cor_4 / VSI L3                  | HEURISTIC"
  LYAP_R_CORE:        "0.20   | EXP-LYAP-CERT  | lyapunov.rs (was 0.50; μ_L0.146+conserv) | confirmed"
  LYAP_DRIFT_BAND:    "1e-3   | EXP-LYAP-CERT  | lyapunov.rs (3σ_ΔL floor=1.1e-3)         | confirmed"

dedup_done_2026-06-02:
  "θ_PSI was a literal 0.79 in reframe.rs AND s4.rs → now both reference crate::calibration::THETA_PSI.
   VR_EPSILON_COSINE, DEFAULT_TAU_REC, LYAP_R_CORE/DRIFT_BAND likewise single-sourced. basin_floor
   0.875 / margin 0.175 (EXP-AB-01) now HAVE A HOME + a helper (within_resilience_envelope) — its live
   consumer (anomaly-vs-envelope check on a REAL stasis_cos) lands with deep_wiring W1."

invariant: "code (calibration.rs) is the source of truth; this doc is the human mirror. A new confirmed
            experiment → add a row here + a const there + name the consuming module. A heuristic graduating
            to confirmed → flip status + cite the run. Mirrors coupling_registry (declarative, one home)."

ordering: "VIABLE 0.70 < θ_PSI 0.79 < BASIN_FLOOR 0.875 < θ_PSI_UPPER 0.9377 < DIP_FLOOR 0.942"

⟦ /calibration | vsm-1.0 | 2026-06-02 ⟧
