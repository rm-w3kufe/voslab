@vsm 1.0
// narrator_calibration.vsm — CHECO CH.d reference data for the Qwen narrator.
// Measured results from LXC 108, 2026-06-20. Read by ch_d_narrator.py as context.
// Anti-circularity: all values are measured OUTPUT, never tuned inputs.

⟦ checo-narrator-calibration | rmw3+claude | vsm-1.0 | 2026-06-20 ⟧

// ── Envelope profiles (from checo_whatif subcommand + tests) ─────────────────

envelope_occupation: {
  description: "Direct occupation state displacement (p→uniform). s=magnitude∈[0,1].",
  measured: [
    { s: 0.0,  min_cos_fixed: 1.0000, min_cos_ema: 1.0000, recovery_ticks: 0,  viable: true },
    { s: 0.3,  min_cos_fixed: "~0.999", min_cos_ema: "~0.999", recovery_ticks: "<53", viable: true },
    { s: 1.0,  min_cos_fixed: 0.9972, min_cos_ema: 0.9976, recovery_ticks: 53, viable: true },
  ],
  always_recovers: true,
  interpretation: "Occupation injection shifts ~4/128 dims (Block D). Shallow excursion; rapid recovery.",
}

envelope_w4b_sustained: {
  description: "Sustained W4b thermal pressure (kT_eff=1+γ·p, γ=1.0). p=magnitude∈[0,1], 2000-tick hold.",
  measured: [
    { p: 0.0,  min_cos_fixed: 1.0000 },
    { p: 0.5,  min_cos_fixed: 0.9995 },
    { p: 1.0,  min_cos_fixed: 0.9990 },
  ],
  sweep_span: 0.001,   // flat curve — W4b moves only 12/128 dims
  always_recovers: true,
  interpretation: "W4b shifts Block B (cpu/budget) + Block D (organelles). Very shallow excursion.",
}

hardware_thermal_reference: {
  value:   0.9377,
  source:  "EXP-CA-01 critical_angle — REAL hardware (CPU temp sensor, worker threads)",
  alt_d:   "MECHANISM-SPECIFIC — not reproducible offline (R10). The gap (0.0595–0.0613) is structural:
            W4b moves 12/128 dims; real hardware stress displaced trust ring + stasis embeddings + occupation
            simultaneously over sustained load. This is a DESIGN PROPERTY, not a model deficiency.",
  use_in_narration: "Always mention when contextualising model vs real-system comparison.",
}

// ── Narrative anchors (semantic mappings for scenarios) ──────────────────────

scenario_mapping: {
  "pérdida de capacidad cómputo / CPU saturado":   { type: "w4b",        magnitude: [0.7, 1.0] },
  "pico de entropía / caos informacional":          { type: "occupation", magnitude: [0.8, 1.0] },
  "stress moderado / carga normal alta":            { type: "w4b",        magnitude: [0.4, 0.6] },
  "perturbación leve / ruido":                      { type: "occupation", magnitude: [0.1, 0.3] },
  "fallo catastrófico / colapso total":             { type: "occupation", magnitude: 1.0         },
  "stress térmico real (hardware)":                 { note: "use hardware_thermal_reference 0.9377, not model" },
}

// ── Interpreter notes ─────────────────────────────────────────────────────────

interpreter_notes: {
  always_viable:     "All tested perturbation classes stay viable (cos > θ_PSI=0.79) throughout.",
  globally_contracting: "The attractor ALWAYS pulls the system back — no escape exists by design (λ_max<0).",
  gap_framing:       "The gap to 0.9377 is honest: the offline model characterises its own domain;
                      the real-hardware envelope requires live measurement (EXP-CA-01).",
  model_claim:       "The CHECO forward model correctly predicts: (a) the system always recovers,
                      (b) the excursion depth for synthetic perturbation classes,
                      (c) the recovery time in ticks.",
}

