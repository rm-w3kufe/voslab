// ═══════════════════════════════════════════════════════════════════════════════
// PART 4 — CALIBRATION REGISTRY  (the E→C mechanism — 'incorporate into the work cycle')
// ═══════════════════════════════════════════════════════════════════════════════

calibration_registry:
  problem:  "empirical constants are hardcoded + duplicated (θ_PSI=0.79 in reframe.rs AND s4.rs;
             basin_floor 0.875 confirmed but consumed NOWHERE). Results don't flow into code systematically."
  proposal: "a single source — docs/experiments/calibration.vsm (and/or a state.db `calibration` table) —
             one row per confirmed constant: {name, value, source_EXP, consuming_modules, status}.
             Modules reference it (or a generated constants.rs) instead of scattered literals. Mirrors the
             coupling_registry pattern (declarative contract in state.db)."
  seed_rows:
    "θ_PSI            = 0.79   ← EXP-TP-01   → reframe.rs, s4.rs, vr_complex(recert)   [confirmed]
     θ_PSI_upper      = 0.9377 ← EXP-CA-01   → (unused; paper)                          [confirmed]
     basin_floor      = 0.875  ← EXP-AB-01   → (TARGET: algedonic margin)               [confirmed,unwired]
     resilience_margin= 0.175  ← EXP-AB-01   → (TARGET: omega proximity)                [confirmed,unwired]
     dip_floor        = 0.942  ← EXP-TC-01   → algedonic signature                      [confirmed]
     tau_rec          = 50t    ← EXP-TC-01   → reframe DEFAULT_TAU_REC                   [confirmed]
     vr_epsilon       = 0.30   ← EXP-TDA-01  → vr_complex VR_EPSILON_COSINE             [confirmed]
     vr_persist_floor = 0.05   ← EXP-TDA-01  → tda_calibrate                            [confirmed]
     D_eff            = 3.00   ← EXP-SB-01   → (sanity bound)                            [confirmed]
     trust_tau_thresh = 0.20   ← EXP-TRUST-01→ coupling Cor_4                            [HEURISTIC]
     lyap_r_core      = 0.50   ← EXP-LYAP-CERT→ lyapunov.rs                              [HEURISTIC]"
  value: "closes the E→C loop: every confirmed experiment result has ONE home and a known consumer;
          heuristic rows are visibly flagged as 'needs a loop'. Directly serves the T→C→E→L saturation."

