      }
      fidelity_computed: 1.0    // H7: PASS
      brief_bytes:       455    // H8_bytes: PASS (5.7% of 8000)
      latency_s:         278    // H8_latency: FAIL (23× baseline)
      llm_ok:            true   // ONLY COMPLETE RESPONSE in bi27mh1ot run ✓
      structure_ok:      true
      interpreted: {
        summary:   "truncated: 'contains detailed information on ethical vigilance, including watchdogs and performance metrics'"
