        classification:  "UNRELIABLE for VSF-domain content with 1.5b model"
      }
      interpreted_cybersyn_mapping: {
        T2: "watchdog→S3 (ref: S5) WRONG; performance_metrics→S4 CORRECT"
        T3: "truncated + domain-wrong"
        finding: "S3/S5 distinction (control vs. governance) requires domain understanding.
