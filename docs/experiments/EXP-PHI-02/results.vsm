      fidelity_computed: 1.0    // H7: PASS
      brief_bytes:       494    // H8_bytes: PASS (6% of 8000)
      latency_s:         330    // H8_latency: FAIL (27× baseline)
      llm_ok:            false  // response truncated mid-JSON by num_predict=150
      interpreted_partial: {
        summary:   "partial: 'The VSF document: events.jsonl analysis reveals 136 lines...'"
