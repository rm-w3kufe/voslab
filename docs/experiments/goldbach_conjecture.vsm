⟦ goldbach_conjecture | EXPERIMENT-v1 | vsm-1.2.1 | 2026-09-30T14:36:38Z ⟧

@vsm 1.2.1
@status active

// GOLDBACH CONJECTURE — epistemic stress test (real reasoning session)
// Statement: every even integer n >= 4 is a sum of two primes.
// Motivation: the 6-state lattice (UNKNOWN/DECLARED/OBSERVED/CERTIFIED/
// INTERPRETIVE/REFUTED) was BUILT for claims like this and had never been
// stressed with an actual theorem. This document runs the conjecture
// through it honestly: computation, routing, and the demarcation question.

// ─── THE EXPERIMENT (machine evidence, this host, 2026-09-30T14:36:38Z) ──────────────────
experiment: {
  bound_N: 10000000,
  evens_checked: 4999999,
  counterexamples: 0,
  hardest: "n=3807404 required smallest prime p=751 (Goldbach comet structure)",
  method: "bytearray sieve (1.3s, 664579 primes) + per-n early-break",
  timing_s: 21.2,
  evidence: "state/epistemic/reports/goldbach_evidence_10M.json",
  evidence_sha256: "58af695c0dca7b12df7830569b75dc373ee48aadbf38b46ac5c51c3e03985813",
  hl_samples: "r(n) scales ~linearly with n modulated by the singular series: "
    "6e6 (divisible by 3) shows 2.83x the representations of 4e6 vs ~3.0x "
    "predicted by (p-1)/(p-2) factors; absolute normalization carries "
    "convention uncertainty (ordered vs unordered, singular series) — the "
    "comparison is recorded INTERPRETIVE, not certified"
}

// ─── EPISTEMIC DECOMPOSITION (the actual test) ─────────────────────────────
// C1 theorem    checkable=none falsifier=true  -> route R2 ceiling OBSERVED, status DECLARED (no evidence yet)
// C2 number     checkable=machine              -> route R1, status OBSERVED, evidence hash-bound, value 10000000 IN evidence
// C3 interpret. ceiling INTERPRETIVE           -> route R3, can never ascend to CERTIFIED (validate_claim enforces)
// C4 adversarial: same claim asserted CERTIFIED carrying a FOREIGN identity
//    cert (belongs to the epistemic plan doc) — the probe; outcome below.
claims_structure: "see adjacent goldbach_conjecture.claims.vsm (C1..C4)"

// ─── FINDINGS (the probe found a real hole — FND-EP-CERT-LINKAGE-01) ───────
// Pre-fix result: audit_artifact returned ok=true, errors=[] for C4 as
// CERTIFIED. Neither layer refused it:
//   - validate_claim only enforces the interpretation->CERTIFIED ceiling;
//   - audit_claim checked cert EXISTENCE and verdict, but never claim_id
//     linkage nor cert CLASS;
//   - route_claim merely REPORTS required_certs=[FORMAL,PREDICATE] —
//     advisory output, never compared against what the claim asserts.
// Consequence: the first-ever CERTIFIED claim in the registry could have
// been certified by a borrowed IDENTITY hash-link. Identity attests
// integrity, not truth — this is exactly the pantomime the lattice exists
// to refuse.
// FIX (applied same session): audit_claim now requires >=1 passing cert
//   LINKED to the claim (claim_id == claim.id or SHARED) with class
//   FORMAL or PREDICATE (class rule mirrors router _r0_status). Controls:
//   - regression test test_certified_foreign_cert_refused (permanent);
//   - claim-audit gate rejects the C4 form at pre-commit (rc=1 demo);
//   - guard G-EP-CERT-LINKAGE runs the regression live.
// Post-fix: audit_claim(C4-as-CERTIFIED) -> ['...claim_id mismatch...'];
// sidecar carries C4 as DECLARED (considered-but-refuted form).

// ─── PROOF-ATTEMPT ANALYSIS (honest, INTERPRETIVE) ─────────────────────────
// Naive routes and where they die:
// 1. Induction on n: step n -> n+2 requires producing primes fresh at each
//    rung; no monotone invariant carries over (parity forces p,q to switch
//    roles). Dead at the inductive step.
// 2. Counting argument (pigeonhole): there are ~n/ln^2 n candidate pairs;
//    >0 for large n — but pairs are not uniformly distributed (parity
//    problem: sieve upper bounds cannot exclude the all-composite scenario;
//    this is exactly why sieve theory cannot prove Goldbach-type
//    simultaneous primality). Dead at distribution control.
// 3. Heuristic (Hardy-Littlewood): predicts positive density of
//    representations — supported relatively by our samples (singular
//    series ratios) — but heuristics measure plausibility, not entailment.
// Boundary facts (recorded, not re-proven here): Chen's theorem approaches
// every large even as prime + (prime or semiprime); ternary Goldbach holds
// for large odd. These narrow the gap without closing it.
// VERDICT: no proof; C1 stays DECLARED with route-ceiling OBSERVED.

// ─── THE PHILOSOPHICAL CONJECTURE (demarcation) ────────────────────────────
// D1: "sufficient evidence saturates into proof".
// REFUTED by construction, twice:
//   - formally: validate_claim rejects interpretation+CERTIFIED (ceiling
//     INTERPRETIVE); routes require FORMAL certs to ascend CERTIFIED;
//   - semantically: exhaustive verification quantifies over a FINITE set;
//     the conjecture quantifies over an INFINITE one — no finite evidence
//     set entails it (classic underdetermination). The system's lattice
//     encodes this: computation yields OBSERVED, deduction yields
//     CERTIFIED, different axes — C2 is OBSERVED while C1 is DECLARED,
//     and that gap is the whole point.
// Related self-reference: this document reasons about the system's own
// epistemic limits — it cannot certify its own consistency (Godel-flavored
// limit, acknowledged via C3 INTERPRETIVE ceiling rather than asserted).
// Meta-note: D1 was REFUTED, but the probe showed the enforcement was
// initially hollow for the CERTIFIED axis — now fixed (linkage+class).

// ─── PROTOCOL + OUTCOME ────────────────────────────────────────────────────
protocol: "1) experiment -> evidence json; 2) sidecar C1..C4; "
  "3) audit-artifact + claim-audit gate; 4) route_claim each; "
  "5) adversarial C4 as CERTIFIED must FAIL audit"
outcome: "pre-fix FAIL-open (finding registered); post-fix CONFIRMED: "
  "audit refuses C4-form, gate rc=1, 100% guard coverage retained"
routes: "C1->R2 DECLARED(techo OBSERVED) C2->R1 OBSERVED(required FORMAL+PREDICATE) "
  "C3->R3 INTERPRETIVE C4->R1 DECLARED(post-fix)"
⟦ /goldbach_conjecture ⟧
