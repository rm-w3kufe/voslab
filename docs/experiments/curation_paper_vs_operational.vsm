@vsm 1.0
// curation_paper_vs_operational.vsm — which pending loops are OPERATIONAL plumbing vs
// PAPER-VALUE science (to develop formally). Grounded in the documented reviewer objections
// (docs/papers/attractor_convergence/review_calibration.vsm) + system_assessment_2026-06-02.
// domain_context: {target=research, env=curation, layer=S4}
// date: 2026-06-02 | author: rmw3 (S5) + Claude

// ═══════════════════════════════════════════════════════════════════════════════
// TEST = does it produce a CLAIM a reviewer cares about? If no → operational.
// ═══════════════════════════════════════════════════════════════════════════════

operational_only:   // engineering — run as needed, NO formal writeup, NO spec.vsm
  T4_sub1_seqlock:   "SeqLock contention bench → RCU-or-not. Pure systems engineering. No claim."
  EXP_LYAP_CERT:     "tune lyapunov r_core/drift_band on the live trajectory. Threshold tuning. No claim."
  EXP_TRUST_01_tune: "per-axis λ_i + τ_threshold calibration. Tuning (the axis-INDEPENDENCE question is a
                      minor aside — see borderline). Mostly operational."
  wiring_W1_W3_W4:   "deep-wiring plumbing (live state, vr monitor, adaptive Δt). Enables science but is
                      not itself a claim — it is the INSTRUMENT that produces the paper measurements."

paper_value:        // develop FORMALLY — pre-register spec.vsm, rigorous protocol, write into the paper
  // ── the 'geometry trilogy' for attractor_convergence (paper 1) ──
  EXP_LY_01_lyapunov:
    claim:   "largest Lyapunov exponent λ_max < 0 via Benettin (rigorous), REPLACING the current
              mean_dL proxy / 'proof sketch'."
    closes:  "documented reviewer objection: 'Lyapunov claim is a proof sketch / D_KY is a proxy'."
    value:   "HIGH — reviewers WILL demand a real exponent. Turns a soft claim into a measurement."
  EXP_MC_01_basin:
    claim:   "basin volume fraction via uniform Monte-Carlo perturbation sampling in ℝ¹²⁸, REPLACING
              EXP-AB-01's 6 hand-picked δ with a principled density estimate."
    closes:  "documented objection: 'basin floor from sparse hand-picked deltas'. (Q7 partial → formal)."
    value:   "HIGH — defensible basin geometry; cheap (sampling, no new runtime model)."
  EXP_TDA_01_complete:
    claim:   "topological signature of viability: β₀=1∧β₁=0 (single attractor) + the β₁ spike/return
              under perturbation (H_TDA3) correlated with σ and τ_rec."
    status:  "H_TDA1 (wide plateau) + H_TDA2 (raw-cosine sufficient, D_eff≈3) ALREADY DONE this session;
              H_TDA3 (perturbation) pending — needs a kicked run with VSF_DUMP_EVERY_TICK."
    value:   "HIGH + NOVEL — a topological (not just cosine) signature differentiates the paper; extends
              the existing 'geometric identity under perturbation' (τ_rec) theme with persistent homology."
  trilogy_thesis:
    "Lyapunov (dynamics: it contracts) + Monte-Carlo basin (volume: how big the safe set is) +
     persistent homology (shape: one attractor, no holes) = a three-lens rigorous geometry of viability.
     Each lens closes a documented weak spot OR adds a novel angle. Coherent, bounded, paper-1 scoped."

  // ── Paper 2 / 3 material (formalize SEPARATELY, not in attractor_convergence) ──
  EXP_PSI_MESH:
    claim:   "EMPIRICAL compositional viability: two ψ-coupled kernels stay viable iff Thm_Compose
              preconditions hold; demonstrate Cor_NoCompose_1/2/3 failures in vivo; measure ‖J_ψ‖ +
              joint basin floor."
    value:   "HIGH but BIG — this is the multi-system / symbiogenesis story (Paper 2/3), validates
              composition_proof.vsm. Scope to its own paper, NOT paper 1."
  EXP_PHI_02:
    claim:   "computed vs interpreted brief fidelity separable (VSL v2)."
    value:   "Paper 2 (Symbolic Substrates) — already seeded there."

  borderline:
    EXP_SEN_01:      "adaptive H_rest senescence — moderate; extends §thermal_senescence if a real aging
                      effect appears. Run operationally first; promote to paper only if the effect is real."
    trust_axes_PCA:  "do the 4 trust axes collapse to effective rank < 4 (PCA)? a 1-paragraph empirical
                      aside, not a standalone experiment."

// ═══════════════════════════════════════════════════════════════════════════════
// RECOMMENDATION  (una / alguna / todas?)
// ═══════════════════════════════════════════════════════════════════════════════

recommendation:
  answer: "ALGUNA — not all. Formally develop the THREE-lens geometry trilogy for attractor_convergence:
           EXP-LY-01 + EXP-MC-01 + EXP-TDA-01(complete). Two of the three CLOSE documented reviewer
           objections (Lyapunov proxy, sparse basin); the third ADDS a novel topological signature.
           Together they make the convergence paper's central claim rigorous from three independent angles."
  scope_out: "EXP-PSI-MESH + EXP-PHI-02 → Paper 2/3 (formalize, but separate paper). Everything in
              `operational_only` → just run it; no spec, no writeup."
  why_not_all: "running every loop dilutes effort and adds claims the paper doesn't need; the trilogy is
                the minimal set that maximizes defensibility + novelty for paper 1."
  sequence:  "cheapest-first: EXP-MC-01 (sampling, no new model) → EXP-TDA-01 H_TDA3 (pipeline ready) →
              EXP-LY-01 (Benettin, needs a perturbation-pair run). Each gets a pre-registered spec.vsm
              (vos_dev_cycle experiment_spec pattern) before implementation."

// ═══════════════════════════════════════════════════════════════════════════════
references:
  "docs/papers/attractor_convergence/review_calibration.vsm — the reviewer-anticipation objections"
  "docs/experiments/index.vsm — EXP-AB-01 (done), EXP-LY-01 / EXP-TDA-01 / EXP-SEN-01 seeds"
  "docs/internal/system_assessment_2026-06-02.vsm — full pending-loop ledger"
  "docs/theory/composition_proof.vsm — what EXP-PSI-MESH would validate"

