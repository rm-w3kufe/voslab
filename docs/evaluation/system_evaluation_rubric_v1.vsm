⟦ system_evaluation_rubric_v1 | SYSTEM-EVAL-RUBRIC-v1 | vsm-1.2.1 | 2026-10-15T01:18:38Z ⟧

@vsm 1.2.1
@status active

// RUBRICA DE EVALUACION PERIODICA DEL SISTEMA — derivada de
// system_evaluation_2026_10_14. Aplicar bajo pedido S5 o cada cierre de
// milestone. Formato: precedent vsf-cert-rubric-v1 (scope/authority/criterios).

rubric(SYSTEM-EVAL-RUBRIC-v1) {
  scope: "Evaluacion periodica whole-system (S1-S5 + algedonic + learning loop). Base: system_evaluation_2026_10_14.vsm. Cada corrida produce un doc system_evaluation_<DATE>.vsm registrado en evaluation_registry.vsm."

  authority: "Anclas epemicos: R5 canon over recall, R9 sin concesion silenciosa, R10 cifras = deterministas (LLM = tactica). Evidencia = paths vivos, nunca recall. Conflicto entre fuentes resuelve contra el estado en disco."

  scale: "0 RED (roto/sin evidencia) | 1 YELLOW (parcial/deuda) | 2 GREEN (verificado con evidencia). Cada criterio declara mode: auto|judgment."

  dimensions: [
    {id: "D1", nombre: "ciclo de vida de instruccion", criterios: [
      {id: "D1-C1", criterio: "82 live checks rc=0", mode: auto, evidencia: "packages/framework/run_gates.py"},
      {id: "D1-C2", criterio: "23 NC (negative controls) rc=0", mode: auto, evidencia: "packages/framework/gate_suite"},
      {id: "D1-C3", criterio: "tool.execute.before/after presentes (conteo canonico)", mode: auto, evidencia: "python3 scripts/logs/count_events.py tool.execute.before tool.execute.after --include-rotated — CANON: event_type/hook primario; live-only = snapshot dependiente de rotacion, NO comparable entre ventanas (resuelve H3 2026-10-15)"}
    ]},
    {id: "D2", nombre: "cibernetica VSM", criterios: [
      {id: "D2-C1", criterio: "canon drift = 0", mode: auto, evidencia: "state-canon state_reconcile"},
      {id: "D2-C2", criterio: "algedonic alerts triaged (sin aging > 7d)", mode: auto, evidencia: "state/rsi/alerts.jsonl + state/rsi/queue/"},
      {id: "D2-C3", criterio: "health_history consistente entre sesiones (scope)", mode: judgment, evidencia: "state/health_history.jsonl tail"}
    ]},
    {id: "D3", nombre: "auto-aprendizaje", criterios: [
      {id: "D3-C1", criterio: "colas drenadas (pending = 0 o justificados con aging < 7d)", mode: auto, evidencia: "state/rsi/queue/"},
      {id: "D3-C2", criterio: "activated/total ratio y tendencia", mode: auto, evidencia: "state/rsi/activated.json vs eval_counter"},
      {id: "D3-C3", criterio: "senales top revisadas (handoff_needs_nod, bridge_call_failed, pattern_runner_fail, learning_investment_pending)", mode: judgment, evidencia: "pattern registry"}
    ]},
    {id: "D4", nombre: "higiene epistemica", criterios: [
      {id: "D4-C1", criterio: "vsm-1.2.1 en todos los docs nuevos", mode: auto, evidencia: "scripts/vsl/validator/check.py <file>"},
      {id: "D4-C2", criterio: "TASKS cerrados archivados (ritual tasks_archive --closed)", mode: auto, evidencia: "docs/sessions/tasks_closed/closed.vsm + TASKS.vsm stubs"},
      {id: "D4-C3", criterio: "advisories complejos no bloqueantes registrados como DEFER", mode: judgment, evidencia: "TASKS.vsm"}
    ]},
    {id: "D5", nombre: "auto-deteccion", criterios: [
      {id: "D5-C1", criterio: "anti-vacuous: fixtures negativas presentes en gates/extractores", mode: auto, evidencia: "packages/framework/gate_suite NC"},
      {id: "D5-C2", criterio: "derived blocks resync reciente (plan census, boot pins)", mode: auto, evidencia: "python3 scripts/plan/plan_tree.py --plan <X>"},
      {id: "D5-C3", criterio: "sin pasos vacios silenciosos en pipeline vivo", mode: judgment, evidencia: "system/kernel/rsi_cycle.py stages"}
    ]}
  ]

  scoring: {
    total: "15 criterios x 0-2 = max 30; normalizar a /10 con round(sum/3)",
    bands: [
      {band: "GREEN", rango: "9-10", implicancia: "candidato a paquete publico"},
      {band: "YELLOW", rango: "7-8", implicancia: "deudas manejables; proyectar en system_projection"},
      {band: "RED", rango: "<7", implicancia: "bloquear publicacion; atender primero"}
    ],
    regla: "cada YELLOW/RED debe mapear a item del system_projection o TASKS; sin items abiertos = score inflado"
  }

  protocol: [
    "1) leer estado vivo (state onboard fresh / state_query)",
    "2) aplicar criterios mode=auto con evidencia",
    "3) criterios mode=judgment con justificacion explicita",
    "4) escribir system_evaluation_<DATE>.vsm en docs/evaluation/",
    "5) registrar en evaluation_registry.vsm",
    "6) proyectar acciones nuevas en system_projection",
    "7) si GREEN: candidato a paquete publico (traduccion + sanitizado de paths internos)"
  ]
}
⟦ /system_evaluation_rubric_v1 ⟧
