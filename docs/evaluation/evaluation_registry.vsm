@vsm 1.2.1
@status active

// REGISTRO DE EVALUACIONES DEL SISTEMA — cada corrida de la rubrica
// agrega una entrada aqui. El registro es el indice de discoverability;
// los docs viven en docs/evaluation/.

registry(EVAL-REGISTRY-v1) {
  schema: {
    id: "EVAL-<YYYY-MM-DD>-<seq>",
    date: "ISO-8601 UTC",
    rubric: "version de rubrica aplicada",
    doc: "path relativo al doc de evaluacion",
    band: "GREEN|YELLOW|RED",
    score: "n/10",
    acciones: "items proyectados (referencia a system_projection)"
  }

  entries: [
    {id: "EVAL-2026-10-14-01", date: "2026-10-14", rubric: "pre-rubrica (evaluacion inicial; rubrica derivada de esta)", doc: "docs/evaluation/system_evaluation_2026_10_14.vsm", band: "YELLOW", score: "6.5/10 (estimado pre-rubrica; D3-C1 RED por colas, D5-C3 YELLOW por pasos vacios historicos)", acciones: "P-EV-R1..R5 en docs/plans/system_projection_2026_10_14.vsm", nota: "amendment 2026-10-15: consistency-check 3-vias E0<->D<->H — ALTA consistencia (0 divergencias numericas), fuente full = registro conversacional S5, funnel+l3+rational recuperados, hallazgos H1 (health_history confirmado vivo) H2 (senales crecientes) H3 (discrepancia conteo idle/after/before — contar canonico pendiente en rubrica D1-C3)"}
  ]
}
⟦ /evaluation_registry ⟧
