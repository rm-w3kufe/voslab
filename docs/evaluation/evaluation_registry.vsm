@status active

// REGISTRO DE EVALUACIONES DEL SISTEMA — cada corrida de la rubrica
// agrega una entrada aqui. El registro es el indice de discoverability;
// los docs viven en docs/evaluation/.

registry(EVAL-REGISTRY-v1) {
  schema: {
    id: "EVAL-<YYYY-MM-DD>-<seq>",
    date: "ISO-8601 UTC",
    rubric: "version de rubrica aplicada",
    doc: "path relativo al doc de evaluacion",
    band: "GREEN|YELLOW|RED",
    score: "n/10",
    acciones: "items proyectados (referencia a system_projection)"
  }

  entries: [
    {id: "EVAL-2026-10-14-01", date: "2026-10-14", rubric: "pre-rubrica (evaluacion inicial; rubrica derivada de esta)", doc: "docs/evaluation/system_evaluation_2026_10_14.vsm", band: "YELLOW", score: "6.5/10 (estimado pre-rubrica; D3-C1 RED por colas, D5-C3 YELLOW por pasos vacios historicos)", acciones: "P-EV-R1..R5 en docs/plans/system_projection_2026_10_14.vsm", nota: "amendment 2026-10-15: consistency-check 3-vias E0<->D<->H — ALTA consistencia (0 divergencias numericas), fuente full = registro conversacional S5, funnel+l3+rational recuperados, hallazgos H1 (health_history confirmado vivo) H2 (senales crecientes) H3 (discrepancia conteo idle/after/before — contar canonico pendiente en rubrica D1-C3)"},
    {id: "EVAL-2026-10-15-01", date: "2026-10-15", rubric: "SYSTEM-EVAL-RUBRIC-v1 (1a corrida)", doc: "docs/evaluation/system_evaluation_2026_10_15.vsm", band: "YELLOW", score: "7/10 (22/30 normalizado; D1 6/6, D2 4/6, D3 2/6, D4 6/6, D5 4/6)", acciones: "D2-C3->P-EV-R4, D3-C1->P-EV-R1, D3-C3->P-EV-R5+NOD-BACKLOG, D5-C1/C3->P-EV-R3", nota: "+0.5 vs EVAL-2026-10-14; H3 resuelto (canon count_events.py --include-rotated); P-EV-R5 verdict=backlog 92 candidatos distintos unack; scoring rubrica normalizado /30->/10 pre-corrida"},
    {id: "EVAL-2026-10-15-02", date: "2026-10-15", rubric: "SYSTEM-EVAL-RUBRIC-v1 (2a corrida del dia, post P-EV)", doc: "docs/evaluation/system_evaluation_2026_10_15_02.vsm", band: "GREEN", score: "10/10 (29/30 normalizado round; unico no-2 = D3-C2 judgment 1)", acciones: "P-PKG-00 desbloqueado (rubrica GREEN -> traduccion EN + sanitizado)", nota: "+7 puntos vs 01: D2-C3 0->2 (scope fix vivo), D3-C1 0->2 (queue 0), D3-C3 1->2 (drenaje 92/92), D5-C1/C3 1->2 (P-EV-R3); pedida por S5 via orden implicito de P-PKG-00; anti-inflado: todo YELLOW cerrado con evidencia fresca"}
  ]
}
