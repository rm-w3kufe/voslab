        A0-ALLOC-BASELINE-SYNC, which is a different naming convention)",
    pattern_D: "'D[0-9]{1,2}[a-z]?' standalone",
    excluded_noise: [
      "docs/corpus/*.txt (raw Gemini transcript dumps; DOM classes, e.g. A75/A44)",
      "docs/sessions/*.vsm (historical session transcripts, own naming)",
      ".opencode/node_modules (foreign vendored code)",
      "*.pdf/*.png/*.pyc, docs/.index.db, .git/, target/, site/, worktrees/",
    ],
    counted_canon_file_classes: [
      "docs/spec/, docs/governance/, docs/theory/, docs/plan/, docs/internal/",
      "docs/experiments/, docs/findings/, docs/incidents/, docs/operations/",
      "docs/infra/, docs/evaluation/, docs/rubric/, docs/security/, docs/vsf-bbh/",
