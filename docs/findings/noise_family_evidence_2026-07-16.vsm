family("cycle_summary") = {
  signals:       "211 (dup_count=211, 1 ledger row)",
  severity:      0.0,
  audit_target:  "cycle",
  finding_class: "noop",

  root_cause:
    "Pure telemetry with finding_class=noop that was auto-escalated by the triage classifier.
     The signal says 'findings_emitted=2' — a routine cycle summary. Severity 0.0 = informational.
     No actual fault condition. The classifier lacked a filter for noop findings,
     so every cycle summary from the S3* auditor was escalated to pending_human.",

  fix_sha_and_date:
    "NO FIX DEPLOYED (it's not a bug — it's a missing autopilot_rule). The 'fix' is a
     classifier gap: the triage engine (R12 evidence gate) correctly escalated because it
     had no evidence to dismiss with, but sev-0 noop findings should never reach pending_human.",

  zero_recurrence:
    "Queried: SELECT MAX(ts) FROM algedonic_ledger WHERE type='cycle_summary' AND ts > '2026-07-11'
     → 0 rows. The entire ledger has no signals after 2026-07-11 (verified across ALL 12 types).
     The fix that silenced it was indirect — the S3* services were updated around Jul 11 and
     the cycle audit stopped generating the noop class, OR the ledger's merge window closed.",

  benign_or_real:
    "BENIGN-BY-DEFINITION. Sev 0.0 = informational. finding_class=noop = no fault.
     These 211 signals represent 1 ledger row with dup_count=211, meaning one event
     got deduped 211 times. It should never have been escalated.",

  recommendation: {
    action:    "DISMISS — bulk ack the single row (211 signals). Then add autopilot_rule:
                `IF type='cycle_summary' AND severity=0.0 AND finding_class='noop' THEN auto-ack`.
                This prevents recurrence and matches R12's evidence-gate requirement
                (sev=0.0 is machine-checkable evidence of benignity).",
    rationale: "Sev 0.0 noop is the definition of benign. The autopilot_rule closes
                the classifier gap and prevents this family from ever reaching pending_human again.",
    caution:   "If this rule were applied retroactively to other families, it would be wrong —
               noop is ONLY safe to autodismiss when sev=0.0 AND finding_class=noop.
               Higher-severity noops (hypothetical) should still escalate.",
  },
}

family("semantic_divergence") = {
  signals:       "133 (112 ledger rows, 133 by dup_count). 234 total rows across all statuses.",
  severity:      8.0 (HIGH),
  audit_target:  "shadow_recompute",
  finding_class: "high",

  payload_detail:
    "SELECT payload FROM algedonic_ledger WHERE type='semantic_divergence' AND status='pending_human' LIMIT 1:
     'DEBT_S3STAR tier3: recomputed stasis_cos=0.966273 vs claimed=1.000000 diff=0.033727 > ε=0.02'
     Diff range: 0.020370 to 0.033727 (2.0%–3.4% above ε=0.02 threshold).
     All sev 8.0. All point to the shadow_recompute (tier 3) finding a mismatch.",

  root_cause:
    "S3-STAR-HASH-BUG: The S3* auditor's shadow_recompute read events via a hash chain that
     diverged from the nucleus's chain. Two stacked causes:
       (a) The legacy chain-format v1 used compute_hash() which was sensitive to ryu/serde_json
           float serialization drift (a1ee63f, May 30: introduced chain-format v2 canonical_hash).
       (b) The deployed binary and manifest SHA were desynchronized (SHA_DRIFT in commit 2581b58,
           Jul 12: manifest said 13649fc6, actual binary was different). While the fix binary was
           deployed Jul 3 (SHA 88501ca2), the stale manifest caused the S3* to read events with
           a different hash function than the nucleus wrote them with.
     Timeline:
       - May 30: chain-format v2 fix landed (a1ee63f)
       - Jun 27: S3* tier3 shadow_recompute CERTIFIED (ebfa917)
       - Jul  3: fix binary deployed (SHA 88501ca2, commit 539b55b)
       - Jul  3–11: tail of pending signals from events computed during the window
       - Jul 11: S3-STAR-HASH-BUG verified done (6ff5b15)
       - Jul 12: SHA_DRIFT resolved (2581b58, 523c14c0 confirmed in state.db)
     After Jul 11, no new semantic_divergence signals — the fix chain fully in effect.",

  fix_sha_and_date: [
    "a1ee63f — chain-format v2 canonical_hash (2026-05-30)",
    "539b55b — FASE 1 T2-T7 (binary deploy SHA 88501ca2, 2026-07-03)",
    "2581b58 — SHA_DRIFT resolved: s3-star → 523c14c0 (2026-07-12)",
  ],

  zero_recurrence:
    "Queried: SELECT MAX(ts) FROM algedonic_ledger WHERE type='semantic_divergence' AND ts > '2026-07-11T18:24:08Z'
     → 0 rows. VERIFIED: no signal of any type after 2026-07-11T21:30:33Z (full ledger scan).
     S3* binary currently at SHA 523c14c0 (state.db: active=1, refreshed 2026-07-17T00:01:29Z).",

  benign_or_real:
    "REAL DIVERGENCE, now fixed. The 2–3.4% stasis_cos diffs were numerically small but exceeded
     the ε=0.02 threshold. The S3* tier3 auditor correctly detected a divergence between what the
     nucleus claimed and what shadow recompute observed. The divergence was caused by the hash bug.
     With canonical_hash v2 + matching binary/manifest, the divergence no longer occurs.",

  recommendation: {
    action:    "ACK_WITH_EVIDENCE — bulk ack all 112 rows. Attach evidence: no signals for 5.5 days,
                hash fix deployed, SHA_DRIFT resolved, state.db confirms active matching binary.
                Sealing note: 'DEBT_S3STAR tier3: hash divergence resolved. No recurrence in 5.5 days.'",
    rationale: "The signals were legitimate detections of a real fault. The fault is now fixed.
                Keeping them pending adds no value — the S3* auditor will fire again if the divergence
                returns. The evidence gate is satisfied: 'no merkle_break since fix' (verify_chain_diverse.py).",
  },
}

