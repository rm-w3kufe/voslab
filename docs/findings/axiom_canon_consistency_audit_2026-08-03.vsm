@vsm 1.0
// docs/findings/axiom_canon_consistency_audit_2026-08-03.vsm
// FINDING: axiom/canon consistency audit across VSF's constitutional layer.
// Origin: grew out of a narrower fix (CLAUDE.md's own boot-memory doc links,
// broken since the docs/{guides,spec,theory}/ reorganization) — rmw3 asked
// "¿por qué nunca más fueron referenciados varios documentos importantes
// (VSL spec, covenant...) desde esa reorganización?" That question surfaced
// that 8 of ~15 foundational docs were entirely absent from CLAUDE.md's own
// canon pointers (not broken links — never mentioned). rmw3 then asked for a
// full study of those documents for contradictions/inconsistencies/
// incompleteness/staleness. Two parallel independent audits (Claude forks,
// no shared context between them beyond the file lists) ran against two
// disjoint document sets and converged on the SAME structural pattern
// independently — cross-validating the finding, not just two separate lists.
// Authors: Claude (Sonnet 5) — fork audit-core-theory + fork
// audit-governance-subsystems, synthesized by [O]. rmw3 (S5) requested this
// be formally registered, 2026-08-03.
// Status: OPEN — findings are registered and cross-verified; REMEDIATION is
// explicitly NOT decided here. Which axiom definition is authoritative is a
// substantive governance call, reserved for rmw3 (S5) — see open_questions.

finding("AXIOM-CANON-CONSISTENCY-2026-08-03") {

  scope_audited: {
    core_theory_set: [
      "docs/spec/vsm_notation_spec.md",
      "docs/theory/recursive_vsm_theory.md",
      "docs/theory/vos_theory.vsm",
      "docs/theory/vos_architecture.vsm",
      "docs/theory/vos_kernel_spec.vsm",
    ],
    governance_subsystem_set: [
      "docs/governance/covenant.vsm",
      "docs/governance/covenant_ops.vsm",
      "docs/governance/strategy.vsm",
      "docs/governance/ethical_machine_seed.vsm",
      "docs/guides/concepts.md",
      "docs/guides/human_guide.md",
      "docs/theory/systems/S1_operations.md",
      "docs/theory/systems/S2_coordination.md",
      "docs/theory/systems/S3_control.md",
      "docs/theory/systems/S3_star_audit.md",
      "docs/theory/systems/S5_policy.md",
    ],
    also_cross_checked_against: ["README.md", "CLAUDE.md", "RULES.md",
        "HANDOFF.vsm.md tail", "TASKS.vsm", "live deployed code
        (s3_resource_alloc.py AXIS2-FIRST-LOOP, this session)"],
  }

  // ═══════════════════════════════════════════════════════════════════════
  // THE HEADLINE FINDING — axiom numbering has NO single source of truth
  // ═══════════════════════════════════════════════════════════════════════

  headline: "At least FOUR incompatible axiom-numbering schemes coexist across
      documents each independently marked 'canonical', citing each other
      without reconciling, with REAL ID collisions on safety-load-bearing
      axioms — not cosmetic drift.

      (1) vsm_notation_spec.md canon: A1-A11, ⊕ as the variety-combination
          operator, NO A0 slot at all.
      (2) vOS lineage (vos_architecture.vsm, vos_kernel_spec.vsm): A0/A0.1/
          A3/A5/A8/A12.
      (3) covenant_ops.vsm: its own A3/A5/Ax_InterfaceOnly/
          Ax_TraceabilityClosure — only 6 axioms enumerated total.
      (4) README.md: a mislabeled summary that mixes the above — calls its
          A3 'Ashby's Law' (canon says Ashby's Law is A6; canon's A3 is a
          budget/resource constraint), and states an 'A5' that is actually
          scheme (2)'s A5 Corollary 2, not A5 itself.

      None of the four declares authority over the other three. Nothing in
      the corpus says which one governs when they disagree.",

  // ═══════════════════════════════════════════════════════════════════════
  // FINDINGS — core theory set (fork audit-core-theory)
  // ═══════════════════════════════════════════════════════════════════════

  core_theory_findings: [
    { id: "CT1", severity: "high", tag: "CONTRADICTION", status: "RESOLVED 2026-08-03",
      what: "A8 has two unrelated formal definitions in two canonical-tier
          docs: vsm_notation_spec.md Part II = 'Absorption invariant'
          (|S(L)| ≤ |S(L+1)|·(1-r_L)); vos_architecture.vsm line 35 =
          'Physical Safety' (CPU.load>0.85 ∨ RAM.free<0.10 → throttle).
          Same ID, both presented as authoritative. RESOLVED: not a real
          collision -- vos_architecture.vsm's own formal rule() already
          used 'A8.vOS' as a namespaced extension (line 331); the bare
          'A8' in its prose header just didn't carry that qualifier
          consistently. Fixed: all A8 references in vos_architecture.vsm
          now say 'A8.vOS', with an explicit note distinguishing it from
          canon's A8." },
    { id: "CT2", severity: "high", tag: "INCOMPLETE",
      what: "A0/A0.1 (Ethical Primacy, Anti-Capture) — treated as
          foundational/inviolable by README.md and the covenant — are
          ABSENT from vsm_notation_spec.md's own Part II axiom list (A1-A11,
          no A0 slot). The 'canonical formal grammar' doesn't define its
          own most-cited axiom; A0/A0.1 exist only in vOS-lineage docs." },
    { id: "CT3", severity: "high", tag: "CONTRADICTION", status: "RESOLVED 2026-08-03",
      what: "README.md's 'Core axioms' mislabels its A3 as Ashby's Law
          (canon: Ashby's Law is A6; canon's A3 is the budget/physical-
          resource constraint) — RESOLVED: README.md line 32 comment now
          reads 'budget/physical-resource ceiling (Ashby's Law is A6)'.
          README's stated 'A5' (S5'(V')⊆S5(V)) is actually vOS-lineage's
          A5 Corollary 2, not A5 proper (A5 proper: op.autonomy ≤
          S5(L).ceiling) — RESOLVED: README.md line 33 now reads 'A5
          corollary', see GS1's resolution note." },
    { id: "CT4", severity: "high", tag: "STALE",
      what: "vos_architecture.vsm P11 specifies cgroup path
          /vsf/{parent_id}/{V.id} (children nest under /vsf/). This
          session's own HANDOFF.vsm.md records EXP-L1-01 had to use a
          SEPARATE root /vsf-l1-exp because the live operational nucleus
          already owns /vsf as a leaf cgroup (no-internal-processes rule) —
          a confirmed LIVE implementation conflict with the spec." },
    { id: "CT5", severity: "medium", tag: "INCOMPLETE",
      what: "The ℝ¹²⁸ state_vector (defined identically in vos_theory.vsm
          and vos_kernel_spec.vsm, live/in-use per TDA/Lyapunov tooling) is
          entirely absent from vsm_notation_spec.md — the doc that's
          supposed to be the canonical grammar." },
    { id: "CT6", severity: "medium", tag: "STALE",
      what: "vos_kernel_spec.vsm §7 hardcodes the vOS kernel's ψ-channel
          LLM peer as peer_id: claude. Current live architecture runs
          Qwen2.5-coder (LXC 110) as S4; Claude operates at S3-S5
          supervision. Boot-spec peer identity doesn't match current role
          assignment." },
    { id: "CT7", severity: "medium", tag: "INCONSISTENCY",
      what: "recursive_vsm_theory.md §6 writes Ashby's Law as
          Var(S3)·Var(S2) (raw multiplication) instead of the canonical ⊕
          operator vsm_notation_spec.md Part I defines for exactly this
          expression (and A6 itself uses correctly)." },
    { id: "CT8", severity: "medium", tag: "STALE",
      what: "vsm_notation_spec.md D7 and recursive_vsm_theory.md §7 both
          define 'opsroom' as 5 VSM views (system_health/pipeline_status/
          signal_queue/priority_ranking/coverage_gaps). Current opsroom
          (per CLAUDE.md, this session) is the formaid mermaid-diagram
          studio + view-modules — a different design that superseded D7's
          mapping without D7 being updated." },
    { id: "CT9", severity: "low", tag: "STALE",
      what: "recursive_vsm_theory.md has no @vsm version header at all and
          lives as a bare .md in docs/theory/ — violating
          vsm_notation_spec.md's own stated convention that docs/theory/
          should be pure .vsm." },
    { id: "CT10", severity: "low", tag: "STALE",
      what: "vos_architecture.vsm is tagged @vsm 0.1 — predates L-relativity,
          D10-D13, A9-A11, and Part XI-XIII (file-grammar/type-system, added
          in v1.0). Never re-validated against the current v1.0 grammar,
          despite being one of the architecturally heaviest docs." },
  ]

  // ═══════════════════════════════════════════════════════════════════════
  // FINDINGS — governance + subsystem set (fork audit-governance-subsystems)
  // ═══════════════════════════════════════════════════════════════════════

  governance_subsystem_findings: [
    { id: "GS1", severity: "high", tag: "CONTRADICTION", status: "RESOLVED 2026-08-03",
      what: "A5 — the most-invoked safety axiom in the project ('no
          double-loop correction without human approval') — has THREE
          materially different formal statements, none cross-referencing
          the others: covenant_ops.vsm (autonomy(V) ≤ S5.ceiling;
          S5→V'(S5) @forbidden), README.md (S5'(V')⊆S5(V)), CLAUDE.md
          ('double-loop corrections always require human approval').
          RESOLVED: not 3 competing definitions — see open_questions
          block for the full traced resolution; covenant_ops.vsm's A5 is
          authoritative, README/CLAUDE.md corrected to match." },
    { id: "GS2", severity: "high", tag: "CONTRADICTION",
      what: "RULES.md R13 cites covenant_ops.vsm's Ax_InterfaceOnly as the
          governing axiom for 'parent reads child, never reverse' — but
          that axiom's actual text is scoped specifically to hardware-
          sensor φ↑ boundary certification, not general parent/child
          visibility. The citation does not support the rule it's
          attached to." },
    { id: "GS3", severity: "high", tag: "INCOMPLETE",
      what: "A1 (recursion), A4 (no sibling coupling), A6 (Cyberfilter/
          variety) are cited as binding everywhere (RULES.md, CLAUDE.md,
          all 5 systems/*.md docs) but defined ONLY in docs/guides/
          concepts.md — a 'working'-tier guide, not covenant.vsm/
          covenant_ops.vsm (the only 'canonical'-tier governance docs).
          This breaks covenant_ops.vsm's own Ax_TraceabilityClosure, which
          enumerates only 6 axioms and does not include A1/A4/A6 at all." },
    { id: "GS4", severity: "medium-high", tag: "INCOMPLETE",
      what: "D11/D11b/D12/D13 are cited as 'inherited constraints' in
          S1_operations.md/S3_control.md/S3_star_audit.md (trust
          composition, reframe trigger, safety blocking) but defined in
          NEITHER covenant document." },
    { id: "GS5", severity: "high", tag: "STALE",
      what: "S3_control.md (content dated 2026-05-24) states escalation
          logic is '✗ Future, not yet formalized' — but _check_escalation()
          was built and deployed in s3_resource_alloc.py on 2026-07-04
          (AXIS2-FIRST-LOOP, confirmed live this session). Over a month of
          undetected drift on a 'canonical'-tier doc." },
    { id: "GS6", severity: "high", tag: "INCOMPLETE",
      what: "docs/theory/systems/ has S1, S2, S3, S3*, S5 — NO
          S4_intelligence.md. S4 is among the most actively developed
          subsystems (Component A/B, markov/clima bridges, multi-S1) and
          is the only one of six lacking a formal per-system requirements
