# ══════════════════════════════════════════════════════════════
# D3 — S5 Console direct BBS poll (5s latency)
# ══════════════════════════════════════════════════════════════
task(D3) {
  goal: Algedonic signals appear in S5 Console within 5s of hitting BBS, not 30s.

  step(D3.1, "Add asyncio background task to s5_console.py"):
    Location: after app = FastAPI(...) declaration
    Pattern: use @app.on_event("startup") + asyncio.create_task()

    Implementation (stdlib only — no aiohttp):
    ```python
    import threading

    def _bbs_alert_poller():
        import urllib.request, urllib.parse, time, json
        BBS = "http://10.10.20.20:8600"
        seen = set()
        # initialize seen with existing messages
        try:
            params = urllib.parse.urlencode({"channel": "vsf-alerts", "limit": 50})
            with urllib.request.urlopen(f"{BBS}/messages?{params}", timeout=5) as r:
                for m in json.loads(r.read()):
                    seen.add(m["message_id"])
        except Exception:
            pass
        while True:
            try:
                params = urllib.parse.urlencode({"channel": "vsf-alerts", "limit": 20})
                with urllib.request.urlopen(f"{BBS}/messages?{params}", timeout=5) as r:
                    msgs = json.loads(r.read())
                for m in msgs:
                    mid = m["message_id"]
                    if mid not in seen:
                        body = m.get("body", "")
                        sev = "critical" if "[CRITICAL]" in body else "warning" if "[WARNING]" in body else "info"
                        entry = {
                            "ts": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat(),
                            "id": "bbs-direct",
                            "severity": sev,
                            "msg": body[:300],
                            "source": "vsf-alerts",
                        }
                        ALERTS_PATH.parent.mkdir(parents=True, exist_ok=True)
                        with open(ALERTS_PATH, "a") as f:
                            f.write(json.dumps(entry) + "\n")
                        seen.add(mid)
                        if len(seen) > 500:
                            seen = set(list(seen)[-300:])
            except Exception as e:
                print(f"[bbs_poller] {e}", flush=True)
            time.sleep(5)

    @app.on_event("startup")
    async def start_bbs_poller():
        t = threading.Thread(target=_bbs_alert_poller, daemon=True)
        t.start()
    ```

  step(D3.2, "Preserve existing /alert POST endpoint"):
    The POST /alert from BRIEF-06 must remain — poller on n02 still uses it.
    Both paths write to alerts.jsonl — deduplicated by the seen set above.

  step(D3.3, "Deploy + verify"):
    Deploy → restart s5_console → send test alert via vsf-netdata-notify.sh
    Check http://localhost:8090/alerts within 10s — should appear.
}


# ══════════════════════════════════════════════════════════════
# D9 — client.py OR/DashScope fallback
# ══════════════════════════════════════════════════════════════
task(D9) {
  goal: Brief execution doesn't require manual intervention on rate limit.

  step(D9.1, "Modify call_dashscope() in client.py"):
    Current: single attempt, returns BLOCKED on 429/400.
    New behavior:
      1. First attempt with configured API (OR or DashScope)
      2. On 429: wait 10s, retry once with same API
      3. On 400 (model error) or second 429: try fallback API
         Fallback reads: ANTHROPIC_API_KEY_FALLBACK + ANTHROPIC_BASE_URL_FALLBACK
      4. If both fail: return BLOCKED with both error summaries

  step(D9.2, "Add fallback env vars to ~/.qwen-env"):
    export ANTHROPIC_API_KEY_FALLBACK="<dashscope key>"
    export ANTHROPIC_BASE_URL_FALLBACK="https://dashscope-intl.aliyuncs.com/apps/anthropic"
    (and vice versa in ~/.openrouter-env — fallback = DashScope)

  step(D9.3, "Test"):
    Temporarily set ANTHROPIC_API_KEY to an invalid key → should fallback to FALLBACK key.

  step(D9.4, "Deploy"):
    Edit ~/vsf/projects/claude-qwen-s1/client.py
    Update ~/.openrouter-env and ~/.qwen-env with fallback vars
    git add + commit
}


