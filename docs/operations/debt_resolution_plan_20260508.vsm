# ══════════════════════════════════════════════════════════════
# D2 — aggregator.py schema audit (FIRST — blocks D1/D7)
# ══════════════════════════════════════════════════════════════
task(D2) {
  goal: Understand what aggregator.py does and whether vsf_telemetry.db is recoverable.

  step(D2.1, "Read DB schema"):
    ssh n02 "pct exec 104 -- python3 -c \"
import sqlite3
db = sqlite3.connect('/root/vsf_telemetry.db')
tables = db.execute(\\\"SELECT name FROM sqlite_master WHERE type='table'\\\").fetchall()
print('tables:', [t[0] for t in tables])
for t in tables:
    count = db.execute('SELECT count(*) FROM ' + t[0]).fetchone()[0]
    cols = [c[1] for c in db.execute('PRAGMA table_info(' + t[0] + ')').fetchall()]
    print(t[0], count, 'rows | cols:', cols)
\""

  step(D2.2, "Read aggregator.py"):
    ssh n02 "pct exec 104 -- cat /root/aggregator.py"
    → Look for: what tables it creates, what it reads, is it a service?

  step(D2.3, "Check if aggregator is running"):
    ssh n02 "pct exec 104 -- ps aux | grep aggregator"
    ssh n02 "pct exec 104 -- systemctl list-units | grep -i agg 2>/dev/null || echo no_systemd"

  decision(D2.D):
    IF tables exist and aggregator is active → flag_if F1 (stop = data loss)
    IF tables exist but aggregator stopped → DB is historical, can keep or discard
    IF tables missing → schema is dead, remove dead queries from s5_console.py
    IF aggregator.py is useless → can be decommissioned
}


