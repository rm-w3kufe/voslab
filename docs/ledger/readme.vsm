@vsm 1.2.1
@status active
// docs/ledger/readme.vsm — ROL Y FUNCIÓN DE ledger/.
// DECISIÓN S5 rmw3 2026-08-14 (DIR-readme-POLICY): 'no acumular documentación
// sin destino' — los registros contables tienen su casa.
// Este readme es la puerta del directorio: se lee antes de entrar.

system(readme) {

  synthesis: "ledger/ := los REGISTROS CONTABLES del árbol — qué se comprimió,
              qué se fusionó, qué métricas; la memoria contable de la
              consolidación documental (compression_ledger). NO vive aquí
              documentación nueva: solo el rastro de lo que ya se hizo.",

  structure: [
    dir("compression_ledger.vsm", role="registro", desc="estándar FORMA de compresión — density_FORMA, coverage_semantic, op() por fusión (COMPRESSION-LEDGER-v1)"),
  ],

  policy: "
    un registro de compresión/fusión/archivo → vive aquí (ledger)
    un doc nuevo con contenido (no registro) → su directorio de rol (system/,
    spec/, plan/, sandbox/) — NO aquí
    un plan cumplido que se archiva → ledger/ o DATED RECORD en plan/
    una propuesta validada → se promueve a system/ (no se archiva en ledger:
    ledger registra, no hospeda)",

  verification: "dir-schema-valid (BLOCKING) — type COMPRESSION-LEDGER-v1 declarado",
}

⟦ /readme ⟧
