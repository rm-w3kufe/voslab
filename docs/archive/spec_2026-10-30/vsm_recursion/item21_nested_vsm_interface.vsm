@vsm 0.3

// ─── ITEM_21: MINIMAL VIABLE NESTED INTERFACE (MVNI) — genuine VSM recursion ──
// Author: Claude (Fable) 2026-07-02 | Status: DESIGN COMPLETE | Impl: DS [S] §4
// Canon aligned: docs/theory/recursive_vsm_theory.md (recursion axiom, §11 reframe)
//                docs/theory/recursive_channel_protocol.vsm (5 channel contracts)
//                DSN-EVC-01 (integration by certification) | A4, A5, R10 inherited.

// ─── 1. THE STRUCTURAL FINDING ────────────────────────────────────────────────
//
// s1-clima L3 nodes are ALREADY proto-VSMs, closer than the task assumed:
//   HAVE: per-node Ω (monthly {var:{lo,hi,mean}} in /var/lib/vsf-clima/omega/),
//         per-node stasis_cos, algedonic emission (sev≥8), own crash domain
//         (vsf-clima-l3@s1-santiago is its own systemd instance).
//   LACK: decision authority (they compute, never decide), refusal capability
//         (φ↓ is obeyed unconditionally), self-certification (declared, not
//         certified), and a covenant floor of their own.
//
// ⇒ The data-level / nested-VSM boundary is NOT about having S1-S5 boxes drawn;
//   it is three capabilities: DECIDE within an envelope, REFUSE outside it,
//   CERTIFY yourself to your parent. That is what MVNI specifies.

// ─── 2. MVNI — the six requirements ──────────────────────────────────────────

N1_own_homeostat: "sense → compare-to-OWN-Ω → act. For observer-class domains
  (climate: cannot actuate the weather) the actuator is REFLEXIVE: the node
  adjusts its own operation — sampling cadence, model parameters, requested
  budget. An observer that regulates its own observing is a viable system;
  one that just emits numbers is a sensor."

N2_own_omega_certified: "local Ω with calibration PROVENANCE: the Fierro Q1-Q3
  protocol applied per node (fierro_q123.py already runs at domain level —
  reuse per-node). Ω_child relates to parent by PROJECTION COMPATIBILITY:
  π_parent(Ω_child) ⊆ Ω_parent's tolerance band for that unit (validator check),
  not equality — the child sees finer structure than the parent's aggregate."

N3_own_s3: "local resource authority WITHIN the parent grant: the node owns
  micro-decisions (cadence up/down, cache size, retry budget) and REQUESTS
  envelope changes via φ↑ (never self-grants — A3 budget ceiling inherited).
  This is where 'decides' becomes real: an if-tree over its own Ω margins, R10
  deterministic, no LLM."

N4_covenant_floor_inherited: "S5_child = covenant.vsm@pinned-hash (A0/A0.1
  non-overridable, downward propagation) + a LOCAL policy space strictly inside
  the parent A5 ceiling. The child's viability.yaml declares the hash; the
  certifier verifies it. A child that could re-derive its own ethics floor
  would be a capture vector — this is the anti-capture axiom recursed."

N5_channels_per_protocol: "exactly recursive_channel_protocol.vsm: typed φ↑
  (attenuation upward), bounded φ↓ (amplification downward, WITH refusal — see
  N6), algedonic bypass child→parent.S5 (severity ≥8 skips the S3 chain),
  S2 mediated by parent (no sibling links, A4), ψ gated by D11 preconditions.
  REFUSAL RIGHT (activates seed S1-PHI-DOWN-GUARD): a φ↓ directive that would
  push the child outside its OWN certified Ω is rejected with a typed
  phi_down_refusal event carrying the violated bound as evidence — the
  TRIAGE-EVIDENCE-RULE pattern, recursed downward. Refusal is auditable,
  never silent."

N6_certification_not_declaration: "DSN-EVC-01 operationalized: the node embeds
  a minimal certifier that emits a SIGNED attestation
    {node_id, omega_calibration: {method, window, Q1Q2Q3 verdicts},
     homeostat_demo: {perturbation, response, recovered_s},
     covenant_hash, validator_gate: nested, ts, sig}
  Key chain: node key certified by the offline S5 CA (existing C1 two-level
  trust — no new PKI). Parent S3* verifies sporadically; state.db registers
  the child as a component WITH attestation ref. Un-attested children are
  RECON-BIDIRECTIONAL findings, not members."

// ─── 3. WHAT CHANGES CONCEPTUALLY ────────────────────────────────────────────

level_relativity: "with MVNI, 'L3' stops being a data tier and becomes a full
  V(s1-santiago, L=1) whose parent happens to be V(s1-clima). reframe() (§11
  theory) applies: any analysis can re-anchor at santiago and see ITS S1-S5.
  Depth policy: 2 for now (domain → node); deeper nesting needs no new theory,
  only budget."
honest_scope: "climate nodes are observer-class: their S1 'operations' produce
  certified observations. This is NOT a limitation of the design — it is the
  first of the two VSM classes (observer / actuator). s1-econ nodes (sectors?)
  would pilot the actuator class later."

// ─── 4. PILOT: s1-santiago (DS [S], 5 phases) ─────────────────────────────────

impl = [
  "P1 viability.yaml for santiago (recursive:true, vsf_ref: s1-clima, S1=observe
      +self-regulate, S3=micro-budget tree, S5=covenant hash) + validator.py
      extension: --gate=nested checks N2 projection-compatibility + N4 hash +
      channel declarations. Pure python, testable offline.",
  "P2 per-node Fierro cert: run fierro_q123.py scoped to santiago's Ω/history →
      Q1/Q2 verdicts into the attestation payload.",
  "P3 micro-S3: cadence self-adjustment (margin thin → densify sampling; fat →
      relax) + budget-request φ↑ event. Deterministic if-tree, unit-tested.",
  "P4 refusal guard: φ↓ handler validates directive against own Ω → obey | refuse
      with phi_down_refusal(evidence). Test: inject an out-of-bounds directive
      on 108 → typed refusal, node stays in Ω, parent sees the event.",
  "P5 attestation: certifier module + S5-CA-signed node key + parent S3* verify
      path + state.db component row. THEN: santiago is the first certified
      nested VSM; generalization to the other 11 nodes is config, not code.",
]
success = ["validator --gate=nested PASS", "out-of-bounds φ↓ refused with evidence",
           "attestation verified by S3*", "santiago crash → domain survives (already
           true via systemd) + parent notices via emit_silence on the node"]
unblocks = ["S1-PHI-DOWN-GUARD (seed → implemented as N5 refusal)",
            "DSN-EVC-01 phase: first embedded certifier in production",
            "recursive_vsm_theory.md: first empirical instantiation of the
             recursion axiom", "actuator-class pilot on s1-econ (future)"]
