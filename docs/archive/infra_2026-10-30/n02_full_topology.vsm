// ═══════════════════════════════════════════════════════════════════════════════
// SECCIÓN 4 — FLUJO BBH: PIPELINE + PROXY CHAIN
// ═══════════════════════════════════════════════════════════════════════════════

flow("bbh-pipeline") {

  // ── Flujo normal (automated, 24/7) ───────────────────────────────────────────

  trigger = "passive_recon_continuous.py (cada 6h) ó manual bbh_pipeline.py"

  step(1) {
    name   = "S4 selecciona target"
    actor  = "S4 orchestrator (Kali LXC)"
    action = "H1 API → fetch programas → score → seleccionar candidato"
    out    = "target seleccionado con scope + restrictions.json"
    model  = "qwen2.5-coder:7b @ Ollama LXC (10.10.20.10:11434)"
  }

  step(2) {
    name   = "P0 Profile"
    actor  = "Kali LXC / 0_profile.py"
    action = "H1 API → policy analysis → restrictions.json + directory setup"
    out    = "~/bbh/targets/<t>/profile.json + scope/"
  }

  step(3) {
    name   = "P1 Passive"
    actor  = "Kali LXC / 1_passive.py"
    tools  = ["subfinder", "amass", "crt.sh", "certspotter", "OTX", "URLScan"]
    proxy  = "Privoxy 8118 → SOCKS5 1080 (SSH tunnel n01 ó Tor)"
    out    = "scope/subdomains.txt (~1k-50k subdominios)"
  }

  step(4) {
    name   = "P2 Active"
    actor  = "Kali LXC / 2_active.py"
    tools  = ["dnsx", "httpx", "gau", "waybackurls", "katana", "hakrawler"]
    proxy  = "Privoxy 8118 (herramientas que lo soportan)"
    out    = "recon/active/httpx_live.txt + all_urls_clean.txt + gate.md"
  }

  step(5) {
    name   = "P3 Enum"
    actor  = "Kali LXC / 3_enum.py"
    tools  = ["arjun", "paramspider", "ffuf", "gf × 8 patterns", "gf_scorer"]
    out    = "enum/param_candidates_scored.txt + gf_scored/"
  }

  step(6) {
    name   = "P4 Vuln"
    actor  = "Kali LXC / 4_vuln.py"
    classes = 19  // ver Sección 3
    oob    = "interactsh-client (SSRF blind callbacks)"
    proxy  = "Privoxy 8118 para nuclei/sqlmap en modo proxy"
    gate   = "scope_gate() + restrictions.json → nunca toca OOS"
    out    = "recon/vulns/*.txt"
  }

  step(7) {
    name  = "P5 Report"
    actor = "Kali LXC / 5_report.py"
    out   = "report/  (markdown + evidencia para H1 submission)"
  }

  // ── Proxy chain detail ───────────────────────────────────────────────────────

  proxy_chain("bbh-automated") {
    tool  →  Privoxy(127.0.0.1:8118)  →  SOCKS5(127.0.0.1:1080)  →  [Internet]

    socks5_backends = {
      "opción A — SSH dynamic": {
        cmd    = "ssh -D 1080 -N -q rmw3@n01.u2738.org"
        egress = "IP pública de n01 — IP fija, mejor para H1 rate limits"
        latency = "bajo"
      }
      "opción B — Tor": {
        cmd    = "systemctl start tor"
        egress = "exit node Tor — IP aleatoria, mayor anonimato"
        latency = "alto — desaconsejar para active recon"
        use_case = "OSINT únicamente (P1)"
      }
      "opción C — direct": {
        egress = "IP del router doméstico"
        use_case = "testing sin proxy, velocidad máxima"
      }
    }
  }

  proxy_chain("bbh-manual") {
    // Para pentesting manual / verificación de findings
    browser/tool  →  mitmproxy(127.0.0.1:8080)  →  [Internet ó Burp Suite]
    note = "mitmproxy para inspección; Burp Suite para testing interactivo"
  }
}


// ═══════════════════════════════════════════════════════════════════════════════
// SECCIÓN 5 — REGLAS DE FIREWALL PROXMOX HOST
// ═══════════════════════════════════════════════════════════════════════════════

firewall("proxmox-host") {

  // REGLA CRÍTICA DE SEGURIDAD ANTES DE HABILITAR:
  // Mantener sesión SSH abierta durante toda la aplicación de reglas.
  // Test: conectar desde una segunda terminal ANTES de aplicar DROP default.
  // Rollback: pvesh set /nodes/n02/firewall/options --enable 0

  policy_input  = DROP    // default DROP para input
  policy_output = ACCEPT  // output del host sin restricción
  policy_forward = DROP   // sin forwarding en el host (maneja el router LXC)

  rules_input = [

    // ── Acceso SSH al host ──────────────────────────────────────────────────
    rule(1) {
      action = ACCEPT
      proto  = tcp
      src    = "127.0.0.1"    // tunnel autossh
      dport  = 22
      note   = "SSH via reverse tunnel desde n01"
    }
    rule(2) {
      action = ACCEPT
      proto  = tcp
      src    = "192.168.0.0/24"  // LAN doméstica
      dport  = 22
      note   = "SSH desde LAN"
    }

    // ── Proxmox Web UI ──────────────────────────────────────────────────────
    rule(3) {
      action = ACCEPT
      proto  = tcp
      src    = "127.0.0.1"
      dport  = 8006
      note   = "Web UI via tunnel (port forward SSH)"
    }
    rule(4) {
      action = ACCEPT
      proto  = tcp
      src    = "192.168.0.0/24"
      dport  = 8006
      note   = "Web UI desde LAN"
    }

    // ── Loopback ────────────────────────────────────────────────────────────
    rule(5) {
      action = ACCEPT
      iface  = lo
      note   = "loopback siempre permitido"
    }

    // ── Established connections ─────────────────────────────────────────────
    rule(6) {
      action = ACCEPT
      state  = ["RELATED", "ESTABLISHED"]
      note   = "respuestas a conexiones iniciadas por el host"
    }

    // ── ICMP (ping) desde LAN ───────────────────────────────────────────────
    rule(7) {
      action = ACCEPT
      proto  = icmp
      src    = "192.168.0.0/24"
    }

    // ── DEFAULT DROP — todo lo demás ─────────────────────────────────────────
    // (implícito por policy_input = DROP)
  ]

  // Notas sobre VLANs — el firewall de VMs/LXCs gestiona el inter-VLAN routing
  // El host aplica reglas adicionales a nivel de bridge (ebtables / Proxmox SDN)
  // si se habilita Proxmox SDN en fase futura.
}


// ═══════════════════════════════════════════════════════════════════════════════
// SECCIÓN 6 — PLAN DE IMPLEMENTACIÓN (fases ordenadas)
// ═══════════════════════════════════════════════════════════════════════════════

implementation_plan("n02-v1") {

  precondition {
    check("reboot n02") {
      reason  = "kernel 6.17.13-3-pve instalado pero no activo"
      risk    = "LOW — el tunnel se restablece solo via autossh"
      verify  = "uname -r muestra 6.17.13-3-pve tras reconexión"
    }
    check("SSH session open") {
      reason  = "cualquier cambio de red/firewall requiere sesión abierta como respaldo"
    }
  }

  phase("W1 — S5 Hardening Proxmox host") {
    status = "COMPLETO (W1.1–W1.6 done 2026-04-24)"

    step("W1.6 — Firewall Proxmox host") {
      status   = DONE
      result   = [
        "/etc/pve/firewall/cluster.fw  — enable: 1",
        "/etc/pve/firewall/n02.fw      — policy_in: DROP, ACCEPT 127.0.0.1:22 + 192.168.0.0/24:22+8006",
        "pve-firewall status: enabled/running",
        "PVEFW-0-management-v4 ipset = 192.168.0.0/24 (auto-detected)",
        "loopback ACCEPT (cubre túnel inverso desde 127.0.0.1)",
        "ESTABLISHED/RELATED ACCEPT, final DROP activo",
        "SSH via túnel inverso y web UI 8006 verificados en vivo",
      ]
    }
  }

  phase("W2 — VLAN-aware bridge") {
    priority = HIGH
    status   = "W2.1+W2.2 COMPLETO (2026-04-24)"

    step("W2.1 — Habilitar VLAN filtering en vmbr0") {
      status = DONE
      result = [
        "bridge-vlan-aware yes + bridge-vids 2-4094 en /etc/network/interfaces",
        "nic0 PVID=1 (nativo untagged), VLANs 2-4094 activas en bridge",
        "gateway 192.168.0.1 alcanzable: 0% loss",
      ]
    }

    step("W2.2 — Crear interfaces VLAN con routing + NAT") {
      status = DONE
      result = [
        "vmbr0.10 UP — 10.10.10.1/24 (mgmt: Netdata, Telemetry)",
        "vmbr0.20 UP — 10.10.20.1/24 (services: Ollama, nucleus)",
        "vmbr0.30 UP — 10.10.30.1/24 (hunting: Kali)",
        "net.ipv4.ip_forward=1 persistente en /etc/sysctl.d/99-vsf-routing.conf",
        "vsf-nat-vlans.service activo — MASQUERADE para 10.10.{10,20,30}.0/24 → vmbr0",
        "Nota: post-up hooks de ifupdown2 duplican reglas — usar systemd service en su lugar",
      ]
    }

    step("W2.3 — Asignar Kali (VM 100) a VLAN 30") {
      status = DONE
      result = [
        "qm set 100 --net0 virtio=BC:24:11:18:64:73,bridge=vmbr0,tag=30",
        "eth0 en Kali: IP 10.10.30.100/24, gateway 10.10.30.1 (via guest agent)",
        "ping 10.10.30.1 desde host: 0% loss",
        "ping 1.1.1.1 desde Kali: 0% loss — NAT funcional",
        "Firewall Kali: enable=1, SSH LAN + JupyterLab:8888 via tunnel",
        "LECCIÓN: /etc/network/interfaces en Kali usa eth0 (no ens18); ifreload elimina stanzas si se borran del archivo",
      ]
      firewall_applied = [
        "pvesh set /nodes/n02/qemu/100/firewall/options --enable 1",
        "pvesh create .../rules ACCEPT SSH 192.168.0.0/24:22  (enable=1)",
        "pvesh create .../rules ACCEPT JupyterLab 127.0.0.1:8888 (enable=1)",
      ]
    }
  }

  // PROTOCOLO OBLIGATORIO — toda nueva VM/LXC sigue este orden:
  // 1. pct/qm create con --net0 bridge=vmbr0,tag={vlan},ip={ip}/24  ← VLAN en creación
  // 2. Instalar workload
  // 3. Firewall ANTES de exponer servicio:
  //      pvesh set /nodes/n02/{lxc|qemu}/{vmid}/firewall/options --enable 1
  //      pvesh create .../firewall/rules --action ACCEPT --type in ... --comment '...'
  //      pvesh set .../firewall/rules/{pos} --enable 1   ← OBLIGATORIO: pvesh crea con enable=0
  // Regla mínima siempre presente: SSH mgmt desde 192.168.0.0/24

  phase("W3 — Crear LXCs de servicios") {
    priority = MEDIUM
    depends_on = "W2 completo"

    step("W3.0 — Firewall LXC 104 (telemetría — ya corriendo)") {
      note   = "LXC 104 creada antes del protocolo — aplicar firewall retroactivo"
      firewall = {
        policy_in = DROP
        rules = [
          "pvesh set /nodes/n02/lxc/104/firewall/options --enable 1",
          "pvesh create /nodes/n02/lxc/104/firewall/rules --action ACCEPT --type in --source 10.10.0.0/16 --proto tcp --dport 22 --log nolog --comment 'SSH desde red interna'",
          "pvesh create /nodes/n02/lxc/104/firewall/rules --action ACCEPT --type in --source 192.168.0.0/24 --proto tcp --dport 22 --log nolog --comment 'SSH mgmt LAN'",
        ]
      }
    }

    step("W3.1 — Ollama LXC (101)") {
      status = DONE  // 2026-04-24
      vlan = 20
      ip   = "10.10.20.10"
      result = [
        "LXC 101 creada: debian-12-standard_12.12-1, 8GB RAM, 4 cores, 20GB disk (ampliado desde 12GB)",
        "Ollama v0.21.2 instalado y activo (systemctl is-active: active)",
        "Modelos migrados via tar pipe (4.4GB): qwen2.5-coder:7b — API /api/tags OK",
        "Ollama bare metal detenido y deshabilitado (systemctl disable ollama)",
        "Firewall: enable=1, ACCEPT 10.10.0.0/16:11434 + ACCEPT 192.168.0.0/24:22",
        "LECCIÓN: disco 12GB insuficiente para Debian+Ollama+modelos — usar ≥20GB",
        "LECCIÓN: modelos en /usr/share/ollama/.ollama/models/ (usuario system 'ollama'), no ~/.ollama/",
        "LECCIÓN: tar pipe via 'pct exec {id} -- tar -xf -' es el método para LXC con LVM storage",
      ]
    }

    step("W3.2 — vsf-nucleus LXC (102)") {
      status = DONE  // 2026-04-24
      vlan = 20
      ip   = "10.10.20.11"
      result = [
        "LXC 102 creada: debian-12-standard_12.12-1, 1GB RAM, 2 cores, 4GB disk",
        "Binarios migrados via pct push: /usr/local/bin/vsf-nucleus + vsf-nucleus-control",
        "vsf-nucleus v0.0.1 ejecuta correctamente dentro del LXC",
        "Firewall: enable=1, ACCEPT 192.168.0.0/24:22",
        "NOTA: vsf-nucleus es CLI (no daemon) — sin estado persistente externo en bare metal",
      ]
    }

    step("W3.3 — Netdata LXC (103)") {
      status = DONE  // 2026-04-24
      vlan = 10
      ip   = "10.10.10.10"
      result = [
        "LXC 103 creada: debian-12-standard_12.12-1, 512MB RAM, 1 core, 4GB disk, nesting=1",
        "Netdata instalado via get.netdata.cloud/kickstart.sh --non-interactive --stable-channel",
        "Netdata activo: systemctl is-active=active, API v3 respondiendo en :19999",
        "Firewall: enable=1, ACCEPT 10.10.0.0/16:19999 + ACCEPT 192.168.0.0/24:22",
        "Acceso: ssh -L 19999:10.10.10.10:19999 n02-tunnel → http://localhost:19999",
        "LECCIÓN: Debian minimal no trae curl — instalar prereqs antes del kickstart.sh",
        "LECCIÓN: Netdata systemd requiere nesting=1 en el LXC",
        "PENDIENTE: configurar agentes en Kali + Ollama LXC (W3.3b)",
      ]
    }
  }

  phase("W4 — JupyterLab en Kali LXC") {
    status = DONE  // 2026-04-25
    result = [
      "jupyterlab 4.0.11 instalado via apt en Kali (ya estaba en repo Kali)",
      "Servicio systemd: /etc/systemd/system/jupyterlab.service",
      "  Environment=OLLAMA_URL=http://10.10.20.10:11434",
      "  ExecStart=/usr/bin/jupyter-lab --no-browser --ip=127.0.0.1 --port=8888 --NotebookApp.token=''",
      "  is-active: active",
      "Acceso desde WSL2: ssh -L 8888:localhost:8888 -J n02-tunnel root@10.10.30.100",
      "LECCIÓN: binario es 'jupyter-lab' no 'jupyter' en paquete Kali",
    ]
  }

  phase("W5 — Migrar BBH a Kali LXC") {
    status = DONE  // 2026-04-25
    result = [
      "Scripts rsync desde /root/vsf-bbh/ (n02) → /root/bbh/ (Kali 10.10.30.100)",
      "SSH key de n02 autorizada en Kali via guest agent para rsync sin contraseña",
      "OLLAMA_URL=http://10.10.20.10:11434 como env var en jupyterlab.service",
      "Dry-run desde Kali: PASS — target=shopify.com score=53.9, S4 funcionando via VLAN20",
      "Ollama LXC configurado con OLLAMA_HOST=0.0.0.0:11434 (default era 127.0.0.1)",
      "Fix page cache: sync && echo 3 > /proc/sys/vm/drop_caches desde host (LXC unprivileged no puede)",
      "PENDIENTE W5.3: bbh-passive-continuous.service (W6.1 primero)",
    ]
  }

  phase("W6 — Validación final y limpieza bare metal") {
    priority = LOW
    depends_on = "W1-W5 completos"

    step("W6.1 — Verificar sistema completo") {
      checks = [
        "S4 orchestrator selecciona target → llama Ollama LXC OK",
        "BBH P0-P1 corren en Kali con proxy chain OK",
        "JupyterLab accesible via tunnel OK",
        "Netdata muestra todos los LXCs OK",
        "Firewall Proxmox activo — acceso SSH + web UI funcionando OK",
        "vsf-tunnel.service activo en n02 (autossh) OK",
      ]
    }

    step("W6.2 — Limpieza bare metal") {
      actions = [
        "Eliminar /root/vsf-bbh/ (migrado a Kali)",
        "Detener Ollama en bare metal (migrado a LXC 101)",
        "Detener vsf-nucleus en bare metal (migrado a LXC 102)",
        "Verificar: bare metal corre SOLO Proxmox + autossh + chrony + kernel",
      ]
    }
  }
}


