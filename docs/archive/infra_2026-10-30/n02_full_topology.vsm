@vsm 1.0
// DOCUMENTO DE DISEÑO — n02 Proxmox Full Topology
// V("n02-ecosystem", L=0..L=2)
//
// Estado: DISEÑO — no operar hasta validación humana
// Autor: sesión 2026-04-24
// Prerequisito: reboot n02 para activar kernel 6.17.13-3-pve (pendiente desde W1.5)
//
// Este documento es la fuente de verdad para:
//   — segmentación de red (VLANs)
//   — inventario de workloads (LXC/VM)
//   — flujo del pipeline BBH
//   — reglas de firewall
//   — plan de implementación ordenado
//
// Convención VSL: spec→ spec completo del componente; ref→ puntero a otro spec

// ═══════════════════════════════════════════════════════════════════════════════
// SECCIÓN 1 — TOPOLOGÍA FÍSICA Y DE RED
// ═══════════════════════════════════════════════════════════════════════════════

topology("n02-ecosystem") {

  // ── Nodos físicos ────────────────────────────────────────────────────────────

  node("n01") {
    role     = "bastion / relay"
    ip       = "fija — n01.u2738.org"
    location = "VPS remoto"
    services = ["autossh receptor", "reverse tunnel endpoint", "SSH relay"]
    tunnel_port = 2290  // puerto donde llega el reverse tunnel desde n02
    note     = "n02 se conecta a n01, no al revés — n02 está detrás de NAT"
  }

  node("n02") {
    role       = "Proxmox bare metal hypervisor"
    ip_lan     = "192.168.0.X"  // DHCP local — confirmar con ip addr
    ip_tunnel  = "127.0.0.1"    // así llega el tráfico del tunnel autossh
    location   = "red doméstica detrás de router NAT"
    hypervisor = "Proxmox VE 9.1.1"
    kernel     = "6.17.13-3-pve (instalado, reboot pendiente)"
    ram        = "23 GB"
    disk_total = "94 GB"
    disk_free  = "~18 GB"  // RESTRICCIÓN CRÍTICA — diseño ajustado a esto
    access_paths = [
      "LAN: ssh rmw3@192.168.0.X (directo)",
      "Remoto: ssh -p 2290 rmw3@n01.u2738.org → llega a n02 como 127.0.0.1",
      "Web UI: http://n02:8006 (LAN) ó tunnel HTTP hacia 8006",
    ]
  }

  // ── Canal de acceso remoto ───────────────────────────────────────────────────

  channel("reverse-tunnel") {
    type    = "autossh reverse SSH"
    path    = "n02 → n01"
    command = "autossh -M 0 -R 2290:localhost:22 rmw3@n01.u2738.org"
    service = "vsf-tunnel.service (systemd, n02)"
    notes   = [
      "Tráfico llega a n02 como 127.0.0.1 — CRÍTICO para reglas de firewall",
      "Permite SSH + SOCKS proxy hacia n02 sin abrir puertos en el router",
    ]
  }
}


// ═══════════════════════════════════════════════════════════════════════════════
// SECCIÓN 2 — DISEÑO DE VLANs
// ═══════════════════════════════════════════════════════════════════════════════

network("n02-vlans") {

  bridge("vmbr0") {
    type   = "Linux bridge VLAN-aware"
    note   = "Reemplaza el bridge plano actual — habilitar vlan_filtering=1"
    ports  = ["NIC física (enp3s0 o similar)"]
    status = "PENDIENTE — requiere editar /etc/network/interfaces"
  }

  vlan(10) {
    name    = "mgmt"
    subnet  = "10.10.10.0/24"
    gateway = "10.10.10.1"  // Proxmox host
    purpose = "Gestión del hypervisor — Proxmox web UI, SSH host"
    members = [
      "Proxmox host: 10.10.10.1",
      "Netdata LXC: 10.10.10.10",
    ]
    firewall_policy = "RESTRICTIVE — solo desde 127.0.0.1 y 192.168.0.0/24"
  }

  vlan(20) {
    name    = "services"
    subnet  = "10.10.20.0/24"
    gateway = "10.10.20.1"
    purpose = "Servicios internos — sin acceso directo a internet"
    members = [
      "Ollama LXC:       10.10.20.10   // inference engine",
      "vsf-nucleus LXC:  10.10.20.11   // Rust governance kernel",
    ]
    internet_access = false
    firewall_policy = "ISOLATED — solo tráfico interno entre VLANs autorizadas"
    note = "Ollama no necesita internet en operación normal — modelos ya descargados"
  }

  vlan(30) {
    name    = "hunting"
    subnet  = "10.10.30.0/24"
    gateway = "10.10.30.1"
    purpose = "BBH traffic — tráfico de recon hacia internet"
    members = [
      "Kali LXC (VM 100): 10.10.30.100",
    ]
    internet_access = true
    egress_route    = "via router LAN (192.168.0.1) — NAT hacia internet"
    proxy_chain     = "ver Sección 4"
    firewall_policy = "EGRESS-ONLY — solo salida permitida; no servicios expuestos"
  }

  vlan(40) {
    name    = "lab"
    subnet  = "10.10.40.0/24"
    purpose = "Experimental — workloads no validados, tests destructivos"
    members = []  // vacío en v1 — reservado para futura expansión
    internet_access = "opcional por sesión"
    status  = "RESERVADO — no implementar en fase inicial"
  }

  // ── Tabla de inter-VLAN routing ─────────────────────────────────────────────

  routing_policy {
    // Quién puede hablar con quién
    allow("vlan30 → vlan20") {
      reason  = "Kali necesita llamar a Ollama API (port 11434)"
      port    = 11434
      proto   = tcp
    }
    allow("vlan30 → vlan20:vsf-nucleus") {
      reason  = "S4 orchestrator en Kali → vsl_channel SQLite está en Kali, no en nucleus"
      note    = "Kali es self-contained — nucleus es independiente en v1"
    }
    allow("vlan10 → vlan20") {
      reason  = "Proxmox + Netdata pueden monitorear services LXCs"
    }
    allow("vlan10 → vlan30") {
      reason  = "Gestión SSH desde host hacia Kali LXC"
    }
    deny("vlan20 → internet") {
      reason  = "Ollama y nucleus no deben tener acceso directo a internet"
    }
    deny("vlan40 → vlan20") {
      reason  = "Lab no puede contaminar services"
    }
    deny("vlan30 → vlan10") {
      reason  = "Kali comprometido no puede alcanzar gestión de Proxmox"
    }
  }
}


// ═══════════════════════════════════════════════════════════════════════════════
// SECCIÓN 3 — INVENTARIO DE WORKLOADS (VSM roles)
// ═══════════════════════════════════════════════════════════════════════════════
// ESTADO: ACTUALIZADO 2026-05-22 — Arquitectura real vs documento anterior
//
// Mapa VSM del ecosistema n02:
//
//  S5 Policy        ← Proxmox firewall + VLAN rules (este documento)
//  S4 Intelligence  ← S4 orchestrator Python (qwen2.5-coder via Ollama LXC 101)
//                  + asc-rust subagent (code analysis) en LXC 107
//  S3 Control       ← vsf-nucleus (Rust kernel, trust=1.0, gobernanza) LXC 102
//  S3* Audit        ← Telemetry LXC 104 (algedónico — alertas de anomalía)
//  S2 Coordination  ← BBS (Bulletin Board System) LXC 106 + vsl_channel
//  S2 Helpers       ← asc-paper, asc-exp subagents en LXC 107
//  S1 Operations    ← Kali VM 100 (BBH phases P0-P5)
//                  + bbh-prod LXC 105 (S1 production instance)

workload("Kali-LXC") {
  id       = "VM 100"
  vsm_role = S1  // operaciones BBH + contexto de ejecución
  vlan     = 30  // hunting — acceso a internet
  ip       = "10.10.30.100"
  os       = "Kali Linux 2024.x"
  disk_alloc = "~30 GB"  // ya asignado al crear la VM
  status   = "RUNNING — operacional ahora"

  services = {
    bbh_pipeline: {
      path    = "~/bbh/scripts/  (migrar desde ~/claude/tools/scripts/)"
      phases  = ["P0 profile", "P1 passive", "P2 active", "P3 enum", "P4 vuln", "P5 report"]
      runner  = "bbh_pipeline.py --target <t> --domain <d>"
      continuous = "passive_recon_continuous.py (systemd service)"
    }
    s4_orchestrator: {
      path    = "~/vsf-bbh/  (migrar desde /root/vsf-bbh/ bare metal)"
      model   = "qwen2.5-coder:7b via Ollama LXC (10.10.20.10:11434)"
      runner  = "run_orchestrator.py --ollama-url http://10.10.20.10:11434"
    }
    jupyterlab: {
      port    = 8888
      bind    = "127.0.0.1"  // NO exponer directo — acceso via SSH tunnel
      access  = "ssh -L 8888:localhost:8888 <kali-ip> desde WSL2"
      purpose = "notebooks de análisis, exploración de resultados BBH, OSINT"
      note    = "misma VM que BBH → acceso directo a ~/bbh/targets/ sin copias"
    }
    privoxy: {
      port    = 8118
      bind    = "127.0.0.1"
      config  = "forward-socks5 / . 127.0.0.1:1080 ."
      purpose = "HTTP proxy para herramientas BBH (--proxy http://127.0.0.1:8118)"
    }
    tor_or_socks: {
      port    = 1080
      options = [
        "opción A: Tor (apt install tor) → anonimato, lento",
        "opción B: SSH dynamic tunnel hacia n01 (-D 1080) → más rápido, IP de n01",
        "opción C: Sin proxy (directo) → más rápido, IP real del router",
      ]
      recommended = "opción B para BBH — velocidad + separación de IP"
    }
    mitmproxy: {
      port    = 8080
      purpose = "inspección manual durante fases activas y verificación de findings"
      mode    = "manual — lanzar por sesión, no como servicio permanente"
    }
  }

  tools_preinstalled = [
    "subfinder", "amass", "dnsx", "httpx", "gau", "waybackurls",
    "katana", "hakrawler", "subjs", "gf", "qsreplace",
    "nuclei", "sqlmap", "ffuf", "arjun", "dalfox", "crlfuzz",
    "mitmproxy", "burpsuite", "metasploit",
    "SecLists (/usr/share/seclists/)",
  ]
  tools_to_install = [
    "paramspider (pip)", "ghauri (pip)", "jwt_tool (git clone)",
    "interactsh-client (go install)",
    "JupyterLab (pip)", "Privoxy (apt)", "Tor (apt)",
  ]

  migration_from_bare_metal = {
    source   = "/root/vsf-bbh/ en Proxmox host"
    dest     = "~/vsf-bbh/ en Kali LXC"
    method   = "scp o rsync via SSH"
    priority = "task W5 — tras VLAN setup"
  }
}


workload("Ollama-LXC") {
  id       = "LXC 101 (nuevo)"
  vsm_role = S1  // inference unit — responde a S4
  vlan     = 20  // services — sin internet
  ip       = "10.10.20.10"
  os       = "Debian 12 minimal"
  disk_alloc = "~12 GB"  // Debian ~2GB + qwen2.5-coder:7b ~4.7GB + margen
  ram_alloc  = "8 GB"
  status   = "DISEÑO — migrar desde bare metal"

  services = {
    ollama: {
      port    = 11434
      bind    = "0.0.0.0"  // accesible desde otras VLANs autorizadas
      models  = ["qwen2.5-coder:7b"]  // ya descargado en bare metal
      migration = "copiar ~/.ollama/models/ desde bare metal al LXC"
    }
  }

  note = "Al migrar Ollama al LXC se libera RAM del bare metal para otros workloads"
}


workload("vsf-nucleus-LXC") {
  id       = "LXC 102 (nuevo)"
  vsm_role = S3  // control + gobernanza
  vlan     = 20  // services
  ip       = "10.10.20.11"
  os       = "Debian 12 minimal"
  disk_alloc = "~4 GB"
  ram_alloc  = "1 GB"
  status   = "DISEÑO — migrar desde bare metal"

  services = {
    vsf_nucleus: {
      binary  = "vsf-nucleus (Rust)"
      state   = "trust=1.0, governed, activo en n02"
      storage = "SQLite + config files"
      api     = "HTTP internal (port TBD)"
    }
  }
}


workload("Telemetry-LXC") {
  id       = "LXC 104 (ACTIVO)"
  vsm_role = "S3*"  // audit algedónico — ve lo que S3 no ve
  vlan     = 10  // mgmt — acceso a host + VLANs
  ip       = "10.10.10.10"  // Revisar dirección real
  os       = "Debian 12 minimal"
  disk_alloc = "~8 GB"
  ram_alloc  = "256 MB"  // (reducido de 512 MB — 2026-05-22)
  status   = "RUNNING — telemetría + alertas"

  services = {
    netdata: {
      port    = 19999
      bind    = "127.0.0.1"
      access  = "SSH tunnel para inspección; NO exponer a internet"
      monitors = ["Proxmox host", "Kali VM", "Ollama LXC", "vsf-nucleus LXC", "bbh-prod LXC", "bbs LXC", "subagents LXC"]
      alerts  = "algedónico: CPU spike, disk fill, network anomaly, tunnel down"
    }
  }
}


