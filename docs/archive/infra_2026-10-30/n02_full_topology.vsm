  id       = "LXC 106 (ACTIVO)"
  vsm_role = "S2"  // Bulletin Board System — coordinación entre S1 units
  vlan     = 20  // services — sin internet
  ip       = "10.10.20.20"
  os       = "Debian 12 minimal"
  disk_alloc = "~4 GB"
  ram_alloc  = "256 MB"  // (reducido de 512 MB — 2026-05-22)
  status   = "RUNNING — signal bus operacional"

  services = {
    bbs: {
      port    = 8600
      api_endpoint = "/health"
      purpose = "S1-S2 message passing, finding escalation, decision gates"
      test    = "curl http://localhost:8600/health"
    }
