  id       = "LXC 105 (ACTIVO)"
  vsm_role = "S1"  // production instance de BBH operations
  vlan     = 30  // hunting — acceso a internet
  ip       = "10.10.30.110"
  os       = "Debian 12 minimal"
  disk_alloc = "~20 GB"
  ram_alloc  = "2 GB"
  status   = "RUNNING — S1 production"

  services = {
    bbh_pipeline_prod: {
      path    = "~/bbh/"
      phases  = ["P0", "P1", "P2", "P3", "P4", "P5"]
