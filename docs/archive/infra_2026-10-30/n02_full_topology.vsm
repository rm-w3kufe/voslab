  id       = "LXC 107 (NUEVO — 2026-05-22)"
  vsm_role = "S2/S4"  // helpers para coordinación + análisis
  vlan     = 20  // services — sin internet
  ip       = "10.10.20.30"
  os       = "Debian 12 minimal"
  disk_alloc = "~10 GB"
  ram_alloc  = "5 GB"
  status   = "RUNNING — servicios configurados"

  services = {
    asc_paper: {
      type    = "Python systemd service"
      purpose = "Generación de papers + reportes"
      model   = "Claude API (S4 orchestrator, vía internet)"
      ram     = "1-2 GB pico"
      runner  = "systemctl start asc-paper"
    }
    asc_rust: {
      type    = "Python systemd service"
      purpose = "Análisis de código Rust, AST parsing"
