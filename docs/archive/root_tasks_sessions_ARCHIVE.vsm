task("LXC104-NETWORK-FIX-2026-08-04", priority=P1, agent=ds, status=complete_2026_08_04) = {
  what: "Fix LXC104 networking.service failure ('RTNETLINK File exists' on
      eth1 at boot) that kept network-online.target inactive and prevented
      the 5 S5 services from auto-starting on fresh boot (residual #2 from
      the nesting-fix report). rmw3 dispatch: 'puedes solucionar el
      problema de red?'",
  root_cause_proven: "NOT a duplicate IP (that was a red herring). `ifup -v
      eth1` shows: [ip addr add 10.10.20.104/24 → OK] [ip link set eth1 up
      → OK] [ip route add default via 10.10.20.1 dev eth1 onlink → FAILS:
      RTNETLINK File exists]. The gateway line on eth1 tried to install a
      SECOND default route (eth0 already provides default via 192.168.0.1);
      the kernel rejects a second default → ifup reports 'File exists' on
      eth1 → networking.service fails → cascade. The log line is
      misleading; only verbose ifup reveals the true failing command.",
  fix_applied: [
    "pct set 104 --net1 name=eth1,bridge=vmbr0,hwaddr=BC:24:11:96:D0:7C,
      tag=20,type=veth (removed ip=10.10.20.104/24 and gw=10.10.20.1 —
      Proxmox no longer manages eth1's address; ifupdown owns it, same
      pattern as eth0)",
    "/etc/network/interfaces eth1 stanza → static address 10.10.20.104/24
      with NO gateway line (eth0 provides the default route)",
  ],
  verified_fresh_boot_2026_08_04T19_20_46Z: [
    "networking.service active",
    "ifupdown-wait-online.service active",
    "network-online.target active",
    "failed units: NONE (was 2, previously 8)",
    "5/5 S5 services AUTO-STARTED (no manual nudge — vsf-s5-algedonic,
      vsf-s5-covenant, vsf-s5-ledger, vsf-g6-algedonic-sink,
      vsf-s3-phidown-actuator)",
    "eth1 inet 10.10.20.104/24; ping broker 10.10.20.20 → 0.035ms",
  ],
  backups: [
    "/etc/network/interfaces.bak-networkfix-20260804 (in 104)",
    "/root/lxc104_conf_backup_before_netfix_20260804.txt (host, pre-net1
      change)",
