session("2026-08-04-ds-network") = {
  summary: "LXC104 network problem SOLVED at root: networking.service
      failure was NOT a duplicate IP — it was a SECOND DEFAULT ROUTE. eth1's
      'gateway 10.10.20.1' line tried to install a default via 10.10.20.1
      while eth0 already owned default via 192.168.0.1; the kernel rejects a
      second default → 'RTNETLINK File exists' on eth1 → networking.service
      failed → network-online.target never reached → 5 S5 services did not
      auto-start on fresh boot. Proven via `ifup -v eth1` (the exact failing
      command), not guessed. Fix: removed gateway from eth1 stanza in
      /etc/network/interfaces + removed ip=/gw= from Proxmox net1 (pct set).
      Verified on a fresh boot (19:20:46Z): networking active, wait-online
      active, network-online.target active, ZERO failed units, 5/5 S5
      AUTO-STARTED (no manual nudge), eth1 10.10.20.104/24 up, broker ping
      0.035ms.",
  result: pass,
  resolved: [
    "LXC104-NETWORK-FIX-2026-08-04 — networking.service active on fresh
      boot; network-online.target active; 0 failed units; 5/5 S5 services
      auto-start (no nudge); report
      docs/deploy/lxc104_network_fix_2026-08-04_report.vsm committed",
  ],
  commits: [
    "(this session) docs(deploy): lxc104_network_fix_2026-08-04_report —
      root-caused second-default-route conflict, fix applied + verified on
      fresh boot (networking active, 0 failed, S5 auto-start)",
    "(this session) docs(tasks): LXC104-NETWORK-FIX-2026-08-04 complete +
      session close",
  ],
  verify: [
    "pct exec 104 systemctl is-active networking.service → active",
    "pct exec 104 systemctl is-active network-online.target → active",
    "pct exec 104 systemctl list-units --state=failed → empty",
    "pct exec 104 systemctl is-active vsf-s5-algedonic … → active x5
      (auto-started)",
    "pct exec 104 ip -4 addr show eth1 → inet 10.10.20.104/24",
    "pct exec 104 ping -c1 -W2 10.10.20.20 → 0.035ms",
    "ifup -v eth1 (pre-fix) → failing command was 'ip route add default
      via 10.10.20.1 dev eth1 onlink' → File exists",
  ],
  note: "Key learning: 'RTNETLINK File exists' from ifup is AMBIGUOUS — it
