// child/sandbox/boot-consolidation/TASK_SPEC.vsm — task root, READ THIS FIRST.
// Dispatch: child/docs/deploy/2026-08-13_parent_dispatch_boot_consolidation.vsm
// (PARENT-DISPATCH-BOOT-CONSOLIDATION-v1, 2026-08-13, commit 2f59d40).
// Directive rmw3 (2026-08-13): "child ejecute el plan y sus propuestas vivan
// ordenadas en su sandbox. antes de tocar nada en producción."
// → THIS IS DESIGN-ONLY. Production (plugins, agent prompts, boot, scripts,
//   RULES.md, opencode.json) is READ-ONLY in this task.

task_spec("BOOT-CONSOLIDATION") {

  // ════ WHAT ════
  what: "Design proposals M1-M6 for the boot-consolidation plan defined in
      the parent spec docs/spec_revision/sandbox/boot-ontology-pattern-v1/boot_ontology_pattern.vsm
      (5 layers, defects D1-D6, principles P1-P7, migration M1-M7). Each
      proposal lives in its own subdir under this task dir, mirrors the
      canonical home it targets, and is a DESIGN (schema, interface, text) —
      not an edit to production.",

  // ════ WHY ════
  why: "The boot order is written FOUR times (D1), the S3 prompt omits
      onboard.sh (D2), the reminder points at decoupled CLAUDE.md (D3), the
      R15 gate cites a retired rule id (D4), the OpenCode port lost the
      RESUMED branch of the reminder (D5 — incident class 2026-06-22 /
      2026-07-27), and the bash reminder is dead code under OpenCode (D6).
      The parent's ontology pattern names the fix: ONE manifest (P4) as the
      single index, a verifier (D_VERIFIER) that FAILS on the current tree,
      a reminder v2 with both branches, and text syncs. rmw3's directive:
      proposals live ordered in the child's sandbox BEFORE any production
      touch.",

  // ════ DELIVERABLES ════
  deliverables: [
    "TASK_SPEC.vsm — this root: what/why/deliverables/relation_to_canon/
        review_protocol/layout/considerations",
    "boot-manifest/M1_boot_manifest.vsm — proposal for boot_manifest.vsm
        (schema, fields, VSL form, coverage, non_goals)",
    "verifier/M2_verify_boot_ontology.vsm — proposal for
        verify_boot_ontology.py (checks, CLI, failure output, integration,
        negative-control fixture)",
    "reminder-v2/M3_reminder_v2.vsm — proposal for vsf-onboard-reminder.ts
        v2 (resume/compact detection, CLEAN+RESUMED injections, child-session
        test plan via symlink)",
    "prompt-sync/M4_prompt_sync.vsm — exact replacement text for the
        vsf-s3-planner.md boot tail (closes D2)",
    "prompt-sync/M5_stale_refs.vsm — exact replacement text for D3
        (reminder→CLAUDE.md pointer) and D4 (gate cites retired rule id)",
    "prompt-sync/M6_bash_reminder.vsm — retire-vs-mark-historical decision
        + exact comment for the bash reminder (closes D6)",
    "child/sandbox/readme.vsm catalog[] — boot-consolidation entry with
        revisions[]",
  ],

  // ════ RELATION TO CANON ════
  relation_to_canon: "Design source: docs/spec_revision/sandbox/
      boot_ontology_pattern.vsm (UNDER TEST, not certified — §RAIL, §10
      under_test). Precedents read read-only: scripts/vsl/
      verify_boot_primer.py (hash manifest pattern), scripts/vsl/
      verify_claim.py (pass/fail + negative-control contract), .opencode/
      plugins/vsf-onboard-reminder.ts (TS plugin), .opencode/plugins/scripts/
      vsf-onboard-reminder (bash, RESUMED branch), checks/* (pass/fail
      fixture convention), docs/spec_revision/system/boot/
      .primer_sources_manifest.json (hash-pinning precedent), .opencode/
      agent/vsf-s3-planner.md (boot tail target of M4). Nothing proposed
      here is canon; promotion is the parent's call after review. Sandbox
      pattern: child/sandbox/readme.vsm (one task = one directory,
      7-field TASK_SPEC).",

  // ════ REVIEW PROTOCOL (for the parent) ════
  review_protocol: "
    1. Read THIS file (TASK_SPEC) — task scope + gate.
    2. Descent order: boot-manifest/ → verifier/ → reminder-v2/ → prompt-sync/.
       Each proposal is self-contained: what the artifact is, its schema /
       interface / exact text, what it covers, what it does NOT (non_goals),
       and how it would be verified (fixture/control).
    3. Each proposal carries its own design decisions + the target production
       file:line it would touch (READ-ONLY evidence, cited).
    4. Parent rules each M independently (accept / hold / rework). Accepted
       proposals become implementation tasks; production changes happen only
       after acceptance (rmw3 directive).",
  gate: "NO production file is edited by this task. Evidence of the gate:
      git status shows only child/sandbox/boot-consolidation/**,
      child/sandbox/readme.vsm, child/TASKS.vsm, child/HANDOFF.vsm.md.",
  review_protocol_note: "after parent review, promotion path per migration
      order in boot_ontology_pattern.vsm §9 (M1 index → M2 detector → M3
      behavior → M4-M6 text → M7 gate).",

  // ════ LAYOUT ════
  layout: "boot-consolidation/ (this dir) mirrors the canonical homes the
      proposals target:
        boot-manifest/   → docs/spec_revision/system/boot/boot_manifest.vsm
        verifier/        → scripts/vsl/verify_boot_ontology.py
        reminder-v2/     → .opencode/plugins/vsf-onboard-reminder.ts
        prompt-sync/     → .opencode/agent/vsf-s3-planner.md (M4),
                           .opencode/plugins/*.ts + scripts/ (M5),
                           .opencode/plugins/scripts/vsf-onboard-reminder (M6)
      The promotion path is visible in the tree (README.vsm pattern).",

  // ════ CONSIDERATIONS (judgements that shaped the work) ════
  considerations: [
    "P4 (index unique) is the load-bearing principle: the manifest is the
        single index; nothing re-lists the boot inventory without passing
        through it. The manifest does NOT re-declare canon content (P1) —
        it indexes artifacts, roles, hashes, ownership.",
    "D_VERIFIER must FAIL on the current tree to prove it detects D1-D4
        (M2). A verifier that passes a broken tree is the proxy failure
        class that verify_claim.py exists to reject.",
    "M3 (reminder v2) is the only MEDIUM-risk migration (live plugin). The
        test plan is a CHILD session loading the plugin via the global
        symlink (~/.config/opencode/plugins/ → /home/rmw3/vsf/.opencode/
        plugins/) — verified read-only that child has no own .opencode/
        plugins/, so the symlink is the load path for BOTH.",
    "M6 is an S5 call (retire vs mark historical) — the proposal gives the
        parent the options with the exact comment text, does not decide.",
    "Every production file cited here was read READ-ONLY with line numbers
        (R4 evidence in the proposal bodies).",
  ],
}
