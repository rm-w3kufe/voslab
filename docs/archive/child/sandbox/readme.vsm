@vsm 1.2.1
@status proposed
// sandbox/readme.vsm — HOW TO USE this folder + CATALOG of work.
// The sandbox is the child's PROPOSAL workspace. Everything here is
// @status proposed — NOT canon. The parent (vsf-s3-validator) reviews
// and promotes; what passes goes to docs/spec_revision/system/.
// This file is the INDEX to the sandbox. Read it before descending.

sandbox_readme("VSF-SANDBOX-README") {

  // ════ PATTERN: one task = one directory ════
  pattern: "
    EVERY task in sandbox/ lives in its OWN top-level directory, named for
    the task (<task-slug>/). Inside each task directory:
      <task-slug>/
        TASK_SPEC.vsm        ← the task root — read THIS FIRST. Holds: what
                                the task is, why, the deliverables, relation
                                to canon, the review protocol for the parent,
                                the directory layout, and the judgements
                                (considerations) that shaped the work.
        <section-audit>/    ← subdirs mirror the CANONICAL home the work
                                targets (boot/, s5-policy/, s3-control/, …).
                                The promotion path is visible in the tree.
        scripts/             ← task-internal scripts, if any (else absent
                                or a placeholder)
        logs/                ← task logs, if needed (transient — §gate)
    Nothing of the task escapes its directory. Nothing of ANOTHER task
    leaks in: a new task = a new <task-slug>/ sibling.",

  // ════ WHY this convention ════
  why: "
    The parent reviews the whole task in one descent: TASK_SPEC.vsm → the
    subdirs it names → spot-check files. No scavenger hunt across sandbox/,
    no implicit coupling between tasks. The directory name IS the task id.
    The TASK_SPEC.vsm convention means the parent's review protocol is the
    SAME shape every time (what / why / deliverables / relation_to_canon /
    review_protocol / layout / considerations).",

  // ════ CATALOG — the live tasks, with dates and revisions ════
  catalog: [
    task("vsl-language-rev") = {
      status:   proposed,
      started:  "2026-08-12",
      owner:    "vsf-s1-executor (child)",
      reviewer: "vsf-s3-validator (parent)",
      summary:  "Split canonical boot/vsl_language.vsm (24,374 tok tiktoken
                 cl100k_base) into a compressed writing-core primer (4,832 tok,
                 -80.2%) + a 14-file per-item reference set (13,062 tok total,
                 -26.6% combined vs canon). Writers read the primer; reference
                 operators open one item file.",
      deliverables: [
        "boot/vsl_language_primer.vsm — writing core (compressed)",
        "s5-policy/vsl-language/index.vsm + 14 item files — reference set",
      ],
      gate:     "intended home docs/spec_revision/system/{boot,s5-policy}/
                 — promotion is parent's call after the review_protocol in
                 TASK_SPEC.vsm passes",
      revisions: [
        rev("r0") = { date: "2026-08-12 00:56", commit: "4239a49",
          note: "compressed vsl_language_primer.vsm (writing core, -80.2%)" },
        rev("r1") = { date: "2026-08-12 01:04", commit: "abf1b5f",
          note: "reference set — index manifest + norm/response_class/psi exemplars" },
        rev("r2") = { date: "2026-08-12 01:28", commit: "fe9c2d1",
          note: "set complete — 14 files, merged small items (memory+machine,
                 m2m+crypto, norm+response_class; definitions split core/theory)" },
        rev("r3") = { date: "2026-08-12 19:10", commit: "bd1b231",
          note: "parent-driven rework (φ↓ 2026-08-12): R1 token-counts
                 reconciled to tiktoken cl100k_base; R2 A14 caveat restored +
                 audit_of_other_14_items.vsm + 7 caveat restorations
                 (definitions_core ×3, validation_gates ×4); R3 parent-harness
                 re-verified verbatim" },
      ],
      next:     "parent review → promote / hold / rework",
    },

    task("boot-consolidation") = {
      status:   proposed,
      started:  "2026-08-13",
      owner:    "vsf-s1-executor (child)",
      reviewer: "vsf-s3-planner (parent) → rmw3 (S5) for D6/M6 decision",
      summary:  "Design proposals M1-M6 for the boot-consolidation plan
                 (parent spec boot_ontology_pattern.vsm: 5 layers, D1-D6,
                 P1-P7, migration M1-M7). rmw3 directive: proposals live
                 ordered in child sandbox BEFORE any production touch.
                 Design-only task — production read-only.",
      deliverables: [
        "TASK_SPEC.vsm — task root (7-field review protocol)",
        "boot-manifest/M1_boot_manifest.vsm — manifest schema (layer/role/
                 hash/owner), VSL form, non_goals",
        "verifier/M2_verify_boot_ontology.vsm — verifier design (checks
                 a-d, CLI, failure output, negative-control fixture; must
                 FAIL on current tree)",
        "reminder-v2/M3_reminder_v2.vsm — TS reminder v2 (resume/compact
                 detection, CLEAN+RESUMED injections, child-session test
                 plan via symlink)",
        "prompt-sync/M4_prompt_sync.vsm — exact boot-tail replacement for
                 vsf-s3-planner.md (closes D2)",
        "prompt-sync/M5_stale_refs.vsm — exact texts for D3 (CLAUDE.md
                 pointer) + D4 (retired rule id)",
        "prompt-sync/M6_bash_reminder.vsm — retire-vs-mark-historical
                 options + exact comment (S5 call)",
      ],
      gate:     "NO production file edited (plugins/agent/boot/scripts/
                 RULES/opencode.json read-only); parent reviews each M,
                 accepts/holds/reworks; production changes only after
                 acceptance (rmw3 directive)",
      revisions: [
        rev("r0") = { date: "2026-08-13 20:40", commit: "dbcf262",
          note: "M1-M6 proposals written + TASK_SPEC + catalog entry;
                 all parse vsl_parser --strict + tokenizer --check;
                 production untouched (design-only, rmw3 directive)" },
      ],
      next:     "parent review of M1-M6 → implementation order decision
                 (child recommendation: M1 → M2 → M3 → M4-M6 → M7)",
    },

    task("vsl-notation-review") = {
      status:   proposed,
      started:  "2026-08-12",
      owner:    "vsf-s1-executor (child)",
      reviewer: "vsf-s3-planner (parent) → rmw3 (S5) if canon edit",
      summary:  "Proposal task (rmw3 invitation): the ¬ glyph observation +
                2 more orientation observations on vsl_language (two-tier
                D1-D13/D14-D21 structure; declared-vs-implemented liveness
                markers). Each obs carries evidence, options, recommendation,
                and the EXACT target § where a change would land. ¬canon
                edit here — gate: parent S4 ruling → rmw3 S5 for any
                canon-text change (double-loop).",
      deliverables: [
        "proposals.vsm — O1 ¬ glyph, O2 tiers, O3 liveness markers",
        "not_usage_audit.vsm — COMPLETE ¬ corpus review (answer to rmw3 S5
         dispatch: 6 real logical uses / 1141 prose-affix)",
        "TASK_SPEC.vsm — task root + review protocol",
      ],
      gate:     "parent S4 rules each obs independently (accept/note/reject/
                 defer); accepted canon-text changes wait on rmw3 (S5)",
      revisions: [
        rev("r0") = { date: "2026-08-12 20:15", commit: "7b9b8d4",
          note: "proposal written — 3 observations, each with target-§ mapping" },
        rev("r1") = { date: "2026-08-12 21:05", commit: "7b9b8d4",
          note: "rmw3 REJECTED the gloss-only O1 → complete ¬ audit done:
                 scripted scan of all 1151 uses; manual re-read of the 14
                 ambiguous hits; verdict 6 REAL logical (0.5%) / 1141
                 prose-affix (99.1%) / 4 glyph tables. O1 re-scoped:
                 note + 3-site cleanup, logical uses preserved" },
        rev("r2") = { date: "2026-08-12 22:10", commit: "e559952",
          note: "parent S4 RULING (32939b8) EXECUTED — audit paths corrected
                 (all repo-root-relative + line numbers, census 6/6 files ✓);
                 R4: P1/P2 NOT phantom (both exist verbatim — parent's check
                 used my short paths from repo root); O1 note text in sandbox
                 primer §3; O2 tier comments in both definitions headers;
                 O3-B 4× LIFESTATUS markers. Canon untouched (g4)" },
        rev("r3") = { date: "2026-08-13 01:10", commit: "<commit>",
          note: "parent RECORRECTION (VSL-NOTATION-RECORRECTION-2026-08-13)
                 EXECUTED — audit v0.2 UNIVERSE-FIRST reverse census: 1,087 not-uses
                 (canon 949/47 + spec-sandbox 138/4). Set corrected:
                 8 LOGICAL (was 6 — L7/L8 found by census: ∧ ¬Δ(architecture),
                 ∧ ¬Δid), 33 PROSE-AMBIGUOUS cleanup sites (was 3 — the '3'
                 claim RETRACTED; full P1-P33 list in audit §5). O1-A/A′
                 updated. Parent's R4 trap named: existential self-check vs
                 universal census" },
      ],
      next:     "await parent ruling on the 3 obs (O1 now audit-backed)",
    },
  ],

  // ════ STATUS LEGEND ════
  status_legend: "
    proposed  — written, validated, awaiting parent review (the default here)
    ratified  — parent approved; promotion pending or in progress
    promoted  — copied to docs/spec_revision/system/ with @status ratified
    rework    — parent flagged issues; child has edits to make
    dropped   — withdrawn (keeps the directory for provenance; ¬deleted)",

  // ════ RULES for adding a task ════
  rules: "
    1. Create <task-slug>/ at sandbox/ root. Name it for what the task IS.
    2. Write TASK_SPEC.vsm at the root of <task-slug>/. Use the 7-field shape
       (what / why / deliverables / relation_to_canon / review_protocol /
       layout / considerations) so the parent's review is uniform.
    3. Put deliverables in subdirs that mirror their CANONICAL home.
    4. Add the task to catalog[] ABOVE with start date + first revision.
    5. Every commit gets a revisions[] entry (date, commit, one-line note).
    6. ¬leave uncommitted work across a session close — the parent sees the
       branch; uncommitted work is invisible. Commit then session-block.",
}
