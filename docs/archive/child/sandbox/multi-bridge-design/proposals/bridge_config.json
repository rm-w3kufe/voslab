{
  "version": 1,
  "bridges": [
    {
      "name": "agent-state",
      "provider_class": "VsmStateProvider",
      "module": "instances.tasks_provider",
      "init_args": {
        "vsm_path": "/home/rmw3/vsf/child/TASKS.vsm"
      },
      "domains": ["tasks", "sessions", "focus", "meta"]
    },
    {
      "name": "infra-state",
      "provider_class": "VsfSshSqliteStateProvider",
      "module": "instances.ssh_sqlite_ops",
      "init_args": {
        "host": "root@n02",
        "path": "/var/lib/vsf-state/state.db"
      },
      "domains": [
        "services", "lxcs", "components", "deploys", "audits",
        "chain_state", "coupling_registry", "s5_policy",
        "variety_metrics", "alert_counts", "spot_checks",
        "opsroom_sessions", "task_drift", "checkpoint_stats",
        "peripheral_health", "v_open_blockers", "v_services_summary",
        "algedonic_ledger", "kpi_manifests", "node_profiles",
        "recon_allowlist", "cyberfilter_health", "autopilot_rules",
        "storage_probe_state", "specs", "tasks"
      ]
    },
    {
      "name": "vsm-docs",
      "provider_class": "VsmDocProvider",
      "module": "socratic_engine.providers.vsm_doc",
      "init_args": {
        "root": "/home/rmw3/vsf/docs/spec_revision/system"
      },
      "domains": [
        "boot", "s1-operations", "s2-coordination",
        "s3-control", "s3star-audit", "s4-intelligence",
        "s5-policy", "kernel", "instance"
      ]
    }
  ]
}
