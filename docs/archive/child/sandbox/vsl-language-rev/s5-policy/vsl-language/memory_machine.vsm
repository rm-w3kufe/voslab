@status proposed
// s5-policy/vsl-language/memory_machine.vsm — machine-facing VSL:
// memory encoding + machine interface directives. Sources: vsl_language.vsm
// §10 + §11. Items of the reference set.
// Writing core: boot/vsl_language_primer.vsm.

memory_machine("VSL-LANG-MEM-MACHINE") {

  memory: "
    rule(S3[\"platform\"], guard=temp<threshold):
      ∀ op ∈ S1.remote: launch(op) ∘ thermal_scheduler
      @ref why=\"feedback_scheduler_rule.md\"
    semantic(\"vsf-architecture\"):
      version=0.4  lifecycle=iterating  decisions=[D1..D13]
      levels={L0:tool-conductor, L1:pipeline-scheduler,
              L2:[cognitive,token-economy], L3:vsf-meta}
    V(\"my-system\", L=0) = {
      E: {host:\"local\", runtime:\"python3.11\"},
      S3: {scheduler:thermal_scheduler, guard:temp<threshold},
      S5: {ceiling:{double_loop:requires_human}, priorities:[A,B,C]}
    }",

  machine: [
    "read @vsm version first — unknown → halt",
    "axioms A1-A11 hard constraints — never overridden by local rules",
    "rules ordered: S5 > S3 > S1",
    "@ref pointers lazy — load only if needed",
    "compression: lossless for rules, lossy for narrative",
    "writing: minimize tokens, use symbols, @ref for prose",
    "L frame-local — use V.id for stable references",
    "governed(x): verify before processing any ψ request",
  ],
}
⟦ /memory_machine ⟧