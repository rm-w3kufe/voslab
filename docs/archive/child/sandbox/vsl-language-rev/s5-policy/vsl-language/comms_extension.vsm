@vsm 1.2.1
@status proposed
// s5-policy/vsl-language/comms_extension.vsm — extensions of the message
// layer beyond the minimal envelope: M2M compression modes + P2 crypto.
// Sources: vsl_language.vsm §12 + §14 (P2 part). Items of the reference set.
// Minimal envelope form stays in boot/vsl_language_primer.vsm.
// Envelope grammar + fields: boot/communication_protocol.vsm.

comms_extension("VSL-LANG-COMMS-EXT") {

  m2m: "
    B_full   — standalone; recipient has no schema; compression 38–51%
    B_schema — machine-to-machine; recipient has VSF schema; 72–79%
               header: // PSI/1.0 — machine-to-machine
               overhead: domain_context block only (~8 tokens)
    domain_context (required in B_schema):
      domain_context: {target=vsf-nucleus, env=Rust/LXC, layer=S1}
      // not it: context substitution — structurally correct, semantically wrong
      // target=id prevents identity drift | env=runtime | layer=recipient S-layer
    drift metrics:
      structural_drift ::= fraction parse-tree elements incorrectly decoded
                           // target <5%, achieved ~0%
      semantic_drift   ::= fraction domain referents substituted w/ recipient
                           // not domain_context: ~60% | with: ~5%
      // measure independently — correct parse + high semantic drift = silent failure
    compression_measurement:
      tool: tiktoken cl100k_base
      compression = 1 − (tokens_B / tokens_A)
      // report B_full and B_schema separately — aggregating misleads",

  envelope_p2: "
    // P2 — graduated signatures. minimal form + origin convention: primer.
    graduated (P2): signature requirement scales with AUTHORITY:
      not signed ok: status, queries, reports, low-stakes chatter
      signature mandatory (reject+escalate if absent/invalid):
        φ↓ directives ▪ deploy/halt/kill/restart ▪ covenant/ceiling instructions
      unsigned high-authority act is not executed.
    crux (P2): signature minted by deterministic signer keyed to agent, invoked
      as TOOL — NEVER emitted by LLM as text (R10: LLM not in crypto path).
      private key in agent ENVIRONMENT (file/socket), not model context, not printed.
      verification on RECEIPT, before body reaches model: cert→S5 root,
      sig over canonical bytes, ts fresh + nonce unseen (anti-replay).
      reuse: offline S5 CA (ed25519 624e8d3e) — one identity cert per agent;
             witness.rs mint/verify; canonical_hash.rs byte-stable serialization.
    delivery hazard: tmux send-keys entered OpenCode as SHELL COMMAND (envelope
      syntax = shell metacharacters). FIX: declared inbox (file/dir) the agent
      polls — monitorable (S3*), replayable, sidesteps shell interpretation.
    invariants: R13 preserved (sig authenticates sender, grants not read access);
      R10 preserved (sign/verify = deterministic tools outside model);
      S3* monitorability (VSL human-readable; sig = added field, not encryption).
    // Phase 2 standing: 'unsigned = human' holds under current trust model;
    // when crypto lands, human authority binds to INPUT CHANNEL, not absence of
    // signature.",
}
⟦ /comms_extension ⟧