⟦ ssh_connection_protocol | PROTOCOL-v1 | vsm-1.2.1 | 2026-10-07T18:58:01Z ⟧

@vsm 1.2.1
@status active

// SSH Connection Protocol — Reinforced procedure for all connections
// LESSON: NATS connection failed because topology wasn't read first

map(SSH-CONNECTION-PROTOCOL) {

  // ─── RULE ───
  rule: "ALWAYS read SSH config before any connection attempt",

  // ─── PROCEDURE ───
  procedure: {
    "1_read_config": {
      action: "Read ~/.ssh/config to understand topology",
      command: "python3 ~/.ssh/read_config.py <hostname>",
      never_skip: true,
    },
    "2_identify_target": {
      action: "Identify the actual target host and its location",
      check: [
        "Is it in a VLAN? (10.10.20.x, 10.10.30.x, 10.10.40.x)",
        "Is it in an LXC container?",
        "Does it require ProxyJump?",
      ],
    },
    "3_resolve_chain": {
      action: "Resolve the full connection chain",
      example: "n02-nats → n01 → n02 → LXC 106",
    },
    "4_connect": {
      action: "Connect using the resolved chain",
      command: "ssh <hostname>",
    },
  },

  // ─── HELPER SCRIPT ───
  helper: {
    location: "~/.ssh/read_config.py",
    usage: [
      "python3 ~/.ssh/read_config.py <hostname>  # Get host info",
      "python3 ~/.ssh/read_config.py --list       # List all hosts",
      "python3 ~/.ssh/read_config.py --topology   # Show network topology",
    ],
  },

  // ─── EXAMPLES ───
  examples: {
    "nats_connection": {
      wrong: "ssh n02 'pct exec 106 -- ...'",  # Indirect, confusing
      correct: "python3 ~/.ssh/read_config.py n02-nats && ssh n02-nats",
      reason: "SSH config defines the topology — use it",
    },
    "lxc_access": {
      wrong: "ssh n02 'pct exec <id> -- ...'",
      correct: "ssh n02 && pct exec <id> -- ...",
      reason: "First connect to host, then access container",
    },
  },

  // ─── LESSON ───
  lesson: "The SSH config is the single source of truth for network topology. Never guess — always read it first.",
}
⟦ /ssh_connection_protocol ⟧
