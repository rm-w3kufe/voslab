// Socratic Tree Recursion Architecture
// Implements recursive decision-making using socratic trees

map(SOCRATIC-TREE-RECURSION) {

  // ─── ARCHITECTURE OVERVIEW ───
  overview: "Recursive decision-making system using socratic trees. Each node evaluates conditions and routes to child nodes or leaves.",

  // ─── TREE STRUCTURE ───
  tree_structure: {

    root: {
      name: "Classification Decision",
      type: "decision",
      description: "Root node that classifies incoming components",
      children: [
        {
          name: "Domain Check",
          type: "decision",
          condition: "Is component domain-specific?",
          children: [
            {
              name: "VSF Domain",
              type: "leaf",
              action: "Route to vsf_script",
              subject: "vsf.alpha.route.vsf",
            },
            {
              name: "Domain-Agnostic",
              type: "leaf",
              action: "Route to socratic-engine",
              subject: "vsf.alpha.route.socratic",
            },
          ],
        },
        {
          name: "Type Check",
          type: "decision",
          condition: "What type of component?",
          children: [
            {
              name: "Script",
              type: "decision",
              condition: "Is it a Python script?",
              children: [
                {
                  name: "NATS Script",
                  type: "leaf",
                  action: "Route to NATS pipeline",
                  subject: "vsf.alpha.route.nats",
                },
                {
                  name: "LXC Script",
                  type: "leaf",
                  action: "Route to LXC orchestrator",
                  subject: "vsf.alpha.route.lxc",
                },
              ],
            },
            {
              name: "Plugin",
              type: "leaf",
              action: "Route to plugin chain",
              subject: "vsf.alpha.route.plugin",
            },
            {
              name: "Documentation",
              type: "leaf",
              action: "Route to validation chain",
              subject: "vsf.alpha.route.doc",
            },
          ],
        },
      ],
    },
  },

  // ─── RECURSIVE EVALUATION ───
  recursive_evaluation: {

    algorithm: {
      name: "Recursive Tree Evaluation",
      description: "Evaluate tree recursively until leaf node is reached",
      steps: [
        "1. Start at root node",
        "2. Evaluate node condition",
        "3. If leaf node: execute action and return",
        "4. If decision node: evaluate condition and select child",
        "5. Recurse on selected child",
      ],
      pseudo_code: """
def evaluate_tree(node, context):
    if node.type == 'leaf':
        return execute_action(node.action, context)
    
    if node.type == 'decision':
        if evaluate_condition(node.condition, context):
            child = node.children[0]
        else:
            child = node.children[1]
        
        return evaluate_tree(child, context)
""",
    },
  },

  // ─── IMPLEMENTATION ───
  implementation: {

    socratic_tree_evaluator: {
      file: "scripts/shared/vsf_socratic_tree_evaluator.py",
      description: "Python implementation of recursive socratic tree evaluation",
      features: [
        "Recursive tree traversal",
        "Condition evaluation",
        "Action execution",
        "Logging and debugging",
      ],
    },

    nats_integration: {
      file: "scripts/shared/vsf_nats_socratic.py",
      description: "NATS integration for socratic tree decisions",
      features: [
        "Request-reply pattern for decisions",
        "Pipeline pattern for multi-step decisions",
        "Queue groups for load balancing",
      ],
    },
  },

  // ─── USE CASES ───
  use_cases: {

    component_routing: {
      description: "Route components to appropriate processing pipelines",
      example: "Classify a new script and route it to the correct handler",
      tree: "Classification Decision tree",
    },

    validation_decisions: {
      description: "Decide which validations to run based on file type",
      example: "A .vsm file needs syntax, naming, and policy validation",
      tree: "Type Check tree",
    },

    error_handling: {
      description: "Decide how to handle errors based on severity",
      example: "A critical error needs immediate attention",
      tree: "Error Severity tree",
    },
  },

  // ─── LESSONS LEARNED ───
  lessons: [
    "Socratic trees provide deterministic decisions — perfect for automation",
    "Recursive evaluation is natural for tree structures",
    "NATS provides the communication backbone for distributed decisions",
    "Each leaf node should have a clear, single responsibility",
    "Conditions should be simple and testable",
  ],
}

