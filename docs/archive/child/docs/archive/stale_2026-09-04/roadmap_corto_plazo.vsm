// ─── FASE 3: INTEGRACIÓN END-TO-END (3-4 días) ──────────────
// Tests que ejercitan flujos completos, no módulos aislados.
// Aquí se encuentran bugs de interfaz entre módulos.

phase_3 = {
  name: "Integración end-to-end",
  effort: "3-4 días",
  risk: "medio-alto — interfaces entre módulos",
  tasks: [
    {
      id: "E2E-001",
      title: "Flujo completo L3: detect → generate → shadow → activate",
      flow: [
        "1. FaultDetector.observe() con errores BLOCKING",
        "2. GA.generate_tree() para el fault detectado",
        "3. ShadowMode.evaluate_strategy() con el árbol generado",
        "4. Si pasó → RollbackManager.activate()",
        "5. RSIObserver.feed_rollback_evaluations() monitorea",
      ],
      verify: "El flujo completo ejecuta sin errores",
      adversarial: [
        "Fault detector detecta → GA produce árbol inválido → graceful",
        "Shadow rechaza todos los árboles → no se activa nada",
        "Rollback se dispara después de activación → estado limpio",
      ],
    },
    {
      id: "E2E-002",
      title: "Flujo scenario: failure → gap → correction → improvement",
      flow: [
        "1. scenario_memory.record() con outcome='failure'",
        "2. scenario_bridge.failures_to_gaps()",
        "3. gap_detector.detect_gaps()",
        "4. scenario_bridge.gaps_to_corrections()",
        "5. pipeline._evaluate_with_predicate() con corrección",
      ],
      verify: "El flujo cierra el loop de aprendizaje",
    },
    {
      id: "E2E-003",
      title: "Flujo feedback: metrics → recommendation → adjustment",
      flow: [
        "1. RSIMetrics.track_classification() con datos variados",
        "2. RSIMetrics.get_recommendation() → adjust",
        "3. RSIFeedbackLoop.adjust_thresholds()",
        "4. Verificar que el threshold cambió en disco",
        "5. Verificar que la accuracy mejoró o al menos no empeoró",
      ],
      verify: "El feedback loop cierra correctamente",
    },
  ],
}


