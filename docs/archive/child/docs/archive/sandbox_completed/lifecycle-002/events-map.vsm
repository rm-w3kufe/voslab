⟦ events-map | LIFECYCLE-002-EVENTS | vsm-1.2.1 | 2026-08-25T00:00:00Z ⟧
@vsm 1.2.1

// ============================================================
// Mapa Completo de Eventos OpenCode — LIFECYCLE-002
// ============================================================
// Todos los eventos disponibles en el SDK de OpenCode, con
// comentario descriptivo de qué conecta, qué activa, y si
// lo estamos usando o no.
//
// Propósito: insumo para la discusión de arquitectura.
// No es definitivo — es material de diseño.
// ============================================================

// ═══════════════════════════════════════════════════════════════
// 1. EVENTOS DE SESIÓN
// ═══════════════════════════════════════════════════════════════

session_events = {

  // ── USADOS ────────────────────────────────────────────────

  "session.created": {
    estado: "USADO",
    plugin: "vsf-onboard-reminder.ts",
    que_hace: "Se dispara UNA VEZ al crear la sesión. Inyecta recordatorio
      CLEAN o RESUMED (discrimina por msg-count).",
    que_activa: "Boot order reminder → agente lee boot_manifest.vsm",
    conecta_con: "vsf-onboard-reminder → client.session.prompt()",
  },

  "session.start": {
    estado: "USADO (via event-router)",
    plugin: "handlers/session-init.ts",
    que_hace: "Se dispara al iniciar sesión. Lee current_focus.json para
      saber qué estaba en flight.",
    que_activa: "session-init handler → carga estado previo",
    conecta_con: "event-router → session-init handler → reads current_focus.json",
    nota: "Solo funciona si event-router está registrado (no está en child)",
  },

  "session.idle": {
    estado: "USADO (via event-router)",
    plugin: "handlers/learning-cycle.ts, session-hygiene.ts, state-reconcile.ts",
    que_hace: "Se dispara cuando la sesión queda idle (sin actividad).
      Múltiples handlers se suscriben.",
    que_activa: [
      "learning-cycle → session_learning_scan.sh + learning_stats.py",
      "session-hygiene → tasks_archive.py + handoff_archive.py",
      "state-reconcile → monitor_reconcile.py",
    ],
    conecta_con: "event-router → handlers en paralelo por prioridad",
    nota: "Solo funciona si event-router está registrado",
  },

  // ── NO USADOS (candidatos a integrar) ────────────────────

  "session.updated": {
    estado: "NO USADO",
    que_hace: "Se dispara cuando la sesión se actualiza (cambio de modelo,
      cambio de agente, cambio de contexto).",
    que_activa_potencial: "Podría triggerear re-validación de contexto si
      el agente o modelo cambian mid-session.",
    conecta_con: "Podría conectar con session-hygiene para re-verificar
      estado después de un cambio.",
    prioridad: "baja",
  },

  "session.deleted": {
    estado: "NO USADO",
    que_hace: "Se dispara cuando una sesión se elimina.",
    que_activa_potencial: "Podría disparar cleanup de archivos temporales
      o archivado final de la sesión.",
    conecta_con: "Podría conectar con session-hygiene para archivado
      definitivo.",
    prioridad: "baja",
  },

  "session.error": {
    estado: "NO USADO",
    que_hace: "Se dispara cuando ocurre un error en la sesión.",
    que_activa_potencial: "✗ CRÍTICO — debería disparar algedonic signal
      o logging de errores para observabilidad.",
    conecta_con: "Podría conectar con algedonic path o con
      state-reconcile para detectar anomalías.",
    prioridad: "alta",
  },

  "session.compacted": {
    estado: "NO USADO",
    que_hace: "Se dispara después de una compactación de la sesión (el
      resumen se comprime para ahorrar contexto).",
    que_activa_potencial: "✗ CRÍTICO — la compactación puede introducir
      errores en el resumen. Debería disparar verificación post-compact.",
    conecta_con: "Podría conectar con vsf-onboard-reminder (que ya maneja
      post-compact via session.created + msg-count, pero no es lo mismo),
      o con un handler dedicado de post-compact validation.",
    prioridad: "crítica",
    nota: "El onboard-reminder maneja parcialmente esto via RESUMED branch,
      pero session.compacted es más específico y debería tener su propio handler.",
  },

  "session.status": {
    estado: "NO USADO",
    que_hace: "Cambio de estado de la sesión (running, idle, etc.).",
    que_activa_potencial: "Podría ser la fuente para session.idle en vez
      de confiar en que el event-router lo detecte.",
    conecta_con: "Alternativa a session.idle para handlers.",
    prioridad: "baja",
  },
}

// ═══════════════════════════════════════════════════════════════
// 2. EVENTOS DE TOOL EXECUTION
// ═══════════════════════════════════════════════════════════════

tool_events = {

  // ── USADOS ────────────────────────────────────────────────

  "tool.execute.before": {
    estado: "USADO",
    plugins: [
      "vsl-measure-before-write.ts (write/edit)",
      "vsf-agent-vsl-gate.ts (bash)",
    ],
    que_hace: "Se dispara ANTES de ejecutar una tool. El plugin puede
      inspeccionar, medir, o bloquear la ejecución.",
    que_activa: [
      "vsl-measure-before-write → muestra estado actual del archivo (advisory)",
      "vsf-agent-vsl-gate → bloquea bash con prose sin VSL marker (R15)",
    ],
    tools_cubiertas: ["write", "edit", "bash"],
    tools_no_cubiertas: ["read", "grep", "glob", "todowrite", "task"],
  },

  "tool.execute.after": {
    estado: "USADO",
    plugins: [
      "vsl-check-on-write.ts (write/edit)",
      "vsf-classify-on-write.ts (write/edit)",
      "vsf-naming-enforcer.ts (write/edit)",
      "vsf-script-classify-on-write.ts (write/edit)",
      "vsf-scripts-manifest-updater.ts (write/edit)",
      "vsl-relocate-on-write.ts (bash)",
    ],
    que_hace: "Se dispara DESPUÉS de ejecutar una tool. El plugin puede
      verificar, clasificar, o registrar lo que pasó.",
    que_activa: [
      "vsl-check-on-write → R18 daemon (grammar, encoding, version, classification)",
      "vsf-classify-on-write → CLASSIFY tree vs real directory",
      "vsf-naming-enforcer → naming conventions (lowercase, no double hyphens)",
      "vsf-script-classify-on-write → advisory: clasifica scripts nuevos",
      "vsf-scripts-manifest-updater → actualiza manifest de scripts",
      "vsl-relocate-on-write → intercepta git mv de .vsm files",
    ],
    tools_cubiertas: ["write", "edit", "bash"],
    tools_no_cubiertas: ["read", "grep", "glob", "todowrite", "task"],
  },

  // ── NO USADOS ─────────────────────────────────────────────

  "tool.input.started": {
    estado: "NO USADO",
    que_hace: "Inicio de input de tool — el agente empieza a escribir
      argumentos para una tool call.",
    que_activa_potencial: "Podría用于 validación temprana de argumentos
      antes de que la tool se ejecute.",
    prioridad: "baja",
  },

  "tool.input.delta": {
    estado: "NO USADO",
    que_hace: "Cada chunk de input mientras el agente escribe argumentos.",
    que_activa_potencial: "Podría用于 streaming validation — detectar
      problemas en argumentos mientras se escriben.",
    prioridad: "muy baja",
  },

  "tool.input.ended": {
    estado: "NO USADO",
    que_hace: "Fin de input — argumentos completos, tool va a ejecutarse.",
    que_activa_potencial: "Alternativa a tool.execute.before para
      validación pre-ejecución.",
    prioridad: "baja",
  },

  "tool.success": {
    estado: "NO USADO",
    que_hace: "Tool ejecutó exitosamente (rc=0).",
    que_activa_potencial: "? OPORTUNIDAD — podríamos loggear éxitos
      para observabilidad. Útil para métricas de uso de tools.",
    conecta_con: "Podría conectar con event-log para métricas.",
    prioridad: "media",
  },

  "tool.failed": {
    estado: "NO USADO",
    que_hace: "Tool falló (rc!=0 o excepción).",
    que_activa_potencial: "✗ IMPORTANTE — debería registrar failures
      para diagnóstico. Podría triggerear retry o algedonic signal.",
    conecta_con: "Podría conectar con algedonic path o con logging
      de errores.",
    prioridad: "alta",
  },

  "tool.progress": {
    estado: "NO USADO",
    que_hace: "Progress update de una tool que toma tiempo (e.g., bash
      command con output incremental).",
    que_activa_potencial: "Podría用于 progress reporting en tools largas.",
    prioridad: "muy baja",
  },
}

