    "    Priority 3: state-reconcile (solo si n02 reachable)",
    "      → monitor_reconcile.py",
    "    Priority 3: governance",
    "      → s5_ca.py, s5_inbox.py, CRL, BBS, caution",
    "    Priority 3: attestation",
    "      → check_agent_log.py + check_binary_integrity.py",
    "    Priority 3: tasks-maintenance",
    "      → validate, reconcile, maintain, archive",
    "    Priority 3: core-scripts",
    "      → bootstrap, onboard, populate, NATS, attestation",
    "    Priority 3: cyberfilter",
    "      → variety accounting, L2/L3 aggregation",
    "    Priority 3: services",
    "      → watchdog, compact, cgroup",
    "    Priority 3: shared",
    "      → covenant hash sync, NATS state",
    "    Priority 4: scenario-memory",
    "      → match procedures → adapt → generate (Phase 1-3)",
    "    Priority 5: gap-resolution",
    "      → log trigger",
    "  → [Standalone]",
    "    → cycle.ts → cycle.tree.vsm (¿está vivo el ciclo de aprendizaje?)",
    "    → observe.ts → observe.tree.vsm (¿quién ejecutó y qué pasó?)",
    "    → lifecycle-autopilot (re-escaneo de proyectos)",
    "    → lifecycle-discovery (auto-descubre nuevos plugins/scripts)"
  ]
}

// ─── 6. PATRONES DE DISEÑO CLAVE ──────────────────────────────────────────

design_patterns = [
  "1. Policy declara, instrument interpreta (R16): La lógica vive en árboles VSL. Los plugins TS son intérpretes delgados.",
  "2. R10: LLM tactics, not enforcement: Los árboles se evalúan determinísticamente por socratic_engine.py. El LLM propone, nunca certifica.",
  "3. R9: Never silent: UNKNOWN no es fallo — significa sin evidencia, sin bloqueo. Todas las activaciones se loguean.",
  "4. R18: Write-time conformance: El daemon corre en CADA escritura, no en commit. Latencia de detección era el defecto original.",
  "5. Classify-then-execute: El event-router usa fase barata classify() primero, luego execute() solo si aprueba.",
  "6. Shared utilities (A6): find-plugin-script, log-activation, event-log son implementaciones únicas usadas por todos los plugins.",
  "7. Robust path resolution: Todos los plugins caminan HACIA ARRIBA desde el directorio de sesión (máx 6 ancestros) para encontrar scripts."
]

// ─── 7. SCENARIO MEMORY (Fase 1-3) ────────────────────────────────────────

scenario_memory = {
  description: "Sistema de memoria procedimental para aprendizaje autónomo",
  paradigm: "Cibernética de 2do orden: el sistema observa sus propias decisiones y aprende",
  phases: {
    phase1: {
      name: "Observación",
      components: ["log-activation.ts", "socratic-shell.ts", "learning_records/procedures/"],
      flow: "socratic-shell → evaluate → act → outcome → log-activation → procedures/",
    },
    phase2: {
      name: "Matching",
      components: ["matching.ts", "procedure-match.tree.vsm", "scenario-memory.ts"],
      flow: "session.idle → match procedures → getRecommendation",
    },
    phase3: {
      name: "Adaptación",
      components: ["adaptation.tree.vsm", "confidence-tracker.ts", "procedure-generator.ts"],
      flow: "session.idle → shouldAdapt → adapt → generate → save",
    },
  },
  safeguards: {
    R17: "Max 3 adaptaciones por procedimiento (tracked in metadata)",
    adaptation_safe: "Predicado socrático que bloquea cuando max reached",
    validateProcedure: "Rechaza procedimientos con adaptations_used > 3",
  },
  metrics: {
    success_rate: "% de outcomes exitosos",
    avg_duration: "Duración promedio de decisiones",
    matching_potential: "Procedimientos reutilizables (high/medium/low confidence)",
    autonomy_score: "Decisiones autónomas vs intervención humana",
  },
}

