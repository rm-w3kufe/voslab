// ═══════════════════════════════════════════════════════════════════════════
// 4. RSI: ANÁLISIS DE AGNOSTICISMO
// ═══════════════════════════════════════════════════════════════════════════

rsi_analysis: {
  
  question: "¿RSI es agnóstico del dominio?"
  
  answer: "PARCIALMENTE — se divide en dos partes"
  
  split: {
    rsi_core: {
      name: "vsf-rsi-core"
      agnostic: true
      what: "Algoritmo genético puro + métricas + forest generator"
      why_agnostic: [
        "El algoritmo genético es un patrón general",
        "Las métricas de fitness son genéricas",
        "La selección, crossover, mutation son genéricos",
        "No usan conceptos VSM"
      ]
      can_use_without_vsm: true
      example_use_cases: [
        "Optimización de hiperparámetros de ML",
        "Evolución de configuraciones de software",
        "Búsqueda heurística en problemas NP-hard",
        "Optimización de pipelines"
      ]
    }
    
    rsi_vsf: {
      name: "vsf-rsi-vsf"
      agnostic: false
      what: "Detección de patrones VSM, generación de árboles VSM"
      why_vsm_specific: [
        "Detecta patrones en datos VSM (algedonic, stasis, etc.)",
        "Genera árboles para el dominio VSM",
        "Usa predicados VSM-specific"
      ]
      can_use_without_vsm: false
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// 5. ESTRUCTURA DE CADA PAQUETE
// ═══════════════════════════════════════════════════════════════════════════

package_structure: {
  
  template: "
    ~/vOSlab/<package-name>/
    ├── pyproject.toml          ← Configuración del paquete
    ├── README.md               ← Documentación principal
    ├── LICENSE                 ← Apache-2.0
    ├── CHANGELOG.md            ← Historial de cambios
    ├── src/
    │   └── <package_name>/
    │       ├── __init__.py     ← Exports públicos
    │       ├── core.py         ← Lógica principal
    │       └── ...
    ├── tests/
    │   ├── test_core.py
    │   └── test_*.py
    └── docs/
        └── *.vsm               ← Documentación VSM
  "
  
  pyproject_agnostic: "
    [build-system]
    requires = [\"setuptools>=68\"]
    build-backend = \"setuptools.build_meta\"
    
    [project]
    name = \"<package-name>\"
    version = \"0.1.0\"
    description = \"<description>\"
    readme = \"README.md\"
    requires-python = \">=3.10\"
    license = { text = \"Apache-2.0\" }
    keywords = [<keywords>]
    classifiers = [
        \"Development Status :: 3 - Alpha\",
        \"Programming Language :: Python :: 3\",
        \"Topic :: Software Development :: Libraries :: Python Modules\",
    ]
    dependencies = [
        # solo dependencias agnósticas
    ]
    
    [project.optional-dependencies]
    dev = [\"pytest>=7\"]
    
    [project.urls]
    Homepage = \"github.com/rm-w3kufe/<package-name>\"
    
    [tool.setuptools]
    packages = [\"<package_name>\"]
    
    [tool.pytest.ini_options]
    testpaths = [\"tests\"]
  "
  
  pyproject_vsm: "
    [build-system]
    requires = [\"setuptools>=68\"]
    build-backend = \"setuptools.build_meta\"
    
    [project]
    name = \"<package-name>\"
    version = \"0.1.0\"
    description = \"<description>\"
    readme = \"README.md\"
    requires-python = \">=3.10\"
    license = { text = \"Apache-2.0\" }
    dependencies = [
        # incluir dependencias VSM
        \"socratic-engine>=0.2.5\",
        \"state-canon>=0.1.0\",
        # otros dependencias VSM
    ]
    
    [project.optional-dependencies]
    dev = [\"pytest>=7\"]
    
    [tool.setuptools]
    packages = [\"<package_name>\"]
    
    [tool.pytest.ini_options]
    testpaths = [\"tests\"]
  "
}

// ═══════════════════════════════════════════════════════════════════════════
// 6. ESTRATEGIA DE PUBLICACIÓN EN GITHUB
// ═══════════════════════════════════════════════════════════════════════════

github_strategy: {
  
  phase_1_agnostic: {
    name: "Publicar paquetes agnósticos"
    priority: "ALTA"
    packages: [
      {
        name: "socratic-engine"
        status: "LISTO"
        effort: "0 días"
      },
      {
        name: "state-canon"
        status: "NECESITA DEFINICIÓN"
        effort: "1-2 semanas"
      },
      {
        name: "vsf-rsi-core"
        status: "NUEVO"
        effort: "1 semana"
      },
      {
        name: "vsf-patterns"
        status: "NUEVO"
        effort: "1 semana"
      },
      {
        name: "vsf-tools"
        status: "NUEVO"
        effort: "3 días"
      }
    ]
    total_effort: "3-4 semanas"
    benefit: "Comunidad puede usar sin VSF"
  }
  
  phase_2_documentation: {
    name: "Documentar ecosistema VSM"
    priority: "MEDIA"
    packages: [
      "vos-kernel",
      "vsf-predicates",
      "vsf-rsi-vsf",
      "vsf-security",
      "vsf-intelligence"
    ]
    total_effort: "1-2 semanas"
    benefit: "Documentación completa del ecosistema"
  }
  
  phase_3_meta: {
    name: "Crear meta-paquete vsf"
    priority: "BAJA"
    packages: [
      "vsf (meta-paquete que instala todo)"
    ]
    total_effort: "1 día"
    benefit: "Instalación fácil del ecosistema completo"
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// 7. REPOSITORIOS GITHUB
// ═══════════════════════════════════════════════════════════════════════════

github_repos: {
  
  agnostic: {
    "socratic-engine": {
      url: "github.com/rm-w3kufe/socratic-engine"
      description: "Recursive boolean certification trees for AI agents — epistemic scaffolding"
      license: "Apache-2.0"
      topics: ["socratic", "epistemic", "verification", "ai", "decision-trees"]
      status: "EXISTS"
    }
    
    "state-canon": {
