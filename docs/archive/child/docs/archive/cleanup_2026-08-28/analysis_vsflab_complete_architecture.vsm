        viability: "Viability set (Ω) — membresía y margen"
      }
      why_vsm_specific: [
        "Covenant es VSM-specific (A0-A11 son axiomas VSM)",
        "Regulation layer es VSM-specific",
        "Viability set (Ω) es VSM-specific",
        "Invariantes son VSM-specific"
      ]
    }
    
    vsf_predicates: {
