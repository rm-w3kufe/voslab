⟦analysis_vsflab_complete_architecture | ARCHITECTURE-v1 | vsm-1.2.1 | 2026-08-28T02:00:00Z ⟧

@vsm 1.2.1
@status active

// ═══════════════════════════════════════════════════════════════════════════
// vOSlab COMPLETE ARCHITECTURE
// Definitiva — Paquetes Agnósticos, VSM-Específicos, Dependencias
// ═══════════════════════════════════════════════════════════════════════════

purpose: "Documentar la arquitectura completa de vOSlab, definiendo cada
         paquete, sus dependencias, qué es agnóstico del framework y qué
         es específico de VSM. Esta es la referencia para implementación
         y publicación en GitHub."

version: "1.0"
date: "2026-08-28"
status: "active"

// ═══════════════════════════════════════════════════════════════════════════
// 1. FILOSOFÍA DE DISEÑO
// ═══════════════════════════════════════════════════════════════════════════

design_philosophy: {

  principle_1: {
    name: "Separación de Capas"
    description: "Lo agnóstico no conoce VSM. Lo específico de VSM usa lo agnóstico."
    rationale: "Permite publicar paquetes sin depender del ecosistema VSM"
  }
  
  principle_2: {
    name: "Dependencias Mínimas"
    description: "Cada paquete solo depende de lo que realmente necesita."
    rationale: "Reduce complejidad y facilita instalación"
  }
  
  principle_3: {
    name: "Publicable Independientemente"
    description: "Los paquetes agnósticos se pueden publicar en GitHub y usar sin VSF."
    rationale: "Amplía audiencia y permite contribuciones externas"
  }
  
  principle_4: {
    name: "Complementarios"
    description: "Los paquetes agnósticos funcionan solos, pero son mejores juntos."
    rationale: "Flexibilidad de adopción"
  }
  
  principle_5: {
    name: "Documentación Rigurosa"
    description: "Cada paquete incluye docs, tests, y diagramas."
    rationale: "Mantiene calidad y facilita mantenimiento"
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// 2. MAPA COMPLETO DE PAQUETES
// ═══════════════════════════════════════════════════════════════════════════

package_map: {

  // ─────────────────────────────────────────────────────────────────────────
  // PAQUETES AGNÓSTICOS — Publicables en GitHub sin VSF
  // ─────────────────────────────────────────────────────────────────────────
  
  agnostic: {
    
    socratic_engine: {
      name: "socratic-engine"
      description: "Motor de evaluación de árboles booleanos recursivos con semántica epistemológica"
      version: "0.2.5"
      agnostic: true
      publicable: true
      github_ready: true
      language: "python"
      license: "Apache-2.0"
      dependencies: []
      can_run_on: "Cualquier sustrato Python 3.10+ sin dependencias externas"
      contains: {
        core: "SocraticEngine — evaluación recursiva de árboles"
        operators: "AND, OR, NOT, XOR, IMPLIES, DIALECTICAL_AND (6)"
        predicates: "type_glob, type_prefix, type_regex, type_has, ctx_has, doc_has_status, trend_up, trend_down, feedback_loop (9 built-in)"
        tree: "TreeExecutor, load_tree, SocraticTreeBuilder, parse_socratic_block, tree_home"
        cache: "PredicateCache con TTL"
        diagnosis: "FailureTrace, find_failure_traces"
      }
      api: {
        evaluate: "engine.evaluate(tree, context) → Evaluation"
        execute: "executor.execute(tree, context) → Evaluation"
        diagnose: "executor.execute_with_diagnosis(tree, context) → dict"
        register: "engine.register_module(module) → int"
      }
      use_cases: [
        "Evaluación de reglas de negocio",
        "Sistemas de decisión",
        "Validación de datos",
        "API gateway routing",
        "Feature flags",
        "Policy enforcement"
      ]
      github_url: "github.com/rm-w3kufe/socratic-engine"
      topics: ["socratic", "epistemic", "verification", "ai", "decision-trees", "boolean-logic"]
    }
    
    state_canon: {
      name: "state-canon"
      description: "Fuente de verdad para sistemas distribuidos — reconciliación de estado"
      version: "0.1.0"
      agnostic: true
      publicable: true
      github_ready: false  # necesita definición clara
      language: "python"
      license: "Apache-2.0"
      dependencies: []
      can_run_on: "Cualquier sustrato Python"
      contains: {
        core: "StateCanon — fuente de verdad"
        reconciliation: "Reconciliación de estado declarado vs observado"
        query: "Consultas sobre estado del sistema"
        audit: "Auditoría de estado"
      }
      use_cases: [
        "Fuente de verdad para sistemas distribuidos",
        "Reconciliación de estado",
        "Auditoría de estado",
        "Debugging de sistemas"
      ]
      github_url: "github.com/rm-w3kufe/state-canon"
      topics: ["state-management", "distributed-systems", "reconciliation", "source-of-truth"]
      needs: "Definición clara de scope antes de publicar"
    }
    
    vsf_rsi_core: {
      name: "vsf-rsi-core"
      description: "Recursive Self-Improvement core — algoritmo genético, fitness, métricas"
      version: "0.1.0"
      agnostic: true
      publicable: true
      github_ready: true
      language: "python"
      license: "Apache-2.0"
      dependencies: ["socratic-engine"]
      can_run_on: "Cualquier sustrato Python con socratic-engine"
      contains: {
        genetic_algorithm: "rsi_genetic_algorithm.py — algoritmo genético puro"
        metrics: "rsi_metrics.py — métricas de rendimiento"
        forest_generator: "rsi_forest_generator.py — generación de bosques"
        feedback_loop: "rsi_feedback_loop.py — loop de retroalimentación"
      }
      use_cases: [
        "Optimización de parámetros",
        "Evolución de configuraciones",
        "Búsqueda heurística",
        "Machine learning hyperparameter tuning"
      ]
      github_url: "github.com/rm-w3kufe/vsf-rsi-core"
      topics: ["genetic-algorithm", "optimization", "self-improvement", "evolutionary-computing"]
    }
    
    vsf_patterns: {
      name: "vsf-patterns"
      description: "Patrones de diseño generales — event-driven, CQRS, distributed processing"
      version: "0.1.0"
      agnostic: true
      publicable: true
      github_ready: true
      language: "python"
      license: "Apache-2.0"
      dependencies: []
      can_run_on: "Cualquier sustrato Python"
      contains: {
        event_driven: "vsf_event_driven.py — event chain pattern"
        event_sourcing: "vsf_event_sourcing.py — event store, replay, snapshots"
        cqrs: "vsf_cqrs.py — commands/queries separation"
        distributed: "vsf_distributed_processing.py — task queue, worker pool"
      }
      use_cases: [
        "Arquitectura de microservicios",
        "Sistemas event-driven",
        "CQRS pattern",
        "Event sourcing"
      ]
      github_url: "github.com/rm-w3kufe/vsf-patterns"
      topics: ["design-patterns", "event-driven", "cqrs", "microservices", "distributed-systems"]
    }
    
    vsf_tools: {
      name: "vsf-tools"
      description: "Herramientas utilitarias generales"
      version: "0.1.0"
      agnostic: true
      publicable: true
      github_ready: true
      language: "python"
      license: "Apache-2.0"
      dependencies: []
      can_run_on: "Cualquier sustrato Python"
      contains: {
        http_mixin: "http_server_mixin.py — HTTP server con log suppression"
        gen_index: "gen_index.py — generación de índices"
        relocate: "relocate_vsm.py — migración de archivos"
        digest: "sd_digest.py — digest de documentos"
      }
      use_cases: [
        "HTTP servers con log suppression",
        "Generación de índices",
        "Migración de archivos",
        "Procesamiento de documentos"
      ]
      github_url: "github.com/rm-w3kufe/vsf-tools"
      topics: ["utilities", "http-server", "file-management", "tools"]
    }
  }
  
  // ─────────────────────────────────────────────────────────────────────────
  // PAQUETES VSM-ESPECÍFICOS — Requieren ecosistema VSM
  // ─────────────────────────────────────────────────────────────────────────
  
  vsm_specific: {
    
    vos_kernel: {
      name: "vos-kernel"
      description: "Núcleo del sistema viable — covenant, regulation, invariants"
