// ═══════════════════════════════════════════════════════════════════════════
// 8. DECISIONES TÉCNICAS
// ═══════════════════════════════════════════════════════════════════════════

technical_decisions: {
  
  d1_naming: {
    question: "¿Prefijo 'vsf-' o sin prefijo para agnósticos?"
    decision: "Mantener prefijo 'vsf-' como namespace"
    rationale: "Identifica origen, pero documentar que es agnóstico"
    examples: "vsf-rsi-core, vsf-patterns, vsf-tools"
  }
  
  d2_state_canon: {
    question: "¿state-canon es un paquete o se integra?"
    decision: "Paquete independiente agnóstico"
    rationale: "Puede funcionar standalone, es útil sin VSM"
    action: "Definir scope claro antes de publicar"
  }
  
  d3_dependencies: {
    question: "¿rsi-core depende de socratic-engine?"
    decision: "Sí — socratic-engine es la base para evaluación"
    rationale: "RSI necesita evaluar fitness de árboles"
    alternative: "Podría ser opcional, pero simplifica"
  }
  
  d4_plugins: {
    question: "¿Plugins TypeScript se empaquetan?"
    decision: "Mantener en .opencode/plugins/ por ahora"
    rationale: "Plugins son específicos del ecosistema opencode"
    future: "Evaluar npm package si hay demanda"
  }
}

