// DECISIONES PENDIENTES
// ═══════════════════════════════════════════════════════════════════════════

pending_decisions: {
  
  d1_state_canon: {
    question: "¿state-canon es dependencia de vos-kernel o se integra?"
    options: [
      "A: Dependencia (importar desde ~/state-canon/)",
      "B: Integrar código en vos-kernel",
      "C: Crear paquete state-canon en vOSlab/"
    ]
    recommendation: "A (mantener separado, importar)"
  }
  
  d2_predicates_in_engine: {
    question: "¿Los predicados van en socratic-engine o en vsf-predicates?"
    options: [
      "A: En engine (built-in)",
      "B: En vsf-predicates (separado)",
      "C: Ambos (built-in + extensiones)"
    ]
    recommendation: "C (built-in en engine, dominio en vsf-predicates)"
  }
  
  d3_plugins_format: {
    question: "¿Los plugins TypeScript se empaquetan o se quedan en .opencode?"
    options: [
      "A: Empaquetar como npm package",
      "B: Mantener en .opencode/plugins/",
      "C: Crear vsf-plugins npm package"
    ]
    recommendation: "B (mantener en .opencode/plugins/ por ahora)"
  }
  
  d4_covenant_location: {
    question: "¿El covenant vive en vos-kernel o se separa?"
    options: [
      "A: En vos-kernel (core)",
      "B: Paquete separado (vsf-covenant)",
      "C: En docs/ (solo referencia)"
    ]
    recommendation: "A (es fundamental, debe estar en kernel)"
  }
}

