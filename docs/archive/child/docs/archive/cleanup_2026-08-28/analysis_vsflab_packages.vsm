// Mantenido solo como referencia histórica.

// ═══════════════════════════════════════════════════════════════════════════
// vOSlab PACKAGES — Definición de Paquetes
// ═══════════════════════════════════════════════════════════════════════════

purpose: "Definir los paquetes que componen vOSlab, su jerarquía,
         dependencias y qué componentes van en cada uno."

// ═══════════════════════════════════════════════════════════════════════════
// ANÁLISIS: COMPONENTES EXISTENTES
// ═══════════════════════════════════════════════════════════════════════════

existing_components: {
  
  already_packages: {
    socratic_engine: {
      location: "~/socratic-engine/"
      version: "0.2.5"
      status: "INSTALADO"
      description: "Motor de evaluación de árboles booleanos"
    }
    
    state_canon: {
      location: "~/state-canon/"
      version: "desconocido"
      status: "REFERENCIA (no instalado)"
      description: "Canon de estado del sistema"
    }
  }
  
  scripts_as_modules: {
    rsi: {
      location: "scripts/vsl/classifier/rsi_*.py"
      modules: 12
      description: "Recursive Self-Improvement (4 niveles)"
    }
    
    vsf_shared: {
      location: "scripts/shared/vsf_*.py"
      modules: 20
      description: "Sistemas compartidos (patterns, security, etc.)"
    }
    
    predicates: {
      location: "scripts/vsl/classifier/*_predicates.py"
      modules: 10
      description: "Predicados por dominio"
    }
    
    classifier: {
      location: "scripts/vsl/classifier/classify.py"
      modules: 1
      description: "Clasificador principal"
    }
  }
  
  plugins: {
    core: {
      location: ".opencode/plugins/core/*.ts"
      modules: 4
      description: "Plugins core (vsl-check, naming, etc.)"
    }
    
    operational: {
      location: ".opencode/plugins/operational/*.ts"
      modules: 5
      description: "Plugins operacionales"
    }
    
    manual: {
      location: ".opencode/plugins/manual/*.ts"
      modules: 3
      description: "Plugins manuales"
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// PROPUESTA: PAQUETES vOSlab
// ═══════════════════════════════════════════════════════════════════════════

packages: {

  // ─── NIVEL 0: FUNDACIÓN ──────────────────────────────────────────────────
  
  vos_kernel: {
    name: "vos-kernel"
    description: "Núcleo del sistema viable — estado, reglas, governance"
    type: "core"
    language: "python"
    dependencies: []
    contains: [
      "state-canon (como dependencia)",
      "covenant validation",
      "regulation layer",
      "invariant checking"
    ]
    source: "New — desde system/boot/ + state-canon"
    priority: "CRÍTICO"
  }
  
  // ─── NIVEL 1: MOTOR DE RAZONAMIENTO ─────────────────────────────────────
  
  socratic_engine: {
    name: "socratic-engine"
    description: "Motor de evaluación de árboles booleanos recursivos"
    type: "engine"
    language: "python"
    dependencies: ["vos-kernel"]
    contains: [
      "SocraticEngine (core)",
      "TreeExecutor",
      "Predicados built-in (12)",
      "Operadores (6)",
      "VSM tree parser"
    ]
    source: "~/socratic-engine/ (ya existe)"
    version: "0.2.5"
    priority: "CRÍTICO"
  }
  
  // ─── NIVEL 2: PREDICADOS POR DOMINIO ────────────────────────────────────
  
  vsf_predicates: {
    name: "vsf-predicates"
    description: "Predicados específicos del dominio VSF"
    type: "predicates"
    language: "python"
    dependencies: ["socratic-engine"]
    contains: [
      "ac_predicates.py (stasis, algedonic)",
      "governance_predicates.py",
      "health_predicates.py",
      "chain_predicates.py",
      "analytics_predicates.py",
      "kernel_regional_predicates.py"
    ]
    source: "scripts/vsl/classifier/*_predicates.py"
    priority: "ALTO"
  }
  
  // ─── NIVEL 2: RSI (RECURSIVE SELF-IMPROVEMENT) ─────────────────────────
  
  vsf_rsi: {
    name: "vsf-rsi"
    description: "Recursive Self-Improvement — optimización, modificación, generación, evolución"
    type: "rsi"
    language: "python"
    dependencies: ["socratic-engine", "vsf-predicates"]
    contains: {
      level_1_auto_optimization: [
        "rsi_metrics.py",
        "rsi_feedback_loop.py"
      ]
      level_2_auto_modification: [
        "rsi_gap_detector.py",
        "rsi_tree_generator.py",
        "rsi_tree_registry.py"
      ]
      level_3_auto_generation: [
        "rsi_pattern_detector.py",
        "rsi_predicate_generator.py",
        "rsi_advanced_tree_generator.py",
        "rsi_component_registry.py"
      ]
      level_4_auto_evolution: [
        "rsi_genetic_algorithm.py",
        "rsi_forest_generator.py"
      ]
    }
    source: "scripts/vsl/classifier/rsi_*.py"
    priority: "ALTO"
  }
  
  // ─── NIVEL 2: PATRONES COMPARTIDOS ──────────────────────────────────────
  
  vsf_patterns: {
    name: "vsf-patterns"
    description: "Patrones de diseño implementados (event-driven, CQRS, etc.)"
    type: "patterns"
    language: "python"
    dependencies: ["vos-kernel"]
    contains: [
      "vsf_event_driven.py",
      "vsf_event_sourcing.py",
      "vsf_cqrs.py",
      "vsf_nats_pipeline.py",
      "vsf_lxc_orchestration.py",
      "vsf_verification_chain.py",
      "vsf_plugin_chain.py",
      "vsf_socratic_tree_evaluator.py",
      "vsf_lifecycle_recursion.py",
      "vsf_validation_recursion.py",
      "vsf_distributed_processing.py"
    ]
    source: "scripts/shared/vsf_*.py"
    priority: "MEDIO"
  }
  
  // ─── NIVEL 2: SEGURIDAD Y GOVERNANCE ────────────────────────────────────
  
  vsf_security: {
    name: "vsf-security"
    description: "Seguridad, RBAC, encryption, audit"
    type: "security"
    language: "python"
    dependencies: ["vos-kernel"]
    contains: [
      "vsf_security.py (RBAC, auth, encryption, audit)",
      "vsf_policy_enforcement.py",
      "vsf_cybernetic_cycle.py"
    ]
    source: "scripts/shared/vsf_security.py, vsf_policy_enforcement.py"
    priority: "ALTO"
  }
  
  // ─── NIVEL 2: INTELIGENCIA Y ANALYTICS ──────────────────────────────────
  
  vsf_intelligence: {
    name: "vsf-intelligence"
    description: "Predictive scaling, anomaly detection, ML routing"
    type: "intelligence"
    language: "python"
    dependencies: ["vos-kernel", "vsf-patterns"]
    contains: [
      "vsf_predictive_scaling.py",
      "vsf_auto_optimization.py",
      "vsf_anomaly_detection.py",
      "vsf_ml_routing.py",
      "vsf_self_healing.py"
    ]
    source: "scripts/shared/vsf_predictive_*.py, vsf_anomaly_*.py, etc."
    priority: "MEDIO"
  }
  
  // ─── NIVEL 3: CONSOLIDACIÓN ──────────────────────────────────────────────
  
  vsf_consolidation: {
    name: "vsf-consolidation"
    description: "Consolidación de duplicaciones, migración legacy"
    type: "consolidation"
    language: "python"
    dependencies: ["vsf-patterns"]
    contains: [
      "vsf_consolidation.py"
    ]
    source: "scripts/shared/vsf_consolidation.py"
    priority: "BAJO"
  }
  
  // ─── NIVEL 3: HERRAMIENTAS ──────────────────────────────────────────────
  
  vsf_tools: {
    name: "vsf-tools"
    description: "Herramientas utilitarias (http mixin, etc.)"
    type: "tools"
    language: "python"
    dependencies: []
    contains: [
      "http_server_mixin.py",
      "gen_index.py",
      "relocate_vsm.py",
      "sd_digest.py"
    ]
    source: "scripts/shared/"
    priority: "BAJO"
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// JERARQUÍA DE DEPENDENCIAS
// ═══════════════════════════════════════════════════════════════════════════

dependency_graph: "
  
  NIVEL 0 (Fundación):
  ┌─────────────────────────────────────────┐
  │  vos-kernel                             │
  │  (state-canon + covenant + invariants)  │
  └─────────────────────────────────────────┘
                    │
                    ▼
  NIVEL 1 (Motor):
  ┌─────────────────────────────────────────┐
  │  socratic-engine                        │
  │  (evaluación de árboles booleanos)      │
  └─────────────────────────────────────────┘
                    │
        ┌───────────┼───────────┐
        ▼           ▼           ▼
  NIVEL 2 (Dominio):
  ┌──────────┐ ┌──────────┐ ┌──────────┐
  │vsf-rsi   │ │vsf-preds │ │vsf-sec   │
  │(auto-    │ │(dominio) │ │(security)│
  │ improve) │ │          │ │          │
  └──────────┘ └──────────┘ └──────────┘
        │           │           │
        ▼           ▼           ▼
  NIVEL 2 (Patrones):
  ┌──────────┐ ┌──────────┐ ┌──────────┐
  │vsf-patrn │ │vsf-intel │ │vsf-tools │
  │(patterns)│ │(analytics│ │(util)    │
  └──────────┘ └──────────┘ └──────────┘
                    │
                    ▼
  NIVEL 3 (Consolidación):
  ┌─────────────────────────────────────────┐
  │  vsf-consolidation                      │
  │  (dedup, legacy migration)              │
  └─────────────────────────────────────────┘
"

// ═══════════════════════════════════════════════════════════════════════════
// FORMATO DE CADA PAQUETE
// ═══════════════════════════════════════════════════════════════════════════

package_template: {
  structure: "
    ~/vOSlab/<package-name>/
    ├── pyproject.toml
    ├── README.md
    ├── LICENSE
    ├── CHANGELOG.md
    ├── src/
    │   └── <package_name>/
    │       ├── __init__.py
    │       ├── core.py
    │       └── ...
    ├── tests/
    │   └── test_*.py
    └── docs/
        └── *.vsm
  "
  
  pyproject_template: "
    [build-system]
    requires = [\"setuptools>=68\"]
    build-backend = \"setuptools.build_meta\"
    
    [project]
    name = \"<package-name>\"
    version = \"0.1.0\"
    description = \"<description>\"
    requires-python = \">=3.10\"
    license = { text = \"Apache-2.0\" }
    dependencies = [
        # dependencies here
    ]
    
    [project.optional-dependencies]
    dev = [\"pytest>=7\"]
    
    [tool.setuptools]
    packages = [\"<package_name>\"]
    
    [tool.pytest.ini_options]
    testpaths = [\"tests\"]
  "
}

// ═══════════════════════════════════════════════════════════════════════════
// ROADMAP DE IMPLEMENTACIÓN
// ═══════════════════════════════════════════════════════════════════════════

implementation_roadmap: {
  
  phase_0_foundation: {
    name: "Fundación"
    priority: "CRÍTICO"
    packages: ["vos-kernel"]
    effort: "1-2 semanas"
    tasks: [
      "Crear estructura vOSlab/",
      "Crear vos-kernel con state-canon como dependencia",
      "Mover covenant + regulation layer",
      "Tests básicos"
    ]
  }
  
  phase_1_engine: {
    name: "Motor"
    priority: "CRÍTICO"
    packages: ["socratic-engine"]
    effort: "1 día (ya existe)"
    tasks: [
      "Copiar socratic-engine a vOSlab/",
      "Actualizar version a 0.2.5",
      "Verificar tests pasan"
    ]
  }
  
  phase_2_domain: {
    name: "Dominio"
    priority: "ALTO"
    packages: ["vsf-predicates", "vsf-rsi", "vsf-security"]
    effort: "2-3 semanas"
    tasks: [
      "Empaquetar predicados por dominio",
      "Empaquetar RSI (4 niveles)",
      "Empaquetar security + policy"
    ]
  }
  
  phase_3_patterns: {
    name: "Patrones"
    priority: "MEDIO"
    packages: ["vsf-patterns", "vsf-intelligence", "vsf-tools"]
    effort: "1-2 semanas"
    tasks: [
      "Empaquetar patrones de diseño",
      "Empaquetar analytics/intelligence",
      "Empaquetar herramientas"
    ]
  }
  
  phase_4_consolidation: {
    name: "Consolidación"
    priority: "BAJO"
    packages: ["vsf-consolidation"]
    effort: "1 semana"
    tasks: [
      "Empaquetar consolidación",
      "Migrar legacy"
    ]
  }
}

