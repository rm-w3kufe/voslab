// ═══════════════════════════════════════════════════════════════════════════
// Scenario Memory — Phase 1: Observación
// ═══════════════════════════════════════════════════════════════════════════
//
// Author: vsf-s1-executor
// Scope: Phase 1 only — observation layer, no behavior change
// Paradigm: Second-order cybernetics — system observes its own decisions
// Status: PROPOSAL (awaiting R4 review)

// ─── 1. OBJETIVO ──────────────────────────────────────────────────────────

objective = "Agregar un layer de observación que registre las decisiones socráticas y sus outcomes, sin cambiar el comportamiento existente. El sistema aprende de sí mismo al observar sus propias decisiones."

principle = "No estamos enseñando al sistema. Le damos la capacidad de aprender de sí mismo."

// ─── 2. COMPONENTES EXISTENTES (FOUNDATION) ───────────────────────────────

foundation = [
  { component: "socratic-shell.ts", function: "Factory: evalúa árboles socráticos", state: "active" },
  { component: "log-activation.ts", function: "Loguea activaciones en JSONL", state: "active" },
  { component: "learning-cycle handler", function: "Escanea aprendizajes pendientes", state: "active" },
  { component: "learning_stats.py", function: "Métricas S4", state: "active" },
  { component: "learning_records/", function: "Almacena IRs", state: "active" }
]

// ─── 3. DISEÑO FASE 1 ─────────────────────────────────────────────────────

// 3.1 Flujo

phase1_flow = [
  "socratic-shell.ts (existente)",
  "  → context() → construye contexto",
  "  → evaluate() → evalúa árbol socrático",
  "  → act() → ejecuta decisión",
  "  → outcome() → NUEVO: registra resultado",
  "    → log-activation.ts (extendido)",
  "      → learning_records/procedures/procedure-NNN.json"
]

// 3.2 Cambios Requeridos

// socratic-shell.ts (extendido)
socratic_shell_changes = {
  component: "socratic-shell.ts",
  change: "Agregar hook outcome() después de act()",
  details: [
    "Agregar campo outcome en SocraticInstance",
    "Llamar outcome() después de act()",
    "Pasar resultado a log-activation.ts"
  ]
}

// log-activation.ts (extendido)
log_activation_changes = {
  component: "log-activation.ts",
  change: "Campo outcome en activation record",
  details: [
    "Campo opcional outcome en ActivationRecord",
    "Incluir outcome en el JSONL output",
    "Crear directorio procedures/ si no existe"
  ]
}

// learning_records/procedures/ (nuevo directorio)
procedures_directory = {
  path: "learning_records/procedures/",
  purpose: "Almacenar procedimientos registrados",
  format: "procedure-NNN.json"
}

// 3.3 Formato de Procedimiento

procedure_format = {
  id: "procedure-NNN",
  type: "procedure",
  version: "1.0",
  source: {
    classId: "string",
    treeRel: "string"
  },
  context: {
    event: "string",
    file_pattern: "string",
    project_state: "string",
    gaps_detected: "array"
  },
  decision: {
    truth: "boolean",
    home: "string"
  },
  outcome: {
    success: "boolean",
    detail: "string",
    durationMs: "number"
  },
  metadata: {
    confidence: "number (0-1)",
    uses: "number",
    last_used: "ISO 8601 UTC"
  }
}

// 3.4 Métricas

phase1_metrics = [
  { metric: "total_procedures", description: "Total de procedimientos registrados", calculation: "COUNT(procedures/)" },
  { metric: "success_rate", description: "% de outcomes exitosos", calculation: "SUM(success) / COUNT(*)" },
  { metric: "avg_duration", description: "Duración promedio de decisiones", calculation: "AVG(durationMs)" },
  { metric: "trees_used", description: "Árboles más utilizados", calculation: "GROUP BY treeRel" }
]

// ─── 4. INTEGRACIÓN CON COMPONENTES EXISTENTES ────────────────────────────

integration = {
  "socratic-shell.ts": "Fase 1: Agregar outcome post-evaluación",
  "log-activation.ts": "Fase 1: Campo outcome opcional",
  "learning-cycle handler": "Fase 1: Incluir procedures en scan",
  "learning_stats.py": "Fase 1: Métricas de procedimientos"
}

// ─── 5. VERIFICACIÓN ──────────────────────────────────────────────────────

verification = {
  unit_tests: [
    "test-outcome-registration: Verificar que outcome se registra correctamente",
    "test-procedure-format: Verificar formato JSON del procedimiento",
    "test-directory-creation: Verificar que procedures/ se crea automáticamente",
    "test-metrics-computation: Verificar métricas calculadas correctamente"
  ],
  integration_tests: [
    "test-socratic-shell-outcome: Verificar que socratic-shell emite outcome",
    "test-log-activation-outcome: Verificar que log-activation incluye outcome",
    "test-learning-scan-procedures: Verificar que learning scan incluye procedures"
  ]
}

// ─── 6. BACKWARDS COMPATIBILITY ───────────────────────────────────────────

backwards_compatibility = "Fase 1 es 100% backwards compatible: Campo outcome es OPCIONAL en ActivationRecord, directorio procedures/ se crea automáticamente, scripts existentes continúan funcionando sin cambios."

// ─── 7. TIMELINE ──────────────────────────────────────────────────────────

timeline = {
  phase1: "2-3 sesiones",
  phase2: "4-5 sesiones (depende de Fase 1)",
  phase3: "6-8 sesiones (depende de Fase 2)"
}

// ─── 8. ACEPTACIÓN ────────────────────────────────────────────────────────

acceptance_criteria = [
  "R4 review por parent (o rmw3 S5)",
  "Todas las pruebas pasando",
  "Backwards compatible confirmado",
  "Documentación completa",
  "Commit en feat/s1-child"
]

