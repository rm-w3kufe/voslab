purpose: "Complementar y conectar los documentos existentes con el análisis
         de integración cibernética. Cada sección referencia el documento
         original y agrega lo nuevo."

// ═══════════════════════════════════════════════════════════════════════════
// 1. COMPLEMENTO A kernel_semantico.vsm
// ═══════════════════════════════════════════════════════════════════════════

complement_kernel_semantico: {
  references: "kernel_semantico.vsm (draft)"
  
  what_exists: {
    layer_1: "Motor Socrático — evalúa árboles lógicos"
    layer_2: "Puente State-Canon — conecta con verdad observada"
    layer_3: "Capa de Agente — expone como MCP"
    flow: "Agente propone → Motor valida → Motor evalúa → Resultado"
  }
  
  what_is_missing: {
    gap_1: "No hay conexión explícita con el kernel de vOS en n02"
    gap_2: "No hay ciclo cibernético de segundo orden"
    gap_3: "No hay ejecución dinámica de árboles"
    gap_4: "No hay integración con RSI"
  }
  
  what_i_add: {
    connection_to_kernel: {
      what: "Punto de entrada al kernel vía NATS"
      implementation: "Canal φ↑ (métricas) + φ↓ (políticas)"
      protocol: "JSON sobre NATS subjects vsf.alpha.*"
      docs: "cybernetic_integration_analysis.vsm §layer_map.kernel"
    }
    
    cybernetic_loops: {
      micro: "Agente → Árbol → Acción → Métricas (segundos)"
      macro: "Agente ↔ Kernel via NATS (minutos)"
      system: "Kernel → Kernel via invariantes (horas)"
      meta: "S5 → S4 → S3 → S2 → S1 (días)"
      docs: "cybernetic_integration_analysis.vsm §cybernetic_integration"
    }
    
    dynamic_execution: {
      what: "TreeExecutor + load_tree + register_module"
      api: "engine.evaluate(), executor.execute(), executor.execute_with_diagnosis()"
      docs: "socratic-engine v0.2.9 CHANGELOG"
    }
  }
  
  updated_flow: "
    ANTES:
      Agente → Motor → Resultado
    
    AHORA:
      Agente → Motor → Resultado → Métricas → Kernel → Políticas → Agente
         │                                    ↑
         └────────────────────────────────────┘
                   (ciclo cibernético cerrado)"
}

// ═══════════════════════════════════════════════════════════════════════════
// 2. COMPLEMENTO A cybernetic_script_cycle.vsm
// ═══════════════════════════════════════════════════════════════════════════

complement_cybernetic_script_cycle: {
  references: "cybernetic_script_cycle.vsm (proposed)"
  
  what_exists: {
    cycle_steps: 9 pasos (need → socratic → mechanism → coupling → impl → integration → validation → learning → improvement)
    application: "Aplicado a consolidación de scripts"
    lessons: "8 lecciones documentadas"
  }
  
  what_is_missing: {
    gap_1: "El paso 2 (socratic_evaluation) no tiene integración real con el motor"
    gap_2: "No hay métricas de ciclo (tiempo, éxito, fallo)"
    gap_3: "No hay retroalimentación automática al motor"
    gap_4: "No hay conexión con RSI para auto-mejora"
  }
  
  what_i_add: {
    step_2_enhanced: {
      what: "Evaluación socrática real con TreeExecutor"
      implementation: "
        from socratic_engine import TreeExecutor, load_tree
        executor = TreeExecutor(engine)
        result = executor.execute_with_diagnosis(tree, context)
        # result['truth'], result['certified'], result['diagnose']
      "
      docs: "socratic-engine v0.2.9"
    }
    
    metrics_per_cycle: {
      what: "Métricas por ciclo de script"
      metrics: [
        "cycle_time: tiempo total del ciclo",
        "success_rate: % de scripts que pasan validación",
        "learning_count: # de learning records generados",
        "improvement_count: # de mejoras aplicadas"
      ]
      implementation: "rsi_metrics.py (Level 1)"
    }
    
    feedback_to_engine: {
      what: "Retroalimentación automática al motor"
      flow: "
        Script falla → Learning record → Pattern detector → 
        RSI Level 2/3 → Nuevo árbol/predicado → Motor actualizado
      "
      implementation: "rsi_gap_detector.py + rsi_tree_generator.py"
    }
    
    rsi_integration: {
      what: "Integración con RSI para auto-mejora"
      levels: {
        L1: "Ajuste de umbrales en scripts existentes"
        L2: "Generación de nuevos scripts basada en gaps"
        L3: "Generación de predicados para validación"
        L4: "Evolución de bosques de scripts"
      }
    }
  }
  
  updated_cycle: "
    ANTES (9 pasos):
      1_need → 2_socratic → 3_mechanism → 4_coupling → 5_impl →
      6_integration → 7_validation → 8_learning → 9_improvement
    
    AHORA (12 pasos con retroalimentación):
      1_need → 2_socratic(REAL) → 3_mechanism → 4_coupling → 5_impl →
      6_integration → 7_validation → 8_learning → 9_improvement →
      10_metrics → 11_feedback → 12_rsi_integration
         │                              │
         └──────────────────────────────┘
                   (ciclo cerrado)"
}

// ═══════════════════════════════════════════════════════════════════════════
// 3. COMPLEMENTO A socratic_engine_nesting_patterns.vsm
// ═══════════════════════════════════════════════════════════════════════════

complement_nesting_patterns: {
  references: "socratic_engine_nesting_patterns.vsm (active)"
  
  what_exists: {
    patterns: [
      "Meta-tree (tree of trees)",
      "Pipeline (sequential composition)",
      "Conditional nesting (if-then-else)",
      "Context with memory (stateful)"
    ]
    rsi_possibilities: "Level 1-4 documentados"
    motor_extensions: "MAP, FOLD, RECURSE, MUTATE propuestos"
  }
  
  what_is_missing: {
    gap_1: "No hay ejecución dinámica de patrones"
    gap_2: "No hay auto-reparación de árboles"
    gap_3: "No hay integración con VSM"
    gap_4: "No hay orden de ejecución semántico"
  }
  
  what_i_add: {
    dynamic_execution: {
      what: "Ejecución dinámica de patrones"
      implementation: "
        # Cargar árbol desde archivo
        tree = load_tree('path/to/tree.vsm')
        
        # Ejecutar con contexto
        executor = TreeExecutor(engine)
        result = executor.execute(tree, context)
        
        # Si falla, auto-reparar
        if not result.certified:
            repaired = auto_repair(tree, result.diagnose())
            result = executor.execute(repaired, context)
      "
    }
    
    self_repair: {
      what: "Auto-reparación de árboles"
      detection: "engine.diagnose() → find_failure_traces()"
      repair: "Reemplazar predicado roto con fallback"
      validation: "Re-ejecutar y verificar certificación"
    }
    
    vsm_mapping: {
      meta_tree: "S4 (Intelligence) — routing por dominio"
      pipeline: "S2 (Coordination) — secuencia de pasos"
      conditional: "S3 (Control) — lógica condicional"
      memory: "S4 (Intelligence) — memoria histórica"
    }
    
    execution_order: {
      what: "Orden semántico de ejecución"
      trunk: "A0 (Propósito ético) — PRIMERO"
      branches: "S2 (Coordinación) — clasificación"
      leaves: "S3 (Control) — validación específica"
      fruits: "S1 (Operaciones) — acción final"
      docs: "cybernetic_integration_analysis.vsm §executable_trees"
    }
  }
}

