  what_is_missing: {
    gap_1: "No hay validación de covenant en raíz"
    gap_2: "No hay orden semántico de ejecución"
    gap_3: "No hay auto-reparación de nodos rotos"
  }
  
  what_i_add: {
    covenant_root: {
      what: "Covenant como raíz del árbol"
      implementation: "
        # Árbol con covenant en raíz
        tree = {
            'op': 'AND',
            'children': [
                # TRONCO: Validación covenant (A0-A11)
                {'predicate': 'covenant_validate', 'args': ['$content']},
                # RAMAS: Clasificación por dominio
                {'op': 'OR', 'children': [
                    {'predicate': 'type_prefix', 'args': ['$type', 'VSF-']},
                    {'predicate': 'type_glob', 'args': ['$type', 'DOMAIN-*']},
                ]},
                # HOJAS: Validación específica
                {'predicate': 'ctx_has', 'args': ['content']},
            ]
        }
      "
    }
    
    semantic_execution_order: {
      what: "Orden semántico de ejecución"
      order: [
        "1. TRONCO: Validación covenant (A0, A0.1)",
        "2. RAMAS: Clasificación por dominio (S2)",
        "3. HOJAS: Validación específica (S3)",
        "4. FRUTOS: Acción final (S1)"
      ]
      docs: "cybernetic_integration_analysis.vsm §executable_trees"
    }
    
    node_self_repair: {
      what: "Auto-reparación de nodos"
      detection: "engine.diagnose() → failure_traces"
      repair: "Reemplazar nodo roto con fallback"
      validation: "Re-ejecutar subárbol"
    }
  }
}

