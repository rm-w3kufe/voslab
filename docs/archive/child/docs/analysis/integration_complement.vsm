// ═══════════════════════════════════════════════════════════════════════════
// 5. COMPLEMENTO A chaining_recursive_patterns.vsm
// ═══════════════════════════════════════════════════════════════════════════

complement_chaining_patterns: {
  references: "chaining_recursive_patterns.vsm (active)"
  
  what_exists: {
    chainable: [
      "NATS Pipeline Pattern",
      "LXC Orchestration Pattern",
      "Verification Chain Pattern",
      "Plugin Chain Pattern",
      "Event Chain Pattern"
    ]
    recursive: [
      "Socratic Tree Evaluator",
      "Lifecycle Recursion",
      "Validation Recursion"
    ]
  }
  
  what_is_missing: {
    gap_1: "No hay integración con pipeline de ejecución de árboles"
    gap_2: "No hay auto-reparación en chains"
    gap_3: "No hay métricas por step en chain"
  }
  
  what_i_add: {
    tree_pipeline: {
      what: "Pipeline de ejecución de árboles"
      implementation: "
        # Chain de árboles
        trees = [load_tree(t) for t in tree_files]
        results = []
        for tree in trees:
            result = executor.execute(tree, context)
            results.append(result)
            if not result.certified:
                break  # Fail fast
        return results
      "
    }
    
    chain_self_repair: {
      what: "Auto-reparación en chains"
      implementation: "
        for i, tree in enumerate(trees):
            result = executor.execute(tree, context)
            if not result.certified:
                repaired = auto_repair(tree, result.diagnose())
                trees[i] = repaired
                result = executor.execute(repaired, context)
      "
    }
    
    step_metrics: {
      what: "Métricas por step en chain"
      metrics: [
        "step_name: nombre del paso",
        "execution_time: tiempo de ejecución",
        "certified: si pasó validación",
        "repair_count: # de reparaciones"
      ]
    }
  }
}

