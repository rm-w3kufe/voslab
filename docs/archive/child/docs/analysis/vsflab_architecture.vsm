      "Scalable systems"
    ]
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// ESTRATEGIA DE PUBLICACIÓN EN GITHUB
// ═══════════════════════════════════════════════════════════════════════════

github_strategy: {
  
  phase_1: {
    name: "Publicar paquetes agnósticos"
    packages: [
      "socratic-engine (ya existe)",
      "state-canon (necesita definición)",
      "vsf-rsi-core (nuevo)",
      "vsf-patterns (nuevo)",
      "vsf-tools (nuevo)"
    ]
    effort: "2-3 semanas"
    benefit: "Comunidad puede usar sin VSF"
  }
  
  phase_2: {
    name: "Documentar ecosistema VSM"
    packages: [
      "vos-kernel",
      "vsf-predicates",
      "vsf-rsi-vsf",
      "vsf-security",
      "vsf-intelligence"
    ]
    effort: "1-2 semanas"
    benefit: "Documentación completa del ecosistema"
  }
  
  phase_3: {
    name: "Crear meta-paquete vsf"
    packages: [
      "vsf (meta-paquete que instala todo)"
    ]
    effort: "1 día"
    benefit: "Instalación fácil del ecosistema completo"
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// ESTRUCTURA DE REPOSITORIOS GITHUB
// ═══════════════════════════════════════════════════════════════════════════

github_repos: {
  
  agnostic_repos: {
    "socratic-engine": {
      url: "github.com/rm-w3kufe/socratic-engine"
      description: "Recursive boolean certification trees for AI agents"
      license: "Apache-2.0"
      topics: ["socratic", "epistemic", "verification", "ai", "decision-trees"]
    }
    
    "state-canon": {
      url: "github.com/rm-w3kufe/state-canon"
      description: "Source of truth for distributed systems"
      license: "Apache-2.0"
      topics: ["state-management", "distributed-systems", "reconciliation"]
    }
    
    "vsf-rsi-core": {
      url: "github.com/rm-w3kufe/vsf-rsi-core"
      description: "Recursive Self-Improvement core — genetic algorithm + metrics"
      license: "Apache-2.0"
      topics: ["genetic-algorithm", "optimization", "self-improvement"]
    }
    
    "vsf-patterns": {
      url: "github.com/rm-w3kufe/vsf-patterns"
      description: "Design patterns — event-driven, CQRS, distributed processing"
      license: "Apache-2.0"
      topics: ["design-patterns", "event-driven", "cqrs", "microservices"]
    }
  }
  
  vsm_repos: {
    "vsf": {
      url: "github.com/rm-w3kufe/vsf"
      description: "Viable System Framework — reference implementation"
      license: "Apache-2.0"
      private: false
      topics: ["vsm", "cybernetics", "viable-system", "stafford-beer"]
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// DECISIONES TÉCNICAS
// ═══════════════════════════════════════════════════════════════════════════

technical_decisions: {
  
  d1_naming: {
    question: "¿Prefijo 'vsf-' o sin prefijo para agnósticos?"
    options: [
      "A: vsf-rsi-core (mantiene identidad VSF)",
      "B: rsi-core (totalmente agnóstico)"
    ]
    recommendation: "A — mantener vsf- como namespace, pero documentar que es agnóstico"
  }
  
  d2_state_canon_split: {
    question: "¿state-canon se divide en agnóstico/VSM?"
    options: [
      "A: Un solo paquete (agnóstico)",
      "B: state-canon-core + state-canon-vsm"
    ]
    recommendation: "A — state-canon es inherentemente agnóstico"
  }
  
  d3_dependencies: {
    question: "¿rsi-core depende de socratic-engine?"
    options: [
      "A: Sí (usa trees para fitness evaluation)",
      "B: No (muy acoplado)"
    ]
    recommendation: "A — socratic-engine es la base para evaluación"
  }
}

