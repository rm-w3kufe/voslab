⟦ vsflab_architecture | ARCHITECTURE-v1 | vsm-1.2.1 | 2026-08-28T01:00:00Z ⟧

@vsm 1.2.1
@status proposed

// ═══════════════════════════════════════════════════════════════════════════
// vOSlab ARCHITECTURE — Agnóstico vs Específico de VSM
// ═══════════════════════════════════════════════════════════════════════════

purpose: "Definir la arquitectura de paquetes separando lo agnóstico del
         framework (publicable en GitHub sin VSF) de lo específico de VSM
         (requiere el ecosistema VSM para funcionar)."

// ═══════════════════════════════════════════════════════════════════════════
// FILOSOFÍA DE DISEÑO
// ═══════════════════════════════════════════════════════════════════════════

design_philosophy: {
  
  principle_1: {
    name: "Separación de Capas"
    description: "Lo agnóstico no conoce VSM. Lo específico de VSM usa lo agnóstico."
  }
  
  principle_2: {
    name: "Dependencias Mínimas"
    description: "Cada paquete solo depende de lo que realmente necesita."
  }
  
  principle_3: {
    name: "Publicable Independientemente"
    description: "Los paquetes agnósticos se pueden publicar en GitHub y usar sin VSF."
  }
  
  principle_4: {
    name: "Complementarios"
    description: "Los paquetes agnósticos funcionan solos, pero son mejores juntos."
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// MAPA DE PAQUETES: AGNÓSTICO vs VSM
// ═══════════════════════════════════════════════════════════════════════════

package_map: {

  // ─── PAQUETES AGNÓSTICOS (Publicables en GitHub) ─────────────────────────
  
  agnostic: {
    
    socratic_engine: {
      name: "socratic-engine"
      description: "Motor de evaluación de árboles booleanos recursivos"
      agnostic: true
      publicable: true
      dependencies: []  # sin dependencias externas
      can_run_on: [
        "Cualquier sustrato Python 3.10+",
        "Sin state-canon",
        "Sin VSM",
        "Standalone"
      ]
      use_cases: [
        "Evaluación de reglas de negocio",
        "Sistemas de decisión",
        "Validación de datos",
        "API gateway routing",
        "Feature flags"
      ]
      github_ready: true
      version: "0.2.9"
    }
    
    state_canon: {
      name: "state-canon"
      description: "Canon de estado — verdad observada del sistema"
      agnostic: true
      publicable: true
      dependencies: []  # sin dependencias externas
      can_run_on: [
        "Cualquier sustrato Python",
        "Sin socratic-engine",
        "Sin VSM",
        "Standalone"
      ]
      use_cases: [
        "Fuente de verdad para sistemas distribuidos",
        "Reconciliación de estado",
        "Auditoría de estado",
        "Debugging de sistemas"
      ]
      github_ready: true  # pero necesita definición clara
    }
    
    vsf_rsi_core: {
      name: "vsf-rsi-core"
      description: "RSI Core — algoritmo genético, fitness, métricas (agnóstico)"
      agnostic: true
      publicable: true
      dependencies: ["socratic-engine"]
      can_run_on: [
        "Cualquier sustrato Python",
        "Con socratic-engine",
        "Sin state-canon",
        "Sin VSM"
      ]
      contains: [
        "rsi_genetic_algorithm.py — algoritmo genético puro",
        "rsi_metrics.py — métricas de rendimiento",
        "rsi_forest_generator.py — generación de bosques"
      ]
      use_cases: [
        "Optimización de parámetros",
        "Evolución de configuraciones",
        "Búsqueda heurística",
        "Machine learning"
      ]
      github_ready: true
    }
    
    vsf_patterns: {
      name: "vsf-patterns"
      description: "Patrones de diseño generales (event-driven, CQRS, etc.)"
      agnostic: true
      publicable: true
      dependencies: []
      can_run_on: [
        "Cualquier sustrato Python",
        "Sin dependencias VSF"
      ]
      contains: [
        "vsf_event_driven.py",
        "vsf_event_sourcing.py",
        "vsf_cqrs.py",
        "vsf_distributed_processing.py"
      ]
      use_cases: [
        "Arquitectura de microservicios",
        "Sistemas event-driven",
        "CQRS pattern",
        "Event sourcing"
      ]
      github_ready: true
    }
    
    vsf_tools: {
      name: "vsf-tools"
      description: "Herramientas utilitarias generales"
      agnostic: true
      publicable: true
      dependencies: []
      can_run_on: [
        "Cualquier sustrato Python"
      ]
      contains: [
        "http_server_mixin.py",
        "gen_index.py",
        "relocate_vsm.py"
      ]
      use_cases: [
        "HTTP servers con log suppression",
        "Generación de índices",
        "Migración de archivos"
      ]
      github_ready: true
    }
  }
  
  // ─── PAQUETES ESPECÍFICOS DE VSM (Requieren ecosistema VSM) ──────────────
  
  vsm_specific: {
    
    vos_kernel: {
      name: "vos-kernel"
      description: "Núcleo del sistema viable — estado, reglas, governance"
      agnostic: false
      publicable: false
      dependencies: ["state-canon", "socratic-engine"]
      requires_vsm: true
      contains: [
        "covenant validation (A0-A11)",
        "regulation layer",
        "invariant checking",
        "viability set (Ω)"
      ]
      why_vsm_specific: [
        "Covenant es VSM-specific",
        "Regulation layer es VSM-specific",
        "Viability set (Ω) es VSM-specific",
        "Invariantes son VSM-specific"
      ]
    }
    
    vsf_predicates: {
      name: "vsf-predicates"
      description: "Predicados específicos del dominio VSF"
      agnostic: false
      publicable: false
      dependencies: ["socratic-engine"]
      requires_vsm: true
      contains: [
        "ac_predicates.py (stasis, algedonic)",
        "governance_predicates.py",
        "health_predicates.py",
        "chain_predicates.py"
      ]
      why_vsm_specific: [
        "Predicados usan conceptos VSM (S1-S5, algedonic, etc.)",
        "No tienen sentido fuera de VSM"
      ]
    }
    
    vsf_rsi_vsf: {
      name: "vsf-rsi-vsf"
      description: "RSI extensiones VSF — predicados y árboles VSM-specific"
      agnostic: false
      publicable: false
      dependencies: ["vsf-rsi-core", "vsf-predicates", "vos-kernel"]
      requires_vsm: true
      contains: [
        "rsi_gap_detector.py (usa conceptos VSM)",
        "rsi_tree_generator.py (genera árboles VSM)",
        "rsi_pattern_detector.py (detecta patrones VSM)",
        "rsi_predicate_generator.py (genera predicados VSM)"
      ]
      why_vsm_specific: [
        "Genera árboles para el dominio VSM",
        "Detecta patrones en datos VSM",
        "Los predicados son VSM-specific"
      ]
    }
    
    vsf_security: {
      name: "vsf-security"
      description: "Seguridad y governance VSM"
      agnostic: false
      publicable: false
      dependencies: ["vos-kernel", "socratic-engine"]
      requires_vsm: true
      contains: [
        "vsf_security.py (RBAC VSM)",
        "vsf_policy_enforcement.py",
        "vsf_cybernetic_cycle.py"
      ]
      why_vsm_specific: [
        "RBAC sigue modelo VSM (S1-S5)",
        "Policy enforcement es VSM-specific",
        "Cybernetic cycle es VSM-specific"
      ]
    }
    
    vsf_intelligence: {
      name: "vsf-intelligence"
      description: "Analytics e inteligencia VSM"
      agnostic: false
      publicable: false
      dependencies: ["vos-kernel", "vsf-patterns"]
      requires_vsm: true
      contains: [
        "vsf_predictive_scaling.py",
        "vsf_auto_optimization.py",
        "vsf_anomaly_detection.py",
        "vsf_ml_routing.py"
      ]
      why_vsm_specific: [
        "Optimización para subsistemas VSM",
        "Routing por dominio VSM",
        "Anomaly detection en datos VSM"
      ]
    }
  }
}

