⟦ vos_package_audit | AUDIT-MANIFEST-v1 | vsm-1.2.1 | 2026-08-29T20:10:00Z ⟧

@vsm 1.2.1
@status active
@binding user(rmw3 S5) 2026-08-29 + child/docs/vos_packaging_principles.vsm (P4)

// MACHINE-READABLE completeness audit (P4). The package-conformance gate
// enumerates EVERY file in ~/vsf/scripts and ~/vsf/.opencode/plugins and FAILS
// on any that does not match a pattern here (mapped or open).
//   mapped = assigned to a package (build target); target MUST resolve to a
//            registry package (P4-DANGLING).
//   open   = explicitly acknowledged, not yet partitioned to a package.
//            PROCESS RULE (P4c): an 'open' entry MUST carry track:"<intended
//            home>" — unnamed open debt is rejected (P4-OPEN-UNTRACKED). track
//            "exclude" = deliberately not a package (docs/registry.json/exp/...).
//            Promote open->mapped as each package is built.
// No blanket patterns: every directory is listed so true orphans surface.

// ── scripts/ ───────────────────────────────────────────────────────────────
audit_entry("scripts/algedonic/*")        = { target: "vos-kernel",            status: mapped }
audit_entry("scripts/analysis/*")         = { target: "vsf-intelligence",      status: mapped }
audit_entry("scripts/audit/*")            = { target: "vsf-security",          status: mapped }
audit_entry("scripts/deploy/*")           = { target: "vos-chassis",           status: mapped }
audit_entry("scripts/docs/*")             = { target: "vsf-common",            status: open, track: "vsf-common" }
audit_entry("scripts/exp/*")              = { target: "open",                  status: open, track: "exclude" }
audit_entry("scripts/legacy/*")           = { target: "open",                  status: open, track: "exclude" }
audit_entry("scripts/llm/*")              = { target: "vsf-intelligence",      status: open, track: "vsf-intelligence" }
audit_entry("scripts/plan/*")             = { target: "open",                  status: open, track: "exclude" }
audit_entry("scripts/s1-kernel/*")        = { target: "vos-kernel",            status: mapped }
audit_entry("scripts/s3-allocation/*")    = { target: "vos-kernel",            status: mapped }
audit_entry("scripts/s4-orchestration/*")= { target: "vos-kernel",            status: mapped }
audit_entry("scripts/s5-governance/*")    = { target: "vos-kernel",            status: mapped }
audit_entry("scripts/shared/*")           = { target: "vsf-common,vsf-tools",  status: mapped }
audit_entry("scripts/state/*")            = { target: "state-canon-infra,state-canon-agent,state-canon-mcp", status: open, track: "state-canon-mcp" }
audit_entry("scripts/tests/*")            = { target: "open",                  status: open, track: "exclude" }
audit_entry("scripts/test-gap-resolver-integration.sh") = { target: "gate-suite", status: mapped }

// ── scripts/vsl (socratic-engine domain; finer mapping documented in plan) ──
// child/scripts/vsl/* = the child's OWN gate engine (verify_child + conformance
// checks) — part of the gate-suite tooling, mapped so no child code is orphan.
audit_entry("child/scripts/vsl/*")                    = { target: "gate-suite",   status: mapped }
audit_entry("child/scripts/vsl/validator/*")          = { target: "gate-suite",   status: mapped }
audit_entry("child/scripts/*")                        = { target: "gate-suite",   status: mapped }
audit_entry("scripts/vsl/classifier/rsi_*.py")        = { target: "vsf-rsi",        status: mapped }
audit_entry("scripts/vsl/classifier/*_predicates.py") = { target: "vsf-predicates", status: mapped }
audit_entry("scripts/vsl/classifier/socratic_*.py")   = { target: "socratic-engine",status: mapped }
audit_entry("scripts/vsl/classifier/vsf_socratic_engine.py") = { target: "socratic-engine", status: mapped }
audit_entry("scripts/vsl/classifier/*.py")            = { target: "vsf-predicates", status: mapped }
audit_entry("scripts/vsl/classifier/scenarios/*")     = { target: "socratic-engine",status: mapped }
audit_entry("scripts/vsl/parser/*")                   = { target: "socratic-engine",status: mapped }
audit_entry("scripts/vsl/validator/*")                = { target: "socratic-engine",status: mapped }
audit_entry("scripts/vsl/tools/*")                    = { target: "socratic-engine",status: mapped }
audit_entry("scripts/vsl/templates/*")                = { target: "socratic-engine",status: mapped }
audit_entry("scripts/vsl/benchmarks/*")               = { target: "socratic-engine",status: mapped }
audit_entry("scripts/vsl/*.py")                       = { target: "socratic-engine",status: mapped }

// ── .opencode/plugins/ ──────────────────────────────────────────────────────
audit_entry(".opencode/plugins/core/*")          = { target: "vos-kernel",   status: mapped }
audit_entry(".opencode/plugins/manual/*")         = { target: "vos-kernel",   status: mapped }
audit_entry(".opencode/plugins/operational/*")    = { target: "gate-suite,state-canon-*", status: mapped }
audit_entry(".opencode/plugins/support/*")        = { target: "socratic-engine,vos-kernel", status: mapped }
audit_entry(".opencode/plugins/scripts/*")        = { target: "vsf-tools",    status: mapped }
audit_entry(".opencode/plugins/*.json")           = { target: "config",       status: open, track: "exclude" }

// ── pre-vsf-rsi EXPLORATORY ORPHANS (from census_orphan_code.vsm) ───────────────
// These trees are NOT in the gate's enumeration (gate watches child/scripts,
// child/docs, ~/vOSlab/packages only). Recorded here as NAMED open debt (P4c)
// so they are not a silent gap. NO migration. Fold-or-retire decided at vsf-rsi
// build gate (post autonomy guarantee).
audit_entry("tools/score.py")          = { target: "open", status: open, track: "pre-vsf-rsi-decision" }
audit_entry("api/main.py")             = { target: "open", status: open, track: "pre-vsf-rsi-decision" }
audit_entry("core/signal_router.py")   = { target: "open", status: open, track: "pre-vsf-rsi-decision" }
audit_entry("cli/install.py")          = { target: "open", status: open, track: "pre-vsf-rsi-decision" }
audit_entry("validator.py")            = { target: "open", status: open, track: "pre-vsf-rsi-decision" }
audit_entry("vOSlab/tests/*")          = { target: "open", status: open, track: "pre-vsf-rsi-decision" }

// ── scenario-memory learning substrate ────────────────────────────────────────
// The procedural-learning store. Mapped (not open) to scenario-memory; these feed
// the autonomy loop. (Not in the gate's enumeration set, so this entry is
// documentation of intent, satisfying P4c naming — not a runtime check.)
audit_entry("child/learning_records/*") = { target: "open", status: open, track: "scenario-memory" }

⟦ /vos_package_audit ⟧

⟦ /vos_package_audit ⟧
