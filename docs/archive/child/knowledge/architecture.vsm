@vsm 1.2.1
@status active

// System architecture summary. Full specs: docs/spec_revision/system/

architecture {

  layers: "
    Capa 4: LLM Memory     — docs/spec_revision/system/ (formal specs)
    Capa 3: Domain          — s1-operations/ s2-coordination/ s3-control/ s4-intelligence/ s5-policy/
    Capa 2: RSI (Python)    — vsf-rsi/ (GA, feedback loop, fault detector)
    Capa 1: Kernel (Rust)   — vsf-nucleus/src/ (15 modules, 131 pub-const)
    Capa 0: Infrastructure  — LXC containers, NATS, state.db, tmpfs
  "

  vsm_hierarchy: "
    S5 (Policy)     — identity, purpose, caution mode
    S4 (Intelligence) — anticipation, scenario memory, evolution
    S3 (Control)    — decision, resource allocation, triage
    S3* (Audit)     — verify S3 doesn't deviate (observer)
    S2 (Coordination) — regulate S1 interactions (metrics, pipeline)
    S1 (Operations) — do the work (GA, fault detector, tree registry)
  "

  kernel_modules: "
    kernel.rs, s1.rs, s2.rs, s3.rs, s3_star_audit.rs, s4.rs, s5.rs,
    algedonic.rs, attractor.rs, stasis.rs, lyapunov.rs, omega_validator.rs,
    state_vector.rs, telemetry_canonical.rs, coupling_registry.rs,
    learned_modes.rs, invariant_checker.rs, vmem.rs, reframe.rs
  "

  rsi_modules: "
    RSIGeneticAlgorithm, RSIGeneticAlgorithmV2, RSIFaultDetector,
    RSIFeedbackLoop, RSIMetrics, RSIObserver, RSIPipeline,
    RSIScenarioBridge, RSITreeRegistry, RSIGapDetector, RSIPatternDetector
  "

  infrastructure: "
    n02: Proxmox host
    LXC 105: s1-bbh (VLAN30, R6 gate — not cleared)
    LXC 106: NATS
    LXC 108: cargo builds
    LXC 112: clima (23 python services)
    LXC 113: econ (Lange-Lerner)
    LXC 115/116/117: soc (VLAN50 SIEM)
  "

  channels: "
    φ↑ (upward):   telemetry, session blocks, commits
    φ↓ (downward): task entries, dispatch envelopes, policy
    ψ:              inter-S1 communication
    α:              algedonic (urgent alerts)
    σ:              stasis signals
  "
}

⟦ /architecture ⟧
