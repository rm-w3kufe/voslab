⟦ self_maintaining_patterns | KNOWLEDGE-v1 | vsm-1.2.1 | 2026-09-04T03:50:00Z ⟧

@vsm 1.2.1
@status active

// Principle: instructions = LOGIC, scripts = VALUES
// Any instruction containing a value that changes should be a pointer or command.

self_maintaining_patterns {

  principle: "
    Instrucciones = LÓGICA (cuándo hacer qué)
    Scripts = VALORES (cuál es el valor actual)
    El LLM no necesita recordar valores — necesita saber DÓNDE encontrarlos.
  "

  what_changes: "
    VSM version     → scripts/helpers/vsm_version.sh
    Timestamp       → scripts/helpers/vsm_timestamp.sh
    Header format   → scripts/helpers/vsm_header.sh <name> <TYPE>
    Validation      → scripts/helpers/vsm_validate.sh <file.vsm>
    PROTOCOL_VERSION → scripts/vsl/tools/envelope.py
  "

  what_never_changes: "
    Identity (who am I)
    Chain of command (who I report to)
    Constraints (what I don't do)
    Destructive gate (R17)
    Path resolution rules
  "

  reference_material: "
    // VSL full spec: boot/vsl_language_primer.vsm
    // Architecture: knowledge/architecture.vsm
    // Rules: boot/hard_rules.vsm
    // Kernel map: docs/spec_revision/system/kernel/kernel-map-v1/kernel_map.vsm
  "

  maintenance_rule: "
    When editing agent definition or knowledge files:
    1. Check if any VALUE is hardcoded
    2. If it changes: replace with pointer to script or source
    3. If it never changes: hardcoded is fine
    4. If unsure: use pointer (safer)
  "
}

⟦ /self_maintaining_patterns ⟧
