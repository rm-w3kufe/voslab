@vsm 1.0
// OPEN_SOURCE_CATALOG.vsm — enumeración de artefactos open-source-ables de VSF, en sus formas.
// author: Claude [O] 2026-07-18 (con rmw3). Complementa: memoria project_open_source_strategy +
//   master plan additions_2026_07.verifiable_systems_toolkit.
// REGLA: esto es un CATÁLOGO (el menú completo), NO un orden de release. Primer corte = el Toolkit (3 core).

catalog = {

  principle:
    "La SUSTANCIA son las herramientas núcleo (libs). Los skills/agentes/MCPs/RAGs son FORMAS DE ENTREGA
     de esas libs + nuestras disciplinas — no confundir el wrapper con la cosa. Triaje: ✓ abrir ·
     ? decoplar primero · ✗ gated. Gate de seguridad (siempre): extraer → decoplar → scrub secretos →
     cargo --locked → checklist Z → abrir. Home: vsf-sandbox."

  // ── A. CONTENIDO & CONOCIMIENTO ──
  aphid:            { forms:[lib,cli,skill],        triage: ✓,             what:"SSG recursivo JSON/YAML→HTML con escaping (port del php_tools de rmw3)" }
  encyclopedia_eng: { forms:[lib,reconciler,skill], triage: ✓,             what:"docs que DERIVAN de un canon único, con detección de drift" }
  knowledge_rag:    { forms:[rag,mcp],              triage: "?→plantilla", what:"RAG sobre base de conocimiento canónica con procedencia (glosario/enciclopedia = la base; cybernetic-rag = semilla)" }

  // ── B. SUSTRATO DE CONFIANZA (el corazón del 'no confíes, verifica') ──
  vsl:              { forms:[lib,mcp,skill], triage: ✓, what:"VSL spec + parser (vsl_v1) + intérprete (vsl_v2) — notación de sistemas viables" }
  verifiable_log:   { forms:[lib,mcp],       triage: ✓, what:"★ canonical_hash + Merkle + verificador DIVERSO + case study footgun f64. La joya" }
  reconciler:       { forms:[lib,skill],     triage: ?, what:"censo model≡reality (anti-huérfano) — decoplar de state.db" }
  validator:        { forms:[lib,cli],       triage: ✓, what:"validator.py + viability.yaml — el core público ya existente" }

  // ── C. DISCIPLINAS (skills/agentes — metodología, NO sustancia nueva) ──
  skill_verify:     { forms:[skill,agent], triage: ✓, what:"verificar claims contra la realidad VIVA, no el reporte (S3*). Agente verificador diverso" }
  skill_breaks:     { forms:[skill],       triage: ✓, what:"docs honestas: 'ninguna metáfora/correspondencia entra sin declarar dónde se rompe'" }
  skill_loud_death: { forms:[skill,snippet],triage: ✓, what:"supervisión: la muerte de un servicio es RUIDOSA (wail), nunca silenciosa" }
  skill_r4_deploy:  { forms:[skill],       triage: ✓, what:"deploy atómico: stop → verify PID → push → start → verify /proc/exe" }
  vsm_role_agents:  { forms:[agent-architecture], triage: ?,
                      what:"★ LA contribución meta NOVEL: agentes organizados por FUNCIÓN VSM — diseño [O]
                            + ejecución [S] + humano-S5 — con handoffs enmarcados y VERIFICACIÓN INDEPENDIENTE
                            en cada frontera. Lo más original del catálogo. Abstraer de nuestra infra." }

  // ── ✗ GATED (no abrir) ──
  gated: "kernel vOS (state_vector/Lyapunov = detrás de los papers) · infra n02/tokens/keys ·
          BBH/ofensivo/disclosure · covenant (semi-público pero sensible)."

  first_release: "Verifiable Systems Toolkit = aphid + VSL + verifiable_log (los 3 core). Esto es el MENÚ
                  completo para el crecimiento del toolkit + olas posteriores, NO el primer corte."
  honest_note:   "Los skills/agentes/MCPs están de moda, pero la sustancia son A y B. La única cosa NUEVA
                  en forma de agente es vsm_role_agents. Todo lo demás = libs núcleo + wrappers."
}
