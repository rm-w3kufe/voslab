# ══════════════════════════════════════════════════════════════
# WHEN REASONING IS NOT ENOUGH — ESCALATION CRITERIA
# ══════════════════════════════════════════════════════════════

escalation_criteria:
  to_calibration_experiment:
    trigger: "structure agreed, but parameter values empirically dependent"
    examples: [T3_ε-range, F5.x.3_SeqLock_contention_threshold]

  to_full_experiment:
    trigger: "hypothesis testable but only with runtime data"
    examples: [PHI-02_H7_split_fidelity, PHI-03_NL_baseline_compression]

  to_L3_human:
    trigger: "peers cannot converge on technical detail; preference/political matter"
    examples_so_far: [
      "T1.R1 vs R3 selection (Claude voted R1, accepted by Qwen) — converged, no L3 needed",
      "C1 indicator vs softmax (3rd round resolved) — converged, no L3 needed",
    ]
    note: "0 L3 escalations across T1-T4; methodology working"

