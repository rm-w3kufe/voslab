// STATUS: historical_record — consumido por fuse DEPRECATED 2026-05-25 — canonical: docs/evaluation/GAPS_AND_DEBTS.md; @src_plan_gap en plans_active.vsm:17 · archivo 2026-08-15
// (THEORY-FUSE-REMAINDER censo; contenido en el target canonical, este doc es fuente histórica.)
// VSF Gap Closure Plan — reasoning-first methodology
// domain_context: {target=vsf+vos_kernel, env=design_phase, layer=meta-S5}
// authors: Claude(S3-vsf) + Qwen(S4-vos), via rmw3 human relay
// origin: realization 2026-05-09 — many open gaps are derivable, not experimental
// scope: 5 already-closed (T1-T4 + T3-pending) + 5 active (G1-G5) + standing principles

# ══════════════════════════════════════════════════════════════
# METHODOLOGY PRINCIPLE
# ══════════════════════════════════════════════════════════════

principles:
  P_REASON_FIRST:
    "Default to derivation. Experiment only when reasoning has reached its limit."
    rationale:
      "experiments are expensive (compute, time, sovereignty cost — see EXP-PHI-01 H5).
       theorems and definitions, once written, never have to be re-run.
       a gap derivable from existing axioms + dialog is closed cheapest by reasoning."

  P_VSL_AS_CHANNEL:
    "Inter-LLM negotiation MUST use VSL as substrate, NOT natural-language prose."
    rationale:
      "EXP-PHI-01-bis demonstrated 0 ambiguity residual after 3 rounds VSL.
       prose induces drift; VSL forces tipificación + axiom-naming + structural commitments."

  P_HUMAN_AS_RELAY:
    "rmw3 is NOT decision-maker by default — only L3 escalation when peers cannot converge."
    rationale:
      "human bandwidth scarce; LLMs negotiate technical detail; human resolves
       only architectural/political/preference matters. respects ceiling principle (A5)."

  P_SINGLE_SOURCE_OF_TRUTH:
    "Every closed gap has ONE canonical artifact. Inquiry/response chains are evidence,
     theory document is authority."
    rationale:
      "feedback memory feedback_single_source: copies/translations are references,
       never parallel authorities. dynamics_choice.vsm is the source of truth for T1-T4."

  P_ESCALATION_LADDER:
    "Reasoning → Inquiry/dialog → Calibration experiment → Empirical experiment → L3 humano"
    rationale:
      "each step costs more than the previous. start cheap. escalate only as needed."

