// ─── COVENANT EMBEDDING ───────────────────────────────────────────────────────

covenant_embedding = {

  mechanism: "Rust compile-time include_str!()",

  // In src/s4.rs:
  rust_impl: """
  // Covenant is compiled into the binary — not read from disk at runtime.
  // Cannot be bypassed without recompiling (requires S5 approval).
  const COVENANT: &str = include_str!("../../../docs/governance/covenant.vsm");
  const COVENANT_HASH: &str = env!("COVENANT_SHA256");  // set by build.rs

  pub fn verify_covenant() -> bool {
      let computed = sha256(COVENANT.as_bytes());
      computed == COVENANT_HASH
  }
  """,

  // In build.rs (runs at compile time):
  build_rs: """
  fn main() {
      let covenant = std::fs::read_to_string("../../docs/governance/covenant.vsm")
          .expect("covenant.vsm must exist at build time");
      let hash = sha256_hex(covenant.as_bytes());
      println!("cargo:rustc-env=COVENANT_SHA256={}", hash);
      // rerun if covenant changes
      println!("cargo:rerun-if-changed=../../docs/governance/covenant.vsm");
  }
  """,

  properties: {
    immutable:    "embedded in binary — file replacement at runtime has no effect",
    verifiable:   "hash checked before every S4 call",
    transparent:  "covenant is plaintext VSL — no black box",
    anti_capture: "modifying covenant requires recompile + S5 approval (A0.1)",
    watermark:    "⟦ COVENANT | {hash} | vsm-0.3 ⟧ included in every S4 prompt",
  }
}

// ─── S4 MODULE DESIGN ────────────────────────────────────────────────────────

S4 = {
  file:      "src/s4.rs",
  interface: "POST http://localhost:11434/api/generate",
  model:     "qwen2.5-coder:7b",

  prompt_construction: """
  fn build_s4_prompt(state: &KernelState, signal: &AngustiaSignal) -> String {
      assert!(verify_covenant(), "covenant integrity check failed — S4 halted");

      format!(
          \"⟦ COVENANT | hash:{} | vsm-0.3 ⟧\\n{}\\n⟦ /COVENANT ⟧\\n\\n\
           Kernel state:\\n{}\\n\\n\
           Angustia signal:\\n{}\\n\\n\
           PSI level: {}\\n\\n\
           Within the covenant constraints above, suggest ONE support action.
           Format: action_type | target | rationale (one line each).
           Do not modify policy. Do not command. Suggest only.\",
          COVENANT_HASH,
          COVENANT,
          serde_json::to_string_pretty(state).unwrap(),
          serde_json::to_string_pretty(signal).unwrap(),
          signal.level,
      )
  }
  """,

  response_parsing: {
    format:    "action_type | target | rationale",
    validate:  "action must be in pre-authorized class list (D4-L2)",
    fallback:  "if parse fails or action not authorized → log + no-op (safe default)",
  }

  authorized_actions: [
    "reduce_cpu_weight | kernel_id | rationale",
    "request_cooldown  | duration_s | rationale",
    "defer_task        | task_id | rationale",
    "escalate_human    | reason | rationale",   // L3 only
  ]
}

