  q17(CONDITION-VS-EVENT) priority=P1 owner="[S] implement · [O] live-verify" {
    spec: "docs/spec/condition_vs_event.spec.vsm"
    what: "2060 of the 2587 pending signals encode SEVEN facts: 5 components diverged since
