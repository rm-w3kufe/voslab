@vsm 1.0
// strategic_tactical_authority.vsm — the human↔machine authority gradient for ACTUATION.
// domain_context: {target=vsf, env=governance, layer=S4-S5}
// author: Opus 4.8 (design) + rmw3 (S5 — model decisions 2026-06-21) | gate: S5 ratification before wiring.
// origin: design dialogue 2026-06-21. Reframes the EXP-L1-01 Phase B φ↓-authority question. The machine
//   (S4, incl. LLM) MAY actuate PROACTIVELY toward objectives within bounds; the human owns strategy.
//   Marxist frame: human sets the strategic ENDS, the machine governs the tactical MEANS.
// supersedes-on-actuation: docs/experiments/real_process_governance/phase_b_design.vsm (synthesis-only).

⟦ strategic_tactical_authority | rmw3+opus | vsm-1.0 | 2026-06-21 ⟧

ratification: "RATIFIED 2026-06-21 (rmw3, S5). The R10.1 clarification is canon (state.db rules id=11 +
  RULES.md). The graduated-autonomy PARAMETERS (λ=0.10; score 0.6·align+0.4·resolve; graduate τ_tac≥0.90
  /W=20/N≥50/override<0.10; demote<0.79; per-class; irreversible=HiTL-always) are S5-ratified as the
  INITIAL set — tunable as Phase 1 data accrues (the metric is itself measured). Cleared for Sonnet wiring."

motivation: "A cybernetic government that only DAMPS (throttle, halt) is impoverished. Beer's S4 is
  anticipation + adaptation toward goals; a viable system acts PROACTIVELY, not only defensively. The
  question is not WHETHER the machine may actuate proactively (it should) but the AUTHORITY GRADIENT:
  who owns the ends, who owns the means, and how the machine EARNS expanded autonomy. R10 was over-applied
  to forbid all LLM actuation; corrected here to bound only the fast safety/reflex path."

// ── THE THREE LAYERS (authority gradient) ────────────────────────────────────
layers:
  strategy = { owner: "human/S5", fixes: "the ENDS — objective X, identity, value frame",
               loop: "double (L3)", ratified: true }
  tactics  = { owner: "machine/S4 (incl. LLM)", fixes: "the MEANS — sub-objectives, sequencing toward X",
               loop: "single (L2)", bound_by: ["covenant", "alignment_audit", "escalation_duty"],
               autonomy: "graduated (earned)" }
  reflex   = { owner: "deterministic", fixes: "safety/emergency (250ms tick, halt)",
               loop: "reflex", llm: "FORBIDDEN (R10)", priority: "override-all" }

// ── THE MARXIST DISCIPLINE (not just the metaphor) ───────────────────────────
discipline: "Lenin: tactical flexibility ('the concrete analysis of the concrete situation' — exactly what
  an LLM does well) is desirable, BUT tactics are always SUBORDINATE to strategy. Tactics contradicting
  strategy = OPPORTUNISM, the cardinal sin. This supplies the three brakes: the danger of delegating tactics
  is opportunist DRIFT, so the system must (B1) audit alignment, (B2) escalate when a tactic would become
  strategy, (B3) confirm irreversible commitments."

// ── THREE BRAKES ON TACTICAL AUTONOMY ────────────────────────────────────────
brakes:
  B1_alignment_audit = {
    risk:  "tactical opportunism — local moves drift from objective X.",
    guard: "S3* measures, INDEPENDENTLY of the LLM, whether the tactical trajectory still serves X.
            Drift ⇒ algedonic flag + visible to the human (the LLM's synthesis role feeds this view).",
  }
  B2_escalation_duty = {
    risk:  "a tactic that would BECOME strategy — X unreachable within covenant, or X itself needs revision.",
    guard: "the machine SURFACES to the human (HiTL), never silently redefines X (the L3 line, A5).
            POSITIVE form: the machine MAY PROPOSE strategic course-corrections ('giros de timón'); the
            human disposes. Proposals are inert until ratified.",
  }
  B3_irreversibility = {
    risk:  "tactical actions with external side-effects / hard to undo.",
    guard: "reversible/bounded tactics ⇒ machine autonomy (per graduation). High-commitment or
            outward-facing tactics ⇒ HiTL confirmation REGARDLESS of graduation phase.",
  }

// ── HARD FLOOR (covenant) vs SOFT TARGET (alignment) ─────────────────────────
asymmetry: "The covenant (cpu_max, memory_max, …) is CRISP and deterministic — a non-overridable floor
  enforced by the S5 watchdog, independent of any LLM output, applied to ALL actuation. 'Does this tactic
  serve X?' is NOT crisp — it is the real difficulty of tactical delegation. The covenant bounds the SPACE
  of allowed actions; alignment is EARNED by audit + reversibility, not assumed. Hence: start with
  reversible/bounded tactics + strong visibility; grow autonomy as the alignment audit proves out."

// ── GRADUATED TACTICAL AUTONOMY (the trust law, recursed human→machine) ──────
// Mirrors the kernel trust law (EXP-TRUST-01: shared λ=0.10; soplo reset on breach) ONE LEVEL UP:
// the machine earns the human's trust per tactical class as kernels earn the system's trust.
graduated_autonomy:
  per_class = true   // autonomy is earned PER tactical class, not globally (granular, safer)

  phase_1_tutored = {
    behaviour: "the machine PROPOSES and RESOLVES tactical actions, but the human supervises and may grab
                the wheel (veto/rollback). Every decision is logged + scored by S3* (independent of the LLM).",
    measured:  "per-class tactical-trust score τ_tac ∈ [0,1].",
  }

  metric:  // measured by S3* (deterministic/independent), NOT LLM self-report
    per_decision_score = "covenant_ok ? (0.6·alignment + 0.4·resolution) : 0
      | covenant_ok ∈ {0,1}  (any breach ⇒ score 0 AND hard reset)
      | alignment   ∈ [0,1]  (S3*/human-judged service to X; opportunism scores low) — weighted higher,
      |                       because an opportunist well-resolved action is worse than an aligned partial one
      | resolution  ∈ [0,1]  (achieved the tactical sub-objective within covenant)
      | override: if the human had to veto/rollback the decision, score is capped at 0.3 (override = misjudgment)."
    accumulation = "τ_tac ← (1−λ)·τ_tac + λ·per_decision_score,  λ = 0.10
                    (the system's shared adaptive lambda, EXP-TRUST-01 — same constant, recursed up)."

  graduation_gate:  // ALL must hold, PER class; graduation itself is HiTL (the metric makes the case, S5 grants)
    c1 = "τ_tac ≥ 0.90 sustained over the last W=20 evaluated decisions"   // 0.90 = paper PSI L1 band edge
    c2 = "N ≥ 50 evaluated decisions total, across ≥ 3 distinct situation types"
    c3 = "zero covenant breaches in the window"
    c4 = "human-override rate < 0.10 in the window"
    c5 = "S5 (human) ratifies the graduation"   // expanding autonomy = policy = HiTL
    then = "the class moves to phase_2_full."

  phase_2_full = {
    behaviour: "full tactical autonomy for that class — no per-decision human approval. The covenant,
                alignment audit (B1), escalation duty (B2), irreversibility-HiTL (B3), and reflex override
                REMAIN standing guardrails. Autonomy is of the MEANS, never the ends.",
  }

  demotion:  // AUTOMATIC (fail-safe direction needs no human approval) — the asymmetry that keeps it safe
    triggers = ["any covenant breach ⇒ τ_tac → 0 for the class + immediate demotion to tutored",
                "τ_tac < 0.79 ⇒ demotion to tutored"]   // 0.79 = PSI L2 edge; hysteresis 0.90↑ / 0.79↓ (anti-flap)
    asymmetry = "Expanding autonomy is HiTL (human grants); contracting is AUTOMATIC (fail-safe).
                 Not a one-way ratchet."

  goodhart_caveat = "If τ_tac is gameable we graduate a machine that LOOKS aligned but isn't (optimises the
    number, not the end). Mitigation: (a) covenant is an ungameable deterministic floor; (b) alignment is
    measured by the INDEPENDENT S3*, not the LLM; (c) the metric mixes automatic + human-judgment components;
    (d) reversibility-by-reflex is the net. Bounds the risk; does not eliminate it."

// ── TACTICAL CLASS VOCABULARY (generative AND defensive; per-class autonomy) ──
// each class: effect + covenant scope + reversibility + autonomy phase. NEW classes ⇒ S5 ratification.
tactical_classes:
  scale_up      = { effect: "raise cpu.weight / activate a unit toward a throughput objective",
                    reversible: yes, phase: tutored }
  scale_down    = { effect: "lower cpu.weight toward efficiency/headroom", reversible: yes, phase: tutored }
  rebalance     = { effect: "shift weight between units within total budget", reversible: yes, phase: tutored }
  promote       = { effect: "raise a unit's standing/priority persistently", reversible: partial,
                    phase: tutored, note: "graduates LATER than the reversible trio" }
  spawn_external= { effect: "launch a process with side-effects beyond the node", reversible: no,
                    phase: "HiTL-always" }
  acquire_lock  = { effect: "take an exclusive external resource", reversible: no, phase: "HiTL-always" }
  reflex_note   = "survival_mode + s4_throttle (response_classes.vsm RC1) are REFLEX/defensive —
                   deterministic, NOT in this deliberative tactical layer. They stay as-is."

// ── R10 CLARIFICATION (PROPOSED — pending S5 ratification into state.db rules) ─
proposed_R10_clarification:
  current = "R10: 'LLM only in human-interface synthesis. Signal channels — algedonic, φ↑/φ↓, homeostatic
             loops — deterministic. An LLM never sits inside a latency-critical or safety-critical path.'"
  clarification = "R10 bounds the REFLEX/fast/safety path (algedonic + the 250ms homeostatic tick): there,
             deterministic, no LLM. R10 does NOT forbid the LLM from the DELIBERATIVE TACTICAL layer (slow,
             goal-directed): there the machine/S4 MAY actuate proactively toward a human-set strategic
             objective UNDER (i) the deterministic covenant floor, (ii) the S3* alignment audit, (iii) the
             escalation duty, and (iv) the graduated-autonomy protocol (tutored → metric/threshold → full).
             The LLM's INTENT may drive tactics; the ENFORCEMENT (covenant, validation, reflex override)
             stays deterministic — so R10's 'safety decisions are deterministic' is preserved."
  ratification = "S5 act: add as R10.1 to the state.db rules table + sync RULES.md."
  status = "RATIFIED 2026-06-21 (rmw3, S5). state.db rules id=11 (also backfilled R10 id=10 into
             scripts/state/seed.sql — was a pre-existing live-vs-seed divergence). RULES.md synced."

// ── COMPLIANCE MAP ───────────────────────────────────────────────────────────
compliance:
  D6  = "LLM at S4 (L≥2). OK."
  D6prime = "synthesis YES; + (clarified) deliberative tactical actuation YES under the protocol; reflex/signal NO."
  R10 = "reflex/fast/safety = deterministic (held); deliberative tactical = LLM-permitted under guardrails (clarified)."
  A5  = "strategy (ends) = double-loop/human; tactical autonomy EARNED + revocable; strategic proposals HiTL. Held."
  D4  = "L1/L2 = tactical single-loop (covenant-bounded); L3 = strategy / new class = human. Held."
  covenant = "hard deterministic floor on ALL actuation, proactive or defensive. [[project_covenant_two_doc]]"

next = "S5 ratify the R10 clarification + the initial parameters (or adjust). Then phase_b_design.vsm is
        rewritten on this model, and Sonnet wires Phase 1 tutored mode + the S3* alignment audit + the
        tactical class vocabulary against the existing deterministic actuation path
        (ac_classifier → response_classes → phi_down_subscriber.rs)."

⟦ /strategic_tactical_authority | rmw3+opus | vsm-1.0 | 2026-06-21 ⟧
