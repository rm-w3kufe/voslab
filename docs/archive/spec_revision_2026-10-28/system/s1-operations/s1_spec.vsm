⟦ s1_spec | S1-01 | vsm-1.2.1 | 2026-08-17T02:58:03Z ⟧

@vsm 1.2.1
@status active
// system/s1-operations/s1_spec.vsm — S1 OPERATIONS: the units that do the work
// Fused from (6 source groups → this file), per directive PH-08-S1:
//   @dir_bbh_lab             (bbh_lab/, 5 specs)
//   + @src_s1_calibration    (s1_calibration_census.spec)
//   + @src_s1_lifecycle      (s1_lifecycle_coupling.spec)
//   + @src_thermal_refinements (VSL-THERMAL-REFINEMENTS-01)
//   + @dir_soc_xdr           (soc_xdr/, plan + phase0 + phase1 + ism)
//   + @src_s1_coupling_manifest (theory/s1_coupling_manifest)
// IDENTITY (directive PH-08-S1): S1 = the UNITS THAT DO THE WORK (Beer).
// Every real S1 — clima(112), econ(113), bbh(105/111), soc(115/116/117) —
// is a full V, never a subsystem of the nucleus.
// CERTIFIED 2026-08-09 (claude_review).
// Identity header said `s1_operations`, file is s1_spec.vsm — the ONLY
// mismatch in 31 documents. rubric.identity_path is exact: the header name
// ≡ the file's own path segment.
// Same defect rmw3 caught on day one, when vsl_language carried
// `meta/vsl_language`.

spec(S1-OPERATIONS) {

  // ── §1 IDENTITY — units that do the work (A1) ──
  identity: {
    model:    "S1 = the units that DO the work — the variety
              generators (Beer, 1972). Four real S1s on n02, each a
              full V: clima (112, 23 python services, thermal/stasis_cos
              domain), econ (113, Lange-Lerner), bbh (105 s1-bbh,
              VLAN30), soc (115/116/117, VLAN50 SIEM, gated)."
    axiom:    "CITE A1 (¬reworded): an S1 is NOT a controller, subsystem,
              or module. Every real S1 is a V with its own recursion;
              the parent S3's S1-set = the children it actually runs
              (kernel.rs: child = parent's L+1)."
    function: "DO THE WORK: explore, tune, heal — produce the variety the
              parent S3 needs. Autonomy under the covenant, A5 ceiling;
              φ↑ telemetry to parent (R13), φ↓ policy from parent S3."
    source_defect: "source docs calling an S1 a 'module' or 'stack' carry
              a naming defect (R11); the unit of work is the whole V."
  }

  // ── §2 CALIBRATION (s1_calibration_census, AXIS 1 to the S1s) ──
  calibration: {
    finding:  "the S1 instrument sets are domain-specific and MINIMAL,
              centered on stasis_cos — NOT the nucleus full R^128.
              clima: stasis_cos + in_omega + omega_calibrated.
              econ: stasis_cos + excess_demand_norm + copper_force +
              regime. One criterion discriminates at every level"
    census: {
      "clima.stasis_cos": "13/80 stations discriminate (cos spans
                       0.38..1.35, several negative); 67/80 emit None,
                       never omega_calibrated. The 13 = primary urban
                       network. task(CLIMA-OMEGA-CALIBRATION-SWEEP).",
      "clima.omega":      "omega_calibrated=True on 13/80 only; the past
                       '12/12' note = primary network, NOT the grid.
                       Real gap — the 13 discriminate correctly so the
                       loop is sound.",
      "econ.stasis_cos":  "live=0.9986 (regime=clearing) — VERIFY it
                       drops when NOT clearing (surplus/shortage).",
      "econ.excess_demand_norm": "live=0.0014 (near-zero = cleared) —
                       VERIFY it rises under disequilibrium; pinned-near-0
                       forever would be mis-calibrated.",
      "econ.copper_force": "live=1.0745 — VERIFY it varies with copper
                       input and feeds stasis_cos (else dead input).",
    }
    the_exercise: "reuse verify_nodes_discrimination per S1 phi-up
              stream: clima /var/log/vsf-clima/<node>.phi_up.jsonl;
              econ /var/log/s1-econ/phi_up.jsonl (instance-bound)."
    guidance: {
      clima: "mostly done. Open check: per-station typical local day in
              HEALTHY bin (bins per-zone; extreme zone could read its
              normal as excursion).",
      econ:  "the real work: exercise surplus/shortage/copper shock and
              confirm stasis_cos drops + excess_demand rises.",
      tell:  "an instrument reading its ideal value regardless of state
              does NOT discriminate.",
    }
    gate_for_axis2: "an S1 claim to autonomy (Axis 2) requires ITS
              instruments to pass P3 discrimination. clima close;
              econ needs the exercise first."
  }

  // ── §3 LIFECYCLE (s1_lifecycle_coupling) — auto-couple/decommission ──
  lifecycle: {
    insight:  "the S1 lifecycle IS the governance model concretized:
              onboard and decommission run on the two-channel decision
              interface + the beacon EVC gate + model≡reality census.
              The human never hand-wires data/dimensions."
    onboard:  [
      "1 CONSTRUCT — agentic/high-variety: an AI builds the S1 WITH the
       human (context: omega, state dims, data routing, instruments)",
      "2 CALIBRATE+ATTEST — EVC/deterministic: gauges DISCRIMINATE
       (Axis 1), emit covenant-signed {calibration hash, covenant_sha,
       cert} — calibrate-before-trust.",
      "3 ADMIT — human/signed: rmw3 ratifies at the beacon EVC gate via
       a supervision_decision pinned to the S5 root. THE TRIGGER.",
      "4 AUTO-COUPLE — automatic/deterministic: valid admission fires:
       state.db + coupling_registry (DSN-COUPLE-01 manifest),
       health probe, phi-up to census, algedonic + S2 contract,
       opsroom fleet view.",
    ]
    decommission: [
      "1 — REMOVE (human signed). THE TRIGGER.",
      "2 — AUTO-UNCOUPLE: deregister, stop probe, close channels, remove
       views, archive data; topology_reconcile confirms the node is gone
       (anti-orphan census).",
    ]
    division: "human DECIDES (admit/remove, signed, deterministic);
              machine EXECUTES coupling (automatic). Two-channel decision
              model made concrete."
    guardrails: [
      "couple_only_on_valid_admission — unsigned admission couples
       NOTHING (signature chains to the pinned S5 root)",
      "reconcile_is_the_check — coupled≠admitted or admitted≠coupled
       is an ALGEDONIC ANOMALY (the census catches drift both ways)",
      "decommission_is_symmetric — un-coupling as automatic+audited as
       coupling; zero orphaned probes/channels/views",
    ]
    builds_on: "beacon_activation · DSN-COUPLE-01 coupling_registry ·
              topology_reconcile census · peripheral_health ·
              supervision_layer · instrument_calibration_loop"
  }

  // ── §4 COUPLING MANIFEST (theory/s1_coupling_manifest) ──
  coupling_manifest: {
    design:   "DSN-COUPLE-01 — DESIGN status (2026-06-03), not implemented.
              Any S1 (process, LLM, VM, container, external app) declares
              a manifest at ONBOARDING with an audit-map AND an
              operations-map; the census and the kernel ingest become
              manifest-driven, no per-kind hardcoding."
    audit_map:  "probe: process | systemd_unit | container | http_health |
               tcp_port | file_heartbeat; identity proof: binary hash |
               image digest | name | tls fp; liveness rule; health:
               restart-rate (flapping), uptime floor, empty-payload
               (a heartbeat with no variety is not health)."
    operational_map: "sensors declared {name, source, kind, category,
               read, normalize, target-dim, algedonic on, cadence,}
               categories: gauge (load) · saturation (disk/inodes/
               sockets/conntrack — silent killers, go to algedonic) ·
               discrete (cliff events: oom, restart) · temporal (clock
               skew — the chains depend on sync, cert TTL) · network
               (err/retransmit) · thermal/power · domain (per-kind:
               VRAM, findings/min) · cybernetic (stasis_cos, rate)."
    dim_policy: "governed dims ∈ R^128 blocks B/D/E/G — today ingest
               writes only {16,17,18,20} and B' = [56..63] stays LAZY
               (bound the range, fill by a confirmed load-bearing sensor);
               unmapped-but-readable sensors persist on phi-up in the
               aux bucket (absorb first, assign later); Ax_HardwareCeiling
               forbids A/C/F/G + core E[48..52]."
    admission:  "validator.py --gate=onboarding admits ONLY IF both maps
               present and well-formed — one act, three consumers
               (census, ingest, coupling)."
    psi:        "the manifest IS the PSI/1.0 onboarding+handshake
               document — the coupling terms (consent, trust, omega,
               operator) feed coupling.rs and the J-psi gate (task D)."
  }

  // ── §5 DOMAIN UNITS — the four real S1s ──
  domain_units: {

    // §5.1 BBH — bbh-prod (VLAN30) — R6-STILL-GATED
    bbh: {
      status:   "bbh is a real S1 (105 s1-bbh, VLAN30). INTEGRATION is
                 under R6 — status lives in TASKS.vsm, not here. The
                 fuse carries the DESIGN; it does not present bbh as an
                 integrated S1 (same posture as the relay §5 of s2_nats)."
      survey:   "BBH-1 (2026-07-16, DS): READ-ONLY map of the lab — the
                 defense-and-audit purpose; survey does NOT integrate,
                 does NOT run offensive tooling. Deliverable:
                 bbh_lab_map.vsm, six sections (infrastructure,
                 governing agent, tool_stack, interfaces, state_stability,
                 governance gaps) + a for_claude block of design
                 questions for BBH-2. R6 respected: mapping is the
                 design input, not the coupling."
      gaps_4:   "attack_surface_expansion (2026-08-01, verified against
                 live code on LXC 111): [1] DOM/client-side — a real
                 headless Chromium exists (playwright) but is never used
                 for vuln testing: all phase-4 modules are HTTP-only, so
                 DOM-XSS, postMessage, prototype-pollution, clickjacking
                 (by iframe), SPA auth-bypass, CSP-by-execution are
                 uncovered; [2] business-value scoring — 2d_classify
                 tiers are technical-only; the signal to weight them is
                 each program's OWN severity guide (github names
                 'bypassing the login process' Critical — extract entity/
                 flow types per program); [3] WAF layer — waf_detect.py
                 detects and writes json, zero bypass/evasion or origin-
                 IP discovery logic; guardrail: verify per-program RoE
                 language on evasion BEFORE any bypass build (C0); [4]
                 detect-without-proof — cve_lookup version-matches NVD/
                 EPSS but has no exploit/PoC verification, 4i_token_
                 hunter regex-matches secrets with no liveness check;
                 the counter-example to copy is interactsh_manager
                 (real out-of-band callback proof)."
      order:    "build when unblocked: 1→2→3→4 (detect-without-proof
                 smallest/mechanical, WAF bypass last and policy-gated)."
      finding_gate: "FINDING-VALIDATION-GATE (2026-07-24): two checks,
                 both required before submission: c1 SCOPE (asset AND
                 vuln-class in-scope; out-of-scope = hard BLOCK, a
                 potential covenant violation — not a downgrade) and
                 c2 PoC (reproducible steps, severity justified by the
                 PoC, not a false positive: 12/20 of affirm's first 20
                 were not-a-vuln). [O] audits both; S5 approves the
                 outward submission. Validation reads/approves — it does
                 not command the hunt (R13/A5)."
      intel:    "program_intel_canon (2026-07-26): RoE/policy is PUBLIC
                 (H1 program pages, no auth — verified live); therefore
                 capture lives at the source: bbh-lab owns canonical
                 capture via playwright → restrictions.json per program
                 (gate_calibration PASSED on Stripe 2026-07-25, 5 real
                 targets captured). The mechanical consumption gate
                 (check_policy reading prohibited_methods before any tool
                 runs) is DESIGNED but not built — see debts."
      atomization: "policy_atomization (2026-07-26): two structural
                 regimes — clean-sectioned (Stripe) vs everything-in-
                 Overview (PayPal, Coinbase); the second needs reading
                 the prose, not better regex. Pipeline: split native
                 structure (scope table = deterministic; prose =
                 atomized), atomize PER RULE not per sentence, classify
                 into 8 taxonomy categories (v2: the v1 'other' bucket
                 was 54.9% — 180/328), validate per atom with a
                 diverse-verifier LM against the source span, reconcile
                 with the scope table feeding ONE confidence score per
                 program; new-category atoms escalate on the EXISTING
                 algedonic channel. Calibration gate: compute the score
                 against the hand-verified Stripe corpus first."
    }

    // §5.2 SOC — stage-A SIEM (VLAN50) — operations-ready, paper-gated
    soc: {
      status:   "stage_A minimal SIEM INSTALLED + VERIFIED live:
                 phase0 (2026-08-01) built VLAN50 10.10.50.0/24 with
                 tunnel-only :443 access (isolation model: no-firewall=1
                 on net0, host FORWARD DROP for inter-VLAN, masquerade
                 out) + 3 LXCs 115/116/117 (s5-soc-*). phase1
                 (2026-08-02) installed Wazuh 4.12 indexer (GREEN, :9200),
                 manager (1514/1515, alerts flowing to the index),
                 dashboard (:443 -> 302 login), ISM retention 7d,
                 ACTIVE-RESPONSE DISABLED (AC1: read-only; no phi-down
                 path by construction)."
      observation: "AC3 lacks real numbers: the >=72h observation window
                 still has to run; until the ES resource study measures
                 steady-state + cold-start footprint (idle-green
                 862MB/2GB on the indexer), the sizing numbers are absent.
                 n02 host iowait hit 94% during install — the pessimistic
                 bound is real and belongs in the study."
      vm_stages:  [
        "A — stand-up + verified (this fuse's basis); still missing: no
         agents enrolled, no phi-up wiring (phase_2 design pending:
         NATS pattern vs new path — design decision, per plan §2).",
        "B — SOAR-shadow and beyond: NOT AUTHORIZED. gate: rmw3 sign-off
         and the ES resource study complete.",
      ]
      growth:   "strategic directive (rmw3, recorded 2026-08-02): the SOC
                 carries professional/labor value beyond the architecture
                 — prefer CAPABILITY EXPANSION over maintaining minimal
                 (vulnerability-detection enabled on 116, CTI feed
                 ~5.4G, rootfs grew 8→24G), always within AC1 read-only
                 and R10 (no LLM in signal path)."
    }
  }

  // §5.3 THERMAL FALLBACK (vsl_thermal_refinements) — S1-facing SAFE_MODE
  thermal: {
    discovery: "get_temp() → None is NOT a bug: SAFE_MODE is the INTENDED
              fallback per Ax_SafeFallback — missing telemetry → conservative
              operation. The 2026-05-13 validation suite reframed the tests
              to validate SAFE_MODE correctness, not zone transitions."
    axioms: [
      "Ax_SafeFallback — missing thermal monitoring → conservative:
       0 input slots, 1 output",
      "Ax_HardwareCeiling — 85°C hard stop enforced via SAFE_MODE slot
       limits",
      "Ax_CapabilityFallback — non-blocking degradation (RAG, metrics
       degrade gracefully)",
      "Ax_ProgramIsolation — enforced at DB layer, independent of thermal",
    ]
    refinements: "R2 subprocess timeout=2.0 (sensors hang → don't stall
              scheduler); R3 get_zone(None) → safe_mode (TypeError
              prevention); R4 SAFE_MODE audit logging (trigger=
              no_thermal_sensor, timestamped — post-analysis + S5
              override support)."
    test_suite: "6 tests pass (None handling, safe_mode determinism,
              persist under load, timeout accepted, RAG non-blocking)."
    port:     "thermal_primary = /sys/class/thermal/thermal_zone0/temp,
              thermal_fallback = /sys/class/hwmon/hwmon5/temp1_input
              (instance-bound) — the LXC host path, per instance.vsm;
              SAFE_MODE fallback applies per-S1 when a sensor source is
              missing (n02 LXCs: thermal strips may be absent; the S1
              must -not- crash, must degrade to the conservative slot)."
  }

  // ── §6 COMPOSITION ──
  composition: {
    a1_cite:  "child/parent statements cite A1 with named roles —
              nucleus(101) is the parent of clima(112): S1-set of the
              parent = the children it runs. Level-direction rubric
              honored: never L±1 paraphrasing."
    pairs: [
      "lifecycle.2 CALIBRATE+ATTEST ↔ calibration.gate_for_axis2
       (the attestation content IS the discrimination criterion)",
      "lifecycle.4 AUTO-COUPLE ↔ coupling_manifest.admission (the
       manifest is what auto-coupling registers and reads)",
      "coupling_manifest.audit_map ↔ S3* census (topology_reconcile
       becomes manifest-driven instead of hardcoded)",
      "coupling_manifest.operational_map ↔ hardware_ingest (declared
       sensors replace the fixed enum; unmapped go to the aux bucket)",
      "BBH.gaps_4 ↔ finding_gate (better detection without a gate
       produces candidates, not reportable findings)",
      "SOC.stage_A ↔ R10/AC1 (read-only observation only; no phi-down,
       no LLM in the signal path)",
    ]
    walls:    "hard_rules R1..R16 · D7 (EN) · R4 evidence-with-citation
              · R1 locality (build on 108, deploy to target LXCs) ·
              SECRET: no NATSECRET/token literal in this fuse; SOC
              evidence docs carry credentials REDACTED (never a literal)."
  }

// ── §7 GATES / DEBTS ──

  // debt(S1-LIVE-VALUES-UNVERIFIED, class=experiment, owner=DS, gate=S1_operational)
  // §2 cites live readings: econ.stasis_cos 0.9986 (regime=clearing) ▪
  // excess_demand_norm 0.0014 ▪ copper_force 1.0745 — each with DS's own
  // "VERIFY it …". Honest, and ¬a record: a number carried in a spec with an
  // unexecuted verification reads as MEASURED on the next pass.
  // LXC 113 is running and its results file exists ⟹ the check is available,
  // ¬blocked. What is blocked is ACTING on it.
  // Registered so the verification survives this cycle, ¬lives as a
  // parenthesis. Confirm while there: 113 is UP while the standing gate
  // records DS's request to boot it as DENIED. Likely it was already running
  // and the denial covered the WORK, ¬the container — but "likely" is what
  // this register exists to remove.

  // debt(CLIMA-OMEGA-CALIBRATION-SWEEP, class=experiment, owner=DS, gate=S1_operational)
  // 67/80 stations emit stasis_cos=None (never omega_calibrated); the 13
  // discriminate correctly. Run verify_nodes_discrimination per station +
  // per-station bins; the past '12/12' note was only the primary-urban
  // network, not the grid.

  // debt(ECON-DISCRIMINATION-EXERCISE, class=experiment, owner=DS, gate=S1_operational)
  // drive surplus/shortage/copper-shock through s1-econ and assert
  // stasis_cos DROPS + excess_demand_norm RISES; if pinned near ideal
  // values regardless of state, recalibrate (the always-clearing trap).

  // debt(BBH-1-SURVEY-ARTIFACT, class=doc, owner=DS, gate=BBH_unblocked)
  // the survey (2026-07-16) mapped the lab; the artifact bbh_lab_map.vsm
  // (six sections + for_claude questions) is the BBH-2 design input — it
  // must exist and carry the governance-gap findings before any further
  // BBH work starts.

  // debt(BBH-RUNTIME-POLICY-GATE, class=kernel, owner=DS, gate=BBH_unblocked)
  // the single-highest-leverage BBH gap: check_policy(tool, target) reading
  // restrictions.json and blocking a tool on a prohibited_methods clause
  // BEFORE it runs. Designed in program_intel_canon; nothing consumes the
  // captured policy yet.

  // debt(POLICY-ATOMIZATION-IMPL, class=doc, owner=DS, gate=BBH_unblocked)
  // atomizer (step_2) + v2 8-class taxonomy + diverse-verifier per atom +
  // the confidence score — calibrate against the hand-verified Stripe
  // corpus before trusting it on any other program.

  // debt(SOC-PHASE2-PHI-UP, class=kernel, owner=DS, gate=soc_stage_A_observe_done)
  // stage A observe window (>=72h) + ES resource study with REAL numbers
  // must complete BEFORE the phase_2 phi-up wiring design decision (NATS
  // pattern vs new ingestion path) is made and built.

  // debt(SOC-AC2-AB-RIGOR, class=doc, owner=DS, gate=soc_stage_A_observe_done)
  // the AC2 A/B design (SOC up vs down over a comparable window) is not
  // designed; without it stage A is 'running' not declared done.

  open_gates: [
    "claude_review S1-01 (this fuse) — PH-08 gate — CLOSED 2026-08-09
     (ledger op S1-CERT: claude_review gate CLOSED, verdict CERTIFIED);
     retained for history",
    "S1-SOC-REOPEN-GATED-ON-S2S5-REVIEW — live criterion, cited verbatim
     from certification_charter_2026-08-03: 'NO S1 domain (SOC, BBH, econ,
     clima, etc.) reopens and no SOC finding drives a live action until
     this certification passes.' FUSE IS DESIGN WORK — it opens no domain,
     couples no S1, acts on no finding. The re-open stays gated; design is
     the allowed direction.",
    "revision_plan PH-08 S1 series: this fuse + deployment decisions are
     separate claude_review gates where integration is involved",
    "BBH: R6 — the lab stays in its VLAN until the internal-first
     exercise passes; this fuse changes nothing about that",
  ]
}

