    floor: "esp32-algedonic-sensor node_profile (Rust no_std, llm='none (D6)', S1-only φ↑ emitter) — proof the certifier can be tiny and non-cognitive",
    relation: "= the 'minimal nucleus' / vsi.rs S0..S5 core; every recursion level runs the SAME certifier",
  },

  viability_attestation: {
    is: "a signed document the embedded certifier emits, REVEALING the instance's
