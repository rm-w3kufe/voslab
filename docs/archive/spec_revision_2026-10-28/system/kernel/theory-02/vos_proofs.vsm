// ═══════════════════════════════════════════════════════════════════════════════
// 1. LYAPUNOV DESCENT — Thm_DirectExpansion (viability per system)
// ═══════════════════════════════════════════════════════════════════════════════

// origin: lyapunov_proof.vsm (authors Claude@S3 + Qwen@S4 VSL-RES-01..04)
// derivable from Ax_SplitOperator + Ax_RecurrentSet + Ax_Ω_Closure

theorem(Thm_DirectExpansion, "Lyapunov descent on recurrent set under split operator") = {
  setting: {
    state_space:   "x ∈ ℝ¹²⁸",
    feasible:      "Ω ⊂ ℝ¹²⁸ compact convex (intersection of ellipsoids)",
    operator:      "x(t+1) = f₀(x(t)) + σ(t)·η(t)",
    f0_form:       "f₀(x) = Σ_{s ∈ {S1..S5}} softmax(logits_s(x); τ)·μ_s",
    noise:         "η(t) ~ N(0, I₁₂₈) iid isotropic; 0 < σ_min ≤ σ(t) ≤ σ_max",
  },
  lyapunov: "L(x) = α(1−cos(x,x̄)) + β·H(t)/H_max + γ·max(0, B−B_avail) + δ·ReLU(H_rest_drift)",
  weights:  "α,β,γ,δ > 0; x̄ ∈ Ω reference attractor center; H ∈ [0,H_max]; H_rest_drift = H_rest(t)−H_rest_target",
  claim: {
    "(a) E[L(x_{t+1})−L(x_t)|x_t] ≤ −ε ∀ x_t ∈ Ω∖R",
    "(b) E[L(x_{t+1})−L(x_t)|x_t] ≤ b  ∀ x_t ∈ R",
    "⟹ positive recurrent on R [Foster drift] ⟹ ∃ unique stationary π on R ⟹ ergodic, mean decrease holds",
  },

  assumptions: [
    "A1_lipschitz: ‖f₀(x)−f₀(y)‖ ≤ L_f·‖x−y‖; L_f = max_s ‖∇logits_s‖/τ (bounded for τ ∈ [0.05, 1.0])",
    "A2_C2: L ∈ C² on interior of Ω; max/ReLU kinks handled by Clarke subgradients (Lemma below)",
    "A3_bounded_hessian: ‖∇²L‖_{op} ≤ M ⟹ noise term ≤ M·σ_max²/2",
    "A4_contraction: ⟨∇L, f₀(x)−x⟩ ≤ −ε₀·dist(x,x̄)² ∀ x ∉ B(x̄,r₀) — validated by EXP-SB-01 (D_KY=3.00, mean_dL→0)",
    "A5_noise_isotropy: E[η]=0, E[ηᵀMη]=tr(M)",
  ],

  lemma(Lemma_SubgradientHandling, "ReLU/max-zero terms admit drift via Clarke subgradients") = {
    statement: "E[g(x+Δ)−g(x)] ≤ ‖∇h‖·‖Δ‖₁ + O(‖Δ‖²); γ-term ≤ σ·K_B (K_B = max‖∂B/∂x‖), δ-term ≤ σ·K_H",
    conclusion: "non-smooth terms ⟹ add to the noise bound, ¬obstruct drift ⟸ γ,δ dominate the ε₀ surplus",
  },

  proof(Thm_DirectExpansion): [
    "step_1 Taylor: Δ = (f₀(x)−x) + ση; E[ΔL|x_t] = ⟨∇L, f₀(x)−x⟩ + ½E[Δᵀ∇²LΔ] + E[R(Δ)]  (linear noise vanishes by A5)",
    "step_2 drift: ≤ −ε₀·dist(x,x̄)² outside B(x̄,r₀)",
    "step_3 diffusion: ≤ σ²·tr(∇²L) ≤ σ²·128·M + σ·(γ·K_B + δ·K_H)",
    "step_4 remainder: |E[R(Δ)]| ≤ C·O((σ_max + L_f·d_max)³) bounded by Ω compactness",
    "step_5 combine: E[ΔL] ≤ −ε₀·r_R² + ½σ_max²·128·M + σ_max·(γK_B+δK_H) + C·σ_max³ =: −ε < 0 outside R",
    "step_6 choose α* > (γK_B + δK_H + 128·M·σ_max²/2)/ε₀ ⟹ Foster: unique π, ergodic ∎",
  ],

  corollaries: [
    "Cor_GovernedDefinition: governed(x_t) := (x_t ∈ Ω) ∧ (mean E[ΔL] over window ≤ 0) ∧ (E[L] within R) — theorem-grounded, replaces boolean-trust heuristic",
    "Cor_AlgedonicTrigger: E[ΔL|x_t] > −ε/2 over T_obs ticks ∧ x_t ∈ Ω ⟹ R may be drifting → algedonic(degrade); distinguishes parameter drift (slow R move) from policy violation (Ω exit)",
    "Cor_ReframeRecertification: after reframe() verify anew — (1) re-estimate {ε₀,M,K_B,K_H,L_f}, (2) check ∃R drift inequality, (3) wait τ_recert = 2·τ_rec; any fail → rollback",
  ],

  runtime_estimation: [
    "ε₀ ≈ −median(⟨∇L, f₀(x)−x⟩/‖x−x̄‖²) over N≥100 ticks — lyapunov.rs::estimate_contraction_rate",
    "M ≈ max‖∇²L‖ finite-difference on telemetry; K_B from cgroup hardware spec",
    "Λ (Lipschitz of σ) ≈ max|dσ/dt| — adaptive_clock.rs for Δt_max bound",
  ],

  scope: {
    guaranteed:     ["unique π; recurrence a.s.; mean drift ≤ −ε outside R; policy keeps x_t ∈ Ω"],
    NOT_guaranteed: ["global descent — E[ΔL] > 0 within R", "a.s. descent — mean only",
                   "finite-time rate", "robustness to Δf₀ ⟹ needs re-cert"],
    open_for_paper: ["rate analysis |E[L]−L*|; concentration P(|L−L*|>ε) ≤ ?; robustness under plasticidad acotada"],
  },
}

// ═══════════════════════════════════════════════════════════════════════════════
// 2. COMPOSITION — Thm_Compose (viability under ψ-coupling)
// ═══════════════════════════════════════════════════════════════════════════════

// origin: composition_proof.vsm (formalization of dynamics_choice.vsm §G3)
// derivable from Ax_SplitOperator + Ax_ψ_Preserve + Ax_RecurrentSet + Def_ArbiterAPI
// implements: proof obligations behind coupling.rs (F5.x.6)

// NOTATION: V_A,V_B viable ℝ¹²⁸ kernels (own Ω, S3, trust); ⊗_ψ = ψ-composition;
//   J_ψ = Jacobian of coupling map (M_ψ = U·Vᵀ, rank ≤ 16); B_h = A3 hardware ceiling

theorem(Thm_Compose, "ψ-composition preserves viability under 4 preconditions") = {
  statement: "viable(V_A) ∧ viable(V_B) ∧ (P1) ∃S3_AB ∧ (P2) Σquota_i ≤ B_AB ≤ B_h ∧ (P3) ‖J_ψ‖<1 ∧ (P4) trust_AB ≥ min(trust_A,trust_B) ⟹ viable(V_AB)",
  proof: [
    "step_1 state: Ax_ψ_Preserve: ψ(x_A,x_B) ∈ Ω_AB ⟺ x_A∈Ω_A ∧ x_B∈Ω_B ∧ (P4) ⟹ joint operator maps Ω_AB→Ω_AB (well-posed)",
    "step_2 lyapunov: L_AB = L_A∘π_A + L_B∘π_B + κ·‖coupling residual‖; each L_i satisfies Thm_DirectExpansion on own R_i",
    "step_3 contraction: (P3) Banach-style: contraction + 2 recurrent summands ⟹ ∃ joint recurrent set R_AB; E[ΔL_AB] ≤ E[ΔL_A]+E[ΔL_B]+(‖J_ψ‖−1)·‖residual‖ ≤ 0",
    "step_4 budget: (P2) no starvation; (P1) S3_AB enforces allocation ⟹ viable(V_AB) ∎",
  ],
  remark: "P1..P4 ≡ the 4 no-compose failure modes negated;
           ∀ corollary ≡ contrapositive of ONE precondition",
}

corollary(Cor_NoCompose_1, "resource contention") = {
  statement: "Σquota_i > B_h ⟹ ¬viable(⊗_ψ V_i)", negates: "P2",
  proof: "∃V_j: B_realized < B_assumed ⟹ γ-term persistently positive ⟹ E[ΔL_j]>0 sustained ⟹ V_j leaves R ⟹ ¬viable ∎",
  enforcement: "Def_ArbiterAPI.allocate rejects Σ quota > B_h (admission control)",
}

corollary(Cor_NoCompose_2, "algedonic resonance") = {
  statement: "∃ φ↑ loop A→B→A with loop_gain > 1 ⟹ ¬viable(⊗_ψ V_i)", negates: "P3",
  proof: "gain g multiplies perturbation by gⁿ; g>1 ⟹ ‖J_ψ‖ ≥ g > 1 ⟹ E[ΔL_AB]>0 ⟹ diverges (Regime::Diverging)",
  enforcement: "M_ψ low-rank bounded singular values + runtime largest-singular-value<1 gate; ALG-1 decay caps cascade",
}

corollary(Cor_NoCompose_3, "phase aliasing") = {
  statement_pragmatic: "|Δt_A − Δt_B| > tol ∧ no sync ⟹ aliasing risk ⟹ ¬viable(⊗_ψ V_i)", negates: "implicit synchrony of E[ΔL_A]+E[ΔL_B]",
  proof: "incommensurate ticks + no sync ⟹ stale σ beyond Bound_Staleness: ½‖∇²L‖(2ΛΔt)² > ε ⟹ descent bound breaks",
  enforcement: "adaptive_clock.rs SeqLock σ_global; bound Δt_max ≤ √(ε/‖∇²L‖)/Λ on BOTH sides",
}

corollary(Cor_4, "trust mismatch", proposed=Claude) = {
  statement: "|trust_A − trust_B| > τ_threshold ⟹ revisit ψ.handshake (capture risk, A0.1)", negates: "P4 in spirit",
  proof_sketch: "Def_TrustCompose clamps trust_parent ≤ min_child + ε; large gap ⟹ V_weak's variety under-weighted ⟹ one-sided contraction ⟹ ¬viable(V_weak) — capture failure, not dynamics",
  enforcement: "Handshake bilateral consent; τ_threshold default 0.2 (calibrate EXP-TRUST-01)",
}

definition(Def_ArbiterAPI) = {
  api:     "{ allocate(V_i, quota), report(V_i, usage), throttle(V_i, factor) }",
  pattern: "stateless function if N ≤ 2; viable V_arb (own S1..S5) if N > 2 or topology dynamic",
  invariants: ["allocate enforces Cor_NoCompose_1 admission control",
               "throttle actuates on quota-exceeded report"],
  // Cor_1 → Cor_NoCompose_1. The abbreviation resolved to ∄ identifier:
  // this document declares Cor_NoCompose_1..3 and cited them short.
  // Found 2026-08-09 by asking a graph engine which identifiers are cited
  // and defined nowhere — the abbreviation is invisible to a reader who
  // already knows what it means, which is every reader who wrote it.
}

hooks: [
  "coupling_rs: runtime ‖J_ψ‖<1 singular-value gate — see debt below",
  // debt(COUPLING-JPSI-GATE, class=kernel, owner=DS, gate=system_certified)
  // Cor_NoCompose_2 says a φ↑ loop with gain > 1 makes the composition
  // non-viable. ∄ runtime check enforces it: the singular-value gate on
  // ‖J_ψ‖ is unimplemented in coupling.rs, so the corollary is a statement
  // the system cannot currently violate-and-detect. Batched with the
  // kernel wave.
  "adaptive_clock_rs: Bound_Staleness negates Cor_NoCompose_3",
  "trust_axes_rs: Def_TrustCompose + τ_threshold for Cor_4",
  "lyapunov_rs: Regime::Diverging = runtime signature of any corollary firing",
  "arbiter: not yet coded; stateless N≤2 is next increment (PSI/1.0 needs V_arb form)",
]

// ═══════════════════════════════════════════════════════════════════════════════
// 3. RECURSIVE VSM — formal theory
// ═══════════════════════════════════════════════════════════════════════════════

V(L) = { tuple: "⟨S1(L), S2(L), S3(L), S4(L), S5(L)⟩ @ E(L)",
         env:   "E(L) = observable environment — what V is embedded IN, ¬a component V has" }
  // CORRECTED 2026-08-07 (claude_review): this line carried the SIX-element
  // tuple with E(L) INSIDE it. Ratified out 2026-08-04 (topology_Δ ∈ D4-L3/A5)
  // and already corrected at :222 of THIS document — one occurrence was fixed
  // and the other was not, so the document defined its own structural axiom
  // twice, incompatibly. Under the old canon's own rule ("all six present —
  // missing → declare non-viable") every system described here was non-viable.
  // Canon: boot/core_boot_primer §structure ∧ boot/covenant §formal_structure.

recursion_axiom: "S1(L) = { V_i(L+1) : i=1..n } — every S1 unit IS a complete V(L+1); structural invariant, not design choice"

budget(L):  "B(L) = min(B_tokens(L), B_compute(L), B_time(L)) — tokens and compute are equivalent scarce resources"
budget_invariant: "B(child) ≤ B(parent) ∀ (parent,child) ∈ V.hierarchy  (frame-local L; within a fixed frame ≡ B(L+1) ≤ B(L))"

tick(L) — VSM_Execute(P, L, B, θ) — one regulation cycle: [
  "1. θ ← read_params(P)                          // φ↓ params.json",
  "2. S2_output ← coordinate(S1_units)            // A4 anti-conflict",
  "3. S3_output ← regulate(S1_units, B)           // D4 allocation, D8 triage",
  "4. ∀s: resolve(s)=∅ ∧ urgency>τ_L → escalate(s)→φ↑; else s.status=deferred (D10)",
  "5. ∀u∈S1: B_u = B·w_u/Σw_j; θ_u = derive_params(u,θ); is_viable(u) ? recurse VSM_Execute(u,L+1,B_u,θ_u) : execute_atomic(u,θ_u) [D6 no LLM at L0/L1]; emit_upward",
  "6. S4_output ← scan_environment(P,L)           // A6 LLM only if L ≤ L_max; AFTER execution",
  "7. S5_output ← apply_policy(S3_output, S4_output); WRITE events.jsonl (φ↑)",
]
recursion_condition: "is_viable(u) ⟺ complexity(u) > τ; else atomic leaf"
termination: ["B(L+1) ≤ B(L) strictly decreases", "project tree finite depth", "leaf → execute_atomic"]

signal_filtering — hierarchical: [
  "escalation (A7): s escalates to the parent ⟺ resolve(s, child) = ∅
   ∧ urgency(s) > τ_child",
  "deferred (D10): resolve = ∅ ∧ urgency ≤ τ ⟹ s.status = deferred, accumulate",
  "meta_shift(V) ⟺ (∃ class: ∀ s ∈ class: resolve = ∅)
   ∧ |class|/|Sig_total| > μ ∧ CalibScore < 0.7  for t > δ
   ⟹ the level is structurally insufficient ⟹ candidate reframe()",
  "absorption: |Sig(parent)| ≤ |Sig(child)|·(1−r), r ∈ (0,1) local resolution
   r ≈ 0.9 ⟹ a grandparent sees ~1% of a grandchild's signals
   ⟹ the root opsroom sees only critical ∨ anomalous —
     a mathematical consequence, ¬a preference",
]

ashby_viability: "regulable ⟺ Var(disturbance) ≤ Var(S3) ⊕ Var(S2)"
ashby_measure: "VSF DECLARES measure(Var) = additive ⟹ ⊕ = +
  [ratified 2026-08-04, D4-L3/A5. live: operational.rs VAR-1,
   dv_in = |Δcpu| + |Δmem| + |Δio|.
   until 2026-08-04 this read Var(S3)·Var(S2), contradicting live code]"
ashby_escape: "disturbance variety > regulator ⟹ escalate to parent ∨ declare outside autonomy ceiling (D3)"

opsroom_views: [
  "System Health → S3 audit (physical resource state)",
  "Pipeline Status → S1 operations (units running/stopped)",
  "Signal Queue → S2 coord (unresolved signals)",
  "Priority Ranking → S4 intel (environment model)",
  "Coverage Gaps → S3→S4 (model-vs-reality gap)",
]
pipeline_alert_pattern: "phase done ∧ ¬next queued after 60s ⟹ MEDIUM —
  a φ↓ failure: the scheduler completed ∧ did not emit the next order"

semantic_memory_as_VSM: [
  "Episodic → S1 upward (events.jsonl)",
  "Semantic → S4 intelligence (knowledge graph)",
  "Procedural → S1 units (skills/, agents/)",
  "Policy → S5 identity (CLAUDE.md)",
  "Coordination → S2 (feedback memory)",
  "MEMORY.md ≡ attenuated S4: the index IS a variety-reduced form
   (a formal mechanism, ¬a metaphor)",
]

notation_as_language: [
  "π-calculus (Milner 1992): P|Q → V_i‖V_j under B ⟹ VSM ≈ π-calculus
   with resource constraints",
  "Actor model (Hewitt 1973): each V(L) an actor; φ↑/φ↓ the messages",
  "Curry-Howard: typed VSM ⟹ types ≡ viability specs, programs ≡ proofs",
  "gap: VSM_semantic →(+operational semantics)→ VSM_executable
   ⟹ needs a reduction relation V→V′ with an interpreter",
]

calibscore: "CalibScore(P,t) = T_expected/T_actual · B_used/B_allocated
  ≈1 ⟹ behaves as modeled ▪ deviation identifies bottlenecks ▪ should be an S1"

reframe(V_id, new_parent_id): [
  "preconditions: governed(new_parent_id) [D11b] ∧ credential-manager.validate [Part IX]",
  "actions: V.parent = new_parent_id; establish φ↑(V_id→new_parent); establish φ↓(new_parent→V_id)",
  "∄ file renamed ▪ ∄ channel destroyed ▪ children unaffected
   new parent gains an S1 unit ⟹ MUST allocate (A2)",
  "L is frame-local: V.id stable, V.L changes with context; trigger meta_shift(V(L0)); double-loop → human approval (D4)",
]

psi_protocol_layers: [
  "layer_1 entry gate: governed(V) = has(params) ∧ emits(events)
   ¬participant in φ↑/φ↓ ⟹ ungovernable ⟹ ∄ ψ",
  "layer_2 trust: trust_score = (1−drift(S4_peer)) ⊕ stability(S3_self)
   level ∈ {none→forbid, limited→restricted, trusted→full}
   maintained by S3* ▪ degrades on drift",
  "layer_3 credentials: validate(V, scope)
   scope = min(credential_scope, allowed_by_trust) — least privilege",
]
credential_manager_note: "¬optional — the minimum infra for ∀ open VSF network;
  itself a VSF system: V(credential-manager) recurses like any other"
language_vs_framework_vs_protocol: "VSL resolves COMMUNICATION ▪ VSF resolves
  ORGANIZATION (recursion) ▪ the protocol resolves SECURITY: who may
  participate, under what conditions"

// ═══════════════════════════════════════════════════════════════════════════════
// 4. INFORMATION FLOW ARCHITECTURE — channels, carriers, invariants
// ═══════════════════════════════════════════════════════════════════════════════

// origin: information_flow_architecture.md v1.0 (rmw3 + Claude, Qwen consensus r1+2)
// status: formal spec — every claim marked ✓/◐/◯

V_structure: "V ::= ⟨S1,S2,S3,S4,S5⟩ @ E(L); ∀s∈S1: s may be V′"
  // S3* is a CHANNEL, ¬a subsystem; E is what V is embedded IN (boot).
  // Corrected 2026-08-06: source predates the 2026-08-04 ratification.
viability_condition: "boot defines viable(V) ⟺ state(V) ∈ Ω(V). The clauses
  below are ¬a second definition — they are the half-space CONSTRAINTS that
  define Ω for this system, per boot's own note that Ω's concrete form is
  implementation-specific:  trust(V) > τ_L ∧ entropy(V) < ε_max ∧
  integrity(V) > 0.  Live: omega_validator.rs — Box/Linear/Ellipsoid
  constraints, trust among the bounded dimensions (trust_hist[i] ∈ [0,1])."
viable_beer_stronger: "viable_beer(V,t) ≡ viable(V,t) ∧ d/dt[viable] ≥ 0 ∧ adaptation_loop_active(S4,S3)"

channels: [
  "φ↑ upward: S1(child)→S3(parent); writer=child; reader=parent; semantic 'child reports what happened'; carrier telemetry/{system_id}/events.jsonl append-only; variety_role=attenuation",
  "φ↓ downward: S5(parent)/S3(parent)→S1(child); 'parent configures child'; carrier telemetry/{system_id}/params.json; variety_role=amplification; read at tick boundary, defaults if absent",
  "ψ lateral: S4(V_A)↔S4(V_B); participants NOT siblings in same tree; preconditions governed ∧ trust≥limited ∧ credential-manager ∧ bilateral S5 approve; mediated expansion_module∘handshake∘S3.filter",
  "S3* audit: S5 ← S3* ← arbitrary level; sporadic asymmetric; sees what S3 misses; maps to direct events.jsonl read by S5 + honeypot/canary (COVENANT_MISMATCH) + external witnesses",
  "φ_algedonic: arbitrary level → S5 DIRECT; BINARY {0,1} — NOT level-graded; priority highest, 'last to die'; compression φ≡1.0 (no attenuation); urgency by ROUTING PRIORITY not payload (graded levels VIOLATE VSL parsimony)",
]

event_schema: "ts ISO-8601 · system_id stable (NOT level-indexed) · event_type tool_run|phase_complete|thermal_wait|token_usage|anomaly|param_change|signal_escalated|signal_deferred · status ok|warn|error · signal_status · duration_s · metrics{}"
escalation_subschema: "signal_escalated {signal_id, urgency CRITICAL|HIGH|MEDIUM|LOW, resolve_attempted, reason}; signal_deferred {signal_id, urgency, deferred_count, meta_shift_ratio}"
param_schema: "_updated_at ISO-8601 · _reason why · params object (typed schema per system)"
psi_payload: "ts · source_id · target_id · channel='ψ' · scope local|shared|restricted = min(offer, trust_level) · payload"

algedonic_gate: [
  "precondition: local_resolution_failed ∧ Δt > timeout_L",
  "decay: algedonic_decay(L,t) ≤ exp(−λ·t) enforced by hysteresis",
  "rate_limit: ≤ 2 per second per emitter",
  "without gate: cascading algedonic from deep recursion collapses stasis_cos",
]

recursion_topology: [
  "intra-binary (same Rust process): tokio tasks, in-memory mpsc/broadcast",
  "intra-host (LXC↔LXC): NATS subjects / filesystem bind-mounts",
  "inter-host (n01↔n02): NATS over network",
  "inter-VSF (different owners): NATS gateways/leaf, ψ-gated",
  "level addressing: system_id stable ▪ level frame-local
   tree depth ← system_id ancestry, ¬a level field",
]

carrier_selection — "kernel first" (start closest to kernel; NATS only crossing a boundary): [
  "φ↑ intra-binary: tokio::mpsc + events.jsonl (NEVER NATS)",
  "φ↑ same-LXC: UDS + events.jsonl (NEVER NATS)",
  "φ↑ same-host: UDS or NATS JetStream if multi-subscriber",
  "φ↑ inter-host: NATS JetStream + events.jsonl rsync",
  "φ↓ any: params.json file (file IS canon)",
  "ψ inter-VSF: NATS gateway/leaf + handshake",
  "S3*: direct read events.jsonl + honeypot logs",
  "φ_algedonic intra-binary: tokio::broadcast (instant, no IO)",
  "φ_algedonic inter-process/container: NATS Core (NO JetStream)",
  "rationale: ∀ step from the kernel adds latency ▪ failure modes ▪ resource cost
   (~30MB + goroutines/conn) ▪ cognitive load.
   mpsc ~1µs ▪ UDS ~10µs ▪ NATS local ~500µs ▪ NATS network 1-10ms",
]

nats_core_vs_jetstream: "Core ≡ in-memory pub/sub, sub-ms, ∄ persistence → α
  JetStream ≡ persistent ack/replication/retention → telemetry ∧ semantic
  mixing them on ONE stream destroys the α guarantees
  [✓ Gate 1 P99 488µs ▪ Gate 4 fsync 361ms]"
tmpfs_staging: "append → tmpfs (3µs) → async flush 100ms → disk
  → NATS in parallel ⟸ cross-boundary only.
  crash window ≤ 100ms of telemetry, replayable.
  [✓ Gate A2: 2-3µs tmpfs vs 361ms ext4 — 5400rpm HDD is a hardware-bound
   floor, ¬a bug]"

nats_subjects: "vsf.{vsf_id}.{system_id}.{channel}.{detail}"
nats_channels: ["up (φ↑ telemetry/events/anomalies)", "down (φ↓ notify; file canonical)", "algedonic (BINARY)", "s3_monitor (live view)", "audit (S3* post-hoc)", "meta (S5 policy)", "psi", "s2 (coordination)", "recurse (inner V′)"]

invariants_runtime: [
  "VAR-1: ΔV_in ≤ ΔV_out per regulating step — variety absorbed ≥ emitted (Ashby applied; measured per regulator)",
  "TRUST-1: trust_chain(path) = Π trust_i — composes multiplicatively along φ↑/ψ paths; one weak link reduces whole",
  "ALG-1: algedonic_decay(L,t) ≤ exp(−λ·t) — enforced by algedonic_gate",
]
trust_dynamics: "trust ∈ [0,1] ▪ τ_L ≈ 0.5 startup, 0.8 governed
  A0_violation ⟹ trust := 0 PERMANENT (D11b)
  deferred → degrade ▪ escalated → slight elevate ▪ witness → bounded boost"

operational_patterns: [
  "boot: read params (defaults ok) → init state_vector ∈ Ω → emit system_start
   → spawn S4 (300s) ∧ telemetry (60s) workers → NATS capability → steady tick",
  "tick: read_metrics → kernel_tick → S4 due? → analyze → s4-decision
   → telemetry due? → state_vector publish + tmpfs append",
  "α: invariant_violated(stasis_cos<0.90 ∨ temp_c>70 ∨ trust<τ_L)
   → NATS Core + signal_escalated ▪ CRITICAL → S5 direct",
  "ψ handshake: A announces → B validates trust ∧ credentials → B.S5 ack
   → A.S5 confirm → exchange scoped_payload, scope = min(offer, trust)",
  "reframe: cumulative_deferred > τ ∨ depth exceeded → pause
   → human approval (A5) → update covenant_hash ∧ params ∨ halt with reason",
  "halt: violated ∈ {A0, integrity, trust=0} → kernel_halt → α last gasp
   → stop workers → persist final state",
]

performance_verified: [
  "φ_algedonic NATS Core: P99 488µs, 3142 req/s, loss zero",
  "φ↑ JetStream+tmpfs: <1ms publish, 100ms flush, 10Hz tested",
  "φ↑ semantic JetStream: 5-50ms, 0.1Hz, loss zero",
  "events.jsonl fsync: tmpfs 3µs mean / ext4 HDD 361ms mean",
]

decisions_closed: [
  "D1: NATS prefix vsf.{vsf_id}.> from day 1 (multi-VSF ready)",
  "D2: first ψ only after first system consolidated + replicated to second hardware",
  "D3: γ (production Motor 1, feature flag) + β (collapsed PoC on LXC 107) PARALLEL from day 1",
  "D4: ∄ SSD migration — viability ⊥ hardware capacity;
   costly ⟹ find a more direct alternative, closer to the kernel",
  "D5: collapsed binary final — hold open (resource-constrained)",
]
kernel_first_principle: "costly(solution) ⟹ seek one more direct, closer to the
  kernel. priority ≻ architectural sophistication.
  ∀ carrier MUST justify its cost; default = kernel-closest"

// ═══════════════════════════════════════════════════════════════════════════════
// 5. PER-SYSTEM REQUIREMENTS METHOD — the 5-section template
// ═══════════════════════════════════════════════════════════════════════════════

// origin: per_system_requirements_method.md — central artifact for per-VSM LLM agents
// each system spec MUST have §1-§5; omission = underspecified

method_sections: [
  "§1 IDENTITY: system_id (stable, ¬level-indexed) ▪ vsm_role ▪ parent_in_tree
   ▪ recursion_level_within ▪ purpose: what / why / what fails if absent",
  "§2 INTERFACE: ∀ channel { direction ▪ role writer|reader ▪ carrier
   ▪ schema_ref ▪ nats_subject ▪ frequency ▪ payload_size ▪ loss_tolerance }",
  "§3 DECISIONS: single_loop (automatable — input/output/latency/example)
   vs double_loop (A5 human — trigger/escalation_path/example)",
  "§4 CONSTRAINTS: inherited (A0, A0.1, A4, A5, D6…) + system_specific
   { constraint_id ▪ statement ▪ enforcement runtime|policy|refusal }",
  "§5 INVARIANTS: { invariant_id ▪ formal statement ▪ measurement
   ▪ threshold pass/fail ▪ violation_action α|halt|reframe }",
]

worked_example_S4 — vsf-nucleus.s4: {
  purpose: "cognitive layer — scans E (telemetry S1+S3) ▪ models future states
    ▪ proposes interventions (scaling, alerts, escalation).
    the ONLY subsystem consulting an external LLM (D6: LLM at L≥2).
    ∄ S4 ⟹ ∄ anticipation, only reaction. closes the adaptation loop with S3",
  channels: [
    "φ↑ reader: events.jsonl + hot cache ▪ ~10Hz peak ▪ 1-50KB ▪ bounded-100ms",
    "φ↑ writer: events.jsonl + JetStream ▪ s4-analysis ▪ 0.0033 Hz ▪ 5-50KB ▪ ∄ loss",
    "algedonic writer: NATS Core; rare; <1KB; loss zero (P99<1.2ms)",
  ],
  decisions: [
    "single scale_recommendation: state_vector ∈ ℝ¹²⁸ + events
     → s4-analysis {action, decision_type, reason, target} ▪ 60s budget",
    "single alert_classification: anomaly → severity+escalation flag; 5s budget",
    "double reframe_request: cumulative_deferred > τ ∨ meta_shift_ratio high
     ⟹ pause + human approval via S5 (A5); halts S4 cycles until answered",
  ],
  constraints: [
    "S4_C1 LLM timeout: MUST complete ≤ 120s ∨ abort the cycle + signal_deferred",
    "S4_C2 structured output: ∀ s4-analysis MUST parse as schema-matching JSON",
    "S4_C3 ∄ direct S1 commands: ↛ write S1 params; φ↓ writes ⊆ S3 (code-level)",
  ],
  invariants: [
    "S4_I1 cycle cadence ∈ [280, 320]s ▪ violation > 600s ⟹ α",
    "S4_I2 decision validity: |decisions| ≥ 1 ▪ violation ⟹ signal_escalated",
    "S4_I3 LLM trust: trust(model_hash) ≥ τ_min — a POLICY parameter from
     s5_policy.json, ¬hardcoded (default 0.8 if S5 is silent).
     violation ⟹ halt S4, refuse to publish.
     rationale: trust thresholds are POLICY (D11/D11b), ¬invariants",
  ],
}

agent_derivation: "agent(V.S_X) = f( identity→persona ▪ interface→tools
  ▪ decisions→action space ▪ constraints→refusals ▪ invariants→checks )
  ⟹ the role is STRUCTURALLY constrained, ¬merely prompted"
agent_prompt_template: "You are the {vsm_role} agent for {system_id} in
  {parent_in_tree}.  PURPOSE {§1} ▪ READ {§2 reader} ▪ WRITE {§2 writer}
  ▪ DECISIONS: single-loop execute, double-loop REFUSE alone
  ▪ CANNOT {§4} ▪ MUST MAINTAIN {§5}
  ▪ uncertain ∨ invariant violated ⟹ emit signal_deferred/escalated, ¬proceed"

verification_6 — declarative is not enough (Qwen ronda 3): {
  probe: "∀ invariant: location(code) ▪ frequency ▪ overhead budget (%CPU)
         ▪ emission (events.jsonl invariant_check)",
  drift_detection: "rolling_window_stat (N=100; mean/p95/p99;
         |stat − baseline| > k·std ⟹ drift_alert)
       ▪ circuit_breaker (M consecutive failures ⟹ signal_escalated, pause)",
  replay_validation: "reconstruct expected state from an events.jsonl window,
       compare to actual. divergence > tolerance ⟹ replay_divergence event
       ⟹ proves the ledger is canonical",
  llm_drift: "prompt_hash_stability — hash at deploy, re-hash each load,
         mismatch ⟹ halt + α
       ▪ output_schema_validity — >1% parse-fail in 1h ⟹ drift_alert
       ▪ covenant_compatibility — sample 1%, A0 check, ∀ violation ⟹
         trust := 0 (D11b) + halt",
  why: "LLMs are stateless ∧ stochastic ⟹ ONLY runtime enforcement guarantees
       invariant compliance. a captured ∨ drifted LLM produces PLAUSIBLE output
       that violates invariants subtly ⟹ §6 makes it detectable ∧ stoppable",
}

completion_checklist: [
  "§1 stable system_id + explicit parent ▪ §2 ∀ channel + schema linked
   ▪ §3 single/double boundary drawn",
  "§4 inherited + system-specific ▪ §5 ≥3 measurable invariants with actions
   ▪ §6 probe + drift for each",
  "LLM agent section ⟸ D6 permits (S3, S3*, S4, S5)
   ▪ confidence markers ✓ ◐ ◯ ? ▪ cross-links to IFA + peers",
]

// ═══════════════════════════════════════════════════════════════════════════════
// 6. ATTESTED STATE — AX-STATE-01 primitive
// ═══════════════════════════════════════════════════════════════════════════════

primitive("attested_state") = {          // ≡ Ax_AttestedState (source name)
  id:     "AX-STATE-01",
  status: "CONVERGED 2026-06-04 (Claude@S3 ↔ Qwen@S4) — PROD-A1a LIVE on n02 host since 2026-06-07; audits integrated 2026-06-08 (91fe6cf)",
  one_line: "∀ load-bearing mutable state ⟹ tamper-EVIDENT ∧ attestable,
  via ONE record type + ONE verifier, reusing Merkle chain ▪ Ed25519/A4
  ▪ S3* reconcile ▪ α",

  converged: [
    "storage: snapshot-mode per TABLE — deploys/audits 5min ▪ coupling_registry/
     nftables 15min. config ∧ covenant change-signed (Ax_SignedUpdateOnly).
     events.jsonl ∧ audit.jsonl reuse the chain + a signed head.
     → /var/lib/vsf/attestations/{surface}.jsonl ∧ NATS vsf.{id}.attest.{surface}",
    "keys CORRECTION C1: on-host keys protect AT-REST only (NOT live-root) ⟹ component-key REVOCATION mandatory tier_α; only OFFLINE S5 root safe from live-root",
    "serialize C2 (defect): MUST be INJECTIVE — length-prefix + type-tag ∀ field.
     raw concatenation COLLIDES: ('ab','c') vs ('a','bc') ⟹ hidden tamper.
     exclude volatile: auto-id ▪ refreshed_at ▪ pid",
    "anti_rollback CORRECTION C3: PRIMARY = verifier tracks MONOTONIC head seen (older head ⟹ rollback) + signature; off-host NATS anchor (JetStream, ordered) survives host compromise — DEPENDS ON H2 (authenticated NATS)",
    "halt_policy C5 (safety): ∀ state.db failure ⟹ DEGRADE (α), NEVER halt —
     a mis-rotated key MUST ¬self-DoS the nucleus.
     HALT reserved for covenant ∨ covenant_ops tamper (G_halt_screams)",
    "separation (Ax_AttestationSeparation): attestation ≡ LOGICAL state (what the
     system BELIEVES) ▪ topology_reconcile ≡ PHYSICAL state (what it OBSERVES).
     BOTH run; disagreement ⟹ high-severity signal",
    "sequencing CORRECTION C4: logical gates, NO time estimates — IF injection suite passes THEN wire state_attest → IF zero false alarms THEN integrate reconcile → THEN generalize",
  ],

  two_kinds: {
    append_only: "event streams — naturally hash-CHAIN (prev_hash);
     tamper(any past entry) ⟹ chain breaks. events.jsonl ALREADY does it ⟹ reuse",
    mutable:     "kv ∧ relational ∧ config — mutated IN PLACE legitimately ⟹ the
     distinction that matters is LEGITIMATE (authorized, S5-signed) vs TAMPER",
  },
  unification: "BOTH reduce to an append-only SIGNED change-log + a materialized
    view (live DB ∨ config) with  live = fold(signed log).
    tamper ⟺ live ≠ fold(log) ∨ unsigned change ∨ chain broken.
    live state ≡ CACHE ▪ signed log ≡ TRUTH.
    ⟹ event-sourcing with a signed WAL, SAME primitive on ∀ surface",

  record: {
    surface:     "state.db | config:covenant.vsm | config:s5_policy.json | nftables | ops:audit.jsonl | …",
    commitment:  "sha256(canonical_serialize(current_state_of_surface))",
    prev_attest: "hash of previous attestation FOR THIS SURFACE (per-surface chain)",
    mode:        "snapshot (periodic) | change (each authorized mutation)",
    authz:       "S5 signature over change for Ax_SignedUpdateOnly surfaces; null for snapshot-mode",
    ts_nonce:    "freshness + anti-replay",
    signer:      "component_key_id",
    sig:         "Ed25519(component_key, all-fields-above)",
  },

  verify_steps: [
    "1. recompute commitment' = sha256(canonical_serialize(LIVE state))",
    "2. commitment' == attestation.commitment?                  [tamper?]",
    "3. attestation.sig vs component_key; component_key S5-CERTIFIED [forgery?]",
    "4. per-surface chain unbroken back to known anchor          [history rewrite?]",
    "5. now − attestation.ts ≤ cadence + grace                    [stale/halted attester?]",
    "6. change-mode: every diff since last attestation has S5 authz [unsigned change?]",
    "ANY failure → algedonic; config/covenant → halt-but-SCREAM-first (G_halt_screams); else algedonic(degrade) — auditor's own failure must not halt the system",
  ],

  canonical_serialize: {
    requirement: "STABLE under non-semantic variation ∧ SENSITIVE to semantic
      change — same discipline as the events.jsonl anti-ryu float drift",
    per_surface: "SQLite → sorted rows+cols, normalized numbers, EXCLUDE auto-increment ids/refreshed_at/pid; nftables → `nft list ruleset` with handles/counters STRIPPED; config → raw bytes",
    failure_modes: "too sensitive → false alarm → alarm IGNORED (noisy certifier is dead — orphan-detector lesson); too lax → real change slips through",
    validation: "BY INJECTION: bump a counter → MUST NOT alarm; change a service row → MUST alarm",
  },

  keys: {
    root:      "S5/covenant/rmw3 Ed25519 — OFFLINE (EVC M2), never on an LXC; certifies component keys",
    component: "per-component signing key. AT REST: kernel keyring ∨ age/sops —
      NEVER plaintext env vars. unlocked at deploy from the offline root.
      ¬Vault: heavy SPOF ⟹ viability anti-pattern",
    chain:     "S5(offline) ⊢ component_key ⊢ attestation — SAME CA as DSN-EVC-01, one CA not two",
  },

  modes: {
    change_signed: "covenant ∧ s5_policy — immediate; ∀ change carries S5 authz.
      tamper ≡ the unsigned diff ⟹ halt-scream",
    snapshot:      "state.db (no-physical-counterpart tables) ∧ nftables —
      periodic signed commitment. tamper caught at the next snapshot ∨
      immediately by the reality cross-check",
    reuse_existing: "events.jsonl/audit.jsonl — already the chain; add periodic SIGNED head",
  },

  narrow_H1: "state.db rows WITH a physical counterpart are ALREADY
  tamper-evidenced by topology_reconcile — delete ⟹ ORPHAN, fake ⟹ MISSING.
  attestation is NEEDED only for no-counterpart tables ⟹ ¬rebuild a full
  per-row HMAC (wasted scope)",

  meta: "the verifier (reconcile) is ITSELF a DECLARED component (coupling
    manifest) ⟹ liveness in the census. dies ⟹ ORPHAN/MISSING ⟹ α.
    its own attestation roots in the offline S5 key, verified out-of-band.
    recursion bottoms at human ∧ offline root ⟹ quis custodiet resolved.
    ∀ hardening mechanism MUST be a declared component, else silent orphan",

  first_step: "state.db attestation (H1, snapshot-mode): state_attest — periodic canonical commitment over deploys/audits/coupling_registry → component-signed → chain → reconcile verifies (steps 1-5); validate BY INJECTION",

  open_for_qwen: [
    "signed-change-log for ALL mutable surfaces, or snapshot-mode acceptable for state.db long-term?",
    "component-key custody: kernel keyring vs age/sops vs deploy flow",
    "SQLite canonical_serialize: deterministic dump tool vs app-level serializer (robust under version drift)",
    "per-surface cadence/grace for freshness — tie to criticality",
  ],

  prod_a1a_status: {
    live: "n02 host `vsf-state-attest`, systemd timer 5min. per pass:
      1. VERIFY prior signed head vs LIVE ⟹ α on finding (DEGRADE, ¬halt — C5)
      2. write a fresh Ed25519 snapshot, advancing the monotonic seen-head",
    dogfood: "sandbox 108 accepted 9/9 — ALARMS on real tamper (deploys.result
      edit ▪ coupling_registry.status edit ▪ chain rollback);
      SILENT on volatile bump (refreshed_at) ∧ bootstrap",
    surfaces: "deploys + coupling_registry ONLY (rarely-mutated, no-physical-counterpart → low-noise); every LEGITIMATE change fires ONE ATTEST_TAMPER before re-baselining — acceptable (operator-driven, rare, SHOULD be recorded)",
    audits: "INTEGRATED 2026-06-08 — chain_commitment ('<n>:<head>', rowid order)
      + mode-aware state_verify: immutable PREFIX, the surface only GROWS.
      TAMPER ≡ past-row edit ∨ deletion ∨ reorder, ¬append.
      3/3 surfaces ✓ clean. only C1 (offline-S5 custody) remains for arc-A",
  },
}

