// instance/instance.vsm — bindings registry (DRAFT; ratified w/ system/)
// * = project root CONSTANT (~/vsf/ here); @var→path lives ONLY here
// Per R_ref_resolution: explicit paths in system bodies ⟹ ⊥

instance("VSF-INSTANCE-v1") {

  root: {
    symbol:      "*",
    value:       "~/vsf/",
    role:        "project root — constant, ¬resolved by this doc",
    spec_root:   "system/",          // universal doc tree (publication-safe)
    // THREE roots, and a binding must say which it uses:
    //   *          this repository        — tooling, sources, governance
    //   spec_root  the published spec     — intra-system refs, layout-free
    //   node:      an absolute node path  — live substrate, ¬portable
    // Found 2026-08-08: intra-system refs were bound through *, which puts
    // docs/spec_revision/system/… inside a tree whose whole purpose is to
    // ¬carry this repository's layout.
    instance_dir:"instance/",        // this config
    agent_dir:   "repo root",        // TASKS/ROADMAP/HANDOFF/BRIEFING/RULES
  },

  bindings: {
    // external tooling (outside system/) — @var, never inline
    envelope_validator: "*/scripts/vsl/envelope.py",
    vsl_parser:         "*/scripts/vsl_parser.py",

    // certification gates (§7b conformance in boot/vsl_language)
    gate_closure:       "*/scripts/vsl/verify_primer_closure.py",
    gate_encoding:      "*/scripts/vsl/verify_encoding.py",
    gate_staleness:     "*/scripts/vsl/verify_boot_primer.py",
    gate_covenant_hash: "*/scripts/state/verify_covenant_hash.py",
    gate_symbols:       "*/scripts/vsl/symbol_table.py",
    dir_tda:            "*/scripts/tda/",
    dir_vsl_scripts:    "*/scripts/vsl/",   // the conformance attenuator
    dir_view_host:      "*/opsroom/view_host/",
    dir_instance_templates: "*/docs/spec_revision/system/instance/templates/",
    dir_s1_template: "*/docs/spec_revision/system/s1-operations/s1-template/",

    // ── R_param_resolution (rmw3 S5, 2026-08-09) ─────────────────────────
    // rmw3's discriminator (verbatim, trans. from ES): "every value that is
    // invariant, agnostic of the substrate, is canon... every one that is an
    // artifact of the instance goes to the instance."
    //
    // CORRECTION, same day, an hour after ratifying my own weaker version.
    // I first bound BASIN_FLOOR and D_KY HERE, arguing BASIN_FLOOR was
    // calibration because it "already carries a _SANDBOX variant". Reading
    // that variant: BASIN_FLOOR_SANDBOX=50 was a cpu.weight PROXY —
    // scaffolding that the real `stasis_cos ≥ BASIN_FLOOR` filter replaced.
    // ¬a per-instance variant of the same quantity. My proof was a misread.
    //
    // Under rmw3's test both are CANON: they are properties of f₀'s
    // state-space geometry, identical on any substrate. Being empirically
    // MEASURED, and revisable by better measurement, does not make a value
    // substrate-dependent — a physical constant refined by a better
    // instrument is still a constant.
    //
    // So THIS registry holds substrate ARTIFACTS only: paths, endpoints,
    // LXC ids, thermal ceilings, cpu weights, poll intervals — values that
    // exist because of THIS box and would differ on another.
    // Canon constants are declared ONCE in the canon or the kernel and CITED
    // by name; spec_kernel_reconcile already gates that bijection.

    // CROSS-REFERENCES BETWEEN system/ DOCUMENTS had ∄ binding convention:
    // src_* names SOURCES outside system/, dir_* names directories, and a
    // sibling spec had neither. s5_policy_annex wrote a bare `@ref
    // comms_protocol #outbound_response_flow` — wrong document name AND a
    // section that does not exist (it is `outbound_flow`). Both survived the
    // fuse because ∄ gate resolved refs. Found 2026-08-09 when the grammar
    // gate was made able to fail.
    doc_s5_comms:       "*/docs/spec_revision/system/s5-policy/s5-comms-01/s5_comms_protocol.vsm",
    // doc_comm_protocol REMOVED 2026-08-10: declared alongside doc_s5_comms
    // when the cross-reference convention was created, and never used. An
    // unused binding is a promise the corpus does not keep — --paths reports it
    // as orphan. Declare a binding when a document cites it, ¬in advance.
    src_scaffolding_register: "*/docs/internal/kernel_scaffolding_register.vsm",
    src_debt_closure_plan:    "*/docs/plan/DEBT_CLOSURE_PLAN.vsm",   // HISTORICAL 2026-07-31

