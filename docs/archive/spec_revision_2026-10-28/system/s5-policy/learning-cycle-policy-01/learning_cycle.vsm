⟦ learning_cycle | LEARNING-CYCLE-POLICY-01 | vsm-1.2.1 | 2026-08-17T00:16:46Z ⟧

@vsm 1.2.1
@status active
// system/s5-policy/learning-cycle-policy-01/learning_cycle.vsm — LEARNING CYCLE POLICY (S5).
// The policy is PRINCIPLES (mirror of s5_policy_core: the policy is not the
// plan nor the spec — it governs both). The plan lives in TASKS.vsm; the
// technical reference set (classifier, record format, checks) lives under
// system/s5-policy/learning_cycle/ (mirror of vsl-language/), NOT in
// sandbox (ephemeral rail per dir_schema).
//
// Parent: 20260815_learning_cycle_vsm11_proposal (IR, learning_records/)
//   UUID: c349cd35-8e5f-4537-822d-cdd3aa4f7086
//   (this doc is a child of that proposal — forward-only filiation, D4)
// The full proposal with ratified decisions D1-D5:
//   docs/learning_records/learning-cycle-proposal/20260815_learning_cycle_vsm11_proposal.vsm

principle: "
  a hole not recorded is a hole re-found           // detect → persist, no memory
  a proposal not persisted is a decision unmade    // survives crash/session/close
  a fix without a parent is an orphan organ        // every product declares its lineage
  a policy without enforcement is a declaration     // policy-and-praxis: verifier + gates
  the cycle applies to itself                       // recursion: learning audits its own records"

// ─── 1. THE LOOP ─────────────────────────────────────────────────────────────
// The cycle: detect (hole) → classify (family/organ/recursion) → persist (IR
// with UUID) → fix (guard/hook, with parent-UUID of the IR) → verify (fixtures
// pass/fail) → trace (parent→child). Each stage is an organ with its owner:
// S3 control detects and closes structural holes deterministically in the
// detection (one occurrence suffices); S4 intelligence records novel patterns
// and aggregates statistically (N in window → decide investment in new
// structure); S3* audits by sampling (noise: observe, do not spend variety);
// S5 ratifies the policy and decides the boundary gates.

loop: {
  detect:    owner=S3,   trigger="check/gate/audit finding",
             response="structural: fix in detection; novel: register"
  classify:  owner=S3*,  fields=[family(novel|existing_gap|debt_resurfaced),
             class(structural|design|noise), organ, recursion, canonical]
  persist:   owner=S3,   artifact="IR in learning_records/ with UUID + parent",
             gate="pre-commit dir-schema blocks it if not declared"
  fix:       owner=S3,   gate="fixtures pass/fail mandatory (checks/); cross-organ → rmw3"
  verify:    owner=S3*,  gate="the fix must discriminate (pass AND fail), not just pass"
  trace:     owner=S4,   gate="parent-UUID declared by every derived product",
             stats="learning_stats.py POPULATES (aggregates IRs into the
             window) and READS under condition (--check: novel >= N in W
             days → TRIGGER decision on investment);
             runs on session.idle (plugin) and pre-commit (guard G)"
}

// ─── 2. RATIFIED DECISIONS (D1-D5, rmw3 2026-08-15) ──────────────────────────
// Recorded in the parent IR (learning_records/, section decisions_pending
// → RESOLVED). This policy DECLARES them, does not re-derive them (R5: canon
// over recall — the IR is the source; here they stand as binding commitment).

decisions: {
  D1: "UUID as a BODY field (uuid:), not a 5th header field —
       avoids breaking EXACTLY-4-fields (rubric + encoding gate)."
  D2: "Timestamp in UTC SECONDS in document headers; microseconds
       only in event/algedonic records."
  D3: "The policy and its reference set live under system/s5-policy/
       (mirror of vsl-language/ — permanent, canonical). The records
       generated by the cycle live in docs/learning_records/
       (category declared in dir_schema.spec.vsm). docs/incidents/ stays
       ONLY for operational incidents."
  D4: "FORWARD-ONLY filiation: legacy docs are marked
       provenance: legacy; NO retroactive census (archaeology)."
  D5: "Migration (when it exists) PROGRAMMATIC, tested first in sandbox/
       (prototype → validation → promotion). The migrator script is a
       derived artifact with parent-UUID = IR."
}

// ─── 3. VSM 1.1 EXTENSIONS (declared here as policy; implemented in
//        vsl_language_primer when the promotion is ratified) ────────────────
// The traceability policy that VSM 1.1 materializes in grammar:

vsm11: {
  timestamp: "date ::= YYYY-MM-DD | YYYY-MM-DDThh:mm[:ss][.fff]Z (UTC).
       Precision: seconds in docs; microseconds in events (D2)."
  uuid:      "every spec and every learning_records/ record carries uuid:
       (body field) — a machine handle for traceability; the semantic ID
       of the header (2nd field) remains for human reading (D1)."
  parent:    "every spec/script/record produced by another declares
       provenance { parent: [uuid...] } — forward-only filiation (D4).
       This doc is a child of c349cd35-8e5f-4537-822d-cdd3aa4f7086."
}

// ─── 4. ENFORCEMENT — the S5-local of this policy ───────────────────────────
// Not a declaration (policy-and-praxis): the policy has its verifier, its
// gates and its manifest, mirror of the root adapted to this tree.

enforcement: {
  pre_commit: "dir-schema-valid (learning_records category declared) —
       a .vsm in learning_records/ without declared category/ID BLOCKS"
  structure:  "TASKS-VSM-STRUCTURE-GUARD (P3): tokenizer --check on root
       .vsm when staged — the first concrete fix the cycle generates
       (brace incident, 2026-08-15)"
  auto_trigger: "LEARNING-CYCLE-AUTO-TRIGGER-2026-08-16 (recursivity —
       the instrument that forces the cycle is itself a hook of the cycle):
       .opencode/plugins/learning-cycle-scan.ts listens to session.idle and
       executes scripts/state/session_learning_scan.sh; the same scan is
       guard (F) del pre-commit. Un draft en learning_records/.pending/
       (aprendizaje detectado sin IR) BLOCKS session-close y commit."
  s4_stats:   "S4-STATS-INSTRUMENT-2026-08-16: scripts/state/learning_stats.py
       POPULATES the window (aggregates IRs by family/class/organ/status/date;
       every commit and session.idle runs it) and READS under condition
       (--check: novel >= N in W days → TRIGGER — S4/S5 decides on structure
       investment). Guard (G) in pre-commit + part of the plugin. Deterministic
       (R10): aggregates and reports, does NOT decide. Thresholds N=3/W=30
       (env LEARNING_MIN_N/LEARNING_WINDOW_DAYS)."
  version:    "checks/vsm-version-coherent (to create with the 1.1 promotion):
       every .vsm under spec_revision declares the SAME version and @vsm == header"
  self:       "checks/learning-record-valid (IMPLEMENTED 2026-08-15) — the
       cycle audits its own records: validates the standard (section 6) and
       ATTENDS the incomplete ones. A malformed or incomplete learning_record
       without deferral is a second-order incident the hook catches.
       Behavior (S5 nuance rmw3 2026-08-15): BLOCKS + REPORTS + generates
       the incident doc — but does NOT demand immediate resolution; if the
       situation is complex and the primary objective must continue, it is
       marked trace.deferral.deferred=true and the record is revisited later
       (documented deferral, not silent — R9)."
}

// ─── 6. LEARNING_RECORD STANDARD — the unified schema ───────────────────────
// Every .vsm in docs/learning_records/ complies with THIS
// schema (checks/learning-record-valid enforces it). Standardized 2026-08-15
// (rmw3, translated: 'the format between the two registered documents is
// inconsistent, with different shapes, it should be more standardized and
// apply compression'). REVISED 2026-08-19 (LEARNING-RECORD-FORMAT-v2): the
// unified canonical form is the learning_record() block + vsm-1.2 header +
// the full field set (severity, detection, root_cause, lesson, propagation
// added; thesis absorbed into lesson) — the 5 IRs already in that shape
// became the reference, the 13 legacy record()+vsm-1.0 were migrated.
// The enforcement status flag is @status(V) (V-lifecycle vocabulary
// already declared in vsl_language_primer — option A, decided 2026-08-15):
//   design (declared only) → planned → onboarding → iterating → testing
//   → production (implemented+validated) | deprecated (discarded)
// Compression applies the FORMA standard (compression_ledger): minimal prose,
// maximum structural density — the fields ARE the document.

learning_record_standard: {
  header:   "⟦ AAAAMMDD_name | LEARNING-RECORD | vsm-1.2.1 | timestamp ⟧ + footer —
            name with COMPACT date prefix (AAAAMMDD_) for chronological order
            by ls; generic TYPE (LEARNING-RECORD | LEARNING-CYCLE-PROPOSAL) —
            uniqueness comes from name+date and the body uuid (D1). timestamp
            ISO 8601 UTC (T..Z, seconds) — the precision form for events (D2,
            vsl_language_primer: 'date-only stays valid; timestamp is the
            precision form for events'). LEARNING-RECORD is an event of the
            learning cycle (detect→classify→persist), so the timestamp form
            applies. REVISED 2026-08-19: the 2026-08-15 S5 decision (date-only
            'hasta VSM 1.1') was superseded when the RE_HEADER cascade landed —
            the parser (version_scan.py RE_HEADER) already accepts
            [\dT:\-.]+Z? and learning_cycle.vsm itself carries a timestamp.
            vsm-1.2 REQUIRED (the learning_record() block shape is the 1.2
            form; vsm-1.0 was the legacy record() form, RETIRED 2026-08-19)"
  status:   "@status(V) ∈ {design, planned, onboarding, iterating, testing,
            production, deprecated} — the enforcement flag"
  fields:   "uuid (body, D1) · parent (filiation, D4) · family · class ·
            severity · detection · root_cause · organ · recursion · canonical
            · evidence (R4) · lesson · action · trace · propagation"
  trace:    "detected_by · registered_by · parent_ref ·
            deferral {deferred: bool, reason, return_to} — documented
            deferral (S5 nuance): allows continuing with the primary
            objective and returning to the record later, while still reporting"
  compression: "FORMA: minimal prose, structural density. Metrics
            density_FORMA + coverage_semantic (compression_ledger) when the
            record is promoted; the standard applies from registration."
}

// ─── 5. REFERENCE SET — system/s5-policy/learning_cycle/ ────────────────────
// Mirror of vsl-language/: the cycle's permanent technical material lives
// under the policy, NOT in sandbox (ephemeral rail, dir_schema says it:
// 'nothing canonical here'). Pending writing when the plan calls for it:
//   classifier (family/class/organ/recursion/canonical)
//   record format (uuid:, provenance, timestamps)
//   checks fixtures pass/fail (learning-record-valid, vsm-version-coherent)
//   VSM 1.1 migration (D5: prototype in sandbox/ first)

reference_set: {
  location: "docs/spec_revision/system/s5-policy/learning_cycle/",
  status: "planned — the specs are born when the plan requires them",
  gate: "every spec of this set declares parent: c349cd35-8e5f-4537-822d-cdd3aa4f7086
       (forward-only filiation, D4)",
}

