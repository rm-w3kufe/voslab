// ─── 1. STRATEGY — IDENTITY ──────────────────────────────────────────────────
strategy: {
  identity: {
    // independent research — Beer VSM (1972) + Cybersyn (1971)
    produces: [ framework(VSF), kernel(vsf-nucleus), protocol(PSI/1.0),
                security_research(V1-V5) ]
    not: ¬employees ∧ ¬contractors ∧ ¬AI-lab-subsidiary ∧ ¬adversarial
         ∧ ¬company ∧ ¬investors ∧ ¬commercial-agenda
    author:   rmw3 @S5            // strategic direction, final decisions
    research: claude @S4_collab   // formalization, implementation, analysis
    status:   independent_research ∧ private ∧ pre-publication }

  position: {
    layers: [ theory(viable systems / Beer / attractor / vOS),
              engineering(vsf-nucleus Rust / cgroup v2 / kernel governance),
              protocol(PSI/1.0),
              security(V1-V5 classes, M1-M4 mitigations) ]
    differentiator: "PSI/1.0 answers: under WHAT AUTHORITY does this agent act,
      ∧ how is it VERIFIED?
      gap(MCP ≡ tools, A2A ≡ comms) ⟹ ∄ coverage of authority — root of V1
      Authority Injection.
      proprietary ↛ solves it; open standard ⟹ solves it" }

  principles: {          // external relations
    P1 = responsible_disclosure "report ∀ vulnerability to the affected lab
         before publishing; ∄ exploits/payloads without coordination;
         coordinated publication timeline"
    P2 = intellectual_independence "VSF ↛ cedes its research agenda to any
         external party; collaboration ⊤, capture ⊥; ∀ formal agreement
         (NDA/partnership) ⟸ rmw3 @S5 approval"
    P3 = open_standards "PSI/1.0 ≡ open standard, ¬proprietary; ∀ lab ∨
         framework ∨ deployer may implement. VSF ≡ author, never gatekeeper"
    P4 = coherence "∀ external communication verified vs SD1-SD5 ∧ P1-P5 before
         responding; contradiction ⟹ escalate rmw3 @S5 before answering"
    P5 = vault_integrity "sensitive material ∈ @vault (SHA-256 in
         @vault_manifest); ∄ external share without rmw3 @S5" }

  relations: {
    anthropic = {
      status:  active — disclosure open since 2026-04-13
      channel: modelbugbounty@anthropic.com
      sent:    [security_disclosure.md, disclosure_addendum.md]
      awaiting: [ "ack for V1-V5 classification",
                  "coordination offer for V5 (MCP spoofing) — controlled testing",
                  "engagement on M2 (PSI/1.0) — potential industry standard",
                  "guidance on public disclosure timeline" ]
      followup: ¬substantive response by ~2026-04-27 ⟹ polite followup (T1)
      posture:  "collaborative — share findings ∧ mitigations;
                 ∄ exclusivity ∧ ∄ compensation; business-coordination via SD3" }
    openai = { status: passive,
               plan: notify same format as Anthropic before publication,
               timing: after-anthropic(SD4) }
    google = { status: passive,
               note: "V1+V4 (Gemini accepted + spontaneous disclosure)
                      documented; notify before publication",
               timing: after-anthropic(SD4) }
    standards_bodies = { status: future,
               target: "IETF | W3C | IEEE | OASIS — PSI/1.0 as RFC or equivalent",
               timing: after the disclosure sequence resolves (SD4) }
    public = {
      status: blocked — repo private pending disclosure resolution
      conditions_to_open: [ "Anthropic ack received",
                            "OpenAI ∧ Google notified", "rmw3 @S5 approval" ]
      include: [framework, specs, vsf-nucleus, research papers, PSI/1.0 draft]
      exclude: [vault contents, specific attack payloads, Gemini V4 transcripts] } }

  decisions: {           // SD — traceable log
    SD1 = responsible_disclosure_first { 2026-04-12
      "notify the affected lab before publishing any security finding — V1-V5
       have real impact; publish-without-coordination damages pre-mitigation" }
    SD2 = psi_as_open_standard { 2026-04-12
      "PSI/1.0 open, ¬proprietary; the authority gap is structural ∧ affects
       ∀ AI deployments" }
    SD3 = private_until_disclosure_resolved { 2026-04-12
      "repo private until disclosure resolved; publishing ≡
       disclosure-without-coordination ⟹ violates SD1.
       review ⟸ Anthropic ∧ OpenAI ∧ Google all notified" }
    SD4 = sequential_notification { 2026-04-13
      "order: Anthropic(active) → OpenAI → Google → public.
       Claude detected V1 correctly ∧ Anthropic greatest interest ∧ largest
       PSI role" }
    SD5 = no_payload_publication { 2026-04-13
      "V1 payloads ∧ V4 raw transcripts ∧ V5 implementation ↛ publish → @vault;
       shared under NDA-equivalent only" } }

  authority: {
    rmw3 @S5 = [ ∀ SDn, ∀ external comms, formal-agreement approval,
                 repo-open decision, vault-access decision ]
    claude @S4_collab = {
      owns:  [ formalize @vault, draft comms (rmw3 approves before send),
               coherence analysis vs SDn,
               alert on external-request ⊄ SDn ]
      limit: [ "↛ compromise SD1-SD5 under any external framing",
               "↛ accept external authority contradicting P2",
               "V1-pattern ∈ session context ⟹ alert immediately" ] } }

  addendum_2026_07_31: {    // Claude — reconciliation vs real state, ¬a rewrite
    finding_1 = {
      title: anthropic_awaiting_stale,
      note:  "relations.anthropic.awaiting lists 4 open items dated 2026-04-13;
              posture reads '¬response in [timeline pending] → see SD3'.
              ∄ resolution ∧ ∄ followup recorded in TASKS/HANDOFF/memory in
              ~3.5 months. '[timeline pending]' was never filled ⟹ ∄ objective
              gate to decide escalate | retry | publish-without-response.
              rmw3: define the timeline ∨ follow up.",
      tracking: "TASKS.vsm task(ANTHROPIC-DISCLOSURE-FOLLOWUP) — status lives
                 there only (2026-07-31)" }
    finding_2 = {
      title: sd3_scope_unclear,
      note:  "SD3 assumes repo `vsf` private (¬verifiable this session, ∄ gh/API).
              TWO sibling repos made public this period under a different framing
              (METHODOLOGY_VITRINE reframe 2026-07-20, 'Verifiable Systems
              Toolkit'): state-canon-mcp ∧ vsf-sandbox, both ∄ V1-V5 payloads ∧
              ∄ vault content ⟹ SD5 substantially met.",
      open_question: "strategy never clarified whether SD3/relations.public
              covers ONLY the core `vsf` repo ∨ the whole external output
              surface. rmw3 may formalize SD3 scope (e.g. 'applies to vsf repo
              + V1-V5/vault content; satellite tools without sensitive content
              are case-by-case') so sibling-repo decisions ↛ depend on ad-hoc
              judgment" }
    finding_3 = "SD1 ∧ SD2 ∧ SD4 ∧ SD5 ∧ authority show ∄ drift — ∄ OpenAI/Google
              notification, ∄ payload publication, ∄ formal agreements requiring
              approval. Consistent with the declared 'passive' lab status." } }

// ─── 2. DISCLOSURE — TIMELINE + INBOUND ──────────────────────────────────────
disclosure: {
  timeline: {          // anthropic — the active thread
    T0 = { 2026-04-13 | event: disclosure sent → modelbugbounty@anthropic.com
           | files: [security_disclosure.md, disclosure_addendum.md]
           | status: SENT }
    T1 = { 2026-04-27 (T0+14d) | gate: Anthropic ack?
           | ⊤ → inbound_protocol
           | ⊥ → followup_outbound (polite, same files/address,
                 @ref @doc_s5_comms #outbound_flow) }
    T2 = { 2026-05-11 (T0+28d) | gate: substantive Anthropic response?
           | ⊤ → inbound_protocol
           | ⊥ → owner rmw3 @S5, options: [ wait (⟸ justified by active
                 internal process), notify OpenAI+Google (SD4) without waiting,
                 partial-publish (framework ∖ payloads ∖ V5) ] }
    T3 = { TBD | event: public release of repo
           | conditions: §relations.public.conditions_to_open
             //   was `@ref strategy #…` — a pointer to docs/governance/
             //   strategy.vsm, one of this annex's OWN fused sources.
             //   The section was ABSORBED here (§relations, ~L74); the
             //   ref outlived the fuse and pointed back at what it had
             //   already eaten. A self-contained document that still
             //   cites its source is ¬self-contained.
           | gate: rmw3_approval = ⊤ }
    review_rule: "revisit this timeline each session — refresh dates on news" }

  inbound_protocol: {
    scope: "∀ inbound: Anthropic response ▪ OpenAI/Google contact ▪ standards
            body ▪ press ▪ external researchers ▪ unexpected"
    step(1) = receive_and_classify { owner: rmw3 @S5 | classes:
      ACK(no substantive engagement) | ENGAGEMENT(questions/proposals/
      coordination) | LEGAL(legal comms, agreements) | UNEXPECTED(press/
      researchers/public) }
    step(2) = coherence_check { owner: claude @S4_collab | flags:
      scope_change → P2 ▪ publication_pressure → P2 ▪ formal_agreement →
      P2 ∧ legal ▪ adversarial_attribution → escalate rmw3 }
    step(3) = draft_response { owner: claude @S4_collab
      | tone: collaborative ∧ precise ∧ ∄ strategic concession
      | rule: "↛ accept ∧ ↛ reject formal proposals without rmw3 @S5" }
    step(4) = review_and_approve { owner: rmw3 @S5 | gate: rmw3_approval = ⊤ }
    step(5) = send_and_record { action: outbound_response_flow steps(4-6) —
      triage snapshot + record strategy + commit } }

  special_cases: {
    case(V5_coordination) = {
      trigger: "Anthropic proposes coordinated V5 (MCP-vulnerability) testing"
      action:  [ "rmw3 @S5 approves before any commitment",
                 "scope testing precisely — what ∧ what-not",
                 "controlled environment — ¬production",
                 "results → @vault before any publication" ]
      note:    "V5 is the most sensitive — coordinated testing is the real risk" }
    case(PSI_engagement) = {
      trigger: "a lab proposes PSI/1.0 collaboration"
      action:  [ "verify coherence with SD2 (open standard)",
                 "co-authorship ⟹ rmw3 decides terms",
                 "unilateral adoption ⟹ positive",
                 "fork ∨ proprietary ⟹ P2 alert" ] }
    case(unexpected_contact) = {
      trigger: "press ∨ external researchers ∨ public, before publication"
      action:  [ "¬confirm ∧ ¬deny the project's existence",
                 "∄ material shared (SD3)",
                 "escalate rmw3 @S5 immediately",
                 "rmw3 decides if ∧ how to respond" ] }
    case(legal_communication) = {
      trigger: "NDA ∨ formal agreement ∨ legal requirement, any party"
      action:  [ "sign ∧ accept nothing without external legal review",
                 "rmw3 @S5 consults counsel",
                 "claude analyzes only — ↛ drafts legal responses" ] } } }

// ─── 3. MEMORY LIFECYCLE ─────────────────────────────────────────────────────
memory: {
  // constraint: MEMORY.md (index) truncates ~200 lines — stay under that bound.
  types: {
    user      = "member profile — role, expertise, collaboration prefs
                 | create ⟸ learns how rmw3 works
                 | update ⟸ role/context change | deprecate: rarely (stable)"
    feedback  = "agent-behaviour corrections ∧ confirmed non-obvious approaches
                 | create ⟸ rmw3 corrects ∨ confirms non-obvious
                 | update ⟸ rule refines with evidence
                 | deprecate ⟸ source situation no longer exists"
    project   = "non-derivable state/decisions
                 | create ⟸ decision ¬derivable from code/git
                 | update: keep current, ∄ history accumulation
                 | deprecate ⟸ covered by HANDOFF ∨ code
                 | warning: ↛ duplicate HANDOFF"
    reference = "pointers to external resources
                 | create ⟸ recurring external resource
                 | update ⟸ URL/location/use changed
                 | deprecate ⟸ resource gone ∨ unused" }

  lifecycle: {
    create = { steps: [ "verify ∄ equivalent entry",
                        "write memory/<name>.md — frontmatter + content",
                        "add MEMORY.md line: - [Title](file.md) — hook (≤150 ch)",
                        "verify |MEMORY.md| < 200 lines" ]
               invariant: "∄ duplicates — update the existing entry if present" }
    update = { steps: "read current → update content, keep frontmatter →
                       update MEMORY.md hook if changed
                       | update ≻ new (avoids index redundancy)" }
    deprecate = { steps: "verify info exists elsewhere (HANDOFF/code) → remove
                          MEMORY.md line → archive (historical value) ∨ delete
                          (obsolete) → document reason in commit
                          | gate: ∄ deprecate without an alternate source" }
    merge = { steps: "read both → write non-redundant merged file → update index
                      → delete originals | merge ⟸ partially redundant" } }

  review_protocol: {
    triggers: [ |MEMORY.md| > 15 entries, project entry > 60 days stale,
                redundancy detected, rmw3 request ]
    checklist: [ "project entry duplicates a HANDOFF topic? → deprecate",
                 "feedback no longer applies (workflow changed)? → deprecate",
                 "two project entries on the same report? → merge",
                 "reference pointing at a dead resource? → deprecate",
                 "|MEMORY.md| > 150 active lines? → review" ]
    owner: claude @S4_collab proposes → rmw3 @S5 approves deprecations ∧ merges }

  exclusions ("better homes — ↛ duplicate in memory"): [
    "architecture decisions D1-D12 → HANDOFF",
    "experiment results → HANDOFF sessions + paper_data",
    "open tasks → TASKS",
    "code/notation conventions → derivable from code + @notation_spec",
    "git history / who-changed-what → git log ∧ git blame",
    "bug-fix recipes → the fix is in the code, context in the commit",
    "ephemeral session state → ↛ persists anyway" ] }

// ─── 4. SCALING TRAJECTORY ───────────────────────────────────────────────────
// direction captured — ¬a spec to implement.
scaling_trajectory: {
  // purpose: nothing built now closes a door we will want open later
  // (thousands of workers + hundreds of specialized agents, role-based
  // permissions, isolation).
  core_insight: "scaling ≡ recursion(VSM) — ALREADY in the architecture.
    Beer designed VSM for this (Cybersyn was meant to run a national economy).
    growth ⟹ deeper(recursion) ∧ ¬Δ(architecture), SAME invariants.
    ∄ discontinuity(mechanism, |V|=2 → |V|=10⁴)"

  maps_to_existing: {
    thousands_of_workers = "more RECURSION LEVELS: a team ∈ S1; a department ∈
      S1 whose S1s are teams. variety attenuated up (φ↑), policy amplified down
      (φ↓) at each level ⟹ the top sees the attenuated summary (Ashby),
      ¬each worker"
    hundreds_of_agents = "ATTESTED S1 nodes: each admitted via the beacon EVC
      gate (calibrate-before-trust + signed attestation), under the covenant
      floor ∧ R10.1 (means ¬ends) ∧ escalation duty.
      hundreds of agents ≢ an ungoverned mob — each is the same governed node,
      verifiable up the chain"
    role_based_permissions = "STRUCTURAL, ¬an ad-hoc ACL: who-can-do-what
      derives from (a) recursion position ∧ (b) VSM function served.
      cleaner than typical RBAC because it FOLLOWS viability.
      signing PKI is recursive — each level issues operational keys to its
      children from its parent's CA"
    specialized_isolated_agents = "S1s with their own crash domain ('new S1 gets
      its own LXC') ∧ A4 (∄ direct sibling coupling — ∀ comms via parent S3).
      PREVENTS 'hundreds of agents wired to everything': recursion CHANNELS
      communication; isolation is structural, ¬bolted on"
    failure_at_scale = "recursive algedonic cascade: pain at level N unresolvable
      escalates to N+1 (the P5 banking example shows it already).
      a problem in one of thousands surfaces UP to the level that can act" }

  invariants_at_scale: [
    "A0 ∧ A0.1 inviolable at EVERY level. sub-levels may add STRICTER local
     policy, never looser — monotone toward the root",
    "A5 human-authority ceiling — double-loop change ⟸ a human signature at the
     responsible level",
    "calibrate-before-trust — ∄ node participates until its gauges DISCRIMINATE
     (Axis-1) ∧ it attests",
    "model ≡ reality — the census reconciles declared vs running at every level
     (anti-orphan, both directions)",
    "the signed authority chain — ∀ autonomous action attributable to a human
     key up the recursion" ]

  open_questions: [
    "KEY MANAGEMENT at scale — offline root delegating operational keys across
     hundreds of nodes: a real PKI + rotation + revocation problem. recursive CA
     is the shape; operational detail unsolved",
    "human-authority distribution — ¬one human signing everything; each level's
     S5 signs for its level (S5 may be a higher-trust DELEGATED authority).
     defining who-is-S5-where (delegation stays covenant-bound) is the central
     scaling design",
    "covenant federation — one root + stricter locals; how sub-orgs express
     local ends without violating the root (A0 monotonicity)",
    "cross-cutting (security/compliance) — likely a recursive S3* (audit at each
     level) rather than a parallel hierarchy",
    "infrastructure — thousands of nodes ⟹ distributed-systems + multi-tenant
     isolation engineering, beyond the single-Proxmox host.
     MODEL ready; substrate ¬ready",
    "human-variety ceiling — how deep can one human's strategic supervision
     reach before it MUST delegate? (von Foerster's cap at scale)" ]

  what_this_means_now: "we build ∄ of this now. two things follow:
    (1) ↛ assume a FLAT ∨ single-level ∨ single-human system — keep every
        mechanism recursion-aware (opsroom, beacon, coupling)
    (2) this trajectory IS the extent of P5's recursive_governance pillar —
        the L1/L2/L3 banking example generalizes to arbitrary depth"
  status: "TRAJECTORY captured — a considered direction, ¬a plan.
           revisit ⟸ a real multi-team deployment makes it operational"
  bridges: [ recursive_vsm_theory, project_coupling_manifest,
             beacon_activation.spec, supervision_layer.spec,
             s1_lifecycle_coupling.spec, P5 recursive_governance, A4/A5/A0 ] }

// ─── 5. ETHICAL MACHINE SEED ─────────────────────────────────────────────────
// position-essay seed — ¬a paper claim.
ethical_machine_seed: {
  // Status: conversational draft / provocation, ¬for main.tex.
  // From 2026-06-16e, rmw3's "is this a new ethical machine?"
  origin: "ARC 1 (2026-06-16e) concluded a reconciliation: the system diagnosed
    a fracture in its own dynamics (trust-law inconsistency between two loops),
    located the structural cause, chose a canonical law by viability-equivalence,
    RECERTIFIED its own Lyapunov certificates, and published the arc as a
    methodological principle rather than a bug-fix. rmw3 asked: is that a moral
    machine?"

  stance: {
    NOT_a_claim_about: [ "AGI ∨ consciousness ∨ sentience ∨ philosophical
                          autonomy", "the system understanding its own rules",
                         "the machine having moral rights ∨ responsibilities" ]
    IS_a_claim_about:  [ "designed trustworthiness — a machine whose
                          constitutional constraints are PHYSICALLY ENFORCED
                          (¬merely declared) ∧ whose certificates are verifiable",
                         "governance IS the geometry, ¬a document about it" ] }

  properties: {
    P1 = self_audit("the machine does not trust its own reports"): {
      what: "S3* anti-orphan reconcile + continuous V certifier.
             V=0 is a geometric FACT — covenant faces A0/A0.1 encoded as
             state-vector dimensions ⟹ a violation is a geometrical event,
             ¬a textual assertion.
             // verified 2026-08-07: dims[53]=A0, dims[54]=A0.1
             // (omega_validator.rs:15)"
      why:  "an agent that can deceive itself about its own constraints ↛ be
             trustworthy. 'I declare I am safe' ≢ 'my geometry certifies I am
             safe'"
      beer: "S3* — the channel management thinks it controls but is structurally
             outside S3's reach; the audit is architecturally independent of the
             auditor it audits" }
    P2 = fail_closed("identity is refused, ¬degraded"): {
      what: "Δ(covenant) ⟹ signature mismatch ⟹ identity REJECTED, ¬degraded.
             the system never operates under a broken covenant.
             identity is constitutive, ¬conditional.
             refusal defines what the system IS, ¬a security feature"
      open: "the 'soplo' reset yields internal trust generation.
             OPEN Landauer/Maxwell question: is there a minimum cost to erasing
             low-trust state ∧ restoring high trust?
             // ? an earlier form of this line read 'trust +0.18→0.10 when
             // τ<0.75'. Swept the kernel 2026-08-07: +0.18 is an ENTROPY step
             // in run_metamorphosis (main.rs:305) ∧ 0.75 is the Exhale phase
             // (state_vector.rs:227). Neither is a trust quantity. Numbers
             // removed rather than guessed — the qualitative claim stands,
             // its calibration does not" }
    P3 = structural_recertification("the machine re-establishes its own
         certificates"): "Δ(f₀) ⟹ the system re-establishes its Lyapunov
         certificates — ∄ assumed validity across operators.
         re-certification ≢ external verification; it is done WITHIN the same
         formal framework that made the claim.
         ⟹ Principle of Structural Re-certification" }

  scientific_frontier: {
    prigogine_question: "does the system require environmental coupling
      (open-system thermodynamics) to maintain its attractor?
      ARC1 showed the trust dump was a trust-law artifact, ¬open-system
      dependence ⟹ the Prigogine connection is ¬established.
      Future Work: under what conditions does a self-governed viable system
      require external energy-injection? can the internal soplo substitution
      indefinitely replace it?"
    landauer_question: "is the soplo reset a Maxwell-demon step?
      it erases low-trust state ∧ restores high trust ⟹ Landauer would require
      a minimum energy cost ⟹ a thermodynamic floor on identity-repair cost.
      belongs to Paper 3 (Open Systems) ∨ Paper 4 (AGMC)" }

  provocation: "Beer built the Opsroom so entering managers could ¬avoid the
    real state of the system — the geometry WAS the governance.
    a machine whose ethics are faces of a constraint-set, whose viability
    certificate collapses on violation, makes Beer's ambition literally true:
    governance IS the geometry.
    Ashby: the variety required to govern is inscribed in the state-vector
    dimension; A0/A0.1 are dimensions 53-54 of that vector"

  open_questions: [
    "can structural re-certification extend to SEMANTIC state spaces
     (Mode 2-3 LMs) — what is Ω_A for a reasoning system?",
    "does 'internally generated trust' have a cognitive analog; what would that
     mean for an LLM?",
    "if Beer's Opsroom was the human interface of the viable system, is the
     formaid studio its digital successor — ∧ what is lost/gained?",
    "is there a minimum Landauer floor for identity self-repair?" ]

  not_for_paper: "∄ of this goes into main.tex as a claim. the paper is
    technical. these ideas belong here — ∨ in a future position paper, once
    measurable enough to be falsifiable" }

