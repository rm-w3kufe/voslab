⟦ readme | ARCHIVE-readme-v1 | vsm-1.2.1 | 2026-08-17T02:58:03Z ⟧

@vsm 1.2.1
@status active
// docs/archive/spec_revision_2026-10-28/archive/readme.vsm — ROL Y FUNCIÓN DE archive/.
// DECISIÓN S5 rmw3 2026-08-17 (ARCHIVE-POLICY): los DATED RECORDS y
// registros que no son ni política (system/) ni spec de implementación
// (design-sources) ni plan activo (plan/) viven AQUÍ, clasificados por
// clase y nivel, todo indexado.
// Este readme es la puerta del directorio: se lee antes de entrar.

system(readme) {

  synthesis: "archive/ := el DEPÓSITO de documentos que cumplieron su
              función: mediciones, ejemplos, propuestas superadas. Se
              citan por LINAGE (historia), NUNCA como autoridad (doc-sync).
              Clasificación por CLASE (subdirectorio) + nivel (rama-naturaleza),
              índice en index.vsm. Un archivo aquí está RETIRADO del canon
              vivo: su estado no rige nada.",
  // CLASES (L2 bajo archive/):
  //   measurements/  — mediciones, surveys, censos (restructure_survey)
  //   examples/      — worked examples, demos (vsm_logic_demo)
  //   superseded/    — docs superados por otro (creative_leaps → seven_ideas)

  structure: [
    dir("readme.vsm",          role="puerta",    desc="este documento — rol y política de archive/"),
    dir("index.vsm",           role="índice",    desc="el índice clasificado — TODO lo archivado, por clase+nivel (ARCHIVE-index-v1). LEER PRIMERO"),
    dir("measurements/",       role="clase",     desc="mediciones/surveys/censos — DATED RECORD"),
    dir("examples/",           role="clase",     desc="worked examples/demos — DATED RECORD"),
    dir("superseded/",         role="clase",     desc="docs superados por otro — DATED RECORD, linage del sucesor"),
  ],

  policy: "
    un documento degradado → archive/<clase>/ CON header actualizado
    (type declarado en dir_schema: ARCHIVE-* / DATED-RECORD) y UNA
    entrada en index.vsm (mismo commit — doc_sync: el índice ES el
    estado de archive/)
    un archivo NO indexado → violación (check archive-index-valid BLOCKS)
    un documento cuyo rol sigue vivo (política/spec/plan) → NO va aquí
    un DATED RECORD se cita por linage (sucesor lo referencia), ¬autoridad
    nada canónico vive aquí; si un archivo debe VOLVER al canon → se
    re-promueve por sandbox/ (rail) o decisión S5 (como cualquier doc)",
  // CICLO (rmw3 2026-08-17): promover lo que es sistema, degradar lo que
  // no, archivar lo que cumplió — sandbox/ limpio, archive/ ordenado.

  verification: "dir-schema-valid (BLOCKING) + archive-index-valid (BLOCKING — index.vsm cubre 100% de archive/)",
}
⟦ /readme ⟧