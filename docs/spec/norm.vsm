@vsm 1.0
// norm.vsm — the agreed operating region R ⊂ Ω (Cyberfilter F3.a)
// Status: ratified (2026-06-12 rmw3 S5)
// Author: rmw3 (S5) + Claude (VSF session) — 2026-06-11
// origin: cybersyn_convergence.md F3.a — Beer's "plan vs actuality" requires an
//         EXPLICIT norm. Until now thresholds lived hardcoded in ac_classifier.py;
//         this file is the single ratifiable source. The classifier reads THIS.
//
// Semantics: inside R = nominal operation (class C). Leaving R = deviation that
// the Cyberfilter surfaces (class B monitor / class A escalate). The norm is the
// standing plan: changing it is a D4-L3 double-loop act (S5 ratification each time).

norm("vsf-alpha-R1") = {
  version  = "1.0"
  applies_to = "vsf-nucleus-operational (LXC 101) state vector ℝ¹²⁸ + kernel telemetry"

  // ── Stasis (attractor convergence) ─────────────────────────────────────────
  stasis_cos {
    nominal_min  = 0.90      // observed steady-state ≥0.96; 0.90 gives margin
    warn_below   = 0.80      // class B — source: ac_classifier.py STASIS_WARN
    critical_below = 0.70    // class A — hard floor, sv.viable() threshold
                             // source: psi_protocol/spec.vsm (never reached empirically)
    basin_floor  = 0.79      // θ_PSI — min_cos under δ=1.0 perturbation, 300 stress ticks
    critical_angle = 0.9377  // thermal ceiling bound (67-69°C) — informational
  }

  // ── Trust ───────────────────────────────────────────────────────────────────
  trust {
    nominal      = 1.0
    warn_below   = 0.8       // class B — source: ac_classifier.py TRUST_WARN
                             // also D4-L2 precedent: "trust<0.8 → survival_mode" class
  }

  // ── Regime ──────────────────────────────────────────────────────────────────
  regime {
    nominal      = "in_recurrent_set"   // anything else = class B
    viable_full  = true                 // false = class A (escalate immediately)
  }

  // ── Invariants ──────────────────────────────────────────────────────────────
  invariants {
    consec_warn_max = 3       // ≥3 consecutive warns on one invariant = class B
    magnitude_max   = 1e-3    // single violation ≥1e-3 = class B
  }

  // ── Consumers ───────────────────────────────────────────────────────────────
  read_by = [
    "scripts/ac_classifier.py (AC — deterministic filter, LXC 101)",
    "scripts/s3star_kpi.py (S3* KPI plan-comparison, LXC 107)",
    "omega_validator.rs default Ω construction (W2.1) — manual sync, values mirrored",
  ]

  deviation_protocol = "outside R → AC classifies B/A → s5-alerts.db → SD/human.
                        Automated S3 response classes = F3.b (ratified 2026-06-12;
                        see docs/spec/response_classes.vsm — wiring in ac_algedonic.py)"
}

ratification {
  status    = "ratified"
  requires  = "rmw3 (S5)"
  decision  = "RATIFIED 2026-06-12 rmw3 (S5)"
  amendment_rule = "any change to bounds = D4-L3 double-loop — new S5 ratification"
}
