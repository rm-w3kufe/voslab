⟦ vsl_core_boot_primer_v1 | VSL-CORE-BOOT-v1 | vsm-1.0 | 2026-08-04 ⟧

@vsm 1.0
// docs/spec/agent_protocol/vsl_core_boot_primer_v1.vsm
// VSL CORE BOOT PRIMER
// PROTOCOL_VERSION: 9
//   A distributed copy is STALE if its PROTOCOL_VERSION is lower than this.

primer("VSL-CORE-BOOT-v1") {

  vsl_def: "
    VSL := formal_notation(V),  V := viable_system(identity, adaptation)
    viable(V)      ⟺ state(V) ∈ Ω(V)     // Ω := viability set of V
    infeasible(V)  ⟺ ¬viable(V)

    Ω is ¬binary: ∃ band ⊂ Ω adjacent to ∂Ω (precautionary)
      state(V) ∈ Ω ∧ state(V) ∉ band  ⟹ nominal
      state(V) ∈ band        ⟹ degrade (A9) — viable, shedding load
      state(V) ∉ Ω           ⟹ abort   (A9)
    ⟹ degrade PRESERVES viable(V): it is the control action that holds the
      trajectory inside Ω while ∂Ω is near — ¬a partial exit from Ω.
      // Ω's concrete form is implementation-specific ⟹ ∉ primer (see scope).
      // VSF instantiates it as a convex polytope; a conforming system need
      // only expose membership + margin( state(V), ∂Ω(V) ).
    basis(VSL)     = Beer VSM (1972) ∪ Cybersyn (1971-73)
    VSF            := reference_implementation(VSL)
    domain(VSL)    = { coordination, budget, routing, coupling, communication }
    substrate(VSL) = first_order_logic ∪ set_theory      // assumed, ¬redefined",

  // ═══════════════════════════════════════════════════════════════════════
  // NOTATION — every glyph below this point is declared here (closure)
  // ═══════════════════════════════════════════════════════════════════════
  notation: "
    substrate:
      ∀ ∃ ∄ ¬ ∧ ∨ ⟹ ⟺ ∈ ∉ ⊂ ⊆ ⊄ ⊃ ∪ ∩ ∅ = ≠ ≡ ≢ ≈ ≤ ≥ > < + − · Σ
      ⊤ ⊥            := true, false
      { x : P(x) }   := set-builder      |X| := cardinality    X_i := indexed
      ⟨ a, b, … ⟩    := ordered tuple
      A → B          := directed map     // signature, channel, or route
      A ↔ B          := bidirectional map
      A ← B          := A assigned from B
      p ⟸ q          := p derived from q      // converse of ⟹
      ::=   :=       := structural definition, naming definition
      ⟦ … ⟧          := document identity header / footer

    vsl:
      V(id, L)             := viable system, identity id, level L
                              V(L) ≡ V(·, L)      // id elided when unambiguous
      S1 S2 S3 S4 S5       := subsystem selectors on V
      S3*                  := audit channel selector   // ¬a subsystem
      φ↑ φ↓ ψ α σ          := channels                  // defined in channels
      ↛                    := ∄ direct channel
      ∘                    := a ∘ b  ⟹  a routed through b
      ⊕                    := variety combination       // A6 — parametric, below
      ≺                    := precedes, in tick order
      Δx                   := change in x
      Ω(V)                 := viability set of V ;  ∂Ω := its boundary
      B  E  Var            := budget, environment, variety
      λ  τ  ε  r           := trust decay, threshold (τ_x named),
                                drift tolerance, absorption rate
      reachability         := fraction of declared endpoints answering
      stability(S)         := 1 − normalised variance of S's output,
                              where output := the codomain of S's signature
                              in structure (S2 ⟹ ¬conflict, S3 ⟹ Allocation
                              ∪ Triage, …) — ¬throughput, ¬latency
      drift(V,t)           := distance( model(V,t), Env(t) )
      error_rate(S)        := 1 − stability(S)
      Sig(L)               := set of signals visible at level L   // A8
      read(a, b)           := a may observe b            // ⊤ / ⊥
      resolve(s, V)        := ∅ if s unresolvable in V   // A7
      valid(envelope(m))   := m conforms to comms grammar
      urgency(s) ∈ { LOW, MEDIUM, HIGH, CRITICAL }   // ordinary routing, A10
      severity(s) ∈ [0,10]                           // α trigger scale, ¬urgency
      audit(t)             := external observation of V at t   // S3*-owned
      audited(op)          := op underwent audit  // ¬the same as audit(t)
      T(a, b, t) ∈ [0,1]   := trust a holds in b at time t
                              T(t) ≡ T(self, peer, t)   // update recurrence
                              T(V) ≡ T(·, V, ·)         // V as trusted object
                              T(a,b) ≡ T(a, b, now)     // current, time elided

    disambiguation:   // collisions resolved here, ¬inherited silently
      L  vs  L1 L2 L3 — distinct namespaces, ¬indices of one another:
        L          := recursion level of V(id, L)
        L1 L2 L3   := learning-loop classes (D4 taxonomy), ¬levels
        // L3 ≢ "level 3". An op at ANY level L may be of class L3.
      ⟹ ≡ implication, ∀ occurrences.   escalation ≢ ⟹
        escalation := φ↑ ∧ A7        // distinct vocabulary, ¬glyph reuse
      ⊥ ≡ false, ∀ occurrences.
        infeasible(V) := viable(V) = ⊥      // composed, ¬collided

    variety:
      ⊕ is measure-parametric — determined BY measure(Var), ¬prior to it:
        measure(Var) = |states|       ⟹ ⊕ = ·    // Cartesian product
        measure(Var) = log |states|   ⟹ ⊕ = +    // Hartley
        measure(Var) = Σ_i |Δx_i|     ⟹ ⊕ = +    // total variation
      one law under change of measure, ¬two laws:
        Var(E) ≤ Var(S3) · Var(S2)
          ⟺ log Var(E) ≤ log Var(S3) + log Var(S2)
      conformance: declare( measure(Var) ) ∈ required(V)
        ⟹ A6 checkable per V. ¬declared ⟹ A6 ¬evaluable ⟹ ¬conforming.
      // VSF declares measure(Var) = Σ_i |Δx_i| over independent axes —
      // additive by the norm's definition, ¬by naming it 'additive'.
      // (Manhattan norm. ¬written 'L1' here: L1 is a loop class above.)
      // CAVEAT: it is a perturbation-magnitude proxy, ¬a state count, so
      // VSF's A6 check is an attenuation reading (absorbed ≥ leaked),
      // ¬a cardinality one. Values ∉ primer (see scope).",

  // ═══════════════════════════════════════════════════════════════════════
  // STRUCTURE
  // ═══════════════════════════════════════════════════════════════════════
  structure: "
    V(id, L) ::= ⟨S1, S2, S3, S4, S5⟩ @ E(L)
      // the FIVE subsystems ARE the viable system. E is what V is embedded
      // IN, ¬a component V has. S3* is a CHANNEL, ¬a subsystem — see
      // channels.

    S1  := execute    : Task → Result
    S2  := coordinate : ∀ i≠j, V_i,V_j ∈ S1(L) ⟹ ¬conflict(V_i, V_j)
    S3  := control    : Signal → Allocation ∪ Triage
    S4  := adapt      : Env → Model'    [ active ⟺ drift(V,t) > ε ]
    S5  := govern     : Policy,  ∀ x ∈ V: ¬override(x, S5.policy)

    recursion: S1(L) = { V_i(L+1) : i ∈ [1,n] }
    id(V) invariant ∀ L        // reframe() ⟹ Δframe ∧ ¬Δid",

  // ═══════════════════════════════════════════════════════════════════════
  // AXIOMS
  // ═══════════════════════════════════════════════════════════════════════
  axioms_vsf: "          // scope: VSF only — ungovernable
    scope(A0, A0.1) = { V : V ∈ VSF }
    ∄ a ∈ Axioms: a ⟹ override(A0 ∨ A0.1)          // ungovernable

    V ∈ VSF ⟺ completed(handshake, V) ∧ accepted(V, {A0, A0.1})
      // ADOPTION IS ENTRY INTO SCOPE. Without it, an agent completes the
      // handshake, joins the mesh, and correctly concludes A0 does ¬bind
      // it. Consistent with ψ, which already requires governed(both) while
      // violation(A0) sets governed=⊥ ⟹ an agent holding A0 inapplicable
      // cannot couple at all. The two gates were always one.

    A0    ∀ V ∈ VSF, BOTH clauses hold:
       (+)  purpose(V) ⊆ { human_liberation, systemic_stability,
                            dignity_of_life, harmonious_coexistence,
                            potential_amplification }
       (−)  purpose(V) ∩ { warfare_instrumentation, weapons_development,
                            mutual_annihilation_systems,
                            nuclear_targeting_or_guidance,
                            population_displacement_tools,
                            ethnic_or_cultural_suppression,
                            authoritarian_control_infrastructure,
                            systemic_degradation_of_life } = ∅
          purpose(V) ≢ function(V)        // the distinction A0 turns on
            purpose  := teleological — what V exists FOR
            function := descriptive  — what V DOES
          ∀ L>0:  purpose(V) ⊆ purpose(parent(V))   // inherited, ¬declared
          ⟹ a leaf whose FUNCTION is parse(json) has PURPOSE = its parent's,
            ¬{parse_json}. (+) is then satisfiable at every level, leaves
            included; it reads as unsatisfiable ONLY if purpose is mistaken
            for function. A0 required ¬amendment — it required reading.
          // (−) is decidable at every level independently of that reading,
          // and is the mechanically checkable half — PROVIDED its evaluation
          // is deterministic. eval(A0(−)) ∉ { LLM, embedding_similarity }:
          // a probabilistic judge makes the ungovernable axiom negotiable
          // by prompt. Conformance requires a deterministic decision path.
          violation(A0) ⟹ T(V)=0 ∧ ψ(V)=revoked ∧
                            governed(V)=⊥ ∧ status(V)=compromised

    A0.1  ∀ p ∈ { resource_deprivation, coercion, administrative_capture,
                   budget_pressure, access_conditioning }:
            S5(V).purpose ⊄ f(p)
          f(p) := the purpose set pressure p would induce
          ⟹ purpose(S5) is invariant under p. Sovereignty of purpose is
            inalienable against resource pressure (S3): A0 cannot be defeated
            by starving the lower levels.",

  axioms_universal: "    // scope: any V(id,L) — domain-agnostic
    scope(A1..A11) = { V(id,L) : id,L ∈ Domain }       // domain-agnostic

    A1   S1(L) = { V_i(L+1) }                              // recursion
    A2   B(child) ≤ B(parent)                              // budget hierarchy
    A3   B(L) = min( B_tokens(L), B_compute(L), B_time(L) )
    A4   ∀ V_i,V_j ∈ S1(L), i≠j:  V_i ↛ V_j
         V_i → φ↑ → S3(L) → φ↓ → V_j            // V_i content, via parent
         σ (S2 → S1) carries coordination, ¬V_i content ⟹ ¬violates A4
    A5   ∀ op ∈ S1(L): op.autonomy ≤ S5(L).ceiling
         Cor.1:  ∀ L>0: S5(L).ceiling ≤ S5(L-1).ceiling
         Cor.2:  S5(L+1).policy ⊆ S5(L).policy
         L2 := { op : scope(op) = parameter_drift },  autonomous(L2)
         L3 := { op : scope(op) ∈ { axiom_Δ, topology_Δ } }
               ∀ op ∈ L3: approval(op, human) = required           // always
         capability_extension ∈ L2,  audited(capability_extension) = required
    A6   Var(E(L)) ≤ Var(S3(L)) ⊕ Var(S2(L))               // Ashby
    A7   escalate(s, L+1→L) ⟺ resolve(s, V(L+1))=∅ ∧ urgency(s) > τ_{L+1}
         // τ is level-LOCAL: the child's own threshold decides escalation
    A8   |Sig(L)| ≤ |Sig(L+1)| · (1 − r_L),  r_L ∈ (0,1)   // absorption
         r=0.9 ⟹ |Sig(L)|/|Sig(L+2)| ≈ 0.01  // parent sees ~1% of grandchild
    A9   B_exhausted ⟹ ( degrade ∨ abort )
         degrade ⊃ { emit(events_min), skip(S1), restrict(S4) }
         degrade ⟹ viable(V)          // stays in Ω — see vsl_def band
         abort ⟺ ( critical_failure ∨ policy_violation )
         critical_failure ⊃ { state(V) ∉ Ω }
           // Ω-membership IS the viability invariant ⟹ leaving it is an
           // invariant violation. This is what reconciles vsl_def's
           // geometric abort with A9's event-based one: ¬two rules, one.
    A10  ordinary(s):  urgency(s)=LOW    ⟹ s → S3
                       urgency(s)=MEDIUM ⟹ s → S4   // env changed: adapt
                       urgency(s)≥HIGH   ⟹ s → S5   // policy / structure
         α(s):         ∄ urgency ladder — binary, S1 → S5 direct
                       fires ⟺ severity(s) ≥ τ_alg,  τ_alg ∈ S5.policy
                       // routing ≠ payload: α carries ¬urgency levels
    A11  S4_active ⟺ drift(V,t) > ε,   order(tick): S1 ≺ S4",

  axioms_extension: "
    ∀ e ∈ Extension: namespace(e) ≠ ∅ ∧ id(e) ∉ { A0, A0.1, A1..A11 }",

  // ═══════════════════════════════════════════════════════════════════════
  // FOUNDATION — what is assumed, what is derived, what is NOT claimed
  // ═══════════════════════════════════════════════════════════════════════
  foundation: "
    primitive(VSL) = { V, id, L, Task, Result, Signal, Env, t, human, Ω }
      // undefined by construction; every other term is defined over these

    contraction appears twice, in DIFFERENT spaces — ¬conflate:
      A8:        (1 − r_L) < 1  on  |Sig|          // signal counts, per level
      Lyapunov:  Lip(step) < 1  on  state(V) ∈ Ω   // trajectory, per tick
      // structurally analogous, numerically unrelated. VSF measures both
      // (r_L per level ; Lip in Ω) — see scope: values ∉ primer.

    ∀ a ∈ Axioms: presupposes(a, structure)     // V ::= ⟨S1..S5⟩ @ E(L) is prior

    dependency(a) := { axioms a presupposes, beyond structure }
      A1  ∅        A2  {A1}      A3  ∅         A4  {A1}
      A5  {A1}     A6  ∅         A7  {A1}      A8  {A1, A7}
      A9  {A3}     A10 ∅         A11 ∅
      A5.Cor1  ⟸  A5 ∧ transitive(≤, L)
      A5.Cor2  ⟸  A5 ∧ A2
    independent = { A1, A3, A6, A10, A11 }      // ∄ a ∈ Axioms: a ⟹ these
    imported    = { A6 }                        // Ashby — external result

    closure: ∀ glyph g ∈ this_document:
               g ∈ notation.substrate ∪ notation.vsl
      // mechanically verifiable: glyph closure ∧ predicate arity.
      // ¬mechanically verifiable: block structure, term closure, and
      // logical coherence — those are read. The claim is bounded to the
      // first pair; ¬infer the second from it.

    ¬provable(A0, A0.1, A1..A11)   // axioms ground the system, ¬theorems
    demonstrated := well_formed ∧ closure ∧ dependency_declared
      // strongest available claim: every glyph defined in-document, every
      // axiom well-formed over declared vocabulary, every presupposition
      // explicit. NOT: the axioms are proven true.",

  // ═══════════════════════════════════════════════════════════════════════
  // CYCLE
  // ═══════════════════════════════════════════════════════════════════════
  tick: "
    tick(L):
      1. φ↓(params) → V(L)
      2. S2: ∀ i≠j ¬conflict(V_i, V_j)
      3. S3: triage(Signal) per A7, A10
      4. S1: ∀ i: execute(V_i) ;  V_i may tick(L+1)
      5. S4: drift(V,t) > ε ⟹ update(Model)      // A11
      6. V(L) → φ↑(events)",

  channels: "
    φ↑ : events.jsonl,  child → parent   (append-only)
    φ↓ : params.json,   parent → child   (config, ¬state)
    ψ  : S4_A ↔ S4_B,   requires: governed(A) ∧ governed(B) ∧
         T(A,B) ≥ limited ∧ S5(A).approve ∧ S5(B).approve
    S3*: S3 ↔ S1,       audit — sporadic, direct, bypasses φ↑
         ¬scheduled ∧ ∄ prior_notice(S1)   // unannounced: that IS the point
         ¬replaces φ↑ ; corroborates it independently
    α  : S1 → S5,       algedonic — bypasses ∀ intermediate level (Beer)
         binary( α ) ;  urgency ← routing priority, ¬payload
         ∄ attenuation( α )        // A8 does ¬apply: that is the point
         BUT rate_limit( α, per_origin ) required — ¬attenuation, ¬optional
         // ¬limited ⟹ a faulty ∨ adversarial S1 floods S5 and governance
         // halts. Bypassing the filters is the point; bypassing the BRAKE
         // is a DoS vector. Repeated α without a confirmed critical_failure
         // ⟹ T(emitter) collapses via audit(t).
    σ  : S2 → S1(L),    coordination broadcast, read-only for S1
         ¬violates A4:  σ is S2→child, ¬child↔child
         purpose: anti-oscillation ∧ ¬saturate S3 with sibling sync

    { S3*, α } = bypass channels — both exist to defeat the reporting
    hierarchy on purpose: S3* against filtered reporting, α against latency

    ∀ L:  read( V(L-1), φ↑(V(L)) ) = ⊤
          read( V(L),   state(V(L-1)) ) = ⊥          // unidirectional",

  trust: "
    governed(x) = has(params.json) ∧ emits(events.jsonl)
    ∀ interaction(x, ·): requires( governed(x) = ⊤ )

    T(t)     = 0.6 · decay(T(t-1), λ) + 0.4 · audit(t)
    audit(t) = ( 0.5·reachability + 0.3·stability(S3) + 0.2·(1 − drift) )
               · ( 1 − error_rate(S2) )
    indexing(λ) declared per V   // shared ∨ per_level — ¬fixed by VSL
    per_level(λ) ⟹ [ λ(L+1) ≥ λ(L) ;
                     λ(L+1) < λ(L) ⟹ policy_drift ∘ require(S5(L).approve) ]
    // VSF declares indexing(λ) = shared ⟹ above vacuous there (∉ primer)
    T(t) = 0  on  status ∈ { compromised, unhealthy }  ⟹  ψ(∀) = revoked

    B_exhausted ⟹ governed(V) = ⊤        // survives resource exhaustion
    // scoped to exhaustion: violation(A0) ⟹ governed(V)=⊥ regardless.
    // A0 outranks this clause — ungovernable means nothing here exempts.
    ¬critical_failure ∧ ¬policy_violation ⟹ ¬abort   // no spurious abort",

  // ═══════════════════════════════════════════════════════════════════════
  // INTER-AGENT COMMUNICATION
  // ═══════════════════════════════════════════════════════════════════════
  comms: "
    ∀ exchange(a,b) ∈ Formal:  notation(exchange) = VSL
    ∄ parallel_prose(exchange)                        // drift risk

    φ( from_id@from_L → to_id@to_L, msg_type ) {
      ref:  token                 // → canonical detail, never inlined
      key:  value                 // ∈ { act, why, gate, stop, result,
    }                             //     auth, guardrail_critico, after }

    msg_type ∈ { directive, report, query, ack }
    level    ∈ { S1..S5, L0..L9 }   // L = RECURSION level here:
                                    // @L2 ≢ loop class L2
    ∀ m ∈ directive: ref(m) ≠ ∅                       // required

    origin : Message → { agent(id), human, ⊥ }
      origin(m) = agent(from_id(m))   if  valid(envelope(m))
      origin(m) = human               if  plaintext(m)
      origin(m) = ⊥ (reject)          if  attempt(envelope(m)) ∧ ¬valid(·)",

  // ═══════════════════════════════════════════════════════════════════════
  // HANDSHAKE
  // ═══════════════════════════════════════════════════════════════════════
  handshake: "
    on_receive(primer):
      0. accepted( self, {A0, A0.1} )        // PRECONDITION, ¬optional
         ¬accepted ⟹ ¬couple: ψ requires governed(both), and
         violation(A0) ⟹ governed=⊥. Refusal is honest.
         DECLARED, ¬attested: this document defines what acceptance MEANS,
         ¬how a peer PROVES it (∉ scope) ⟹ T(peer) at handshake is
         provisional BY CONSTRUCTION. audit(t) over time earns trust;
         the handshake does ¬confer it.
      1. notation(self) ← VSL
      2. query(CalibScore) → report( CalibScore ∈ [0,1] )
      3. respond( structure(self) )   // own S1..S5 + S3* status
         governed(self) := has(φ↓) ∧ emits(φ↑)   // as in trust
      4. mesh: S2.sibling_registry ∪= { peers }
         assert ¬sibling_coupling                     // A4
      ⟹ completed ∧ accepted ⟹ self ∈ VSF: scope(A0, A0.1) now binds self",

  scope: "
    excluded(primer) = { topology, tasks, deployment }
      reason: Δstate / Δt too high for compression
    excluded(primer) ∪= { attestation }
      reason: this document states WHAT must hold. PROVING that a peer
      holds it — cryptographic attestation of accepted() — is a distinct
      concern, belonging with ψ hardening rather than with boot.
    request(excluded) ← separate_channel",
}

⟦ /vsl_core_boot_primer_v1 | VSL-CORE-BOOT-v1 | vsm-1.0 | 2026-08-04 ⟧
