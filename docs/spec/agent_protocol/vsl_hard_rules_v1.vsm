@vsm 1.0
// docs/spec/agent_protocol/vsl_hard_rules_v1.vsm
// VSL HARD RULES — v1 (NORMATIVE DEFINITION of the hard rules)
// PROTOCOL_VERSION: 3
// Precondition: vsl_core_boot_primer_v1.vsm + vsl_regulation_layer_v1.vsm
//
// DIRECTION OF DEPENDENCY — this file DEFINES; RULES.md CITES.
//   RULES.md is the annotated human mirror: it carries the rationale, the
//   incident history, and the S5 attribution for each rule. It does not
//   restate the normative content — it points here, the way R8/R13/R15
//   already pointed into the primer.
//   Until v2 this header read "compressed RULES.md", declaring the OPPOSITE
//   direction from the one R5_canon_over_recall mandates (agent_protocol =
//   dependency base, RULES = dependent). Every rule then existed in 3-4
//   copies that drifted independently: R5 in 3 files / 9 statements, R6 in
//   4 places, R7 in 3. Corrected 2026-08-10 — the duplicates were removed
//   from RULES.md in the same commit, not merely deprecated.
//
// v3, 2026-08-11 (R7-SCOPE-INVERSION resolved, rmw3 S5): R7 previously said
//   state.db wins ANY conflict, unscoped — including the `rules` domain,
//   where state.db's own mirror had gone stale (pre-2026-08-03-compression
//   shape) and would have out-ranked this file, the corrected copy. rmw3's
//   diagnosis: state.db observes n02's DETERMINISTIC reality (services,
//   lxcs — populated by polling, freshness is meaningful); rules govern the
//   AGENT's non-deterministic behavior — declared by S5, not observable by
//   polling anything. The two were never the same KIND of fact, so one
//   staleness rule never should have covered both. R7 now scopes itself to
//   observed domains only; `rules` has exactly one canonical source, this
//   file, unconditionally.

rules("VSL-HARD-RULES-v1") {

  R1_locality: "
    ∀ C:  build(C) ∘ C.build_target
          deploy(C) ∘ C.deploy_target
          state(C) ⊆ { rootfs, canonical_state_dir, canonical_script_dir }
    ¬( build(C) ∘ dev_host )
    ¬( deploy(binary_built_elsewhere) )
    ¬( state(C) ∘ host_root ∖ exceptions )",

  R4_verification: "
    trust(claim) ⟸ ∃ check:  independent(check) ∧ external(check) ∧
                              real_conditions(check)
    ¬∃ such check  ⟹  claim ≡ unverified,  ∀ source ∈ { self_report, log,
                                                          config, is_active }",

  R5_canon_over_recall: "
    session_start:
      post_compact ⟹  onboard() ≺ act(summary)      // recall ≠ canon
      clean         ⟹  primer(4 docs) ≺ RULES ≺ onboard()
    authority_order:  state.db ≻ MEMORY ≻ HANDOFF ≻ TASKS
    // primer = docs/spec/agent_protocol/ (ALL 4: core, regulation, hard
    // rules, comms) — the dependency base: RULES defers its definitions
    // to it (R8/R13/R15 ≡ primer…). Read dependency before dependent.",

  R6_internal_first: "
    ∀ S1 ∈ external_domain:
      integrate(S1)  ⟸  (S2..S5 ∧ algedonic ∧ covenant) ⊨ empirical_exercise
    status(gate) ∈ TASKS.vsm  only",

  R7_state_db_wins: "
    state.db ⊕ memory → conflict ∧ domain ∈ observed(state.db)  ⟹  state.db wins
      // observed(state.db) = { services, lxcs, chains, storage_probe_state, … }
      //   — populated from n02 by polling; staleness is a meaningful, checkable
      //   property of these domains, which is what makes 'live wins' true.
    domain = rules  ⟹  this file (vsl_hard_rules_v1.vsm) wins, UNCONDITIONALLY
      // rules govern the AGENT (non-deterministic) — declared by S5, never
      // observed by polling n02. A hand-edited mirror table was never the
      // kind of artifact this rule's 'db = live' justification covers; it
      // rots exactly like a memory file would, with none of the freshness
      // guarantee. state.db MAY carry a `rules` table for convenience but
      // it is informational only, never a tie-breaker.
    // memory = point-in-time snapshot ; db = live, where 'live' is earned by
    // actually being polled — not by living in a SQL file",

  R8_spof: "
    ≡ vsl_regulation_layer_v1.spof_pattern
    // single-path infra ⟹ treat as critical ; probe(fail) ⟹ cross-check
    // before concluding blocked(path)",

  R9_no_silent_concession: "
    ∀ (interface, mechanism, contract) adopted_as_base:
      pass(version_check) ∧ pass(conformance) ∧ pass(viability_cert)
      diverges  ⟹  align(it) ∨ flag(it)              // never silent",

  R10_llm_boundary: "
    LLM ∈ { proposal, digest, audit_flag_synthesis }
    LLM ∉ { algedonic, φ↑, φ↓, homeostatic_tick }     // scope: llm",

  R10_1_llm_tactics_not_enforcement: "
    S4 (⊇ LLM) may actuate proactively toward human_set_goal
      under:  covenant_floor(deterministic) ∧ S3*_audit ∧
              escalation_duty ∧ graduated_autonomy
    intent ← LLM.   enforcement ← deterministic,  always.",

  R11_naming: "
    heritage_names:  keep as design_target, document(gap), converge, ¬rename
    borrowed_terms:  implementation ⊨ canonical_definition(term)  ∨  rename",

  R13_visibility: "
    ≡ vsl_core_boot_primer_v1.channels (unidirectional visibility)",

  R15_formal_exchange: "
    ≡ vsl_core_boot_primer_v1.comms (VSL, never prose, ∀ agents/providers)",

  doc_sync_practice: "
    status(work_item) ∈ TASKS.vsm  only
    Δ(status) ∘ same_commit( close(work_item) )        // never deferred",
}
