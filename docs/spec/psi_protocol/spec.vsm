// ─── DEFINITION ───────────────────────────────────────────────────────────────

PSI("Perimeter of Stability Intervention") = {
  version:   "PSI/1.0",
  purpose:   "define when S4 (LLM) may observe and optionally support a stressed S1 kernel",
  principle: "intervention = support under stress, not rescue from collapse",
  covenant:  "A0.1 anti-coercion axiom — S4 may propose, never impose"
}

// ─── THRESHOLD ────────────────────────────────────────────────────────────────

theta_PSI = {
  value:       0.79,
  units:       "cosine similarity (stasis_cos)",
  angle:       "37.9°",
  derivation:  "min_cos under max activation perturbation (δ=1.0, 300 stress ticks)",
  semantics:   "system under maximum observable stress but still viable",
  upper_bound: 0.9377,   // from critical_angle (thermal)
  floor:       0.70,     // sv.viable() hard threshold — never reached empirically
  calibration: "WORKING VALUE — calibration target, not frozen (S5 directive 2026-06-22).
                Reviewed against accumulated run data per calibration_protocol below.
                Q2 (senescence): θ_PSI may need to become time-varying.",
}

// ─── TRIGGER CONDITIONS ───────────────────────────────────────────────────────

trigger(PSI) = {
  primary:   "stasis_cos < θ_PSI (0.79)",
  secondary: "stasis_cos < θ_PSI for N_SUSTAINED=3 consecutive ticks",  // avoid spurious triggers
  inhibit:   "stasis_cos recovering (dcos/dt > 0) — system self-regulating, no intervention needed",
  emergency: "viable_full = false — S4 MUST act immediately (should not normally occur)",
}

// ─── INTERVENTION LEVELS ──────────────────────────────────────────────────────

intervention_levels = {

  L1_observe: {
    trigger:   "stasis_cos < 0.90",
    action:    "S4 begins monitoring — logs angustia_signal to φ↑ channel",
    autonomy:  "fully automatic — no human approval needed",
    covenant:  "observation only — no φ↓ sent",
  }

  L2_support: {
    trigger:   "stasis_cos < θ_PSI (0.79) sustained N_SUSTAINED ticks",
    action:    "S4 may send φ↓ suggestion to S3: reduce load, reallocate resources",
    autonomy:  "S4-autonomous within pre-authorized bounds (D4-L2 class_execution)",
    covenant:  "suggestion, not command — S3 applies judgment before acting",
    examples:  ["reduce cpu_weight allocation", "defer non-critical tasks",
                "request thermal cooldown window"],
  }

  L3_escalate: {
    trigger:   "stasis_cos < 0.72 OR viable_full = false",
    action:    "S4 escalates to human (rmw3) via algedonic channel (vsf-s5-algedonic +
                bbs-bridge, LXC 104) — requires double-loop approval (D4-L3)",
    autonomy:  "requires_human for any EXPANDING action — never automated.
                CONTRACTING fail-safe is pre-authorized (see fail_safe_ladder).",
    covenant:  "A5 ceiling: S4 cannot unilaterally modify kernel policy.
                S4 NEVER 'takes charge' — its scope contracts with the system's.",
    on_human_present:     "human directs the double-loop response (normal A5 path)",
    on_human_unavailable: "deterministic fail_safe_ladder executes (see below) — NOT S4.
                           This answers the S5 observation (2026-06-22): the human is not
                           always connected; the system must degrade safely without them.",
  }
}

// ─── FAIL-SAFE LADDER (L3 + human unavailable) ───────────────────────────────
// S5 observation (2026-06-22): rmw3 (or any human) may be unreachable when L3 fires
// and an urgent response is needed. Principle: in the absence of human judgment, the
// system defaults to the action that minimises harm AND minimises S4's autonomous power.

fail_safe_asymmetry = {
  principle:  "Autonomous emergency action is permitted ONLY for moves that CONTRACT the
               system (shed load, reduce scope, halt cleanly), NEVER for moves that EXPAND it
               (novel actions, resource acquisition, policy change).",
  why:        "Contraction can never be used to seize authority → pre-authorisable.
               Expansion always can → always requires a human.
               This makes the human's approval a DESIGN-TIME act (authoring this ladder now),
               not an EXECUTION-TIME requirement. The human stays in the loop — earlier.",
  analogy:    "SCRAM (nuclear) / dead-man's switch (rail): the safe state is the DEFAULT when
               control is lost. It needs a human to NOT prevent it, not a human to trigger it.",
  no_llm:     "The ladder is executed by the deterministic reflex layer (Rust), NOT S4/Qwen
               (D6/R10 — no LLM in the safety path). S4 only keeps escalating + logging.",
}

fail_safe_ladder = {
  precondition: "L3 trigger active AND no human ack within T_ack AND stasis_cos still degrading",

  T_ack: {
    value:       "300s",
    role:        "human acknowledgment window after L3 fires, before ladder begins",
    during:      "system holds at MAX L2 support (shed non-critical load) automatically —
                  buys time without expanding S4 authority",
    calibration: "WORKING VALUE — calibration target (S5 directive). Tune against real
                  algedonic round-trip latency + observed degradation rates.",
  }

  steps: [
    "S1 — shed all non-critical load (maximal L2 support; deterministic; reversible)",
    "S2 — quiesce to minimal viable kernel (reduce to known-stable attractor)",
    "S3 — if STILL inviable: clean halt with state snapshot preserved (the ultimate fixed point)",
  ]

  properties: {
    monotone_contracting: "every step only REDUCES system activity — never expands (A0.1-safe)",
    deterministic:        "no LLM judgment at any step (D6/R10)",
    bounded:              "terminates in clean halt — a known, recoverable fixed point",
    reversible:           "at any step, human-return OR stasis_cos recovery exits the ladder",
    state_preserved:      "snapshot on halt → kernel resumes from where it was when a human returns",
    non_harm:             "clean halt is NOT harm (A0) — it is sleep, not death. The harm would be
                           an unsupervised LLM 'rescue' that corrupts state or expands scope.",
  }

  algedonic: "throughout the ladder, the algedonic channel keeps firing on ALL channels so the
              full trace is waiting when ANY human returns (vsf-s5-algedonic, bbs-bridge).",

  empirical_grounding: "viable_full=false is structurally hard to reach (basin floor > 0.79) and
                        auto_recovery is the default path → L3-with-no-human is RARE. When it
                        happens, safe contraction is the covenant-consistent response.",
}

// ─── SIGNAL FORMAT ────────────────────────────────────────────────────────────

angustia_signal = {
  channel:    "φ↑ telemetry (events.jsonl)",
  event_type: "angustia",
  fields: {
    tick:        "current tick",
    stasis_cos:  "current cosine similarity",
    level:       "L1 | L2 | L3",
    dcos_dt:     "rate of change (positive = recovering)",
    viable_full: "bool",
    entropy_phase: "stasis | inhale | degen | exhale",
  }
}

// ─── RECOVERY PROTOCOL ────────────────────────────────────────────────────────

recovery = {
  auto_recovery:   "stasis_cos ≥ θ_PSI for 5 consecutive ticks → PSI deactivates",
  S4_success:      "stasis_cos recovers within recovery_window after φ↓ sent",
  log_outcome:     "all interventions logged with outcome (recovered | escalated | spontaneous)",
  theorem:         "if basin is robust (empirically confirmed), auto_recovery is the default path",
}

// ─── CONNECTION TO COVENANT ───────────────────────────────────────────────────

covenant_constraints = {
  A0:   "PSI never activates to harm the kernel — support only (clean halt = sleep, not harm)",
  A0.1: "S4 cannot use PSI to increase its own authority or scope. The fail-safe ladder
         CONTRACTS S4's scope with the system's — it is structurally impossible to use it to
         seize authority (fail_safe_asymmetry).",
  A5:   "PSI ceiling: S4 autonomous only at L2 (support) + CONTRACTING fail-safe. Any EXPANDING
         action at L3 requires human. Human approval of the fail-safe ladder is given at
         DESIGN time (ratification), not execution time.",
  D4:   "L2 support + fail-safe contraction = class_execution (pre-authorized) |
         L3 expanding response = policy_change (human)",
  D6:   "S4 (LLM) at L2 only — PSI signal processing AND the fail-safe ladder are deterministic Rust",
}

