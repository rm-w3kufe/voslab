@vsm 1.0
// VSL-THERMAL-REFINEMENTS-01: Phase 1.5 Thermal Integration Specification
// Date: 2026-05-13
// Domain: Phase 1.5 (metrics, RAG, scheduling, thermal-aware execution)
// Scope: SAFE_MODE fallback validation + code refinements (#2, #3, #4)
// Audience: BBH (implementation), Qwen (architecture), rmw3 (S5 policy)
// Status: LOCKED — Ready for execution at 14:00 UTC 2026-05-13

spec(VSL-THERMAL-REFINEMENTS, "Phase 1.5 thermal integration + SAFE_MODE fallback validation"):

  // ═════════════════════════════════════════════════════════════════════════
  // CONTEXT & ARCHITECTURAL DECISION
  // ═════════════════════════════════════════════════════════════════════════

  context:
    problem: "Kali/QEMU environment lacks thermal sensors. Original validation sequence expected dynamic zone transitions. Actual environment: get_temp() returns None → SAFE_MODE activates automatically."

    discovery: "This is not a bug. SAFE_MODE is the INTENDED fallback state per Ax_SafeFallback: 'Missing telemetry → conservative operation.' Testing SAFE_MODE validates the architecture's resilience in virtualized environments."

    decision: "Accept SAFE_MODE baseline as valid validation state. Reframe 6-test sequence to validate SAFE_MODE correctness instead of zone transitions. This tests what actually happens in production (AWS, Azure, containerized deployments)."

    architectural_alignment: |
      • Ax_SafeFallback: Missing thermal monitoring → conservative operation (0 input slots, 1 output)
      • Ax_HardwareCeiling: 85°C hard stop enforced via SAFE_MODE slot limits
      • Ax_CapabilityFallback: Non-blocking degradation (RAG, metrics degrade gracefully)
      • Ax_ProgramIsolation: Enforced at DB layer (per-target tables, independent of thermal)

  // ═════════════════════════════════════════════════════════════════════════
  // CODE REFINEMENTS (3 changes, isolated + low-risk)
  // ═════════════════════════════════════════════════════════════════════════

  refinement(R3, "get_zone() None handling — TypeError prevention"):
    status: "PRE-EXISTING (verified, no change required)"
    location: "/home/rmw3/claude/tools/scripts/thermal_scheduler_enhanced.py:153-154"
    code: |
      def get_zone(temp: Optional[float]) -> str:
          if temp is None:  # ← This line prevents TypeError
              return "safe_mode"  # Ax_SafeFallback
          # ... existing threshold comparisons unchanged

    purpose: "Prevent TypeError when get_temp() returns None (missing sensors scenario)"
    test_coverage: "VSL-TEST-2: get_zone(None) → 'safe_mode' deterministic"
    status_commit: "5172b19 + verified 2026-05-13"

  refinement(R2, "subprocess timeout=2.0 — hang prevention"):
    status: "IMPLEMENTED 2026-05-13"
    location: "/home/rmw3/claude/tools/scripts/thermal_scheduler_enhanced.py:134-136"
    change_before: |
      out = subprocess.check_output(
          ["sensors"], stderr=subprocess.DEVNULL, text=True
      )

    change_after: |
      out = subprocess.check_output(
          ["sensors"], stderr=subprocess.DEVNULL, text=True, timeout=2.0
      )

    rationale: "If sensors command is present but unresponsive (driver issue in LXC), subprocess blocks indefinitely. Timeout=2.0s prevents scheduler stall."

    risk: "VERY LOW — isolated parameter addition, exception already caught below"

    test_coverage: "VSL-TEST-5: subprocess timeout=2.0 parameter accepted"

  refinement(R4, "SAFE_MODE audit logging — compliance + post-analysis"):
    status: "IMPLEMENTED 2026-05-13"
    location: "/home/rmw3/claude/tools/scripts/thermal_scheduler_enhanced.py:144-145"
    change_before: |
      log("[WARN] No thermal sensor reading available. Entering SAFE_MODE.")
      return None

    change_after: |
      log(f"[SAFE_MODE] timestamp={datetime.now().isoformat()} zone=safe_mode trigger=no_thermal_sensor")
      return None

    rationale: |
      "SAFE_MODE is baseline state in Kali/QEMU. Structured audit logs essential for:
       1. Confirming SAFE_MODE activation is due to missing sensors (not crash)
       2. Tracking duration in SAFE_MODE for post-baseline analysis
       3. Supporting S5 (rmw3) override decisions"

    log_example: "[SAFE_MODE] timestamp=2026-05-13T11:48:51.100028 zone=safe_mode trigger=no_thermal_sensor"

    risk: "NONE — purely logging addition, no logic change"

    test_coverage: "VSL-TEST-1: Log format verified when get_temp() returns None"

  // ═════════════════════════════════════════════════════════════════════════
  // VALIDATION TEST SEQUENCE (6 tests, SAFE_MODE baseline)
  // ═════════════════════════════════════════════════════════════════════════

  test_suite(VSL-TESTS, "6-test SAFE_MODE validation sequence"):

    meta:
      environment: "Kali/QEMU (no thermal sensors, SAFE_MODE baseline)"
      duration: "~45 minutes"
      success_criteria: "6/6 tests pass"
      owned_by: "BBH (S1 implementation)"
      scheduled: "2026-05-13 14:00-14:45 UTC"

    test(VSL-TEST-1, "Verify get_temp() returns None when thermal zones missing"):
      objective: "Confirm sysfs absence is handled gracefully (no crash, no fake 40.0°C)"

      assertions:
        - "sysfs /sys/class/thermal/thermal_zone*/temp is empty"
        - "get_temp() returns None"
        - "No exception thrown"
        - "Audit log: '[SAFE_MODE] timestamp=... zone=safe_mode trigger=no_thermal_sensor'"

      pass_criteria: "✓ None returned, audit log present, no exception"

    test(VSL-TEST-2, "Verify SAFE_MODE activates when temp is None"):
      objective: "Confirm get_zone(None) → 'safe_mode' without TypeError"

      assertions:
        - "get_zone(None) returns 'safe_mode' deterministically"
        - "No TypeError: '>=' not supported between NoneType and float"
        - "Zone color: ? (warning emoji)"

      pass_criteria: "✓ Returns 'safe_mode', no TypeError"

    test(VSL-TEST-3, "Verify SAFE_MODE persists under CPU load"):
      objective: "Confirm fallback robustness (scheduler stays in SAFE_MODE even under stress)"

      procedure:
        1. "Start scheduler with monitoring"
        2. "Apply CPU load (stress --cpu 4 --timeout 30s)"
        3. "Observe scheduler.log for zone changes"
        4. "Expected: No zone transitions, stays in SAFE_MODE"

      assertions:
        - "Scheduler remains in SAFE_MODE under CPU load"
        - "No accidental escalation to 'cool', 'optimal', 'warm', etc."
        - "Scheduler log shows: '[TICK] ... zone=?safe_mode ... running: 0 input / X output'"

      pass_criteria: "✓ SAFE_MODE persists, no unexpected transitions"

    test(VSL-TEST-4, "Verify get_zone(None) determinism (no race conditions)"):
      objective: "Confirm zone logic doesn't crash or vary with None temp"

      procedure:
        "Call get_zone(None) 10 times in loop, record results"

      assertions:
        - "All 10 calls return 'safe_mode'"
        - "No TypeError, no variability"
        - "100% success rate"

      pass_criteria: "✓ 10/10 calls return 'safe_mode' consistently"

    test(VSL-TEST-5, "Verify subprocess timeout prevents hangs"):
      objective: "Confirm timeout=2.0 parameter prevents indefinite blocking"

      assertions:
        - "subprocess.check_output(['sensors'], ..., timeout=2.0) is syntactically valid"
        - "No TypeError on timeout parameter"
        - "get_temp() fallback includes timeout protection"

      pass_criteria: "✓ Timeout parameter accepted, no syntax errors"

    test(VSL-TEST-6, "Verify RAG Phase 5 works independently of thermal state"):
      objective: "Confirm graceful fallback (RAG non-blocking even in SAFE_MODE)"

      procedure:
        "Attempt RAG Phase 5 recommendation generation with mock findings"

      assertions:
        - "RAG returns recommendations OR degrades gracefully (non-blocking)"
        - "No crash due to SAFE_MODE state"
        - "Phase 5 continues even if RAG unavailable (LanceDB optional)"

      pass_criteria: "✓ RAG functions or degrades gracefully (non-blocking)"

  // ═════════════════════════════════════════════════════════════════════════
  // AFFIRM BASELINE EXECUTION (post-validation)
  // ═════════════════════════════════════════════════════════════════════════

  execution_plan(AFFIRM-BASELINE, "Phase 0-4 + Phase 1.5 with SAFE_MODE baseline"):

    precondition: "✓ BBH 6/6 tests pass"

    target: "affirm.com (Affirm bug bounty program)"

    phases:
      phase_0_4: |
        "Normal pipeline execution (independent of thermal state)
         • Phase 0: Profile
         • Phase 2: Active (web fingerprinting)
         • Phase 3: Enum (enumeration)
         • Phase 4: Vuln (vulnerability assessment)"

      phase_1_5: |
        "Non-blocking enhancements:
         • Metrics collection: z-score anomaly detection
         • Multi-target scheduler: priority queue reordering
         • Credential vault: Fernet encryption, per-program isolation
         • Tool ROI tracking: skip low-value tools
         • RAG Phase 5: generate recommendations from historical findings"

      thermal_state: |
        "SAFE_MODE (expected in LXC 105 if no sensors)
         • Input slots: 0 (no new jobs started)
         • Output slots: 1 (in-flight jobs complete)
         • Execution model: Sequential output, no parallelization
         • Expected duration: Longer than ideal, but stable"

    expected_metrics:
      findings_db: "~/bbh/findings.db — SQLite with discovered vulnerabilities"
      metrics_json: "~/bbh/metrics.json — anomaly detection scores, tool ROI"
      logs: "~/bbh/logs/scheduler.log — zone transitions, phase completions, RAG recommendations"

    timeline:
      start: "2026-05-13 15:00 UTC (if BBH 6/6 pass)"
      phase_0_4_duration: "~30-45 min"
      phase_1_complete: "2026-05-17 16:00 UTC (Friday)"
      rmw3_decision: "Phase 2 go/no-go based on baseline results"

  // ═════════════════════════════════════════════════════════════════════════
  // PHASE 2 ROADMAP (if Affirm baseline succeeds)
  // ═════════════════════════════════════════════════════════════════════════

  phase_2_roadmap:

    week_2:
      task: "Install LanceDB + enhanced RAG recommendations"
      impact: "Improve Phase 5 pattern matching with vector DB"
      estimated_cost: "2-3 hours"

    week_3:
      task: "Check LXC 105 thermal sensor availability (Proxmox nesting config)"
      paths:
        - "If sensors available: Upgrade to full thermal monitoring"
        - "If sensors unavailable: Document SAFE_MODE as production baseline"

    week_4_plus:
      task: "Phase 2 re-architecture (if baseline performance acceptable)"
      components:
        - "PostgreSQL 16: findings persistence + sync"
        - "Neo4j 5.26: asset graph + pivot detection"
        - "Celery workers: multi-target parallelization"
      estimated_cost: "~16 hours"
      criteria: "rmw3 decision (Friday 2026-05-17) determines whether Phase 2 proceeds"

  // ═════════════════════════════════════════════════════════════════════════
  // ACCEPTANCE CRITERIA
  // ═════════════════════════════════════════════════════════════════════════

  acceptance:
    validation_passes_if:
      - "✓ BBH 6/6 tests all pass"
      - "✓ No unhandled exceptions in scheduler.log"
      - "✓ get_zone(None) deterministically returns 'safe_mode'"
      - "✓ SAFE_MODE persists under load (no unexpected zone transitions)"
      - "✓ subprocess timeout=2.0 parameter accepted"
      - "✓ RAG Phase 5 gracefully degrades if unavailable"

    validation_fails_if:
      - "✗ Any test throws unhandled exception"
      - "✗ get_zone(None) raises TypeError"
      - "✗ SAFE_MODE exits unexpectedly"
      - "✗ Scheduler crashes or hangs"
      - "✗ subprocess timeout causes parameter error"

    go_no_go_rule: |
      "IF BBH 6/6 tests pass AND no exceptions AND Affirm infrastructure ready
       THEN launch Affirm baseline at 15:00 UTC 2026-05-13
       ELSE investigate failure + revert changes if necessary"

  // ═════════════════════════════════════════════════════════════════════════
  // CLOSURE
  // ═════════════════════════════════════════════════════════════════════════

  closure:
    "VSL-THERMAL-REFINEMENTS-01 specification locked.

     3 code changes (R2, R3, R4) isolated and low-risk.
     6-test sequence validates SAFE_MODE architecture in virtualized environment.
     SAFE_MODE is not a failure state; it is the intended fallback per Ax_SafeFallback.

     BBH validation scheduled 14:00 UTC 2026-05-13.
     Affirm baseline ready for launch if tests pass.
     Phase 2 roadmap documented and deferred pending baseline results.

     Ready to execute with confidence. handshake"
