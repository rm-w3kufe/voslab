// docs/spec/format_usage_inventory_2026-08-11.vsm
// FORMAT-USAGE INVENTORY — base de evidencia empírica para el "orientador
// determinista de formatos" (prosa vs código vs VSL vs comentarios VSL)
// que rmw3 planteó a [O] 2026-08-11 16:10 y que se quedó sin respuesta
// cuando Claude se quedó sin tokens. Diseño conceptual es de Claude/Rmw3 —
// este documento es SO el inventario de evidencia desde el rol [S] (DS).
//
// author: DS [S], 2026-08-11 (feat/ds-s1)
// scope:  medición empírica del corpus actual — qué formato usa cada tipo
//         de artefacto, con qué header, qué componentes léxicos, qué rol
//         le toca a cada uno en el ciclo de trabajo. NO propone reglas —
//         eso es diseño y queda para [O].
// method: rodear el catálogo 2026-08-11_grammar_protocol_ontology_instruments
//         con la contracara FORMAT: ese catalogó los Instruments que guardan
//         Grammar/Protocol/Ontology; este cataloga qué Format usa cada
//         Artifact en la práctica, para que el orientador tenga evidencia
//         de qué caso de uso ya existe (no teoría).
// status: INVENTORY-COMPLETE — esperando diseño [O] sobre esta base.

inventory("FORMAT-USAGE-2026-08-11") {

  // ═════════════════════════════════════════════════════════════════════════
  // CORPUS — lo medido, no lo asumido
  // ═════════════════════════════════════════════════════════════════════════

  corpus: {
    vsm_files:    493,            // find docs -name '*.vsm'
    md_files:     165,            // find docs -name '*.md'
    tex_files:    3,              // docs/papers/*/main*.tex — la prosa larga ES .tex
    json_files:   "varios",      // opencode configs, coupling_manifests, focus
    py_files:     "~350",        // scripts/, projects/ — el código ES .py
    rs_files:     47,            // projects/vsf-nucleus/src — kernel en Rust
  },

  // ═════════════════════════════════════════════════════════════════════════
  // AXIOMA DE PARTIDA — observado, no postulado
  // ═════════════════════════════════════════════════════════════════════════

  observed_invariant:
    "El formato NO se elige por capricho — cada tipo de artefacto del repo
     usa un formato determinado que responde a (1) qué tipo de CONTENIDO
     lleva y (2) qué INSTRUMENTO debe poder leerlo. La pregunta de rmw3
     ('cuándo prosa, cuándo código, cuándo VSL, cuándo comentarios VSL')
     tiene respuesta empírica observando lo que ya hacemos: hay 7 formas
     estables, cada una con un header canónico y un componente léxico
     típico. El orientador determinista no inventa — formaliza lo que
     ya es estable.",

  // ═════════════════════════════════════════════════════════════════════════
  // LAS 7 FORMAS — observadas en el repo (no prescritas)
  // ═════════════════════════════════════════════════════════════════════════

  forms: [

    // ── Forma 1: ENVELOPE — dispatch agente→agente ──────────────────────
    {
      id:        "ENVELOPE",
      where:     "docs/deploy/*dispatch*.vsm (25 files)",
      header:    "@vsm 1.0",
      signature: "phi([O]@S3 -> [S]@S1, directive) { ... }",
      components: {
        prose:   "bloque dentro de `phi(...){}` — `why:`, `task:`, strings",
        vsl:     "firma `phi(emisor -> receptor, modo)` — formal",
        code:    "no lleva — es routing, no implementación",
        comments:"header `//` banner con DIRECTIVE + contexto",
      },
      role:      "pasar trabajo entre agentes sin ambigüedad routing —
                  R15 inter-agent formal",
      reader:    "agente destino (DS, child, futuro) — grammar-aware
                  (vsf-agent-vsl-gate.ts valida)",
    },

    // ── Forma 2: SPEC — experimento pre-registrado ──────────────────────
    {
      id:        "SPEC",
      where:     "docs/experiments/*/spec.vsm, docs/spec/*.spec.vsm",
      header:    "@vsm 1.0",
      signature: "experiment(EXP-XX) { ... } o foo(.spec.vsm){...}",
      components: {
        prose:   "fields `question:`, `motivation:`, `observables:` — strings",
        vsl:     "construct formal `experiment(...)` + sub-bloques",
        code:    "no lleva — si necesita pseudocódigo, va como string",
        comments:"PRE-REGISTERED, author, status — `//` header con
                  status FROZEN/etc.",
      },
      role:      "definir un experimento ANTES de correrlo (R4: ciencia
                  pre-registrada, no narrativa post-hoc)",
      reader:    "validador + autor futuro — el parser reconoce
                  `experiment(...)`, el humano lee la motivación",
    },

    // ── Forma 3: THEORY — prueba/constructo formal ──────────────────────
    {
      id:        "THEORY",
      where:     "docs/theory/*.vsm (18 files), docs/papers/*/*.vsm",
      header:    "@vsm 1.0",
      signature: "theorem(Thm_X, \"tagline\"):",
      components: {
        prose:   "body del teorema en notación matemática, no lx natural",
        vsl:     "máximo — axioms, theorems, constructs, corollaries",
        code:    "pseudocódigo ocasional como referencia a `projects/src/*.rs`",
        comments:"NOTATION block `//` — clave: define Qué significa cada
                  símbolo antes del cuerpo",
      },
      role:      "fundamentar teoría que el código implementa
                  (composition_proof ↔ coupling.rs)",
      reader:    "revisor Fierro / Beer-community — matemáticamente denso",
    },

    // ── Forma 4: INCIDENT/REPORT — reconstrucción temporal ─────────────
    {
      id:        "INCIDENT",
      where:     "docs/incidents/*.vsm (6), docs/deploy/*_report.vsm (20+)",
      header:    "@vsm 1.0",
      signature: "catalog(\"ID\") { ... }",
      components: {
        prose:   "cronología narrativa de eventos (R4: timestamps verificados)",
        vsl:     "construct `catalog(...)` — categoriza items},
        code:    "snippets bash/python citados verbatim dentro de strings
                  (no ejecutables aquí — referenciales)",
        comments:"header narrativo extenso `//` — contexto antes del bloque",
      },
      role:      "reconstruir un incidente con evidencia citable
                  (R4 independencia: cada hash resuelve live)",
      reader:    "agente futuro + auditor — narrativo pero estructurado",
    },

    // ── Forma 5: TASKS/BACKLOG — estado compartido ─────────────────────
    {
      id:        "TASKS",
      where:     "TASKS.vsm (~10455 lines)",
      header:    "@vsm 1.0",
      signature: "task(\"ID\", priority=X, agent=[...]) = {...} (forma B)
                  o task(X): k=v (forma A)",
      components: {
        prose:   "`what:`, `closed_evidence:`, `note:` — strings descriptivas",
        vsl:     "construct `task()` con recognised fields (status, gate, etc.)",
        code:    "no lleva",
        comments:"`// ─── DONE ───` / `// ─── OPEN ───` separadores
                  visuales para humanos",
      },
      role:      "backlog + estado del trabajo — UN lugar para status
                  (doc-sync discipline)",
      reader:    "tasks_provider.py (state-canon-mcp) + humano —
                  grammar-aware (vslline.py + R4.1 gate activos ahora)",
    },

    // ── Forma 6: GOVERNANCE/COVENANT — constitucional ───────────────────
    {
      id:        "GOVERNANCE",
      where:     "docs/governance/covenant*.vsm (8 files)",
      header:    "⟦ name | author | vsm-X.Y | date ⟧ — identidad caligráfica",
      signature: "preamble: ...; axiom: ...; article: ...",
      components: {
        prose:   "preámbulo bilingüe (ES/EN) en strings `ES: \"...\"`",
        vsl:     "construct formal `axiom(...)`, `article(...)`",
        code:    "no lleva",
        comments:"separadores `// ───` para secciones (preamble/article)",
      },
      role:      "constitución del sistema — reglas que nadie override
                  (S5: covenado)",
      reader:    "humano (rmw3) — requiere legible, no densamente notacional",
      legacy:    "formato `⟦⟧` más antiguo que `@vsm 1.0` —
                 令subsiste por convención historica",
    },

    // ── Forma 7: SESSIONS — diálogo agente↔agente ──────────────────────
    {
      id:        "SESSIONS",
      where:     "docs/sessions/*.vsm (31) + .md de diálogo",
      header:    "@vsm 0.1 + ⟦⟧ identidad — formato histórico",
      signature: "ψ CHANNEL ... V(\"...\") = {...}",
      components: {
        prose:   "transcripción comprimida + comentarios contexto",
        vsl:     "V(...) construct para el sistema observado",
        code:    "no lleva — son diálogo, no ejecución",
        comments:"hub `// session:`, `// watermark_on_file:` — metadatos
                  de la conversación",
      },
      role:      "preservar diálogo cross-agent (Gemini/Qwen/Kimi/Meta
                  handshake etc.) — histórico",
      reader:    "humano lateral — formato reside entre transcripción
                  y registro estructurado",
      legacy:    "@vsm 0.1 — formato más antiguo del repo, pre-1.0",
    },
  ],

  // ═════════════════════════════════════════════════════════════════════════
  // PATRONES TRANSVERSALES — observados en TODAS las formas
  // ═════════════════════════════════════════════════════════════════════════

  cross_cutting_patterns: [

    "P1. HEADER SIEMPRE PRESENTE: las 7 formas tienen un header
     canónico (@vsm X.Y o ⟦⟧). `verify_encoding.py` lo valida (206
     advisories actuales son dash, no header — juicio, no gate). El
     orientador puede asumir: si no lleva header reconocido, NO es
     VSM-canonical y se rechaza.",

    "P2. PROSA VA EN STRINGS DENTRO DE VSL, NO AFUERA: el patrón universal
     es `field: \"prosa aquí\"` — la prosa es el VALUE de un campo VSL,
     no texto suelto en el archivo. ESTO es la distinción crítica:
     VSL → estructura, prosa → contenido. No hay prosa libre
     sin un campo que la contenga. (vsf-agent-vsl-gate.ts bloquea
     prosa larga >120 chars por exactamente esta razón —
     vslline-manifest-valid, R15 gate.)",

    "P3. COMENTARIOS `//` LLEVAN RACIONAL, NO HECHOS: observado en todas
     las formas — `//` se usa para: (a) context/autoría del archivo,
     (b) separadores visuales (// ─── DONE ───), (c) NOTATION blocks
     en theory. NUNCA lleva el contenido de una tarea o la definición
     de un experimento. La diferencia operativa: `//` NO es leído por
     ningún instrumento (parser salta); VSL sí. Si debe sobrevivir a
     symbol_table/tokenizer/debt_register → va en VSL. Si es contexto
     puro para el humano → va en `//`.",

    "P4. CÓDIGO VA EN ARCHIVOS .py/.rs/.sh, NUNCA EN VSL: el código
     ejecutable vive en scripts/, projects/, no dentro de .vsm. Cuando
     un doc VSL referencia código (THEORY → coupling.rs, INCIDENT →
     snippet), lo hace como string citado, no como bloque ejecutable.
     El orientador puede decir: si es código → .py/.rs/.sh; si es
     descripción de código → VSL string con path de referencia.",

    "P5. IDENTIDAD ⟦⟧ ES LEGACY, @vsm ES CANONICAL: las formas modernas
     (forms 1-5) usan `@vsm 1.0`. La identidad caligráfica `⟦⟧` subsiste
     en Governance (6) y Sessions (7) por historia, NO por necesidad.
     verify_boot_primer.py valida `@vsm`. El orientador debe: normalizar
     TODO a `@vsm 1.0`; permitir `⟦⟧` legacy solo en covenant por razones
     de autoría fundacional, no como formato nuevo.",

    "P6. ROL DE CADA FORMA ES DETERMINADO POR SU READER: la forma
     responde a quién lo lee. ENVELOPE → agente grammar-aware. SPEC →
     validador + parser. THEORY → revisor matemático. INCIDENT →
     auditor + agente. TASKS → tasks_provider.py (state-canon-mcp) +
     humano. GOVERNANCE → humano (constitucional). SESSIONS → humano
     lateral (histórico). El orientador determinista debe preguntar:
     ¿quién READS este contenido? ESO determina el formato, no la
     preferencia estética.",
  ],

  // ═════════════════════════════════════════════════════════════════════════
  // CÓDIGO DE RESPUESTA A LA PREGUNTA DE RMW3 — mapeo directo
  // ═════════════════════════════════════════════════════════════════════════

  answer_to_rmw3_question: {
    cuando_prosa:
      "ES siempre contenido dentro de un field VSL: `why: \"prosa\"`,
       `what: \"prosa\"`, `closed_evidence: \"prosa\"`. Único caso donde
       la prosa se permite libre fuera de un field es el header `//`
       narrativo de ENVELOPE/INCIDENT (sigue siendo comentario, no
       ejecutable, no parsed).",
    cuando_codigo:
      "NUNCA dentro de .vsm. Código ejecutable → .py (scripts/),
       .rs (projects/vsf-nucleus/src/), .sh (deploy). Referencia a
       código desde VSL → string con path: `files: ['src/coupling.rs']`.",
    cuando_vsl:
      "Siempre que el contenido deba sobrevivir a algún instrumento:
       symbol_table (declarations), debt_register (deuda),
       verify_boot_primer (canon), tasks_provider (estado),
       symbol_table_gates (gate), envelope parser (R15).",
    cuando_comentarios_vsl:
      "Cuando es contexto para el humano y NO debe ser leído por
       instrumentos: (a) autoría/fecha/status al inicio, (b) separadores
       visuales para secciones, (c) NOTATION blocks en theory, (d)
       racional/origen de una decisión (no la decisión misma).",
  },

  // ═════════════════════════════════════════════════════════════════════════
  // ENTREGABLES QUE [O] PUEDE CONSTRUIR SOBRE ESTA BASE
  // ═════════════════════════════════════════════════════════════════════════

  deliverable_candidates: [
    "(Da) `scripts/vsl/format_orient.py` — instrumento determinista que
     recibe un archivo y responde: ¿qué forma esperada? ¿está bien
     usado prosa/código/VSL//? ¿header canónico? Coste: bajo, la
     taxonomía está aquí.",
    "(Db) `docs/spec/format_usage_policy.vsm` — SPEC formalizando
     las reglas P1-P6 como axiomas del_policy_offset. Es el input
     que un futuro `format_orient.py` implementaría. Diseño es de [O].",
    "(Dc) `checks/format-usage-valid` — commit-time gate que aplica
     la policy. Modela existentes: vsf-agent-vsl-gate.ts + R4.1
     gate + verify_encoding.py ya son fragmentos; unificar.",
    "(Dd) Hook pre-write que avise al autor si usa (por ejemplo) prosa
     larga fuera de un field — esto es lo que vsf-agent-vsl-gate.ts
     PARCIALMENTE ya hace (>120 chars).",
  ],

  // ═════════════════════════════════════════════════════════════════════════
  // LIMITES — qué NO cubre este inventario
  // ═════════════════════════════════════════════════════════════════════════

  scope_limits: [
    "Cuenta formas maduras observables. NO cubre formatos emergentes:
     .coupling.json (coupling_manifests/), opencode.json (config),
     paper_data.vsm. Esos no son VSL puro — son JSON/JSON-ish.",
    "NO prescribe — solo cataloga. Cualquier regla nueva ('a partir
     de hoy...') es decisión de [O]+rmw3, no de DS.",
    "Cobertura: docs/ + TASKS.vsm. NO cubre: scripts/*.py (código),
     projects/* (Rust), state.db (sqlite — observado por poll, no
     VSL).",
    "Muestreo: headers + primeras 20-35 líneas por tipo de artefacto.
     NO es un análisis exhaustivo de los 493 .vsm — es una
     caracterización por tipo, no una auditorización por archivo.",
  ],

  // ═════════════════════════════════════════════════════════════════════════
  // CONEXIÓN AL CATALOG DE INSTRUMENTS
  // ═════════════════════════════════════════════════════════════════════════

  relates_to_catalog:
    "docs/incidents/2026-08-11_grammar_protocol_ontology_instruments.vsm
     cataствоthe INSTRUMENTS (quién guarda grammar/protocol/format/
     ontology). Este inventario cata el FORMAL USO de formatos en
     artefactos reales — la contracara observacional. Juntos: qué
     formatos usamos (este) y qué instrumentos los validan (catalog).",
}

