@vsm 1.0
// s1_lifecycle_coupling.spec.vsm — automatic coupling on S1 onboard / decommission.
// author: Fable [O] 2026-07-04 → DS [S] impl. Ties: beacon EVC gate + coupling_registry (DSN-COUPLE-01)
// + topology_reconcile (model≡reality) + peripheral_health + supervision_layer (signed decision).

spec(S1-LIFECYCLE-COUPLING) {

  insight:
    "The S1 lifecycle is the CONCRETE instance of the whole governance model — the single thread on which
     every piece we built operates together: the two-channel decision interface, the beacon EVC gate,
     calibrate-before-trust, signed human authority, and the model≡reality census. 'How the computer works'
     IS this lifecycle. A new S1's information couples in AUTOMATICALLY once admitted; a removed S1 uncouples
     automatically once decommissioned. The human never hand-wires data/dimensions into the framework."

  // ── ONBOARD ───────────────────────────────────────────────────────────────────
  onboard: [
    "1 CONSTRUCT   (agentic, high-variety) — an AI agent builds the S1 WITH the human: Ω, state-vector dims,
                    data routing, instruments. Never hand-coded. [Claude Code / OpenCode]",
    "2 CALIBRATE+ATTEST (EVC, deterministic) — the S1 runs pattern(instrument_calibration_loop); its gauges
                    must DISCRIMINATE (Axis-1); it emits a covenant-signed attestation of {calibration hash,
                    covenant_sha, cert}. calibrate-before-trust.",
    "3 ADMIT       (human, signed, low-variety) — rmw3 ratifies at the beacon EVC gate: a SIGNED
                    supervision_decision verified against the pinned S5 root. THE TRIGGER. (deterministic button)",
    "4 AUTO-COUPLE (automatic, deterministic) — a VALID admission fires the coupling with NO manual wiring:
                      - register in state.db + coupling_registry (DSN-COUPLE-01 manifest: audit+ops+ψ),
                      - start its peripheral/health probe (declare + probe + algedonic),
                      - add its φ↑ to the census / topology_reconcile (it enters model≡reality),
                      - wire its algedonic channel + its S2 coordination contract,
                      - surface it in the opsroom fleet view.",
  ]

  // ── DECOMMISSION ────────────────────────────────────────────────────────────────
  decommission: [
    "1 REMOVE       (human, signed) — rmw3 signs the decommission. THE TRIGGER.",
    "2 AUTO-UNCOUPLE (automatic) — deregister, stop the probe, close channels, remove from views, archive its
                     data. topology_reconcile CONFIRMS the node is gone (anti-orphan census).",
  ]

  the_division:
    "human DECIDES (admit / remove — signed, deterministic) → machine EXECUTES the coupling (automatic). The
     high-variety work (construct) terminates in a low-variety signed gate (admit) that fires a deterministic
     mechanism (couple). This is the two-channel decision model made concrete for the node lifecycle."

  guardrails: {
    couple_only_on_valid_admission: "the coupling fires ONLY on a signature that chains to the pinned S5 root;
                                      an unsigned/invalid admission couples NOTHING.",
    reconcile_is_the_check: "model≡reality census is the invariant — a node coupled-but-not-admitted, OR
                             admitted-but-not-coupled, is an ALGEDONIC anomaly (the census catches drift both ways).",
    decommission_is_symmetric: "un-coupling is as automatic + audited as coupling; no orphaned probes/channels/views.",
  }

  builds_on: "beacon_activation.spec.vsm (the admission gate) · DSN-COUPLE-01 coupling_registry (phase 4) ·
              topology_reconcile / viability_reconciliation (the census) · peripheral_health census ·
              supervision_layer.spec.vsm (the signed decision) · instrument_calibration_loop (the attestation content)."
  owner: "Fable [O] (this design) → DS [S] (the auto-couple/uncouple trigger + reconcile hooks). rmw3 (S5):
          signs admissions/decommissions. Completes DSN-COUPLE-01 phase 4, wired to the beacon EVC gate."
  status: "SPEC ready — the S1 lifecycle as the operational spine. Queued (after supervision_layer + beacon deploy)."
}
