// ═══ §2 — STAGE A DETAILED SPEC (the only stage authorized to plan execution now) ═══

stage_A_spec = {

  motivation: "Get real Wazuh alert telemetry flowing into VSF's φ↑ path with zero
    actuation risk, while producing the load-under-a-live-regulator data point that
    is the actual point of co-locating the SOC with the nucleus (node_topology.n02.
    intent: 'un sistema viable es el que sigue viable BAJO CARGA REAL'). Also
    produces the resource-sizing data the Elasticsearch co-requisite study needs."

  co_requisite: "stack.engine already flags this as NOT optional: 'Elasticsearch
    REQUIERE estudio de optimización de recurso [O/S] ANTES de escalar el stack
    (heap sizing, shards, retención, índices fríos/calientes).' Sequence: size a
    MINIMAL single-node Elasticsearch config first (small heap, short retention,
    no hot/warm tiering yet), observe its real footprint under Stage A's actual
    alert volume, THEN do the sizing study with real numbers instead of estimates."

  protocol: {
    phase_0_infra: "provision a dedicated VLAN on n02 for the SOC stack (per
      stack.location: 'Aislado en su PROPIA VLAN'). Provision the 3 Wazuh VMs
      (indexer/server/dashboard) as their OWN LXC(s) or VM(s) — do not co-locate
      inside an existing S1's container (clima=112, econ=113), consistent with
      the project's own [[feedback_new_s1_own_lxc]] rule: distinct system = own
      crash-domain. The co-location this roadmap deliberately wants is at the
      HOST level (n02 as a whole under real load), not at the container level.",
    phase_1_deploy: "install Wazuh indexer+server+dashboard with MINIMAL sizing
      (single-node ES, small heap — exact values to be set by the resource study,
      not guessed). No response/active-response modules enabled anywhere in config.",
    phase_2_wire_phi_up: "define the φ↑ contract: Wazuh alerts → nucleus telemetry.
      Concrete question to resolve before coding (not answered in this pass):
      does this reuse the existing NATS bridge pattern (token-auth,
      vsf_agent::nats::connect, per the S4-MULTI-S1 refresh_delta precedent) or a
      new ingestion path? Recommend reusing the NATS pattern for consistency —
      but flag this as a design decision for whoever specs Stage A's
      implementation, not settled here.",
    phase_3_observe: "run for a defined burn-in window (recommend >=72h, matching
      this project's general preference for real multi-day observation over
      short synthetic tests) with alert volume from real network traffic on n02's
      SOC VLAN. Capture: n02 stasis_cos/omega-margin trend, Elasticsearch actual
      RAM/CPU footprint, alert volume/rate.",
  }

  acceptance_criteria: {
    AC1_isolation: "zero φ↓ code path exists from the SOC stack back to the
      nucleus — verified by code/config review, not just 'we didn't enable it'.",
    AC2_substrate_health: "n02's stasis_cos/omega-margin during Stage A's burn-in
      window does not cross into 'critical' regime (per the Markov-projection
      classification already live) attributable to the SOC stack's load. A
      controlled A/B (SOC stack up vs down) over a comparable window would make
      this rigorous — not yet designed here, flagged as needed before Stage A is
      declared done rather than just 'running'.",
    AC3_resource_study_delivered: "the Elasticsearch resource-optimization study
      (heap/shards/retention) is written up with REAL Stage-A footprint numbers,
      not estimates — this is the actual deliverable stack.engine calls for.",
    AC4_no_new_debt: "no new algedonic pending_human entries attributable to the
      SOC stack's presence (distinguish from n02's existing baseline noise).",
  }

  infra_footprint: {
    location: "n02 host, new dedicated VLAN + new LXC/VM(s) for the 3 Wazuh
      components — NOT inside LXC 101/104/112/113.",
    network: "SOC VLAN, segmented per stack.location — exact VLAN ID/CIDR to be
      assigned at implementation time (check current VLAN usage: 10/20/30/40 per
      [[project_proxmox_vm_architecture]] before picking a new one).",
    services_new: "wazuh-indexer, wazuh-server (manager), wazuh-dashboard — 3 new
      services/units, none touching existing S1/S3/S4/S5 units.",
    services_touched: "none directly — φ↑ wiring (phase_2) adds a new NATS
      subscriber/consumer on the intelligence side, does not modify S3/S4/S5 code.",
  }

  rollback: "Stage A is read-only and additive by construction — rollback is
    stop+uninstall the 3 Wazuh services and remove the VLAN. Zero nucleus state
    is touched at any point, so there is no nucleus-side rollback procedure
    needed (unlike go_live_runbook.vsm's §3, which exists because that flip
    changes live kernel behavior — Stage A changes nothing on the kernel side).",

  monitoring_window: "mirror go_live_runbook.vsm §4's discipline once phase_2
    (φ↑ wiring) goes live: watch stasis_cos/omega-margin trend for the first
    burn-in window, watch for unexpected algedonic entries, watch Elasticsearch
    resource consumption against the sizing plan. Concrete check commands are an
    implementation-time detail (VLAN/LXC IDs don't exist yet) — not written here."
}

