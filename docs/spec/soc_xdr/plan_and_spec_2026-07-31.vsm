// ═══ §0 — GATE ASSESSMENT: is H0 "sufficiently proven"? ═══════════════════════════
//
// SOC_XDR_ROADMAP.vsm's own bar (placement.co_location_note): "H0 no es solo
// paralelo al SOC: es su PRERREQUISITO de seguridad" — the live S4 loop must be
// SUFFICIENTLY proven BEFORE the heavy SOC stack adds real load to n02, because
// H0 is the regulator that's supposed to keep n02 viable under that load.

gate_assessment = {

  literal_bar: "EXP-S4-01-STRESS passing is named as the concrete milestone for
    H0 (SOC_XDR_ROADMAP.vsm frame.not_now). The spec's own text (docs/experiments/
    EXP-S4-01-STRESS/spec.vsm) states: 'Gates: DEPLOY-S4-MULTI-S1 shadow (H0 step 2).
    No shadow until this passes.'"

  what_actually_happened: {
    stress_test: "TASKS.vsm task(EXP-S4-01-STRESS, status=done). Result field, verbatim:
      'H_STRESS_fail — H_STRESS_2 (noise) fails at sigma >= 0.05. Loop stays in harness.'
      5 of 6 hypotheses pass (load, degenerate-input fail-safe, sub-horizon honesty,
      OOD battery, precision). ONE fails: noise-rejection above sigma=0.05.",
    diagnosis: "TASKS.vsm's own diagnosis for the failure: the Python ZoneSimulator
      used in the harness has no input-noise filter; 'The Rust projector's OLS
      regression over stasis_count provides natural low-pass filtering' — i.e. the
      failure is attributed to a limitation of the TEST HARNESS, not the production
      Rust kernel. This is a plausible mitigation, but it was not independently
      re-verified against the real kernel's noise behavior — it is the harness
      author's diagnosis, carried forward here as-is.",
    production_flip: "Separately, and going FURTHER than the stress spec's own gate
      text authorized: Component A (s3_anticipation.rs) / Component B
      (vsf_cgroup_reallocate.py) were flipped straight to PRODUCTION on 2026-07-30
      (S3_ANTICIPATION_MODE=production, LXC 101) — not to 'shadow' as the stress
      spec's gate names as the next step. A supervised actuation test (calling
      actuate_order() directly, bypassing Component A's decision logic) verified
      the cgroup-write mechanism works and reverts cleanly. This is real and
      verified, but it is a manually-triggered proof of the ACTUATOR, not an
      observed instance of the full S4→S3→B loop closing autonomously on a
      genuine, unprompted signal.",
    uncalibrated: "BASIN_FLOOR (0.875, compile-time constant) was deliberately NOT
      recalibrated — the current window (storm + El Niño) is atypical data and
      recalibrating against it would bake in worst-case conditions as normal. A
      history logger (s4_l2_projection_history.jsonl) is accumulating real data for
      a proper post-storm recalibration, not yet done.",
    open_credit_question: "TASKS.vsm explicitly declined to self-credit the M0.3
      scorecard milestone for the supervised test ('not Claude's call to
      self-adjudicate that credit') — still open, rmw3's call.",
  }

  verdict: "PARTIALLY MET — asymmetric by stage, not a single yes/no:
    · Sufficient for STAGE A (SIEM read-only, §2 below): this doc's own placement
      section already pre-authorizes Stage A to run in parallel with just H1, no
      full H0 required, because Stage A adds no φ↓ actuation path — the loop this
      whole gate is protecting (S4→S3→B) is never in Stage A's causal path, so
      Stage A's risk profile does not depend on how proven H0 is.
    · NOT yet sufficient, on the evidence above, to treat H0 as fully closed for
      purposes of Stage B/C (SOAR-shadow/live) — those stages exist specifically
      to add MORE real load onto n02, leaning on H0's resource loop as the safety
      net exactly the way EXP-S4-01-STRESS's own gate intended to guard. The noise-
      sensitivity failure, the skip-straight-to-production (not shadow-first) path
      actually taken, the uncalibrated BASIN_FLOOR, and the unresolved M0.3 credit
      question are four independent reasons for caution — any one alone might be
      acceptable, four together warrant treating H0 as 'operationally live but not
      yet battle-tested' rather than 'proven'.
    Recommendation: start Stage A now (§2). Treat Stage B's go/no-go as its own
    explicit rmw3 sign-off gate, informed by real production behavior observed
    between now and then (ideally including the post-storm BASIN_FLOOR
    recalibration and at least one organic, unprompted production actuation
    event) — not decided in this document."
}

// ═══ §1 — STAGED PLAN (extends SOC_XDR_ROADMAP.vsm, invents no new architecture) ═══

staged_plan = {
  stage_A: {
    name: "SIEM read-only",
    scope: "Wazuh (indexer+server+dashboard, 3 VMs) on n02, own VLAN. φ↑ ONLY —
            alerts flow toward the nucleus's telemetry; no φ↓ actuation path exists
            at this stage, by construction (not by policy — the code path is absent).",
    gate: "H1-adjacent; does not require H0 fully proven (see §0). READY NOW.",
    detail: "fully specified in §2 below.",
  }
  stage_B: {
    name: "SOAR-shadow",
    scope: "response logic runs and LOGS what it would do (local n02 + remote n03),
            takes no real action. Exercises the decision path without the risk.",
    gate: "requires: Stage A stable for a defined observation window (not yet
          numerically defined — TODO before this stage is specced) AND rmw3's own
          explicit judgment call on H0 readiness per §0's four open items.",
    detail: "NOT specced in this document — anticipatable-now queue item for a
            future pass, per SOC_XDR_ROADMAP.vsm's spec_pipeline discipline.",
  }
  stage_C: {
    name: "SOAR-live (local)",
    scope: "real, reversible, bounded response actions on n02-local findings only
           (per response_floor: reversible+acotadas = autonomous ceiling; destructive
           stays human). This is where SOC_XDR_ROADMAP.vsm's covenant framing
           (response_floor.covenant) becomes operative code, not policy text.",
    gate: "Stage B clean for its own observation window + explicit A5 sign-off.",
    detail: "not specced.",
  }
  stage_D: {
    name: "XDR cross (n03)",
    scope: "the actual H2 crossing per SOC_XDR_ROADMAP.vsm node_topology.n03.dual(a):
           n02's SOC detects on n03 and RESPONDS (isolate, block) — action crossing
           a real network boundary with real consequences.",
    gate: "Stage C proven + n03 reachability/tooling prerequisites (not assessed here).",
    detail: "not specced — furthest out, matches roadmap's own H2→H3 framing.",
  }
  stage_E: {
    name: "fractality study + offensive integration (BBH)",
    scope: "SOC_XDR_ROADMAP.vsm's fractality (S1-in-S1 nested VSM) and
           offensive_integration (BBH-1..4) tracks — explicitly SOC-first per that
           doc's own decision 2 ('SOC-only primero → luego...').",
    gate: "SOC maturity (Stage C/D) + unchanged R6 gate on BBH.",
    detail: "not specced — out of scope for this pass; BBH-1 status itself is a
            separate open question already flagged in the roadmap's 2026-07-31
