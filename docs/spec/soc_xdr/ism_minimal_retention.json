{
  "policy": {
    "description": "SOC Stage A minimal-retention: wazuh-alerts indices kept 7 days, wazuh-archives 7 days, then rolled over/deleted (AC3 minimal footprint — no hot/warm tiering). Applied via ISM PUT _plugins/_ism/policies/soc-minimal-retention.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "7d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "wazuh-alerts-*",
          "wazuh-archives-*"
        ],
        "priority": 100
      }
    ]
  }
}
