⟦ roadmap-pure-logic | rmw3 | vsm-1.0 | 2026-05-14 ⟧

@vsm 1.0
// PURE IF/THEN LOGIC ROADMAP — NO TEMPORAL ESTIMATES
// domain_context: {target=vsf+attractor_convergence+vos, layer=S4-S5}
// rule: ONLY dependencies (blockers/unblocks), zero time predictions

// ═════════════════════════════════════════════════════════════════════════════════════
// PHASES DEFINED BY LOGICAL GATES (not time)
// ═════════════════════════════════════════════════════════════════════════════════════

PHASE_0_BASELINE = {
  name: "Current State",
  status: "active",
  condition: "NOW (2026-05-14)",

  state: {
    paper_v1_0: "✓ DONE (content locked, not released)",
    vsl_math_01: "✓ DONE (5 gates verified: Ω, L, σ_max, separabilidad, teorema)",
    vos_kernel: "SPEC COMPLETE, code not started",
    open_tasks: 16,
    critical_blockers: "NONE (3 independent kickoff tasks ready)",
  }
}

// ═════════════════════════════════════════════════════════════════════════════════════
// PHASE 1 — THREE INDEPENDENT TRACKS
// ═════════════════════════════════════════════════════════════════════════════════════

PHASE_1 = {
  name: "Parallel Tracks: Paper + Kernel + Theory",
  condition: "IF rmw3_approves(parallel_strategy)",

  TRACK_A_paper = {
    name: "Paper to Prof. Fierro",
    start_gate: "task(V) READY? YES (no blocker)",

    gates: {
      A1_enmiendas: {
        gate: "task(V) V1-V6 done",
        blocker: "none",
        unblocks: ["A2_send"]
      }

      A2_send: {
        gate: "send RESPUESTA + main.pdf v1.0 to Prof. Fierro",
        blocker: "A1 ✓",
        unblocks: ["experiments_spawn"]
      }

      experiments_spawn: {
        gate: "IF A2_send ✓ THEN spawn experiments",
        prereq: "A2_send ✓",
        actions: {
          exp_ly_01: "spawn EXP-LY-01 (blocker: none, can run parallel with JAC)",
          exp_jac_01: "spawn EXP-JAC-01 (blocker: none, can run parallel with LY)",
          nc_blocked: "EXP-NC-01/02/03 blocked until [LY + JAC data ready]"
        }
      }

      exp_data_ready: {
        gate: "IF [EXP-LY-01 ∧ EXP-JAC-01] DONE",
        then: {
          nc_unblock: "EXP-NC-01 ∧ EXP-NC-02 ∧ EXP-NC-03 NOW unblocked",
          graphics: "Start graphics rendering (blocker: all exp data)"
        }
      }

      v1_5_integration: {
        gate: "IF [all experiments ∧ graphics ∧ Fierro feedback (if available)]",
        blocker: "experiments ∧ graphics",
        action: "Write §4 + integrate data + apply enmiendas → main.pdf v1.5",
        unblocks: ["fierro_verdict"]
      }

      fierro_verdict: {
        gate: "WAIT: Prof. Fierro evaluates main.pdf v1.5",
        prereq: "v1_5_integration ✓",
        outcomes: {
          outcome_A: "Fierro: 'v2.0 ready' → PHASE_4",
          outcome_B: "Fierro: 'refinamientos needed' → ITERACION_03"
        }
      }
    }
  }

  TRACK_B_kernel = {
    name: "vOS Stage 1 Kernel",
    start_gate: "F5.x.1 READY? YES (no blocker)",

    gates: {
      B1_operator: {
        gate: "task(F5.x.1) operator.rs DONE",
        blocker: "none",
        unblocks: ["B2_lyapunov", "B4_validator"]
      }

      B2_lyapunov: {
        gate: "task(F5.x.2) lyapunov.rs DONE",
        blocker: "B1 ✓",
        unblocks: ["stage_1_baseline"]
      }

      B3_clock: {
        gate: "task(F5.x.3) adaptive_clock.rs DONE",
        blocker: "none (can run parallel with B1)",
        unblocks: ["stage_1_baseline"]
      }

      B4_validator: {
        gate: "task(F5.x.4) omega_validator.rs DONE",
        blocker: "B1 ✓",
        unblocks: ["stage_1_baseline"]
      }

      B5_remaining: {
        gate: "task(F5.x.5) TDA + task(F5.x.6-9) others",
        blocker: "F5.x.5 blocked by EXP-TDA-01",
        note: "F5.x.6-9 have independent blockers, can start in parallel"
      }

      stage_1_baseline: {
        gate: "IF [B1 ∧ B2 ∧ B3 ∧ B4] ∧ THEORY-COMP ✓",
        then: "vOS Stage 1 baseline ready"
      }
    }
  }

  TRACK_C_support = {
    name: "Theory + Security + Protocols",
    start_gate: "THEORY-COMP READY? YES (no blocker)",

    gates: {
      C1_theory_comp: {
        gate: "task(THEORY-COMP) composition proofs DONE",
        blocker: "none",
        unblocks: ["C2_covenant"]
      }

      C2_covenant: {
        gate: "task(COVENANT-V04) update DONE",
        blocker: "C1 ✓",
        unblocks: ["axioms_locked"]
      }

      C3_psi: {
        gate: "task(O) PSI protocol DONE",
        blocker: "F5.x.6 ✓ (coupling.rs)",
        unblocks: ["vendor_neutral_standard"]
      }

      C4_security_Y: {
        gate: "task(Y) cargo --locked DONE",
        blocker: "none",
        unblocks: ["C5_security_Z"]
      }

      C5_security_Z: {
        gate: "task(Z) pre-deploy checklist DONE",
        blocker: "C4 ✓",
        unblocks: ["SEC_gates_ready"]
      }

      C6_qwen: {
        gate: "task(S) Qwen VSL compilation DONE",
        blocker: "task(T) ✓ (parser already done)",
        unblocks: ["task(U) VSL v2.0"]
      }
    }
  }

  PHASE_1_complete = {
    condition: "IF [TRACK_A reached experiments ∨ sent_to_fierro]",
    AND: "[TRACK_B reached stage_1_baseline]",
    AND: "[TRACK_C reached security_Z ∧ theory_comp]",
    THEN: "proceed to next phase"
  }
}

// ═════════════════════════════════════════════════════════════════════════════════════
// PHASE 1.5 — CONDITIONAL WAIT (parallel with Phase 1 continued work)
// ═════════════════════════════════════════════════════════════════════════════════════

PHASE_1_5 = {
  name: "Experimental Validation + Fierro Feedback",
  condition: "IF TRACK_A reached [experiments_spawn]",
  parallel_work: "TRACK_B kernel continues unblocked",

  gates: {
    exp_ly_01: {
      status: "running (spawned from TRACK_A experiments_spawn)",
      blocker: "A2_send ✓",
      unblocks: ["exp_nc"]
    }

    exp_jac_01: {
      status: "running parallel with exp_ly_01",
      blocker: "A2_send ✓",
      unblocks: ["exp_nc"]
    }

    exp_nc: {
      gate: "IF [exp_ly_01 ∧ exp_jac_01] data ready",
      then: "spawn EXP-NC-01 ∧ EXP-NC-02 ∧ EXP-NC-03",
      unblocks: ["graphics_production"]
    }

    graphics_production: {
      gate: "IF all experiments data ✓",
      action: "render 22 artefactos (14 new + 8 revision)",
      unblocks: ["TRACK_A v1_5_integration"]
    }

    fierro_feedback: {
      status: "WAIT (external, not controlled)",
      condition: "while main.pdf v1.5 under review",
      parallel_work: "TRACK_B continues without blocking"
    }
  }
}

// ═════════════════════════════════════════════════════════════════════════════════════
// PHASE 2 — INTEGRATION (triggered when experiments ready)
// ═════════════════════════════════════════════════════════════════════════════════════

PHASE_2 = {
  name: "ITERACION_02 Integration + Kernel Completion",
  condition: "IF [experiments_data_ready ∨ Fierro_feedback_arrived]",

  gates: {
    exp_integration: {
      gate: "IF experiments_data ∧ graphics ✓",
      action: "Write §4 (Ω, L, σ_max, theorems, validation)",
      blocker: "graphics ✓"
    }

    feedback_integration: {
      gate: "IF Fierro feedback available",
      action: "Apply corrections to appropriate sections",
      blocker: "depends on Fierro response timing"
    }

    enmiendas_v1_to_v6: {
      gate: "Apply V1-V6 calibration enmiendas",
      blocker: "none (can run parallel with above)",
      actions: [
        "D_KY → effective_dims",
        "stasis_cos as proxy formulation",
        "alignment as hypothesis",
        "Limitations §11",
        "figure captions 'ilustrativo'",
        "covenant to §12"
      ]
    }

    v1_5_compile: {
      gate: "IF [§4 written ∧ feedback applied ∧ enmiendas applied ∧ graphics ready]",
      action: "Compile main.pdf v1.5",
      blocker: "all above ✓"
    }

    kernel_completion: {
      gate: "Complete vOS Stage 1 remaining modules (F5.x.5-9)",
      parallel_with: "paper integration (no dependency)",
      blocker: "F5.x.5 blocked by EXP-TDA-01, others independent"
    }

    stage_1_final: {
      gate: "IF [all kernel modules F5.x.1-9 ∧ THEORY-COMP ∧ COVENANT-V04]",
      then: "vOS Stage 1 COMPLETE ✓"
    }
  }

  PHASE_2_complete = {
    condition: "IF [v1_5_compile ✓ ∧ stage_1_final ✓]",
    state: {
      paper: "main.pdf v1.5 ready for Prof. Fierro second review",
      kernel: "vOS Stage 1 complete",
      framework: "VSF v1.0 feature-locked"
    }
  }
}

// ═════════════════════════════════════════════════════════════════════════════════════
// PHASE 3 — DECISION GATE (Prof. Fierro Verdict)
// ═════════════════════════════════════════════════════════════════════════════════════

PHASE_3 = {
  name: "Prof. Fierro Evaluation (Second Round)",
  condition: "IF main.pdf v1.5 ∧ Qwen validation PASS",

  gates: {
    send_v1_5: {
      action: "Send main.pdf v1.5 + summaries EN/ES to Prof. Fierro",
      blocker: "v1_5_compile ✓"
    }

    wait_verdict: {
      gate: "WAIT: Prof. Fierro evaluates v1.5",
      state: "external evaluation (not controlled by rmw3)",
      parallel_work: "vOS Stage 2 design can start"
    }

    outcome_decision: {
      gate: "IF Prof. Fierro returns verdict",
      outcomes: {
        outcome_A: {
          verdict: "v2.0 ready for release",
          then: "PHASE_4 (final release)"
        }

        outcome_B: {
          verdict: "refinamientos requeridos",
          then: "ITERACION_03 (targeted refinements loop)"
        }
      }
    }
  }

  ITERACION_03_conditional = {
    name: "Conditional Loop: Refinements",
    condition: "IF outcome_B",
    loop: {
      analyze_feedback: "Identify specific refinements needed",
      implement: "Targeted changes (typically faster than ITERACION_02)",
      recompile: "main.pdf ITERACION_03-v1",
      resubmit: "Send to Prof. Fierro",
      wait_again: "Await second verdict (outcome_A ∨ outcome_B_2)"
    }
  }
}

// ═════════════════════════════════════════════════════════════════════════════════════
// PHASE 4 — PAPER v2.0 FINAL RELEASE
// ═════════════════════════════════════════════════════════════════════════════════════

PHASE_4 = {
  name: "Paper v2.0 Final Release",
  condition: "IF [PHASE_3 outcome_A]",

  gates: {
    compile_v2_0: {
      action: "Finalize main.pdf v2.0 (Prof. Fierro approved)",
      blocker: "outcome_A ✓"
    }

    summaries_v2_0: {
      action: "Update executive summaries EN/ES for v2.0",
      blocker: "compile_v2_0 ✓"
    }

    distribution: {
      action: "Distribute to Beer community (Metaphorum, SCiO, UV)",
      blocker: "summaries ✓",
      channels: [
        "email Prof. Fierro + contacts",
        "GitHub releases (tag v2.0)",
        "preprint server (if desired)",
        "kernel announcement with paper"
      ]
    }

    kernel_integration_decision: {
      condition: "Ship kernel with paper or separately?",
      option_integrated: "include kernel results in paper appendix",
      option_separate: "kernel as independent open-source project",
      note: "decision needed before distribution"
    }
  }

  PHASE_4_complete = {
    condition: "IF distribution ✓",
    result: {
      paper: "v2.0 published + distributed",
      kernel: "vOS Stage 1 released (GitHub tag + docs)",
      framework: "VSF v1.0 stable",
      community: "paper + kernel available to Beer community"
    }
  }
}

// ═════════════════════════════════════════════════════════════════════════════════════
// PHASE 5 — vOS STAGE 2 + VSF v2.0
// ═════════════════════════════════════════════════════════════════════════════════════

PHASE_5 = {
  name: "vOS Stage 2 Intelligence",
  condition: "IF [vOS Stage 1 ✓ ∧ paper v2.0 released]",

  gates: {
    qwen_vsl: {
      gate: "task(S) Qwen VSL compilation DONE",
      blocker: "task(T) ✓ (parser ready from PHASE 1)",
      unblocks: ["task(U)"]
    }

    vsl_interpreter: {
      gate: "task(U) VSL v2.0 interpreter DONE",
      blocker: "task(S) ✓",
      unblocks: ["task(X)"]
    }

    indexing: {
      gate: "task(X) vsf-indexer semantic search DONE",
      blocker: "task(U) ✓",
      unblocks: ["self_query"]
    }

    phi_02: {
      gate: "EXP-PHI-02 fidelity testing (computed vs interpreted)",
      blocker: "task(T) ✓ (parser ready)",
      output: "empirical capability matrix for Paper 2 §3"
    }

    stage_2_operational: {
      condition: "IF [qwen_vsl ∧ vsl_interpreter ∧ indexing]",
      then: "Qwen S4 autonomous (can read/execute/report specs without Claude intermediary)"
    }
  }

  target_outcomes = {
    framework: "VSF v2.0 machine-readable + VSL v1.0 stable",
    kernel: "vOS Stage 1 running on n02 + GitHub",
    intelligence: "Qwen S4 operationally autonomous",
    ecosystem: "self-aware viable system foundation ready"
  }
}

// ═════════════════════════════════════════════════════════════════════════════════════
// CRITICAL DEPENDENCY GRAPH (pure IF/THEN, no durations)
// ═════════════════════════════════════════════════════════════════════════════════════

critical_gates = [
  "task(V) ∅ → gate_A1 ✓",
  "gate_A1 ✓ → experiments_spawn ✓",
  "EXP-LY-01 ∧ EXP-JAC-01 ✓ → EXP-NC-01/02/03 ✓",
  "all_experiments ✓ → graphics ✓",
  "graphics ✓ → main.pdf v1.5 ✓",
  "main.pdf v1.5 ✓ → fierro_verdict",

  "F5.x.1 ∅ → F5.x.2 ✓",
  "F5.x.1 ✓ → F5.x.4 ✓",
  "[F5.x.1 ∧ F5.x.2 ∧ F5.x.3 ∧ F5.x.4] ∧ THEORY-COMP ✓ → stage_1_baseline ✓",

  "THEORY-COMP ∅ → COVENANT-V04 ✓",
  "task(Y) ∅ → task(Z) ✓",
  "task(T) ✓ → task(S) → task(U) → task(X)",
]

// ═════════════════════════════════════════════════════════════════════════════════════
// USER DECISION POINTS
// ═════════════════════════════════════════════════════════════════════════════════════

user_gates = {
  gate_phase_1_approval: {
    question: "Proceed with PHASE 1 parallel tracks?",
    blocking: false,
    impact: "If NO → alternative prioritization needed (specify which)"
  }

  gate_kernel_v_integration: {
    question: "Ship kernel with paper (Appendix) or separately?",
    timing: "Must decide before PHASE 4 distribution",
    options: {
      integrated: "add 3-5pp to paper v2.0, shows methodology",
      separate: "independent GitHub release, cleaner scope"
    }
  }

  gate_vos_stage_2_start: {
    question: "When to start vOS Stage 2 (Qwen S4)?",
