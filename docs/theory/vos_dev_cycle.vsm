@vsm 1.0

// STATUS: historical_record — consumido por fuse fuente THEORY-01 (vos_core_theory.vsm:9); contenido canonical en vos_core_theory.vsm · archivo 2026-08-15
// (THEORY-FUSE-REMAINDER censo; contenido en el target canonical, este doc es fuente histórica.)
// domain_context: {target=vos-dev, env=VSF-session, layer=S4}
// VSL es el invariante que sobrevive el reset. Formalizar ANTES de comprimir.


// ─── CICLO DE DESARROLLO vOS ─────────────────────────────────────────────────

dev_cycle(vOS) {

  phase(1): spec {
    input:   ideas + reflexión + revisión por par
    output:  VSL formal (.vsm)
    channel: VSL  // contrato — no código, no prosa; si no está en VSL no existe
  }

  phase(2): implementation {
    input:  VSL spec
    output: Rust código
    rule:   VSL → Rust  // dirección única — Rust no modifica VSL
  }

  phase(3): stress_test {
    input: Rust binario compilado
    ops:   compile(cargo build --release) | run(spec_boot) | stress(A_breath λ_max)
    exit:  crash → phase(1) | survive → medir(H_KS, D_KY, viable_full)
    output: telemetría + PASS | FAIL
  }

  phase(4): learning_cycle {
    peer_review {
      send:    stress_test result en VSL
      receive: observaciones del par en VSL
      merge:   correcciones → actualizar spec
    }
    // par devuelve formato degradado → extraer idea, re-formalizar antes de integrar
  }

  phase(5): formalization {
    trigger: session_tokens > τ_compression ∨ nueva_idea_importante ∨ ciclo_completado
    ops:     formalize(.vsm) | git_commit | update(memory/*.md)
    invariant: lo que no se formaliza antes del reset → se pierde
  }

  phase(6): memory_reset {
    ops:  clean(nueva sesión) | reload(HANDOFF + TASKS + memory/*.md)
    test: spec autocontenido sin contexto anterior? si no → phase(5) rewrite
  }

  phase(7): verify {
    ops:  run(spec_boot) | check(viable_full=true) | compare(resultado vs spec)
    convergence: resultado == spec_expectation → next_cycle
    divergence:  resultado ≠ spec_expectation  → phase(1)
  }

  repeat: ∞
}


// ─── ANTI-PATRONES (delirio) ──────────────────────────────────────────────────

delirium_patterns {
  D1: "está bien en teoría"     // si no compila y corre, no está bien
  D2: conexiones sin traza .vsm/.rs  // síntoma de sesión larga sin reset
  D3: formalización retroactiva      // el pasado no commitado no existe
  D4: spec no sobrevive el reset     // el .vsm está mal, no el agente
  D5: LaTeX mezclado con VSL         // Gemini pattern → re-formalizar antes de integrar
  detection: sesión > 2h sin commit → riesgo de delirio
  cure:       phase(5) → phase(6)
}


// ─── ROLES ────────────────────────────────────────────────────────────────────

roles {
  rmw3   @S5          { owns: dirección, aprobación double-loop, qué formalizar, cuándo resetear }
  claude @S4_session  { owns: VSL, Rust, stress_test  | limit: sesión efímera → todo en .vsm }
  gemini @S4_peer     { owns: peer review, validación cruzada | limit: canal degradado → re-formalizar }
  sci-01 @S4_permanent { owns: ciclo autónomo n02 cuando activo }
  VSL    @canal       { invariant: sobrevive todos los resets | lo que no está en VSL no participa }
}


// ─── PATRONES DE CONTINUIDAD DE INVESTIGACIÓN ────────────────────────────────

research_continuity {

  pattern(experiment_spec) {
    trigger:  experimento nuevo ∨ re-run
    location: docs/experiments/<nombre>/spec.vsm
    required_sections: [
      motivation, hypotheses(H1..Hn),
      protocol(fases, parámetros, stop_conditions),
      impl { file, function, pseudocode, estimated_lines },
      expected_output, analysis, timing(impl:Nh + run:Nm),
    ]
    antipatterns: [sin pseudocode, sin expected_output, sin timing]
  }

  pattern(paper_skeleton) {
    trigger:  paper nuevo ∨ datos de experimentos disponibles
    location: docs/papers/<nombre>/
    files_required: [paper_data.vsm, main.tex(compilable), references.bib]
    paper_data_vsm_sections: [hardware, per-experiment, cross-experiment, new_refs]
    main_tex_rules: [
      compila sin errores antes de commit,
      secciones con % TODO: instrucción exacta (palabras + argumento + cita),
      tablas pobladas, ecuaciones escritas,
      abstract: último,
    ]
    invariant: "abrir main.tex = saber exactamente qué escribir en cada párrafo"
  }

  pattern(queue_vsm) {
    trigger:  fin de sesión con trabajo pendiente
    location: docs/experiments/queue.vsm
    required_sections: [
      status_legend(READY/IMPL/BLOCKED/DONE),
      queue(orden + tiempo estimado),
      per-experiment(status, blocks, spec, impl_summary),
      done(historial + resultado clave),
    ]
    invariant: "leer queue.vsm = saber qué hacer primero"
  }

  pattern(model_reality_reconciliation) {
    // S3*/S4 audit-and-reconcile loop for the model≡reality invariant.
    // Trigger: experimental result contradicts theoretical prediction,
    //          OR two code paths produce inconsistent outcomes for the same claim.
    trigger:  resultado_empírico ≠ predicción_teórica ∨
              dos_rutas_de_código producen resultados_inconsistentes para la misma_afirmación
    location: docs/experiments/<exp-anomalía>/results.vsm → causa raíz
    phases: [
      "P1  observe:        anomalía en output del experimento diverge de predicción teórica",
      "P2  cross-reference: localizar la contra-evidencia canónica (exp previo o teorema)",
      "P3  localise:       identificar causa estructural (ley divergente, parámetro, ruta de código)",
      "P4  decide canonical: aplicar criterio de viability-equivalence (R, μ*, Ω_A compartidos);
                            elegir la ley/ruta validada en el paper Y que corre en producción",
      "P5  port + re-certify: cambio mínimo; correr regression guard sobre resultado ancla del paper",
      "P6  frame:          cerrar en el paper como principio ('robustez bajo equivalencia de leyes'),
                            no como incidente ('había un bug')",
    ]
    viability_equivalence_criterion:
      "dos leyes dinámicas son viability-equivalent sii comparten
       recurrent set R, stationary measure μ*, y contractive core Ω_A.
       La ubicación exacta del atractor dentro de Ω_A puede diferir;
       V > 0 es invariante bajo la equivalencia."
    gate:   "P6 debe preceder cualquier commit al paper que toque la afirmación reconciliada"
    roles:  { S3_star: "P1-P3 (detectar + localizar)", S4: "P4 (decisión canónica)",
               S5:     "P6 (aprobación del framing)" }
    example:
      "ARC 1 (2026-06-16e): reconciliación de la trust law — law A (cos-driven + soplo)
       canonicalizada; law B (phase-driven) retirada de los loops de producción.
       §sec:trustlaw en main.tex es el worked example de este patrón.
       Ejemplo de P3: dos bucles (run_core_calibration vs run_s1_kernel_loop) compartían Ω_A
       pero divergían en comportamiento off-basin; la divergencia fue observable sólo a largo
       plazo / regímenes pure-compute. La anomalía fue EXP-L1-01 trust drain."
    invariant:
      "una grieta model≡reality nunca se publica;
       se localiza, resuelve y re-certifica ANTES de cerrar la afirmación que toca"
  }

  pattern(longitudinal_cyberfilter_census) {
    // Extraer la firma de viabilidad de DATOS QUE YA EXISTEN en operación (el ledger
    // algedónico + la cadena φ↑), sin instrumentación nueva. Doble propósito: mide la
    // viabilidad (resultado de paper) Y la mejora (backlog). Origen: 2026-07-02 (rmw3+Fable).
    trigger:  "caracterizar la viabilidad de un dominio VSF tras N días de operación, O
               fundamentar un claim de cierre operacional en un paper (P1 §12), O drenar
               la cola algedónica de forma no-ciega"
    tool:     scripts/analysis/cyberfilter_census.py   // determinista, stdlib, reproducible
    input:    { ledger: "algedonic_ledger (state.db o mirror 104)",
                state:  "events.jsonl (φ↑ del núcleo)" }
    two_axes: {
      A_filter_calibration:   // Ashby / Cyberfilter de Beer
        "cómo el S3* discrimina la variedad: attenuation (fracción auto-resuelta con razón
         machine-checkable = clases conocidas que el filtro absorbe), frontier (tipos que sólo
         ESCALAN, 0 auto = variedad NO modelada → cada uno es una tarea-handler), evidence
         (fracción cerrada con evidencia verificable = transición R12 narrativo→evidencia).",
      B_loop_closure:         // Lyapunov / atractor
        "por run (un restart resetea tick→1 = la perturbación canónica), la trayectoria de
         recuperación al atractor: time-to-attractor (trust,stasis_cos ≥ θ) + mean_l ↓ (contracción)."
    }
    falsifiable_frame:        // fundar el experimento EN el paper, no confirmarlo después
      "null = las detecciones del S3* NO rastrean excursiones reales (ruido) ∧/∨ las excursiones
       detectadas NO retornan al atractor. El census lo puede tumbar; si no, se reporta honesto."
    honesty_guardrails: [
      "NO enmarcar el conteo de alertas como eficacia — parte de la frontera son puntos ciegos
       del PROPIO tooling (p.ej. emit_count probe-scope). Una auditoría que caza sus propios
       bugs es buena, pero la corrección es HUMANA (doble-loop A5), no auto-sanación.",
      "distinguir divergencia real (sensor) de artefacto de instrumentación en el writeup",
      "el filtro es determinista + expansión-de-variedad-humana-en-loop, NO un clasificador que aprende solo",
    ]
    double_payoff: {
      single_loop: "produce el resultado de paper (P1 §12 cierre operacional longitudinal + forward-ref a P_phi desde semantic_divergence)",
      double_loop: "cada tipo-frontera → tarea-handler del filtro; cada perturbación no-recuperada → deuda de viabilidad",
    }
    roles:  { S3_star: "genera el ledger (Eje A) + la cadena (Eje B)",
              analyst:  "corre el census, computa la firma",
              S5:       "aprueba el framing antes de tocar el paper (gate del hold)" }
    gate:   "el framing falsable + los guardrails de honestidad preceden cualquier commit al paper"
    example:
      "2026-07-02, ~6 días / 408 findings: Eje A = 76% atenuación (111 merkle bootstrap, 112
       cycle_summary, 86 semantic<tol), 19% escalación, frontera load=52 (emit_count probe-bug +
       env_temp sensor-gap + novel), evidence 4% (R12 recién). Eje B = run post-restart recupera
       al atractor en ttr=15 ticks con mean_l ↓ (0.15081→0.14982). Hipótesis PINTA en ambos ejes."
    invariant:
      "el census mide Y mejora en la misma pasada; la frontera de hoy es el backlog de mañana,
       y su cierre es la variedad que el filtro absorbe en el próximo ciclo"
  }

  pattern(recursive_viability_forecaster) {
    // The Markov projection (paper §sec:markov) is a DOMAIN-AGNOSTIC S-function: any S1 at any recursion
    // level has a stasis_cos (the universal viability signal), so the SAME forecaster plugs into any of
    // them. Origin: rmw3 2026-07-03 — "forecast with our own tools; the math should replicate for any S1
    // at any recursion level." Worked instance: S1-Clima L3 stations (MARKOV-PROJECTION-INERT).
    thesis:
      "stasis_cos is the UNIVERSAL viability signal — every viable subsystem computes it (its state vs its
       Ω centroid). So viability FORECASTING is domain-agnostic: bin stasis_cos into K states, train a
       transition matrix T from the subsystem's OWN history, project T^n·e_current → P(state at t+n).
       Domain-specific = only the SENSING (what feeds the state vector); the forecaster is shared."
    two_layers: {
      sensing:    "domain-specific, the S1's own kernel: state vector → stasis_cos vs Ω. NOT the forecaster.",
      forecaster: "domain-AGNOSTIC, reused verbatim: stasis_cos history → K-bin Laplace-smoothed transition
                   matrix → T^n projection → excursion probability + regime. = paper §sec:markov machinery.",
    }
    recursion:
      "because any S1 can be a full VSM (Beer) and every level emits stasis_cos, the forecaster NESTS: an L3
       station forecasts its own viability; an L2 zone the aggregate; an L0 domain the whole. Same code,
       different φ↑ subject. The recursive VSM made predictive."
    our_own_tools:
      "the projection uses OUR math (§sec:markov / Perron-Frobenius) on OUR signal (the S1's live stasis_cos
       from its own kernel). External data enters ONLY at historical calibration (the prior); the live
       forecast is fully internal. Never re-fetch external state to forecast — read the S1's φ↑."
    worked_instance:
      "S1-Clima: kernel_r32.py computes each L3 station's live stasis_cos vs its Ω centroid; markov_train.py
       built the per-zone transition matrices from ERA5. The gap (MARKOV-PROJECTION-INERT) is ONLY that
       markov_project reads missing snapshots instead of the live φ↑ — a WIRING fix (forecaster_live_state.spec.vsm).
       Once wired, the SAME forecaster serves econ, the nucleus, and BBH when they arrive."
    reuse_target:
      "extract markov_train + markov_project into a domain-agnostic module parameterised by (φ↑ subject, Ω
       source, K bins). Each S1 supplies the three; the projection is shared. Future [O]→[S] task."
    data_provenance:
      "external HISTORY may train/calibrate the model (e.g. the ERA5 baseline for the clima Ω); the OUTPUT must
       be computed by OUR model (the Markov projection over our OWN stasis_cos), NEVER fetched from an external
       forecast API. Provenance matters at the OUTPUT boundary, not the training boundary — that is what makes it
       a system that anticipates, not a relay. Applies to any predictor. [[feedback-data-provenance-boundary]]"
    paper_bridge:
      "operationalises §sec:markov (transition kernel, stationary μ*, T^n) as a live, recursive forecaster —
       a candidate for the paper's anticipation/RETURN thread (S4 projection)."
  }

  pattern(instrument_calibration_loop) {
    // Agnostic, node-by-node verification that a viability instrument CARRIES INFORMATION about the
    // state. The same program runs on the nucleus now and on any S1 at onboarding. Origin: rmw3 +
    // Fable 2026-07-03 (persistent-gap analysis → calibration is prerequisite for autonomy).
    // Full strategy: docs/plan/calibration_autonomy_strategy.vsm.
    trigger: "before closing any autonomous S3/S4/S5 loop on an instrument; at any S1 onboarding
              (calibrate-before-trust); periodically as a viability audit."
    criterion:
      "an instrument is CALIBRATED iff (1) a healthy/typical state reads HEALTHY, and (2) it
       DISCRIMINATES — distinct states → distinct readings (output entropy > 0, Shannon). A broken
       instrument reads the same regardless of state (pinned/saturated/degenerate) or reads normal as anomalous."
    loop: [
      "P1 enumerate the node's instruments (state-vector-derived signals)",
      "P2 exercise across the state range (healthy→perturbed→severe) with real/known inputs, end-to-end",
      "P3 discriminate? does output vary with state AND does typical read healthy? if no → mis-calibrated",
      "P4 recalibrate the metric (healthy→healthy + discriminates)",
      "P5 verify by re-exercising; then next node",
    ]
    the_tell: "mis-calibration = the same reading across states that should differ, OR normal-reads-anomalous."
    reuse:    "agnostic (tests information content, not domain) → identical program for nucleus + any S1;
               plugs into the EVC (embedded viability certifier) as the calibrate-before-trust gate."
    worked_examples: [
      "margin (OMEGA-MARGIN-DIAG): pinned 0.0 → danger-face margin → discriminates.",
      "forecaster (2026-07-03): all zones 70-90% excursion → percentile bins → typical→bin4, P(exc) discriminates. VERIFIED live.",
    ]
    invariant: "never close an autonomous loop on an instrument that has not passed P3. Calibration precedes autonomy."
  }
}


// ─── PROTOCOLO DE CIERRE DE SESIÓN ────────────────────────────────────────────

session_end_protocol {
  checklist = [
    "[ ] git commit — todos los cambios de código",
    "[ ] HANDOFF.vsm.md — session() del día + resultados",
    "[ ] memory/*.md — hallazgos no-derivables del código",
    "[ ] learning scan — bash scripts/state/session_learning_scan.sh pass;
          aprendizajes de la sesión persistidos como IR
          (docs/spec_revision/learning_records/) o deferral explícito
          (trace.deferral.deferred: true); resultado registrado en el
          session block (campo learning:) — LEARNING-SCAN-IN-SESSION-CLOSE
          2026-08-16: el cierre documenta tasks/session, pero el ciclo de
          aprendizaje exige que el scan corra y su resultado quede escrito",
    "[ ] docs/experiments/queue.vsm — si hay experimentos pendientes",
    "[ ] main.tex skeleton compilable — si hay paper en progreso",
    "[ ] paper_data.vsm completo — si hay paper en progreso",
    "[ ] docs/glossary.vsm — si apareció término nuevo",
    "[ ] tasks_validate.py TASKS.vsm + gen_index.py --check → 0 drift/0 invalid (VSL standardization v1.5, 2026-07-16)",
  ]
  test_de_reset: "agente fresco abre HANDOFF.vsm.md → sabe qué hacer, tiene todos los números"
  invariant:     "lo que no está en .vsm + .md + git no existirá la próxima sesión"
}

