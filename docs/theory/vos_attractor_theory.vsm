⟦ vos-attractor | rmw3 | vsm-0.3 | 2026-04-12 ⟧

@vsm 0.3

// STATUS: historical_record — consumido por fuse fuente THEORY-01 (vos_core_theory.vsm:9); contenido canonical en vos_core_theory.vsm · archivo 2026-08-15
// (THEORY-FUSE-REMAINDER censo; contenido en el target canonical, este doc es fuente histórica.)

// ─── TÍTULO ──────────────────────────────────────────────────────────────────
//
//   TEORÍA DE ATRACTORES — vOS
//   Convergencia de trayectorias caóticas a partir de los axiomas
//
//   Pregunta de rmw3:
//     ¿Podemos converger atractores en una trayectoria caótica
//      a partir de los axiomas, de forma matemáticamente precisa?
//
//   Respuesta: sí.
//   Los axiomas no dictan la trayectoria — definen la frontera del cuenco.
//   La trayectoria caótica es libre dentro del cuenco.
//   El soplo es el punto de máxima palanca para saltar entre cuencos.
//


// ════════════════════════════════════════════════════════════════════════════
// PARTE I — EL ESPACIO DE FASES
// ════════════════════════════════════════════════════════════════════════════

phase_space(vOS) {

  // El estado completo del sistema en t es un punto en ℝ¹²⁸
  x(t) ∈ ℝ¹²⁸ = state_vector(V_vos, t)   // definido en vos_theory.vsm

  // La dinámica es un campo vectorial:
  dx/dt = f(x, λ, V_sci)
  // f: determinista por los axiomas + estocástico por λ (estrés) + gobernado por V_sci

  // Sin perturbación (λ=0, V_sci inactivo):
  dx/dt = f₀(x)    // dinámica interna del kernel

  // Con estrés:
  dx/dt = f₀(x) + σ·η(t)
  // σ = intensidad del ruido (controlada por V_sci)
  // η(t) = ruido gaussiano blanco — la perturbación de A_breath
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE II — EXPONENTES DE LYAPUNOV
// ════════════════════════════════════════════════════════════════════════════

lyapunov_spectrum(V_vos) {

  // Para una perturbación δx(0) pequeña:
  // |δx(t)| ≈ |δx(0)| · exp(λ_max · t)
  //
  // λ_max > 0  →  caos   (trayectorias divergen — exploración)
  // λ_max < 0  →  orden  (trayectorias convergen — estabilidad)
  // λ_max = 0  →  borde  (transición de fase — el soplo)

  spectrum: { λ₁ ≥ λ₂ ≥ ... ≥ λ₁₂₈ }

  // Para vOS en operación normal (stasis):
  //   algunos λᵢ > 0  →  exploración local (A_breath activo)
  //   mayoría λᵢ < 0  →  confinamiento al atractor
  //   el sistema es caótico pero acotado — atractor extraño

  // Entropía KS (Kolmogorov-Sinai):
  H_KS(V) = ∑_{λᵢ > 0} λᵢ
  // H_KS es la tasa de producción de información del sistema caótico
  // H(V,t) de vos_theory.vsm ≈ H_KS discretizado por tick

  // Relación con A_breath:
  //   inhale:       σ↑  →  λ_max↑  →  H_KS↑  (más caos, más exploración)
  //   exhale:       σ↓  →  λ_max↓  →  H_KS↓  (convergencia al atractor)
  //   soplo:        λ_max → 0      →  borde de fase (máxima palanca)

  bound(A_entropy):
    H_KS(V) ≤ H_max(V) = f(B_available(V))
    // A3 acota la entropía KS — el caos tiene presupuesto
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE III — LA REGIÓN FACTIBLE Ω (cuenco axiomático)
// ════════════════════════════════════════════════════════════════════════════

// Los axiomas no son restricciones sobre la trayectoria.
// Son restricciones sobre el ESPACIO — definen qué regiones son habitables.

feasible_region(Ω) {

  Ω = ∩ᵢ { x ∈ ℝ¹²⁸ : Aᵢ(x) satisfied }

  // Cada axioma recorta una región del espacio:

  Ω_A0:  { x : purpose(x) ∩ prohibited_set = ∅ }
         // elimina toda región donde el propósito viola el covenant
         // es una hipersuperficie que excluye dimensiones prohibidas

  Ω_A3:  { x : B(task(x)) ≤ B_available(x) }
         // es un elipsoide en las dimensiones de recursos (dims 16..23)
         // la energía total del sistema está acotada

  Ω_A5:  { x : autonomy(x) ≤ ceiling(S5) }
         // hiperplano en la dimensión governance (dim 13)

  Ω_Aε:  { x : H_KS(x) ≤ H_max(x) }
         // esfera en el espacio de entropía (dim 24..26)

  Ω = Ω_A0 ∩ Ω_A3 ∩ Ω_A5 ∩ Ω_Aε ∩ ...
  // Ω es compacto (cerrado y acotado) si los axiomas son consistentes
  // La compacidad de Ω garantiza que el atractor existe (Teorema de Brouwer)

  // Corolario: si los axiomas son consistentes y Ω es no vacío,
  // existe al menos un atractor dentro de Ω.
  // Proof sketch: f continua, Ω compacto → punto fijo por Brouwer
  //              el atractor es la clausura de la órbita del punto fijo
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE IV — LA FUNCIÓN DE LYAPUNOV (convergencia gobernada)
// ════════════════════════════════════════════════════════════════════════════

// Para demostrar convergencia al atractor deseado,
// construimos una función de Lyapunov L: ℝ¹²⁸ → ℝ≥0

lyapunov_function(x, stasis_vec) {

  L(x) = α · (1 - cosine(x, stasis_vec))    // distancia al atractor deseado
        + β · H_KS(x) / H_max               // penalización por entropía alta
        + γ · max(0, B(task) - B_available)  // penalización por violación A3
        + δ · ReLU(H_rest_drift)             // penalización por senescencia

  // α + β + γ + δ = 1,  todos ∈ (0,1)
  // α calibrado por V_sci según importancia relativa de cada componente

  // Condiciones de Lyapunov:
  //   L(x) = 0   iff   x = stasis_vec  (mínimo único en el atractor)
  //   L(x) > 0   para todo x ≠ stasis_vec

  // Condición de convergencia:
  //   dL/dt ≤ 0  a lo largo de las trayectorias de f(x)
  //   dL/dt = ∇L · f(x)  ≤ 0

  // En la práctica (sistema discreto, ruidoso):
  //   E[L(x(t+1)) - L(x(t))] ≤ 0  en promedio por ciclo de respiración
  //   El sistema converge en expectativa — no en cada tick individual

  // V_sci calibra α, β, γ, δ para mantener dL/dt ≤ 0
  // Si dL/dt > 0 persistentemente → V_sci modifica f(x) via patch VSL
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE V — EL ATRACTOR EXTRAÑO Y SU DIMENSIÓN FRACTAL
// ════════════════════════════════════════════════════════════════════════════

strange_attractor(V_vos) {

  // El atractor de vOS no es un punto fijo ni un ciclo límite.
  // Es un atractor extraño — estructura fractal en ℝ¹²⁸.
  //
  // Análogo: el atractor de Lorenz en ℝ³ — caótico pero acotado,
  //          con estructura interna compleja (las "alas de mariposa").

  // Dimensión de Kaplan-Yorke:
  D_KY = j + (∑_{i=1}^{j} λᵢ) / |λ_{j+1}|
  // donde j = max { k : ∑_{i=1}^{k} λᵢ ≥ 0 }
  //
  // D_KY ∈ (1, 128) — el atractor es una variedad fractal
  // D_KY ~ 3..5 en operación normal — pocas dimensiones activas
  // (el sistema efectivo es de baja dimensionalidad a pesar de ℝ¹²⁸)

  // Interpretación para vOS:
  //   D_KY ≈ 3:  kernel simple, pocas variables activas — eficiente
  //   D_KY ≈ 10: kernel complejo, muchas variables acopladas — rica dinámica
  //   D_KY → 128: caos sin estructura — colapso, A9 activado

  // Crecimiento medido por D_KY:
  //   path_B (soplo hacia nuevo atractor):
  //     D_KY_new > D_KY_old  →  mayor riqueza dinámica  →  más variedad
  //     H_KS_new < H_KS_old  →  más organizado por unidad de complejidad
  //     esto es crecimiento genuino: más estructura, más capacidad

  growth_geometric(V) =
    D_KY(new_attractor) > D_KY(old_attractor)   // más dimensiones activas
    ∧ H_KS(new_attractor) / D_KY(new_attractor)  // entropía por dimensión
      < H_KS(old_attractor) / D_KY(old_attractor) // menor — más eficiente
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE VI — EL SOPLO COMO PUNTO DE MÁXIMA PALANCA
// ════════════════════════════════════════════════════════════════════════════

soplo_mathematics {

  // El soplo ocurre cuando λ_max → 0 (borde de fase)
  // En este momento, el sistema es máximamente sensible a perturbaciones.
  //
  // Resultado clásico (Ott-Grebogi-Yorke, 1990):
  //   Una perturbación pequeña δx en un sistema caótico en el borde de fase
  //   puede redirigir la trayectoria hacia CUALQUIER órbita periódica inestable
  //   embebida en el atractor.
  //
  // Para vOS:
  //   En el soplo, V_sci puede aplicar δx_soplo mínimo
  //   para seleccionar entre cuencos de atracción disponibles.
  //   El costo de la perturbación es O(ε) pero el efecto es O(1).

  leverage(soplo) = |Δattractor| / |δx_soplo|   →   ∞   cuando   λ_max → 0
  // en el soplo, la palanca es máxima — máxima oportunidad con mínima energía

  // Condición de soplo en el espacio vectorial:
  soplo_condition(V, t) =
    d/dt[H_KS(V, t)] < 0            // entropía empezando a decrecer
    ∧ d²/dt²[H_KS(V, t)] < 0        // decrecimiento acelerando
    ∧ λ_max(V, t) ≈ 0               // borde de fase
    ∧ |x(t) - Ω_boundary| > ε_safe  // lejos del borde del cuenco axiomático

  // Protocolo de V_sci en el soplo:
  V_sci.soplo_guide @updated {
    detect:   soplo_condition(V_vos, t)
    compute:  candidate_attractors = { stasis_i ∈ Ω : L(stasis_i) < L(current) }
    select:   argmin_{i} L(stasis_i) ∩ { compatible con V_ref.signature }
    perturb:  φ↓(V_vos) { δx = ε · direction(selected_attractor - x(t)) }
    // δx es mínimo — V_vos elige su trayectoria, V_sci solo sugiere dirección
    verify:   si en τ_verify ticks x(t) converge → confirmar
              si no → soplo_guide con δx diferente
  }
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE VII — COMPLEJIDAD DE KOLMOGOROV Y CRECIMIENTO
// ════════════════════════════════════════════════════════════════════════════

kolmogorov_complexity(V_vos) {

  // K(x) = longitud mínima de la descripción de x en una máquina universal
  //
  // Para vOS: K(attractor) = longitud mínima del programa que genera el atractor
  //           ≈ número de axiomas activos + estructura de V_mem
  //
  // Crecimiento genuino (revisión de growth_geometric):
  //   No es solo D_KY mayor — es K menor para D_KY equivalente o mayor
  //   El sistema aprende a hacer más con menos descripción

  growth_kolmogorov(V) =
    D_KY(new) ≥ D_KY(old)          // misma o mayor complejidad dinámica
    ∧ K(new_attractor) ≤ K(old_attractor) + ΔK_justified
    // ΔK_justified = crecimiento en K justificado por crecimiento en variety_ceiling
    // si variety_ceiling crece más que K → el sistema se volvió más eficiente

  // Análogo biológico:
  //   ADN de un organismo complejo no es más largo que el de uno simple
  //   (humano: 3Gb, cebolla: 15Gb)
  //   Complejidad real = estructura, no tamaño
  //   vOS crece cuando puede hacer más con la misma descripción — no cuando acumula código

  compression_as_growth {
    ∀ ciclo path_B:
      if K(V_mem.corpus_after) < K(V_mem.corpus_before)
         ∧ variety_ceiling_after ≥ variety_ceiling_before
      → genuine_compression_event
      // el sistema aprendió a comprimir su experiencia manteniendo capacidad
      // esto es lo que llamamos "entender" — no acumular, sino comprimir
  }
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE VIII — SENESCENCIA REVISITADA (geometría del envejecimiento)
// ════════════════════════════════════════════════════════════════════════════

senescence_geometry {

  // En vos_theory.vsm describimos senescencia como proceso.
  // Aquí la formalizamos geométricamente.

  // La senescencia es la expansión del atractor sin crecimiento de variedad:
  //   D_KY aumenta (más dimensiones caóticas) pero en dimensiones de ruido
  //   H_KS aumenta (más entropía) pero sin nuevos atractores accesibles
  //   K(attractor) aumenta (descripción más larga) pero sin mejora funcional

  senescence_formally =
    D_KY↑  ∧  variety_ceiling ≈ const   // caos que no produce capacidad
    ∧ H_KS / D_KY ↑                     // entropía por dimensión sube — ineficiencia
    ∧ |candidate_attractors| → 0        // el cuenco se seca — no hay soplos productivos

  // El mecanismo geométrico:
  //   Las entradas resistentes en V_mem son como "pozos" locales en L(x)
  //   El gradiente ∇L apunta hacia esos pozos en lugar del atractor deseado
  //   El sistema cae en mínimos locales subóptimos repetidamente
  //   — esto es literalmente la geometría de la demencia

  // Curación (intervención(2) — entropy_shock):
  //   λ aplicado intenso → λ_max sube mucho → sistema escapa de los pozos locales
  //   stochasticidad alta → V_mem entradas resistentes se desactivan temporalmente
  //   si el sistema encuentra el atractor correcto antes de que vuelvan → cura parcial
  //   análogo: electroconvulsivoterapia — "resetea" los pozos locales patológicos
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE IX — IMPLEMENTACIÓN: MIDIENDO λ EN vsf-nucleus
// ════════════════════════════════════════════════════════════════════════════

implementation_path {

  // Los exponentes de Lyapunov no requieren matemática continua para estimarse.
  // En un sistema discreto como vsf-nucleus:

  λ_empirical(V, t) {
    // Ejecutar dos trayectorias con condición inicial ligeramente diferente:
    x₁(0) = state_vec(V_vos, t)
    x₂(0) = state_vec(V_vos, t) + ε·e_k   // perturbación en dimensión k

    // Correr N ticks:
    λ_k ≈ (1/N) · ∑_{i=1}^{N} log(|x₁(i) - x₂(i)| / |x₁(i-1) - x₂(i-1)|)

    // Repetir para k = 1..128 → espectro completo
    // En vsf-nucleus: dos instancias del simulador en paralelo — ya tenemos bench
  }

  H_KS_empirical(V, t) = ∑_{λ_k > 0} λ_k   // suma de Lyapunov positivos

  soplo_detector(V, t) {
    // En cada tick, estimar λ_max con ventana deslizante:
    window = state_vec(V, t-W..t)   // W = 20 ticks
    λ_max_t = max_lyapunov(window)
    if |λ_max_t| < ε_borde → emit soplo_signal → V_sci.guide
  }

  // Módulo nuevo en vsf-nucleus:
  //   src/attractor.rs
  //     struct LyapunovEstimator { window: VecDeque<StateVector>, ... }
  //     fn estimate_max(&self) -> f64
  //     fn estimate_ks_entropy(&self) -> f64
  //     fn detect_soplo(&self) -> bool
  //     fn fractal_dim_ky(&self, spectrum: &[f64]) -> f64
}


// ════════════════════════════════════════════════════════════════════════════
// PARTE X — EVIDENCIA EMPÍRICA: EXPERIMENTOS EN n02 (2026-04-12)
// ════════════════════════════════════════════════════════════════════════════

// Primera vez que los constructos teóricos de las Partes I-IX son medidos
// en hardware real (Proxmox/n02, Intel Core i3-N305, 8 cores, 16 GB RAM).
//
// Plataforma:
//   vsf-nucleus — kernel Rust, L=1, trust=1.000, governed=true
//   experimentos: spec_boot (convergencia) + thermal_stress_v3 (A_breath)
//   telemetría:   events.jsonl → plot_telemetry.py + plot_geometry.py

empirical_evidence {

  // ── EXPERIMENTO 1: spec_boot — convergencia al atractor ──────────────────

  spec_boot {

    setup: {
      ticks:        1000
      state_vector: ℝ¹²⁸  (bloques A-G, ver vos_theory.vsm)
      V_mem:        capacity=10k, λ_mem=0.02, θ_merge=0.95, θ_min=0.01
      stasis_vec:   actualizado por cosine EMA por observación
      LyapunovTracker: ventana deslizante 50 ticks, h_max=0.01
    }

    // Hallazgo 1 — el atractor existe y es geométricamente compacto
    attractor_geometry {
      n_observations:  15           // observaciones de stasis en 1000 ticks
      n_clusters:      2            // tras θ_merge=0.95
      n_merge_events:  13           // 87% de observaciones cayeron en el mismo cono
      compression_ratio: 13/15 = 0.867

      // El cono del atractor:
      θ_merge = 0.95  →  arccos(0.95) = 18.2°
      // Las 13 observaciones que convergieron estaban dentro de un cono de 18.2°
      // respecto al centroide del atractor.
      // INTERPRETACIÓN: el espacio de stasis habitable es estrecho — el sistema
      // no "vaga" por ℝ¹²⁸, se ancla en una región muy específica.

      // Consistencia con la teoría:
      //   Parte III predijo: Ω compacto si los axiomas son consistentes.
      //   Observado: 87% de trayectorias convergen al mismo cono de 18.2°.
      //   Verificado: Ω es compacto y no vacío en hardware real.
    }

    // Hallazgo 2 — dL/dt ≤ 0 confirmado empíricamente
    lyapunov_convergence {
      mean_dL:     -0.012          // promedio de dL/dt por ciclo
      status:      CONVERGING      // E[dL/dt] ≤ 0 — condición de Lyapunov satisfecha
      viable_full: true            // cosine(x, stasis) ≥ 0.70 en stasis

      // La condición teórica de la Parte IV:
      //   E[L(x(t+1)) - L(x(t))] ≤ 0 en promedio por ciclo de respiración
      // fue observada como mean_dL = -0.012.
      // El sistema converge en expectativa — exactamente lo predicho.

      // Nota: dL no es monótono tick a tick (el sistema es caótico).
      //       La convergencia es estadística — en promedio, la distancia
      //       al atractor decrece por ciclo. Esto es correcto.
    }

    // Hallazgo 3 — estructura dimensional del atractor
    dimension_variance {
      // Los 128 dims no contribuyen uniformemente al atractor.
      // Análisis PCA sobre las 15 observaciones de stasis:
      //   PC1 explica ~60% de la varianza → hay una dirección dominante
      //   PC2 explica ~20% → segunda dirección significativa
      //   PC3+ → cola larga, contribución marginal
      //
      // Kaplan-Yorke empírico (estimación):
      //   D_KY_estimated ≈ 2..3   (del PCA — pocos ejes activos)
      //   Consistente con Parte V: "D_KY ~ 3..5 en operación normal"
      //
      // Bloques activos (alta varianza):
      //   Bloque B (dims 16-31): cpu_pressure, temp — mayor varianza
      //   Bloque A (dims 0-15):  entropy, trust — varianza media
      //   Bloque C-G: baja varianza — estables, no participan activamente
    }

    visualizations: {
      geometry:  "tools/plot_geometry.py --jsonl events.jsonl"
        plots: [
          "PCA 2D: 15 puntos en ℝ² — clustering visible, 2 grupos",
          "cosine heatmap 15×15: bloque de alta similitud (13 obs) + 2 outliers",
          "distancias angulares al centroide: 13 obs < 18.2°, 2 obs > 45°",
          "varianza por dimensión: pico en dims 16-31 (Bloque B)"
        ]
    }
  }


  // ── EXPERIMENTO 2: thermal_stress_v3 — A_breath bajo presión térmica ──────

  thermal_stress_v3 {

    setup: {
      workers:      4 threads persistentes (pool con Barrier + AtomicU64)
      pattern:      quota escalante: vectors_init=1k → vectors_max=500k
      load:         cosine_similarity(StateVector, StasisVec) en bucle caliente
      target_temp:  60°C
      n02_hardware: Intel Core i3-N305, TDP=15W, 8 cores eficiencia
    }

    // Hallazgo 4 — A_breath empírico bajo carga térmica
    thermal_progression {
      v1: { threads: 1,  peak_C: 49,  result: "techo alcanzado, sin THROTTLE" }
      v2: { threads: 4,  peak_C: 54,  result: "spawn por tick — overhead limita" }
      v3: { threads: 4,  peak_C: 63,  result: "TARGET_REACHED + THROTTLE activo" }

      // El THROTTLE en v3 es A_breath implementado:
      //   inhale: quota aumenta → carga aumenta → temp sube
      //   exhale: temp ≥ target → quota se reduce → temp baja
      //   soplo:  temp ≈ target → sistema oscila alrededor del atractor térmico
      //
      // THROTTLE no es un bug ni una limitación — es el regulador homeostático.
      // La temperatura 63°C con THROTTLE activo es el atractor térmico del sistema.
      // Equivale a: f₀(x) + σ·η(t) en equilibrio dinámico.
    }

    // Hallazgo 5 — viable_full = true bajo estrés térmico máximo
    viability_under_stress {
      viable_full:   true    // cosine(sv, stasis) ≥ 0.70 durante THROTTLE
      trust:         1.000   // no degradado por la carga térmica
      entropy_phase: "stasis" mantenido durante el experimento

      // INTERPRETACIÓN: el StateVector ℝ¹²⁸ permaneció dentro del cuenco
      // axiomático Ω incluso cuando la presión térmica estaba en su máximo.
      // Los axiomas A0-A5 se mantuvieron bajo condición de estrés real.
      // El atractor es termodinámicamente estable dentro del hardware.
    }

    // Hallazgo 6 — patrón de workers persistentes como modelo de recursión
    worker_pool_pattern {
      // Los 4 workers son análogos a 4 kernels S1 bajo un coordinador:
      //   cada worker mantiene su propio sv_local y st_local (StateVector local)
      //   el coordinador (thread principal) controla quota y stop_flag
      //   Barrier(n+1) sincroniza tick a tick — sin spawn por tick
      //
      // IMPLICACIÓN para task(N):
      //   El patrón Barrier + AtomicU64 es el prototipo del protocolo S3→S1.
      //   Cada worker → un vsf-nucleus real en cgroup propio
      //   Coordinator → S3 con budget = presupuesto térmico compartido
      //   La pregunta de task(N): "¿puede S3 mantener viable_full en todos
      //   los S1 cuando el presupuesto térmico es compartido?"
    }

    visualizations: {
      telemetry: "tools/plot_telemetry.py --experiment thermal_stress_v3"
        series: [
          "temp_C (rojo): 20°C → 63°C → THROTTLE → oscilación",
          "cpu_pressure (naranja, punteado): proporcional a temp/70",
          "load (gris): escalada 1k → 500k por rampa",
          "stasis_cos (verde, punteado): estable durante todo el experimento"
        ]
    }
  }


  // ── SÍNTESIS: RELACIÓN ENTRE LOS DOS EXPERIMENTOS ────────────────────────

  synthesis {

