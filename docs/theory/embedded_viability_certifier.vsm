// STATUS: historical_record — consumido por fuse fuente THEORY-02 (vos_proofs.vsm:7); contenido canonical en vos_proofs.vsm · archivo 2026-08-15
// (THEORY-FUSE-REMAINDER censo; contenido en el target canonical, este doc es fuente histórica.)
// domain_context: {target=vsf, env=VSF-session, layer=S5}
// SEED — DSN-EVC-01 — Embedded Viability Certifier: integration by CERTIFICATION, not DECLARATION.
// Origin: rmw3 observation 2026-06-03 (after DSN-COUPLE-01 Phase 3a). The keystone that makes VSM
// recursion operational and resolves DSN-COUPLE-01's cold-start-trust + vantage open questions.

seed("embedded_viability_certifier") {
  id     = DSN-EVC-01
  status = "design — security layer CONVERGED + S5-ratified 2026-06-04 (Claude@S3 ↔ Qwen@S4, 4 rounds); core spec pending"
  date   = 2026-06-03
  extends = "DSN-COUPLE-01 (manifest → attestation); connection_schema.json; coupling.rs; PSI/1.0 (task O)"

  thesis:
    "A module must integrate by presenting a VERIFIABLE VIABILITY GUARANTEE, not a self-asserted
     DECLARATION. Today a Coupling Manifest (DSN-COUPLE-01) declares an S1's function; the parent validates
     its STRUCTURE but not its TRUTH. Upgrade: every instance (LXC / VM / container / MCU) EMBEDS a MINIMAL
     CERTIFIER — a tiny nucleus — that self-certifies viability from the INSIDE and emits a signed
     Viability Attestation. A module couples by PRESENTING that attestation; the parent VERIFIES it."

  minimal_certifier: {
    what:    "the smallest core that can certify viability: Ω-membership check + the model≡reality
              self-reconcile (topology_reconcile, run from INSIDE the instance) + the `governed` predicate
              (lyapunov-lite) + the manifest/admission gate. NOT an LLM (D6-safe) — pure Rust, no_std-capable.",
    floor:   "the esp32-algedonic-sensor node_profile (Rust no_std, llm='none (D6)', S1-only φ↑ emitter) is
              the minimal certifier's hardware floor — proof the certifier can be tiny and non-cognitive.",
    relation:"= the 'minimal nucleus' / vsi.rs S0..S5 core. Every recursion level runs the SAME certifier."
  }

  viability_attestation: {
    is:      "a signed document the embedded certifier emits, REVEALING the instance's relation to the
              system: recursion level + parent (vsf_ref), φ↑/φ↓/ψ channel bindings, its Ω box, current
              trust state (4-axis), S1-S5 completeness, and a freshness/nonce.",
    signed:  "Ed25519 over the certifier's identity (covenant key chain). The parent verifies (a) the
              signature, (b) the CERTIFIER BINARY identity (sha) = a canonical minimal-nucleus, and MAY
              (c) challenge for a fresh attestation (nonce → liveness, not a replay).",
    vs_manifest: "the manifest DECLARES (audit_map/operational_map/coupling); the attestation CERTIFIES the
                  same, produced by a running verifiable certifier. Manifest = the claim; attestation = the proof."
  }

  // ── WHY THIS IS THE RECURSION ────────────────────────────────────────────────
  recursion:
    "The certifier is the RECURSIVE INVARIANT: V' ⊃ V' ⊃ V', each level running the same minimal certifier
     exposing the same connection_schema contract — now also EXECUTING it. The attestation is HOW a level
     'reveals its relationship to the system'. Recursion stops being a diagram and becomes a running,
     verifiable artifact at every level."

  resolves: {
    cold_start_trust: "DSN-COUPLE-01's open gap. Don't trust an unknown S1's declaration — verify its
                       certifier's attestation, ROOTED in the certifier binary identity (the STRUCTURAL
                       trust axis = topology_reconcile identity_proof.binary_sha). The sha-root IS the CA.
                       quis custodiet resolved: the certifier is verifiable, not self-trusted.",
    vantage_problem:  "each instance certifies ITSELF from inside ⇒ the parent needs no vantage INTO opaque
                       instances (the VM case generalizes — EVERY instance self-certifies, not just VMs).
                       S3* becomes bidirectional across the membrane: child self-audits + presents, parent
                       verifies. (The FIND-NUC-ORPHANS host-vantage limitation dissolves at this layer.)",
    distributed_psi:  "peer ψ-coupling = MUTUAL attestation exchange. coupling.rs Handshake becomes 'exchange
                       + verify each other's Viability Attestation before ψ'. Same protocol, horizontal."
  }

  security_hinge:
    "CRITICAL: a self-certifier CAN LIE. The defense is that the parent verifies the CERTIFIER'S IDENTITY
     (binary sha + covenant signature), NOT its output. Self-certification without a verifiable trust root
     is theater. Root = the covenant key / a CA chain over certifier binaries. This is exactly the structural
     trust axis already built — the loop closes."

  becomes_PSI: "PSI/1.0 (task O) is no longer just an onboarding manifest — it is a VIABILITY ATTESTATION
                PROTOCOL: handshake = attestation exchange + verification; the open standard by which any
                viable system proves (not declares) its viability to couple, recursively and peer-to-peer."

  // ── SECURITY LAYER — CONVERGED + S5-RATIFIED (2026-06-04) ───────────────────────
  // Claude@S3 ↔ Qwen@S4 cross-validation, 4 rounds. Full exchange:
  //   docs/internal/vsl_micro_nucleus_02_claude_review.vsm (S3 corrections M1/M2)
  //   docs/internal/vsl_micro_nucleus_04_claude_signoff.vsm (S3 final + 4 guards)
  security_layer_converged: {
    foundation: "M1 — security IS transparency/attestability, NOT obfuscation (Kerckhoffs for viability
                 certification): NO obfuscation/anti-debug; tamper-resistance via reproducible build + signed
                 binary + EXTERNAL sha attestation (parent verifies the certifier sha = the structural trust
                 axis = the CA). M2 — the trust ROOT is OFFLINE: rmw3 pubkey + covenant hash baked in at
                 build time; the public vsf.u2738.org anchor is freshness/revocation only (it is the n01/
                 bastion SPOF, R8); AUTHORITY = the S5 signature, never the URL or a bare hash-match.",
    axioms: [
      "Ax_NoObscurity: certifier OPEN + REPRODUCIBLE; tamper-resistance via external sha + signature.",
      "Ax_SignedUpdateOnly: a new covenant hash is adopted ONLY via an S5-signed version increment; absence
       of the anchor DEGRADES to last-known-good-signed, never halts; local tamper → halt but SCREAM FIRST.",
      "Ax_TwoLevelAttestation: S5 ⊢ certifier_key (authorizes the certifier); certifier ⊢ instance_
       attestation(nonce, ts) (proves viability NOW; anti-replay).",
      "Ax_BoundaryMatchedAuth: signed Ed25519 challenge-response in-host (no PKI); mTLS only cross-node.",
      "(refined) Ax_CovenantAnchoring(offline root) · Ax_BinaryIntegrity(external check + scream-then-halt) ·
       Ax_ManifestSigning(split S5-manifest / certifier-attestation) · Ax_ChannelAuthentication · Ax_TrustChainContinuity."
    ],
    spec_guards: [
      "G_repro (LOAD-BEARING): reproducibility is the whole chain's premise — VERIFY BY REBUILD (build twice
       on n02, byte-identical) BEFORE the CA. cargo --locked+source-date-epoch is necessary, not sufficient
       (need --remap-path-prefix, pinned toolchain, normalized debug info, no timestamps). tier_α.0.",
      "G_keylife: the CA must specify key LIFECYCLE (root custody=covenant/A4, certifier-key issuance/
       rotation, certifier-key revocation [promote to tier_α]), not just topology.",
      "G_genesis: BOTH ends embed the offline root at build time (parent ⊇ {S5 pubkey, canonical certifier
       sha}; certifier ⊇ {S5 pubkey, covenant hash}) — no bootstrap hole, no network for first contact.",
      "G_halt_screams: halt MUST emit algedonic(sev10) + a final signed 'halting:tamper' attestation BEFORE
       halting — never die silently (the anti-orphan lesson: silent failure is the worst kind)."
    ],
    reuse: "A4 witness scaffolding (Ed25519-dalek, already in vsf-agent) · DSN-COUPLE-01 Phase 1 manifest +
            validator · covenant.vsm v1.1 + covenant_ops.vsm v0.1 (S5-signed)."
  }

  next: [
    "spec drafting (convergence done): (0) the G_repro REPRODUCIBILITY GATE first (verify-by-rebuild on n02);",
    "design DSN-EVC-01 fully: (1) the Viability Attestation schema (extends coupling_manifest + a signature);",
    "  (2) the minimal-certifier core spec (Ω + self-reconcile + governed + gate; no_std target = vsi.rs);",
    "  (3) the verification protocol (signature + certifier-sha CA + challenge/nonce);",
    "  (4) the trust-root / CA model over certifier binaries (the covenant key chain).",
    "gated/related: vsi.rs (the S0..S5 minimal core), EXP-TRUST-01 (trust state IN the attestation),",
    "  covenant signing key (A4 Ed25519 witness verify already in vsf-agent), DSN-COUPLE-01 (the manifest",
    "  it upgrades). This is the natural successor to DSN-COUPLE-01 Phase 4."
  ]
}

