⟦ runner_telemetry_api_design | ARCHITECTURE-v1 | vsm-1.2.1 | 2026-10-23T13:35:53Z ⟧

@vsm 1.2.1
@status active

// RUNNER TELEMETRY API — design para vOS-como-servidor (RUNNER-ARCH-API-1).
// Origen: S5 2026-10-20 (arch-agnostico WSL → LXC → bare-metal via API;
// agentes anidados reportan SIN sistema completo junto al nucleo, modelo
// n02). scheduled_suite.py = primer reportero. ESTE DOC: design-only per
// ronda ordenamiento S5 2026-10-23 (#8 ranked); wiring de staging queda
// para la sesion post-AGI-push.

role = "API HTTP JSON donde los AGENTES ANIDADOS (reducidos: sin repo,
  sin TASKS.vsm, sin covenant) reportan ciclos; el nucleo es la unica
  autoridad que consolida (S4). El agente no porta el sistema completo:
  solo reporta a esta API.";

api_shape = {
  transport: "HTTP/1.1 JSON (stdlib ThreadingHTTPServer; cero deps)",
  default_bind: "127.0.0.1:9090 staging WSL (loopback, plain). PRODUCCION
    (S5 ratificado 2026-10-23, opcion MAS SEGURA): bind nunca publico sin
    TLS+auth fuerte — ver security_tier.",
  api_version: "1.0",
  endpoints: [
    "POST /api/v1/cycles      — reporte de ciclo (idempotente por cycle_n)",
    "GET  /api/v1/cycles      — listing paginado (cycle_n desc, limit<=200)",
    "GET  /api/v1/cycles/{n}  — ciclo puntual",
    "POST /api/v1/agents      — registro: {agent_id, os, arch, hostclass}",
    "GET  /api/v1/health      — liveness (rc 0 solo si puede persistir local)",
  ],
  auth: "HARD REQUIREMENT (S5 2026-10-23 ratificado: la opcion mas segura,
    el servidor abrira al PUBLICO): todo bind fuera de loopback EXIGE
    (1) TLS 1.3 (mTLS preferido: server+client certs de la CA S5,
    renewal per operations.s5_ca_renewal), (2) token firmado per-agent
    (HMAC o JWT corto-TTL, NO identidad declarada sola), (3) reject
    fail-closed si X-VOS-Agent no matchea payload agent_id. En loopback
    staging el header declarativa sigue siendo aceptable (trust loopback).",
  idempotencia: "POST /cycles con cycle_n ya visto → 200 {status:
    duplicate} (no re-consolida); cycle_n entero >= 1 y monotono creciente
    (cada writer lleva su contador local).",
};

payload_schema = {
  api: "1.0",
  producer: "scheduled_suite",
  agent_id: "vsf-sched-suite-wsl",
  cycle_n: "<int>",
  ts: "<UTC ISO 8601>",
  wall_s: "<float>",
  ok: "<bool>",
  steps: "[ {name, rc, secs, tail} ]",
  last_decision: "<str|null>",
  shadow: "<bool>",
  constraints: "body <= 1MiB; steps <= 16 entradas; tail recortado a 4000
    chars server-side (fail-open: nunca rechaza por contenido largo).",
};

consolidation = {
  store: "1 archivo jsonl append-only: state/runner_api/cycles.jsonl",
  writer: "runner-api-server — registrar en DERIVED_STATE_WRITERS ANTES
    del primer arranque (leccion P4: writers fantasma rompen el gate)",
  consumption: "kernel lee via adapter domain=runner_api; NO reverse-write
    al producer (el reporter escribe SOLO su state local + POST).",
};

reporter_contract = {
  failopen: "el reporter SIEMPRE termina su ciclo local y luego hace POST
    fire-and-forget (timeout 5s); el rc de la API nunca afecta el rc del
    ciclo (fail-open documentado R9) — un server caido no puede convertir
    un ciclo verde en rojo.",
  integrity: "el server sella cada reporte con server_received_ts y los
    re-emite byte-exactos; dedupe unicamente por cycle_n.",
};

first_reporter_wiring = {
  file: "scripts/state/monitoring/scheduled_suite.py (candidato natural
    como primer reportero de la flota — se activa tras go S5 del design)",
  hook: "al cerrar la escritura de scheduled_suite_last.json, un POST si
    RUNNER_API_URL esta en env (default localhost:9090 en WSL staging)",
  privacy: "sin secretos en payload; los tails de checks ya son info
    publica del repo (R13 Ax_InterfaceOnly compatible).",
};

s5_answers_2026_10_23 = [
  "Q1 TLS/mTLS: SI — obligatorio antes de bind fuera de loopback (el
    servidor va publico pronto; production gate = security_tier abajo).",
  "Q2 heartbeat TICK: NO en v1 — cycles sola basta (menos superficie);
    heartbeat queda como D2 si S4 lo pide con evidencia de stall.",
  "Q3 host staging: WSL primero (risk-free, loopback); n02 solo cuando
    security_tier este implementado y S5 abra el bind.",
];

security_tier = {
  trigger: "cualquier bind != 127.0.0.1",
  required: [
    "TLS 1.3 (preferido mTLS, certs CA S5)",
    "token firmado per-agent (HMAC/JWT corto-TTL)",
    "rate limit (p.ej. 10 req/s per agent; 429 en exceso)",
    "body strict-schema (reject unknown fields; max 1MiB)",
    "fail-closed: agent_id header vs payload mismatch => 403",
  ],
  absent: "el server NO arranca en bind publico (startup assertion:
    if bind != loopback and not tls_ok: exit 2)",
};

success_criteria = [
  "server stdlib corriendo en staging (localhost) con /health rc 0",
  "scheduled_suite ciclo real POSTea OK (created o duplicate) y el
    service unit queda PASS incondicional",
  "cero BLOCKS nuevos: fail-open verificado (matar el server → suite
    sigue rc 0)",
];

// Contrato con la funcionalidad futura: D1 (adopcion local) es el scope
// de este doc; D2 (multi-agent, auth fuerte, heartbeat) requiere design
// S5 addendum antes de implementar.
⟦ /runner_telemetry_api_design ⟧
