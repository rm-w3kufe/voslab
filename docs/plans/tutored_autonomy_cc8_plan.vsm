@vsm 1.2.1
@status proposed

// CC-8 — TUTORED AUTONOMY (the L4 ladder)
// Premise recorded from S5 (rmw3, 2026-09-30):
//   "This would only be true if the rest of the systems had the
//    capability to present the evolution of the system, so that S5
//    can make L4 decisions. We have no certainty about this."
// Therefore CC-8 makes that certainty the ENTRY CRITERION of every
// stage — presentation capability first, autonomy second.

purpose: "
  Elevate the autonomy ceiling (L4_AUTO stays False) GRADUALLY and
  per-class, only after S5 can see — in one artifact, with evidence —
  what the system changed, would have done, and did. No stage of this
  ladder raises autonomy itself; stages raise what S5 can VERIFY.
"

// ─── PREREQUISITE AUDIT (S5's doubt, made concrete) ────────────────────────
// audited 2026-09-30 against state/ + logs/ (battery battery-2026-09-30)
presentation_capability: {
  exists: [
    "findings/guards ledgers + audit (49/49, coverage 1.0, run-verified)",
    "commit_verify/verdict_chain per-commit evidence (410/651, fresh)",
    "cycle_health verdict over 24 handlers, rotation-aware",
    "monitor 9/9 fleet instruments with real ages (n02 E2E)",
    "agent-plugin log census: 20 declared vs 38 observed sources",
    "snapshot history for churn-prone state (faults/rollback, daily)",
    "MCP live probes: canon_providers TRUE + state_reconcile []",
    "decisions.jsonl ledger (schema: question/alternatives/approved/outcome)",
    "gates: 13 negative controls executed every run"
  ],
  thin: [
    "decisions.jsonl had only 5 entries, stale Sep-27 (fed today: 5 -> 10)",
    "claims/certs frozen at 2026-09-27",
    "doc_manifest last run 2026-09-10",
    "S5-facing presentation = chat reports, no single regenerated view"
  ],
  missing: [
    "NO delta-report generator (nothing answers 'what changed since X' on demand)",
    "NO counterfactual/shadow harness (what WOULD the system have auto-done)",
    "NO per-class activation registry (bounds not machine-checkable)",
    "idle dispatch post-handler-fix observed only in code, not yet in a real idle"
  ]
}

// ─── THE LADDER ─────────────────────────────────────────────────────────────
ladder: {
  "CC-8.0": {
    name: "Evolution presentation (prerequisite)",
    goal: "S5 answers 'what changed, when, why, with evidence' from ONE artifact",
    deliverables: [
      "evolution report generator: deltas across ledgers, commits, snapshots, focus, drift",
      "decisions.jsonl fed on every S5-relevant event (cadence, not heroics)",
      "claims/certs/doc_manifest on a refresh cadence"
    ],
    exit_criteria: [
      "report regenerated 3 consecutive days from clean state",
      "every S5 decision of the period has a ledger entry with alternatives",
      "battery R1-R11 repeatable via a single runner command"
    ],
    autonomy_granted: "none — this stage is pure observability"
  },
  "CC-8.1": {
    name: "Counterfactual shadow",
    goal: "system LOGS the activations/decisions it WOULD take, without taking them",
    deliverables: [
      "shadow harness: on each candidate predicate/fix, append would-be action + bounds-check result",
      "divergence review: shadow vs reality side by side in the evolution report"
    ],
    exit_criteria: [
      "10 consecutive cycles with 100% of divergences explained",
      "at least 1 case where shadow proposed X and a guard would have blocked X (proof the shadow is not rubber-stamping)"
    ],
    autonomy_granted: "none — still observation, but of DECISIONS not just state"
  },
  "CC-8.2": {
    name: "Tutored execution per ratified class",
    goal: "auto-execute ONLY inside a class S5 ratified explicitly",
    bounds: [
      "class spec: scope (paths/predicate types), max blast radius, sha-pin, trial cycles",
      "auto-rollback on guard trip (faults/rollback + snapshots give forensics)",
      "every action pre-logged to decisions.jsonl; algedonic alert on boundary crossing",
      "per-instance S5 veto remains: queue > activated (status quo machinery)"
    ],
    first_candidate_class: "documentation/hash-refresh predicates (zero runtime blast) — S5 picks, not us",
    exit_criteria: [
      "K consecutive clean auto-actions inside class (K set by S5 at ratification)",
      "0 unexplained guard trips; rollback drill executed once for real"
    ],
    autonomy_granted: "L4 inside ONE ratified class; L4_AUTO flag stays False"
  },
  "CC-8.3": {
    name: "Ceiling review by S5",
    goal: "S5 decides — on CC-8.0..2 evidence — whether a wider class or a L4_CLASSES flag is justified",
    non_goals: ["blanket L4_AUTO=True", "bypassing algedonic channel", "any stage self-promoting (R17)"],
    autonomy_granted: "S5's call, nothing pre-decided"
  }
}

// ─── CONSTRAINTS (carry always) ─────────────────────────────────────────────
constraints: [
  "R10 deterministic predicates only",
  "R17: no stage promotes itself; activation needs S5",
  "algedonic pain signals reach S5 directly, never filtered by the layer under test",
  "presentation layer is PART OF the system under test: it gets battery'd too (anti-pantomima)"
]

// ─── VERIFY ─────────────────────────────────────────────────────────────────
auto_verify: [
  "python3 packages/framework/run_gates.py                      # 13/13 incl negative controls",
  "python3 -c import-audit_guards                               # coverage 1.0",
  "state/epistemic/reports/real_state_battery_*.json            # R1-R11 verdicts + declared gaps",
  "plan: check.py docs/plans/tutored_autonomy_cc8_plan.vsm      # format"
]
auto_execute: false
rollback_on_fail: true
