    path: "packages/framework/gate_suite/gates/timestamp_no_hardcoded.py",
    description: "Rejects .vsm files with hardcoded timestamps",
    rules: [
      "Detects midnight, noon, epoch placeholders",
      "Detects timestamps older than 24h",
      "Allows empty or minimal VSL documents"
    ]
  }
}

