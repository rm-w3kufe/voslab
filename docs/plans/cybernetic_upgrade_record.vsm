@vsm 1.2.1
@status active

// ============================================================================
// CYBERNETIC UPGRADE RECORD
// ============================================================================
// Second-order cybernetics implementation for vOS.
// Components now modify themselves, not just observe themselves.
// ============================================================================

@phase P1: RSI Feedback Loop {
  status: "done",
  commit: "refactor: bridge rsi_bridge to real vsf-rsi-core (L1-L3)",

  @component RSIBridge {
    path: "packages/framework/vos_kernel/backbone/rsi_bridge.py",
    description: "Real RSI bridge replacing 528-line stub",

    @capability L1: Feedback Loop {
      method: "feedback_loop_step()",
      vsf_rsi: "vsf_rsi_core.bridge.feedback_loop_step()",
      description: "One iteration of detection → proposal → evaluation → learning → adaptation",
    }

    @capability L2: Predicate Generation {
      method: "predicate_generate()",
      vsf_rsi: "vsf_rsi_core.bridge.predicate_generate()",
      description: "Propose changes to critical predicates from code or specs",
    }

    @capability L3: Genetic Algorithm {
      method: "genetic_algorithm_run()",
      vsf_rsi: "vsf_rsi_core.bridge.genetic_algorithm_run()",
      description: "Evolve predicate strategies using genetic algorithm",
    }
  }

  @evidence {
    vsf-rsi-core: "v0.2.12 available",
    tests: "vsf-rsi-core has 42 tests",
    integration: "rsi_bridge.py works directly with vsf-rsi-core",
  }
}

@phase P2: Socratic Integration {
  status: "done",
  commit: "docs: add cybernetic audit to record_structural",

  @component SocraticEngine {
    description: "New 2nd-order functions for self-modification",

    @capability Adaptive Fitness Weights {
      function: "adaptive_fitness_weights()",
      path: "packages/public/vsf-rsi/vsf_rsi/adaptive_weights.py",
      description: "Modify fitness function weights based on evaluation outcomes",
    }

    @capability Strategy Evaluation {
      function: "strategy_evaluate()",
      path: "packages/public/vsf-rsi/vsf_rsi/rsi_genetic_algorithm.py",
      description: "Evaluate strategy effectiveness and adapt parameters",
    }
  }
}

@phase P3: Adaptive Weights {
  status: "done",
  commit: "feat: P3 adaptive weights implementadas",

  @component AdaptiveWeightManager {
    path: "packages/public/vsf-rsi/vsf_rsi/adaptive_weights.py",
    description: "Modify fitness function weights based on evaluation outcomes",

    @interface {
      get_fitness_weights() → dict: "Current weights for GA fitness function",
      update_from_outcome(outcome) → dict: "Adjust weights based on evaluation",
      get_drift_step(accuracy) → float: "Calculate drift step size based on accuracy",
      record_accuracy(accuracy) → None: "Record accuracy for drift calculation",
    }

    @weights {
      accuracy: 0.4,
      complexity: 0.2,
      diversity: 0.2,
      threshold: 0.2,
    }

    @rules {
      accuracy_high: "If accuracy > 0.8, increase accuracy weight by 0.1",
      accuracy_low: "If accuracy < 0.5, decrease accuracy weight by 0.1",
      complexity_high: "If complexity > 1.0, increase complexity weight by 0.1",
      diversity_low: "If diversity < 0.3, increase diversity weight by 0.1",
    }
  }

  @integration {
    rsi_genetic_algorithm: "Uses adaptive weights in fitness evaluation",
    rsi_observer: "Uses adaptive drift step based on accuracy",
  }
}

@phase P4: Socratic Self-Modification {
  status: "done",
  commit: "feat: P3 adaptive weights implementadas",

  @description "Socratic engine can now modify its own parameters"

  @mechanism {
    adaptive_weights: "Modify fitness function weights",
    drift_detection: "Detect when strategy is degrading",
    strategy_adaptation: "Adapt strategy based on drift patterns",
  }
}

@phase P5: Schema Auto-Evolution {
  status: "done",
  commit: "feat: P5 schema_evolution implementado",

  @component SchemaEvolution {
    path: "state-canon-mcp/state_canon/schema_evolution.py",
    description: "Schema tracks its own history and can propose changes",

    @component SchemaTracker {
      description: "Tracks field types, nullability, record counts over time"
    }

    @component SchemaReconciler {
      description: "Diffs snapshots, detects added/removed/changed fields",
      drift_types: ["field_added", "field_removed", "type_changed", "nullability_changed"]
    }

    @component DriftAnalyzer {
      description: "Analyzes drift patterns across snapshots",
      patterns: ["frequent_add", "type_instability", "nullable_drift", "field_churn"]
    }
  }

  @mcp_integration {
    tools: [
      "state_schema_evo_status",
      "state_schema_evo_snapshot",
      "state_schema_evo_drift",
      "state_schema_evo_patterns",
      "state_schema_evo_propose"
    ],
    resource: "state://schema-history",
    flag: "--schema-evo <path>"
  }
}

@phase P6: Plugin System {
  status: "done",
  commit: "fix: plugin paths corregidos en opencode.json",

  @problem "All 25 plugin paths in opencode.json pointed to non-existent ../.opencode/plugins/"

  @solution "Updated paths to ../vsf/.opencode/plugins/"

  @result {
    plugins_resolved: 25,
    plugins_broken: 0
  }
}

@phase P7: Integration Verification {
  status: "done",

  @results {
    gate_suite: "8 gates PASS (negative control verified)",
    plugin_paths: "25/25 resolve correctly",
    rsi_bridge: "vsf-rsi-core v0.2.12 available",
    adaptive_weights: "fitness weights + drift step functional",
    schema_evolution: "drift detection functional",
    vsm_version_enforcer: "vsm-1.2.1 accepted, vsm-1.2 rejected"
  }
}

@phase P8: Documentation {
