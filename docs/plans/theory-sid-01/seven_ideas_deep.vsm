@status proposed
// plan/seven_ideas_deep.vsm — seven conjectures over the running system
// domain_context: {target=vsf, env=theory, layer=L+3}
//
// RESTRUCTURED 2026-08-08 (rmw3 S5). The document was 736 lines, 659 of them
// comment and 3 of them code: an essay with a VSL wrapper. It passed every
// density target because both axes measure LINE SHAPE, and a narrative
// wrapped at 70 columns has the shape of dense notation.
// Nothing in it could be CITED by another document or checked against the
// primer. That is what the restructure buys: the claims are now blocks, and
// six of them turned out to be wrong the moment they were written as blocks.
//
// The argument is preserved as comments ANCHORED to the claim they justify —
// ¬deleted. Maturana, Varela, Barnsley, Landauer and Beer are the reason
// these conjectures are worth testing.

frame("THEORY-SID-01") = {
  ground: "these conjectures are ¬thought experiments. They are read off a
           RUNNING system:",
  substrate: [
    "Rust kernel emitting ℝ¹²⁸ every 10s          ⟹ ~8640 points/day",
    "Merkle chain, signed events                  ⟹ mutation-evident",
    "modes μₛ — behavioural prototypes, S1..S5 ⊂ ℝ¹²⁸",
    "Lyapunov, 4 measured terms (Φ_align, H_entropy, B_budget, T_thermal)",
    "algedonic ledger — empty. A symptom, ¬a defect",
    "τ — how smooth the mode mixing is",
    "resource grants to 5 subsystems",
  ],
  depth_order: "#7 learned modes is the deepest ▪ #1 Merkle-as-immune is the
                one that reaches biology (Maturana, Santiago school)",
}

// ─────────────────────────────────────────────────────────────────────────
// #1 — THE MERKLE CHAIN AS IMMUNE SYSTEM
// ─────────────────────────────────────────────────────────────────────────
// A Merkle chain is classically an INTEGRITY mechanism — Bitcoin, git, any
// auditable log. Here it does more: it DEFINES the system. The system is what
// the chain says it is; outside the chain there is ∄ system. That is the
// definition of autopoiesis (Maturana & Varela 1973): a network of production
// processes producing the components which in turn produce the network.
// The chain produces events ▪ events produce state ▪ state produces events.

conjecture(1, "merkle_chain_as_immune_system") = {

  Def_Chain(t):    "C(t) = {e₁ … eₙ} ▪ eᵢ = (type, data, nonce, sig,
                    hash(prev), hash(self))",
  Def_Living(t):   "Chain(t) = {e ∈ C(t) | ¬invalidated_by_audit(e)}",
  // ¬the kernel that produces it — the CHAIN, as a record of self-production.
  // NAMED Chain(t), ¬S(t): S is S1..S5 in the canon and the viable set in #6.

  Def_Self(e):     "self(e) ⟺ verify(e.sig) ∧ hash(prev) = hash(e_{i−1})
                              ∧ hash(self) = hash(e)",
  Def_NonSelf(e):  "¬self(e) ∨ foreign_writer(e)",

  immune_system:   "IS = {diverse_verifier, s3-star, A0_classifier,
                    algedonic_channel}",

  correspondence: {              // biology → this system
    naive_T_lymphocyte:   "diverse_verifier — detects non-self",
    memory_B_lymphocyte:  "algedonic_ledger — remembers threats",
    antibody:             "CAPTURE_SUSPECT event",
    inflammation:         "α signal, sev > 3",
    sepsis:               "α signal, sev = 10 ∧ sustained",
    scar_tissue:          "restart_seam — the system recognizes its scar",
    autoimmune_disease:   "false positives — 105 merkle_breaks that were TCP",
    self_tolerance:       "restart_seam raises ∄ alarm",
    immunological_memory: "the full chain — it cannot forget",
    antigen_presentation: "A0_classifier reads patterns",
    cytokine:             "φ↓ response — resources, reconfiguration",
  },
  // SELF TOLERANCE is the load-bearing one: the system must ¬attack itself.
  // After a restart the nonces reset, and the kernel knows ¬to alarm on that.

  autopoiesis: {                 // Maturana 1987, The Tree of Knowledge
    autonomy:     "the kernel specifies which events are valid — signature ∧
                   hash chain. ∄ external agent inserts without the key",
    individuality:"identity = the public key. ¬in hardware, ¬in code — in the
                   CAPACITY TO SIGN. The system IS its key",
    closure:      "events → state → decisions → events. ∄ input bypassing the
                   chain. Organizationally closed, thermodynamically open",
  },
// Maturana 1980: the immune system is COGNITIVE — it does not only distinguish
  // self from non-self, it CONSTITUTES the self through that distinction. The
// self does not pre-exist detection. Here: by defining what a valid event is,
  // the verifier constitutes the system.
// ⟹ the system does not HAVE an identity. It IS an identity maintaining itself
  //   through continuous production of self-consistent events.

  experiment("immunological_challenge"): [
    "inject foreign_writer into events.jsonl        — simulated attack",
    "measure t until diverse_verifier detects       — response_time",
    "measure α amplitude                            — response_magnitude",
    "measure false positives, next 10 min           — autoimmune_flare",
    "compare against the biological response curve",
  ],
  predicts: "R(t) = A · step(t − t_poll)      // step at the next poll",
  // CORRECTED per review 2026-07-11: ¬logistic. The verifier runs on a TIMER
  // (cron 04:30), ¬by continuous proliferation, so detection is a STEP, ¬a
  // sigmoid. Lymphocytic kinetics over-biologizes the system and a reviewer
  // will use it against us.
  // step(·), ¬H(·): H is Shannon entropy in #2 and H_entropy in the Lyapunov.

  open: {
    Q1_1: "minimum immunological memory? how many events to tell self from
           non-self?  → hypothesis: the last hash suffices, the chain is
           cumulative",
    Q1_2: "is an empty algedonic ledger IMMUNOSUPPRESSION? ∄ algedonic ⟹ the
           system ¬remembers its infections  → hypothesis: yes, viability risk",
    Q1_3: "can tolerance be INDUCED? a benign error pattern (Qwen TCP
           timeouts) taught to the A0 classifier  → controlled
           immunosuppression",
  },
}

// ─────────────────────────────────────────────────────────────────────────
// #2 — THE KERNEL AS A THERMAL ENGINE POWERED BY INFORMATION
// ─────────────────────────────────────────────────────────────────────────
// Every computation dissipates heat (Landauer 1961) — LXC 101 runs 68-72°C at
// ~15-20W. But the kernel is ¬only a computer: it is a REGULATOR. It takes
// variety from the S1 sensors, compresses it, emits decisions. How much
// variety buys one decision, and what is the ceiling?

conjecture(2, "kernel_as_thermal_engine") = {

  strokes: {
    admission:   "V_in  = H(φ↑) + H(sensors)         [bits/s]
                  measured on NATS: φ↑ topics/min · mean size",
    compression: "ℝ¹²⁸ → Δ⁴ — softmax mixing selects a mode combination.
                  C = 128 / log₂(5) ≈ 55:1 upper bound; REAL C is lower,
                  the modes carry structure",
    work:        "W_out = φ↓ decisions + grants + α       [bits/s]
                  ~72 bytes/decision — Ed25519 sig, timestamp, nonce, data",
    exhaust:     "Q_out = ΔT · C_thermal                  [J/s = W]
                  CPU temperature rise over idle",
  },

  efficiency: {
    informational: "η₁ = W_out / V_in        decision bits per variety bit",
    thermodynamic: "η₂ = W_out / Q_out       decision bits per joule",
    cybernetic:    "η₃ = η₁ · η₂ = W_out² / (V_in · Q_out)",
    // CORRECTED 2026-08-08. The source asserted BOTH
    //   η₃ = W_out / (V_in · Q_out)   AND   η₃ = η₁ · η₂
    // and those are ¬equal: η₁·η₂ = W². A formula contradicting itself two
    // lines later is the class of defect no gate catches — it parses, it
    // closes, it encodes clean. η₁·η₂ is kept as the definition because that
    // is the composition the argument uses; the other form was the typo.
  },

  ceiling: "η₃ ≤ Ashby ⊗ Landauer",
  ashby:    "W_out ≤ V_in · k_reg — the decision cannot carry more variety
             than the regulator has",
  landauer: "Q_out ≥ k_B·T·ln2 · bits_erased",
  units:    "η₁ [1] ▪ η₂ [bit/J] ▪ η₃ [bit/J] ▪ η₃_max ∝ (V_reg/V_env)/(k_B·T·ln2)",
  // CORRECTED 2026-08-08: the source labelled η₃_max DIMENSIONLESS. It is
  // ¬dimensionless — 1/(k_B·T·ln2) carries [1/J]. Declaring units per term is
  // the cheapest guard against this whole class, so they are declared.

  experiment("thermal_efficiency"): {
    material: "LXC 101 — 8 GB, Rust kernel, ollama 7B",
    measure: [
      "input_bits — NATS φ↑ bytes/min + sensor reads/min, from kernel logs",
      "cpu_temp   — @thermal_primary, read DIRECTLY (¬via a chart API)",
      "decisions  — φ↓ count in events.jsonl per minute",
      "cpu_freq   — /sys/devices/system/cpu ⟹ watts, P = C·V²·f",
      "idle_temp  — stop the nucleus, wait 5 min, read base",
    ],
    derive: "ΔT = cpu_temp − idle_temp ▪ Q = ΔT · C_thermal
             ▪ C_thermal ≈ 100 J/K per core (ESTIMATE, ¬measured)",
    predicts: "η₁ ≈ 0.01-0.1 ▪ η₂ < 0.001 — the kernel does far more than
               decide ▪ η₃ is the interesting number",
  },

  implication: "a stable measurable η₃ is the FIRST empirical figure for the
                efficiency of a cybernetic regulator ⟹ compare (Rust kernel vs
                Python loop) ▪ optimize (τ, α, β, γ) ▪ size (CPU per N sensors)",
  novelty: "Conant & Ashby 1970 gives the THEORY — every good regulator is a
            model of the system. ∄ measured η for a real control loop. η
            QUANTIFIES Ashby: η ≤ V_reg / V_env",
  paper: "The Thermodynamic Efficiency of Cybernetic Control: Ashby's Law Made
          Quantitative — connects Ashby 1970, Landauer 1961, Beer 1972 in ONE
          number",
  // The deepest form of the question: does EVOLUTION optimize η₃? A liver also
  // processes information and dissipates heat. Do living systems sit near the
  // Ashby-Landauer limit?
}

// ─────────────────────────────────────────────────────────────────────────
// #3 — SELECTIVE BREEDING OF KERNELS
// ─────────────────────────────────────────────────────────────────────────
// The kernel's 5 parameters (τ, α, β, γ, δ) were CHOSEN. Are they optimal for
// this climate? Viability is already a fitness function — the kernels holding
// Lyapunov negative and recovering fastest from excursions are more viable.

conjecture(3, "selective_breeding_of_kernels") = {

  population: "P = {K₁ … Kₙ} ▪ Kᵢ = kernel instance @ (τᵢ, αᵢ, βᵢ, γᵢ, δᵢ)",
  fitness:    "F(Kᵢ) = 1/τ_rec ▪ τ_rec = post-excursion recovery time
               ▪ excursion ⟺ Lyapunov crosses to positive",
  selector:   "argmax F replaces argmin F",
  mutation:   "each parameter ← parameter + ε, ε ~ N(0, σ²), probability p_mut",
  crossover:  "parameters — weighted mean of two parents ⟹ child
               modes      — 2-point exchange of μₛ between kernels, in ℝ¹²⁸",
  // Mode crossover is the sharper operator: parameters are 5 scalars, the
  // modes are the system's learned structure (#7). Exchanging them asks
  // whether STRUCTURE is heritable, ¬only tuning.

  algorithm: [
    "init N = 10 kernels ▪ τ ~ U(0.05, 1.0) ▪ α,β,γ,δ ~ U(0.1, 0.9)",
    "∀ kernel: run 24h @ LXC 108 (sandbox)",
    "measure F(Kᵢ)",
    "select top 3 ⟹ crossover + mutation ⟹ 10 children",
    "replace the 10 worst",
    "repeat ×10 generations",
  ],
  gate: "A5 ▪ D4-L3 — this MUTATES kernel parameters. Sandbox-only, and a
         promotion out of LXC 108 is a double-loop decision, ¬autonomous",
  // The gate is ¬decoration: a fitness function that rewards fast recovery
  // will happily find parameters that recover fast by ¬detecting excursions.

  predicts: {
    a: "τ converges for this climate — likely τ ≈ 0.3-0.5. Too cold ⟹ rigid,
        too hot ⟹ noisy",
    b: "α (alignment) → ~0.6 ▪ δ (thermal) → ~0.1",
    c: "generational fitness improves ⟹ selection works",
    d: "SPECIALIZATIONS appear — some kernels stable (low τ, high β), others
        adaptive (high τ, high α)",
  },
  novelty: "genetic algorithms for CONTROL exist. Evolving a COMPLETE viable
system — S1..S5, algedonic, covenant — does not. This would be the
            first viable-systems farm, where systems compete for viability",
  implication: "the parameter space has MULTIPLE LOCAL OPTIMA = distinct
                viability STRATEGIES (conservative vs exploratory) ⟹ ∄ single
                optimal kernel, ∃ a NICHE of viable strategies",

  darwinian_reading: {
    natural_selection: "best τ_rec survives",
    variation:         "mutation + crossover",
    inheritance:       "children carry parent parameters",
    population:        "10 kernels = a small metapopulation",
    genetic_drift:     "neutral parameters fix by chance — Sewall Wright",
  },
  // Measuring drift in the NEUTRAL parameters is the sharper test: if it
  // appears, kernel evolution obeys the same laws as biological evolution.
}

// ─────────────────────────────────────────────────────────────────────────
// #4 — RECURSION AS FRACTAL COMPRESSION (IFS of viable systems)
// ─────────────────────────────────────────────────────────────────────────
// Barnsley 1988: an image encoded as contractive affine maps {W₁..Wₙ} whose
// fixed point reproduces it. Compression is enormous (1000:1+) because you
// store the TRANSFORMATIONS, ¬the pixels. Is VSM recursion an IFS, each level
// a contraction over the variety of the level below?

conjecture(4, "recursion_as_fractal_compression") = {

  structure: "V(L) = ⟨S1(L), S2(L), S3(L), S4(L), S5(L)⟩ @ E(L)
              ▪ W(L) = the contraction, ¬a tuple element
              ▪ S3* = a CHANNEL, ¬a subsystem",
  // CORRECTED 2026-08-08, two defects in one line. The source wrote
  //   V_L = (W_L, S1_{L,1} … S1_{L,n}, S2_L, S3_L, S3*_L, S4_L, S5_L)
  // which (a) puts S3* INSIDE the tuple, against the ratification of
  // 2026-08-04 that S3* is a channel, and (b) puts the transformation W
  // inside the object it transforms. Both contradict the primer directly.

  recursion: "S1(parent) = { V_i(child) } ▪ child = parent's L + 1, per A1",
  // CORRECTED 2026-08-08: the source said "each S1_{L,i} can be a complete
  // VSM_{L-1}" — the child carrying the LOWER index, inverted against A1,
  // against primer read(V(L−1), φ↑(V(L))), and against kernel.rs:352
  // (child = self.level + 1). Written in named parent/child roles for the
  // reason vos_proofs §8 was: a named role cannot invert, an index can.

  instance: "80 stations → 5 zones → continental stasis_cos
             ▪ variety flows UP, from the higher L index to the lower",
  contraction: "W: variety(child) → variety(parent)
                ▪ ‖W(x) − W(y)‖ ≤ λ·‖x − y‖ ▪ λ < 1",
  from_lyapunov: "λ = exp(τ · λ_max) < 1  ⟸  λ_max < 0 (stable)",
  // λ is overloaded across this corpus — contraction factor here, Lyapunov
  // exponent as λ_max, trust decay elsewhere (measured 0.10, EXP-TRUST-01).
  // Distinguished by subscript at every use site.

  attractor: "iterating {W₁ … W_N} from any start converges to a UNIQUE
              attractor A = the full viable structure",

  size: "|V(L)| = |W| · (1 + λ + λ² + … + λ^L)
                = |W| · (1 − λ^{L+1}) / (1 − λ)
         L → ∞ ⟹ |V(∞)| = |W| / (1 − λ)          ⟸ λ < 1",
  consequence: "an INFINITELY recursive VSM has FINITE size. The recursion
                converges, ¬diverges",

  predicts: "compress(L) = |V(L)| / |V(L−1)| ≈ λ, CONSTANT across levels",
  worked: "λ = 0.4 ⟹ L0 100% ▪ L1 40% ▪ L2 16% ▪ L3 6.4%
           observed compression today: 38-79% ⟹ λ ∈ [0.4, 0.8]",
  experiment: "build 2 recursion levels with an added climatic S1 and measure
               |V(L)|/|V(L−1)|. Constant ⟹ fractal compression CONFIRMED",
  // Source cited "ITEM-21 of the master plan". MASTER_PLAN.vsm was RETIRED
  // 2026-07-31 and its live content folded into TASKS.vsm — the citation is
  // dropped rather than pointed at a document that ∄.

  implication: {
    self_similarity: "the VSM at city scale ≡ at country scale ≡ at
                      continental scale. Beer knew it: the same pattern recurs
                      at every level",
    fractal_dim:     "d_H = log(N) / log(1/λ) ▪ N = |S1| per level
                      N=5, λ=0.6 ⟹ d_H = 1.609 / 0.511 ≈ 3.15",
    // CORRECTED 2026-08-08: the source computed the same expression as 1.35.
    // log(5)/log(1.667) = 3.15. An arithmetic slip that survived because
    // nothing downstream used the number.
    chaos:           "an IFS produces extreme complexity from simple rules —
                      Barnsley's fern. If VSM is an IFS, system complexity
                      requires ¬design complexity, it emerges from iteration",
  },
  // Beer: "the purpose of a model is to economize on the number of statements
  // required to describe the system." He knew the VSM is a compressor. He did
  // ¬know it is an IFS.
}

// ─────────────────────────────────────────────────────────────────────────
// #5 — DECISIONS AS TIME'S ARROWS
// ─────────────────────────────────────────────────────────────────────────
// A signed decision (Ed25519 + nonce + timestamp + hash(prev)) is
// IRREVERSIBLE: un-signing it breaks the chain, and the break is detectable.
// The irreversibility is ¬decorative — it is WHY the system can be audited.
// Reversible decisions ⟹ ∄ accountability.

conjecture(5, "decisions_as_times_arrow") = {

  domain: "D(t) = {signed decisions up to t}",

  AT1: "|D(t)| monotone increasing ▪ t₁ < t₂ ⟹ |D(t₁)| ≤ |D(t₂)|",
  AT2: "d|D|/dt = the system's IRREVERSIBILITY VELOCITY",
  AT3: "d|D|/dt → 0 sustained ⟹ ¬deciding ⟹ ¬responding to E ⟹ ¬viable",
  AT4: "d|D|/dt is bounded — CPU, throughput",
  // NAMESPACED AT1..AT4 2026-08-08. The source numbered these A1..A4, which
  // collide head-on with the canon's A1..A11 — A1 is the recursion axiom this
  // very document depends on in #4. Every duplicate sweep would have reported
  // them as rival definitions of A1, forever.

  metrics: {
    basal_rate:   "d|D|/dt in homeostasis — basal metabolism",
    peak_rate:    "d|D|/dt during an excursion — decision fever",
    acceleration: "d²|D|/dt² — how fast the system answers a change",
    inertia:      "t(stimulus → first decision)",
  },

  thermodynamic_reading: "the ledger grows BY CONSTRUCTION — append-only.
                          This is ¬a second law",
  // Per review 2026-07-11, verbatim: "Only |D(t)| monotone growth is true —
  // trivially, it is an append-only log. No second law here; cut it."
  // The Shannon entropy of decision-TYPE frequencies can DECREASE when one
  // type dominates. d|D|/dt as metabolic rate is a correct observable; keep
  // that, drop the law.

  tension: "d|D|/dt ≥ 0            — trivial, the ledger grows
            dH(E)/dt ≤ 0           — the system regulates its environment
            ⟹ the difference is NET WORK: variety absorbed to hold integrity",

  age: "|non-ACKed decisions| as the system's THERMODYNAMIC AGE — young ⟹
        few pending, old ⟹ many (governance debt)",
  // Folded from creative_leaps 2026-07-05, WITH its correction: the seed read
  // this as ledger ENTROPY under a second law. There is ∄ second law here
// (review 2026-07-11). Backlog depth is a real observable; the law was not.
  // Bennett 1982 is the honest citation — dissipation is the cost of ERASING
  // information — and this ledger erases nothing.

  experiment: [
    "measure |D(t)| of the algedonic ledger @ LXC 104, 7 days",
    "compute d|D|/dt over 1h windows",
    "correlate against excursions (Lyapunov > 0)",
    "verify: constant in homeostasis, peaks at excursion",
  ],
}

// ─────────────────────────────────────────────────────────────────────────
// #6 — ONTOLOGY OF THE SELF: the system is defined by what it is NOT
// ─────────────────────────────────────────────────────────────────────────
// Ω defines the viable states. A definition by inclusion implies one by
// EXCLUSION. The identity of the system is ¬in its states — it is in its
// FRONTIER. "I am what is inside my limits, but my limits are what define me."

conjecture(6, "ontology_of_the_self") = {

  Def_Self:     "Self = {x ∈ ℝ¹²⁸ | viable(x) per Ω}",
  Def_Frontier: "∂Self = {x ∈ ℝ¹²⁸ | Ω-margin(x) = 0}",

  claim: "identity = ∂Self, ¬Self",
  because: [
    "Self moves — the state travels inside Ω",
    "∂Self is stable — the constraints change slowly",
    "the system knows itself when it knows its limits",
    "the system stops being viable when it CROSSES ∂Self",
  ],

  D_id:    "{d ∈ [1..128] | ∀t near_boundary(x_d(t))}   — constitutive dims",
  D_adapt: "{d ∈ [1..128] | ∃t free(x_d(t))}            — adaptive dims",
  measured: "OMEGA-MARGIN-DIAG ⟹ D_id ≈ {governed, lifecycle, mem_pressure}
             ▪ D_adapt ≈ most of the 128",

  beer: "requisite variety says the regulator must carry as much variety as
         what it regulates. The dual, and the one this conjecture asserts: the
         regulator's IDENTITY is the variety it EXCLUDES",
  // "A viable system is defined by its constraints, ¬its capabilities."
  implication: "identity is MEASURABLE — the dims always near their limit are
                the system's BONES. D_id(t₁) ≠ D_id(t₂) ⟹ ¬the same system,
                whatever the code and the data say",
  governance: "the S5 rules — the covenant — DEFINE D_id. Changing the
               covenant = changing identity. That is why the covenant is
               signed with the same key as the decisions: the signature of the
               covenant is the system's SELF-DEFINITION",
}

// ─────────────────────────────────────────────────────────────────────────
// #7 — LEARNED MODES (dynamic prototypes) — THE DEEPEST
// ─────────────────────────────────────────────────────────────────────────
// The modes μₛ are FIXED today, designed in operator.rs as centroids of
// "ideal behaviour" per subsystem. But the real system does not operate at the
// ideals. The fixed modes are a HYPOTHESIS about the system's structure — and
// the system could TELL US its structure if allowed to learn its own modes.
// That is unsupervised learning INSIDE the control loop: the system clusters
// its own state space while governing itself.

conjecture(7, "learned_modes") = {

  today: "x(t) = Σ wₛ(t)·μₛ          μₛ FIXED, wₛ dynamic
          wₛ(t) = softmax(sₛ/τ)      sₛ = affinity(state, μₛ)",
  kernel_reality: "μₛ are SPARSE FEATURE VECTORS in ℝ¹²⁸, ¬one-hot ideals.
                   operator.rs:279 — μ_S1 = {CPU_PRESSURE 0.5, PHI_UP_RATE 0.8}
                   ▪ μ_S3 = {BUDGET 0.85, PHI_DOWN_RATE 0.7}
                   ▪ μ_S5 = {GOVERNED 1.0, ESCALATION 0.2}",
  // CORRECTED 2026-08-08 against the kernel. The source illustrated the fixed
  // modes as μ_S1 = [1,0,0,0,0] — a one-hot in ℝ⁵. The running kernel carries
  // ℝ¹²⁸ vectors with a handful of nonzero features. The conjecture survives
// the correction; the illustration did not, and it was the kind of detail a
  // reader would have taken for the implementation.

  proposed: "x(t) = Σ wₛ(t)·μₛ(t)    μₛ DYNAMIC
             μₛ(t+1) = μₛ(t) + ε·wₛ(t)·(x(t) − μₛ(t))    ▪ ε ≪ 1",
  derivation: "≡ online k-means, SGD on reconstruction loss
               L = ‖x(t) − Σ wₛ(t)·μₛ(t)‖²
               ∇_{μₛ} L = −2·wₛ(t)·(x(t) − μₛ(t))     — active mode only
               δμₛ = −(ε/2)·∇_{μₛ} L = ε·wₛ(t)·(x(t) − μₛ(t))",

  as_compression: "modes minimizing ‖x − Σ wₛ·μₛ‖ ARE solving online k-means
                   / online PCA ⟹ the system is LEARNING TO COMPRESS ITSELF",
  // This is what ties #7 back to #4: recursion compresses the specification,
  // learned modes compress the experience. Same operation, two substrates.

  properties: [
    "only the most active mode (max wₛ) updates meaningfully",
    "modes that never activate ¬change ⟹ specialization is preserved",
    "E changes slowly ⟹ the modes follow it — STRUCTURAL DRIFT",
    "the modes converge to centroids of the REAL state space",
  ],

  maturana: "living systems undergo STRUCTURAL DRIFT — structure changes
             through interaction, organization is CONSERVED",
  mapping:  "ORGANIZATION = the VSM pattern (S1..S5, φ↑, φ↓, Lyapunov, α)
                          ⟹ ¬changes. It is still a VSM.
             STRUCTURE    = the modes μₛ, the weights, the affinities
                          ⟹ changes with experience",
  varela:   "ENACTION (1991) — the system BRINGS FORTH its own cognitive
