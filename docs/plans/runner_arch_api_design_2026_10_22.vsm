@status ratified


contexto = "RUNNER-ARCH-API-1 (TASKS 5315): diseño de la API de telemetría arch-agnóstica para vOS-como-servidor. Fase 1 local (vsf-scheduled-suite.timer WSL) ya landeada y operando como puente."
runner_natural = "scheduled_suite.py = primer reportero (S3+ 2026-10-20: guardia horaria con 3 fixes de unicode/cd, 0 failed units, family vsf-*)."
status = "proposed — DOC propuesto a ratificación S5; Fase 2 (runtime) queda gated a la aprobación del diseño"

endpoints = [
  "POST /reports/health — estado del ciclo (scheduled_suite, primer reportero)",
  "POST /reports/faults — fault detection (kernel/vosi)",
  "POST /reports/heartbeat — señal de vida del runner (al broker)",
  "GET /inspect/manifest — manifest de runners esperados (referencia cruzada con scripts_manifest)",
]
auth = [
  "token bearer de S5 en config (gitignore-safe via env)",
  "role: broker (solo lectura), service (escritura de reportes)",
]
schema = {
  runner_id: "nombre del runner (system/kernel/…)",
  ts: "ISO 8601 UTC con Z (parametric, get_timestamp)",
  payload: "service-specific (schema a definir en followup T2-F2)",
  tags: "lista plana de run-context (cron/timer/etc)",
}
implementacion = "sin polyglot: Python nativo, mismo runner pipeline scheduled_suite — 0 dependencias de red nuevas"
