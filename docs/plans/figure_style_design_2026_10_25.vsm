⟦ figure_style_design | DESIGN-v1 | vsm-1.2.1 | 2026-10-25T23:46:10Z ⟧

@vsm 1.2.1
@status active

// figure_style_design.vsm — canonical figure standard for the AA paper
// Status: active (S5 rmw3 ratified semantic palette 2026-10-25).
// Evidence: 7 generator scripts, 24 included figures, 88 hardcoded
// fontsize values across 9 sizes, 20 ad-hoc figsizes, 2 mixed visual
// languages (tab10 color vs mono+accent), include widths 0.60-1.0
// \textwidth (printed text between ~4.5pt and ~11pt).

standard = {
  name: "VSF Figure Standard v1",
  source_of_truth: "docs/papers/attractor_convergence/vsf_style.py",
  rule: "no figure script hardcodes fontsize, figsize or hex colors;
         everything resolves through vsf_style (PAL, FSIZE, FS, LW, MS)",
}

typography = {
  family: "Latin Modern Roman (serif, matches paper body) + mathtext CM",
  scale_pt: { title: 9.5, label: 9.0, tick: 8.0, legend: 8.0, annot: 7.5, small: 7.0 },
  rationale: "figures are designed at their PRINTED width, so the scale
              prints as specified (no more 0.72x shrink of 8pt text).",
}

canvas = {
  textwidth: "6.30 in (A4 210mm - 2*25mm margins = 160mm)",
  widths: { full: 6.30, med: 4.54 },   // 4.54 = 0.72 * textwidth
  ladder_in: {
    med: [4.54,3.20], med_sq: [4.54,4.00], med_tall: [4.54,4.80],
    full: [6.30,2.80], full_34: [6.30,3.40], full_45: [6.30,4.50],
    full_sq: [6.30,5.40], comp3: [6.30,7.40], three_d: [5.60,4.40],
  },
  include_rule: "med* -> width=0.72\\textwidth ; full*/comp3/three_d -> width=\\textwidth",
}

palette_semantics = {
  data:  "#0072B2 (blue)   — primary series / measured data",
  alt:   "#E69F00 (orange) — comparison series / interventions",
  good:  "#009E73 (green)  — viability / pass / healthy",
  bad:   "#D55E00 (red)    — failure / limit / stress",
  gov:   "#CC79A7 (purple) — governance / trust layer",
  ref:   "#666666 (gray)   — reference lines / equilibrium",
  aux:   "#56B4E9 (sky)    — auxiliary fourth series",
  greys: "#1a1a1a #4a4a4a #858585 #b8b8b8 #ebebeb — structure, fills",
  colorblind_safe: true,
  value_encodings: "heatmaps / ranked tables use greys or sequential
                    colormaps; semantic hues are reserved for series identity",
}

stroke = {
  data_lw: 1.4, ref_lw: 0.9, thin_lw: 0.6,
  markers: 4.5, grid_alpha: 0.25, grid_lw: 0.5,
  spines: "top/right off", ref_style: "dotted or dashed gray",
}

enforcement = {
  write_time: "scripts import vsf_style and use PAL/FSIZE/FS tokens only",
  review: "grep for fontsize=[0-9] and figsize=( in figure scripts must be empty",
  regeneration: "every figure that has local inputs is re-rendered after a
                 style change; figures whose data lives elsewhere are noted
                 as pending (fig9_topology: n02 tda-data2).",
}

debt = {
  "fig9_topology": "needs n02 ~/tda-data2/traj_full.npy to re-render",
  "tda_script_styles": "scripts/analysis/fig_topology.py + EXP-SOPLO-01/plot_summary.py
                        refactored to the standard; re-render when data is present",
}
⟦ /figure_style_design ⟧
