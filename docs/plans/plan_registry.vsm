// ─── PLAN LIFECYCLE ─────────────────────────────────────────────────────────
lifecycle: "
  1. DETECT  ← gap-resolver identifies component stub
  2. PLAN    ← backbone generates plan.vsm in system/plans/
  3. REGISTER ← plan added to active_plans here
  4. EVALUATE ← socratic-engine validates plan safety
  5. EXECUTE ← backbone implements changes (semi-auto)
  6. VERIFY  ← gate suite + S3* audit confirms closure
  7. LEARN   ← RSI observer records pattern for future
  8. CLOSE   ← plan status → done, removed from active_plans
"

// ─── CLASSIFICATION ─────────────────────────────────────────────────────────
// Plans are classified as type *PLAN-v1* and live in system/plans/
// See classification.local.vsm for directory mapping

