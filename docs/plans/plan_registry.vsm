⟦ plan_registry | PLAN-REGISTRY-v1 | vsm-1.2.1 | 2026-09-07T06:19:20Z ⟧

@vsm 1.2.1
@status active
// system/plans/plan_registry.vsm
// Master registry of all strategic plans in vOSlab
// Separate from current_focus.json (tactical work tracking)
// Plans are .vsm files with formal structure (R16 compliance)

// ─── PURPOSE ────────────────────────────────────────────────────────────────
purpose: "
  Track strategic plans for system improvement.
  Each plan is a .vsm document with phases, success criteria, and auto-verify.
  Plans are detected by gap-resolver and executed by backbone.
  Semi-automatic: human backstop for structural changes (R17).
"

// ─── PLAN STRUCTURE ─────────────────────────────────────────────────────────
plan_schema: {
  required_fields: [
    "plan_id",           // unique identifier
    "gap_ref",           // which gap definition triggered this
    "components",        // affected components
    "phases",            // ordered execution phases
    "success_criteria",  // measurable outcomes
    "auto_verify",       // can system verify completion?
    "auto_execute",      // default: false (R17)
    "rollback_on_fail"   // can system revert?
  ],
  phase_schema: {
    id: "string",
    name: "string",
    status: "pending|active|done|blocked",
    evidence: "string",  // file path or description
    auto_action: "string|null"  // what backbone does automatically
  }
}

// ─── ACTIVE PLANS ───────────────────────────────────────────────────────────
active_plans: [
  {
    plan_id: "CYB-2ND-ORDER-001",
    title: "Second-Order Cybernetics Upgrade",
    gap_ref: "component-completeness#cybernetic-2nd-order",
    status: "active",
    created_at: "2026-09-07T06:19:20Z",
    file: "plan_cybernetic_upgrade.vsm"
  },
  {
    plan_id: "RSI-INTEGRATION-001",
    title: "RSI Bridge Functional Implementation",
    gap_ref: "component-completeness#rsi-bridge-stubs",
    status: "active",
    created_at: "2026-09-07T06:19:20Z",
    file: "plan_rsi_integration.vsm"
  }
]

// ─── PLAN LIFECYCLE ─────────────────────────────────────────────────────────
lifecycle: "
  1. DETECT  ← gap-resolver identifies component stub
  2. PLAN    ← backbone generates plan.vsm in system/plans/
  3. REGISTER ← plan added to active_plans here
  4. EVALUATE ← socratic-engine validates plan safety
  5. EXECUTE ← backbone implements changes (semi-auto)
  6. VERIFY  ← gate suite + S3* audit confirms closure
  7. LEARN   ← RSI observer records pattern for future
  8. CLOSE   ← plan status → done, removed from active_plans
"

// ─── CLASSIFICATION ─────────────────────────────────────────────────────────
// Plans are classified as type *PLAN-v1* and live in system/plans/
// See classification.local.vsm for directory mapping

⟦ /plan_registry ⟧
