// plan/plan-01/plans_active.vsm — the ACTIVE plan set of VSF, fused.
// PH-10 PLAN-01 fuse per directive: active plans only; retired plans
// are DATED RECORDS, NOT-plans. CLAUDE.md is the backlog source, not-these
// docs (doc-sync discipline 2026-07-31: status lives in TASKS.vsm).
// PLAN-TREE 2026-08-15 (rmw3): the STRATEGIC block below is DERIVED by
// scripts/plan/plan_tree.py — live-state projection of this plan's
// organ branches. Wrapped, not replaced: the strategic_frame/horizons/
// per_system blocks remain the strategy source.
// Sources:
//   @src_plan_vitrine     METHODOLOGY_VITRINE.vsm (175) ACTIVE
//   + @src_plan_soc       SOC_XDR_ROADMAP.vsm (199) ACTIVE
//   + @src_plan_proj      STRATEGIC_PROJECTION_2026-07-16.vsm (237)
//   + @src_plan_ceiling   CEILING_ROADMAP_2026-07-16.vsm (259)
//   + @src_plan_catalog   OPEN_SOURCE_CATALOG.vsm (44) ACTIVE
//   + @src_plan_queue     ds_queue.vsm (398) ACTIVE
//   + @src_plan_complete  completion_plan.vsm (532) DATED RECORD (2026-06-12)
//   + @src_plan_gap       gap_closure_plan.vsm (196) DEPRECATED 2026-05-25
//   + @src_plan_papers    paper_strategy.vsm (643) ACTIVE-draft
//   + @src_plan_bbh       bbh_publisher_contract.md (226) INTEGRATION SPEC
// Places cited as RECORD (retired/historical, per 2026-07-31
// consolidation): MASTER_PLAN (retired) · DEBT_CLOSURE_PLAN (historical,
// ≈95% executed) · calibration_autonomy_strategy (historical).
// WATCH (directive): netdata DECOMMISSIONED 2026-08-09 — dead instrument,
// ∅ netdata references carry forward; paper P5 = vsf_anticorruption —
// any other P5 in the papers namespace is a collision (P5.prio = S2/BBH).

plan(PLAN-ACTIVE-SET) {

  structure: "principle → strategic_frame → horizons → critical_path →
              per_system → priorities → soc → vitrine → catalog → queue →
              records"

  principle: {
    source_of_truth: "CLAUDE.md = the backlog. TASKS.vsm = status. These
              docs = framing/rationale/strategy. A plan's status lives
              in TASKS.vsm, flipped in the same commit closing the work."
    active_only:     "a plan that is not being executed is a DATED RECORD:
              cited for lineage, NOT cited as authority (doc-sync)."
    close_when:      "a plan retires when its work lands in TASKS.vsm or
              the roadmap supersedes it. MASTER_PLAN → retired 2026-07-31;
              DEBT_CLOSURE_PLAN + calibration_autonomy_strategy →
              historical 2026-07-31 (≈95% executed)."
  }

  // ── THE STRATEGIC FRAME (proj + ceiling) ──
  strategic_frame: {
    thesis:     "crossed 'looks like a VSM' (detect/alert/wait) → 'works
              like a VSM' (measures itself, closes its own loops). The
              frontier = AUTONOMY: converting validated experiment loops
              into live, bounded, reversible loops. ~3.55/4 ceiling BY
              DESIGN (A5 human-in-loop · Ashby · von Foerster semantic cap)."
    current:    "I=2.48 / A=2.43 (canon 2026-07-16 baseline, ratified in
              q16 review 2026-07-25). Trajectory: 2.48→2.55 (H0)→2.7
              (H1)→3.05 (H2)→3.4+ (H3)→3.55."
    organizing: "Ashby two sides: INPUT variety cheap (add a feed); OUTPUT
              variety is the bottleneck (a viable system regulates by
              ACTING). Milestones measure ACTUATION SURFACES, NOT info feeds.
              Ladder: (0) self-substrate cpu/mem · (1) experimental model
              (info real in, action simulated out — the bridge) · (2) SW S1
              (BBH/2nd nucleus) · (3) physical actuator (nano) · (4) fed-
              eration. Input variety without an actuation surface = dead
              weight: no feed is added without an output to consume it."
    stability:  "rmw3: 'no romper nada en el camino'. Protocol, NOT-brake:
              (1) negative control · (2) viability floor stasis_cos ≥
              0.875 · (3) shadow-first (compute+log, apply-NOT) · (4)
              reversibility · (5) S3* audit of φ↓ + human ACK on envelope
              change (A5 double-loop)."
  }

  // ── HORIZONS (actuation surfaces; status reconciled 2026-07-31) ──
  horizons: {
    H0: { window: "now→weeks", surface: "self-substrate cpu/mem (cgroup)",
      milestones: "M0.1 EXP-S4-01-STRESS ✓ DONE (5/6 pass, H_STRESS_2
              noise-fail = gate working as designed) · M0.2 shadow ✓ ·
              M0.3 live bounded ◐ (Component A/B PRODUCTION 2026-07-31;
              supervised actuation test ran end-to-end incl. real cgroup
              write; Component A autonomous decision on real data still
              pending BASIN_FLOOR recalibration — deferred through storm+
              ENSO window, rmw3 decides if M0.3 counts) · M0.4 S5-PUSH
              ◯ open · M0.5 DEBT_S3b ✓ DONE 2026-06-26 (20ed6cd; effector
              s4_cycle_interval_secs re-verified live 2026-07-31)."
      score_end: "I~2.57/A~2.53", gate: "none external — internal, reversible" }
    H1: { window: "weeks→months", surface: "experimental models (clima
              multi-zone, econ)", milestones: "M1.1 S4-MULTI-S1 live ·
              M1.2 3rd/4th experimental domain · M1.3 S2 real coordination
              ◐ (EXP-S2-01 validated anti-oscillation clima+econ 2026-06-30,
              but full credit needs a GENUINELY distinct domain = BBH,
              R6-gated — mechanism proven, credit still gated) · M1.4
              Lyapunov-local.",
      score_end: "I~2.7/A~2.7", gate: "H0 proven", caveat: "action still
              simulated — trains the regulator where error is free" }
    H2: { window: "months", surface: "FIRST REAL actuation: (a) BBH SW-S1
              or (b) nano physical (ATmega328P, real ℝ² loop)", milestones:
              "M2.1 first external S1 coupled with real output · M2.2 S3*
              audits external φ↓ · M2.3 bounded autonomous real action
              (BBH write under M7/HMAC or nano) · M2.4 loop closes over a
              real environment.",
      score_end: "I~3.0/A~3.1 — THE BIG JUMP", gate: "H0+H1 proven · M7
              security · R6 internal-first cleared · rmw3 S5 sign-off.
              NOT accelerated: cross when the autonomous interior is proven",
      caveat: "the hard step rmw3 named — simulated→real is the threshold" }
    H3: { window: "long term", surface: "federation — coordinated action
              across multiple VSM (VSI protocol, recursion)", milestones:
              "M3.1 VSI/1.0 · M3.2 operational recursion (DSN-EVC-01 live)
              · M3.3 genuine federation ≥2 VSM · M3.4 approach ceiling.",
      score_end: "I~3.4/A~3.4 → 3.55", gate: "H2 proven", caveat: "3.55→4.0
              unreachable by design — feature, NOT omission (paper §Beer)" }
  }

  // ── THE SPINE: S4 critical path (proj critical_path + status) ──
  critical_path: {
    rationale: "S4 = largest AND most actionable gap. Converting the
              validated loop to live moves S4 (2.2→~2.6) and drags S3."
    status:     "STRESS ✓ DONE → SHADOW ✓ DONE → LIVE ◐ (production flip
              + supervised actuation test 2026-07-31; autonomous first
              decision deferred — storm window, BASIN_FLOOR=0.875 intact)."
    step_1_STRESS: "adversarial harness (load/noise/degenerate inputs).
              Exit: precision + honesty under stress. Risk 0 — harness."
    step_2_SHADOW: "compute+log the reallocation, apply-NOT; compare
              against what really happened. Exit: shadow would have helped
              (or not harmed). Risk 0 — observes only."
    step_3_LIVE:  "bounded autonomous actuation: zero-sum cpu shares,
              magnitude bounded, floor 0.875, reversible, S3* audits φ↓.
              Requires rmw3 ACK (envelope change, A5 double-loop)."
  }

  // ── PER-SYSTEM PROJECTION (now I/A → ceiling → next) ──
  // Scores written I=n/A=n, NOT In/An: bare `A2.2` matches the AXIOM namespace
  // (A1..A15) and the identifier index read six scores as rival axiom
  // definitions. The document's own strategic_frame already used the `=`
  // form — this block was the inconsistent one. Rubric §namespacing.
  per_system: {
    S4: "I=2.3/A=2.2 → 3.8. Gap 1.6 = LARGEST + most actionable. Next:
        DEPLOY-S4-MULTI-S1 (synthetic→live). Guard: zero-sum, shadow,
        floor, bounded, reversible, audited."
    S5: "I=2.0/A=2.4 → 3.5. Gap 1.1; LOWEST I. Next: S5-PUSH (async
        notification on pending_human — closes human-in-loop latency).
        Guard: notification, NOT action."
    S3: "I=2.3/A=2.8 → 3.4. Gap 0.6. Rides S4 (arrastre); DEBT_S3b ✓ closed
        (was the between-session application gap)."
    S3*:"I=2.8/A=3.0 → 3.5. Gap 0.5 = smallest; most mature. Residual:
        FLAP false positives + phantom locks; tier-4 n01 audit deferred."
    S2: "I=2.2/A=1.7 → 3.3. Gap 1.6 but GATED: needs N≥2 GENUINELY distinct
        S1 domains (BBH) — R6 internal-first + M7. DO NOT FORCE. The gate
        IS the stability guard."
    S1: "I=3.3/A=2.5 → 3.8. Near its PRACTICAL ceiling with current domains.
        A-gap = potential with more external domains, NOT current debt."
  }

  // NAMESPACED: the papers programme also runs P1..P5 (P1 =
  // attractor_convergence … P5 = vsf_anticorruption). Bare Pn would collide
  // with it in every duplicate sweep. Rubric §namespacing — flagging a
  // collision is NOT resolving it.
  priorities: {
    P1.prio: "S4 critical path STRESS→SHADOW→LIVE (spine; started, ◐ live)"
    P2.prio: "S5-PUSH — parallel, closes human latency, raises lowest I"
    P3.prio: "DEBT_S3b ✓ closed 2026-06-26 (STRATEGIC_PROJECTION's P3 is a
        stale-copy discrepancy, HANDOFF resolved)"
    P4.prio: "FLAP calibration — when slack, [S] light"
    P5.prio: "S2/BBH — GATED (R6+M7). Review only after P1 live + P2."
    P5.paper: "vsf_anticorruption (papers slot P5.paper) — the roadmap
        P5.prio is a DIFFERENT P5 (S2/BBH gated). Slot collision flagged,
        NOT merged."
  }

  // ── SECURITY DOMAIN: H2 CANDIDATE (soc, CEILING soc_integration) ──
  soc: {
    role:   "security = the concrete H2 candidate: SIEM input · SOAR output
            (the H2 crossing) · XDR multi-domain (H2→H3). Wazuh=S1,
            nucleus=S3/S4/S5. DEFENSIVE = A0-aligned, reversible"
    not_now:"critical path stays H0. Stage A (SIEM read-only, φ↑ only) can
            overlap early with H1 — no output risk. NONE executed yet
            (verified 2026-07-31: no Wazuh/Suricata/Zeek/Arkime units, no
            SOC VLAN declared)."
    decisions: {  // rmw3 2026-07-16, all resolved
      n02:    "COMPLETE system on n02 — DELIBERATE co-location with the
              nucleus = the resilience experiment (regulate UNDER real
              load). Gauge: OMEGA-MARGIN/stasis_cos live."
      n03:    "external node (other network/city, permanent VPN) = XDR
              client + recursive experimental VSF. THE H2 crossing."
      n01:    "link after n03 (SPOF of n02 access — delicate)."
      wsl:    "eventual node; major engineering; gated on physical-memory
              saturation (not distant)."
      stack:  "Wazuh 3 VMs (indexer/server/dashboard) + Suricata/Zeek/
              OwlH/Arkime if capacity. Elasticsearch = the RAM hog — its
              optimization is CRITICAL (lives on the same box as the
              nucleus), study [O/S] BEFORE scaling."
      fractal:"the SOC stack is itself a NESTED VSM (each VM an S1) —
              recursive VLANs/firewalls; the recursion claim made INFRA."
      response_floor: "now: everything scales (learn); target: calibrated
              so only ACTIONABLE reaches the human. Reversible+bounded →
              autonomous; destructive (brick/wipe/isolate-prod) → human.
              Matures A5 WITHOUT lowering the ceiling."
      staging:"A SIEM read-only → B SOAR shadow (compute+log, apply-NOT) →
              C SOAR live (H2 crossing, rmw3 ACK A5) → D XDR."
    }
    offensive: "BBH-LAB: SOC-first, offense after. BBH-1..4 sub-branch
              (study → [O] contract → mature under VSF → integrate with
              SIEM). BBH-state: lab stable; the gap = its governing agent
              (NOT hacker-skilled). A0 hard: own/authorized targets only."
  }

  // ── METHODOLOGY VITRINE (theme D reframe; state-canon shipped) ──
  vitrine: {
    reframe:"first RELEASE = the development model vitrine (2 agents +
            intelligent control) in world-known forms (MCP/skills/RAG),
            not-3 convergent libs (those demoted to a later wave)."
    thesis: "industry pushes agent swarms ('more agents = better'); we are
            the counter-proof: careful work with TWO agents + ground-
            anchored control does more with less (fewer tokens, better
            work)."
    elements:{  // the 5, observed 2026-07-20
      rag_de_estado:   "★ THE JEWEL: a STATE-RAG — canonical store written
            on every change + reconciler (model≡reality, anti-orphan) +
            onboard that INJECTS current state into the LLM's decision
            path. The agent CANNOT not see ground truth."
      control_2_agentes:"[O] reason/architecture (S3-S5) + [S] execute (S1)
            + human-S5; framed handoffs + INDEPENDENT verification at
            every boundary = the vsm_role_agents contribution."
      skills:  "portable disciplines: verify-live-not-report · confirm-first
            · work-gated-liveness · R4-deploy · loud-death · surface-debt."
      mcps:    "delivery forms: state.query/onboard/verify/reconcile +
            memory.search. Any external agent gets anchored context."
      token_savings: "the quantifiable pitch: anchor-don't-re-derive ·
            model tiering · compact notation (VSL) · query-don't-re-read."
    }
    anchor:  "state-canon-mcp (github.com/rm-w3kufe/state-canon-mcp,
            PUBLIC — the canonical repo; projects/ copy removed 2026-07-27,
            STATE-CANON-MCP-MIGRATION). C0/C1/C2 measured 2026-07-20:
            C1-onboard 553 tok broad · C2-MCP ~429 narrow · C0-cold ≈
            592-650 (always loses) · correctness 10/10 · behavioral find-
            ing: agents default to the BROADEST tool → cost hints
            EXPENSIVE/CHEAP added. Hybrid optimum: C1 session-start + C2
            follow-ups. Still needed for publishable number: real attach +
            billed counters + per-task isolated sessions."
    license:"Apache-2.0 code + CC-BY-4.0 docs (deliberately more permissive
            than core AGPL — vitrine = adoption)."
    paper:  "SEED 'State RAG: Reconciled Ground Truth as Agent Context'
            (systems/tooling; NOT competing with P1.paper..P5.paper). Gated on: public
            launch ✓ (repo public) + publication-grade numbers + realistic
            corpus. (per 2026-07-31 addendum: launch done, grades pending)"
  }

  // ── OPEN-SOURCE CATALOG (the menu, NOT the order) ──
  catalog: {
    principle: "substance = core libs; skills/agents/MCPs = delivery
            forms. Triage: ✓ open · ◐ decouple first · ✗ gated.
            Gate: extract → decouple → scrub → cargo --locked → checklist
            Z → open."
    A_content:    "aphid ✓ · encyclopedia_eng ✓ · knowledge_rag ◐→template"
    B_trust:      "vsl ✓ · verifiable_log ✓ (★ canonical_hash+Merkle+
            diverse verifier) · reconciler ◐ · validator ✓"
    C_disciplines:"skill_verify ✓ · skill_breaks ✓ · skill_loud_death ✓
            · skill_r4_deploy ✓ · vsm_role_agents ◐ (the NOVEL meta
            contribution — abstract from our infra)"
    gated:        "kernel vOS (behind papers) · infra n02/tokens/keys ·
            BBH/offensive · covenant (semi-public)"
    first_release:"Verifiable Systems Toolkit = aphid + VSL + verifiable_log"
  }

  // ── DS EXECUTION QUEUE (queue.vsm — the working set) ──
  queue: {
    note: "the framed prompt per item is built at ASSIGNMENT, NOT here.
            Open high-priority: q8 NATS-RESILIENCE (P1, pilot validated on
            markov-bridge; rollout gate = publisher false-kill check on
            core clima BEFORE 87×L3) · q17 CONDITION-VS-EVENT (P1) · q19
            MASKED-ALERTS-RCA (P1, parallel q17) · q20 S4-OFF-DOMAIN-
            DECISIONS (P1, measure-don't-fix; blocks q16 rescore S4 dim
            and q19.B veto ordering). P2: q18 FRONTIER-HANDLERS (after
            q17) · q11 POPULATE-CADENCE. P3: q15 OMEGA-CAL (phase_1
            remains) · q16 SCORE-RESCORE-V2 (repair order F2→F1→F4/F5
            from O review). P4: q9 SEMANTIC-DIVERGENCE-RCA · q12 CHAIN-
            BLANK-LINES · q14 RESTART-L3-KILL-RACE. P5: q5 SAMPLE-RATE.
            P6: q6 NOISE-VERIFY (needs O spec). P7: q7 BBH-1-SURVEY (R6,
            read-only)."
    algedonic_arc: "q17+q18 make the channel readable; q19 fixes what it
            was hiding. Baseline: attenuation 12% / escalation 83% /
            evidence-closure 6%, 2587 pending, 0 closed in 24h."
  }

  // ── DATED RECORDS (retired/historical plans) ──
  records: {
    completion_plan: "2026-06-12 (rmw3+S, approved). Phase-ordered
            completion plan. STATUS: largely executed; its pieces landed
            as TASKS.vsm tasks. Kept as lineage — resurfacing a phase as
            PLANNED work would be doc-drift."
    gap_closure:     "2026-05-09 (Claude+Qwen via rmw3). DEPRECATED
            2026-05-25 (canon moved to GAPS_AND_DEBTS then
            TASKS.vsm). Reasoning-first methodology (reason → inquiry →
            calibration → experiment → L3). T1-T4 + G1-G5 closed by
            negotiation; methodology validated (0 L3 escalations). Kept
            for the method."
    papers_strategy: "2026-07-05 (DS draft, for [O] evaluation). AC
            attractor_convergence: Option A (η₃ + d|D|/dt + FPR, ~7h,
            strengthens preprint) recommended FIRST, then Option B (second
            paper: thermodynamic/immunological extensions, 2-4 weeks).
            Status: AC v0.5→defensible per roadmap; P5.paper = vsf_anticorruption
            assigned. Maturana-Varela connection = Discussion paragraph
            (AC) / central (NP). Algedonic-ledger finding updated by the
            later algedonic arc (q17-q19)."
    bbh_contract:    "2026-05-25. VSF γ.9 bbh_subscriber (LXC 101) awaiting
            first bbh.> message; subject hierarchy bbh.<instance>.<channel>
            .<event_type> → events.jsonl with system_id=bbh; phase field
            mandatory for Markov analysis (B0_..ABORT). INTEGRATION SPEC,
            NOT execution — BBH coupling remains R6-gated."
  }
}

