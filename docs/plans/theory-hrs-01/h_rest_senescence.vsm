// plan/h_rest_senescence.vsm — what law governs H_rest drift?
// PROPOSED: hypotheses awaiting S5 review. ¬established results.
// author: Claude (Opus), VSF session 2026-06-22
// prerequisite for: Wave 2 of @src_scaffolding_register (the H_rest = L gap)
//                   ▪ EXP-SEN-01
// closes the register's question: what IS resting entropy,
// and why should it age?
// A genuine open RESEARCH question — small code, hard theory.

gap = {
  symptom: "the Lyapunov senescence term δ·ReLU(H_rest_drift) ≡ 0, because
            H_rest is a COMPILE-TIME constant: 0.20·log₂4 = 0.400
            ⟹ the model CANNOT account for senescence",
  but:     "fig4 (attractor_convergence) OBSERVES senescence:
            DKY drops ~15% over 3600 ticks under sustained load
⟹ observation ∧ governing equation do not touch",
  paper:   "main.tex §thermalsenescence + §OpenQuestions Q2: genuine senescence
            requires EITHER (a) H_rest adaptive, OR (b) external stressors over
            wall-clock hours",
  class:   "RESEARCH, ¬engineering. The code change — H_rest as an updated
            field — is trivial. The LAW it should follow is the open question.
            Hence this note BEFORE the change",
}

definition = {
  H_t:    "H(t) = −Σ pᵢ·log₂ pᵢ — entropy of the organelle-activation
           distribution",
  H_max:  "log₂(N_organelles) — full disorder. N = 4 here ⟹ H_max = 2.0 bits",
  H_rest: "the entropy the kernel SETTLES TO at its attractor.
           ¬zero — a living system is ¬frozen.
           ¬H_max — it is regulated.
           ⟹ the homeostatic SET-POINT between order and disorder: the
             irreducible resting metabolic entropy held while viable",
  senescence: "the DRIFT of that set-point over a lifetime.
               Biological reading: aging = losing the ability to hold low
               entropy. H_rest creeps toward H_max as the repair machinery
               wears.
               ReLU fires only on UPWARD drift
               ⟹ senescence = monotone decay of order-MAINTENANCE capacity",
}

// ─── THREE CANDIDATE LAWS ─────────────────────────────────────────────────
// ¬mutually exclusive. Three SOURCES of accumulated irreversibility, each
// with a distinct test. Ordered by theoretical grounding and by how much
// existing programme they connect to.

law(A, "Landauer / soplo") = {
  claim: "H_rest degrades in proportion to cumulative IRREVERSIBLE homeostatic
          work",
  form:  "dH_rest/dt = κ_A · soplo_rate · (1 − H_rest/H_max)",
  reads: "each soplo — a homeostatic correction pushing state back to the
          attractor — is an irreversible information-write costing ≥ k_B·T·ln2.
          The (1 − H_rest/H_max) factor SATURATES the drift at max disorder",
  kappa: "κ_A = senescence coefficient per soplo. To be fitted",
  first_because: "thermodynamically grounded ▪ makes senescence a MEASURED
                  CONSEQUENCE of the kernel doing its job — it ages BECAUSE
                  it regulates ▪ directly testable vs EXP-SOPLO-01
                  ⟹ most defensible, most connected",
  connects: "EXP-SOPLO-01 ▪ §sec:maxwell (Maxwell demon, observer
             constitutivity) ▪ P3 open systems",
}

law(B, "damage accumulation") = {
  claim: "H_rest drifts with cumulative external stress-time — the paper's T·t
          damage function",
  form:  "dH_rest/dt = κ_B · stress(t)   ⟹   H_rest_drift = κ_B · ∫ stress dt",
  reads: "generalises the thermal damage law, damage ∝ T·t. Senescence tied to
          environmental LOAD, ¬internal work",
  kappa: "κ_B = coefficient per unit stress-time. Distinct quantity ∧ distinct
          units from κ_A",
  status: "EXP-TSM-01/65C showed ∄ drift — BUT that run had CONSTANT H_rest,
           which is the very gap. With H_rest adaptive, re-running sustained
           thermal would actually test B",
}

law(C, "model mismatch") = {
  claim: "H_rest rises when the calibrated stasis_vec diverges from the actual
          (moving) environment — the internal model ages relative to the world",
  form:  "dH_rest/dt = κ_C · D(stasis_vec, environment(t))",
  reads: "OPEN-SYSTEM senescence: the kernel's compressed model of its niche
          goes stale as the niche moves",
  kappa: "κ_C = coefficient per unit model-world divergence",
  connects: "EXP-NB-01 step 8 — turn off the room light ▪ the paper's
             'no external environment' limitation",
}
// NAMESPACED κ_A/κ_B/κ_C 2026-08-08.
// The source used a bare κ across all three laws — three quantities,
// three units, one symbol.
// Fitting one and reporting it as κ = a silent error.
// The laws are explicitly ¬rivals ⟹ all three coexist.

unifying_frame = "H_rest is the homeostatic entropy SET-POINT. It drifts as
  the kernel accumulates irreversibility through three channels: its OWN
  corrections (A, Landauer) ▪ external LOAD (B, damage) ▪ MODEL-WORLD
  divergence (C, open system).
  Senescence = the set-point losing its grip on order.
  The three are testable CHANNELS, ¬competing hypotheses."

// ─── TEST DESIGN — two substrates ─────────────────────────────────────────

tests = {
  nano_bench: {
    where:   "EXP-NB-01 vOS-nano — ℝ², ATmega328P. The CHEAP bench",
    why:     "the nano's H_rest is ALREADY real-calibrated (phase_1),
              ¬a compile-time constant ⟹ adaptive is a few lines.
              It counts its OWN corrections (PWM Δ / recalibs = soplos)
              ▪ step 8 changes the environment
              ⟹ tests A ∧ C on bare metal, visibly, ∄ OS confound",
    measure: "correlate H_rest drift vs cumulative soplo count (A) and vs
              environment change (C). Does the kernel RECALIBRATE — absorb —
              or collapse to non-viable?",
    leverage:"answers the paper's senescence AND external-environment questions
              on real physics. Also the P4 link: the nano is where D_eff = 2",
  },
  rust_EXP_SEN_01: {
    where:   "the ℝ¹²⁸ nucleus — the headline experiment the register names",
    change:  "replace the compile-time H_rest constant with a state-derived
              running quantity drifting per the chosen law. Start with A",
    success: "δ·ReLU(H_rest_drift) becomes NONZERO and its trajectory MATCHES
              the observed DKY drift (fig4, −15%) ⟹ model and observation
              reconciled, gap closed",
    gate:    "a Rust kernel change ⟹ build + certify on LXC 108 (R1 — never on
              WSL). Spec first: EXP-SEN-01/spec.vsm",
  },
}
// The source had ∄ comma between these two blocks. The parser accepted it;
// the grammar does not promise to.

unblocks = {
  paper:    "the deepest open question — senescence δ ≡ 0 ▪ moves the claim
             from observed-but-unexplained to observed-AND-governed",
  program:  "ties senescence → Landauer/soplo (P3) → the nano (P4 bench) into
             ONE mechanism",
  register: "satisfies the Wave-2 prerequisite — H_rest adaptive, PRECEDED by
             a theory mini-arc",
}

