@vsm 1.2.1
@status active

@vsm 1.2.1
@status active

// lesson_capture — PROTOCOLO O1 (capture-on-demand formalizado).
// P-A-LEARN-DISTILL: S5 rmw3 eligio O1 2026-10-15 (techo INTACTO: S5 es el
// unico emisor). Diseno ratificado en docs/plans/autonomy_ceiling_proposals.vsm
// (propuesta_A + ratificacion_P_A); aqui vive el template canonico y el
// contrato de las contenciones C1-C5. Problema que cierra: lecciones
// conversacionales (decisiones S5 con matices/porques/alternativas) que se
// pierden entre compactaciones — el aprendizaje institucional no es write-only.

protocol = {
  emitter: "S5 (rmw3) — unico emisor; el comando rechaza cualquier otra via",
  comando: "python3 scripts/state/lessons/lesson_capture.py --lesson '<json>'",
  storage: "state/lessons/<lesson_id>.vsm (archivo versionado por leccion) + index state/lessons/index.jsonl",
  template: {
    required: ["claim", "porque", "alternativas", "fuente_ts", "session_id"],
    optional: ["scope", "reconfirm_by"],
    claim: "que se aprendio / que decision sostiene (1-3 frases)",
    porque: "evidencia o razon (cita ts+session_id del log fuente)",
    alternativas: "que se descarto y por que (R9: no silenciar)",
    fuente_ts: "ts ISO-8601 UTC del log fuente",
    session_id: "sesion donde ocurrio la leccion",
    lesson_id: "lc-<fuente_ts compact>-<slug corto>",
  },
  gates: {
    C1: "sin fuente_ts + session_id = RECHAZA (provenance obligatoria)",
    C2: "max 3 lecciones por sesion — el 4to RECHAZA (el resto es nota cruda)",
    C3: "decay 30 dias sin re-confirmacion -> archived (reconfirm_by = fuente_ts + 30d)",
    C4: "--stats hoy; seccion LECCIONES en evolution_report = integracion O2",
    C5: "revert = quitar <lesson_id>.vsm + su fila del index (git revert del archivo)",
  },
  preguntas_s5_resueltas: {
    q1: "clases: solo decisiones-S5 con done_when cerrado (O1 acotado; observaciones/tacticas entren en O2+)",
    q2: "viven en state/lessons/ con index (archivo por leccion, versionado, git-visible)",
    q3: "firma: rmw3 (S5) emite; el comando solo valida y persiste (sin firma no entra)",
    q4: "obsolescencia: C3 con ventana 30 dias",
    q5: "graduacion: O1 primero; evaluar O2 tras 2 semanas de uso con tasa de recuperacion en post-compact como metrica",
  },
  graduation: "O2 (extractor->drafts en approval queue) solo tras 2 semanas de O1 con evidencia de uso",
}
⟦ /lesson_capture_protocol ⟧
