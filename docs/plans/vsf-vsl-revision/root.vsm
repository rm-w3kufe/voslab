// */spec_revision/revision_plan.vsm — WORK PLAN: VSL revision → canonical tree
// Status: proposal — NOT canonical. Root of the revision workspace.
// Ordering principle (rmw3 2026-08-05): never particular→general; go from the
// most axiomatic/declarative (boot) toward the branches (ramas → instance).
// Sources = worklist VSF-VSL-WORKLIST-v1 (translate/fuse/migrate queues).

plan("VSF-VSL-REVISION-v1", source=["VSF-DOC-CENSUS-v1", "VSF-VSL-WORKLIST-v1", "INSTANCE-LAYER-v1"]) = {

  // ── ORDERING PRINCIPLE ──
  ordering: "
    boot  →  meta  →  theory  →  ramas (s5→s4→s3→s3star→s2→s1)  →  infra  →  plan  →  spec  →  instance
    From most axiomatic/declarative to the branches.
    Ramas order = generalidad constitucional decreciente: s5 (policy, most
    constitutional) first, s1 (operations) last — s1_spec depends on S3
    calibration/omega sources and is the largest fuse group.
    instance last: contracts reference the branch specs.",
  rationale: "
    boot:    axioms — already ratified; PH-00 reviews coherence, not translation.
    meta:    the language every other doc is written in — before any creation.
    theory:  core theory + proofs + migrated legacy specs — before branches
             because S1-S5 system docs (docs/theory/systems/*.md) fuse into it.
    ramas:   each S-function gets its canonical doc, from a fuse group.
    infra/plan/spec: operational artifacts, after the functional core.
    instance: values + contracts — depends on the branch specs it instantiates.",

