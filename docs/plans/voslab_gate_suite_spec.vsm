// Source: vsf@838d4fc1 child/docs/voslab_gate_suite_spec.vsm — original header timestamp 2026-08-28T21:30:00Z  // hardcoded-allow: historical upstream header, record fidelity
// Promoted to vOSlab 2026-10-01 (S5 rmw3 directive: promote)

// PROPOSAL: vOSLAB pre-commit gate suite — built clean from day 1.
// Context: vsf's gate suite was comprehensively broken by accumulated parent
// WIP (≈19 gates). Repairing all of them in vsf is futile (rmw3 S5 2026-08-28:
// "se vuelve una tarea algo fútil"). vOSLAB is the clean-slate pivot (→ vOS/
// prod → vOS VM on N02). The LESSON is: build vOSLAB's gate suite correctly so
// the corrosion does not propagate. This doc captures what vsf's gates 8-19
// were, and the defects found, so vOSLAB does NOT repeat them.

// ═══════════════════════════════════════════════════════════════════════════
// 1. GATES SUPERSEDED IN vsf (do NOT port as-is; rebuild cleaner in vOSLAB)
// ═══════════════════════════════════════════════════════════════════════════
superseded_gates() {
  ontology_master:      "3 gates (coherent/frame/trace) — catalog of sandbox specs; only useful if it does not lie. Heavy, parent-WIP-coupled.",
  vsl_gate:             "inter-agent VSL prose gate (R15) — keep, but verify the plugin's exported regexes are the SINGLE source (drift guard done right).",
  agent_plugin_path:    "no hardcoded absolute repo paths in plugins — keep.",
  agent_plugin_log:     "logs/agent_plugin.jsonl valid JSONL + instruments present — keep, but the check must actually RUN (dead-code lesson).",
  write_gates:          "write-time gate registry valid — keep.",
  design_sources_index: "INDEX.vsm covers 100% of design-sources/ — keep (orphan/fantom guard).",
  archive_index:        "INDEX.vsm covers 100% of archive/ — keep.",
  vsl_encoding:         "encoding CYCLE discriminates (RE_TIMESTAMP present, date-only REJECTED) — keep, foundational.",
  vsl_timestamp:        "FASE-1-ENFORCEMENT: all headers UTC timestamp — keep.",
  vsm_version_coherent: "@vsm == header version — keep, but DECIDE one canonical version (vsf drifted 1.0/1.2/1.2.1).",
  compression_drift:    "ledger ≡ disk — REPORT not block (pre-existing debt) — keep as report-only.",
  incident_registry:    "register status is truth (R7) — keep, BLOCK.",
  crl_expiry:           "S5 CRL near-expiry reminder (root key offline) — keep, ALERT only.",
  ratified_version:     "staged ratified doc on canonical version — keep.",
  version_change_plan:  "emit migration tasks when canonical root bumps — keep as emit-only.",
  learning_record:      "§6 standard (learning_record() + vsm-1.2 + required fields + deferral escape-hatch) — keep, but ENFORCE at generation time (see §3).",
  child_refs_notify:    "R13 dispatch envelopes need canonical footer — keep, ENFORCE at generation.",
}

// ═══════════════════════════════════════════════════════════════════════════
// 2. DEFECTS FOUND IN vsf (vOSLAB must not repeat)
// ═══════════════════════════════════════════════════════════════════════════
defects_found() {
  d1_orchestrator_misdetect: "symbol_table.py --gates mis-classified socratic-engine trees as LOOP-CLOSURE/RECURSION; grep-heavy orchestrator scan produced false positives. vOSLAB: use precise classification regexes, not greedy globs.",
  d2_r18_regex_dots:        "verify_status.py / verify_versioning.py used header regex (\\w+) which rejected dotted names (e.g. s3-operations). vOSLAB: use ([\\w.]+) for header tokens.",
  d3_check_negative_control: "checks/plugin-location-valid has a BROKEN negative control (fail-mode passes when it should fail) → cannot tell true from false. vOSLAB QUALITY BAR: every check MUST discriminate (run both pass and fail modes in CI/pre-commit).",
  d4_generated_spanish:     "update_scripts_manifest.py emitted Spanish keys (archivos/dependencias) + literal {now} placeholder in footer. vOSLAB: generators emit the canonical language + valid ISO timestamps; never a {now} literal.",
  d5_unclassified_corpus:   "new docs without classification.local.vsm rules failed classification gate. vOSLAB: classification is MANDATORY at creation (leaf-rule: every dir has classification.local.vsm).",
  d6_language_policy:       "parent WIP docs (rsi_roadmap, plugin_arch_policy, scripts_state_manifest) were Spanish. vOSLAB: single-language corpus enforced from commit #1 (D7 from start).",
}

// ═══════════════════════════════════════════════════════════════════════════
// 3. vOSLAB GATE-SUITE DESIGN PRINCIPLES
// ═══════════════════════════════════════════════════════════════════════════
design_principles() {
  p1_single_canonical_version: "pick ONE @vsm version at init (recommend vsm-1.2.1) and enforce vsm-version-coherent from day 1.",
  p2_checks_discriminate:      "no check is admitted without a passing negative control (fail-mode exits non-zero on the false claim). Gate the gate.",
  p3_generators_conformant:    "every generator (manifests, learning_records, dispatch envelopes) emits valid VSM + English + ISO timestamps; run the gate on generator OUTPUT in CI.",
  p4_language_from_start:      "D7 language guard ON from commit #1; no Spanish Creeps in.",
  p5_classify_at_creation:     "classification.local.vsm leaf-rule enforced; an unclassified doc cannot be committed.",
  p6_scope_to_owned_corpus:   "gate suite tests ONLY the corpus vOSLAB owns; parent/WIP artifacts are out of scope (unlike vsf's all-encompassing suite).",
  p7_reversible_skip:          "if a gate is ever superseded, wrap it in an env-guarded block (VSF_RUN_SUPERSEDED_GATES pattern) — never delete gate logic silently.",
}
⟦ /voslab_gate_suite_spec ⟧
