⟦ trace_graph | PLAN-v1 | vsm-1.2.1 | 2026-09-30T19:19:06Z ⟧

@vsm 1.2.1
@status active

// trace_graph — permanent graph capability over state/rsi/tree_traces.jsonl
// Approved by rmw3 (S5), 2026-09-30: capability of the system, not a script.

task("TRACE-GRAPH") = {
  status: active,
  owner: "vos-kernel",
  input: "state/rsi/tree_traces.jsonl",
  views: ["per-trace: exact evaluation tree (local node_ids)",
          "aggregate: canonical skeleton + traversal weights"],
  exports: ["dot (graphviz interchange)", "json nodes/links (gephi/d3)",
            "networkx DiGraph (notebook: nx + matplotlib render path)"],
}

// Invocation (permanent CLI):
//   python3 scripts/vsl/tools/trace_graph.py list
//   python3 scripts/vsl/tools/trace_graph.py export --tree <family> --format dot|json [--out f]
//   python3 scripts/vsl/tools/trace_graph.py show --trace <id> --format dot|json
// Notebook API:
//   from trace_graph import load_traces, aggregate, per_trace, to_dot, to_json, to_networkx

// Identity rule (R10): aggregate nodes key on the recorded VSL text (F3),
// never on the per-trace local node_id. Pre-F3 rows without text key on
// type:name and meta reports keyed_by_text / keyed_by_fallback — honesty
// denominators, fallback nodes get a blue border in DOT. Homes are a
// TRACE-LEVEL attribute: shown in meta, never as fake structural edges.
// Loading never fails on old row shapes; malformed lines are counted as
// skipped, never silently dropped.

// Determinism: all exports sorted-iteration only, no randomness; same
// input yields byte-identical output (tests assert it).
// Tests: packages/framework/trace_graph/tests — 24 green on synthetic
// fixtures (no dependency on the runtime JSONL).
⟦ /trace_graph ⟧
