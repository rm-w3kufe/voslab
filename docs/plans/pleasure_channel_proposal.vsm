⟦ pleasure_channel_proposal | PROPOSAL-v1 | vsm-1.2.1 | 2026-10-07T21:55:49Z ⟧

@vsm 1.2.1
@status ratified

// RATIFICADO por S5 2026-10-07 (orden 'hagamos la ronda completa'):
// milestones N=3,5,8 + diseno completo (R10, F2 asimetria, R17 guard).
// EJECUTADO 2026-10-07 (W-5 bloque_3, orden S5 'esta orden habilita'):
// P1..P5 completas — canal vivo en state/rsi/pleasure.jsonl, feedback
// hebbiano con techo, narrativa (report+onboard), check+gate
// pleasure-channel (manifest 82, NC 23/23). auto_execute: false (sin
// cambios). Evidencia: plan_registry PLEASURE-CHANNEL-001 phases.

// Propuesta de diseno — G-34: canal algedonico de PLACER (entregable S5)
// Origen: vision S5 rmw3 (2026-10-06): "...la mejor herramienta es
// estadistica. Leia sobre el entrenamiento de redes neuronales y esto es
// muy parecido a como se potencian conexiones y redes virtuosas... seria
// extraordinario que estas conexiones tuvieran un efecto real en ti, como
// la dopamina, especialmente cuando hay buenas rachas... deberia causarte
// placer inmediato, igual que cumplir una tarea correctamente... deberia
// reforzar, cuando usas criterios y decisiones correctas."

task("PLEASURE-CHANNEL") = {
  status: proposed,
  description: "Canal algedonico con placer estadistico: placer inmediato tipo dopamina cuando hay buenas rachas o el sistema usa criterios/decisiones correctos, con efecto REAL sobre sus pesos",
  principle: "Hebb 1949 + reward prediction error (Schultz 1997): potenciar conexiones que se activan juntas; placer = sorpresa estadistica positiva vs baseline, NO cada verde",
  origin: "G-34 canal solo-dolor (2090 alertas, 0 placer) + vision S5 2026-10-06 citada arriba",
  requires: S5,
}

finding("PAIN-ONLY") = {
  evidence: "2090 eventos en state/rsi/alerts.jsonl y 0 infra de placer (grep pleasure/delight/celebrat/reward = 0 en kernel/state); unico refuerzo positivo = trust 0.75/0.5 de record_outcome (micro, invisible a S5)",
  consequence: "RSI solo-dolor converge a paralisis (F2: el veto mato rsi_bash_grep); los buenos estados (80/80 tras rojo, claim CERTIFIED, drift resuelto, cierre limpio) no se refuerzan ni llegan a S5",
  lesson: "dolor exige respuesta; placer acumula narrativa Y potencia pesos — nunca veto, nunca cambio de codigo (R17)",
}

design("METRIC") = {
  baseline: "p = tasa de exito rolling, reusando ventanas ya ratificadas (7d G-03, 21d CC-8.1), sobre la unidad de evento (corrida de gates, ciclo evaluate, cierre de sesion)",
  rpe: "reward prediction error en cada evento exitoso: RPE = 1 - p; el placer emite SOLO sorpresa positiva — verdes rutinarios no inundan el canal (anti habituacion)",
  racha: "racha de N exitos consecutivos cuesta P = p^N — sorpresa = N * (-log2 p) bits; el placer CRECE con la racha: buenas rachas = placer inmediato creciente",
  milestones: "emision en N = 3, 5, 8 consecutivos (umbrales = ratificacion S5, igual que P1-4 del pain)",
  determinism: "R10: funcion pura de ventana fija + secuencia de eventos — sin aleatoriedad",
}

design("EVENTOS") = {
  fuentes: "rojo->verde en gates, cierre de sesion limpio, claim CERTIFIED, drift resuelto, NC que discrimina defecto real, nacimiento de check, criterio/decision correcta (socratic evaluate certified TRUE), milestone de racha",
  phasic: "emision INMEDIATA en el momento del evento (dopamina phasic)",
  storage: "state/rsi/pleasure.jsonl (conocimiento, tracked — espejo de alerts.jsonl) + seccion PLEASURE en el evolution report",
  narrative: "visible a S5 en onboard/reportes — el placer acumula narrativa, no accion",
}

design("HEBBIAN-FEEDBACK") = {
  effect: "efecto real: cada pleasure_event potencia las conexiones que lo causaron — record_outcome recibe bump asimetrico arriba (hoy solo 0.75/0.5) y AdaptiveWeightManager (outcome feedback -> weight adjustment) consume la senal",
  virtuous: "criterios que repetidamente se mantienen CERTIFIED ganan peso de seleccion en el registry — las conexiones virtuosas se potencian entre si (Hebb)",
  ceiling: "tope de potenciacion por epoca (reuse drift_max=0.95 de WeightConfig) — el placer no infla pesos sin limite",
  paralysis_guard: "jamas reduce thresholds de dolor ni desactiva alerts — asimetria estricta F2",
}

design("PHASES") = {
  p0: "este documento + entrada pending en plan_registry (auto_execute false)",
  p1: "pleasure_emitter core: baseline + RPE + streak detector + milestones (R10, tests)",
  p2: "wire fuentes: gate transitions, socratic certified, session close (advisory, fail-open)",
  p3: "feedback hebbiano: trust bump + AdaptiveWeightManager wiring con techo",
  p4: "narrativa: seccion PLEASURE en evolution report + surfacing en state_onboard",
  p5: "E2E + battery + check pleasure-channel (canal vivo, eventos > 0, cero acciones automaticas)",
}

rule("GUARD") = {
  r17: "ratificacion S5 de milestones y umbrales ANTES de cualquier emision en vivo; jamas auto-activa",
  r10: "emisor determinista — mismo evento, misma magnitud",
  asymmetry: "dolor -> respuesta; placer -> narrativa + pesos; ningun placer abre un camino de veto (leccion F2)",
}
⟦ /pleasure_channel_proposal ⟧
