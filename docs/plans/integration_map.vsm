  },

  "Paso 3: Corregir decide.py": {
    status: "pending",
    action: "Arreglar path al engine",
  },

  "Paso 4: Registrar DECIDE en opencode.json": {
    status: "pending",
    action: "Agregar plugin decide.ts",
  },

  "Paso 5: Probar end-to-end": {
    status: "done",
    action: "Evaluar una decisión real con DECIDE",
    evidence: "2026-09-09 decide.py --decision funciona; UNCERTAIN ante input vacio (correcto)",
  },

  "Paso 6: Documentar integración": {
    status: "done",
