⟦ prop_status_lifecycle | POLICY-v1 | vsm-1.2.1 | 2026-09-10T13:30:39Z ⟧

@vsm 1.2.1
@status proposed

// STATUS LIFECYCLE (destilado de child status_policy; bindings vOSlab).
// Fuente: ~/vsf/child/docs/archive/ratified/status_policy.vsm
// Estados: proposed -> active -> ratified -> archived ( + active -> archived).
// Prohibido: archived -> * (re-proponer), proposed -> ratified (vía active).
// FORMULACIÓN VSL: delta(status, evento) -> status; delta(s,e) = ∅ ssi
// (s,e) en prohibidas. La función es total y computable.
// BINDINGS vOSlab: SR-1 existe (vsl-check-on-write exige @status);
// SR-2..SR-5 manual-review hoy -> futuro check de commit-msg.
// VERIFICACIÓN: matriz de transiciones en tests (permitidas OK,
// prohibidas rechazadas). Canonización a system/s5-policy/ tras verde.
status_lifecycle: {
  states: [proposed, active, ratified, archived],
  delta_proposed: {approve: active},
  delta_active: {ratify: ratified, deprecate: archived},
  delta_ratified: {supersede: archived},
  delta_archived: {},
}
⟦ /prop_status_lifecycle ⟧
