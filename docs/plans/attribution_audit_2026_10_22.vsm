objetivo = "Auditoria R11 de atribuciones: mapear TODA semantica de propiedad/authorship atribuida a Claude/Anthropic/otras compañias en el repo vivo (no archives) y sus implicaciones, ANTES de cualquier modificacion. Scan ejecutado 2026-10-22 via scripts ad-hoc (2 pasadas), evidencia en /tmp/opencode/attribution_audit.json + ownership_audit.json."

metodologia = {
  pasada_1: "scan broad por tokens de compania/modelo (Claude|Anthropic|OpenAI|GPT|Gemini|Microsoft|Fable|Perplexity|Copilot|Llama|Meta AI) → 2807 hits en 2008 files (8805 escaneados). La mayoria es NARRATIVA HISTORICA (sessions/provenance/chats) — no semantica de propiedad.",
  pasada_2: "scan fino de CAMPOS con semantica de propiedad (owner|author|authors|credited|by|attribution|copyright|credits|provenance) que CITE una entidad comercial → 89 campos en 48 files; descartando archive → 67 campos en ~29 archivos VIVOS.",
  nota_metodologica: "el campo owner= en VSM denota DELEGACION OPERATIVA (quien EJECUTA/verifica), no IP/copyright. El sistema NO tiene copyright asignado a LLMs: LICENSE autor rmw3 unico; covenant tiene clausula explicita 'no legal obligations on Anthropic'. El riesgo es de LECTURA (un lector externo puede sobre-interpretar), no legal.",
}

