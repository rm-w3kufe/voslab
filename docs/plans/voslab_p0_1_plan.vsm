// Source: vsf@838d4fc1 child/docs/voslab_p0_1_plan.vsm — original header timestamp 2026-08-28T23:10:00Z  // hardcoded-allow: historical upstream header, record fidelity
// Promoted to vOSlab 2026-10-01 (S5 rmw3 directive: promote)

// PROPOSAL: P0.1 — build the CLEAN vOSLAB pre-commit gate-suite.
// Companion to child/docs/voslab_gate_suite_spec.vsm (defects + design principles).
// This doc defines repo structure, gate scope, and work order. NO code yet —
// this is the evaluation/plan for rmw3 to refine before building.

// ═══════════════════════════════════════════════════════════════════════════
// 1. REPO STRUCTURE  (~/vOSlab)
// ═══════════════════════════════════════════════════════════════════════════
structure() {
  "~/vOSlab/": {
    "README.md": "purpose + how to run gate-suite",
    "pyproject.toml": "package metadata",
    ".github/workflows/gate-suite.yml": "CI: runs harness on every PR/push",
    "gate_suite/": {
      "policy/vsm_format.v1.vsm": "CANONICAL: version, language, header/footer, required fields",
      "gates/": "one module per gate (boot_load, plan_tree, relocate_vsm, plugin_location,",
                "dir_schema, classification, learning_record, r18_status, r18_versioning,",
                "child_refs_notify)",
      "harness/negative_control.py": "CORE: a gate is ADMITTED only if it has a negative-control",
                                     "test that FAILS on a crafted false claim",
      "harness/runner.py": "runs all gates + their negative-control tests; fails if any gate",
                            "lacks a passing negative control",
      "checks/plugin_location_valid.py": "the previously-BROKEN check, REBUILT with real neg control",
      "tests/test_negative_control.py": "proves the harness CATCHES a broken check",
      "tests/test_gates.py": "functional tests for each gate (pass + fail modes)",
    },
    "docs/gate_suite_spec.vsm": "mirrors voslab_gate_suite_spec.vsm",
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// 2. GATE SCOPE  (v1 — what to BUILD, vs what is OUT)
// ═══════════════════════════════════════════════════════════════════════════
scope() {
  in_scope_v1: [
    "boot_load        — manifest @var artifact refs resolve",
    "plan_tree        — plan() synced to live plan tree",
    "relocate_vsm     — no broken @ref across docs",
    "plugin_location  — plugins NOT hardcoded to repo paths (REBUILT w/ neg control)",
    "dir_schema       — declared dirs/artifacts match disk",
    "classification   — leaf-rule: every dir has classification.local.vsm",
    "learning_record  — §6 standard (learning_record() + required fields + deferral)",
    "r18_status       — @status present + valid value",
    "r18_versioning   — header/footer version coherent; dotted names OK",
    "child_refs_notify— R13 dispatch envelopes have canonical footer",
  ],
  out_of_scope_v1: [
    "the 14 superseded vsf gates (8-19) — vOSLAB rebuilds its own as needed,",
    "NOT ported. They are documented in voslab_gate_suite_spec.vsm as 'do not repeat'.",
  ],
  design_principles_applied: "p1-p7 from voslab_gate_suite_spec.vsm",
}

// ═══════════════════════════════════════════════════════════════════════════
// 3. WORK ORDER
// ═══════════════════════════════════════════════════════════════════════════
work_order() {
  A0: "Scaffold ~/vOSlab repo (git init, README, pyproject, empty CI workflow).",
  A1: "Write policy/vsm_format.v1.vsm — SINGLE source of truth the gates enforce",
      "(canonical VSM version, English-only, header+footer+required-fields).",
  A2: "Build harness/negative_control.py FIRST — defines the admission contract:",
      "every gate MUST register a negative-control test; runner fails the suite",
      "if any gate lacks one that fails on a crafted false claim.",
  A3: "Port the 10 in-scope gates one by one, EACH with a negative-control test.",
  A4: "Rebuild checks/plugin_location_valid.py with a REAL negative control.",
      "PROOF: run it through the harness in its BROKEN form → harness FAILS;",
      "in FIXED form → harness PASSES. This demonstrates the vsf defect is caught.",
  A5: "Wire as pre-commit hook + CI (GitHub Actions) so negative-control is",
      "enforced on every change (no check admitted without a discriminating test).",
  A6: "Document design principles p1-p7 as policy; automate where feasible.",
}

// ═══════════════════════════════════════════════════════════════════════════
// 4. OPEN QUESTIONS FOR rmw3 (refine before building)
// ═══════════════════════════════════════════════════════════════════════════
decisions() {
  q1_canonical_version: "vsm-1.2.1  (LOCKED — matches R18 policy)",
  q2_language: "English-only from commit #1  (LOCKED — D7 from day 1)",
  q3_repo_path: "~/vOSlab  (LOCKED — per vos_migration_roadmap)",
  q4_socratic: "Reuse public ~/socratic-engine  (LOCKED — no vendor copy)",
  q5_gate_count: "10 in-scope gates as v1  (LOCKED)",
  q6_enforcement: "Pre-commit hook + CI both  (LOCKED)",
  q7_packaging: "In-repo only for v1  (LOCKED — no PyPI yet)",
  status: "PLAN FINALIZED — awaiting GO to build (A0: scaffold ~/vOSlab)",
}
