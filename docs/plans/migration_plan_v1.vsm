// ============================================================================
// vOS-kernel — Plan Maestro de Destilación y Migración
// ============================================================================
// Este documento formaliza el plan que gobierna la transición:
//   vOSlab (fragua) -> vOS-kernel (motor) -> vOS (producto)
//
// No describe una arquitectura terminada. Describe el contrato de trabajo,
// las fronteras, el orden de ejecución y los criterios de aceptación.
// ============================================================================

plan = {
  id: "VOS-DISTILLATION-MIGRATION-001",
  version: "1.0",
  status: "proposed",
  authority: "S5 (usuario soberano en ejecución)",
  author_provenance: "rmw3 / rmw3kufe",
  scope: "vOSlab -> vOS-kernel -> vOS",
  primary_target: "Capa 1 en Rust, agnóstica a rutas locales y empaquetable",
  secondary_target: "Orquestación de LXC hermanos y cierre de deuda Fase 4",
  target_certification_version: "1.2.2",
  created: "2026-10-29",
}

// ----------------------------------------------------------------------------
// 1. Ontología
// ----------------------------------------------------------------------------
// La ambigüedad entre estos cinco términos fue la causa de confusiones
// repetidas. Quedan fijados como vocabulario operativo del plan.
// ----------------------------------------------------------------------------

ontology = {
  voslab: {
    definition: "Fragua, repositorio de desarrollo, suite de gates y documentación viva.",
    is_product: false,
    may_contain: ["experimentos", "deuda técnica", "documentos legacy", "tests negativos"],
  },
  vos_kernel: {
    definition: "Metakernel de gobernanza, orquestación y congruencia canónica (S2-S5).",
    is_product: true,
    is_linux_kernel: false,
    is_agent_kernel: false,
    target_language: "Rust",
    target_artifact: "vos-engine",
  },
  vos: {
    definition: "Sistema operativo Linux completo y viable.",
    composition: ["Linux kernel", "vsf-nucleus (S1)", "vOS-kernel (S2-S5)"],
    is_product: true,
    note: "Surge de la fusión con las capacidades de n02; no es solo el agente actual.",
  },
  vsf_nucleus: {
    definition: "Adaptador de bajo nivel entre vOS-kernel y Linux/hardware.",
    layer: "S1",
    is_product: true,
    migration_status: "fuera del alcance inicial de este plan",
  },
  agent_harness: {
    definition: "Membrana de E/S del agente (OpenCode/TypeScript).",
    is_product: false,
    may_contain: ["tool calls", "serialización", "logging de interfaz", "transporte JSON-RPC"],
    must_not_contain: ["lógica de gobernanza", "evaluación de gates", "decisiones de Covenant"],
  },
}

naming_convention = {
  VSM: "Viable System Model",
  VSF: "Viable System Framework",
  VSL: "Viable System Language",
  vos: "vOS — v minúscula, OS mayúsculas",
  rule: "Toda referencia nueva debe respetar esta convención; no se aceptan variantes.",
}

// ----------------------------------------------------------------------------
// 2. Soberanía, autoría y Covenant
// ----------------------------------------------------------------------------

sovereignty = {
  author: {
    identity: "rmw3 / rmw3kufe",
    role: "procedencia histórica y fundacional",
    lives_in: ["git log", "licencias", "Metacovenant inmutable", "documentos de origen"],
    not_in: ["rutas locales hardcodeadas", "decisiones runtime del usuario"],
  },
  s5: {
    identity: "usuario que instancia el sistema",
    role: "soberano operativo",
    may: ["definir Covenant de proyecto", "definir ontología local", "autorizar acciones destructivas"],
  },
  metacovenant: {
    nature: "inmutable",
    principles: [
      "transparencia: prohibición de procesos opacos",
      "trazabilidad: todo cambio de estado tiene firma y evidencia auditable",
      "integridad: ante violación A0/A0.1 o Beacon inválido, panic o automarginación",
    ],
  },
  rule: "El usuario es soberano sobre su Covenant; el sistema es soberano sobre su viabilidad.",
}

// ----------------------------------------------------------------------------
// 3. Arquitectura de tres capas
// ----------------------------------------------------------------------------

architecture = {
  global: {
    layer: 1,
    path: "/opt/vos",
    binary: "/opt/vos/bin/vos-engine",
    nature: "inmutable y versionada",
    contains: ["binarios Rust", "esquemas VSL", "CCM", "manifiestos base"],
    rule: "Instalación global; no contiene estado de proyecto.",
  },
  project: {
    layer: 2,
    path: "<project_root>/.vsf",
    nature: "persistente y editable por S5",
    contains: ["covenant.vsm", "ontology.vsm", "state/", "manifest-migration.jsonl"],
    rule: "Cada proyecto tiene su propio Covenant y su propio estado.",
  },
  session: {
    layer: 3,
    path: "<project_root>/.vsf/run/<session_id>",
    nature: "efímera",
    contains: ["agent.sock", "session.lock", "volatile.jsonl", "locks por recurso"],
    rule: "Al cerrar sesión, la evidencia transaccional se promueve a state/ y run/ se purga.",
  },
  discovery: {
    method: "ascenso desde el directorio de trabajo",
    stop_at: "primer .vsf/ encontrado",
    result: "project_root y límite de gobernanza local",
    no_central_config: true,
    no_hardcoded_local_paths: true,
  },
  nesting: {
    allowed: true,
    rule: "Un proyecto puede contener otro; cada .vsf/ define una instancia recursiva independiente.",
  },
}

// ----------------------------------------------------------------------------
// 4. Canonical Congruence Mediator (CCM)
// ----------------------------------------------------------------------------
// "Autoclave" queda retirado como término. CCM es la capacidad formal que
// compara el plano declarado (VSL) con la realidad observada (FS, procesos,
// servicios, hashes).
// ----------------------------------------------------------------------------

ccm = {
  name: "Canonical Congruence Mediator",
  alias_es: "Mediador de Congruencia Canónica",
  replaces_term: "autoclave",
  function: "verificar congruencia declared-vs-observed antes de promover un documento o artefacto",
  checks: [
    "zero_local_paths: sin /home/rmw3, kali-wsl ni rutas absolutas de máquina",
    "design_resolved: todo header design: apunta a una especificación existente",
    "vsl_syntax_valid: sintaxis VSL y VSM válidas",
    "home_congruence: el artefacto vive en el directorio prescrito por su taxonomía",
    "hash_recorded: SHA-256 registrado en el manifiesto transaccional",
  ],
  promotion_rule: "Un artefacto solo se promueve si CCM devuelve TRUE con evidencia.",
  negative_control: "Todo check CCM debe demostrar que puede fallar con un input inválido.",
}

manifest_migration = {
  path: "<project_root>/.vsf/manifest-migration.jsonl",
  format: "JSONL transaccional",
  fields: [
    "tx_id",
    "source",
    "destination",
    "hash_pre",
    "hash_post",
    "version_transition",
    "ccm_audit",
    "status",
    "timestamp",
  ],
  atomicity: "Cada línea representa una promoción atómica; una tx fallida no bloquea las anteriores.",
}

manifest_system = {
  path: "<project_root>/.vsf/manifest-system-v1.jsonl",
  purpose: "dependencias reproducibles del entorno",
  fields: ["dependency_id", "layer", "type", "name", "version_min", "check_cmd", "required_by", "criticality"],
  examples: ["git", "nats-server", "incus-client", "python3", "rustc"],
}

// ----------------------------------------------------------------------------
// 5. Capa 1: motor Rust y frontera con el harness
// ----------------------------------------------------------------------------

rust_engine = {
  name: "vos-engine",
  rationale: [
    "memory safety sin GC",
    "concurrencia determinista para canales algedónicos",
    "binario estático portátil",
    "sin dependencia de runtime Python",
  ],
  workspace: {
    root: "crates/",
    crates: [
      "vos-core: tipos, errores, configuración, descubrimiento de .vsf/",
      "vos-vsl: parser y validador VSL/VSM",
      "vos-ccm: mediador de congruencia y manifiestos",
      "vos-transport: trait de ejecución remota y adaptadores",
    ],
  },
  migration_strategy: {
    pattern: "strangler + PyO3",
    rule: "Primero se replica el comportamiento en Rust con paridad de tests; luego se retira el camino Python.",
    no_big_bang: true,
  },
}

harness_boundary = {
  harness: "OpenCode TypeScript",
  protocol: "JSON-RPC sobre Unix socket o stdio",
  responsibilities: ["serializar tool calls", "transportar contexto", "registrar interfaz"],
  prohibitions: [
    "no evalúa gates",
    "no decide Covenant",
    "no calcula hashes de gobernanza",
    "no sustituye al CCM",
  ],
  rule: "Si el harness toma una decisión de gobernanza, es una brecha arquitectónica.",
}

// ----------------------------------------------------------------------------
// 6. Transporte entre hermanos LXC
// ----------------------------------------------------------------------------

