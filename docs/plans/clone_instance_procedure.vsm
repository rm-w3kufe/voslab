⟦ clone_instance_procedure | PROCEDURE-v1 | vsm-1.2.1 | 2026-10-01T11:53:21Z ⟧

@vsm 1.2.1
@status ratified



task("CLONE-INSTANCE") = {
  status: ratified,
  description: "Procedimiento S5 para instancia scratch de vOSlab y sync hacia main",
  constraint: "el kernel no escribe fuera de su workspace: S5 ejecuta el clon en shell",
}

step("CLONE") = {
  cmd: "git clone ~/vOSlab ~/vOSlab-scratch (ajustar nombre si se quiere)",
  branch: "en scratch trabajar sobre rama scratch, main queda como rama canonica",
  why_git_clone: "historia completa, sin remote, sync local por fetch mas merge",
}

step("REPOINT") = {
  where: "dentro del clon, re-apuntar 3 archivos hacia la ruta del clon",
  f1: "opencode.json: 5 rutas (focus, journal, 2 MCP locales)",
  f2: ".opencode/mcp/parse_query_mcp.py: VOSLAB_PATH",
  f3: ".opencode/mcp/socratic_mcp_with_bridge.py: 3 rutas",
  how: "sed -i s|RUTA_MAIN|RUTA_CLON|g sobre f1 f2 f3 (revisar diff tras sed)",
  trust: ".trust_state.json converge solo con el uso (no editar a mano)",
}

step("SKIP-WORKTREE") = {
  why: "exclude solo cubre untracked; focus y logs estan trackeados",
  cmd: "git update-index --skip-worktree current_focus.json logs/agent_plugin.jsonl logs/commit_verify.jsonl logs/verdict_chain.jsonl .trust_state.json .opencode/plugins/operational/.rate_limit.json",
  check: "git status ya no muestra esos archivos; git ls-files -v los marca S",
  exclude: ".git/info/exclude queda como higiene para untracked (rotaciones .gz)",
}

step("BOOT-SCRATCH") = {
  run: "branch, run_gates, primera entrada de focus marcando instancia scratch",
  mcp: "los MCPom hijo del proceso opencode del clon (aislados por proceso)",
  shared: "LXC, NATS y state remota siguen compartidos (correcto)",
}

rule("DISJOINT") = {
  text: "nunca el mismo documento en main y scratch a la vez (stash y quarantine son por path)",
  sessions: "dos terminales mismo dir solo para lectura o tareas disjuntas",
}

step("SYNC") = {
  direction: "solo scratch hacia main, nunca al reves salvo fast-forward limpio",
  git: "desde main: fetch de la ruta scratch mas merge --no-ff de rama scratch",
  content: "solo codigo y docs; jamas logs, state, db, rate, trust ni focus",
  vsm: "espejos verbatim con breaches declarados (disciplina mirror vigente)",
  gates: "deben pasar en scratch antes del sync y en main tras el merge",
}

step("RESUME") = {
  why: "opencode -c retoma la sesion global mas reciente y roba la sesion entre terminales",
  use: "scripts/ops/resume_here.sh en vez de -c (retoma ultima sesion DEL directorio via -s, o arranca fresca)",
  note: "el script vive en main; copiarlo al clon hasta el primer sync",
}

step("VERIFY") = {
  cmd: "python3 scripts/ops/clone_preflight.py RUTA_CLON (solo lee, exit 0 es READY)",
  checks: "ancestro compartido, cero anclas a MAIN, paths MCP dentro del clon, exclude presente",
}

rollback = {
  scratch_roto: "se borra el clon y se re-clona (main nunca se toca)",
  sync_malo: "revert del merge en main (sync siempre --no-ff para revert limpio)",
}
⟦ /clone_instance_procedure ⟧
