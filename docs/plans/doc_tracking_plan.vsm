@vsm 1.2.1
@status active

// ═══════════════════════════════════════════════════════════════════════════
// PLAN: SEGUIMIENTO EXHAUSTIVO DE DOCUMENTACIÓN
// ═══════════════════════════════════════════════════════════════════════════
//
// PROBLEMA:
//   - 895 archivos .vsm en vsf, medidos 2026-09-09 (scan real)
//   - 693 missing + 202 modified en vOSlab (match por basename; revisar)
//   - No había metodología de registro ni verificación
//
// DECISIÓN S5 (rmw3, 2026-09-09): alcance COMPLETO con sync curado.
//   Fase 1 HECHA: scripts/vsl/tools/doc_manifest.py (scan/verify/stats),
//   línea base en state/doc_manifest.jsonl. Solo lee fuera de vOSlab.
//   Fase 2 LISTA-INICIAL HECHA 2026-09-09: 5 espejos en docs/canon_mirror/
//   (rsi_roadmap, covenant, hard_rules, boot_manifest, core_boot_primer)
//   + MIRROR.json. Política: specs→vsf, results→vOSlab, planes→S5.
//   Espejos verbatim: 2 PASS, 3 con breaches pre-existentes upstream
//   (covenant @vsm 0.1 sin firmas; roadmap timestamps placeholder).
//   NUNCA escribir fuera de ~/vOSlab/.
//
// SOLUCIÓN:
//   Sistema de tracking con 3 componentes:
//   1. MANIFEST: Registro declarativo de qué docs importan
//   2. SYNC: Sincronización automática desde fuentes
//   3. VERIFY: Verificación de consistencia
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// §1 — MANIFEST: REGISTRO DECLARATIVO
// ═══════════════════════════════════════════════════════════════════════════
//
// Cada documento tiene un registro en doc_manifest.jsonl:
//
// {
//   "id": "unique-id",
//   "source": "vsf/docs/spec_revision/...",
//   "dest": "docs/specs/...",
//   "category": "architecture|spec|guide|plan|rule",
//   "priority": "critical|high|medium|low",
//   "sync_mode": "auto|manual|reference",
//   "last_sync": "2026-09-08T01:07:33Z",
//   "status": "synced|modified|outdated|missing",
//   "checksum": "sha256:...",
//   "notes": "..."
// }
//
// sync_mode:
//   auto     - se sincroniza automáticamente
//   manual   - se sincroniza con confirmación
//   reference - solo se referencia, no se copia
// ═══════════════════════════════════════════════════════════════════════════

doc_manifest_rules: "
  1. TODO doc usado en vOSlab DEBE tener entrada en manifest
  2. TODO doc archivado DEBE tener status=archived
  3. TODO doc modificado DEBE tener status=modified
  4. CHECKSUM se calcula en cada sync
  5. PRIORIDAD determina frecuencia de sync
",

// ═══════════════════════════════════════════════════════════════════════════
// §2 — CATEGORIZACIÓN DE DOCUMENTOS
// ═══════════════════════════════════════════════════════════════════════════
//
// Categorías y su ubicación en vOSlab:
//
// architecture/  → system/architecture/
//   - Descripción del sistema
//   - Diagramas de componentes
//   - Decisiones arquitectónicas
//
// spec/          → docs/specs/  [RETIRED 2026-10-30, F4 Ola 5]
//   - Especificaciones formales
//   - Protocols y APIs
//   - Contratos entre componentes
//
//   NOTE: docs/specs/ was retired in Ola 5. The `spec` mapping below is kept
//   only for the historical sync corpus; canonical specs now resolve through
//   classification.local.vsm (system/, docs/design/sources/, docs/plans/,
//   docs/design/sandbox/). Do not use docs/specs/ for new documents.
//
// guide/         → docs/guides/
//   - Tutoriales
//   - How-to guides
//   - Onboarding
//
// plan/          → docs/plans/
//   - Roadmaps
//   - Implementation plans
//   - Task tracking
//
// rule/          → system/rules/
//   - Reglas del sistema
//   - Políticas
//   - Invariants
//
// theory/        → system/kernel/
//   - Teoría formal
//   - Proofs
//   - Modelos matemáticos
//
// archive/       → docs/archive/
//   - Documentos obsoletos
//   - Versiones anteriores
//   - Referencia histórica
// ═══════════════════════════════════════════════════════════════════════════

category_mapping: {
  "architecture": "system/architecture/",
  "spec": "docs/specs/",
  "guide": "docs/guides/",
  "plan": "docs/plans/",
  "rule": "system/rules/",
  "theory": "system/kernel/",
  "archive": "docs/archive/",
  "active": "docs/",
},

// ═══════════════════════════════════════════════════════════════════════════
// §3 — FLUJO DE TRABAJO
// ═══════════════════════════════════════════════════════════════════════════
//
// 3.1 INICIALIZACIÓN
//   1. Escanear vsf/ para docs relevantes
//   2. Clasificar por categoría
//   3. Generar manifest inicial
//   4. Copiar docs críticos a vOSlab
//
// 3.2 SINCRONIZACIÓN
//   1. Leer manifest
//   2. Para cada doc con sync_mode=auto:
//      a. Calcular checksum de source
//      b. Si checksum != manifest → sincronizar
//      c. Actualizar manifest
//   3. Para cada doc con sync_mode=manual:
//      a. Detectar cambios
//      b. Reportar al usuario
//      c. Esperar confirmación
//
// 3.3 VERIFICACIÓN
//   1. Ejecutar diariamente (o al inicio de sesión)
//   2. Comparar checksums
//   3. Detectar docs huérfanos (en vOSlab sin manifest)
//   4. Detectar docs faltantes (en manifest sin archivo)
//   5. Reportar inconsistencias
//
// 3.4 REGISTRO
//   1. Todo cambio genera un entry en doc_changelog.jsonl
//   2. Formato:
//      {
//        "ts": "timestamp",
//        "doc_id": "id",
//        "action": "sync|create|delete|modify",
//        "source": "path",
//        "dest": "path",
//        "checksum_before": "...",
//        "checksum_after": "..."
//      }
// ═══════════════════════════════════════════════════════════════════════════

workflow: {
  init: "scan vsf → classify → generate manifest → copy critical docs",
  sync: "read manifest → checksum compare → sync auto/manual → update manifest",
  verify: "checksum compare → detect orphans → detect missing → report",
  register: "log all changes to doc_changelog.jsonl",
},

// ═══════════════════════════════════════════════════════════════════════════
// §4 — HERRAMIENTAS
// ═══════════════════════════════════════════════════════════════════════════
//
// scripts/doc_tracking/
//   ├── doc_manifest.jsonl       ← Registro de documentos
//   ├── doc_changelog.jsonl      ← Historial de cambios
//   ├── scan_sources.py          ← Escanea vsf/ y genera manifest
//   ├── sync_docs.py             ← Sincroniza docs según manifest
//   ├── verify_docs.py           ← Verifica consistencia
//   └── view_manifest.py         ← CLI para consultar manifest
// ═══════════════════════════════════════════════════════════════════════════

tools: [
  "scan_sources.py - escanea fuentes y genera manifest",
  "sync_docs.py - sincroniza según manifest",
  "verify_docs.py - verifica consistencia",
  "view_manifest.py - CLI para consultar",
],

// ═══════════════════════════════════════════════════════════════════════════
// §5 — PRIORIDADES INICIALES
// ═══════════════════════════════════════════════════════════════════════════
//
// CRÍTICOS (sync inmediato):
//   - system/boot/*.vsm (covenant, hard_rules, core_boot_primer)
//   - system/architecture/architecture.vsm
//   - docs/archive/specs_2026-10-30/vos_master_plan.vsm
//
// ALTOS (sync esta semana):
//   - docs/plans/*.vsm
//   - system/rules/*.vsm
//   - docs/guides/*.vsm
//
// MEDIOS (sync este mes):
//   - docs/reference/*.vsm
//   - system/kernel/*.vsm
//
// BAJOS (reference only):
//   - docs/archive/**/*.vsm
//   - vsf/child/docs/**/*.vsm
// ═══════════════════════════════════════════════════════════════════════════

priorities: {
  critical: ["system/boot/", "system/architecture/", "docs/plans/"],
  high: ["docs/plans/", "system/rules/", "docs/guides/"],
  medium: ["docs/reference/", "system/kernel/"],
  low: ["docs/archive/", "vsf/child/docs/"],
},

// ═══════════════════════════════════════════════════════════════════════════
// §6 — MÉTRICAS DE ÉXITO
// ═══════════════════════════════════════════════════════════════════════════
//
// 1. COBERTURA: % de docs críticos sincronizados → meta: 100%
// 2. CONSISTENCIA: % de docs con checksum match → meta: 100%
// 3. TRAZABILIDAD: % de docs con entrada en manifest → meta: 100%
// 4. LATENCIA: Tiempo máximo entre cambio en fuente y sync → meta: <24h
// ═══════════════════════════════════════════════════════════════════════════

success_metrics: {
  coverage: "100% de docs críticos sincronizados",
  consistency: "100% de docs con checksum match",
  traceability: "100% de docs con entrada en manifest",
  latency: "<24h entre cambio y sync",
},

// ═══════════════════════════════════════════════════════════════════════════
// §7 — NOTA DE ALCANCE: FASE 3 LIGERA (QUEUE-EXEC F5, CERRADA 2026-10-10)
// ═══════════════════════════════════════════════════════════════════════════
//
// HECHO:
//   - scripts/doc_tracking/verify_docs.py: checksum (source re-hash vs
//     manifest + dest observado entre corridas), huerfanos en 2 tiers
//     (canon = docs/canon_mirror/ stale, ACCIONABLE; native = resto,
//     informativo), faltantes (dest declarado ausente en disco), cola
//     S5 (status=modified), changelog por diff vs estado previo (§3.4:
//     ts, doc_id, action, source, dest, checksums). Reutiliza
//     doc_manifest.py — Fase 1 NO duplicada. rc=0 = report completo
//     (drift/cola = report, no gate); rc=2 = manifest ilegible. El
//     gate rc=1 de integridad sigue siendo `doc_manifest.py verify`.
//   - Wiring: cron diario `7 4 * * *` con flock /tmp/doc-verify.lock
//     (precedente: snapshot_runtime_state) -> logs/doc_verify.log.
//     Decisión: NO por sesión — el changelog escribe estado y no debe
//     correr en el camino de tool calls.
//   - Corrida base 2026-10-10: rc=0, 909 entries, 0 source-drift,
//     0 faltantes, cola 70 modified en
//     state/doc_tracking/review_queue.jsonl, huerfanos 95 = 13 canon
//     stale (dest canónico ya registrado en otra ruta; 1 sin entrada)
//     + 82 native (detail en state/doc_tracking/orphans.jsonl).
//
// DIVERGENCIAS DE PATH vs §4 (documentadas, no silenciosas):
//   - El manifest vive en state/ desde Fase 1; changelog, estado y
//     cola viven en state/doc_tracking/ por la misma razón: datos en
//     state/, código en scripts/. §4 queda obsoleto en esos paths.
//
// DEUDAS / NO HECHO (futuro, fuera de F5 ligero):
//   - sync_docs.py + view_manifest.py (§4): sync curado = Fase 2+.
//   - Regla 1 del manifest (todo doc usado en vOSlab con entrada)
//     aplica hoy solo al scope vsf-driven: los 82 native docs en
//     directorios trackeados no tienen entrada. Cobertura
//     vOSlab-native = decisión S5 futura.
//   - Cola 70 modified + 13 canon stale = revisión S5 PENDIENTE
//     (no se tocó contenido en F5 — solo se midió y encoló).

// ═══════════════════════════════════════════════════════════════════════════

