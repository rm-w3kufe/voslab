// system/plans/plan_cybernetic_upgrade.vsm
// Second-Order Cybernetics Upgrade Plan
// Gap: 4 of 5 components lack self-modification capability
// Only vsf-rsi has true second-order cybernetics

// ─── PROBLEM STATEMENT ──────────────────────────────────────────────────────
problem: "
  Audit 2026-09-07T06:19:20Z revealed:
  - vsf-rsi: ✅ Second-order (detect → generate → shadow → activate → rollback)
  - socratic-engine: ❌ First-order (executes, doesn't self-modify)
  - state-canon: ❌ First-order (stores, doesn't evolve schema)
  - backbone: ❌ Stub RSI bridge (auto_improve returns success without action)
  - plugins: ❌ No plugin system (files referenced but don't exist)
  
  The system can observe itself but cannot modify itself recursively.
  Auto-observation without auto-modification = glass box, not cybernetic system.
"

// ─── COMPONENTS AFFECTED ────────────────────────────────────────────────────
components: [
  {
    id: "socratic-engine",
    current: "first-order",
    target: "second-order",
    capability: "self-modification",
    description: "Adjust predicate weights based on evaluation outcomes"
  },
  {
    id: "state-canon",
    current: "first-order",
    target: "second-order",
    capability: "auto-evolution",
    description: "Evolve schema based on drift patterns"
  },
  {
    id: "backbone",
    current: "stub-rsi-bridge",
    target: "functional-rsi-bridge",
    capability: "recursive-improvement",
    description: "RSIBridge.auto_improve() must invoke vsf-rsi real"
  },
  {
    id: "plugins",
    current: "missing",
    target: "operational",
    capability: "plugin-system",
    description: "Implement plugin lifecycle for self-modification"
  }
]

