@vsm 1.2.1
@status active

// RESPONSE TIERS per strategy (s3 review-surface complement).
// Every L3 strategy ships with its tier declared BEFORE shadow:
//   tier D4-L1 auto: scope exact, rollback auto-reversible, prohibited=[].
//   tier D4-L2 pre-auth: needs recorded pre-authorization reference.
//   tier D4-L3 human: S5 approval per strategy (default for novel kinds).
// Undeclared tier = D4-L3 (fail-closed default). Recert epoch:
// tau_recert = 2 * tau_rec on every strategy change. Snapshot + atomic
// restore required before any live flip (rollback one-liner covers it).
// Template: copy, fill, attach to the fault record. Techo intacto.
strategy_tier: {
  tier: "D4-L1 | D4-L2 | D4-L3",
  scope: "exact predicate/file list",
  rollback: "auto-reversible procedure",
  prohibited: [],
  pre_auth_ref: "null | <reference>",
}
⟦ /strategy_tier_template ⟧
