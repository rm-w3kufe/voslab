    ],
    costo: "~1 linea por timer en design doc + smoke ya existente",
    fase: "P1",
  },

  // ── T5 · R9: lecturas canonicas silenciosamente vacias ──
  T5_CANON_FAILLOUD: {
    evidencia: "_parse_tasks_vsm devuelve [] si TASKS.vsm no existe
