    costo: "F1 ~40 lineas en corpus",
    fase: "P0 (F1)",
  },

  // ── T9 · convencion de procesos background de agentes ──
  T9_BG_CONVENTION: {
    evidencia: "nohup+& murio con el timeout de la tool; workaround
