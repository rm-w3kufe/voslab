      "F2 ventana hardcodeada -> census-derived: el test compara TASKS
       vs census (converge-check ya existe) en vez de banda fija;
       cero restatements futuros",
    ],
    costo: "F1 sweep ~5 writers; F2 rewrite corto de 1 test",
    fase: "P1",
  },

  // ── T7 · R16 advisory persistente en commits de tests/scripts ──
  T7_R16_SCOPE: {
    evidencia: "canon vs realidad: R16 cuantifica {script, plugin, spec,
      service, check} (test NO enumerado); P3 RATIFICADO S5 2026-10-16:
      todo test declara # design: line 1 heredado del SUT, 0 design docs
