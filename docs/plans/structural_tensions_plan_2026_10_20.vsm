      "F2 canon sites: raise con mensaje fail-loud; ledgers intactos",
      "F3 detector: test que invoca los canon-readers con archivo
       ausente y exige excepcion, no lista vacia",
    ],
    costo: "F1+F3 en corpus; F2 diff minimo",
    fase: "P0",
  },

  // ── T6 · tests vs estado vivo (flakes por escritura) ──
  T6_LIVESTATE_TESTS: {
    evidencia: "test_evolution_report flaky (writer reescribe durante
      el test); ventana test_tasks_live exige restatement en cada
      movimiento del census (37+-5 -> 49+-5 hoy)",
    fix: [
      "F1 atomic-writes: tmp + os.replace en writers de estado
