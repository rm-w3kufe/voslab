@status proposed

// PLAN DE SOLUCION — tensiones estructurales VSM + huecos vigentes.
// Origen: evaluacion post-ronda ARC-EVAL-ROUND-1 (2026-10-20, S5).
// Principio rector: R16 detector-first (cada fix sale con su detector),
// R9 fail-loud (sin concesiones silenciosas), R17 auto_execute=false en
// todo lo que toca policy. Cada tension cita su evidencia de esta ronda
// (NO-NEW-TRUTH).

plan("STRUCTURAL-TENSIONS-2026-10") {

  contexto: [
    "ronda 2026-10-20 reparo la guardia semanal (3 root causes) y cerro
     el pretrain con veredicto negativo; ambas revelan tensiones
     estructurales, no bugs aislados (evaluacion post-ronda a S5)",
    "evidencia: (a) suite 'verde' en dev divergio de systemd >=2 dias;
     (b) alerts 7d = 220 errores sin triage (bridge_call_failed 145 +
     pattern_runner_fail 48 = 88% del volumen); (c) el pre-compromiso
     D2-C dejo la ronda 8h autonoma sin S5 en el loop — fortaleza a
     institucionalizar",
  ],

  // ── T1 · S2 auto-referencia incompleta (guardia sin guardia) ──
  T1_S2_SELF_OBSERVATION: {
    evidencia: "weekly nacio rojo en A4 (cwd=HOME + VOSLAB_PATH
      parents[3] + bridge per_status); scheduled_suite cubre run_gates,
      pero ni la pierna pytest del weekly ni el env de los timers
      tenian guardia propia",
    fix: [
      "F1 test runner-parity: run_gates verde con cwd != repo-root y
       env strippado — regresiona exactamente el bug class de hoy",
      "F2 check systemd-units-fresh: systemctl --user --failed sin
       unidades vsf-* + timers enabled; SKIP declarado honesto si el
       env no tiene systemd",
      "F3 canary env-stripped en scheduled_suite: 3 tests sensibles
       (audit_pipeline envenenador + bridge victima + gates-green) bajo
       env sin VOSLAB_PATH en UNA invocacion, orden importado (62s
       medido 2026-10-20, ciclo total ~121s) — deteccion <=1h de la
       clase envenenada. NOTA: run_gates ya corre strippado cada hora
       via systemd (sin VOSLAB_PATH); el hueco real era el CORPUS pytest
       (hoy solo <=7d en weekly)",
    ],
    costo: "~90 lineas total; F1 corpus semanal, F2 suite, F3 por hora",
    fase: "P0 (F1) + P1 (F2, F3)",
  },

  // ── T2 · S5 cuello de botella de policy ──
  T2_S5_PRECOMMIT: {
    evidencia: "D2-C (condicion pre-ratificada IF gate THEN accion)
      hizo la ronda completa autonoma; precedente adicional: envelope
      learn-budget O2 ratificado 2026-10-15 con params fijos y
      enforcement machine-side (ya en production, task archivado) — el
      patron precompromiso YA existe en dos formas. En paralelo crece la
      cola 'consideracion S5' (B/r1/LoRA 10-24, RUNNER-ARCH-API-1)",
    fix: [
      "F1 practica conditional-precommit: toda decision S5 elegible se
       ratifica dentro del task con patron D2-C (ya probado); 1 linea
       en protocolo de boot",
      "F2 (solo si en 2 semanas la cola no baja) registry
       docs/governance/precommitments.vsm",
    ],
    costo: "F1 = doc; F2 = doc + ceremonia",
    fase: "P2 (D-SA2)",
  },

  // ── T3 · canal algedonico sin attenuator ni triage ──
  T3_ALGEDONIC_TRIAGE: {
    evidencia: "220 errores 7d sin triage; top-2 son loops de fallo
      repetidos (88% del backlog, no 193 incidentes distintos);
      error_burst aviso pero nadie clasifica",
    fix: [
      "F1 source-fix: root-cause bridge_call_failed (145) y
       pattern_runner_fail (48) — reparar la fuente antes que triagear
       su estela",
      "F2 dedup-attenuator: misma clase+detail repetida en <24h =
       fila con contador, jamas drop (R9 preservado)",
      "F3 paso alerts-triage en session boot: errores 7d sin triage
       clasificados en el primer reporte a S5",
    ],
    costo: "F1 = diagnostico + fix (estim 1-2h c/u); F2 ~40 lineas;
      F3 = 1 paso de boot",
    fase: "P0 (F1) + P1 (F2, F3)",
  },

  // ── T4 · S4 no modela entornos de ejecucion ──
  T4_S4_ENV_MODEL: {
    evidencia: "la brecha dev-shell vs systemd duro >=2 dias porque
      ningun modelo de S4 declaraba env/cwd/deps de cada runner",
    fix: [
      "F1 inventario de los 5 timers: {env, cwd, python, deps, checks}
