            "Add agent_id tracking"
        ]
    },
    "phase_3": {
        "name": "Agent Results Storage",
        "tasks": [
            "Create agent_results domain in state-canon",
            "Add MCP tools for agent result persistence",
            "Create storage directory structure"
        ]
    },
    "phase_4": {
        "name": "Plan-Task Linkage",
        "tasks": [
            "Extend plan parser to extract phases",
            "Create plan-to-task mapping",
            "Add plan progress tracking"
        ]
    },
    "phase_5": {
        "name": "Query Extensions",
        "tasks": [
            "Add hierarchy query patterns",
            "Add agent result queries",
            "Add plan progress queries"
        ]
    }
}


// ============================================================
// SECTION 7: INTEGRATION WITH VSM KERNEL
// ============================================================

// Tasks can be VSM documents with proper metadata
// Using the centralized VSM kernel for generation

task_vsm_example = """
⟦ TASK-001 | TASK-v1 | vsm-1.2.1 | 2026-09-07T19:31:07Z ⟧

@vsm 1.2.1
@status active

task(TASK-001):
  title = "Organize documentation"
  parent_id = null
  plan_id = "DOC-ORGANIZE-001"
  phase = "P1"
  status = in_progress
  priority = high
  agent = vos-kernel
  what = "Consolidate and organize all documentation"
  context = "Documentation was created haphazardly during migration"
  learnings = ["54 files had short footers", "134 files had hardcoded timestamps"]
  subtasks = ["TASK-001-A", "TASK-001-B"]

"""


// ============================================================
// SECTION 8: BENEFITS
// ============================================================

benefits = {
    "context_preservation": "No more lost context between sessions",
    "task_hierarchy": "Clear parent/child relationships",
    "agent_attribution": "Know who is working on what",
    "knowledge_accumulation": "Subagent conclusions persist and are reusable",
    "plan_tracking": "Track progress against plans",
    "reduced_redundancy": "Don't re-do work already completed"
}


