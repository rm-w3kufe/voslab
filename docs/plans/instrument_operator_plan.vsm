⟦ instrument_operator_plan | PLAN-v1 | vsm-1.2.1 | 2026-10-06T04:24:21Z ⟧

@vsm 1.2.1
@status ratified


// INSTRUMENT-OPERATOR — make instrument omission detectable
// Category found in diagnosis 2026-10-05 (classes A1-A5, "instrument
// declared, never called"): references rotted silently in opencode.json,
// zero call events for search_graph / socratic_evaluate / state_onboard /
// parse_query / journal_mark / canon_query / state_verify in the log
// window while rsi-cycle logged 894 events; guard coverage is
// incident-driven, so never-bitten instruments (schema_evo, journal)
// degraded without anyone noticing.

// S5 APPROVAL RECORD (rmw3, 2026-10-06):
//   "si, registra y luz verde ... pero antes de ejecutar, quiero que me
//    muestres el plan" -> plan presented -> "estamos bien yo creo".
//   Recommendations adopted: (1) loader = advisory (style
//   vsf-onboard-reminder, never blocking), (2) auto-creation emits DRAFT
//   proposals requiring S5 ratification (never self-activates),
//   (3) Fase 1 (references-health check) runs first.

purpose: "
  Bind every declared cognitive instrument to an occasion that calls it;
  load an advisory reminder when an occasion passes without a call;
  draft (never activate) new instruments when an omission repeats; and
  give references a live health check so topology rot cannot go silent
  again.
"

taxonomy: {
  A1: "declared, never loaded (loader missing)",
  A2: "cadence declared, no operator (journal: 2 marks / month)",
  A3: "orphan instrument (schema_evo_status crashes, nobody calls it)",
  A4: "call site without an instrument (blind spot in the log)",
  A5: "blindness to omissions (no signal for what was NOT called)",
}

approval: {
  authority: "S5 rmw3",
  date: "2026-10-06",
  recommendations: [
    "loader advisory, style vsf-onboard-reminder (once/session, fail-safe)",
    "auto-creation => draft proposal + S5 ratification, never auto-activate",
    "Fase 1 first: references-health before anything else",
  ],
}

phases: [
  { id: "F0", name: "register + commit references", status: "done",
    evidence: "commits e84d2fd (opencode.json references 6/6) + 8e3b13f (plan doc + plan_registry + backlog G-33/G-34/D-21/D-22)" },
  { id: "F1", name: "references-health check", status: "done",
    evidence: "commit 0b6aa9c: check references-health (pass 6/6 rc=0, NC discrimina rc=1), manifest 80 checks, gates 80/80 + NC17" },
  { id: "F2", name: "occasion -> instrument manifest", status: "done",
    evidence: "commit 1148acd: L_OCCASION layer with 7 occasion->instrument rules (hash-verified), boot-manifest-valid PASS, boot-ontology 0 violations" },
  { id: "F3", name: "loader advisory handler", status: "done",
    evidence: "handlers/instrument-loader.ts wired (vsf-event-router import+register, registry.json, handler_states); once/session + 6h fallback, 0 throw-new-Error; side fix: route_component root cause of G-13 (handlers/ dest + already-at-destination no-op), 3-case smoke PASS" },
  { id: "F4", name: "omission detector", status: "done",
    evidence: "R-d1 (basename+ambiguity filter) + R-d2 (state_journal.db via python spawn) live; tsx E2E: R-d2 caught real omission (238 tool events, 0 journal marks UTC) persisted to state/instrument_misses.jsonl; latent JS % bug in journalRowsToday fixed" },
  { id: "F5", name: "draft proposals", status: "done",
    evidence: "repeat miss -> state/instrument_drafts.jsonl {status:draft, ratified:false, requires:S5, plan_ref:INSTRUMENT-OPERATOR-001}; verified E2E (run C), auto_execute:false" },
  { id: "F6", name: "verify + commit", status: "done",
    evidence: "run_gates 79/80 live (child-boot-state-archive red by design on dirty tree) + NC 17 PASS; plugin_contract rc=0; pre-commit TS checks rc=0; kernel suite 309 passed; tsx E2E A/B/C (miss/skip/draft); single closing commit with session block" },
]

success_criteria: "
  references-health check passes on all 6 references; every
  ocasion->instrumento rule in the manifest has >=1 loader path; a missed
  occasion produces an advisory within the same session; a repeated miss
  produces a draft proposal and no activation; full battery green.
"

auto_verify: true
auto_execute: false
rollback_on_fail: true
