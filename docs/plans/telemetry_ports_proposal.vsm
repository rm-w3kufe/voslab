rule("GUARD") = {
  r17: "cero código hasta aprobación S5 de la fase de aplicación; cero corridas >70°C sin aprobación explícita",
  r9: "cero parches silenciosos — nominal que se mueve se declara in-doc; gap que aparece se declara, no se tapa",
  provenance: "toda cifra publicada declara procedencia — señal fingida es bug detectable por máquina (checker), no por lectura humana",
