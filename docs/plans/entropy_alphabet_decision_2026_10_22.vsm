  // h_eq: H del atractor actual (kernel_step.rs:233-239). Con gamma=1:
  //   kT=1 (idle): h_eq=1.796 -> 89.8% de h_max=2
  //   kT=2 (max load): h_eq=1.945 -> 97.3% de h_max=2
  // => el atractor saludable ya vive CERCA del techo: el techo NORMALIZADO
  // ~0.9-0.97 es inherentemente degen-dominante POR CONSTRUCCION del
  // alfabeto 4-niveles perfilado Boltzmann, no por bug.
  atraccion: "attractor h_eq = 1.796..1.945 de h_max=2 (89.8%..97.3% del techo)",

  // CALIBRATE-ENTROPY 2026-07-03 (kernel_step.rs:229-249): degen ya NO es
  // h_t >= 0.70·h_max absoluto: es h_t >= h_eq+delta (delta=0.05) — el
  // diagnostico de fase ya es correcto contra el atractor.
  fases: "stasis/inhale/degen RELATIVOS a h_eq (CALIBRATE-ENTROPY) — degen diagnostic correcto hoy",

  // (A) checkpoint: save_checkpoint() por tick (kernel_step.rs:302) +
  // reload h_rest EMA de persisted (125-126, 146-148) — sin transitorio.
  // (B) omega_validator.rs:395-408 — margin_free() y margin_free_binding()
  // EXCLUYEN H_T de la agregacion (comentado verbatim, confirmative).
  daño_restante: "NINGUNO operacional tras (A)+(B): resto es semantico+papel",
]

