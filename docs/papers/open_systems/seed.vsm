⟦ paper_open_systems | PAPER-3-SEED | vsm-1.0 | 2026-04-18 ⟧

@vsm 1.0
// domain_context: {target=vsf, env=VSF-session, layer=S4}
// Paper 3 — semilla formal
// Título tentativo: "VSF as a Framework for Open Physical Systems:
//   Information Thermodynamics, Maxwell's Demon, and the Lindblad Connection"
// Estado: SEED — no hay experimentos corridos, solo marco teórico

// ─── TESIS CENTRAL ───────────────────────────────────────────────────────────

thesis:
  "El VSF es un simulador natural de sistemas físicos abiertos.
   La equivalencia Shannon–Boltzmann (Jaynes 1957) hace que los kernels
   vsf-nucleus sean directamente interpretables como redes de sitios cuánticos
   bajo ecuaciones maestras de Lindblad.
   S4 como observador reproduce el Demonio de Maxwell con costo Landauer medible.
   La arquitectura VSM impone la separación observador/sistema requerida por
   la cibernética de segundo orden — y por la mecánica cuántica."

// ─── CONEXIONES TEÓRICAS ──────────────────────────────────────────────────────

theoretical_bridge: {
  shannon_boltzmann: {
    claim:  "H(t) = -Σ p_i log p_i es idéntica en forma a S_Boltzmann bajo Jaynes 1957"
    implication: "los kernels VSF son simuladores de Boltzmann sin cambio de código"
    cite:   "Jaynes (1957) — Phys. Rev. 106, 620"
  }
  organeles_as_lattice: {
    claim:  "organelos = sitios de red (tight-binding, Hubbard model)"
    mapping: {
      activations_p_i:  "ocupaciones de sitio"
      H_t:              "entropía de von Neumann (caso clásico límite)"
      trust:            "parámetro de orden (fracción de sitios en coherencia)"
      stasis_cos:       "solapamiento con estado de referencia (fidelidad)"
    }
    implication: "vsf-nucleus simula dinámica de red de Hubbard sin modificación"
  }
  s4_as_measurement: {
    claim:  "S4 = aparato de medición cuántico — su presencia causa decoherencia controlada"
    evidence: "EXP-OE-01: ΔH=0.1214 bits, D_KY 4→3 bajo control S4"
    quantum_analog: "back-action del aparato en medición débil (weak measurement)"
  }
  landauer_qubit: {
    claim:  "computación cuántica reversible evita costo Landauer — pero decoherencia
             lo reimporta. El Demonio de Maxwell reaparece exactamente ahí."
    implication: "VSF modela el límite termodinámico de computación cuántica"
    cite:   "Landauer (1961) — IBM J. Res. Dev. 5, 183"
  }
  lindblad: {
    claim:  "la ecuación maestra de Lindblad es el formalismo natural para
             sistemas cuánticos abiertos — equivalente al loop φ↑/φ↓ de VSF"
    mapping: {
      lindblad_operators: "operadores de salto = intervenciones S4 (φ↓)"
      decoherence_rate:   "frecuencia de intervención (1 per 100 ticks en EXP-OE-01)"
      steady_state:       "atractor VSF — stasis_cos=1.000 en condición A"
    }
    cite:   "Lindblad (1976) — Commun. Math. Phys. 48, 119"
  }
}

// ─── ESTRUCTURA TENTATIVA ─────────────────────────────────────────────────────

structure: [
  "§1 Introduction — información termodinámica como lenguaje unificado"
  "§2 Shannon–Boltzmann bridge — Jaynes 1957, equivalencia formal"
  "§3 VSF kernel as open system — organelos, H(t), φ↑/φ↓ como aparato"
  "§4 Experiment: Maxwell's Demon (EXP-OE-01) — resultados empíricos"
  "§5 Landauer bound — costo de intervención, restauración Segunda Ley"
  "§6 Lindblad connection — ecuación maestra, operadores de salto, steady-state"
  "§7 Quantum computing limit — decoherencia como Demonio inevitable"
  "§8 Discussion — VSF como simulador de materiales + computación cuántica"
  "§9 Open questions + future experiments"
]

// ─── EXPERIMENTOS REQUERIDOS ──────────────────────────────────────────────────

experiments_needed: [
  exp(lindblad_kernel): {
    id:      "EXP-LK-01"
    status:  "idea"
    goal:    "implementar operadores de Lindblad en vsf-nucleus — L_j φ ρ φ† terms"
    impl:    "modificar run_maxwell_demon: reemplazar sesgo heurístico por
              operadores de salto cuánticos L_j con tasa γ"
    metric:  "comparar ρ_steady (Lindblad) vs atractor VSF — ¿son el mismo?"
    blocker: "requiere álgebra de matrices complejas en Rust (nalgebra)"
  }
  exp(decoherence_rate): {
    id:      "EXP-DR-01"
    status:  "idea"
    goal:    "barrer tasa de intervención S4 (γ=1/100, 1/50, 1/10 ticks)
              → medir ΔH y D_KY en función de γ"
    metric:  "curva ΔH(γ) — ¿lineal? ¿hay γ_crítico?"
    blocker: "ninguno — extensión directa de EXP-OE-01"
    effort:  "bajo — solo cambiar parámetro de intervención"
  }
  exp(landauer_sweep): {
    id:      "EXP-LS-01"
    status:  "idea"
    goal:    "barrer kT (temperatura del baño) → medir costo Landauer empírico
              vs costo teórico kT·ln2"
    metric:  "¿coincide el ΔH medido con kT·ln2 × n_interventions?"
    effort:  "medio — requiere parametrizar kT en el kernel"
    blocker: "kT hardcodeado en maxwell_demon — extraer como parámetro"
  }
]

// ─── AUDIENCIA Y VENUE ────────────────────────────────────────────────────────

audience: [
  "comunidades de sistemas complejos: UV ISCV, Santa Fe Institute"
  "físicos computacionales (modelación de materiales)"
  "grupos de computación cuántica (límite Landauer)"
  "comunidad Beer/Metaphorum (conexión VSM–termodinámica)"
]

venue_candidates: [
  "Entropy (MDPI) — open access, cubre información termodinámica",
  "Physical Review E — si el formalismo Lindblad está completo",
  "Complex Systems (Santa Fe) — si el ángulo es sistemas complejos",
  "Proceedings Metaphorum — si el ángulo es VSM",
]

// ─── PREREQUISITOS ────────────────────────────────────────────────────────────

prerequisites: [
  P1: "Paper 1 (attractor_convergence) publicado o en revisión",
  P2: "EXP-DR-01 corrido — extensión directa de EXP-OE-01, bajo esfuerzo",
  P3: "formalismo Lindblad mapeado a notación VSM (trabajo teórico, ~1 sesión)",
  P4: "acceso a nalgebra en Rust — para EXP-LK-01 (opcional para paper básico)",
]

citations_core: [
  "Maxwell (1867) — Theory of Heat",
  "Boltzmann (1877) — Über die Beziehung...",
  "Jaynes (1957) — Phys. Rev. 106, 620",
  "Landauer (1961) — IBM J. Res. Dev. 5, 183",
  "Lindblad (1976) — Commun. Math. Phys. 48, 119",
  "von Foerster (1979) — Cybernetics of Cybernetics",
  "Beer (1979) — The Heart of Enterprise",
  "Bennett (1982) — Thermodynamics of Computation",
  "Zurek (2003) — Decoherence, einselection, and the quantum origins of the classical",
]

