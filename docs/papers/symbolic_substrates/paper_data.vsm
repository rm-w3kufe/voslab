@vsm 1.0
// paper_data.vsm — symbolic_substrates (Paper 2): canonical data provenance + thesis.
// created: 2026-06-26 (Opus session). UNIFIES two former seeds per rmw3 decision:
//   "P2 absorbe a P_VSL" — symbolic_substrates is the primary paper; vsl_language
//   (the language + agent-as-compiler paper) folds into it as the LANGUAGE lens.
// supersedes: docs/papers/vsl_language/{main.tex,paper_data.vsm} (now source material).
// purpose: single source of truth for Paper 2 — thesis, two lenses, hypotheses,
//   experiment census (real numbers), section skeleton, novelty, program relationship.
// [[project_paper2_seed]] [[project_paper_vsl]] [[paper-program]] [[feedback_single_source]]

⟦ paper_data | symbolic_substrates | vsm-1.0 | 2026-06-26 ⟧

meta:
  title     = "Symbolic Substrates: VSL as a Viable Coordination Medium Between
               Heterogeneous Cognitive Systems"
  subtitle  = "(working) — the language, the agent that compiles it, and whether
               meaning survives the crossing"
  file      = "docs/papers/symbolic_substrates/main.tex"
  status    = "SKELETON — main.tex compiles, paper_data complete (2026-06-26).
               Prose sections [TO WRITE] in a later Opus writing session."
  absorbs   = "P_VSL (vsl_language) — agent-as-compiler + grammar + Shannon argument
               become the LANGUAGE lens of this paper. Decision rmw3 2026-06-24/26."
  target    = "Systems Research and Behavioral Science (SRBS — the Beer community, same
               venue family as P_phi) OR J. Artificial Intelligence Research. Decide
               after P1 (attractor) is submitted. Most accessible paper of the program
               to a CS/AI + cybernetics audience."
  tone      = "NARRATIVE first, experimental second. More story than theorem. Two lenses
               braided: (1) what VSL IS (a language an agent compiles); (2) whether VSL
               WORKS as a substrate (does operational meaning survive an inter-system
               crossing). The second is the cybernetic core; the first is its mechanism."
  gate_met  = "N≥3 PHI experiments with data (EXP-PHI-01 + 01-bis + 02). Met 2026-06-26."

// ── THE GAP THIS PAPER ADDRESSES ─────────────────────────────────────────────
problem:
  one_line = "Heterogeneous cognitive agents (LLMs of different architectures) must
              coordinate as distinct VSM layers. The S2 coordination channel between
              them had no adequate medium — and even with a medium, it is not obvious
              that operational MEANING survives the crossing between two minds."

  why_existing_media_fail = {
    natural_language: "Ambiguous, context-dependent, verbose (10-50× the tokens of the
                       operational state it describes). No parse guarantee, not verifiable.",
    json_yaml:        "Parseable but semantically flat — no notion of system layer, channel
                       type, or viability constraint. Nothing constrains an LLM to viable
                       configurations.",
    general_code:     "Turing-complete but domain-blind. A Rust struct does not know it is
                       an S3 node; the type system does not express viability.",
    mathematics:      "Precise but not generatable in real-time interaction. Formalism and
                       operational medium are decoupled.",
  }

  the_deeper_problem = "A medium that parses is necessary but NOT sufficient. The substrate
                        question is second-order (von Foerster): when agent A encodes intent
                        as VSL and agent B decodes it, does B reconstruct A's operational
                        referents, or its own? A correct parse tree with wrong referents is a
                        SILENT failure. This is the paper's central empirical object."

// ── UNIFIED THESIS (two lenses, one claim) ───────────────────────────────────
thesis:
  claim = "VSL (Viable System Language) is the minimum formal language that lets
           heterogeneous cognitive agents coordinate as VSM layers — and the act of
           generating it is semantic COMPRESSION, not translation. Its viability as a
           substrate is measurable and is governed by Ashby's Law: computational variety
           belongs to a deterministic layer, semantic variety to the cognitive layer. When
           the substrate respects that split, meaning survives the crossing by construction."

  lens_language = "What VSL IS. A DSL derived from VSM structure; an LLM that generates it
                   is an agent-compiler performing semantic compression; quality is a
                   distribution (parse rate, fidelity, round-trip preservation), not a
                   binary. D6 (no LLM at L0/L1) is the constraint that gives the language
                   clean semantics — the cognitive/operational boundary IS the language
                   boundary. (This lens = the absorbed P_VSL contribution.)"

  lens_substrate = "Whether VSL WORKS as a coordination medium. Compression is real but
                    insufficient: the load-bearing finding is the structural-vs-semantic
                    drift — structure crosses ≈100%, meaning drifts to ≈40% without a domain
                    anchor. The resolution is architectural (Ashby): split the brief into
                    COMPUTED fields (deterministic, wrapper-executed, fidelity=1.0 by design)
                    and INTERPRETED fields (semantic, LLM-executed, capability-dependent).
                    (This lens = the original P2/symbolic_substrates contribution.)"

  why_one_paper = "The two lenses are the same object seen twice. The language exists BECAUSE
                   a substrate was needed; the substrate is viable BECAUSE the language splits
                   variety by competence. Separating them would publish a mechanism without its
                   purpose, or a purpose without its mechanism."

// ── THE AGENT-AS-COMPILER ARGUMENT (language lens) ───────────────────────────
agent_as_compiler:
  classical_compiler = "Source → machine code. Deterministic, lower abstraction, no ambiguity
                        resolution. Correctness is binary."
  llm_as_compiler    = "Natural language (high ambiguity / low precision / high expressiveness)
                        → VSL (low ambiguity / high precision / constrained expressiveness).
                        NOT classical compilation: SEMANTIC COMPRESSION — the agent extracts
                        operational intent from NL and encodes it in the minimum formal
                        representation that preserves that intent."
  measurable_quality = "parse rate, semantic fidelity, round-trip intent preservation —
                        a distribution, not a bit."
  d6_enabling        = "D6 (no LLM at L0/L1): the agent operates at L≥2, generating VSL that
                        governs L0/L1. The language only needs to express what an L≥2 agent
                        says to L0/L1 processes."
  shannon_link       = "Grammar = codebook. Valid VSL = low-dimensional manifold in the space
                        of all strings. Generating VSL = finding a point on that manifold.
                        A session without VSL is Shannon noise to the parser (max entropy);
                        VSL gives it a codebook. Parallels the kernel's ℝ¹²⁸→D_eff≈5 compression
                        (cf. P1, P_phi)."

// ── THE SUBSTRATE-VIABILITY ARGUMENT (substrate lens) ────────────────────────
substrate_viability:
  central_object = "Does operational meaning survive an inter-system crossing? Measured as the
                    gap between STRUCTURAL fidelity (S-layer hierarchy, φ↑/φ↓ channels, PSI
                    thresholds, covenant step, metric names) and SEMANTIC fidelity (correct
                    domain referents)."

  drift_finding = "Structural ≈100% ∧ semantic ≈40% (EXP-PHI-01). The receiving model parses
                   perfectly yet substitutes its OWN operational context for VSF referents
                   (φ↑ checkpoints → cloud-sync; vm-nucleus → an internal knowledge module).
                   This CONTEXT SUBSTITUTION is structurally silent. The single 'fidelity'
                   metric conflated two independent properties — splitting them is the first
                   contribution of the substrate lens."

  domain_anchor = "Fix: a lightweight header `domain_context: {target=…, env=…, layer=…}`
                   (~8 tokens) eliminates context substitution in subsequent tests. Semantic
                   drift ≈60% → ≈5% with the anchor (EXP-PHI-01 H3)."

  ashby_resolution = "The deeper fix (EXP-PHI-02) is not to anchor harder but to NOT ask the
                      LLM for what it cannot reliably do. Partition the brief output_format:
                        computed:    {key: parseable_pattern}   — wrapper executes (deterministic)
                        interpreted: {key: semantic_description} — LLM executes (semantic)
                      Requisite Variety at the grammar level: fidelity(computed)=1.0 by design,
                      fidelity(interpreted) ∈ (0,1) by capability. This ARCHITECTURALLY closes
                      H6 (closure ≠ correctness) — the failure was structural, not a model deficit."

  sovereignty_cost = "A substrate that depends on an external agent has a measurable, multi-
                      dimensional COST OF EXISTING: Σ(credentials, routing, upstream availability,
                      dynamic resources). Surfaced in EXP-PHI-01/01-bis as a structural property
                      of the loop, not an accident (H5). Connects to P_phi's cost-of-coherence."

// ── HYPOTHESES (unified H1–H9; PHI experiments are the anchor) ────────────────
hypotheses:
  H1_substrate_viability = {
    statement: "A compact formal language can sustain a closed algedonic loop between two
                heterogeneous LLMs acting as distinct VSM layers (Qwen=S1, Claude=S3-S5)."
    status:    "CONFIRMED — EXP-PHI-01 Run 005 (loop closed); EXP-PHI-01-bis (4 rounds pure
                VSL Claude↔Qwen: 8 axioms + 12 defs + 3 corollaries exchanged)."
  }
  H3_compression = {
    statement: "tokens(VSL) ≪ tokens(NL-equivalent) for the same operational state."
    status:    "CONFIRMED — standalone 38–51%; machine-to-machine (shared schema) 72–79%,
                growing with protocol complexity (orig. single-case 83%). EXP-PHI-01 table."
  }
  H5_substrate_sovereignty = {
    statement: "The substrate carries a structural, multi-dimensional cost of depending on an
                external cognitive agent."
    status:    "CONFIRMED — Σ(credentials, routing, upstream availability, dynamic resources).
                Surfaced as a measurable property, not an incident (EXP-PHI-01 + bis)."
  }
  H6_operational_fidelity = {
    statement: "Loop closure ≠ correctness. Detecting that the loop closed is NOT a viability
                signal."
    status:    "OBSERVED → ARCHITECTURALLY CLOSED. EXP-PHI-01 Run 005: 3/5 keys correct (LLM
                under-counted s_level_mentions ~5× — counting bias). Resolved by H7 (split)."
  }
  H7_split_fidelity = {
    statement: "Partitioning the brief into computed (wrapper) + interpreted (LLM) fields gives
                fidelity(computed)=1.0 deterministically; fidelity(interpreted) is capability-
                dependent. Total fidelity is separable per axis (Ashby)."
    status:    "CONFIRMED — EXP-PHI-02 2026-06-26: fidelity_computed=1.0 on all 5 tasks, 3 runs.
                Deterministic by construction, not by model capability."
  }
  H8_compression_via_split = {
    statement: "When the LLM handles only interpreted fields, the brief is much shorter."
    status:    "BYTES CONFIRMED (median 450B vs 8000B PHI-01 baseline = 18× compression).
                LATENCY hardware-bound (qwen2.5-coder:1.5b CPU ~321s vs 12s target — a model/HW
                constraint, not a design failure; GPU+larger model would meet it)."
  }
  H9_capability_taxonomy = {
    statement: "Which field types are reliably computable vs. reliably interpretable is a model-
                specific capability matrix."
    status:    "PARTIAL — EXP-PHI-02: computed fields RELIABLY_COMPUTED (1.0); interpreted are
                CAPABILITY- and DOMAIN-KNOWLEDGE-dependent. Key datum: 'covenant' → 'legal
                contract' misclassification, and watchdog→S3 vs ref S5 — the boundary is DOMAIN
                knowledge, not task type. Distinguishes two H9 axes: task-type (robust) vs
                domain (model-specific)."
  }
  // Deferred (future PHI experiments):
  H2_algedonic_floor      = "deferred — L_floor = T_poll + T_exec + T_post irreducible latency."
  H4_closure_determinants = "deferred — P(closure) = f(specificity, gap, retry)."

// ── EXPERIMENT CENSUS (real numbers; provenance) ─────────────────────────────
experiments:
  done:
    EXP-PHI-01: {
      what:    "VSL compression + structural/semantic drift, cross-model.",
      data:    "docs/experiments/EXP-PHI-01/ (+ extracted to symbolic_substrates/seed_vsl_from_paper1.tex)",
      numbers: "compression standalone 0.38–0.51, schema 0.72–0.79; structural≈100% / semantic≈40%;
                anchor ~8 tokens → semantic drift 60%→5%; cross-model Gemini + Qwen3.6-Plus + Claude.",
      anchors: "H1, H3, H5, H6, H2(drift-split), H3(language H1/H2/H3)",
    }
    EXP-PHI-01-bis: {
      what:    "Pure-VSL inter-LLM coordination under MAX sovereignty (no shared infra).",
      numbers: "4 rounds Claude↔Qwen, T1-T4 + G1-G5 closed; 8 axioms + 12 defs + 3 corollaries.",
      anchors: "H1 (substrate viability under max sovereignty)",
    }
    EXP-PHI-02: {
      what:    "Computed vs interpreted brief-field split — S2-parser delegation (Ashby).",
      data:    "docs/experiments/EXP-PHI-02/results.vsm (+ results/*.json)",
      numbers: "H7 fidelity_computed=1.0 (5/5, 3 runs); H8 bytes 450 vs 8000 (18×), latency FAIL
                (1.5b CPU 321s); H9 domain boundary (covenant→legal; S3/S5 confusion). 5 tasks.",
      anchors: "H7, H8, H9; architecturally closes H6",
    }
  language_metrics_existing:
    parse_rate:   "212/217 corpus files pass VSL v1.0 parser (~97.7%). 5 failures = legacy
                   format edge cases, not grammar violations. [[project_vsl_v1_parser]]"
    generation:   "Qwen generates next_experiment.vsm via vsl_run.py plan/eval/propose.
                   [[project_vsl_v2_interpreter]]"
    corpus_sweep: "--corpus sweep: BNF production coverage across corpus."
  designed_subsumed:
    // The former P_VSL EXP-VSL-01..04. Several are now SUBSUMED by the PHI experiments;
    // the rest are the language-lens future work. Keep, but mark overlap.
    EXP-VSL-01_compression:  "SUBSUMED by EXP-PHI-01 (compression table) + H8 (split bytes).
                              Residual: NL-vs-VSL on 10 generic session handoffs for a clean
                              compression_ratio + ambiguity_ratio (=1 by construction)."
    EXP-VSL-02_fidelity:     "round-trip intent → Claude(NL) → VSL → Qwen(exec) → outcome.
                              OVERLAPS H1/H6; reframe as the round-trip companion to H7."
    EXP-VSL-03_generation:   "20 controlled NL scenarios → Qwen VSL; parse_rate + semantic_acc.
                              OVERLAPS H9; the language-lens generalisation of the capability matrix."
    EXP-VSL-04_entropy:      "H(VSL) vs H(NL) Shannon entropy; grammar as codebook, valid VSL as
                              low-D manifold. NOVEL, not subsumed — the information-theory closer.
                              Connects to P_phi compression thread. Run before the closing section."
  honest_status = "The empirical spine (H1/H3/H5/H6/H7/H8/H9) is DONE on real data. EXP-VSL-04
                   (Shannon) is the one genuinely-new measurement worth running for the closing
                   argument; VSL-01/02/03 are largely subsumed and can be reported as confirmations."

// ── SECTION SKELETON (the unified narrative) ─────────────────────────────────
sections:
  §1_problem:
    title = "The Problem of Saying What a System Is"
    tone  = "narrative — origin story"
    moves = ["the first handoff too long for a context window but too structured for prose;",
             "why NL / JSON / code / math each fail in a specific way;",
             "VSL emerged bottom-up from the .vsm files we were already writing."]
  §2_language:
    title = "A Grammar Derived From Structure, and the Agent That Compiles It"
    tone  = "narrative + formal grammar excerpts + theory"
    moves = ["the three things VSL must express: identity V(id,L), channels (φ↑/φ↓/algedonic),
              viability state; the BNF fits a page; what VSL deliberately omits;",
             "recursion in grammar mirrors recursion in VSM (recursive: true);",
             "agent-as-compiler: semantic compression, not translation; D6 as the boundary;",
             "Qwen=S1, Claude=S3-S5, VSL = the S2 channel between cognitive layers."]
  §3_substrate_question:
    title = "Does Meaning Survive the Crossing?"
    tone  = "the cybernetic core — second-order framing"
    moves = ["parse correctness is necessary, not sufficient; the silent-failure mode;",
             "structural ≈100% vs semantic ≈40% (the drift table);",
             "context substitution as a structural property of heterogeneous coupling;",
             "the domain_context anchor (~8 tokens): a cheap variety attenuator."]
  §4_ashby_resolution:
    title = "Requisite Variety at the Grammar Level"
    tone  = "the load-bearing contribution"
    moves = ["computed vs interpreted partition; fidelity_computed=1.0 by design (H7);",
             "this ARCHITECTURALLY closes H6 (closure ≠ correctness) — Ashby, not capability;",
             "the capability matrix (H9): task-type boundary (robust) vs domain boundary (model-specific);",
             "compression via split (H8): 18× bytes; latency is hardware, stated honestly."]
  §5_sovereignty:
    title = "The Cost of Depending on Another Mind"
    tone  = "the substrate's thermodynamics-adjacent honesty"
    moves = ["the multi-dimensional sovereignty cost (H5);",
             "connection to P_phi cost-of-coherence; the substrate is not free."]
  §6_measuring:
    title = "Measuring the Language"
    tone  = "experimental — the evidence section"
    moves = ["parse rate 212/217; the PHI experiments; EXP-VSL-04 Shannon entropy;",
             "grammar as codebook, valid VSL as a low-D manifold."]
  §7_closing:
    title = "What a Substrate Is For"
    tone  = "narrative — closing argument"
    moves = ["a language is successful when it compresses the right things;",
             "VSL compresses operational state; S5 policy stays in NL (carries intentionality
              VSL cannot encode) — the boundary is a design decision, not a limitation;",
             "grammar-as-architecture-mirror: VSL's gaps are the system's debts (v2);",
             "open: emergent language; can VSL express the cost-of-existing?"]

// ── GRAMMAR AS ARCHITECTURE MIRROR (language-evolution thread, from P_VSL) ────
// Preserved from vsl_language paper_data: the grammar co-evolves with the architecture.
grammar_mirror:
  principle = "Every gap in VSL v1 corresponds to an architectural debt. VSL v2 closes those
               gaps in parallel with the system closing them. The paper documents that
               co-evolution: grammar and architecture as one design act."
  v1_gaps_v2_additions = {
    phi_down_rejected: "S1 can reject a φ↓ pushing τ outside Ω (closes DEBT_S1).",
    predictive_alert:  "S4→S5 anticipatory event {projected_crossing_tick, confidence, regime}
                        (closes ITEM_13.3) — note: EXP-S4-02 (P1) showed the internal channel is
                        empty without external variance; the grammar anticipates the CLIMA coupling.",
    env_sample:        "external observation channel {source: psi|thermal|loadavg, regime: shannon}
                        — the regime field makes the von Foerster / Shannon split explicit.",
    s2_coordination:   "coordinate V<->V via s2 {protocol, active:false} — semantics activate at N≥2 S1.",
    s5_veto:           "veto channel {scope: operational|policy} — closure, distinct from algedonic
                        (alert). EXP-S5-01 (P1) demonstrated this veto is operational.",
  }
  v2_compression = "implicit channels, status shorthand, links[…] block, unicode φ↑/φ↓ —
                    est. 40–60% token reduction for equivalent semantics. EXP-VSL-01/H8 quantify."
  note = "v2 BNF design is a separate Sonnet/Opus task (see TASKS task U/v2). This paper
          DOCUMENTS the rationale; it does not require v2 shipped to make its claims —
          v1 carries H1/H3/H5/H6/H7/H8/H9."

// ── NOVELTY ──────────────────────────────────────────────────────────────────
novelty:
  - "First DSL derived from VSM structure whose grammar encodes viability constraints."
  - "Agent-as-compiler: the LLM as semantic compressor, with measurable quality (parse rate,
     fidelity, round-trip), not just a text generator."
  - "The structural-vs-semantic drift distinction — a viability measurement of an inter-system
     coordination medium (second-order cybernetics, operationalised)."
  - "Requisite Variety at the grammar level (computed/interpreted split): a constructive proof
     that meaning can be made to survive a heterogeneous crossing by partitioning variety by
     competence — fidelity=1.0 by design, not by model scale."
  - "The sovereignty cost: a substrate that depends on another mind has a measurable cost of
     existing — a structural property, not an incident."
  - "Shannon framing: grammar as codebook, valid VSL as a low-D manifold; generating VSL is
     finding a point on it."

// ── RELATIONSHIP TO THE PAPER PROGRAM ────────────────────────────────────────
paper_program:
  P1_attractor    = "the kernel VSL governs; φ↑ events are VSL-structured. P1 §sec:vsl points here.
                     P1 EXP-S4-02/EXP-S5-01 give the grammar's predictive_alert/veto their referents."
  P_phi_epistemic = "shares the compression / cost-of-coherence thread; the Shannon argument
                     (§6, EXP-VSL-04) connects directly."
  P3_open_systems = "VSL as the medium through which S3 reaches L0/L1 processes under thermodynamic
                     constraint — future bridge."
  P_VSL_status    = "ABSORBED into this paper (rmw3 2026-06-26). vsl_language/ retained as SOURCE
                     material; canonical P2 = symbolic_substrates. Update [[paper-program]]."
  this_paper      = "P2 — symbolic_substrates. Empirical spine DONE (N≥3 PHI). Skeleton compiles.
                     Prose = a future Opus writing session. GATE to submit: after P1 (program order)."

// ── DATA PROVENANCE / HONESTY ────────────────────────────────────────────────
provenance:
  real_data   = "All H1/H3/H5/H6/H7/H8/H9 numbers come from EXP-PHI-01/01-bis/02 on real LLMs
                 (Gemini, Qwen2.5-coder, Qwen3.6-Plus, Claude). No simulated substrate."
  hardware    = "EXP-PHI-02 ran qwen2.5-coder:1.5b CPU-only on LXC 110 (n02). The latency FAIL is
                 explicitly hardware/model-bound, NOT a design result — stated as such (H8)."
  honest_gaps = ["H2 (algedonic floor) + H4 (closure determinants) deferred to future PHI runs.",
                 "EXP-VSL-04 (Shannon entropy) is the one new measurement worth running before §6/§7.",
                 "H9 capability matrix is partial (1 model, 5 tasks); a fuller matrix needs ≥3 models."]
  single_source = "This file supersedes vsl_language/paper_data.vsm for P2. Do not edit both —
                   symbolic_substrates is canon. [[feedback_single_source]]"

watermark = "⟦ /paper_data | symbolic_substrates | vsm-1.0 | 2026-06-26 ⟧"
