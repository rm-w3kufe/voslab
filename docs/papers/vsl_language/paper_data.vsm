// ─────────────────────────────────────────────────────────────────────────────
// paper_data.vsm — vsl_language: seed + provenance.
// created: 2026-06-24 (end of philosophical session)
// origin: VSL v1.0 parser (task T, done) + v2.0 interpreter (task U+S, done) +
//   Shannon/compression thread developed in epistemic_viability session.
// purpose: anchor a paper about VSL as a novel language — origin, agent-as-compiler,
//   metrics, and the information-compression argument.

⟦ paper_data | vsl_language | vsm-1.0 | 2026-06-24 ⟧

meta:
  title        = "VSL: A Language for Viable Systems and the Agent That Compiles It"
  file         = "docs/papers/vsl_language/main.tex"
  status       = "SEED — skeleton written, experiments partially available"
  target       = "TBD — consider: J. Artificial Intelligence Research, or Software:
                  Practice and Experience, or Systems Research and Behavioral Science
                  (same community as P_phi). Decision after P1 (attractor) is submitted."
  tone         = "NARRATIVE first, experimental section second. More story than theorem.
                  Reads as: why this language needed to exist, how it emerged, what it
                  does that nothing else does — and then: here is the evidence."
  register     = "DSL design + cognitive systems + information theory. Accessible to
                  systems researchers who are not PL theorists."

// ── THE PROBLEM THIS PAPER SOLVES ─────────────────────────────────────────────
problem:
  gap = "There is no language designed specifically for the operational state of a
         viable system. Natural language is ambiguous and verbose. Mathematical formalisms
         are too dense to generate in real time. General-purpose code is opaque to
         cognitive agents (LLMs). The S2 coordination channel had no adequate medium."

  why_existing_languages_fail = {
    natural_language: "Ambiguous, context-dependent, verbose. A session description in
                       prose requires 10-50x more tokens than the operational state it
                       describes. No parse guarantee. Cannot be verified.",
    json_yaml:        "Parseable but semantically flat. No notion of system layer, channel
                       type, or viability constraint. An LLM generating JSON for a VSM
                       state has no grammar to constrain it to viable configurations.",
    general_code:     "Turing-complete but carries no domain semantics. A Rust struct does
                       not know it represents an S3 node. The type system does not express
                       viability constraints.",
    mathematics:      "Precise but not generatable. No LLM produces LaTeX VSM specs in
                       real-time interaction. The formalism and the operational medium are
                       decoupled.",
  }

// ── THE ARGUMENT ──────────────────────────────────────────────────────────────
argument:
  thesis = "VSL is the minimum formal language that closes the gap between the
            operational state of a viable system and the cognitive agents that govern it.
            Its design is not arbitrary: it is derived from the structure of what needs
            to be expressed (VSM channels, viability constraints, system recursion) and
            from the constraints of the medium (must be generatable by an LLM, must be
            parseable by a deterministic parser, must be compressible relative to NL)."

  agent_as_compiler = {
    classical_compiler: "Translates from high to low abstraction (source → machine code).
                         Deterministic. No ambiguity resolution.",
    llm_as_compiler:    "Translates between two types of abstraction: natural language
                         (high ambiguity, low precision, high expressiveness) and VSL
                         (low ambiguity, high precision, constrained expressiveness).
                         This is NOT classical compilation. It is SEMANTIC COMPRESSION:
                         the agent extracts the operational intent from the natural
                         language and encodes it in the minimum formal representation
                         that preserves that intent.",
    implication:        "The agent's quality as a VSL generator is measurable: parse rate,
                         semantic fidelity, round-trip preservation of intent. These are
                         empirical questions with quantifiable answers.",
    d6_rule:            "D6 (no LLM at L0/L1) is the constraint that makes this work:
                         the agent operates at L≥2, generating VSL that governs L0/L1
                         processes. The language is the boundary between cognitive and
                         operational layers.",
  }

  compression_argument = {
    shannon_link:   "VSL is an efficient code for the source that is the operational
                     state of a viable system. Shannon: compression lower bound = H of
                     the source. A VSL file encoding a session state is consistently
                     10-50x smaller than the NL equivalent while preserving parse
                     uniqueness (1 parse per valid VSL, vs. N interpretations per NL).",
    d_eff_parallel: "Just as the kernel compresses ℝ¹²⁸ to D_eff ≈ 5 effective dimensions,
                     VSL compresses an operational session (potentially 10k+ tokens of
                     context) to a structured representation of ~500-2000 tokens.
                     The attractor of the language is its grammar — the set of valid
                     VSL files is a low-dimensional manifold in the space of all strings.",
    incompressible: "A session without VSL is Shannon noise relative to the parser:
                     maximal entropy, no exploitable structure, every token potentially
                     new. VSL gives the session a codebook. The agent that generates VSL
                     is the compressor; the parser is the decompressor.",
  }

// ── SECTION SKELETON ──────────────────────────────────────────────────────────
sections:
  §1_origin:
    title = "The Problem of Saying What a System Is"
    tone  = "narrative — origin story"
    moves = [
      "The moment we needed a new language: the first handoff between sessions that
       was too long for a context window but too structured for pure prose.",
      "Existing languages were wrong in specific ways (NL verbose, code opaque, math
       non-generatable). The gap was not accidental — it reflects a deeper mismatch
       between the structure of viable systems and available formalisms.",
      "VSL emerged bottom-up from operational need, not from a language design workshop.
       Its first version was implicit in the .vsm files we were already writing.",
    ]

  §2_design:
    title = "A Grammar Derived From Structure"
    tone  = "narrative with formal grammar excerpts — readable, not a manual"
    moves = [
      "The three things VSL must express: system identity (V(id, L)), channel contracts
       (φ↑, φ↓, algedonic), and viability state (viable, blocked, partial).",
      "The BNF: small enough to fit in a page. Every production rule has a reason.",
      "What VSL deliberately does NOT express: implementation details, code, natural
       language prose. The boundary is a design decision, not a limitation.",
      "Recursion in the grammar mirrors recursion in VSM: any S1 unit can embed a
       full VSM (recursive: true). The language is self-similar at every scale.",
    ]

  §3_agent_compiler:
    title = "The Agent That Compiles"
    tone  = "narrative + theory — the novel contribution"
    moves = [
      "Qwen as S1, Claude as S3-S5: the architecture requires a language the S1 agent
       can generate and the S3 system can verify. VSL is that language.",
      "Semantic compression: the agent does not translate — it compresses. The difference
       matters. Translation preserves form; compression preserves meaning while reducing
       representation. A good VSL file is smaller than the NL it summarises AND more
       precise.",
      "Measurable quality: a compiler's correctness is binary (it compiles or it doesn't).
       An agent-compiler's quality is a distribution: parse rate, semantic fidelity,
       round-trip intent preservation.",
      "D6 as enabling constraint: the rule that keeps LLMs out of L0/L1 is what gives
       VSL its clean semantics. The language only needs to express what an L2+ agent
       needs to say to L0/L1 processes.",
    ]

  §4_experiments:
    title = "Measuring the Language"
    tone  = "experimental — the evidence section"
    existing_metrics = {
      parse_rate:    "212/217 corpus files pass v1.0 parser (~97.7%). The 5 failures
                      are documented edge cases (legacy format, not grammar violations).",
      generation:    "Qwen generates next_experiment.vsm via vsl_run.py plan/eval/propose.
                      Tasa de .vsm válidos generados: TBD (experiment needed).",
      corpus_sweep:  "--corpus sweep results: coverage of BNF productions across corpus.",
    }
    experiments_to_design = {
      EXP-VSL-01_compression: {
        what:   "Compression ratio: same operational state in NL vs. VSL.
                 Take 10 session handoffs. Measure token count NL vs. VSL.
                 Measure parse uniqueness (NL: N interpretations; VSL: 1).",
        metric: "compression_ratio = tokens_NL / tokens_VSL; ambiguity_ratio = N_interpretations_NL / 1",
        expected: "10-50x compression; ambiguity → 1 by construction",
      }
      EXP-VSL-02_fidelity: {
        what:   "Round-trip fidelity: intent → Claude (NL) → VSL → Qwen (execution) → outcome.
                 Does the VSL preserve the intent? Measure: human judge rates whether
                 Qwen's output matches the original intent.",
        metric: "fidelity_score ∈ [0,1]; degradation = 1 - fidelity_score",
        expected: "High fidelity for structural intents (deploy X to Y); lower for
                   nuanced policy decisions (the ambiguity lives at L≥3, not in VSL)",
      }
      EXP-VSL-03_generation_quality: {
        what:   "Qwen VSL generation quality under controlled prompts.
                 Give Qwen 20 operational scenarios in NL. Measure: parse rate,
                 semantic correctness (human judge), token efficiency vs. NL equivalent.",
        metric: "parse_rate, semantic_accuracy, compression_ratio",
        expected: "parse_rate > 90% (grammar learned); semantic gaps in edge cases",
      }
      EXP-VSL-04_entropy: {
        what:   "Shannon entropy of VSL corpus vs. NL corpus of equivalent content.
                 H(VSL) should be significantly lower than H(NL) — the grammar
                 constrains the space, reducing entropy.",
        metric: "H_vsl, H_nl, D_eff_vsl (effective vocabulary dimensions)",
        note:   "Connects directly to the Shannon thread in P_phi (epistemic_viability)",
      }
    }

  §5_compression_closing:
    title = "What a Language Is For"
    tone  = "narrative — closing argument"
    moves = [
      "A language is successful when it compresses the right things. VSL compresses
       operational state without compressing policy (S5 decisions remain in NL because
       they carry intentionality that VSL cannot encode).",
      "The grammar as attractor: the set of valid VSL files is a low-dimensional
       manifold in the space of all strings. Generating VSL is finding a point on
       that manifold — which is exactly what the agent-compiler does.",
      "Open questions: can VSL be learned by an agent without being explicitly taught?
       (emergent language); can VSL express the cost-of-existing distinction from P_phi?
       (the language's own limits as a research frontier)",
    ]

// ── ARCHITECTURAL REFRAME (2026-06-24) ───────────────────────────────────────
// Source: cross-examination Beer/vonFoerster/Shannon canon against implementation.
// Decision: papers do not conform to incomplete model — push implementation until
// VSM is validated, then document. rmw3: "el objetivo es el VSM, no los proxies."
architectural_reframe:
  principle = "P_VSL documents the language, not the system. The language exists and
               is measurable independently of whether the VSM is Beer-compliant.
               However, the GRAMMAR must evolve with the architecture — VSL today
               does not express what the complete VSM requires. That evolution IS
               part of the paper's contribution."

  grammar_debts = {
    DEBT_S1_phi_down_rejected: "VSL has phi_down as one-way channel. Once DEBT_S1
                                 is closed (S1 validates φ↓ before applying), the grammar
                                 needs: 'channel: phi_down_rejected -> V(...)'.
                                 The paper should acknowledge this as an open extension,
                                 not a completed feature.",

    DEBT_S2_nominal: "VSL has S2 channel grammar but with one S1 the semantics are
                      empty. The paper must be explicit: S2 grammar exists; S2 semantics
                      activate with N≥2 S1 units. This is a design virtue, not a defect —
                      the grammar anticipates the architecture.",

    DEBT_S3_discontinuous: "The agent-as-compiler argument assumes Claude-as-S3 operates
                            continuously. Current S3 is episodic. The paper should frame
                            VSL as the medium that ENABLES episodic S3 to be coherent
                            across sessions — not that it enables continuous S3 that does
                            not yet exist.",

    DEBT_S4_dual_channel: "Once ITEM_13 is implemented, VSL needs grammar for
                           'predictive_alert' events and the 'env_sample' channel type.
                           These extend the language. The paper can describe them as
                           designed extensions — showing the grammar is evolvable.",
  }

  vsl_v2_plan: {
    decision: "The P_VSL paper session IS the VSL v1→v2 promotion session.
               Writing the paper and designing v2 are the same act — the paper
               documents the design rationale; v2 is the design.
               rmw3 decision 2026-06-24."

    v2_design_principles: [
      "Grammar mirrors architecture exactly — no features without implementation,
       no implementation without grammar. v1 gaps = v2 additions.",
      "Maximum compression: minimum description length for operational state.
       v2 should be measurably more compressed than v1 (EXP-VSL-01 will quantify).",
      "Regime-aware: grammar distinguishes Shannon (external) from von Foerster
       (internal) channel types — a distinction v1 cannot express.",
      "S2 semantics activated: v2 defines the S2 coordination grammar so it is
       ready when N≥2 S1 units exist, even if currently nominal.",
    ]

    v2_new_grammar: {
      phi_down_rejected: "channel: phi_down_rejected -> V(...)
                          S1 can reject a φ↓ that would push τ outside Ω.
                          Closes DEBT_S1. New production in channel_type.",

      predictive_alert:  "event: predictive_alert {
                            projected_crossing_tick: u64
                            current_trajectory: f64
                            confidence: f64
                            regime: shannon | von_foerster
                          }
                          S4→S5 anticipatory channel. Closes ITEM_13.3.",

      env_sample:        "channel: env_sample <- external {
                            source: psi | thermal | loadavg
                            regime: shannon
                          }
                          External observation channel. Closes ITEM_13.0.
                          Regime field makes the von_Foerster/Shannon split explicit.",

      s2_coordination:   "coordinate: V(id1, L1) <-> V(id2, L1) via s2 {
                            protocol: anti_oscillation
                            active: false  // nominal until N>=2 S1 units
                          }
                          S2 semantics declared; active flag prevents phantom coordination.",

      s5_veto:           "channel: veto -> V(...) {
                            scope: operational | policy
                          }
                          S5 veto channel. Closes DEBT_S5.
                          Distinct from algedonic (alert) — this is closure.",

      flow_block:        "flow: datum_id {
                            sensor -> normalize -> project(R128) -> phi() ->
                            viability_check -> phi_up
                            regime: shannon  // at sensor boundary
                          }
                          Information flow tracing block. Generates Mermaid automatically.
                          ITEM_5.3 extension. Optional in v2; core in v3.",
    }

    v2_compression_improvements: {
      implicit_channels: "S-level implies default channel direction.
                          L1 → φ↑ is always up unless specified.
                          Removes boilerplate from 80% of declarations.",
      status_shorthand:  "viable / blocked / partial as bare keywords (no 'status:' prefix).",
      link_block:        "links [s3-star, s3, s5] shorthand for multi-channel declarations.",
      unicode_symbols:   "φ↑ φ↓ as valid tokens (v1 used phi_up/phi_down).
                          Aligns notation with papers.",
    }

    v1_vs_v2_example: {
      v1: "@vsm 0.1
           V(vsf-nucleus, L1) {
             status:  viable
             channel: phi_up   -> V(vsf-s3-star, L2)
             channel: phi_down <- V(vsf-s3, L2)
             channel: phi_down_rejected -> V(vsf-s3, L2)
             channel: algedonic -> V(vsf-s5, L3)
             recursive: false
           }"

      v2: "@vsm 2.0
           V(vsf-nucleus, L1) {
             viable
             links [vsf-s3-star, vsf-s3, vsf-s5]
             rejects: phi_down_invalid
             env_sample <- external { source: psi | thermal, regime: shannon }
           }"

      compression_ratio: "estimated 40-60% token reduction for equivalent semantics"
    }

    session_sequence: [
      "1. [O] Design VSL v2 BNF — Opus session. Architecture decision.
             Input: grammar_debts + compression_principles + v1 BNF.
             Output: v2 BNF document + rationale.",
      "2. [S] Implement parser v2 — Sonnet session. Task T2.
             Certify in LXC 108. Corpus sweep v1 files (backwards compat check).",
      "3. [S] Run EXP-VSL-01..04 — v1 vs v2 comparison.
             Key metric: compression_ratio v2/v1 + Shannon entropy H(v2) vs H(v1).",
      "4. [O] Write paper — Opus session.
             §1-3 document the design rationale.
             §4 documents experimental results.
             §5 closes with the compression/manifold argument.",
    ]

    gate: "Session 1 (BNF design) gates on ITEM_13.3 being defined (predictive_alert
           fields must be known before grammar is frozen). Can start BNF design
           in parallel with ITEM_13 implementation."
  }

  publication_timing = "P_VSL session sequence: Opus BNF design → Sonnet parser v2 →
                        EXP-VSL-01..04 → Opus paper write. Can run after ITEM_13 defines
                        predictive_alert fields. Likely 2 work cycles after ITEM_13."

  what_the_grammar_debts_reveal = "The grammar is not ahead of the architecture — it is
                                    precisely aligned with it. Every gap in VSL v1 grammar
                                    corresponds to an architectural debt. VSL v2 closes those
                                    gaps in parallel with ITEM_13+14 closing them in the system.
                                    The paper documents that co-evolution: grammar and
                                    architecture as a single design act."

// ── RELATIONSHIP TO OTHER PAPERS ─────────────────────────────────────────────
paper_program:
  P1_attractor      = "cites the kernel that VSL governs; the φ↑ events are VSL-structured.
                       GATE: P_VSL grammar extensions (predictive_alert, env_sample) need
                       ITEM_13 implemented before they can be described as real."
  P_phi_epistemic   = "VSL is an instance of the compression argument: a codebook for
                       operational state. Shannon thread connects §4 and §5 directly."
  P3_open_systems   = "VSL as the medium through which S3 communicates with S1 processes
                       subject to thermodynamic constraints — future connection"
  this_paper        = "P_VSL — the language paper. Can be submitted independently.
                       §1-3 stable now. §4-5 after ITEM_13 grammar extensions designed.
                       Most accessible paper of the program to a CS/AI audience."

// ── WHAT MAKES THIS PAPER NOVEL ───────────────────────────────────────────────
novelty:
  - "First DSL derived from VSM structure — not a general systems notation but a
     language whose grammar encodes viability constraints"
  - "Agent-as-compiler framing: LLM as semantic compressor, not just text generator"
  - "Empirical measurement of language quality via agent generation + parse rate"
  - "Shannon connection: grammar as codebook; valid VSL as low-D manifold"
  - "D6 as language design principle: the cognitive/operational boundary defines
     the language boundary"
  - "Grammar as architecture mirror: VSL limits reveal system limits — the language
     is honest about what the system can and cannot yet do"

watermark = "⟦ /paper_data | vsl_language | vsm-1.0 | 2026-06-24 ⟧"
