\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces EXP-S5-01: the covenant halt fired at tick~6 (binding constraint: $\texttt  {ESCALATION\_GRACE\_TICKS}=3$ exceeded), set the shared halt flag that gates S3 auto-decisions, co-emitted an algedonic alert, and cleared end-to-end on an explicit operator resume published over NATS. The resume event is itself Merkle-chained ($\texttt  {prev\_hash}\to \texttt  {hash}$), so the governance action is tamper-evident.}}{45}{table.caption.75}\protected@file@percent }
\newlabel{tab:s5veto}{{25}{45}{EXP-S5-01: the covenant halt fired at tick~6 (binding constraint: $\texttt {ESCALATION\_GRACE\_TICKS}=3$ exceeded), set the shared halt flag that gates S3 auto-decisions, co-emitted an algedonic alert, and cleared end-to-end on an explicit operator resume published over NATS. The resume event is itself Merkle-chained ($\texttt {prev\_hash}\to \texttt {hash}$), so the governance action is tamper-evident}{table.caption.75}{}}
