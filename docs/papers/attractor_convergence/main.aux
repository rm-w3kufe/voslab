\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Baseline convergence (\texttt  {spec\_boot}, $10^4$ ticks, no stressor). With no stress, S5 and the trust channel are \emph  {redundant}: NC-01 and NC-02 converge identically to \texttt  {vsf-nucleus}{} ($\text  {stasis\_cos}=0.9999$, contracting $\overline  {\Delta L}<0$). Only NC-03, the bare substrate, differs --- it sits at $0.8739$ with a \emph  {positive} $\overline  {\Delta L}$: the OU process reverts to \emph  {its own} equilibrium, drifting away from the VSF stasis target. It is nominally viable ($\cos >\theta _\text  {viable}=0.70$) only because it starts near the attractor; the positive exponent shows it would drift out of the stasis cone over a long run.}}{41}{table.caption.68}\protected@file@percent }
\newlabel{tab:nc_baseline}{{21}{41}{Baseline convergence (\texttt {spec\_boot}, $10^4$ ticks, no stressor). With no stress, S5 and the trust channel are \emph {redundant}: NC-01 and NC-02 converge identically to \nucleus {} ($\text {stasis\_cos}=0.9999$, contracting $\overline {\Delta L}<0$). Only NC-03, the bare substrate, differs --- it sits at $0.8739$ with a \emph {positive} $\overline {\Delta L}$: the OU process reverts to \emph {its own} equilibrium, drifting away from the VSF stasis target. It is nominally viable ($\cos >\theta _\text {viable}=0.70$) only because it starts near the attractor; the positive exponent shows it would drift out of the stasis cone over a long run}{table.caption.68}{}}
\@writefile{toc}{\contentsline {paragraph}{Baseline convergence.}{41}{table.caption.68}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Real-hardware cyclic thermal load (\texttt  {thermal\_cycling}, $52$\,°C target, no dry-run) --- the load-bearing result of the section. The full \texttt  {vsf-nucleus}{} throttles the workers, holds the $52$\,°C target, and produces the structured dip floor $0.942$ of Experiment~9. \textbf  {NC-01 (no S5) collapses}: with no governor to throttle the load, the core reaches $76$\,°C in $63$\,s and the attractor collapses completely ($\text  {stasis\_cos}=0.0000$, viable $=$ false) --- simultaneously thermally unsafe and informationally dead. NC-02 (S5 active, trust frozen) stays viable throughout ($0.9973$) and takes nearly $4\times $ longer to reach the ceiling. NC-03 (bare substrate) never collapses but never stabilises either: it dips on $100\%$ of ticks at floor $0.777$.}}{41}{table.caption.70}\protected@file@percent }
\newlabel{tab:nc_thermal}{{22}{41}{Real-hardware cyclic thermal load (\texttt {thermal\_cycling}, $52$\,°C target, no dry-run) --- the load-bearing result of the section. The full \nucleus {} throttles the workers, holds the $52$\,°C target, and produces the structured dip floor $0.942$ of Experiment~9. \textbf {NC-01 (no S5) collapses}: with no governor to throttle the load, the core reaches $76$\,°C in $63$\,s and the attractor collapses completely ($\text {stasis\_cos}=0.0000$, viable $=$ false) --- simultaneously thermally unsafe and informationally dead. NC-02 (S5 active, trust frozen) stays viable throughout ($0.9973$) and takes nearly $4\times $ longer to reach the ceiling. NC-03 (bare substrate) never collapses but never stabilises either: it dips on $100\%$ of ticks at floor $0.777$}{table.caption.70}{}}
