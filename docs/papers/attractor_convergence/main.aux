\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces EXP-SOPLO-01 $\sigma $-sweep ($N=128$ kernels, $1000$ stationary ticks, $T=313$\,K). Register entropy $H(\tau )$ rises monotonically with $\sigma $; soplo frequency $f_\text  {soplo}$ rises from zero; clamp saturation falls from $1.0$; and dissipation-per-soplo (log scale) sits far above the $kT\ln 2$ reference and decreases with $\sigma $. The Landauer floor $kT\ln 2 = 2.995\times 10^{-21}$\,J/bit at $313$\,K holds at every $\sigma $ (no Second-Law violation).}}{62}{figure.caption.113}\protected@file@percent }
\newlabel{fig:soplo}{{26}{62}{EXP-SOPLO-01 $\sigma $-sweep ($N=128$ kernels, $1000$ stationary ticks, $T=313$\,K). Register entropy $H(\tau )$ rises monotonically with $\sigma $; soplo frequency $f_\text {soplo}$ rises from zero; clamp saturation falls from $1.0$; and dissipation-per-soplo (log scale) sits far above the $kT\ln 2$ reference and decreases with $\sigma $. The Landauer floor $kT\ln 2 = 2.995\times 10^{-21}$\,J/bit at $313$\,K holds at every $\sigma $ (no Second-Law violation)}{figure.caption.113}{}}
