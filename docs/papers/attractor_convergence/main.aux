\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Viability-equivalent, not $\mu ^*$-equivalent.} Both laws place their stationary measure $\mu ^*$ inside the contractive core $\Omega _A$ (so both are viable, $V>0$), but at \emph  {different} points: Law~B at the apex ($c\to 1$), Law~A at a looser plateau ($c\approx 0.95$). Only Law~B admits the collapse path (dashed) that leaves $\Omega _A$ toward the spurious $\tau \to 0$ basin; Law~A's restorative reset removes it. The viability verdict is a property of the region $(\Omega ,\Omega _A)$; the attractor location is a property of the law.}}{59}{figure.caption.103}\protected@file@percent }
\newlabel{fig:trustlaw_geom}{{24}{59}{\textbf {Viability-equivalent, not $\mu ^*$-equivalent.} Both laws place their stationary measure $\mu ^*$ inside the contractive core $\Omega _A$ (so both are viable, $V>0$), but at \emph {different} points: Law~B at the apex ($c\to 1$), Law~A at a looser plateau ($c\approx 0.95$). Only Law~B admits the collapse path (dashed) that leaves $\Omega _A$ toward the spurious $\tau \to 0$ basin; Law~A's restorative reset removes it. The viability verdict is a property of the region $(\Omega ,\Omega _A)$; the attractor location is a property of the law}{figure.caption.103}{}}
