\newlabel{tab:sustained_noise}{{6}{19}{Sustained-noise margin (EXP-NS-01). Confinement $P(\cos \ge \theta _\text {viable})$ is $1.0000$ at every amplitude, up to noise of four times the state norm ($\sigma $ up to $2.0$); the margin $m(\sigma )$ degrades smoothly and saturates}{table.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Viability margin under sustained noise (EXP-NS-01). The robustness curve $V(\sigma ) = \min (g,c,t,m(\sigma )) = m(\sigma )$ falls steeply then saturates near $0.33$; confinement is total ($1.0000$) across the whole sweep. The borrowed impulsive proxy ($m \approx 0.46$) corresponds to a high-noise point $\sigma \approx 1.0$ (the sweep continues to $\sigma = 2.0$, margin $0.33$); at a moderate operating point ($\sigma = 0.10$) the margin is $0.71$.}}{20}{figure.caption.24}\protected@file@percent }
\newlabel{fig:sustained_noise}{{9}{20}{Viability margin under sustained noise (EXP-NS-01). The robustness curve $V(\sigma ) = \min (g,c,t,m(\sigma )) = m(\sigma )$ falls steeply then saturates near $0.33$; confinement is total ($1.0000$) across the whole sweep. The borrowed impulsive proxy ($m \approx 0.46$) corresponds to a high-noise point $\sigma \approx 1.0$ (the sweep continues to $\sigma = 2.0$, margin $0.33$); at a moderate operating point ($\sigma = 0.10$) the margin is $0.71$}{figure.caption.24}{}}
