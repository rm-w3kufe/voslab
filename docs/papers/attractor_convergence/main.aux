\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Certifier-validation suite for $V = \min (g,c,t,m)$ (EXP-VNC-01, EXP-G-01). Each row is a scenario; each column is one axis of the certificate. Cells are grey-coded: dark $=$ axis value $= 0$, light $=$ axis healthy. \textbf  {Coloured border}: the binding cell (argmin) that determines $V$. \textcolor {orange}{Orange}: binding but viable (the certifier carries a positive value from this axis). \textcolor {red}{Red}: binding and $V = 0$ (system failed on this axis). The diagonal pattern in the per-axis breaks (rows 5--8) shows that each of $g, c, t, m$ can independently collapse $V$; NC-02 and NC-03 remain viable because no $\Omega $-face is violated.}}{54}{figure.caption.92}\protected@file@percent }
\newlabel{fig:v_capstone}{{20}{54}{Certifier-validation suite for $V = \min (g,c,t,m)$ (EXP-VNC-01, EXP-G-01). Each row is a scenario; each column is one axis of the certificate. Cells are grey-coded: dark $=$ axis value $= 0$, light $=$ axis healthy. \textbf {Coloured border}: the binding cell (argmin) that determines $V$. \textcolor {orange}{Orange}: binding but viable (the certifier carries a positive value from this axis). \textcolor {red}{Red}: binding and $V = 0$ (system failed on this axis). The diagonal pattern in the per-axis breaks (rows 5--8) shows that each of $g, c, t, m$ can independently collapse $V$; NC-02 and NC-03 remain viable because no $\Omega $-face is violated}{figure.caption.92}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Per-constraint $\Omega $-slack census at the attractor (EXP-G-01). Bars show the normalised slack for each axiom face; A3\_cpu (near-black, binding) is the practical feasibility limit at Boltzmann equilibrium --- $g = 0.102$. All other resource constraints carry positive slack. Ethics faces A0/A0.1 (dashed border) are fully slack at the attractor; setting either dimension to~1 collapses $V$ to zero, confirming H\_G3 (\emph  {a covenant violation is geometrically indistinguishable from a resource violation}).}}{55}{figure.caption.94}\protected@file@percent }
\newlabel{fig:slack_census}{{21}{55}{Per-constraint $\Omega $-slack census at the attractor (EXP-G-01). Bars show the normalised slack for each axiom face; A3\_cpu (near-black, binding) is the practical feasibility limit at Boltzmann equilibrium --- $g = 0.102$. All other resource constraints carry positive slack. Ethics faces A0/A0.1 (dashed border) are fully slack at the attractor; setting either dimension to~1 collapses $V$ to zero, confirming H\_G3 (\emph {a covenant violation is geometrically indistinguishable from a resource violation})}{figure.caption.94}{}}
\@writefile{toc}{\contentsline {paragraph}{Three recipients; one open objective.}{55}{section*.96}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces $V = \min (g,c,t,m)$ discrimination test (EXP-VNC-01). Filled bars (dark): viable scenarios with $V=0.102$; outlined dashed bars (light): failed scenarios with $V=0$. Each per-axis break drives $V\to 0$ independently. NC-02 and NC-03 (structural modifications without actual $\Omega $ violations) remain viable, confirming that $V$ measures the geometry of the attractor, not mere structural completeness.}}{56}{figure.caption.95}\protected@file@percent }
\newlabel{fig:v_discrimination}{{22}{56}{$V = \min (g,c,t,m)$ discrimination test (EXP-VNC-01). Filled bars (dark): viable scenarios with $V=0.102$; outlined dashed bars (light): failed scenarios with $V=0$. Each per-axis break drives $V\to 0$ independently. NC-02 and NC-03 (structural modifications without actual $\Omega $ violations) remain viable, confirming that $V$ measures the geometry of the attractor, not mere structural completeness}{figure.caption.95}{}}
