\@writefile{toc}{\contentsline {paragraph}{Viability-equivalence vs.\ dynamical-equivalence.}{59}{section*.106}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces \textbf  {Trust trajectory divergence: Law~A recovers, Law~B drains.} Both trajectories start at $(\cos , \tau _0) = (0.897,\,0.5)$ -- the EXP-L1-01 stall point. \textbf  {(a)} First 50 cycles: under Law~A the soplo reset fires twice (orange markers, cycles 1 and 2) and $\tau $ settles at $1.0$ by cycle~8. \textbf  {(b)} Full 600-cycle run: under Law~B the open-loop law drains $\tau \to 0$ monotonically (cycle~500), collapsing $V$ via the $A5_{\mathrm  {trust\_min}}$ constraint. The divergence is the time-domain counterpart of the state-space split shown in Figure~\ref {fig:trustlaw_geom}: identical behaviour at the attractor ($\cos \to 1$), qualitatively different response away from it. Constants from \texttt  {src/main.rs}: Law~A drift $\Delta \tau = 0.025 c_t - 0.04(1-c_t)$, soplo $+0.18$ when $\tau < 0.75$; Law~B $\Delta \tau = -0.001$ per cycle (degen regime, $\cos = 0.897 < 0.998$ stasis threshold).}}{60}{figure.caption.105}\protected@file@percent }
\newlabel{fig:trust_two_law}{{25}{60}{\textbf {Trust trajectory divergence: Law~A recovers, Law~B drains.} Both trajectories start at $(\cos , \tau _0) = (0.897,\,0.5)$ -- the EXP-L1-01 stall point. \textbf {(a)} First 50 cycles: under Law~A the soplo reset fires twice (orange markers, cycles 1 and 2) and $\tau $ settles at $1.0$ by cycle~8. \textbf {(b)} Full 600-cycle run: under Law~B the open-loop law drains $\tau \to 0$ monotonically (cycle~500), collapsing $V$ via the $A5_{\mathrm {trust\_min}}$ constraint. The divergence is the time-domain counterpart of the state-space split shown in Figure~\ref {fig:trustlaw_geom}: identical behaviour at the attractor ($\cos \to 1$), qualitatively different response away from it. Constants from \texttt {src/main.rs}: Law~A drift $\Delta \tau = 0.025 c_t - 0.04(1-c_t)$, soplo $+0.18$ when $\tau < 0.75$; Law~B $\Delta \tau = -0.001$ per cycle (degen regime, $\cos = 0.897 < 0.998$ stasis threshold)}{figure.caption.105}{}}
