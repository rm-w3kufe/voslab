}

// ─── §3 BASIN GEOMETRY (EXP-2: multikernel_geometry) ─────────────────────────

exp2 = {
  experiment:  "multikernel_geometry",
  n_kernels:   4,
  n_ticks:     1000,
  trust_init:  [0.55, 0.65, 0.75, 0.85],
  date:        "2026-04-13",

  // Per-kernel final state
  kernels = [
    { id: 0, trust_init: 0.55, trust_final: 0.038, stasis_cos: 0.8701, viable: true, soplos: 14, mean_dl: -0.00915 },
    { id: 1, trust_init: 0.65, trust_final: 0.141, stasis_cos: 0.8822, viable: true, soplos: 14, mean_dl: -0.01053 },
    { id: 2, trust_init: 0.75, trust_final: 0.246, stasis_cos: 0.8959, viable: true, soplos: 14, mean_dl: -0.01199 },
    { id: 3, trust_init: 0.85, trust_final: 0.352, stasis_cos: 0.9096, viable: true, soplos: 14, mean_dl: -0.01342 },
  ]

  // Pairwise cosine between final stasis vectors
  pairwise = [
    { pair: "(k0,k1)", cos: 0.9948, angle_deg: 5.8  },
    { pair: "(k0,k2)", cos: 0.9808, angle_deg: 11.2 },
    { pair: "(k0,k3)", cos: 0.9607, angle_deg: 16.1 },
    { pair: "(k1,k2)", cos: 0.9955, angle_deg: 5.4  },
    { pair: "(k1,k3)", cos: 0.9839, angle_deg: 10.3 },
    { pair: "(k2,k3)", cos: 0.9964, angle_deg: 4.9  },
  ]

  summary = {
    mean_pairwise_cos: 0.9854,
    mean_angle_deg:    9.8,
    max_divergence:    "cos(k0,k3) = 0.9607  (16.1°)  — trust_init 0.55 vs 0.85",
    min_divergence:    "cos(k2,k3) = 0.9964  (4.9°)   — trust_init 0.75 vs 0.85",
    verdict:           "SAME BASIN — attractor independent of initial conditions",
    hypothesis:        "H1 confirmed",
  }

  // For LaTeX table
  note_for_paper: "Table: trust_init | trust_final | stasis_cos | soplos | mean_dL + pairwise matrix"
}

// ─── §4 AUTONOMOUS VIABILITY (EXP-3: s3_failure_resilience) ──────────────────

exp3 = {
  experiment:   "s3_failure_resilience",
  n_kernels:    4,
  phase1_polls: 12,   // S3 active (12 × 250ms = 3s)
  phase2_polls: 12,   // S3 frozen (12 × 250ms = 3s)
  date:         "2026-04-13",

  phase1 = {
    s3_active:    true,
    viable_all:   "100%  (12/12 S3 polls)",
    temp_range:   "47-49°C",
    pressure:     "0.233-0.300",
  }
  phase2 = {
    s3_active:    false,    // coordinator frozen — no quota adjustments
    viable_all:   "100%  (12/12 S3 polls)",
    temp_range:   "46-47°C",
    pressure:     "0.200-0.233",
  }

  kernels_final = [
    { id: 0, trust: 0.553, stasis_cos: 0.9303, viable: true },
    { id: 1, trust: 0.553, stasis_cos: 0.9303, viable: true },
    { id: 2, trust: 0.553, stasis_cos: 0.9303, viable: true },
    { id: 3, trust: 0.553, stasis_cos: 0.9303, viable: true },
  ]

  delta:   "0.0%  — no degradation when S3 frozen",
  verdict: "A_auto confirmed — S1 viability is intrinsic, not coordination-dependent",
  hypothesis: "H1 + H2 confirmed",

  cgroup_active: true,  // real cgroup v2 writes verified
  note_for_paper: "Key: this is not just simulation — cgroup.procs writes confirmed on real kernel"
}

// ─── §5 PSI THRESHOLD (critical_angle + thermal_ceiling_v4) ──────────────────

exp_gemini = {
  experiment:     "critical_angle",
  baseline_temp:  67.0,   // °C — hardware already hot
  date:           "2026-04-13",

  result = {
    viable_full_throughout: true,
    min_stasis_cos:         0.9377,
    min_angle_deg:          20.3,
    first_nonviable_tick:   null,    // never reached
    theta_PSI:              "< 0.9377 (upper bound)",
    interpretation: "hardware thermal ceiling (67-69°C throttling) prevents reaching θ_PSI",
  }

  theta_PSI_upper_bound: 0.9377,   // stasis_cos at max thermal stress, still viable
  cone_bound_deg: 20.3,            // arccos(0.9377) — system never exceeded this under thermal load

  note_for_paper: "θ_PSI is bounded above by 0.9377 — finding the exact value requires non-thermal stress (future work)"
}

exp4 = {
  experiment:    "thermal_ceiling_v4",
  target_temp:   68.0,   // °C — NO THROTTLE
  safety_temp:   70.0,   // °C
  result:        "SAFETY_HALT at tick 0",
  reason:        "hardware at 71°C post-critical_angle load — cooldown required",
  note_for_paper: "demonstrates hardware thermal ceiling: i7-7600U throttles at 67-69°C, creates hard boundary for thermal stress experiments"
}

// Combined thermal finding
thermal_finding = {
  hardware_ceiling:  "67-69°C (CPU throttling under sustained 4-worker load)",
  max_viable_temp:   "≥71°C (never observed viable=false under thermal stress alone)",
  implication:       "thermal stress is insufficient to find θ_PSI — non-thermal perturbation needed",
  future_work:       "theta_psi_stress experiment: controlled stasis_vec divergence injection",
}

