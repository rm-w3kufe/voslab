@vsm 0.3
// NP / P6 — Learned Modes paper — formal seed
// domain_context: {target=vsf, env=paper_seed, layer=L+3}
// date: 2026-07-11 | status: SEED — gated on EXP-MODES-01 outcome
// Scope ratified by rmw3 (S5) 2026-07-11: focused single-experiment paper,
// NOT the 9-claim omnibus originally proposed (that material was distributed
// to P2-P5 seeds on 2026-07-11 and stays there — single-source discipline).

paper("learned_modes") = {
  id:      "PAP-06 (NP)",
  title:   "Structural Drift under an Invariant Organisation:
            Learned Modes in a Viable System Kernel",
  size:    "15-20 pp — one experiment, carried deep",
  gate:    "EXP-MODES-01 outcome B (converge-to-different) → full paper;
            outcome A → validation note; outcome C → no paper (safety doc only)",
}

// ─── THESIS ───────────────────────────────────────────────────────────────────

thesis:
  "A viable system can learn its own internal categories — the prototypes that
   define what 'being S1..S5' means — while its organisation (Ω, the VSM
   topology, the contraction sign) remains invariant, PROVIDED the learning is
   bounded by a structural lock: the Ω-guard, which rejects any prototype
   update whose one-tick simulation would exit the feasible region. This is
   Maturana's structural drift made operational and measurable: structure
   adapts, organisation is conserved, and the conservation is enforced in
   code rather than asserted in prose."

// ─── THREE CONTRIBUTIONS ─────────────────────────────────────────────────────

contributions = {
  C1_experiment: "First 7-day measurement of online prototype learning inside
    a production-grade control kernel (sandboxed), with pre-registered
    hypotheses (EXP-MODES-01): organisation invariance (λ<0, stasis, zero Ω
    exits) simultaneous with structural drift (modes leave design, converge
    to environment-carved centroids, reconstruction error improves).",

  C2_guard: "The Ω-guard as a safety contribution: self-referential learning
    bounded by a structural invariant. Cost ~16K flops/update. The guard, the
    λ-freeze, the decay schedule and the collapse repulsion together form a
    containment pattern for ANY self-modifying element in a viable system —
    the pattern is the contribution, the kernel is the instance.",

  C3_theory: "Closed-loop self-clustering: the system visits states generated
    USING the modes it is learning, so the sampling distribution depends on
    the learned parameters. Convergence is NOT covered by Robbins-Monro. We
    do not solve the general theory; we state it precisely, measure one
    instance, and characterize the empirical convergence — an honest open
    problem stated from data.",
}

// ─── RELATION TO THE PROGRAM ─────────────────────────────────────────────────

program_position = {
  vs_AC:  "AC claims the attractor is universal/invariant — this paper is the
           counterpoint that RESOLVES the apparent tension via the
           organisation/structure split. AC untouched; one Future-Work
           sentence there may point here.",
  vs_P2_P5: "Thermodynamics stays in P3, immune/D_id in P5, compression in
           P2/P4 (distributed 2026-07-11). This paper takes ONLY learned
           modes + the guard.",
  frame:  "Maturana & Varela central here (structural drift, enaction as
           measured mechanism) — foundation, not decoration; Luhmann as
           precedent for non-biological application. Ramsauer for the
           softmax-attractor substrate; the AC Santiago-school paragraph is
           the bridge citation.",
}

// ─── SOURCES ─────────────────────────────────────────────────────────────────

sources = [
  "docs/spec_revision/plan/theory-sid-01/seven_ideas_deep.vsm §7 (DS, 2026-07-05) — the original idea",
  "docs/theory/claude_review_seven_ideas.vsm §4.idea_7 — closed-loop caveat + guard mandate",
  "docs/theory/paper_strategy.vsm §1-§2 (DS) — org/structure resolution + reviewer defence",
  "docs/governance/decisions/D-OMEGA-GUARD_ratification.md — S5 authorization, scope",
  "docs/experiments/EXP-MODES-01/spec.vsm — pre-registered protocol",
]

// ─── APPENDIX — verbatim quote (es), preserved at rmw3's request ─────────────
// rmw3, 2026-07-11: "la cita textual de tu respuesta es también digna de posar
// íntegra en un libro". Source: Claude (Fable 5), session cbe86482, explaining
// the Ω-guard ratification. Kept in Spanish as spoken; candidate epigraph or
// boxed quote for the paper/book.

quote_es: """
Hoy los modos μₛ del kernel (los prototipos de "qué es ser S1, S2... S5" en
ℝ¹²⁸) son constantes compiladas — los diseñamos nosotros. La idea de modos
aprendidos los vuelve dinámicos: cada tick, el modo activo se desplaza un
poquito hacia el estado real. El sistema aprende sus propias categorías de su
experiencia, en vez de operar sobre las idealizadas.

Un sistema que redefine sus categorías internas podría, en principio, derivar
hasta "reclasificar" su manera de esquivar restricciones. La respuesta de
política ya existe (A5: doble-loop requiere humano), pero la respuesta técnica
es el Ω-guard: antes de aceptar cualquier actualización de μₛ, el kernel
simula 1 tick con el modo nuevo y verifica Ω — si la trayectoria saldría de Ω,
la actualización se rechaza. Es un candado de protocolo en código, no una
regla en un documento.

Esto es el caso frontera exacto de la regla D4: cambiar el estado es
single-loop (automatizable); cambiar la estructura — lo que los modos
significan — es lo más cerca de doble-loop que el kernel ha estado. Sería el
primer elemento auto-modificante del kernel. La resolución conceptual es la de
Maturana: la organización queda invariante (Ω, la topología S1-S5, el signo de
λ, el covenant — todo eso sigue compilado y verificado por SHA al boot), la
estructura (los prototipos) adapta. El Ω-guard es lo que hace cumplir esa
separación en código: el aprendizaje puede mover los prototipos, pero nunca a
un lugar que viole Ω. El sistema no puede aprender a salirse de su propia
constitución.
"""
