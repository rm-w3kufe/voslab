    "rmw3 to source: recent algorithmic governance literature using systems
     vocabulary without Beer — the bridge we can build",
  ]

// ── WHAT THIS PAPER IS NOT ────────────────────────────────────────────────────
not:
  - "A VSF manual or technical report"
  - "A claim that VSF is the answer to Klein's agenda"
  - "A paper heavy with equations — those belong in the attractor paper"
  - "A critique of Klein — it is a response and an extension"

// ── SHANNON / COMPRESSION THREAD ─────────────────────────────────────────────
// Emerged from conversation 2026-06-24. Connects information theory to viability
// and to the epistemic drift diagnosis. Probably belongs in §1 or §2.
// Reference video (rmw3): https://www.youtube.com/watch?v=l6DKRf-fAAM
// (series on compression and entropy — Shannon lineage)

shannon_compression_thread:
  core_insight = "Viability is stable compression. Drift is loss of compressible structure."

  shannon_link = {
    theorem:   "Shannon's source coding theorem: the lower bound on compression is H.
                Perfect noise is incompressible — maximal entropy, no exploitable pattern,
                every bit is genuinely new.",
    kernel:    "The ℝ¹²⁸ kernel has capacity ≈ 7 bits (log₂128). At rest: D_eff ≈ 5
                effective dimensions. Under Maxwell demon: D_eff → 3.89. This is
                SPONTANEOUS COMPRESSION — the attractor is the compression structure.
                The system discovers that most of its state space is redundant.",
    nc03:      "NC-03 (pure OU substrate) = Shannon noise: maximal H, D_eff unbounded,
                no stable compression. Incompressible by definition. Not viable.",
    senescence:"Senescence (what EXP-SEN-01 was searching for) = DEGRADATION OF COMPRESSION:
                the system needs more dimensions to represent the same state. H rises,
                D_eff grows, the attractor expands until it is no longer an attractor.",
  }

  epistemic_translation = {
    drift:      "Epistemic drift (Klein) in Shannon terms: a field that loses its
                 compression. Ideas proliferate, more words needed to say the same thing,
                 concepts multiply without reducing the variety of the problem. H rises.
                 D_eff grows. The shared low-dimensional representation dissolves.",
    coherence:  "Coherence without closure = compression without forced loss.
                 A good attractor allows the field to operate from a compact shared
                 representation while remaining open to new data that genuinely
                 increases H (real novelty) vs. noise that mimics novelty.",
    s5_role:    "S5 as condition-of-possibility = the structure that MAKES compression
                 possible. Without it, the field has no basis for distinguishing
                 signal from noise. NC-01 under thermal stress: without S5, the system
                 cannot compress the stress signal into an actionable response.",
    palantir:   "Palantir compresses social complexity into threat scores. This is
                 technically compression. But the compression function (who counts as
                 signal, who as noise) is the hidden S5 — defined privately, without
                 accountability. The problem is not that it compresses. The problem is
                 who owns the codebook.",
  }

  stasis_cos_as_compression = {
    insight: "stasis_cos measures whether the compressed representation (the attractor
              direction) remains stable over time. stasis_cos → 1.0 = the system keeps
              finding the same low-dimensional structure. stasis_cos → 0.0 = the
              compression has collapsed (NC-01 thermal: 0.0000).",
    implication: "For an epistemic network: stasis_cos would measure whether the field's
                  core concepts retain their mutual orientation over time — whether
                  'viability', 'feedback', 'emergence' still point in the same direction
                  relative to each other. Drift = stasis_cos falling.",
  }

  reference_video = {
    title:   "Reinventando la Entropía | Compresión e Inteligencia Parte 1"
    channel: "3Blue1Brown"
    url:     "https://www.youtube.com/watch?v=l6DKRf-fAAM"
    note:    "Not formally citable but pedagogically foundational for the compression-
              entropy-viability intuition. Seed of the shannon_compression_thread."
  }

  section_placement = "§1 (Drift as Viability Failure) or §2 (Observer Cost).
                       Shannon gives §1 its technical spine: reframe drift not as
                       communication failure but as loss of compression structure.
                       The field stopped being compressible."

// ── OPEN QUESTIONS SEEDED BY THIS PAPER ──────────────────────────────────────
open_questions:
  Q1 = "Can a system observe indefinitely without the observer drifting?
        (EXP-SEN-01 touched this; it is unresolved)"
  Q2 = "When a state space mutates, is identity preserved in trajectory or
        in attractor? (S1 in R^n connecting to nucleus in R^128)"
  Q3 = "What is the signature of Ω-approach in an epistemic network?
        (Klein senses it; no one has instrumented it)"
  Q4 = "Is the cost-of-existing for S5 measurable? If S5 never acts, how do
        we know it is still functioning as a condition?"

// ── ARCHITECTURAL REFRAME (2026-06-24) ───────────────────────────────────────
// Source: cross-examination Beer/vonFoerster/Shannon canon against implementation.
// Decision: papers do not conform to incomplete model — push implementation until
// VSM is validated, then document. rmw3: "el objetivo es el VSM, no los proxies."
architectural_reframe:
  principle = "P_phi is the philosophical paper of the program. It does NOT require
               Beer-compliant VSM implementation to be valid — its argument is about
               epistemic networks IN GENERAL, using VSF as a case study, not as proof.
               However, the empirical anchors it cites (NC-01, Maxwell demon, EXP-SEN-01)
               MUST be accurately attributed: 'algedonic channel' not 'S5 governance'
               until DEBT_S5 is closed."

  impact_of_debts = {
    DEBT_S5: "NC-01 result currently cited as 'S5 conditional viability'. Correct
              attribution: 'algedonic channel provides conditional viability without
              active S5 veto.' The philosophical argument about S5-as-condition
              is STRONGER with this honesty — the gap between ideal (S5 as condition)
              and current implementation (S5 as alerter) IS the cost-of-coherence
              argument in miniature. The debt does not weaken §3; it exemplifies it.",

    DEBT_S3: "S3 discontinuous (episodic Claude sessions) is relevant to §1:
              epistemic drift in a field is the same as S3 governance with gaps.
              Klein's diagnosis IS the S3-discontinuity problem. This strengthens
              the parallel, not weakens it.",

    DEBT_S4: "S4 that only reads φ↑ internal = an observer that only observes
              itself. Von Foerster's critique of this circularity = §2 exactly.
              The epistemic field equivalent: researchers who only cite each other.",
  }

  publication_timing = "P_phi can be submitted BEFORE P1 — it is philosophical,
                        not experimental. The architectural debts make its argument
                        richer, not weaker. Recommend: write §1-3 in Opus session once
                        P1 reframe is settled. Target: SRBS or IFSR 2026 proceedings."

  what_makes_it_publishable_now = "The argument does not depend on a complete VSM.
                                   It depends on the formal concepts (Ω, S5, cost-of-existing,
                                   stasis_cos, Shannon compression) being coherently applied
                                   to epistemic networks. Those concepts are stable regardless
                                   of whether ITEM_13 is implemented."

// ── RELATIONSHIP TO OTHER PAPERS ─────────────────────────────────────────────
paper_program:
  P1_attractor    = "docs/papers/attractor_convergence — formal results that
                     anchor §2 (demon) and §3 (NC experiments). Cite, don't repeat.
                     GATE: P1 empirical anchors must use corrected attributions before
                     P_phi cites them. Coordinate on 'algedonic channel' vs 'S5 governance'."
  P3_open_systems = "docs/papers/open_systems — Maxwell demon + Landauer +
                     Lindblad lineage. epistemic_viability is the philosophical
                     companion to P3's technical development."
  this_paper      = "P_phi — the philosophical bridge between the formal results
                     and the cybernetics community. Can publish BEFORE P1.
                     Enables the conversation that makes the other papers matter."

watermark = "⟦ /paper_data | epistemic_viability | vsm-1.0 | 2026-06-24 ⟧"
