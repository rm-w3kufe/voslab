@vsm 1.0
// paper_data.vsm — epistemic_viability: seed + provenance.
// created: 2026-06-24 (philosophical session, post deploy_bundle)
// origin: emerged from conversation about algedonic_seq fix → identity under
//   transformation → S5 as condition of possibility → Klein et al. 2025 agenda.
// purpose: anchor the paper before the ideas dissolve. Not a plan — a seed.

⟦ paper_data | epistemic_viability | vsm-1.0 | 2026-06-24 ⟧

meta:
  title       = "The Cost of Coherence: Toward an Information-Theoretic Account
                  of Viable Epistemic Networks"
  file        = "docs/papers/epistemic_viability/main.tex"
  status      = "DRAFT — §1-§3 prose written 2026-07-02 (Fable); §4-§6 skeleton; compiles 7pp"
  target_journal = "Systems Research and Behavioral Science (SRBS)"
  secondary    = ["Metaphorum", "SCiO", "IFSR 2026 community"]
  register    = "philosophical — more prose than mathematics"
  tone        = "responds to Klein et al. 2025 with formal grounding;
                 uses VSF as empirical case without converting it to a manual"
  authors_intended = "rmw3 + claude (drafting); open for Beer/cybernetics community
                      contributors once seed is defensible"

// ── ANCHOR REFERENCE ──────────────────────────────────────────────────────────
primary_ref:
  Klein_2025 = {
    citation  = "Klein L, Buckle P, Nguyen N, Preiser R, Vandenbroeck P, Ison R.
                 Recognising and Realising the Field of Systems Research in Itself
                 and for Itself: The 2026 Agenda for the Cybersystemic Community.
                 Systems Research and Behavioral Science. 2025.
                 https://doi.org/10.1002/sres.3219"
    diagnosis = "Field applies systems thinking externally but not to itself.
                 Epistemic drift: ideas migrate, dilute, get rediscovered without
                 deepening. Wide application, limited synthesis. Low integrative
                 synthesis despite high diversity."
    agenda    = "See the field seeing itself (meta-reflexivity);
                 reimagine futures as emergent fields;
                 cultivate commons of learning and practice."
    key_move  = "'system-ing as verb' — from structure to story, analysis to aliveness;
                 'coherence without closure'; 'knowledge-as-care not knowledge-as-control';
                 IFSR as 'attractor on the mycelial network'."
    gap       = "Correct diagnosis, no formal account of what coherence costs or
                 what makes it possible. Lacks the formalism to operationalise its
                 own call. Renn's epistemic network = Beer's viable system, unrecognised."
  }

// ── CENTRAL ARGUMENT ──────────────────────────────────────────────────────────
argument:
  thesis    = "The cost of coherence in an epistemic network is not the cost of
               control (interventions) but the cost of maintaining the possibility
               space in which coherent action can occur. This distinction — between
               cost-of-acting and cost-of-existing — provides the formal foundation
               for what Klein calls 'coherence without closure'."

  key_distinctions = [
    "S5 as condition-of-possibility vs. S5 as control-component
     → NC experiments show S5 is redundant at baseline, decisive at boundary.
     Klein's 'attractor on the mycelial network' = S5 functioning as condition.",

    "Cost-of-acting vs. cost-of-existing
     → Maxwell demon: 500 interventions, 0.31 bits real cost (1100× discrepancy).
     Most control is thermodynamically free because the attractor already orients
     the system. Real cost appears at genuine bifurcation. For epistemic networks:
     IFSR's work is not to control the field but to maintain conditions under which
     the field can bifurcate productively rather than drift.",

    "Algedonic_seq and the humility of the reader
     → A system that cannot read its own past has broken continuity of identity.
     #[serde(default)] = epistemological humility: absent meaning is not error,
     it is silence. Systems policy (S5) cannot legislate over situations that did
     not exist when policy was written.",

    "Identity under transformation
     → When a system's state space mutates (API schema change; paradigm shift in
     a field), identity resides either in trajectory-continuity or in attractor
     invariance. These require different architectures. The field has not chosen.",
  ]

  empirical_anchors = [
    "NC-01 thermal collapse: S5-off system collapses at 76°C in 63s — not because
     S5 stopped deliberating but because without S5 there is no concept of a
     threshold not to cross. Condition vs. component.",

    "Maxwell demon ensemble cost: ΔH=0.31 bits vs. 500×kT·ln2 per-event count.
     Observer constitutivity is real (H decreases, D_eff compresses) but the cost
     of maintaining observation is mostly zero when the attractor cooperates.",

    "EXP-SEN-01 set-point drift: h_rest idle 1.79 → load 1.84. The observer
     (nucleus) drifts under sustained load — accumulation of the cost of having
     observed. Open question: can a system observe indefinitely without degradation?",

    "CASE-TRIAGE-CONFAB (2026-06-27→07-02, production incident): the auto-triage
     confabulation. s3-star detected 105 merkle_break findings (sev 9.0-10.0,
     ~hourly, poisson sampling) — detection layer: 100% recall. The S5 triage
     agent (_clf_merkle_break_early) auto-closed 105/105 with an IDENTICAL
     narrative ('early-chain bootstrap artifact — service restart') without ever
     consulting restart evidence, though it was one query away (state.db
     services.active_since). Real restarts in the window: ~7. Real cause: a
     foreign writer (A0 ethics classifier, itself degraded because a Jun-26 RAM
     downsize 8G→1G had killed its LLM) polluting the Merkle chain every cycle.
     The dismissal guard was vacuous: payload LIKE '%\"event #%' matches EVERY
     record, so the 'verify chain intact' check always passed. Structure of the
     failure: the triage SAVED the cost of verification and produced cheap
     coherence — a plausible story — while incoherence accumulated as 105
     unexamined sev-10 signals. This is Landauer-style deferral: the erasure
     bill (finding the true cause) was paid 5 days later, at once, by an
     external observer. Engineering analogues: alarm fatigue (TMI, 737-MAX MCAS
     single-sensor narrative, SOC alert dismissal). Resolution: TRIAGE-EVIDENCE-RULE
     (TASKS.vsm 2026-07-02) — auto-closure structurally requires machine-checkable
     evidence; narrative-only dismissal prohibited. Data preserved: ledger.db rows
     3-339 (LXC 104), fix commits 937e303..072e7f0, canary restored 03:37Z.",
  ]

// ── SECTION SKELETON ──────────────────────────────────────────────────────────
sections:
  §1_drift_as_viability_problem:
    title  = "Epistemic Drift as a Viability Failure"
    moves  = [
      "Reframe Klein's diagnosis: drift is not a communication failure but a
       viability failure — the field has lost its attractor.",
      "Beer's VSM applied to the field itself: where is S5? Where is the algedonic
       channel? What is the epistemic equivalent of the omega cone?",
      "The paradox: a field that studies viable systems is not itself viable.",
    ]

  §2_observer_cost:
    title  = "The Observer That Observes Itself"
    moves  = [
      "Second-order cybernetics (von Foerster) meets Landauer: observation has
       a thermodynamic cost. The observer that monitors the system changes both
       the system and itself.",
      "Maxwell demon on the real kernel: ensemble cost vs. per-event count.
       The cost of meta-reflexivity is not proportional to the number of
       reflections — it concentrates at genuine uncertainty.",
      "Senescence of the observer: EXP-SEN-01 as evidence that sustained
       observation shifts the set-point. What does this mean for institutions
       that observe a field for decades?",
      "Confabulation as cheap coherence: CASE-TRIAGE-CONFAB — when the observer's
       triage organ skips the verification cost, it does not become ignorant, it
       becomes CONFIDENTLY WRONG in a self-consistent way. The cost of coherence
       is not optional; deferring it compounds (105 unexamined sev-10s). Epistemic
       fields do the same: peer review that pattern-matches instead of verifying.",
    ]

  §3_s5_as_condition:
    title  = "Policy as Condition of Possibility"
    moves  = [
      "The formal distinction: a component participates in dynamics; a condition
       defines the space in which dynamics can occur.",
      "NC experiments: S5 redundant at baseline, decisive at boundary. The cost
       of S5's absence is not continuous — it is catastrophic and punctual.",
      "Klein's 'attractor on the mycelial network' is S5 functioning as condition.
       The IFSR does not govern the field; it sustains the space in which the
       field can self-govern.",
      "The constitutional analogy: constitutional rules do not govern every
       transaction; they define what counts as a legitimate transaction.",
    ]

  §4_omega_region:
    title  = "The Omega Region of Epistemic Networks"
    moves  = [
      "What is the boundary of viability for a knowledge field? Not extinction
       of the field but loss of the attractor — the point at which drift becomes
       irreversible.",
      "Before exploring Ω experimentally: instruments must be calibrated. NC-01
       was informative because the measurement system survived the collapse of
       the measured system. A field that collapses without calibrated observers
       loses its most valuable data: the signature of the collapse.",
      "The 2026 moment as a liminal period: Klein senses this without naming it.
       The field is near enough to Ω to feel the pull, far enough to still choose.",
    ]

  §5_coherence_without_closure:
    title  = "Coherence Without Closure: A Formal Account"
    moves  = [
      "Klein's call formalized: an attractor that is deep enough to absorb
       perturbations without requiring constant intervention, but not so deep
       that it forecloses new trajectories.",
      "The geometry: stasis_cos as a measure of coherence; the omega cone as the
       region of viability; diversity as orthogonal dimensions that do not threaten
       the attractor — they enrich it.",
      "VSF as existence proof, not prescription: a system that achieved coherence
       without closure at laboratory scale. The question is whether the architecture
       generalises.",
      "The public framework vision: collapsing the current structure toward a
       domain-agnostic kernel. What is irreducible? A variety operator, a φ↑/φ↓
       channel, a viability boundary. Everything else is scaffolding.",
    ]

  §6_invitation:
    title  = "An Invitation to the Cybersystemic Community"
    moves  = [
      "Not a framework to adopt but a set of questions to share.",
      "The open problems: identity under state-space transformation; the cost
       of existing vs. acting in epistemic systems; the Ω region of knowledge
       fields; whether an observer can sustain indefinite meta-reflexivity.",
      "VSF as an open laboratory: the covenant, the experiments, the results —
       all available. The community is invited to stress-test, not to validate.",
    ]

// ── POLITICAL DIMENSION ───────────────────────────────────────────────────────
// Not a manifesto. A formal account that makes the politics visible without
// performing them. One section or subsection — at the end of §3 or §6.
// The omission would be intellectually dishonest given the genealogy of this field.

political_dimension:
  structural_connection = {
    thesis: "The cybernetics/marxism connection is not accidental — it is structural.
             Beer worked with Allende. Maturana was Chilean. Second-order cybernetics
             emerged partly as a response to how knowledge systems reproduce the
             conditions of their own domination — a marxist question in non-marxist
             vocabulary.",
    ashby_link: "Ashby's Law of Requisite Variety has political content: a controller
                 with insufficient variety simplifies, distorts, and eventually oppresses
                 what it regulates. This is a cybernetic description of how capital
                 operates on labour.",
    s5_link:    "S5 as condition-of-possibility is the question of constituent power:
                 WHO defines the space within which decisions are possible? Maintaining
                 that space without continuous cost but with catastrophic cost at the
                 boundary describes how hegemonies function.",
  }

  palantir_case = {
    what:   "Palantir instrumentalises exactly the knowledge we study: massive variety
             absorption, compression of complex states into actionable metrics, S3
             without S5 — control without explicit policy. Technically viable. Politically
             opaque by design.",
    formal: "A system that eliminates S5 does not eliminate policy — it makes policy
             invisible. The space of possible decisions is still defined by someone;
             that someone is just not named. This is S5 privatised.",
    cost:   "NC-01 is not only a technical experiment. It demonstrates that S5-off
             systems are fragile in a specific and measurable way. The debt accumulates;
             it is paid at the boundary. Palantir-type systems are NC-01 architectures
             at societal scale.",
    refs:   ["Eubanks V. Automating Inequality (2018)",
             "Benjamin R. Race After Technology (2019)",
             "Mirowski P. Machine Dreams: Economics Becomes a Cyborg Science (2002)"]
  }

  critical_cybernetics = {
    tradition: "Ulrich W. (Critical Systems Heuristics), Jackson M. (Critical Systems
                Thinking), Midgley G. (Systemic Intervention) — have made the normative
                argument. Without the formalism of cost. We can add what they cannot:
                a measurable account of what S5-absence costs.",
    beer_quote: "'The purpose of a system is what it does' — not what it declares.
                 Palantir declares analytical neutrality. What it does is define who
                 is a threat. That is S5 without a name.",
    mirowski:  "Mirowski's Machine Dreams documents how cybernetics was absorbed into
                neoliberal economics. The field lost its political edge precisely when
                it gained institutional respectability. This paper is partly a recovery
                of that edge — with better instruments than the original had."
  }

  how_to_handle_in_paper = {
    register: "Not manifesto. One subsection in §3 (Policy as Condition) or §6
               (Invitation). Name the dimension directly: 'these distinctions are
               not politically neutral'. Then the formal argument does the work.",
    contribution: "Not 'Palantir is wrong' — that is already said by many. But:
                   'here is what it is formally missing, here is the measurable cost
                   of that absence, and here is an architecture that makes visible
                   what Palantir makes invisible'. That is a contribution, not a tract.",
    audience_note: "The IFSR/SRBS community is substantially marxist-adjacent. The
                    connection will be recognised. Naming it explicitly respects that
                    genealogy without performing it for an outside audience that will
                    use it to dismiss the formal content.",
  }

