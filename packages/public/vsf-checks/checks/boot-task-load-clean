#!/usr/bin/env bash
# CLAIM: the boot loads every task in TASKS.vsm — no definition invisible, no
# duplicate id, no unreadable status.
#   pass  -> the live TASKS.vsm has zero load defects
#   fail  -> a fixture carrying one of each defect MUST be reported (if this
#            passes, the audit is not discriminating and the claim is void)
set -u
MODE="${1:-pass}"
AUDIT='
import re,sys
from collections import Counter
t=open(sys.argv[1],encoding="utf8",errors="replace").read()
D=r"^{l}task\((?:\"([^\"]+)\"[^)\n]*|([A-Za-z0-9_.\-]+))\)\s*(?::|=)"
names=[a or b for a,b in re.findall(D.format(l=r"[ \t]*"),t,re.M)]
ind=re.findall(D.format(l=r"[ \t]+"),t,re.M)
dup=[n for n,c in Counter(names).items() if c>1]
unread=0
for m in re.finditer(r"^[ \t]*task\(([A-Za-z0-9_.\-]+)\):(.*?)(?=^[ \t]*task[\(\"]|\Z)",t,re.S|re.M):
    b=m.group(2); s=(re.search(r"^\s*status\s*=\s*\"?([^\"\n,]+)\"?",b,re.M) or [None,""])[1].strip()
    s=s.split("//")[0].strip().split()[0] if s else ""
    if not s: s=(re.search(r"status\s*=\s*(\w+)",m.group(0).splitlines()[0]) or [None,""])[1]
    if not s: unread+=1
for m in re.finditer(r"^task\(\"([^\"]+)\"([^)]*)\)\s*=\s*\{(.*?)^\}",t,re.S|re.M):
    if not (re.search(r"status\s*[:=]\s*\"?(\w+)",m.group(2)+m.group(3)) or [None,""])[1]: unread+=1
bad=len(ind)+len(dup)+unread
print(f"indented={len(ind)} duplicates={len(dup)} unreadable={unread} ids={len(set(names))}")
sys.exit(1 if bad else 0)
'
if [ "$MODE" = "pass" ]; then
    exec python3 -c "$AUDIT" TASKS.vsm
fi
# negative control: a fixture with one of each defect. The audit MUST flag it.
FIX=$(mktemp); trap 'rm -f "$FIX"' EXIT
cat > "$FIX" <<'FIXTURE'
 task(INDENTED-ONE):
  status   = done
task(DUP-ID):
  status   = done
task(DUP-ID):
  status   = done
task("NO-STATUS-HERE", priority=P2, agent=claude) = {
  what: "deliberately statusless",
}
FIXTURE
python3 -c "$AUDIT" "$FIX" && { echo "NEGATIVE CONTROL PASSED — audit does not discriminate"; exit 0; }
exit 1
