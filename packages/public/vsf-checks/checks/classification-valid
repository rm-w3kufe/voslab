#!/usr/bin/env bash
# design: docs/spec_revision/plan/classification-policy-plan-v1/classification_policy_plan.vsm
# (CLASSIFICATION-POLICY-PLAN-v1, S5 rmw3 2026-08-17)
# (R16_impl_with_design — DESIGN-SOURCES-POLICY; PART II questionnaire)
# CLAIM: classification-valid holds — every .vsm under docs/spec_revision/
# lives in the directory its NATURE (per the Socratic questionnaire) prescribes.
# Classification = applying the questionnaire (binary, Socratic, non-leading)
# recursively — the SAME contract at every level — until the leaf directory.
#
# THE INSTRUMENT IS PARAMETRIC + RECURSIVE (2026-08-17, R16 pattern + EXP-
# RECURSIVE-ENGINE v6): the ROOT tree lives in classification_policy_plan.vsm
# PART IV-B as tree_rules (machine-readable); each LEVEL declares its OWN
# local policy in its directory (classification.local.vsm). scripts/vsl/
# classify.py READS the tables and applies the chain to any doc. This check
# DELEGATES to classify.py — it never hard-codes a category. A tree change
# re-classifies without editing any instrument (the policy declares, the
# instrument interprets — same pattern as write_gates + orchestrator).
#
# MODES:
#   pass       -> scan every .vsm under docs/spec_revision/; a doc whose
#                 nature the tree resolves (≠ "?") must be in its canonical
#                 dir; a violation (nature → dir mismatch) exits 1.
#   check-file -> (single-arg path) the SAME classification for ONE file,
#                 O(1): no corpus scan. Used by the write-time daemon.
#   fail       -> deliberately-false variant: a fixture doc (spec type in
#                 ledger/) is asserted to be correctly placed (must exit
#                 non-zero — false claim fails). R4.1: fail-mode ALWAYS
#                 exits non-zero.
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# packaged-layout guard (2026-10-03, T5.4 system_lifecycle audit): checks
# may run from packages/public/vsf-checks/checks/ where ROOT above is the
# PACKAGE root, not the repo — docs/, scripts/, .opencode/ resolve wrong
# (SKIP/fake-FAIL observed: classification-valid degraded to SKIP exit 0).
# Walk up to the first dir holding .git (real checkout). Layout vsf
# (checks/ at repo root) is a no-op: ROOT already contains .git.
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
SR="$ROOT/docs/spec_revision"
CLASSIFY="$ROOT/scripts/vsl/classifier/classify.py"

[ -f "$CLASSIFY" ] || { echo "SKIP: scripts/vsl/classifier/classify.py ausente"; exit 0; }

# ── fail mode: negative control (R4.1) ───────────────────────────────────────
# The FALSE claim "a fixture spec doc placed in ledger/ is correctly placed"
# must NOT hold. If it ever passes, the check cannot discriminate → proxy →
# INVALID. R4.1 convention: fail-mode ALWAYS exits non-zero.
if [ "$MODE" = "fail" ]; then
    FIX=$(mktemp --suffix=.vsm)
    cat > "$FIX" <<'EOF'
⟦ fix | AXIS2-FIRST-LOOP | vsm-1.2 | 2026-08-17 ⟧
@status active
fact("fix") = { body: "fixture" }
EOF
    home=$(python3 "$CLASSIFY" classify "$FIX")
    rm -f "$FIX"
    # a spec-type doc must NOT classify as ledger
    if [ "$home" = "ledger" ]; then
        echo "FAIL(fail-mode): fixture classified ledger — check cannot discriminate" >&2
        exit 1
    fi
    echo "FAIL (negative): fixture did not pass — the false claim does not hold" >&2
    exit 1
fi

# classify_one <abs-path> — returns 1 when the doc's canonical home (from the
# RECURSIVE chain — root tree_rules + local policies, EXP-RECURSIVE-ENGINE v6)
# differs from its actual directory, OR the tree does not resolve it ("?").
# A doc the tree cannot classify is a COVERAGE GAP in the policy — it must
# surface as a violation, never pass silently. Returns 0 only for gateway
# doors (README/INDEX/classification.local.vsm).
classify_one() {
    local f="$1"
    [ -f "$f" ] || return 0
    local base
    base=$(basename "$f")
    [ "$base" = "README.vsm" ] && return 0
    [ "$base" = "INDEX.vsm" ] && return 0
    [ "$base" = "classification.local.vsm" ] && return 0   # gateway del nivel (política local)
    local home rel actual
    home=$(python3 "$CLASSIFY" classify "$f")
    [ -z "$home" ] && return 0
    rel="${f#$SR/}"
    # actual = the FULL directory chain (not just the first component —
    # the recursive engine resolves the leaf, classification-valid checks it)
    case "$rel" in
        */*) actual="${rel%/*}" ;;
        *)   actual="." ;;
    esac
    if [ "$home" = "?" ]; then
        echo "  $rel — el árbol NO lo clasifica (gap de cobertura en la cadena)"
        return 1
    fi
    # the doc must live IN its canonical home, or inside a sub-tree of it
    # (a level without local policy is a visible GAP — the doc stays in the
    # canonical branch, e.g. archive/superseded under home=archive)
    if [ "$home" = "." ]; then
        [ "$actual" = "." ] && return 0
        echo "  $rel — el árbol clasifica la RAÍZ, encontrado en $actual/"
        return 1
    fi
    if [ "$actual" != "$home" ] && [ "${actual#"$home"/}" = "$actual" ]; then
        echo "  $rel — el árbol clasifica $home/, encontrado en $actual/"
        return 1
    fi
    return 0
}

case "$MODE" in
    pass)
        # FASE-2 OPT (2026-10-16): in-process batch — the old loop forked
        # python3 TWICE per doc (~348 startups ≈ 67s, blowing the harness
        # 60s timeout at rc=124 as the corpus grew to 178 docs). Same
        # semantics, ONE interpreter; pure reader of classify.py.
        python3 - "$CLASSIFY" "$SR" <<'PYBATCH'
import sys
from pathlib import Path

classify_file, sr = sys.argv[1], Path(sys.argv[2])
sys.path.insert(0, str(Path(classify_file).parent))
import classify as C  # noqa: E402

violations = []
count = 0
for f in sorted(sr.rglob("*.vsm")):
    base = f.name
    if base in ("README.vsm", "INDEX.vsm", "classification.local.vsm"):
        continue
    home = C.classify(f)
    if home == "":
        continue
    rel = str(f.relative_to(sr))
    actual = rel.rsplit("/", 1)[0] if "/" in rel else "."
    if home == "?":
        violations.append(f"  {rel} — el árbol NO lo clasifica (gap de cobertura en la cadena)")
        continue
    if home == ".":
        if actual != ".":
            violations.append(f"  {rel} — el árbol clasifica la RAÍZ, encontrado en {actual}/")
            continue
        count += 1
        continue
    if actual != home and not actual.startswith(home + "/"):
        violations.append(f"  {rel} — el árbol clasifica {home}/, encontrado en {actual}/")
        continue
    count += 1

if violations:
    print("FAIL: classification-valid — hoja del árbol ≠ directorio real:" + "".join("\n" + v for v in violations))
    print("  Reclasificar según PART II/IV-B (plan/classification_policy_plan.vsm)")
    sys.exit(1)
print(f"PASS: classification-valid — {count} documentos en directorio canónico (árbol paramétrico)")
PYBATCH
        exit $?
        ;;
    check-file)
        f="${2:-}"
        if [ -z "$f" ]; then
            echo "usage: $0 check-file <path>" >&2
            exit 2
        fi
        f="$(readlink -f "$f")"   # normalize — $SR is absolute
        # scope guard (2026-10-03, T5.4): the CLAIM covers .vsm UNDER
        # docs/spec_revision/ — a working doc outside the corpus (docs/plans,
        # docs/internal, ...) is not this check's subject; socratic-classify
        # (gate 3, workspace-recalibrated 2026-09-10) covers it. Without
        # this, every docs/plans write was a spurious "coverage gap" block.
        case "$f" in
            "$SR"/*) ;;
            *)
                echo "OK: $(basename "$f") — fuera del corpus spec_revision (claim no aplica)"
                exit 0
                ;;
        esac
        if ! out=$(classify_one "$f"); then
            echo "$out"
            exit 1
        fi
        echo "OK: $(basename "$f") — directorio canónico según el árbol"
        exit 0
        ;;
    *)
        echo "usage: $0 pass|fail|check-file <path>" >&2
        exit 2
        ;;
esac