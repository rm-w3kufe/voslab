#!/usr/bin/env bash
# CLAIM: G-29 instance-start-preconditions — the S1 instance
# `start: "preconditions before it may run: ..."` declarations have a
# runtime consumer that discriminates:
#   pass -> (a) scripts/vsl/tools/start_preconditions.py exits 0 on the
#               live workspace (every instance carries a parseable
#               start: block; preconditions classified MANUAL/COVERED/
#               UNKNOWN with sources); AND
#           (b) its --self-test discriminates: a valid fixture passes,
#               a missing start: is caught, a malformed (unterminated)
#               start: is caught, and the R6-vs-validation conflict is
#               reported UNKNOWN instead of being invented away.
#   fail -> a deliberately-false variant: asserts NO evaluator reads
#               instance start: blocks (must exit non-zero — the claim
#               does not hold; G-29 would be back).
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
TOOL="$ROOT/scripts/vsl/tools/start_preconditions.py"

if [ "$MODE" = "pass" ]; then
  if [ ! -f "$TOOL" ]; then echo "FAIL: no $TOOL"; exit 1; fi
  if ! python3 "$TOOL" >/dev/null 2>&1; then
    echo "FAIL: live instances report a structural violation"; exit 1
  fi
  if ! python3 "$TOOL" --self-test >/dev/null 2>&1; then
    echo "FAIL: self-test does not discriminate"; exit 1
  fi
  echo "instance-start-preconditions: PASS — live clean, self-test discriminates"
  exit 0
fi

if [ "$MODE" = "fail" ]; then
  # deliberately-false: "no evaluator exists" — must not hold
  if [ -f "$TOOL" ] && python3 "$TOOL" --self-test >/dev/null 2>&1; then
    echo "instance-start-preconditions: OK — absence assertion does not hold"
    exit 1  # the false claim does not hold (non-zero, as documented)
  fi
  echo "FAIL: evaluator missing or blind (G-29 regression)"; exit 1
fi

echo "usage: $0 [pass|fail]"; exit 2
