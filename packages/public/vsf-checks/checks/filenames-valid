#!/usr/bin/env bash
# design: docs/spec_revision/design-sources/structural-integrity-checks-v1/structural_integrity_checks.vsm
# CLAIM: all .vsm filenames are lowercase, no duplicate basenames exist
# (except by design: classification.local.vsm, readme.vsm, index.vsm),
# and no filenames contain double hyphens or other invalid patterns.
#   pass  -> all filenames conform
#   fail  -> fixture with invalid filename must be detected
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# packaged-layout guard (2026-10-03, T5.4 system_lifecycle audit): checks
# may run from packages/public/vsf-checks/checks/ where ROOT above is the
# PACKAGE root, not the repo — docs/, scripts/, .opencode/ resolve wrong
# (SKIP/fake-FAIL observed: classification-valid degraded to SKIP exit 0).
# Walk up to the first dir holding .git (real checkout). Layout vsf
# (checks/ at repo root) is a no-op: ROOT already contains .git.
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done

if [ "$MODE" = "fail" ]; then
    # negative control: create a file with uppercase name
    FIX="$ROOT/docs/spec_revision/__FIX_UPPER_TMP.vsm"
    printf '⟦ fix | FIX-UPPER | vsm-1.2 | 2026-08-22T19:14:18Z ⟧\n@vsm 1.2\n@status active\nfact("fix") = { body: "test" }\n⟦ /fix | FIX-UPPER | vsm-1.2 | 2026-08-22T19:14:18Z ⟧\n' > "$FIX"
    # The check should detect the uppercase name
    fail=0
    if find "$ROOT/docs/spec_revision" -name "*.vsm" | grep '[A-Z]' > /dev/null 2>&1; then
        fail=1
    fi
    rm -f "$FIX"
    if [ "$fail" -eq 0 ]; then
        echo "FAIL (negative): uppercase filename not detected"
        exit 1
    fi
    echo "FAIL (negative): uppercase filename detected — the false claim does NOT hold"
    exit 1
fi

# pass mode
fail=0

# Check 1: no uppercase letters in filenames
# strip the repo prefix first: $ROOT itself contains uppercase ("vOSlab"),
# so an unstripped absolute path made every file a false positive (bug since
# the repo relocation to /home/rmw3/vOSlab).
upper=$(find "$ROOT/docs/spec_revision" -name "*.vsm" | sed "s|^$ROOT/docs/spec_revision/||" | grep '[A-Z]' | wc -l)
if [ "$upper" -gt 0 ]; then
    echo "FAIL: $upper files with uppercase names:"
    find "$ROOT/docs/spec_revision" -name "*.vsm" | sed "s|^$ROOT/docs/spec_revision/||" | grep '[A-Z]'
    fail=1
fi

# Check 2: no double hyphens
double=$(find "$ROOT/docs/spec_revision" -name "*.vsm" | grep '\-\-' | wc -l)
if [ "$double" -gt 0 ]; then
    echo "FAIL: $double files with double hyphens:"
    find "$ROOT/docs/spec_revision" -name "*.vsm" | grep '\-\-' | sed "s|$ROOT/docs/spec_revision/||"
    fail=1
fi

# Check 3: no spaces in filenames
spaces=$(find "$ROOT/docs/spec_revision" -name "*.vsm" | grep ' ' | wc -l)
if [ "$spaces" -gt 0 ]; then
    echo "FAIL: $spaces files with spaces in names"
    fail=1
fi

if [ "$fail" -eq 0 ]; then
    echo "PASS: all filenames conform to naming convention"
    exit 0
fi
exit 1
