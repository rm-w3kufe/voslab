#!/usr/bin/env bash
# design: child/docs/vos_package_detailed_plans.vsm
# CLAIM: RSI-AUDIT-GAPS-DOCUMENTED-2026-08-30 (rsi-docs-valid R4.1) —
# the RSI roadmap (rsi_roadmap.vsm) reflects the 6 structural gaps
# found in the 2026-08-30 audit (GAP-1 through GAP-6).
# Negative control: removing GAP-6 reference MUST cause check to fail (exit 1)
# Usage: bash checks/rsi-docs-valid pass|fail

set -euo pipefail
MODE="${1:-pass}"
# CWD-independent: derive ROOT (T5.4 packaged-layout guard) — the roadmap
# path is repo-relative, so running from checks/ used to 404 in grep.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
ROADMAP="$ROOT/system/s1-operations/rsi_roadmap.vsm"

if [ "$MODE" = "pass" ]; then
    if grep -q "GAP-6" "$ROADMAP"; then
        echo "✓ rsi-docs-valid: roadmap reflects audit gaps"
        exit 0
    else
        echo "✗ rsi-docs-valid: roadmap missing audit gaps"
        exit 1
    fi
elif [ "$MODE" = "fail" ]; then
    # Negative control: remove GAP-6, then run pass check — MUST fail
    TMP=$(mktemp)
    cp "$ROADMAP" "$TMP"
    sed -i '/GAP-6/d' "$TMP"
    if grep -q "GAP-6" "$TMP"; then
        rm "$TMP"
        echo "✗ rsi-docs-valid: negative control broken (gap still present after removal)"
        exit 1
    else
        rm "$TMP"
        echo "✗ rsi-docs-valid: negative control passed (gap removed → check correctly fails)"
        exit 1
    fi
else
    echo "Usage: bash checks/rsi-docs-valid pass|fail"
    exit 1
fi
