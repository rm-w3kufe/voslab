#!/usr/bin/env bash
# design: docs/design/sandbox/vsl_encoding_cycle_design.vsm
# (R16_impl_with_design — cascada VERSION-COHERENT VSM11, 5/6)
# CLAIM: vsm-version-coherent holds — every active .vsm under system/ and
# docs/ declares @vsm == header version (internal coherence), and the
# version distribution is reported (multi-version is LEGAL post-S5 decision
# 2026-08-16: only the primer promotes to vsm-1.2; the rest of the corpus
# stays vsm-1.0 until the cascade migrates it).
#   pass -> (a) scanner reports NO incoherent doc (@vsm != header); AND
#           (b) version distribution is reported. The scanner
#           (scripts/vsl/tools/version_scan.py) replicates the parser's §13.1
#           coherence detection in ONE process for the whole corpus
#           (~0.3s vs ~20s spawning the full parser per doc).
#   fail -> deliberately-false variant: asserts a doc with @vsm != header
#           is treated as coherent (must exit non-zero — false claim fails).
#           The negative control uses the REAL parser to verify the scanner
#           does not diverge from the parser's detection (double control).
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# packaged-layout guard (2026-10-03, T5.4 system_lifecycle audit): checks
# may run from packages/public/vsf-checks/checks/ where ROOT above is the
# PACKAGE root, not the repo — docs/, scripts/, .opencode/ resolve wrong
# (SKIP/fake-FAIL observed: classification-valid degraded to SKIP exit 0).
# Walk up to the first dir holding .git (real checkout). Layout vsf
# (checks/ at repo root) is a no-op: ROOT already contains .git.
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
PARSER="$ROOT/scripts/vsl/parser/vsl_parser.py"
SCANNER="$ROOT/scripts/vsl/tools/version_scan.py"
CORPUS_PRIMARY="$ROOT/system"
CORPUS_SECONDARY="$ROOT/docs"

if [ "$MODE" = "pass" ]; then
    if [ ! -f "$SCANNER" ]; then
        echo "FAIL: $SCANNER missing — cannot gate version coherence"
        exit 1
    fi
    if [ ! -d "$CORPUS_PRIMARY" ] || [ ! -d "$CORPUS_SECONDARY" ]; then
        echo "FAIL: active corpus missing ($CORPUS_PRIMARY / $CORPUS_SECONDARY) — coherence UNVERIFIABLE (never vacuous pass)"
        exit 1
    fi
    # (a) coherence via the fast scanner (one process, whole corpus).
    # P-EV-R3 vacuity guard: the old `< <(python3 "$SCANNER" 2>/dev/null)`
    # ate a scanner crash (empty stream → incoherent stayed 0 → PASS with
    # ZERO lines scanned). Capture rc + require output; empty ≠ healthy.
    _scan_out="$(mktemp)"; _scan_err="$(mktemp)"
    python3 "$SCANNER" >"$_scan_out" 2>"$_scan_err"
    _scan_rc=$?
    if [ "$_scan_rc" -ne 0 ] || [ ! -s "$_scan_out" ]; then
        echo "FAIL: version scanner crashed or emitted nothing (rc=$_scan_rc) — vacuous pass prevented"
        sed 's/^/    /' "$_scan_err" >&2
        rm -f "$_scan_out" "$_scan_err"
        exit 1
    fi
    incoherent=0
    scanned=0
    while IFS= read -r line; do
        scanned=$((scanned + 1))
        if [ "${line#INCOHERENT }" != "$line" ]; then
            echo "  ✗ ${line#INCOHERENT }"
            incoherent=1
        fi
    done < "$_scan_out"
    rm -f "$_scan_out" "$_scan_err"
    if [ "$scanned" -eq 0 ]; then
        echo "FAIL: scanner emitted 0 doc lines — vacuous pass prevented"
        exit 1
    fi

    # (b) distribution report (reality, not a gate — multi-version is legal).
    #     P-EV-R3: an EMPTY distribution means the scanner counted nothing —
    #     report it as a failure instead of looping over nothing.
    echo "  ── corpus version distribution ──"
    _dist=$(python3 "$SCANNER" --dist 2>/dev/null | grep '^DISTRIBUTION' | sed 's/^DISTRIBUTION //')
    if [ -z "$_dist" ]; then
        echo "FAIL: version distribution EMPTY — scanner counted 0 docs (vacuity guard)"
        exit 1
    fi
    for pair in $_dist; do
        ver=${pair#vsm-}; ver=${ver%%:*}; n=${pair##*:}
        printf "    vsm-%s: %s docs\n" "$ver" "$n"
    done

    if [ "$incoherent" -eq 0 ]; then
        echo "PASS: vsm-version-coherent — @vsm == header ∀ doc; distribution reported"
        exit 0
    fi
    echo "FAIL: vsm-version-coherent gate"
    exit 1

elif [ "$MODE" = "fail" ]; then
    # ── negative control: a world where @vsm != header is tolerated must FAIL ──
    FIX="$ROOT/system/__ver_bad_tmp.vsm"
    printf '⟦ ver_bad | VER-BAD-v1 | vsm-1.0 | 2026-08-16 ⟧\n\n@vsm 1.2\n@status proposed\nrecord("VERBAD") {}\n\n⟦ /ver_bad | VER-BAD-v1 | vsm-1.0 | 2026-08-16 ⟧\n' > "$FIX"
    # both the scanner AND the parser must flag it (double control)
    if ! python3 "$SCANNER" "$FIX" 2>&1 | grep -q "INCOHERENT"; then
        echo "FAIL (negative): scanner did not flag incoherent doc — false claim holds"; rm -f "$FIX"; exit 1
    fi
    if ! python3 "$PARSER" "$FIX" 2>&1 | grep -q "differs from header version"; then
        echo "FAIL (negative): parser did not flag incoherent doc — scanner diverged"; rm -f "$FIX"; exit 1
    fi
    rm -f "$FIX"
    echo "FAIL (negative): coherence gate exists and detects (scanner+parser) — the false claim does NOT hold"
    exit 1

else
    echo "usage: $0 [pass|fail]" >&2
    exit 2
fi