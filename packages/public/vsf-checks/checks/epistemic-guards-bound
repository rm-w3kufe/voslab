#!/usr/bin/env bash
# CLAIM: G-16 epistemic-guards-bound — every registered epistemic guard
# declares WHAT it protects, not only HOW to run it:
#   pass -> (a) every entry in state/epistemic/guards.jsonl that carries
#               a cmd also carries non-empty artifact AND covers
#               (26/26 bound — was 15/26 before G-16); AND
#           (b) python3 -m vos_kernel.epistemic audit-guards reports
#               coverage 1.0 / ok true (findings->guard direction holds:
#               every fix names an existing guard).
#   fail -> deliberately-false fixture: a guard record with cmd but
#               empty artifact/covers must be flagged (if the verifier
#               accepts it, the unbound-guard assertion does not hold —
#               G-16 would be back; non-zero, as documented).
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
GUARDS="$ROOT/state/epistemic/guards.jsonl"

# verifier: rc 0 iff every cmd-carrying guard declares artifact+covers
verify_bindings() {
  python3 - "$1" <<'PYEOF'
import json, sys
path = sys.argv[1]
bad = []
total = 0
try:
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            g = json.loads(line)
            if not g.get("cmd"):
                continue
            total += 1
            if not (str(g.get("artifact", "")).strip()
                    and str(g.get("covers", "")).strip()):
                bad.append(g.get("id", "?"))
except (OSError, json.JSONDecodeError) as e:
    print(f"unreadable guards store: {e}")
    sys.exit(1)
if bad:
    print(f"UNBOUND ({len(bad)}/{total}): {', '.join(bad)}")
    sys.exit(1)
print(f"bound {total}/{total}: artifact+covers present on every cmd guard")
sys.exit(0)
PYEOF
}

if [ "$MODE" = "pass" ]; then
  if [ ! -f "$GUARDS" ]; then echo "FAIL: no $GUARDS"; exit 1; fi
  if ! verify_bindings "$GUARDS"; then
    echo "FAIL: a registered guard carries cmd without artifact/covers (G-16 regression)"; exit 1
  fi
  if ! (cd "$ROOT" && python3 -m vos_kernel.epistemic audit-guards >/dev/null 2>&1); then
    echo "FAIL: audit-guards coverage/links broken (findings->guard)"; exit 1
  fi
  echo "epistemic-guards-bound: PASS — all cmd guards bound, findings coverage 1.0"
  exit 0
fi

if [ "$MODE" = "fail" ]; then
  # deliberately-false: an unbound guard MUST be flagged (rc != 0)
  FIXDIR=$(mktemp -d)
  trap 'rm -rf "$FIXDIR"' EXIT
  printf '%s\n' '{"id": "G-UNBOUND-FIXTURE", "cmd": ["true"], "expect": ["x"], "artifact": "", "covers": ""}' > "$FIXDIR/guards.jsonl"
  if verify_bindings "$FIXDIR/guards.jsonl"; then
    echo "epistemic-guards-bound: OK — unbound guard accepted, claim does not hold"
    exit 1
  fi
  echo "FAIL: fixture flagged as expected (claim holds; fail mode asserts the opposite)"
  exit 1
fi

echo "usage: $0 [pass|fail]"; exit 2
