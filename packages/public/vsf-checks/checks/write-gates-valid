#!/usr/bin/env bash
# design: system/s5-policy/agent-policy/agent-write-gates-v1/write_gates.vsm
# (AGENT-WRITE-GATES-v1, S5 rmw3 2026-08-17)
# (R16_impl_with_design — the registry IS the design of the write-time gates)
# CLAIM: write-gates-valid holds — the registry parses, every registered
# gate's command exists, every write-time gate is mode=per-file (O(1), R18
# latency), the orchestrator runs exactly the registered gates, AND the
# orchestrator is WIRED to an active invoker (G-12): the registered core
# plugin vsl-check-on-write is declared in opencode.json, its daemon
# script invokes write_gate_orchestrator.py, and the end-to-end chain
# blocks a deliberately-broken fixture with a [DEMONIO ...] verdict.
#
# Why a dedicated check (lesson DAEMON-GATE-AFTER-EARLY-EXIT): a
# mis-registered gate (missing command, corpus mode at write time, empty
# registry) fails SILENTLY — the daemon reports nothing and the write
# passes. That is the same class of silent death this whole redesign
# removes. This check makes the registry itself verifiable (R4.1).
#
#   pass -> every gate: cmd exists (resolvable from ROOT), mode ∈
#           {per-file, corpus}, block_on ∈ {nonzero, contains:<marker>},
#           label non-empty. Registry non-empty. Orchestrator parses and
#           lists exactly the registered gates. WIRED (G-12): plugin
#           declared in opencode.json + daemon script calls the
#           orchestrator + end-to-end chain blocks a broken fixture
#           with [DEMONIO ...] (rc=1). → exit 0
#   fail -> deliberately-broken variants: (a) a registry that registers a
#           nonexistent command is asserted to be valid, and (b) an
#           unwired daemon script is asserted to be wired — both must
#           exit non-zero (false claims fail).
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# packaged-layout guard (2026-10-03, T5.4 system_lifecycle audit): checks
# may run from packages/public/vsf-checks/checks/ where ROOT above is the
# PACKAGE root, not the repo — docs/, scripts/, .opencode/ resolve wrong
# (SKIP/fake-FAIL observed: classification-valid degraded to SKIP exit 0).
# Walk up to the first dir holding .git (real checkout). Layout vsf
# (checks/ at repo root) is a no-op: ROOT already contains .git.
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
REGISTRY="$ROOT/system/s5-policy/agent-policy/agent-write-gates-v1/write_gates.vsm"
ORCH="$ROOT/scripts/vsl/tools/write_gate_orchestrator.py"

fail() { echo "FAIL: $*" >&2; exit 1; }

[ -f "$REGISTRY" ] || fail "registry missing: $REGISTRY"
[ -f "$ORCH" ] || fail "orchestrator missing: $ORCH"

# ── parse the registry: extract gate name + block text ──
# reuse the orchestrator's own parse logic via a dry-run list of gates.
gates=$("$ORCH" __list 2>/dev/null)
rc=$?
if [ $rc -ne 0 ] || [ -z "$gates" ]; then
  fail "orchestrator cannot parse the registry (rc=$rc)"
fi

# each gate line: <name>|<cmd>|<mode>|<label>|<block_on>|<advisory>
# note: run the while in a here-string (not a pipe) so we can capture the
# loop's exit status directly — PIPESTATUS is unreliable under set -u with
# builtins.
while IFS='|' read -r name cmd mode label block_on advisory; do
  [ -n "$name" ] || fail "gate with empty name in registry"
  [ -n "$label" ] || fail "gate '$name' missing label (orchestrator would emit no [DEMONIO] tag)"
  case "$mode" in
    per-file|corpus) ;;
    *) fail "gate '$name' mode='$mode' — must be per-file or corpus" ;;
  esac
  case "$block_on" in
    nonzero|contains:*) ;;
    *) fail "gate '$name' block_on='$block_on' — must be nonzero or contains:<marker>" ;;
  esac
  # the first token of cmd must resolve from ROOT (python3 prefix unwrap)
  exe="${cmd%% *}"
  [ "$exe" = "python3" ] && exe="$(printf '%s' "$cmd" | awk '{print $2}')"
  [ -e "$ROOT/$exe" ] || [ -e "$ROOT/scripts/$exe" ] || \
    fail "gate '$name' cmd='$cmd' — '$exe' does not resolve from ROOT"
done <<< "$gates"

# registry non-empty is enforced by the orchestrator's own __list (it exits
# 1 on zero gates) — checked above via rc.

if [ "$MODE" = "pass" ]; then
  # ── G-12 wiring: the registry must be reachable from an ACTIVE invoker ──
  WANT_PLUGIN=".opencode/plugins/core/vsl-check-on-write.ts"
  DAEMON="$ROOT/.opencode/plugins/scripts/vsl-check-on-write"
  python3 - "$ROOT/opencode.json" "$WANT_PLUGIN" <<'PYEOF' || fail "vsl-check-on-write not registered in opencode.json plugin[] (G-12: no active invoker)"
import json, sys
cfg_path, want = sys.argv[1], sys.argv[2]
try:
    cfg = json.load(open(cfg_path))
except (OSError, json.JSONDecodeError) as e:
    print(f"opencode.json unreadable: {e}")
    sys.exit(1)
plugins = cfg.get("plugin") or []
if not any(str(p) == want for p in plugins):
    sys.exit(1)
sys.exit(0)
PYEOF
  [ -f "$DAEMON" ] || fail "daemon script missing: $DAEMON (G-12: unwired)"
  grep -qF "write_gate_orchestrator.py" "$DAEMON" \
    || fail "daemon script does not invoke write_gate_orchestrator.py (G-12: unwired)"
  # end-to-end fixture (G-12: 'verificacion post-enlace con fixture que
  # deba bloquear'): a version-violating .vsm through the real chain —
  # plugin script → orchestrator → registry gates — MUST block (rc!=0)
  # with a labelled [DEMONIO ...] verdict.
  FIX=$(mktemp --suffix=.vsm)
  trap 'rm -f "$FIX"' EXIT
  printf '⟦ g12_wiring_fixture | FIXTURE-v1 | vsm-1.2 | 2026-10-05T02:30:00Z ⟧\n\n@vsm 1.2\n@status active\n\n// deliberately wrong version — the chain MUST block this write\n\n⟦ /g12_wiring_fixture ⟧\n' > "$FIX"
  chain_out=$(bash "$DAEMON" "$FIX" 2>&1); chain_rc=$?
  if [ "$chain_rc" -eq 0 ] || ! printf '%s' "$chain_out" | grep -q '\[DEMONIO '; then
    fail "end-to-end chain did NOT block the fixture (rc=$chain_rc) — G-12 wiring broken"
  fi
  echo "PASS: write-gates-valid — $(echo "$gates" | wc -l | tr -d ' ') gate(s) resolvable+per-file; wiring live (opencode.json → daemon → orchestrator → fixture blocked)"
  exit 0
fi

# ── fail mode: assert deliberately-false claims ──
# (b) G-12: 'a daemon script that never calls the orchestrator is wired'
# It is NOT. Detection on a fixture must flag the missing link (blindness
# = the check would not have caught the original G-12 gap).
UNWIRED=$(mktemp)
trap 'rm -f "$UNWIRED"' EXIT
printf '#!/usr/bin/env bash\nexit 0\n' > "$UNWIRED"
if grep -qF "write_gate_orchestrator.py" "$UNWIRED"; then
  echo "FAIL (negative control): unwired fixture detected as WIRED — check is blind (G-12 regression)" >&2
  exit 1
fi
echo "FAIL (negative control): unwired daemon correctly flagged — wiring detection works; false claim does NOT hold" >&2
# (a) Claim: 'a gate whose command does not exist is a valid registration'.
# It is NOT. The negative control proves the check discriminates: point the
# registry resolver at a nonexistent path (via a fixture registry) — the
# false claim must FAIL (exit non-zero). We test the resolver directly on a
# fixture, not the real registry (which must stay valid for other gates).
fixture_cmd="checks/definitely-not-a-real-check-xyz"
if [ -e "$ROOT/$fixture_cmd" ]; then
  echo "FAIL (negative control): fixture '$fixture_cmd' unexpectedly exists — cannot test" >&2
  exit 1
fi
# The resolver logic (exe must resolve from ROOT) is what fails on a
# nonexistent command. Reproduce the resolution: it must NOT resolve.
if [ -e "$ROOT/$fixture_cmd" ] || [ -e "$ROOT/scripts/$fixture_cmd" ]; then
  echo "FAIL (negative control): nonexistent cmd resolved — check is blind" >&2
  exit 1
fi
echo "FAIL (negative control): a gate with nonexistent cmd 'checks/definitely-not-a-real-check-xyz' does NOT resolve — false claim does NOT hold" >&2
exit 1