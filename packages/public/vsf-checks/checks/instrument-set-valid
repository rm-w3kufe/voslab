#!/usr/bin/env bash
# CLAIM: the declared instrument set (vsf_checks/checks_manifest.json)
# matches the observed set (checks/ executable files) — S4
# checks-audit-checks: an instrument that verifies the instrument set.
#   pass -> vsf_checks/regen_manifest.py --audit exits 0
#           (no missing/extra/stale entries)
#   fail -> inventory has drifted: a check was added/removed/resized
#           without regenerating the manifest (or vice versa)
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
exec python3 "$DIR/../vsf_checks/regen_manifest.py" --audit
