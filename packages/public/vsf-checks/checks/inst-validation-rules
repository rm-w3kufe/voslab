#!/usr/bin/env bash
# CLAIM: G-30 inst-validation-rules — the fails_if rules of
# system/instance/inst-validation-01/validation.vsm have a runtime
# consumer that discriminates:
#   pass -> (a) scripts/vsl/tools/inst_validation_rules.py exits 0 on
#               the live workspace (runnable rules c1/c2/c4/c5 clean,
#               coverage wiring for c7/c8 present); AND
#           (b) its --self-test discriminates: fixture violations of
#               c1_pairs, c2_s1_pairs, c4_no_secrets and
#               c5_contract_uniqueness are each caught while a clean
#               fixture root passes.
#   fail -> a deliberately-false variant: asserts NO runnable rule
#               exists for the validation doc (must exit non-zero —
#               the claim does not hold; G-30 would be back).
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
TOOL="$ROOT/scripts/vsl/tools/inst_validation_rules.py"

if [ "$MODE" = "pass" ]; then
  if [ ! -f "$TOOL" ]; then echo "FAIL: no $TOOL"; exit 1; fi
  if ! python3 "$TOOL" >/dev/null 2>&1; then
    echo "FAIL: live runnable rules report a violation"; exit 1
  fi
  if ! python3 "$TOOL" --self-test >/dev/null 2>&1; then
    echo "FAIL: self-test does not discriminate (c1/c2/c4/c5)"; exit 1
  fi
  echo "inst-validation-rules: PASS — live clean, self-test discriminates"
  exit 0
fi

if [ "$MODE" = "fail" ]; then
  # deliberately-false: "no runnable evaluator exists" — must not hold
  if [ -f "$TOOL" ] && python3 "$TOOL" --self-test >/dev/null 2>&1; then
    echo "inst-validation-rules: OK — absence assertion does not hold"
    exit 1  # the false claim does not hold (non-zero, as documented)
  fi
  echo "FAIL: evaluator missing or blind (G-30 regression)"; exit 1
fi

echo "usage: $0 [pass|fail]"; exit 2
