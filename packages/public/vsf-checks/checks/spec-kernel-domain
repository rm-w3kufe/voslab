#!/usr/bin/env bash
# CLAIM: G-32 spec-kernel-domain — the spec<->kernel domain is registered
# in state-canon (SPEC-KERNEL-DOMAIN-REGISTER paid):
#   pass -> loading scripts/state/canon/voslab_instance.py the exact way
#               the MCP server does yields domain 'spec_kernel' answering
#               state_query-style queries with the six known deviations
#               (live ledger evidence lines), AND a registered
#               SpecKernelReconciler whose diff reports exactly those six
#               as rule_violation (provider/observe statuses agree);
#   fail -> the deliberately-false variant asserts the domain is NOT
#               registered — must exit non-zero while it exists (the
#               absence claim does not hold; G-32 would be back).
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
INST="$ROOT/scripts/state/canon/voslab_instance.py"
FOCUS="$ROOT/current_focus.json"

run_assert() {  # $1 = "present" | "absent"
  python3 - "$1" "$INST" "$FOCUS" <<'PY'
import importlib.util, sys
mode, inst_path, focus = sys.argv[1], sys.argv[2], sys.argv[3]
spec = importlib.util.spec_from_file_location("sk_check", inst_path)
mod = importlib.util.module_from_spec(spec)
sys.modules["sk_check"] = mod
spec.loader.exec_module(mod)
provider, reconcilers = mod.load(focus)
registered = "spec_kernel" in provider.list_domains()
if mode == "absent":
    # false claim: domain missing — while it IS registered this must fail
    sys.exit(0 if not registered else 1)
if not registered:
    print("FAIL: spec_kernel not registered", file=sys.stderr)
    sys.exit(1)
records = provider.query("spec_kernel")
if len(records) != 6:
    print(f"FAIL: expected 6 records, got {len(records)}", file=sys.stderr)
    sys.exit(1)
if not all(r["status"] in ("known_deviation", "evidence_missing")
           for r in records):
    print("FAIL: unexpected status values", file=sys.stderr)
    sys.exit(1)
rec = next((r for r in reconcilers
            if getattr(r, "domain", None) == "spec_kernel"), None)
if rec is None:
    print("FAIL: no SpecKernelReconciler registered", file=sys.stderr)
    sys.exit(1)
diffs = rec.diff()
rules = [d for d in diffs if d.kind == "rule_violation"]
if len(rules) != 6:
    print(f"FAIL: diff should report 6 deviations, got {len(diffs)}",
          file=sys.stderr)
    sys.exit(1)
sys.exit(0)
PY
}

if [ "$MODE" = "pass" ]; then
  if [ ! -f "$INST" ]; then echo "FAIL: no $INST"; exit 1; fi
  run_assert present || { echo "spec-kernel-domain: FAIL"; exit 1; }
  echo "spec-kernel-domain: PASS — domain answers, diff reports the six"
  exit 0
fi

if [ "$MODE" = "fail" ]; then
  if run_assert absent; then
    # absent-assertion SUCCEEDED = domain is gone -> real regression
    echo "FAIL: domain registration broken (G-32 regression)"
  else
    # absent-assertion FAILED = domain exists -> the false claim does not
    # hold (non-zero, as documented)
    echo "spec-kernel-domain: OK — absence assertion does not hold"
  fi
  exit 1
fi

echo "usage: $0 [pass|fail]"; exit 2
