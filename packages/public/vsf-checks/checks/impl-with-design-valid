#!/usr/bin/env bash
# design: docs/design/sandbox/SPEC-REVIEW-ARC-DESIGN.vsm
# (R16_impl_with_design — enforcement determinista; ver SPEC-REVIEW-ARC-DESIGN)
# CLAIM: R16_impl_with_design holds — every NEW implementation artifact
# (staged under scripts/, checks/, .opencode/plugins/, projects/) carries
# its DISEÑO DE ESTRUCTURA: a self-declared `design:` header line resolving
# to an existing .vsm design source (sandbox/ or design-sources/).
#   pass -> for every staged NEW artifact in the impl dirs, a design source
#           exists (self-declared `design:` header → file exists); no staged
#           artifacts ⟹ vacuous truth ⟹ exit 0.
#   fail -> deliberately-false variant: asserts the phantom artifact
#           scripts/vsl/tools/__phantom_impl__.py HAS a design source (must exit
#           non-zero — the false claim does not hold).
#   --report -> whole-corpus scan, report-only (exit 0 always): lists every
#           existing impl artifact without a design source — calibration
#           for the rule (detector-first).
# CWD-independent: derives ROOT from BASH_SOURCE.
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# packaged-layout guard (2026-10-03, T5.4 system_lifecycle audit): checks
# may run from packages/public/vsf-checks/checks/ where ROOT above is the
# PACKAGE root, not the repo — docs/, scripts/, .opencode/ resolve wrong
# (SKIP/fake-FAIL observed: classification-valid degraded to SKIP exit 0).
# Walk up to the first dir holding .git (real checkout). Layout vsf
# (checks/ at repo root) is a no-op: ROOT already contains .git.
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
IMPL_DIRS="scripts checks .opencode/plugins projects"
DESIGN_DIRS="$ROOT/docs/design/sandbox $ROOT/docs/design/sources"

# returns 0 if $1 (abs path) self-declares a design: header resolving to an
# existing .vsm under ROOT
has_self_declared_design() {
    local f="$1"
    [ -f "$f" ] || return 1
    local decl
    decl="$(head -40 "$f" | grep -oE "design:[[:space:]]*[^[:space:]]+\.vsm" | head -1 | sed 's/design:[[:space:]]*//')"
    [ -z "$decl" ] && return 1
    # resolve relative to ROOT (docs/spec_revision retired 2026-10-29)
    [ -f "$ROOT/$decl" ] && return 0
    return 1
}

# whole-map path extraction (P2): prints one impl-dir file path per line for
# every plugin/instrument declared in agent_map.vsm. Class-level substrates
# (" (", "~") and non-impl paths are skipped; ambiguity reports to stderr.
extract_map_impl_paths() {
    python3 - "$1" "$2" <<'PYEXTRACT'
import re, sys, pathlib
MAP, ROOT = sys.argv[1], pathlib.Path(sys.argv[2])
IMPL = ("scripts/", "checks/", ".opencode/plugins/", "projects/")
text = open(MAP, encoding="utf-8").read()
seen = set()
for m in re.finditer(r'(plugin|instrument|agent|adapter|handler)\(\s*"([^"]+)"', text):
    kind, name = m.group(1), m.group(2)
    block = text[m.end(): m.end() + 500]
    block = block.split('),', 1)[0].split(')\n', 1)[0]
    sm = re.search(r'substrate="([^"]*)"', block)
    sub = sm.group(1) if sm else None
    if sub and (' (' in sub or '~' in sub):
        continue
    cands = []
    if sub and not sub.endswith('/'):
        cands.append(sub)
    if sub and sub.endswith('/'):
        cands.append(sub + name)
    if sub and not sub.endswith('/') and pathlib.PurePosixPath(sub).name != name:
        cands.append(sub.rstrip('/') + '/' + name)
    rel = next((c for c in cands if c.startswith(IMPL) and (ROOT / c).is_file()), None)
    if not rel:
        bases = []
        search = [ROOT / sub] if (sub and sub.endswith('/') and (ROOT / sub).is_dir()) \
                 else [ROOT / i for i in IMPL if (ROOT / i).is_dir()]
        for d in search:
            bases += [str(p.relative_to(ROOT)) for p in d.rglob(name)
                      if p.is_file() and '__pycache__' not in str(p)]
        if len(bases) == 1:
            rel = bases[0]
        elif len(bases) > 1:
            print(f"# AMBIGUO {kind}({name}): {bases}", file=sys.stderr)
    if rel and rel.startswith(IMPL) and rel not in seen:
        seen.add(rel)
        print(rel)
PYEXTRACT
}

if [ "$MODE" = "pass" ]; then
    # staged NEW artifacts under impl dirs (ACMR = added/copied/modified/renamed)
    bad=0
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        # Skip JSON files — they can't have comments/design headers
        case "$f" in
            *.json) continue ;;
        esac
        in_impl=""
        for d in $IMPL_DIRS; do
            case "$f" in
                "$d"/*) in_impl=1 ;;
            esac
        done
        [ -n "$in_impl" ] || continue
        # staged file that is not deleted; skip deletions
        if ! git -C "$ROOT" diff --cached --name-only --diff-filter=A -- "$f" | grep -q "^${f}$"; then
            continue
        fi
        # the artifact's design must be declared in the file itself
        if ! has_self_declared_design "$ROOT/$f"; then
            echo "FAIL: $f — nuevo artefacto de implementación sin design: header (R16_impl_with_design)"
            bad=1
        fi
    done < <(git -C "$ROOT" diff --cached --name-only --diff-filter=A 2>/dev/null)

    # ── whole-map coverage (CHILD-ROUTE-REPAIR P2, S5-approved 2026-10-14) ──
    # The MAP is the checklist: every impl-dir file declared in agent_map.vsm
    # must self-declare a resolvable design:. The old substrate=-only grep
    # skipped every plugin(...) whose substrate is a CLASS DIRECTORY
    # (".opencode/plugins/"), and the MAP path predated agent-map-v1/ — a
    # double silent no-op that hid backbone.ts's dead child/ design ref.
    # Extractor: substrate=file → it; substrate=dir → dir+basename; else a
    # unique basename search under the substrate (deterministic, R10).
    MAP="$ROOT/system/s5-policy/agent-policy/agent-map-v1/agent_map.vsm"
    map_checked=0
    if [ -f "$MAP" ]; then
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            map_checked=$((map_checked+1))
            if ! has_self_declared_design "$ROOT/$f"; then
                echo "FAIL: $f — declarado en agent_map.vsm sin design: header resoluble (R16 map coverage)"
                bad=1
            fi
        done < <(extract_map_impl_paths "$MAP" "$ROOT")
    else
        echo "FAIL: agent_map.vsm ausente ($MAP) — cobertura R16 no verificable (anti-vacuous)"
        bad=1
    fi

    if [ "$bad" = "0" ]; then
        echo "PASS: ${map_checked} artefactos del agent_map + artefactos nuevos staged con design de estructura (R16)"
        exit 0
    fi
    exit 1

elif [ "$MODE" = "map" ]; then
    # R16 coverage of DECLARED INSTRUMENTS (C1 closure): every instrument()
    # declared in agent_map.vsm whose substrate is a file under impl dirs
    # must self-declare a design: header. The S2 map is the checklist —
    # an instrument registered WITHOUT design is a policy violation, not a
    # new-artifact gap (agent-map-valid census + this gate close the loop).
    MAP="$ROOT/system/s5-policy/agent-policy/agent-map-v1/agent_map.vsm"
    [ -f "$MAP" ] || { echo "SKIP: agent_map.vsm ausente"; exit 0; }
    bad=0
    checked=0
    while IFS= read -r path; do
        [ -z "$path" ] && continue
        checked=$((checked+1))
        if ! has_self_declared_design "$ROOT/$path"; then
            echo "FAIL: $path — declarado en agent_map.vsm sin design: header (R16 map coverage)"
            bad=1
        fi
    done < <(extract_map_impl_paths "$MAP" "$ROOT")
    if [ "$bad" = "0" ]; then
        echo "PASS: $checked instrumentos registrados en agent_map.vsm todos con design: header (R16 map coverage)"
        exit 0
    fi
    exit 1

elif [ "$MODE" = "fail" ]; then
    # negative control: the false claim "the phantom artifact has a design
    # source" must NOT hold. If it ever starts holding (someone creates a
    # design: header for it), the check stops discriminating and must fail.
    if has_self_declared_design "$ROOT/scripts/vsl/tools/__phantom_impl__.py"; then
        echo "FAIL (negative): phantom artifact has a design — check no longer discriminates"; exit 1
    fi
    # (f3) CHILD-ROUTE-REPAIR P3 (S5 2026-10-14): a design: ref pointing at
    # the decommissioned child/ must NOT resolve — dead-route discrimination.
    # If it ever resolves, R16 stops catching exactly the bug this task fixed.
    F3DIR=$(mktemp -d)
    printf '#!/usr/bin/env python3\n# design: child/docs/integration_backbone_design.vsm\n' > "$F3DIR/__child_route_impl__.py"
    if has_self_declared_design "$F3DIR/__child_route_impl__.py"; then
        echo "FAIL(f3): child/ dead ref ACCEPTED — R16 no discrimina rutas muertas" >&2
        rm -rf "$F3DIR"; exit 1
    fi
    rm -rf "$F3DIR"
    echo "FAIL (negative): phantom + child-route fixtures rechazados — la afirmación falsa no se sostiene"; exit 1

elif [ "$MODE" = "--report" ]; then
    # calibration scan: report-only, never blocks
    echo "=== R16 corpus scan (report-only) ==="
    missing=0
    for d in $IMPL_DIRS; do
        [ -d "$ROOT/$d" ] || continue
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            if ! has_self_declared_design "$f"; then
                echo "  SIN design: ${f#"$ROOT"/}"
                missing=$((missing + 1))
            fi
        done < <(find "$ROOT/$d" -type f \
                ! -path "*/__pycache__/*" ! -name "*.pyc" ! -name ".gitkeep" \
                ! -path "*/target/*" ! -path "*/node_modules/*" ! -path "*/.git/*" \
                ! -path "*/.venv/*" ! -path "*/dist/*" ! -path "*/build/*" \
                2>/dev/null)
    done
    echo "=== $missing artefactos sin design: header (calibración; no bloquea) ==="
    exit 0

else
    echo "usage: $0 [pass|fail|--report]" >&2
    exit 2
fi