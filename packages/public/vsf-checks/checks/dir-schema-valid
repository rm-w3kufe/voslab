#!/usr/bin/env bash
# checks/dir-schema-valid — DIR-SCHEMA policy check (R4.1).
# Confirms every .vsm under docs/spec_revision/ is classified and placed per
# docs/spec_revision/design-sources/dir_schema.spec.vsm. Same instrument as the policy
# verifier (scripts/vsl/validator/verify_dir_schema.py), so check and spec never drift.
# Negative control: a fixture tree with a MISPLACED + UNCOVERED + UNDECLARED
# file must be flagged (rc=1) — the check cannot drift to always-green.
#
# Usage:  checks/dir-schema-valid pass|fail
# Exit:   0 on expected outcome, 1 on unexpected.
set -euo pipefail

mode="${1:-pass}"
# FND-BOOTOOLS-PATH-DRIFT-01 (sibling bug): repo="${VSF_ROOT:-/home/rmw3/vsf}"
# validated the OLD vsf tree while vOSlab's own tree drifted (2 real
# violations invisible). Walk up from BASH_SOURCE like the sibling checks.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
repo="$SCRIPT_DIR"
while [ "$repo" != "/" ] && [ ! -d "$repo/.git" ] && [ ! -d "$repo/packages/public/vsf-checks" ]; do
  repo="$(dirname "$repo")"
done
if [ "$repo" = "/" ]; then
  echo "FAIL: dir-schema-valid: no repo root above ${SCRIPT_DIR}" >&2
  exit 1
fi

emit() { printf '%s\n' "$1"; }

case "$mode" in
  pass)
    if out=$(python3 "$repo/scripts/vsl/validator/verify_dir_schema.py" 2>&1); then
      emit "✓ dir-schema-valid: $out"
      exit 0
    else
      emit "✗ dir-schema-valid: $out"
      exit 1
    fi
    ;;
  fail)
    # ── negative control: a deliberately-false claim must NOT hold ──
    # A /tmp fixture tree with a misplaced s2 file in the s4 dir, an uncovered
    # type, and an undeclared file in a static dir — the verifier must flag it.
    fx=$(mktemp -d /tmp/dir-schema-neg-XXXXXX)
    mkdir -p "$fx/docs/spec_revision/system/s4-intelligence" \
             "$fx/docs/spec_revision/system/boot" \
             "$fx/docs/spec_revision/design-sources/dir-schema-v1"
    # spec lives at design-sources/dir-schema-v1/dir_schema.spec.vsm (the
    # flat design-sources/dir_schema.spec.vsm path never existed here —
    # the old cp died and the NC "passed" via the CONFIG branch instead of
    # the MISPLACED/UNCOVERED/UNDECLARED detection it claims to prove).
    cp "$repo/docs/spec_revision/design-sources/dir-schema-v1/dir_schema.spec.vsm" \
       "$fx/docs/spec_revision/design-sources/dir-schema-v1/dir_schema.spec.vsm"
    printf '⟦ s2_misplaced | S2-NATS-01 | vsm-1.2 | 2026-08-14 ⟧\n\n@vsm 1.2\n' \
      > "$fx/docs/spec_revision/system/s4-intelligence/s2_misplaced.vsm"
    printf '⟦ ghost | GHOST-TYPE-99 | vsm-1.2 | 2026-08-14 ⟧\n\n@vsm 1.2\n' \
      > "$fx/docs/spec_revision/system/boot/ghost.vsm"
    if out=$(python3 - "$repo" "$fx" <<'PY'
import importlib.util, sys
spec = importlib.util.spec_from_file_location(
    "verify_dir_schema", sys.argv[1] + "/scripts/vsl/validator/verify_dir_schema.py")
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
import pathlib
findings = mod.check(base=pathlib.Path(sys.argv[2]))
for f in findings:
    print(f)
print(f"TOTAL {len(findings)}")
sys.exit(1 if findings else 0)   # flag found => non-zero (discriminates)
PY
    ); then
      # verifier exited 0 = it found nothing = the false claim held — BAD:
      # the negative control passed, so the check is a proxy. Per the R4.1
      # contract, fail-mode must exit NON-ZERO when it discriminates.
      emit "✗ dir-schema-valid fail-mode: verifier did NOT flag the fixture"
      echo "$out"
      rm -rf "$fx"
      exit 0
    else
      total=$(echo "$out" | grep -c '^\(MISPLACED\|UNCOVERED\|UNDECLARED\)' || true)
      emit "✓ dir-schema-valid fail-mode: fixture flagged ($total finding(s))"
      echo "$out" | head -4
      rm -rf "$fx"
      exit 1
    fi
    ;;
  *)
    emit "usage: $0 pass|fail"
    exit 2
    ;;
esac
