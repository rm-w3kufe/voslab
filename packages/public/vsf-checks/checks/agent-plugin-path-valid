#!/usr/bin/env bash
# design: docs/spec_revision/system/s5-policy/agent-policy/agent_instruments.vsm
# AGENT-PLUGIN-CYCLE-REPAIR-2026-08-17 — regression guard for hardcoded
# absolute paths in VSF opencode plugins.
#
# CLAIM: no VSF opencode plugin (.opencode/plugins/*.ts, .opencode/plugin/*.ts)
# hardcodes an absolute path to the repo (e.g. /home/rmw3/vsf) in executable
# code. Path resolution must use the shared helper find-plugin-script.ts
# (walk-up from directory) — the lesson from learning-cycle-scan.ts resolving
# to /home and running NOTHING, and from 3 plugins carrying /home/rmw3/vsf/...
# literals that break silently when the repo moves (AGENT-PLUGIN-CYCLE-REPAIR).
#   pass -> corpus-wide scan: no plugin contains a hardcoded repo path outside
#           comments/docs (the fix annotation may mention the old path).
#   fail -> a fixture plugin carrying a hardcoded /home/.../vsf path in code
#           MUST be flagged (exit != 0 — discriminates). A fail mode that
#           passes while the claim is true is a proxy (verify_claim.py
#           contract); only a failing fail-mode proves the check discriminates.
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Hardcoded repo path pattern: an absolute path ending in /vsf (the repo),
# used as a string/constant in executable code — not inside a comment line.
# Comment lines (leading //, /*, *, or preceded by #) are excluded: the fix
# annotations legitimately reference the old path for the record.
REPO_ABS='["'"'"']/home/[^"'"'"']*/vsf/'
RE_COMMENT='^\s*(//|/\*|\*|#)'

violations=0
scan() {
  local dir="$1"
  for f in "$dir"/*.ts; do
    [ -f "$f" ] || continue
    while IFS= read -r line; do
      if echo "$line" | grep -qE "$REPO_ABS"; then
        if ! echo "$line" | grep -qE "$RE_COMMENT"; then
          echo "  ✗ $f: $line" >&2
          violations=$((violations + 1))
        fi
      fi
    done < "$f"
  done
}

if [ "$MODE" = "pass" ]; then
  scan "$ROOT/.opencode/plugins"
  scan "$ROOT/.opencode/plugin"
  if [ "$violations" -eq 0 ]; then
    echo "PASS: no hardcoded repo paths in VSF opencode plugins (resolution via find-plugin-script)"
    exit 0
  fi
  echo "FAIL: $violations hardcoded repo path(s) in plugins — use find-plugin-script.ts (walk-up from directory)" >&2
  exit 1
else
  # fail mode = negated claim: expect plugins to be CLEAN of hardcoded paths.
  # A fixture plugin with a hardcoded path MUST be flagged → fail mode fails
  # (exit != 0), proving the check discriminates.
  FIXTURE="$ROOT/docs/spec_revision/sandbox/_agent_plugin_path_fixture.ts"
  cat > "$FIXTURE" << 'FIXEOF'
// fixture for agent-plugin-path-valid fail mode (R4.1 negative control)
import { execFile } from "node:child_process";
const SCRIPT = "/home/rmw3/vsf/scripts/docs/some_script.py";
export const Fixture: Plugin = async () => ({});
FIXEOF
  scan "$ROOT/docs/spec_revision/sandbox" 2>/dev/null | grep -q "_agent_plugin_path_fixture" && true
  # direct check on the fixture file
  hit=0
  while IFS= read -r line; do
    if echo "$line" | grep -qE "$REPO_ABS" && ! echo "$line" | grep -qE "$RE_COMMENT"; then
      hit=1
    fi
  done < "$FIXTURE"
  rm -f "$FIXTURE"
  if [ "$hit" -eq 1 ]; then
    # the negated claim ("no hardcoded path is flagged") is false — the
    # fixture WAS flagged. fail mode fails as required.
    echo "FAIL (expected): fixture with hardcoded path was detected — check discriminates"
    exit 1
  fi
  echo "PASS (unexpected): fixture with hardcoded path NOT detected — check is a proxy" >&2
  exit 0
fi