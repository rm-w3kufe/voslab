#!/usr/bin/env bash
# design: docs/plans/structural_tensions_plan_2026_10_20.vsm (T1-F2: systemd-units-fresh)
# systemd-units-fresh — S2 self-observation of the vsf timer fleet.
#
# CLAIM: the user-level systemd fleet that runs the suite hourly is itself
# observed:
#   pass -> (a) NO vsf-* unit appears in `systemctl --user --failed`;
#               AND (b) the 5 scheduling timers are all `enabled`:
#               vsf-scheduled-suite.timer, vsf-gates-daily.timer,
#               vsf-docs-reconcile.timer, vsf-gates-weekly.timer,
#               vsf-restore-drill.timer.
#           (vsf-net-housekeeping.timer is NOT in the fleet: separate
#           family (%h/vsf/scripts), intentionally disabled — excluded by
#           design, see plan T4 inventory.)
#           SKIP (exit 0, honest) when this env has no systemctl or no
#           systemd user bus (env -i stripped runs, non-systemd hosts) —
#           declared by plan T1-F2: the red lives where the timers
#           actually run (the systemd timer context has the bus).
#   fail -> self-contained discrimination proof: a PATH-shimmed fake
#               systemctl walks 3 fixtures — clean (must PASS), failed
#               vsf unit (must be flagged), disabled timer (must be
#               flagged). Accepting a broken fixture = proxy: verify_claim
#               contract, this mode then exits non-zero.
# Context (plan 2026-10-20 T1 evidence): the suite was green in dev while
# the systemd fleet diverged >=2 days — scheduled_suite covered run_gates
# but neither the timers nor their enable-state had a guard of their own
# (S2 auto-referencia incompleta: guardia sin guardia).
# CWD-independent: ROOT from BASH_SOURCE walk-up to .git (T1 lesson).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done

TIMERS="vsf-scheduled-suite.timer vsf-gates-daily.timer vsf-docs-reconcile.timer vsf-gates-weekly.timer vsf-restore-drill.timer"

fail() { echo "FAIL: $*" >&2; exit 1; }

check_systemd() {
  command -v systemctl >/dev/null 2>&1 \
    || { echo "SKIP: no systemctl in PATH (env without systemd)"; exit 0; }
  local failed
  if ! failed="$(systemctl --user --failed --no-legend 2>/dev/null)"; then
    echo "SKIP: no systemd user bus (stripped/non-systemd env)"
    exit 0
  fi
  local vsf_bad other
  vsf_bad="$(printf '%s\n' "$failed" | awk '$1 ~ /^vsf-/ {print $1}')"
  other="$(printf '%s\n' "$failed" | awk '$1 !~ /^vsf-/ && NF {print $1}')"
  if [ -n "$other" ]; then
    echo "note: non-vsf failed units (out of scope): $(printf '%s' "$other" | tr '\n' ' ')"
  fi
  if [ -n "$vsf_bad" ]; then
    fail "failed vsf units: $(printf '%s' "$vsf_bad" | tr '\n' ' ')"
  fi
  local t state missing=""
  for t in $TIMERS; do
    state="$(systemctl --user is-enabled "$t" 2>/dev/null | head -1)" || state=""
    [ "$state" = "enabled" ] || missing="$missing $t(${state:-absent})"
  done
  if [ -n "$missing" ]; then
    fail "timers not enabled:$missing"
  fi
  echo "PASS: systemd-units-fresh — 5 timers enabled, no failed vsf units"
  exit 0
}

# ── fail mode: 3-fixture discrimination proof (proxy detector) ───────────
write_fake() {
  # $1 = fixture: clean | failed-unit | disabled-timer
  local tmp="$2" scen="$1"
  cat > "$tmp/systemctl" <<FAKE
#!/usr/bin/env bash
# fixture systemctl ($scen)
case "\$*" in
  *--failed*)
    if [ "$scen" = "failed-unit" ]; then
      echo "vsf-gates-daily.service loaded failed failed Root \x2fbin\x2fsh"
    fi
    exit 0 ;;
  *is-enabled*)
    if [ "$scen" = "disabled-timer" ]; then
      case "\$*" in
        *vsf-scheduled-suite.timer*) echo "disabled"; exit 1 ;;
      esac
    fi
    echo "enabled"; exit 0 ;;
esac
exit 0
FAKE
  chmod +x "$tmp/systemctl"
}

run_fixture() {
  # $1 = fixture, $2 = expected verdict (pass|red). Returns 0 iff verdict matches.
  local tmp scen="$1" want="$2" out rc
  tmp="$(mktemp -d)" || return 1
  write_fake "$scen" "$tmp"
  out="$(PATH="$tmp:$PATH" "$(readlink -f "$0")" pass 2>&1)"; rc=$?
  rm -rf "$tmp"
  case "$want" in
    pass)
      if [ "$rc" -ne 0 ]; then
        echo "FAIL: clean fixture rejected (rc=$rc): $out" >&2; return 1
      fi ;;
    red)
      if [ "$rc" -eq 0 ]; then
        echo "FAIL: broken fixture accepted (proxy): $scen" >&2; return 1
      fi ;;
  esac
  echo "ok: fixture $scen -> $want"
  return 0
}

if [ "$MODE" = "pass" ]; then
  check_systemd
else
  rc=0
  run_fixture clean pass || rc=1
  run_fixture failed-unit red || rc=1
  run_fixture disabled-timer red || rc=1
  if [ "$rc" -eq 0 ]; then
    echo "PASS: systemd-units-fresh discriminates (3/3 fixtures)"
  else
    echo "FAIL: systemd-units-fresh is a proxy or rejects the clean fixture" >&2
  fi
  exit "$rc"
fi
