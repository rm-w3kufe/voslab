#!/usr/bin/env bash
# CLAIM: G-31 regulation-monitor — boot/regulation_layer.vsm's monitoring
# promise (Invariant -> RegulationLayer -> monitor() -> response) is
# executable and discriminates:
#   pass -> (a) RegulationLayer() registers >= 1 default invariant AND the
#               live workspace reports no VIOLATED invariant; AND
#           (b) fixture: a phantom caution DB (mode=true, expiry in the
#               past) IS rejected (non-zero) — the monitor discriminates a
#               violating state from a healthy one.
#   fail -> a deliberately-false variant: asserts the default layer
#               registers ZERO invariants (must exit non-zero — the claim
#               does not hold; G-31 would be back).
# CWD-independent: derives ROOT from the script location (BASH_SOURCE).
set -u
MODE="${1:-pass}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
while [ ! -d "$ROOT/.git" ] && [ "$ROOT" != "/" ]; do ROOT="$(dirname "$ROOT")"; done
export PYTHONPATH="$ROOT/packages/framework${PYTHONPATH:+:$PYTHONPATH}"

run_monitor() { # $1 = optional db path; prints status lines
  python3 - "$1" <<'PY'
import sys, os
if sys.argv[1]:
    os.environ["VSF_STATE_DB"] = sys.argv[1]
from vos_kernel.regulation import RegulationLayer, InvariantStatus
layer = RegulationLayer()
if not layer._invariants:
    sys.exit(3)  # G-31 regression: empty default layer
results = layer.monitor()
for r in results:
    print(f"  {r.status.value:9s} {r.name} — {r.message}")
sys.exit(1 if any(r.status == InvariantStatus.VIOLATED for r in results) else 0)
PY
}

if [ "$MODE" = "pass" ]; then
  # (a) live workspace: defaults registered, nothing violated
  out="$(run_monitor "" 2>&1)"; rc=$?
  if [ $rc -eq 3 ]; then echo "FAIL: $out"; exit 1; fi
  if [ $rc -ne 0 ]; then echo "FAIL: live violation: $out"; exit 1; fi
  # (b) discrimination: phantom caution must be rejected
  db="$(mktemp -t regulation_monitor.XXXXXX)"
  python3 - "$db" <<'PY'
import sqlite3, sys
conn = sqlite3.connect(sys.argv[1])
conn.execute("CREATE TABLE s5_policy(key TEXT PRIMARY KEY, value TEXT)")
conn.execute("INSERT INTO s5_policy VALUES('s5.caution_mode', 'true')")
conn.execute("INSERT INTO s5_policy VALUES('s5.caution_expires', '2026-01-01T00:00:00Z')")
conn.commit(); conn.close()
PY
  out="$(run_monitor "$db" 2>&1)"; rc=$?
  rm -f "$db"
  if [ $rc -eq 0 ]; then
    echo "FAIL: phantom caution accepted (monitor does not discriminate): $out"
    exit 1
  fi
  echo "regulation-monitor: PASS — live healthy, phantom rejected"
  exit 0
fi

if [ "$MODE" = "fail" ]; then
  # deliberately-false variant: "the default layer registers zero invariants"
  if python3 - <<'PY'
from vos_kernel.regulation import RegulationLayer
import sys
sys.exit(0 if len(RegulationLayer()._invariants) == 0 else 1)
PY
  then
    echo "FAIL: zero-defaults assertion holds — G-31 regression"; exit 1
  fi
  echo "regulation-monitor: OK — zero-defaults assertion does not hold"
  exit 1  # the false claim does not hold (non-zero, as documented)
fi

echo "usage: $0 [pass|fail]"; exit 2
