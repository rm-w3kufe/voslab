⟦ lifecycle_policy | LIFECYCLE-POLICY-01 | vsm-1.2.1 | 2026-09-10T22:11:30Z ⟧

@vsm 1.2.1
@status ratified

// LIFECYCLE POLICY (S5 rmw3, ciclo de vida canonico de archivos).
// Un archivo entra a system/ solo por este camino; docs/ es consultivo.
// ETAPAS: docs(proposed) -> implementacion+verificacion -> canonizacion
// -> system/active -> ratificacion S5 -> archived al superarse.
// FORMULACIÓN VSL: delta(status,evento)->status total; canonizar(doc)
//   <=> instrumento(codigo) ^ mecanismo ^ politica ^ verificacion ^
//   formulacion-VSL-parseable. Sin los cinco, no entra (falla cerrada).
// ARCHIVO: docs/archive/ (historia intacta, nunca borrado).
// ATTESTATION S5 (rmw3): propuesto -> active -> ratified 2026-09-10.
//   Verificado: instrumento scan (117 docs, 0 violaciones), CAT rule,
//   gate classify rc 0, tests verdes. Matiz dotted-names documentado
//   como decisión de estándar pendiente (no bloqueante).
lifecycle_policy: {
  stages: [docs, implement, verify, canonize, ratify, archive],
  gate: "canonizar(doc) <=> instrumento ^ mecanismo ^ politica ^ verificacion ^ vsl-formulable",
  instrument: "scripts/vsl/tools/status_lifecycle.py scan",
}
⟦ /lifecycle_policy ⟧
