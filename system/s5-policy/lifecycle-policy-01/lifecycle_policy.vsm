⟦ lifecycle_policy | LIFECYCLE-POLICY-01 | vsm-1.2.1 | 2026-09-27T23:02:17Z ⟧

@vsm 1.2.1
@status ratified

// LIFECYCLE POLICY (S5 rmw3, canonical file lifecycle).
// A file enters system/ only by this path; docs/ is advisory.
// STAGES: docs(proposed) -> implement+verify -> canonize
// -> system/active -> S5 ratify -> archived when superseded.
// VSL FORMULATION: delta(status,event)->total status; canonize(doc)
//   <=> instrument(code) ^ mechanism ^ policy ^ verification ^
//   VSL-parseable formulation. Without the five, it does not enter
//   (closed failure).
// ARCHIVE: docs/archive/ (history intact, never deleted).
// ATTESTATION S5 (rmw3): proposed -> active -> ratified 2026-09-10.
//   Verified: instrument scan (117 docs, 0 violations), CAT rule,
//   gate classify rc 0, tests green. Dotted-names nuance recorded
//   as a pending standard decision (non-blocking).
lifecycle_policy: {
  stages: [docs, implement, verify, canonize, ratify, archive],
  gate: "canonizar(doc) <=> instrumento ^ mecanismo ^ politica ^ verificacion ^ vsl-formulable",
  instrument: "scripts/vsl/tools/status_lifecycle.py scan",
}
⟦ /lifecycle_policy ⟧
