// ledger op(S5-01).verify.gate flipped in the same commit; see above).

// ─── 0. PRINCIPLE ────────────────────────────────────────────────────────────
principle: "
  damping-only government (throttle, halt) ⟹ impoverished
  S4 := anticipation ∧ adaptation → goals ⟹ viable(V) acts PROACTIVELY
  question ≢ may(machine, actuate)         // it should
  question ≡ AUTHORITY GRADIENT: owner(ends) ▪ owner(means) ▪ earn(autonomy)
             ▪ floor(deterministic)
  R10 was over-applied ⟹ forbade ∀ LLM actuation
    this bounds ONLY the fast safety/reflex path"

// ─── 1. THREE LAYERS ─────────────────────────────────────────────────────────
layers:
  strategy = { owner: human@S5, fixes: ENDS (objective X, identity, value frame),
               loop: double(D4-L3), ratified: ⊤ }
  tactics  = { owner: machine@S4 (incl. LLM), fixes: MEANS (sub-objectives → X),
               loop: single(D4-L2), autonomy: graduated(earned),
               bound_by: [covenant, alignment_audit, escalation_duty] }
  reflex   = { owner: deterministic, fixes: safety (250ms tick, halt),
               loop: reflex, llm: ⊥ (R10), priority: override-all }

  subordination: tactics ⊆ strategy
    // The Marxist discipline, ¬only the metaphor: Lenin's "concrete analysis
    // of the concrete situation" — what an LLM does well — but tactic ⊄
    // strategy ⟹ OPPORTUNISM, the cardinal sin. The three brakes below follow
    // from the discipline, ¬from the figure of speech.

// ─── 2. THREE BRAKES ─────────────────────────────────────────────────────────
brakes:
  B1_alignment_audit = {
    risk:  tactical opportunism — local moves drift from X,
    guard: "S3* measures serves(trajectory, X) INDEPENDENTLY of the LLM
            drift ⟹ α ∧ visible(human)" }
  B2_escalation_duty = {
    risk:  tactic → strategy (X unreachable within covenant ∨ X needs revision),
    guard: "machine SURFACES to human (HiTL); ¬silently Δ(X)   // D4-L3/A5
            (+) machine MAY PROPOSE strategic correction; human disposes
            proposal ≡ inert until ratified" }
  B3_irreversibility = {
    risk:  tactical action with external side-effects,
    guard: "reversible ∧ bounded ⟹ autonomy(per graduation)
            high-commitment ∨ outward-facing ⟹ HiTL ∀ phase" }

// ─── 3. HARD FLOOR vs SOFT TARGET ────────────────────────────────────────────
asymmetry: "
  covenant (cpu_max, memory_max, …) := CRISP ∧ deterministic
    ¬overridable ▪ enforced by S5 watchdog ▪ independent of ∀ LLM output
    ▪ applied to ALL actuation
  serves(tactic, X) := ¬crisp       // the real difficulty of delegation
  ⟹ covenant bounds the SPACE; alignment is EARNED by audit ∧ reversibility,
    ¬assumed. start(reversible ∧ bounded ∧ visible) → grow as the audit proves"

// ─── 4. GRADUATED TACTICAL AUTONOMY ──────────────────────────────────────────
// mirrors the kernel trust law ONE LEVEL UP: the machine earns the human's
// trust per class as kernels earn the system's (EXP-TRUST-01, shared λ, reset
// on breach).
graduated_autonomy: {
  per_class = ⊤            // earned PER class, ¬globally — granular, safer

  phase_1_tutored = {
    behaviour: "machine PROPOSES ∧ RESOLVES; human SUPERVISES (veto ∨ rollback)
                ∀ decision logged ∧ scored by S3*, independent of the LLM",
    measured:  τ_tac ∈ [0,1] per class }

  metric = {         // measured by S3* (deterministic), ¬LLM self-report
    per_decision_score = "covenant_ok ? (0.6·alignment + 0.4·resolution) : 0
      covenant_ok ∈ {0,1}   breach ⟹ score=0 ∧ hard reset
      alignment  ∈ [0,1]    S3*/human-judged service to X — weighted higher:
                            an opportunist well-resolved action harms more than
                            an aligned partial one
      resolution ∈ [0,1]    achieved the sub-objective within covenant
      override   ⟹ score ≤ 0.3         // override ≡ misjudgment"
    accumulation = "τ_tac ← (1−λ)·τ_tac + λ·per_decision_score,  λ = 0.10
                    // the system's shared λ (EXP-TRUST-01), recursed up" }

  graduation_gate = {   // ALL hold, PER class. graduation itself is HiTL
    c1 = τ_tac ≥ 0.90 over last W=20 evaluated     // 0.90 = PSI INT-L1 edge
    c2 = N ≥ 50 evaluated ∧ ≥ 3 distinct situation types
    c3 = zero covenant breaches in window
    c4 = human-override rate < 0.10 in window
    c5 = S5(human) ratifies                        // Δautonomy ≡ policy ⟹ HiTL
    then = phase_2_full }

  phase_2_full = { behaviour: "full tactical autonomy for that class — ∄ per-
    decision approval. covenant ∧ B1 ∧ B2 ∧ B3 ∧ reflex-override REMAIN.
    autonomy(MEANS), never autonomy(ends)" }

  demotion = {         // AUTOMATIC — the fail-safe direction needs ∄ approval
    triggers = [ "covenant breach ⟹ τ_tac ← 0 ∧ demote(tutored)",
                 "τ_tac < 0.79 ⟹ demote(tutored)" ]  // 0.79 = PSI INT-L2 edge
    hysteresis = 0.90↑ / 0.79↓
    asymmetry  = "expand ⟹ HiTL ▪ contract ⟹ AUTOMATIC.  ¬a ratchet" }

  goodhart_caveat = "gameable(τ_tac) ⟹ graduates a machine that LOOKS aligned
    (optimises the number, ¬the end). mitigations:
      (a) covenant ≡ ungameable deterministic floor
      (b) alignment measured by the INDEPENDENT S3*, ¬the LLM
      (c) metric mixes automatic ∧ human-judgment components
      (d) reversibility-by-reflex ≡ last line
    bounds the risk; ∄ elimination" }

// ─── 5. TACTICAL CLASS VOCABULARY ────────────────────────────────────────────
// class := effect + covenant scope + reversibility + phase. NEW ⟹ S5 ratifies.
tactical_classes:
  scale_up       = { effect: raise cpu.weight ∨ activate unit → throughput,
                     reversible: ⊤, phase: tutored }
  scale_down     = { effect: lower cpu.weight → efficiency/headroom,
                     reversible: ⊤, phase: tutored }
  rebalance      = { effect: shift weight between units within total budget,
                     reversible: ⊤, phase: tutored }
  promote        = { effect: raise a unit's standing persistently,
                     reversible: partial, phase: tutored,
                     note: graduates LATER than the reversible trio }
  spawn_external = { effect: launch a process with side-effects beyond the node,
                     reversible: ⊥, phase: HiTL-always }
  acquire_lock   = { effect: take an exclusive external resource,
                     reversible: ⊥, phase: HiTL-always }
  reflex_note    = "survival_mode ∧ s4_throttle ∈ REFLEX — deterministic,
                    ∉ this deliberative layer. unchanged."

// ─── 6. R10 CLARIFICATION (R10.1, canon) ─────────────────────────────────────
r10_clarification: {
  current = "R10: LLM ∈ human-interface synthesis only; signal channels
             (α, φ↑, φ↓, homeostatic loops) deterministic; LLM ∉ any
             latency-critical ∨ safety-critical path."
  clarification = "R10 bounds the REFLEX/fast/safety path (α + the 250ms tick):
    deterministic, ∄ LLM.
    R10 does not forbid LLM ∈ the DELIBERATIVE TACTICAL layer (slow, goal-directed):
      machine@S4 MAY actuate proactively → a human-set X, UNDER
      (i) the deterministic covenant floor ▪ (ii) the S3* alignment audit
      (iii) the escalation duty ▪ (iv) graduated autonomy (tutored → full)
    intent ← LLM.  enforcement ← deterministic, always.
    ⟹ R10's 'safety decisions are deterministic' is preserved."
  ratified = "2026-06-21 (rmw3, S5). state.db rules id=11 (R10.1); R10
              backfilled id=10 in @state_seed; RULES.md synced.
              // verified 2026-08-07: @state_seed:186 ▪ RULES.md:133" }

// ─── 7. COMPLIANCE MAP ───────────────────────────────────────────────────────
compliance: {   // CITATIONS + verdicts against the canon, ¬definitions.
                // Each left id names a canon item stated in boot/.
  D6  = "LLM at S4 (L≥2). OK."
  R10 = "reflex/fast/safety deterministic (held); deliberative tactical
         LLM-permitted under guards (clarified)."
  A5  = "ends ⟹ double-loop/human; tactical autonomy EARNED ∧ revocable;
         strategic proposals HiTL. Held."
  D4  = "D4-L1/D4-L2 ⟹ tactical single-loop (covenant-bounded);
         D4-L3 ⟹ strategy ∨ new class ⟹ human. Held."
  covenant = "hard deterministic floor on ALL actuation, proactive ∨ defensive.
              Defined in boot/covenant.vsm" }

// ─── 8. LICENSE ALIGNMENT (theme D — pre-publication) ────────────────────────
// author: Claude [O] 2026-07-20 (requested by rmw3). Low urgency, HIGH
// importance pre-publication.
license_audit(license_audit) status=SPEC {
  trigger: "rmw3 2026-07-20: aligned with the tools that collaborate?
            discrepancy(third-party) ⟹ contingency: write our own in Rust."

  first_pass: {     // [O] inline inventory, ¬exhaustive
    note: "state-rag-mcp: ZERO runtime deps (pure stdlib) ⟹ zero friction.
           direction: permissive (MIT/Apache/BSD/PSF) → AGPL ok
           converse ⊥: AGPL code ↛ permissively-licensed modules (clean-room)"
    stack: {
      nats-py ▪ nats-server ▪ async-nats   "Apache-2.0 ok"
      tokio "MIT" ▪ serde "MIT/Apache dual" ▪ SQLite "public-domain"
      Python "PSF" ▪ tiktoken "MIT" ▪ Ollama "MIT" ▪ mkdocs "BSD"
      systemd "LGPL (USED, ¬distributed)" ▪ Proxmox "AGPL (same)"
      attention: "MODEL licenses ≻ code copyleft in risk.
                  qwen2.5-coder = Apache-2.0 ok ▪ DeepSeek = model license
                  ⟹ check commercial-use ∧ output terms.
                  These are TERMS OF USE, ¬code copyleft." } }

  audit_formal: {   // [S]/[O] at publication time
    s1 = "cargo license / pip-licenses over each real Cargo.toml + requirements"
    s2 = "classify: permissive | weak-copyleft | strong-copyleft | model-terms"
    s3 = "verify matrix vs AGPL-3.0 (code) ∧ CC-BY-SA-4.0 (docs) ∧ module license"
    s4 = "model-terms: use ▪ outputs ▪ weight redistribution (we ¬redistribute)" }

  rust_contingency: "own instruments in Rust ⟸ the audit finds real friction
    (unlikely — the ecosystem is permissive). Sovereignty is a valid long term;
    the audit precedes it. ¬rewrite by vigilance what has ∄ conflict."

  decision_ceiling: "authority: rmw3.
    State RAG MCP public module: MIT (max adoption) ∨ Apache-2.0 (+ patent grant)
      both → our AGPL ok (we ABSORB module improvements;
      NEVER copy core-AGPL INTO the module)
    module docs: CC-BY-4.0 (more open) ∨ CC-BY-SA-4.0 (share-alike, coherent)
    DECISION: [rmw3]." }

// ─── 9. LEGACY → CLEAN VIABLE-MODULE MIGRATION ───────────────────────────────
// origin: rmw3 2026-06-05. sibling of DSN-COUPLE-01 (onboarding) ∧ R9.
// reference impl: s5-opsroom (LXC 109).
module_migration(module_migration) status=protocol {
  principle: "legacy(component) ↛ migrate by grafting new behaviour onto it —
    that is the concession R9 forbids.
    migrate ≡ REBUILD as a declared ∧ certified ∧ decommissionable viable
    module, then retire the legacy once the clean replacement is live.
    the replacement consumes φ↑ (@connection_schema), never the legacy interface."

  naming: {
    convention: "containers/VMs named for VSM role + function, hostnames
                 lowercase. Ratified 2026-06-05."
    map = {
      "101 nucleus            → s3s4-nucleus (S3 control + S4 intel) + ollama"
      "104 s5-layer           → s5-policy (console / governance / α)"
      "106 vsf-nats-test      → s2-broker (S2 coordination, NATS)"
      "107 vsf-collapsed-poc  → s3star-audit (S3* sporadic audit)"
      "108 vsf-sandbox        → dev-sandbox (∉ Sn — test harness)"
      "109 (new)              → s5-opsroom (view-host) — DONE, reference impl"
      note: "rename(LIVE container) touches hostname ∧ state.db.lxcs.role ∧
             tunnels ∧ services ⟹ a scheduled migration window, ¬bundled
             with a build" } }

  steps: {         // logical gates — ∄ time estimates
    step(1) = rebuild { "a NEW minimal module, ∄ legacy interface as a base;
                         it consumes φ↑ (connection_schema), ¬the old API" }
    step(2) = declare { "an lxcs row (Sn-function name) + a coupling_registry
                         row (kind=phi_channel). status=planned until it has a
                         verifying feed.
                         active declaration ∧ ∄ feed ⟹ ORPHAN under S3* reconcile" }
    step(3) = certify { "the φ↑ feed is AX-STATE-attested; the module VERIFIES
                         it (state_verify, G-V3) before acting.
                         view-contract gates G-V1..G-V4: version ▪ conformance
                         ▪ attestation ▪ declaration" }
    step(4) = cutover { "live ∧ certified ⟹ retire the legacy: stop the service,
                         remove its repo source, set coupling_registry/lxcs rows
                         deprecated ∨ delete.
                         NEVER decommission BEFORE the replacement is verified live" } }

  reference_impl: {         // s5-opsroom (LXC 109), ¬legacy opsroom/api.py
    what: "subscribes to NATS φ↑ (vsf.alpha.view.*, vsf.alpha.attest.*), verifies
           the upstream source attestation (state_verify), serves the panel
           scaffold + module registry over minimal WS/SSE.
           Hosts view-module #1 = cybernetic-rag."
    φ↑_wiring: "canonical φ↑ ≡ nucleus events.jsonl (FILE, Merkle-chained per
           connection_schema — ¬NATS). Nucleus telemetry dir bind-mounted:
           RW → 101 (at the nucleus's own path, ∄ code change) ∧
           RO → 109 (/mnt/telemetry).
           View-host reads the tail (seek, ¬full scan; UTF-8-tolerant;
           window > the 60s sampler), verifies the chain, projects.
           These mounts are pct config — THIS DOC is their traceability record."
    cutover: "SCADA on 101 (:8080) decommissioned once 109 served BOTH modules
           certified: service stopped ∧ disabled ∧ removed, /opt/vsf/opsroom
           deleted, opsroom/ reduced to view_host/ + modules/, :8080 tunnel
           retired (opsroom is now :8088). Nucleus on 101 unaffected (separate
           proc). ≡ step(4) executed." }

  what_is_not: [
    "¬a rewrite-everything-now mandate — INCREMENTAL, one module at a time,
     legacy kept alive until its replacement is certified",
    "¬coupled to a framework choice — the view-host is vanilla; the discipline
     is the certified φ↑ contract ∧ declaration, ¬the rendering tech" ]

  next: [
    "formal audit (license_audit §audit_formal) at publication time",
    "graduated autonomy wiring [Sonnet]: Phase 1 tutored mode + S3* alignment audit
     + the tactical class vocabulary against the deterministic actuation path
     (ac_classifier → response_classes → phi_down_subscriber.rs),
     after claude_review of this core" ] }

