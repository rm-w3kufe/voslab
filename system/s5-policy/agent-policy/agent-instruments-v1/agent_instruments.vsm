⟦ agent_instruments | AGENT-INSTRUMENTS-v1 | vsm-1.2.1 | 2026-09-07T22:22:39Z ⟧

@vsm 1.2.1
@status active
// system/s5-policy/agent-policy/agent-instruments-v1/agent_instruments.vsm — SHARED ORGANELLES.
// The upper recursion shares its instruments: each has an owner (the organ
// that operates it) and a role (the cybernetic capacity it materializes).
// This census avoids duplicating organs per agent (A6 — variety spent on
// duplicating = variety not spent on controlling).

map(AGENT-INSTRUMENTS) {

  instruments: [
    // ── GATE (S3 — control with veto) ──
    inst("gate", role="S3 veto", owner="S3 planner",
      substrate=".opencode/plugins/vsf-agent-vsl-gate.ts",
      desc="the ONLY mechanism with veto in the boot — enforces R15 (inter-agent VSL)",
      design_source=@src_relocate_gate),

    // ── CHECKS (R4.1 — verification) ──
    inst("checks", role="S3* verification", owner="S3 planner",
      substrate="checks/ (dir-schema-valid, boot-ontology-clean, learning-record-valid, write-gates-valid, …)",
      desc="every claim with machine-checkable verification; R4.1 gate in commit-msg"),

    // ── WRITE-TIME GATES (registry + orchestrator — R18/CLASSIFICATION) ──
    inst("write-gates", role="S3* verify at write", owner="S3 planner",
      substrate=@doc_write_gates,
      desc="declarative registry of every write-time gate; the daemon runs
            the orchestrator which executes gates INDEPENDENTLY and labels
            each cause — ADD a policy = register a gate, never edit the
            daemon (lesson DAEMON-GATE-AFTER-EARLY-EXIT-2026-08-17)"),

    // ── RELOCATE (S2 — coordination) ──
    inst("relocate", role="S2 coordinate", owner="S3 planner",
      substrate=".opencode/plugins/vsl-relocate-on-write.ts",
      desc="prevents footguns when moving docs @vsm 1.0",
      design_source=@src_relocate_vsm),

    // ── MCP servers (state — canonical query) ──
    inst("state-canon", role="S3 query", owner="S3 planner",
      substrate="state-canon-mcp (tasks · focus · journal)",
      desc="do NOT ask it for services/rules (domain retracted R7)"),
    inst("state-canon-infra", role="S3 infra query", owner="S3 planner",
      substrate="state-canon-infra-mcp (services · lxcs · chains — n02 state.db)",
      desc="the queryable infrastructure; R7: state.db wins"),

    // ── STATE (the operational truth) ──
    inst("state", role="S3 state", owner="S3 planner",
      substrate="state.db on n02",
      desc="live state: services, chains, lxcs, topology — NOT rules (R7)"),

    // ── MANIFEST (the boot's memory) ──
    inst("manifest", role="S5 memory", owner="S5 rmw3",
      substrate=@doc_boot_manifest,
      desc="every boot artifact with role and hash; agents and plugins cited"),
  ],

  // ── ACTIVATION LOG — S5 decision 2026-09-30 (FND-AGENT-LOG-SCHEMA-DRIFT-01) ──
  // The LIVE schema is canonical (the instrument/hook names were the
  // pre-rename taxonomy; the writers have been stable since). Instruments
  // are declared here as plugin SOURCES; the validator runs at every
  // session.idle and reads current + rotated logs (a source that never
  // fires = dead plugin — learning-cycle-scan lesson).
  activation_log: {
    file: "logs/agent_plugin.jsonl (JSONL append-only, size-rotated .jsonl.<epoch>.jsonl.gz)",
    canonical_fields: "ts pid source event_type action result",
    optional_fields: "detail context level event_id",
    ts_format: "ISO 8601 UTC with explicit offset — Z (TS writers) | +00:00 (python writers)",
    organ_map: "gate->GATE; write-gates->gate-suite sources (vsl-check-on-write and friends); relocate->CLASSIFY; idle handlers->own source name; state-canon, state-canon-infra, state, manifest never write this log (attested via boot_manifest/staleness instead)",
    declared_sources: "tool-integration rsi-cycle event-router GATE gap-resolution vsl-check-on-write attestation session-hygiene lifecycle-reporting hook-analytics scripts-automation governance cyberfilter scenario-memory state-reconcile tasks-maintenance core-scripts services shared learning-cycle",
    validator: "scripts/state/attestation/check_agent_log.py <log> <declared_sources>",
  },
}
⟦ /agent_instruments ⟧