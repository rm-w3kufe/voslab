      desc="measures the file state BEFORE the edit (PreToolUse)",
      manifest="boot_manifest layer L_MEASURE_CHECK (declared)"),
    plugin("vsl-relocate-on-write.ts", role="S2 relocate",
      substrate=".opencode/plugins/",
      desc="automatic relocation @vsm 1.0 (RELOCATE-VSM-SPEC, promoted A5)",
      manifest="boot_manifest layer L_MEASURE_CHECK (declared 2026-08-15 — it was the only absent one)"),
