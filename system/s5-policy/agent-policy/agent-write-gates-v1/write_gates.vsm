@vsm 1.2.1
@status active
// system/s5-policy/agent-policy/agent-write-gates-v1/write_gates.vsm — THE WRITE-TIME GATE
// REGISTRY. Declarative source of truth for every conformance gate that
// runs on a .vsm write (R18 write-time conformance, CLASSIFICATION
// questionnaire, future gates: R16, D7, …).
//
// WHY (2026-08-17, lesson DAEMON-GATE-AFTER-EARLY-EXIT): gates used to be
// injected ad-hoc into the daemon script (vsl-check-on-write). Each new
// policy collided with the base flow (early-exit kills the gate), with the
// observer's label (generic [DEMONIO R18] hid the real cause), and with
// the scope (corpus scan per write instead of per-file). The fix is
// STRUCTURAL, not per-gate:
//   - the REGISTRY declares the contract of every gate (command, mode,
//     label, blocker/advisory, owner)
//   - the ORCHESTRATOR (scripts/vsl/tools/write_gate_orchestrator.py) reads the
//     registry, runs each gate INDEPENDENTLY (no gate depends on another
//     gate's exit code), aggregates results, and labels the CAUSE
//   - ADDING a policy = registering a gate, never editing the daemon
// The daemon script keeps only input guards + the orchestrator call.
//
// CONTRACT each gate must honor:
//   cmd         — executable + args template; the file path is appended as
//                 the last argument ($path)
//   mode        — per-file | corpus. per-file = O(1) verification of ONE
//                 doc at write time (R18 latency). corpus = full scan
//                 (only for commit-time gates; write-time MUST be per-file)
//   label       — the [DEMONIO <label>] tag the orchestrator emits when
//                 this gate blocks. MUST be the cause, not a generic class.
//   block_on    — "nonzero" (any exit != 0 blocks) | "contains:<marker>"
//                 (block only when the marker appears in output — for
//                 gates whose exit 1 is split between blocking and
//                 advisory, e.g. check.py grammar vs R18 version)
//   advisory    — if true, the gate's failure is reported but does NOT
//                 block (mid-flight state is legitimate)
//   owner       — the organ that operates the gate (S3*/S3/S2…)
//   desc        — what the gate enforces

map(AGENT-WRITE-GATES) {

  gates: [

    // ── R18 conformance (grammar + encoding + structure + version) ──
    // check.py exits 1 for grammar (mid-flight = advisory) AND version
    // (R18-BLOCK = policy breach). block_on contains:R18-BLOCK separates
    // the two: only a version violation blocks write-time; grammar is
    // advisory while the doc is legitimately half-written.
    gate("r18-conformance") {
      cmd: "python3 scripts/vsl/validator/check.py",
      mode: per-file,
      label: "R18",
      block_on: "contains:R18-BLOCK",
      advisory: false,
      owner: "S3* auditor",
      desc: "R18 write-time conformance — edited doc must be at canonical protocol version (vsm-1.2.1); a version violation emits R18-BLOCK and BLOCKS. Grammar/encoding mid-flight (exit 1 without R18-BLOCK) is reported but does NOT block (advisory by the gate's block_on)",
    },

    // ── CLASSIFICATION questionnaire (PART II, CLASSIFICATION-POLICY-PLAN) ──
    // checks/classification-valid check-file <path> is O(1): reads the
    // header type of ONE file, no corpus scan. A doc in the wrong
    // directory blocks (policy breach); design-in-validation (sandbox/,
    // spec/ pending migration) is advisory by the check's own rules.
    gate("classification") {
      cmd: "checks/classification-valid check-file",
      mode: per-file,
      label: "CLASSIFICATION",
      block_on: "nonzero",
      advisory: false,
      owner: "S3* auditor",
      desc: "PART II questionnaire — doc's declared nature must resolve to its canonical directory (classification_policy_plan.vsm)",
    },

    // ── SOCRATIC-CLASSIFY questionnaire (PLUGIN-CLASS-TAXONOMY-v1, fase c) ──
    // The socratic engine ITSELF as a write-time gate (write-time universal):
    // the CLASSIFY tree (classify.tree.vsm) is evaluated against the doc's
    // TYPE; the answer (home) is compared with the file's REAL directory.
    // A mismatch blocks (policy breach). UNKNOWN (no TYPE readable) does NOT
    // block — reports '?' visibly (R9: no silent concession). R10: the
    // engine decides with structural evidence (certified), never opinion.
    gate("socratic-classify") {
      cmd: "python3 scripts/vsl/classifier/socratic_gate.py",
      mode: per-file,
      label: "SOCRATIC-CLASSIFY",
      block_on: "nonzero",
      advisory: false,
      owner: "S3* auditor",
      desc: "SOCRATIC questionnaire IS the gate — CLASSIFY tree vs real dir; UNKNOWN advisory (R9), mismatch blocks",
    },

    // ── future gates register HERE — never edit the daemon ──
  ],
}
⟦ /write_gates ⟧