@vsm 1.2.1
@status ratified
// s5-policy/vsl-language/definitions_core.vsm — core definitions D5-D13 + D11b.
// Source: vsl_language §2 definitions. Item of the reference set.
// OPERATIONAL tier (D1-D13): what the running system does — kernel-facing.
// D1-D4, D9, D11 stay in boot/vsl_language_primer.vsm core_defs — NOT re-stated.
// D14-D21 → definitions_theory.vsm (addendum 2026-05-09), NOT here.

definitions_core("VSL-LANG-DEFS-CORE") {

  definitions_core: "
    D5 recursion_condition:
                     is_viable(u) = True iff complexity(u) > τ_viability
                       // τ set by parent S3 in params.json
                     is_viable(u) = False → execute_atomic(u)

    D6 LLM_constraint:
                     S4(L).uses_LLM = True only_if L ≥ L_min    L_min = 2
                       // ∄ LLM at L0/L1 — those levels are deterministic.
                       // LIFESTATUS: CORRECTED 2026-08-07 — read 'L ≤ L_max, L_max = 2',
                       // which permits exactly the two levels D6 forbids.
                       // CANON lists FOUR independent sources agreeing on ≥,
                       // plus the running kernel: docs/archive/theory_2026-10-30/plan_status_2026-05-25.md,
                       // information_flow_architecture, per_system_requirements
                       // _method, cybernetic_rag_retrofit ('ollama @ S4, L≥2
                       // per D6'), and s4_operational.rs:844 ('Do NOT recommend
                       // L0/L1 actions directly — advisory to S3 only').

    D6.tactical inference_bands (ADOPTED 2026-08-10, rmw3 S5):
                       // D6 governs the SPEED CHANNEL. D6.tactical: a system
                       // at L ≥ 2 carries TWO BANDS inside S4; the constraint
                       // differs by BAND, not by level alone. rmw3 widened the
                       // ruling past the LLM — 'other techniques that could
                       // fall in the tactical band and not necessarily in the
                       // speed channel, such as learned patterns, ML, etc.'
                       // (original note in ES; D7 exempts the covenant, not notes).
                       band(reflex) ⊨ deterministic ∀ L
                         reflex ▪ fast-path ▪ safety interlock ▪ Ω-gate
                         ∄ inference of ANY kind. not LLM, not ML, not learned mode.
                         REASON: reproducible + auditable tick-for-tick;
                         non-determinism here = unbounded latency on a
                         path that arbitrates safety.
                       band(deliberative_tactical) ⊨ inference PERMITTED,
                         only_if L ≥ L_min ∧ guarded
                         admits: LLM ▪ ML ▪ learned modes ▪ any
                         non-deterministic proposer
                         ROLE: it PROPOSES. never arbitrates the reflex
                         band, never signs a φ↓ action on its own.
                         guards ≜ @s5_policy_core §graduated_autonomy — CITED,
                          not restated: phase_1_tutored → graduation_gate c1..c5
                          → phase_2_full, per CLASS, scored by S3* DETERMIN-
                          ISTICALLY, not by the proposer's self-report. Plus B1
                         ▪ B2 ▪ B3_irreversibility + reflex-override.
                       TO IMPLEMENT, a band must declare: band | technique
                          (by name, ∄ 'AI') | class | arbiter (always
                          deterministic, not the proposer) | override.
                         A component that cannot name its arbiter is in the
                         reflex band by default.
                       OPEN: learned_modes.rs (535 LOC, 15th unmamed kernel
                         module) is a deliberative_tactical proposer with ∄
                         declared band/class/arbiter — PH-14 maps it.

    D7 opsroom:      opsroom(V(id,L)) = {
                       view[\"system_health\"]    ≡ S3(L).audit,
                       view[\"pipeline_status\"]  ≡ S1(L).operations,
                       view[\"signal_queue\"]     ≡ S2(L).unresolved,
                       view[\"priority_ranking\"] ≡ S4(L).environment,
                       view[\"coverage_gaps\"]    ≡ S3(L) → S4(L) }

    D8 signal_priority:
                     urgency(s) ∈ { CRITICAL, HIGH, MEDIUM, LOW }
                     urgency(s) = f( impact_budget, impact_stability, model_drift )
                     s.status ∈ { pending, resolved, undecidable, deferred }
                       // only CRITICAL+HIGH in opsroom Signal Queue (A8)

    D10 incompleteness:
                     resolve(s,V) = ∅ ⟹ s.status = undecidable
                     rule(S3(L), guard=s.status=undecidable):
                       if urgency(s) > τ_L: s ⟹ φ↑(s)      // A7
                       else: s.status = deferred
                     // |deferred|/|total| > μ ∧ CalibScore < 0.7 → meta_shift (D12)

    D11b trust_formula:
                     governed(x) = has(params(x)) ∧ emits(events(x))
                     trust_level ∈ { none→forbid_ψ, limited→ψ_restricted,
                                     trusted→ψ_full }
                     T(V,t) = 0.6·decay(T(V,t−1),λ) + 0.4·audit(V,t)
                     audit(V,t) = (0.5·reachability + 0.3·stability(S3)
                                   + 0.2·(1−drift)) · (1−error_rate(S2))
                      // LIFESTATUS: SUPERSEDED BY D17, not implemented: the 0.6/0.4 blend
                     // appears nowhere in the kernel. What runs is D17's EMA
                     // (trust_axes.rs::update). Kept: audit(V,t) composition
                     // IS the live observation term; the outer blend is
                     // history. λ ∈ S5.policy; VSF instantiates ONE shared
                     // entropy-adaptive λ = 0.10·(1+|ΔH|/H_max) ∈ [0.05,0.20].
                      // S3* owns trust computation (not S4 — conflict of interest);
                     // missing history → conservative_default.
                     // rule(S5(L), guard=configure(S5(L+1), λ) ∧ per_level(λ)):
                     //   λ(L+1) ≥ λ(L) → single_loop; λ(L+1) < λ(L) →
                     //   policy_drift ∘ require(S5(L).approve)
                     // Q-vsf-13 CONDITIONAL (2026-08-04): binds only per-level;
                     // VSF shared λ ⟹ vacuous here.
                     rotate(V.credential): provision(new) → ψ.add_channel(new)
                       → wait_telemetry(new) → revoke(old)
                     rule(S3*(L), guard=V_peer.status ∈ {deprecated,compromised,
                                                          unhealthy}):
                       trust_score(V_peer)=0 ∘ terminate(ψ) ∘ log(S2.access_log)
                     rule(S4[\"ψ\"], guard=incoming(ψ,V_B)):
                       import V_B.env_model → sandbox(S4); trust≥trusted →
                       integrate: sandbox → env_model

    D12 meta_shift:  meta_shift(V(L)) = True iff:
                       (∃ class(Sig): ∀ s∈class(Sig): resolve(s,V(L))=∅)
                       ∧ |class(Sig)|/|Sig_total| > μ ∧ CalibScore(V(L),t) < 0.7
                       for t>δ
                     rule(S4[\"meta\"], guard=meta_shift):
                       low:    μ<0.2 ∧ CalibScore>0.6  → log
                       medium: μ<0.5 ∧ CalibScore>0.5  → opsroom_signal_queue
                       high:   μ≥0.5 ∨ CalibScore≤0.5  → φ↑(urgency=CRITICAL)
                     rule(S5[\"meta\"]): enforce no_auto_reframe
                       // reframe() always double-loop (D4)

    D13 structural_safety:
                     rule(S5): enforce: max_recursion_depth | promotion_budget_limit
                       | ψ_rate_limit | no_circular_trust | no_unbounded_growth
                     absorption_rate(L) = |Sig_resolved(L)| / |Sig_total(L)|  // S3* tick
                     rule(S4(L), guard=promote(x, E→V)):
                       count(S1.units) > max_manageable_units(L)
                         → resolve(promotion)=∅ ∘ φ↑(HIGH,\"Variety_Overload\")
                     resistance(V) = combine( system_size(V), coupling_degree(V) )
                        // ¬⊕: that glyph is declared for VARIETY combination
                        // (A6/Ashby) — size/coupling are not varieties.
                     rule(S3[\"inertia\"], guard=single_loop_structural_op):
                       require: Δstructure > threshold_inertia(V)  // S5 tunes
                     rule(S3*[\"audit\"]): log: ψ_events | reframe_attempts |
                       promotion_events | rejections",
}
⟦ /definitions_core ⟧