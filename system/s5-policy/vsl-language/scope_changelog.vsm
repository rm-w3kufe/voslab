// s5-policy/vsl-language/scope_changelog.vsm — §21 scope + §22 changelog.
// Source: vsl_language §21 + §22. Item of the reference set (provenance).

scope_changelog("VSL-LANG-SCOPE-CHANGELOG") {

  scope: "
    this doc = the notation, axioms, grammar, types, validation, execution
      semantics, and language-level primitives (event/condition, envelope,
      norm, response-class, PSI, VSI, standardization, encyclopedia).
    protocol VALUES (thresholds, calibrated numbers, ratified classes) live in
      their branch docs (s3, s5-policy, s2) — referenced, not duplicated here.
    promotion (addendum → STABLE): ≥1 independent peer review ▪ ≥3 .vsm files
      using new primitives compile-validated ▪ no semantic conflict with A1-D13
      ▪ CHANGELOG approved by rmw3 (S5).",

  changelog: "
    v1.0 (2026-04-18): +Part XI file grammar, +Part XII types, +Part XIII
      validation/stability, +@vsl_parser (C2). closes task(T) C1-C6
    v0.4 (2026-04-18): +Part X M2M mode, domain_context, drift metrics,
      extension table
    v0.3 (2026-04-13): +A9/A9b/c/d, A10, A11; D11b trust + reachability
    v0.2 (2026-04-08): +L-relativity, D4 refined, D10/D11/D11b/D12, tick(L),
      reframe()
    v1.1 (DRAFT 2026-05-09 addendum): +A12-A15, +D14-D21, +T1/C1-C6,
      +IV.c extensions (watermark/inquiry/response/gap, Ax_/Def_/Thm_/Cor_/
      Lemma_ decls). backwards-compatible 100%.
    fused into this doc: 2026-08-06 (PH-01 META draft, gate claude_review)",
}
