⟦ norm_response_class | VSL-LANG-NORM-RESPONSE-CLASS-v1.0 | vsm-1.2.1 | 2026-09-07T22:22:39Z ⟧

@vsm 1.2.1
@status ratified
// s5-policy/vsl-language/norm_response_class.vsm — the two D4-L2 contract
// primitives: norm() operating region + response_class() pre-authorized S3
// responses. Sources: vsl_language §15 (norm.vsm F3.a) + §16
// (response_classes.vsm F3.b). Items of the reference set.
// Writing core: boot/vsl_language_primer.vsm.

norm_response_class("VSL-LANG-NORM-RESPONSE-CLASS") {

  norm: "
    norm(ID) = {           // agreed operating region R ⊂ Ω (Beer plan-vs-actual)
      version, applies_to, read_by[]
      <metric>_region: { nominal_min, warn_below, critical_below, basin_floor,
                         critical_angle }
      regime:    { nominal: \"in_recurrent_set\", viable_full: bool }
      invariants:{ consec_warn_max, magnitude_max }
      deviation_protocol: outside R → classify B/A → s5-alerts.db → SD/human
    }
    // inside R = nominal (class C); leaving R = deviation (B monitor / A escalate)
    // changing any bound = D4-L3 double-loop (S5 ratification each time)
    // classifiers read THIS file, not hardcoded thresholds.
    // instance: norm(\"vsf-alpha-R1\") — values live in branch docs (s3), not here",

  response_class: "
    response_class(ID) {  // D4-L2 pre-authorized S3 responses, not real-time S5
      tier     ∈ { D4-L1 kernel-auto, D4-L2 THIS, D4-L3 human-gate }
      trigger, action, scope, rollback, audit, rationale, status
      // scope declares the EXACT config surface touched (not more)
      // rollback auto-reversible; prohibited list explicit
    }
    // wiring gate: status MUST be ratified before any class wires into
    // ac_algedonic.py / phi_down_subscriber.rs. new class = new session +
    // S5 decision (A5). instance: response_classes(\"vsf-alpha-RC1\") — 4
    // ratified classes live in branch docs (s3), not here",
}
⟦ /norm_response_class ⟧