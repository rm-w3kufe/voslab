⟦ vsl_language_index | VSL-LANGUAGE-index-v1.0 | vsm-1.2.1 | 2026-09-07T22:22:39Z ⟧

@vsm 1.2.1
@status ratified
// s5-policy/vsl-language/index.vsm — MANIFEST of the vsl_language reference set
// STATUS: canon (promoted 2026-08-13, S5 go; was rmw3 sandbox proposal).
// TOKEN-COUNT METHOD (R1, reconciled 2026-08-12): tiktoken cl100k_base
//   (python3 -c 'import tiktoken; enc=tiktoken.get_encoding("cl100k_base")').
//   canon 24,374 tok ▪ primer 4,899 tok (-79.9%) ▪ this set 13,809 tok;
//   primer+set vs canon = -23.2%. est_tok fields below = measured, method-anchored.
// Relation: the WRITING CORE lives in boot/vsl_language_primer.vsm (4,899 tok,
//   -79.9% vs the 24,374-tok original). The NON-writing items of vsl_language.vsm
//   split here into per-item files — each small, each readable on demand.
// NO-DUPLICATION: every statement already declared elsewhere (primer, boot,
//   this set) is CITED by name, not re-stated. Each enunciado lives in ONE file.
// HOME: docs/spec_revision/system/s5-policy/vsl-language/ (promoted from the
//   child sandbox 2026-08-13).
// Source (historical): docs/spec_revision/system/boot/vsl_language.vsm — DELETED
//   2026-08-13 on promotion (S5 replace-total decision); see git history.

vsl_language_index("VSL-LANGUAGE-index-v0.1") {

  purpose: "
    reader: agent needing a NON-writing item of vsl_language (validators,
      kernel/runtime work, provenance). The WRITING agent reads only the primer.
    gives:  item → file map ▪ per-file content summary ▪ source section refs ▪
            size estimates ▪ dependency order.
    does not give: the writing core (→ boot/vsl_language_primer.vsm)
            substrate, A1-A11, tick, channels, trust (→ boot/core_boot_primer.vsm)
            A0, A0.1 (→ boot/covenant.vsm) ▪ regulation (→ boot/regulation_layer.vsm)",

  // ═══ FILE TREE — one item, one file, snake_case per s5-policy convention ═══
  // MERGED 2026-08-12 (smallest review unit): §10+§11 → memory_machine.vsm;
  //   §12+§14 → comms_extension.vsm; §15+§16 → norm_response_class.vsm;
  //   definitions split core/theory (not single 3.5K-tok file).
  tree: "
    s5-policy/vsl-language/
      index.vsm                 ← THIS manifest
      axioms_extension.vsm      ← A12-A15 only (A1-A11 ≡ primer, NOT re-stated)
      definitions_core.vsm      ← D5-D13 + D11b (D1-D4, D9, D11 in primer core_defs)
      definitions_theory.vsm    ← D14-D21 addendum (theory proofs consume these)
      validation_gates.vsm      ← §7b gates + not covers (C1/C5/C6 stay in primer)
      memory_machine.vsm        ← §10 memory examples + §11 machine directives
      comms_extension.vsm       ← §12 B_full/B_schema + §14 P2 crypto
      norm_response_class.vsm   ← §15 norm + §16 response_class primitives
      psi_protocol.vsm          ← §17 PSI + INT-Ln ladder
      vsi_protocol.vsm          ← §18 VSI + VSI-Ln layers
      standardization.vsm       ← §19 (status_enum stays in primer; tooling here)
      encyclopedia.vsm          ← §20 encyclopedia build spec
      execution_reframe.vsm     ← §8 reframe() only (tick ≡ primer.tick, skipped)
      scope_changelog.vsm       ← §21 scope + §22 changelog (provenance)
    // total 14 files, each 0.2K-1.1K tok → smallest unit of review.",

  // ═══ ITEM MAP — content contract per file ═══
  items: [
    item(axioms_extension) = {
      source: "vsl_language.axioms — A12..A15 only",
      content: "A12 hardware_ceiling ▪ A13 recurrent_set ▪ A14 ψ_preservation ▪ A15 Ω_closure",
      dep: "core_boot_primer (A1-A11 declared there — cite, not copy)",
      est_tok: "680 (measured)",
      note: "axioms_A1-A11 deliberately ABSENT — the primer owns them.",
    },
    item(definitions_core) = {
      source: "vsl_language.definitions — D5..D13 + D11b",
      content: "D5 recursion_condition ▪ D6 LLM_constraint + tactical bands ▪ D7 opsroom ▪
        D8 signal_priority ▪ D10 incompleteness ▪ D11b trust_formula ▪ D12 meta_shift ▪
        D13 structural_safety",
      dep: "primer core_defs (D1-D4, D9, D11)",
      est_tok: "1,847 (measured)",
      note: "D14-D21 live in definitions_theory.vsm — addendum, theory-facing.",
    },
    item(definitions_theory) = {
      source: "vsl_language.definitions — addendum 2026-05-09 (D14..D21)",
      content: "D14 split_operator ▪ D15 softmax_mixing ▪ D16 adaptive_τ ▪ D17 trust_vector ▪
        D18 reframe_staged ▪ D19 VR_complex ▪ D20 lyapunov_filtration ▪ D21 seqlock_σ",
      dep: "definitions_core (D5-D13) + primer core_defs",
      est_tok: "1,368 (measured)",
      note: "consumed by theory/ proofs (composition_proof, dynamics_choice, vos_proofs).",
    },
    item(validation_gates) = {
      source: "vsl_language.gates",
      content: "encoding ▪ closure ▪ staleness ▪ covenant ▪ symbols ▪ grammar gates + not covers + waives",
      dep: "primer validation (C1/C5/C6)",
      est_tok: "793 (measured)",
      note: "for validator operators; writers need only C1/C5/C6 (primer).",
    },
    item(memory_machine) = {
      source: "vsl_language.memory + machine (merged §10+§11)",
      content: "rule()/semantic()/V() encoding examples + machine directives list
        (read @vsm first, axioms hard, order S5>S3>S1…)",
      dep: "primer grammar + core_defs",
      est_tok: "449 (measured)",
      note: "two ~0.3-0.6K items merged → one ~0.9K file, fewer hops.",
    },
    item(comms_extension) = {
      source: "vsl_language.m2m + envelope-P2 (merged §12+§14)",
      content: "B_full vs B_schema ▪ domain_context ▪ drift metrics ▪ compression measurement
        ▪ signature scaling ▪ deterministic signer tool ▪ verification on receipt ▪
        delivery hazard ▪ invariants (R13/R10/S3*)",
      dep: "primer comms + envelope (minimal form)",
      est_tok: "817 (measured)",
      note: "two ~0.5K items merged; both are OPTIONAL extensions beyond the minimal
        envelope/message forms that the primer owns.",
    },
    item(norm_response_class) = {
      source: "vsl_language.norm + response_class (merged §15+§16)",
      content: "norm(ID) operating-region primitive + deviation protocol ▪
        response_class(ID) pre-authorized S3 response primitive",
      dep: "∅",
      est_tok: "562 (measured)",
      note: "two ~0.2K contract primitives merged — both are D4-L2 speech acts.",
    },
    item(psi_protocol) = {
      source: "vsl_language.PSI",
      content: "PSI purpose ▪ θ_PSI ▪ trigger ▪ INT-L1/L2/L3 ▪ fail_safe ladder ▪ angustia signal",
      dep: "primer (D4-Ln, A5, A0.1) — cited",
      est_tok: "953 (measured)",
    },
    item(vsi_protocol) = {
      source: "vsl_language.VSI",
      content: "VSI-L1..L4 ▪ sequence ▪ preconditions P_* ▪ security map ▪ hooks",
      dep: "primer (VSI-Ln namespace) + norm",
      est_tok: "1,101 (measured)",
    },
    item(standardization) = {
      source: "vsl_language.standardization — tooling part",
      content: "single_source ▪ task() grammar ▪ validator/reconcile ▪ session_end_hook ▪ memory_index",
      dep: "primer status_enum (stays there)",
      est_tok: "425 (measured)",
    },
    item(encyclopedia) = {
      source: "vsl_language.encyclopedia",
      content: "purpose ▪ D1-D5 ▪ architecture ▪ entry_schema ▪ reconciler checks ▪ build ▪ taxonomy",
      dep: "∅",
      est_tok: "848 (measured)",
    },
    item(execution_reframe) = {
      source: "vsl_language.execution — reframe() only",
      content: "reframe(V, new_parent) 4-step procedure (tick ≡ primer.tick → omitted)",
      dep: "core_boot_primer.tick",
      est_tok: "296 (measured)",
    },
    item(scope_changelog) = {
      source: "vsl_language.scope + changelog",
      content: "scope statement ▪ v0.2→v1.1 changelog provenance",
      dep: "∅",
      est_tok: "560 (measured)",
    },
  ],

  // ═══ VALIDATION GATE ═══
  gate: "
    pass ⟺ all files: tokenizer --check ✓ ▪ verify_encoding ✓ ▪ vslline 9/9 ▪
      symbol_table 0 undeclared ▪ @status proposed ▪ R_ref_resolution clean ▪
      + each file < ~1.2K tok (readable in one shot).
    // measured 2026-08-12 (tiktoken cl100k_base): index 2,363 tok ·
    // definitions_core 1,847 tok · definitions_theory 1,368 tok — ALL OTHER
    // 11 files < 1,200 tok.
    // Reference-dictionary exemption (as in original D5-D21 note): definitions_*
    // + index are DIRECTORIES, not boot reads; over-1.2K is acceptable there,
    // the split already halved the original single 3.5K definitions file.",
}
⟦ /vsl_language_index ⟧
