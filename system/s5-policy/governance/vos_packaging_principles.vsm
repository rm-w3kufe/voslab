⟦ vos_packaging_principles | BINDING-PRINCIPLES-v1 | vsm-1.2.1 | 2026-10-14T20:48:39Z ⟧

@vsm 1.2.1
@status active

@binding user(rmw3 S5) 2026-08-29  // overrides prior packaging assumptions

// BINDING — corrections to the vOSLAB packaging model, imposed by rmw3 (S5)
// 2026-08-29. Persisted as canon so it survives context compaction (read
// directly + via IR + TASKS/HANDOFF refs). These are NON-NEGOTIABLE.

principle("P1-socratic-engine-on-pypi") = {
  body: "socratic-engine is published on PyPI (https://pypi.org/project/socratic-engine/).
         It is a normal PyPI dependency, NOT a local sibling/git workaround.",
  apply: "Declare socratic-engine in pyproject [project.dependencies] of any package
          that needs it. No git-sibling bootstrap for it.",
}

principle("P2-rsi-single-package") = {
  body: "RSI is ONE public package: vsf-rsi. NO vsf-rsi-core vs vsf-rsi-vsf split.
         vsf-rsi HARD-depends on socratic-engine — it is RSI's recursive engine; RSI
         has no purpose without it. The .vsm format of generated artifacts is
         irrelevant if the engine parses them.",
  apply: "Build a single vsf-rsi package. The earlier vsf-rsi-core (metrics+GA only,
          'agnostic') was the hole — DELETED. Validate end-to-end: generate tree ->
          evaluate via socratic-engine -> evolve via GA -> improvement on a metric.",
}

principle("P3-agnosticism-scope") = {
  body: "Agnosticism = NO leak of VSM/VSF governance (covenant, S5, ontological/
         grammatical hardness, vsf-specific paths). It does NOT mean our own tools are
         independent: state-canon-mcp, socratic-engine, vsf-rsi legitimately depend on
         each other and declare HARD deps on each other.",
  apply: "De-VS only vsf-governance specifics. KEEP and DECLARE tool-to-tool deps
          (socratic-engine, state-canon-mcp). Never strip a package's real engine.",
}

principle("P4-no-orphans") = {
  body: "No script or plugin in ~/vsf may be left without a home in a vOSLAB package.",
  apply: "Completeness audit: enumerate every scripts/** and .opencode/plugins/** and
          map each to exactly one package. Gaps => new package or build-from-scratch.",
  gate_emits: ["P4-ORPHAN"],
}

principle("P5-dual-hard-validation") = {
  body: "Each package validated with HARD tests against (a) its own package spec AND
         (b) the ~/vsf source specs of the scripts/plugins it derives from.",
  apply: "Every package ships an end-to-end test proving it fulfills its purpose.
          Speed irrelevant; completeness mandatory (sin huecos, nada sobra, nada falta).",
  gate_emits: ["P5-PLAN", "P5-SPECSRC", "P6-ADVERSARIAL"],
}

principle("P6-adversarial-verification") = {
  body: "Extremely strict, reiterative, recursive verification BEFORE validating any
         claim, function, or package. Take the ADVERSARY role: actively hunt gaps,
         holes, technical debts, contradictions, bugs. state-canon is a COMPASS, not
         proof — it orients, it does not certify.",
  apply: "Certify only after: (1) model vs reality (R7: declared == observed, never
          from memory); (2) adversarial negative-control + gap hunt on the artifact;
          (3) hard end-to-end test vs its spec AND the ~/vsf source specs. No claim
          accepted on recall; no shortcut via state-canon alone.",
}

principle("P6.1-dangling-target-rejected") = {
  body: "P6 made structural: 'mapped' is necessary but NOT sufficient. Every audit_entry
         target must resolve to a package actually declared in registry('voslab'). A
         source file mapped to a package that does not exist in the registry is a SILENT
         GAP — the tree looks complete while its destination is imaginary. The skepticism
         lives in the gate (core-gate package-conformance: finding P4-DANGLING), not in
         review memory.",
  apply: "Sentinels 'open' and 'config' are acknowledged (pending partition / non-package
           config) and skipped. Any other target token must match a registry package name
           (exact, or prefix-match for wildcard tokens ending in '*'). Else: REJECTED.",
  gate_emits: ["P4-DANGLING"],
}

principle("P4c-open-debt-must-be-named") = {
  body: "The promise 'I will keep the audit synced (open -> mapped)' is MEMORY, not a
         process — and P6 forbids trusting recall. An 'open' audit entry (pending partition
         into a package) MUST name its intended home via track:. An open entry with no track:
         is an UNNAMED debt and is REJECTED (finding P4-OPEN-UNTRACKED). track: 'exclude'
         marks a deliberately non-package target (docs / registry.json / exp / legacy / tests).
         The open-debt count is also surfaced as a NOTE every run, so the debt is never silent.",
  apply: "When a package is built, change its source dirs from status:open/track:X to
         status:mapped/target:X — the NOTE count drops mechanically. 'Syncing the audit' is
         therefore enforced by the gate, not by memory. (User challenge 2026-08-29: 'por
         memoria o es un proceso?' -> answered: now a process.)",
  gate_emits: ["P4-OPEN-UNTRACKED"],
}

principle("P6.2-structural-repair-on-gap") = {
  body: "The standing agreement 'any gap found during a vOSLAB build is repaired
         STRUCTURALLY, never by memory/patch' is itself a PROCESS, not a recall promise.
         A verbal agreement is memory — it must be encoded to survive compaction and be
         reviewable. Concretely: when a gap/debt/bug is found mid-build, the repair MUST
         (a) add or extend a gate rule in check_package_conformance.py (or the relevant
         verifier) that would have caught it; (b) add a negative-control test asserting the
         gate DETECTS that gap class; (c) record an IR noting the lesson. A fix that only
         patches the instance without hardening the gate is a silent concession (R9) and is
         REJECTED. This is the operational meaning of 'repair structurally'.",
  apply: "Before declaring any vOSLAB package complete, confirm the last gap found was
         closed in CODE (gate rule + test), not just in the instance. The agreement lives
         in this principle + the gate, not in chat recall. (User 2026-08-29: 'si encuentras
         algo en el camino reparamos estructuralmente' -> encoded here as process.)",
}

