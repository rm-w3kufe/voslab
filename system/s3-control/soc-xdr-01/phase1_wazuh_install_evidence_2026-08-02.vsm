@vsm 1.2.1
@status active

// ============================================================================
// SOC Stage A — Phase 1 Wazuh minimal install — EVIDENCE DOSSIER
// Date: 2026-08-02 (started 2026-08-01; resumed+completed 2026-08-02)
// Author: DS (vsf-s1-executor)
// Status: COMPLETE — all 3 components installed + verified; metrics + ISM live
// Companion: plan_and_spec_2026-07-31.vsm (phase_1_deploy + AC3 requirements)
//            phase0_infra_evidence_2026-08-01.vsm (network/LXC state)
// ============================================================================

report(SOC-PHASE1-WAZUH-INSTALL-EVIDENCE) = {
  status:   complete,
  objective: "Wazuh 4.12.0 indexer+server+dashboard on 115/116/117 (VLAN50),
      minimal sizing, zero active-response, no phi_up (phase_2), continuous
      metrics capture, initial footprint registered for the >=72h AC3 study.",

  // ── WHAT IS DONE AND VERIFIED ──────────────────────────────────────────────
  indexer_115: {
    state:    "INSTALLED + ACTIVE + GREEN",
    version:  "wazuh-indexer 4.12.0-1 (OpenSearch 2.19.1, bundled JDK 21)",
    service:  "wazuh-indexer.service active; listening [::ffff:10.10.50.115]:9200",
    security: "securityadmin.sh re-run manually after installer's claim was false
        (cluster log showed 'no such index [.opendistro_security]' + 503).
        RC=0, all 10 config types loaded. Generated passwords applied via
        wazuh-passwords-tool.sh -f /root/wazuh-install-files/wazuh-passwords.txt
        (RC=0; backup of pre-change internal_users in
        /etc/wazuh-indexer/internalusers-backup/).",
    verified: [
      "admin with generated password -> HTTP 200 cluster health GREEN, 1 node",
      "default admin:admin -> HTTP 401 (REJECTED — hardening confirmed)",
    ],
    footprint_cold_start: {
      "container": "2GB RAM total; used 862/2048 MB (42%) at idle-green",
      "java_rss":  "870 MB (heap 512 + off-heap + JVM overhead)",
      "jvm_heap":  "-Xms512m -Xmx512m (patched; see installer bug below)",
      "disk":      "2.6G used / 4.9G free on 8G rootfs",
      "cpu":       "2 cores placeholder; cold start consumed little CPU,
                    dominated by host-wide I/O wait",
    },
  },

  // ── INSTALLER BUGS FOUND (PATCHED) ────────────────────────────────────────
  installer_patches: {
    heap_bug: {
      symptom:  "wazuh-install.sh always set JVM heap 1024m regardless of RAM",
      root_cause: "indexer_configure() computes ram from variable 'ram_mb'
          but assigned it as 'ram_gb' — ram_mb is undefined -> ram=0 -> fallback 1024",
      patch:    "ram_mb=2048; ram=512 (hard) + disabled the ram=1024 fallback",
      file:     "/root/wazuh-install.sh on 115/116/117 (patched copy pushed;
                  original saved as /root/wazuh-install.sh.orig on 115)",
    },
    systemd_timeout: {
      symptom:  "wazuh-indexer.service start operation timed out (systemd 90s
                  default) — cold start needs ~20 min under host I/O saturation",
      patch:    "installCommon_startService() now writes a systemd drop-in
                  /etc/systemd/system/<svc>.service.d/vsf-timeout.conf with
                  TimeoutStartSec=1800 TimeoutStopSec=600 before starting",
    },
    securityadmin_race: {
      symptom:  "installer logged 'Wazuh indexer cluster initialized' but
                  .opendistro_security index was never created (installer ran
                  securityadmin too early / silently failed under slow disk)",
      fix:      "manual re-run: sudo -u wazuh-indexer ... securityadmin.sh
                  -icl ... (RC=0, SUCC 10/10)",
    },
  },

  // ── HOST-LEVEL FINDING (AC3-relevant) ─────────────────────────────────────
  ac3_baseline_finding: {
    observation: "n02 host I/O saturated: iowait 94%, load avg 20+ sustained,
        single 931G spinning disk (sda) shared by all 15 LXCs on lvmthin.
        OpenSearch cold start takes ~18-20 min under this load (JVM healthy,
        I/O-starved). 512MB heap + 1800s timeout is the minimal workable
        combo — that IS the real baseline the AC3 study must record.",
    implication: "The >=72h observation window matters: cold-start numbers
        under host I/O contention are the pessimistic bound; steady-state
        footprint (idle-green 862MB/2GB) is the optimistic one.",
  },

// ── SERVER 116 — COMPLETE ──────────────────────────────────────────────────
  server_116: {
    state:     "INSTALLED + ACTIVE",
    version:   "wazuh-manager 4.12.0-1",
    services:  "wazuh-manager active; filebeat active; egress to indexer verified.",
    manager_daemons: "analysisd, remoted, authd, logcollector, syscheckd,
        modulesd, monitord, execd, apid, wazuh-db all RUNNING (wazuh-control
        status). clusterd not-running = expected single-node.",
    listeners: "1514 (wazuh-rem), 1515 (wazuh-auth) LISTEN",
    pipeline:  "wazuh-alerts-4.x-2026.08.02 -> 272 docs on indexer by
        dashboard-finish time (39 at initial check -> growing = live egress).",
    filebeat:  "test output OK, elasticsearch 10.10.50.115:9200, TLS 1.2,
        version 7.10.2",
    verified: [
      "systemctl is-active wazuh-manager -> active",
      "systemctl is-active filebeat -> active",
      "ss -tln -> 1514 + 1515 LISTEN",
    ],
  },

  // ── DASHBOARD 117 — COMPLETE ───────────────────────────────────────────────
  dashboard_117: {
    state:    "INSTALLED + ACTIVE",
    version:  "wazuh-dashboard 4.12.0.1 (opensearch-dashboards node)",
    service:  "wazuh-dashboard active; LISTEN 10.10.50.117:443 (node pid)",
    login:    "https://10.10.50.117:443 -> HTTP 302 (login redirect). UI up.",
    incident: "FIRST install: unpack ~2h (host IO), then failed 'Request timed
        out' connecting to indexer during bootstrap + resource_already_exists on
        .kibana_1. ROOT CAUSE: host IO saturation + leftover .kibana_1 index.
        FIX: DELETE .kibana_1 via API, relaunch install -> finished clean
        17:18 (unpack 469MB write, connect OK, .kibana_1 recreated fresh).",
    footprint_cold_start: {
      "container": "2GB RAM; ~1GB resident (node + groupwise services)",
      "disk":      "install leaves ~1.0-1.2G unpacked under host IO",
    },
    verified: [
      "systemctl is-active wazuh-dashboard -> active",
      "ss -tln | :443 -> LISTEN",
      "curl -sk https://10.10.50.117:443/ -> HTTP 302 (login)",
      "cluster health GREEN (provided dashboard init completed)",
    ],
  },

  // ── METRICS CAPTURE (DS design choice per dispatch) ────────────────────────
  metrics_capture: {
    status: "LIVE", 
    script: "scripts/soc/capture_soc_metrics.sh v1.1",
    deploy: "/home/soc/capture_soc_metrics.sh on 115/116/117 (pct push + chmod)",
    cron:   "/etc/cron.d/soc-metrics — '*/5 * * * * root /home/soc/<script> <role>'
            every 5min on all 3 (cron active verified)",
    roles:  "indexer(115) / server(116) / dashboard(117)",
    output: "/var/lib/soc-metrics/<role>.jsonl (one JSON obj/line)",
    schema: "ts role mem_*(MB) swap load1 cpu_user/sys/iowait proc_rss_mb
            disk_used_pct OR disk_used_gb services{...} extras{...}",
    indexer_extras: "cluster_status, active_shards, unassigned_shards, nodes,
             heap_used_pct — polled via admin API (10.10.50.115:9200; pw in
             /etc/soc-metrics/indexer-admin.env, 0600)",
    env_note: "ADMIN_PW stored at /etc/soc-metrics/indexer-admin.env (0600) on 115",
    verified: [
      "python json.loads(open(...).read().split('\\n')[-2]) -> VALID in all 3",
      "115 extras -> {\"cluster_status\":\"green\",\"active_shards\":8,
           \"unassigned_shards\":0,\"nodes\":1, heap partial}",
    ],
    bugs_fixed_in_design: [
      "cpu via /proc/stat not 'top' (top -bn1 %Cpu parse was fragile)",
      "services is-active single-line (systemctl prints newline for absent svc)",
      "indexer health via 10.10.50.115 not 127.0.0.1 (binds external IP [::ffff:10.10.50.115]:9200)",
      "JSON extraction via python3 json (awk $4 brittle on one-line JSON)",
    ],
  },

  // ── RETAITION (ISM) ────────────────────────────────────────────────────────
  ism_retention_policy: {
    policy_id: "soc-minimal-retention",
    applied:   "PUT _plugins/_ism/policies/soc-minimal-retention + 
        POST _plugins/_ism/add/wazuh-alerts-4.x-2026.08.02 (updated_indices:1)",
    rule:      "hot state 7d -> delete (no hot/warm tiering; AC3 minimal footprint)",
    pattern:   "ism_template -> index_patterns ['wazuh-alerts-*','wazuh-archives-*']",
    note:      "ISM template applies to NEW indices; existing index attached manually",
    verified:  "GET _plugins/_ism/policies -> total_policies:1",
  },

  // ── ACTIVE-RESPONSE: DISABLED (AC1 guardrail) ─────────────────────────────
  active_response_disabled: {
    server_ossec_conf: "block at ossec.conf L236-238 commented with
        <!-- ... --> ('active-response options here' is the template comment).
        No actual <command>/<active-response> wiring. wazuh-execd runs (default
        daemon) but has no AR commands activated. EVIDENCE: grep showed only
        the commented template + /var/ossec/logs/active-responses.log location.",
    filebeat: "no active-response concept at filebeat config level",
    dashboard: "no active-response in dashboard config",
    cleanroom: "AC1_isolation (read-only) — no response/active-response modules
        -- confirmed not activated anywhere in the stack.",
  },

// ── FOOTPRINT RESOLUTION: server disk 100% (RESOLVED via rootfs expand) ────
  server_disk_finding: {
    observation: "server 116 rootfs (8G) was 100% full: 7.4G used / 0.01G free.
        Biggest consumer: /var/ossec/tmp/vd_1.0.0_vd_4.11.0.tar (5.2G)
        + source .tar.xz (247M) — the Vulnerability Database fetched by the
        installer during install (mtime 05:14).",
    relevance:   "vulnerability-detector block NOT present in ossec.conf
        (scanner disabled), yet 5.5G of VD data was pulled. Was filling rootfs
        and threatening /var/ossec writes (logs, alerts).",
    decision:    "rmw3 2026-08-02: do NOT delete the VD — it is real audit tooling
        with own value, not dead weight. Instead expand rootfs.",
    action:      "pct resize 116 rootfs 8G -> 16G (resize2fs online on host).",
    resize_v2:   "2026-08-02 (Claude) 16G -> 24G to guarantee headroom once
        vulnerability-detection enabled grew CTI feed (~5.4G).",
  },

  // ── SOC STRATEGIC DIRECTIVE (rmw3, 2026-07-02) — scope bias ───────────────
  soc_strategic_directive: {
    principle: "Unlike exploratory experiments (e.g. clima, which can be freely
        reshaped/optimized), the SOC carries real value beyond VSF architecture
        — knowledge value AND concrete professional/labor value. Therefore
        prefer EXPANDING SOC capability over maintaining it minimal.",
    apply:     "future SOC scope decisions: favor growth of monitoring/audit
        capability (e.g. vulnerability detection, agent enrollment, tooling)
        over the earlier 'minimal install' framing, while still honoring AC1
        (read-only, no active-response) and R10 (no LLM in signal path).",
    recorded_by: "rmw3 (S5) via session — visible to DS for subsequent SCOPE.",
  },

  // ── VULNERABILITY-DETECTION ENABLED (rmw3-confirmed 2026-08-02) ───────────
  vulnerability_detection_enabled: {
    decision:  "rmw3 2026-08-02: activate vulnerability-detector on server 116.
        Reasoning agreed with rmw3: it is PASSIVE/read-only (scans package
        versions against CVE feed, no actuation) — consistent with AC1
        observation-only spirit vs active-response. Aligns with SOC strategic
        directive (expand capability).",
    format_note: "Wazuh 4.12 DEPRECATED legacy <vulnerability-detector> with
        <provider> sub-blocks. Use new <vulnerability-detection> element. The
        manager default config already ships it ENABLED (ossec.conf L108-112,
        <enabled>yes</enabled> + <index-status>yes</index-status> +
        <feed-update-interval>60m</feed-update-interval>). Providers are no
        longer per-OS blocks; 4.8+ uses Wazuh's own CTI feed (cti.wazuh.com).",
    my_false_start: "First I added a legacy <vulnerability-detector> block with
        canonical/debian providers — REJECTED as deprecated by wazuh-modulesd
        (invalid element warnings). Reverted to the default modern block.",
    enabled_via: [
      "kept default <vulnerability-detection> block (already enabled:yes)",
      "internal_options.conf: vulnerability-detection.disable_scan_manager=0
          (scan the manager itself; default was 1=disabled)",
      "indexer-connector keystore credentials written on 116:
          wazuh-keystore -f indexer -k username=admin / -k password=<gen>
          (fixes 'No username and password found in the keystore' — the
          installer does NOT set this for the server's OWN scanner; GitHub
          issue #30090)",
    ],
    verified: [
      "wazuh-analysisd -t config test EXIT=0 before restart",
      "log: 'IndexerConnector initialized successfully for index:
          wazuh-states-vulnerabilities-s5-soc-server' (20:42 + 20:47)",
      "log: 'Database decompression finished' (21:27) + 'Vulnerability scanner
          module started' (21:29)",
      "indexer: wazuh-states-vulnerabilities-s5-soc-server index EXISTS (green)",
      "CTI feed reachable: https://cti.wazuh.com HTTP 200 from 116",
    ],
    footprint:  "CTI feed ~5.4G in /var/ossec/queue/vd/feed + ~1.6G
        vd_updater/tmp (cleaned after decompression). This is the real cost
        of enabling VD — principal reason rootfs expanded to 24G.",
    rocksdb:    "/var/ossec/queue/indexer/db/wazuh-states-vulnerabilities-*
        stores scanner DB (actively writing during scan).",
    status:     "ACTIVE — first scan of the manager in progress under host I/O.
        Vulnerability states/alerts index will populate after first scan
        completes (needs syscollector inventory + comparison per Wazuh docs).",
  },

  // ── REMAINING AFTER INSTALL ───────────────────────────────────────────────
  remaining: [
    "end-to-end human login via tunnel (soc-access) + browse dashboard — verify
        UI reachable from outside (needs tunnel up)",
    "cross-filebeat components check (filebeat full pipeline from a real agent
        — no agents enrolled at phase-1 agentless stage)",
    "AC3 >=72h study: deploy metrics first (done), then let observe window run,
        register steady-state footprint both pessimistic (host-IO) and
        optimistic (idle-green)",
  ],
}
