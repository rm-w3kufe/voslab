@vsm 1.2.1
@status conjecture
// system/s3-control/viable_compressor.vsm — is the VSM an optimal information compressor?
// domain_context: {target=vsf_nucleus+vsl, env=theory, layer=L+3}
//
// rmw3's question, 2026-07-05: "could our model be an effective machine for
// the absolute compression of information?"
// It joins five things that were being worked separately: VSL compression,
// the soplo as a Maxwell demon, internal entropy h_t, the Ω-margin, and the
// VSM structure itself read as a variety filter.
//
// RESTRUCTURED 2026-08-08 (rmw3 S5). 212 lines, 209 of them comment, ∄
// top-level block. Three defects only became visible as blocks — see
// evidence.E3, lines.E and measurable.M3.

frame("THEORY-VC-01") = {
  question: "is maintaining viability the SAME operation as compressing?",
  method:   "∄ new experiment required. Three independent measurements
             already point the same way",
}

// ─────────────────────────────────────────────────────────────────────────
// 1 — WHAT IS ALREADY MEASURED
// ─────────────────────────────────────────────────────────────────────────

evidence = {

  E1("VSL compression", EXP-VSL-04, 2026-06-29): {
    ratio:    "38-51% (B_full) ▪ 72-79% (B_schema)",
    entropy:  "H_char(VSL) = +10.6% vs NL   — REFUTED at character level
               H_tok(VSL)  = −5.4%  vs NL   — CONFIRMED at token level",
    reading:  "the VSL codebook operates at TOKEN level, ¬character.
               The GRAMMAR is the codebook: fewer tokens for the same thing",
    claim:    "lossless SEMANTIC compression — the .vsm means what the prose
               meant, in less space",
  },

  E2("soplo as Maxwell demon", EXP-SOPLO-01, 2026-07-02): {
    mechanism: "φ↑ receives all S1 variety (23 clima services + econ + the
                nucleus) and compresses SELECTIVELY: low-entropy signals
                (high stasis, inside Ω) reach S3 ▪ high-entropy signals are
                blocked or aggregated",
    reading:   "a Maxwell demon — it separates hot signals from cold and
                passes only the cold",
    cost:      "Landauer: the demon PAYS for the measurement. Here the price
                is kernel CPU time, measurable in watts per tick",
  },

  E3("internal entropy h_t", CALIBRATE-ENTROPY, 2026-07-03): {
    measured: "h_t ≈ 1.9-2.0 bits steady state ▪ h_max = 2.0 (4-state
               alphabet) ▪ h_eq ≈ 1.8",
    utilization: "95-100% of h_max — within rounding of the 2-bit ceiling",
    // CORRECTED 2026-08-08. The document carried BOTH readings, four lines
    // apart: "~90-95% of maximum entropic capacity, the remaining ~5-10% is
    // reserve variety" AND "95-100%, within rounding". The 2026-07-11 review
    // had fixed an earlier "~50%" (an alphabet-size error) by APPENDING the
    // correction and leaving the line it corrected in place.
// ⟹ the reserve-variety claim does not survive: at 95-100% there is ∄
    //   meaningful reserve. That is a finding about the system, ¬a rounding
    //   detail — it says the kernel runs at its entropic ceiling.
  },
}

// ─────────────────────────────────────────────────────────────────────────
// 2 — THE CONJECTURES
// ─────────────────────────────────────────────────────────────────────────

conjecture(VC-1, "the VSM kernel is an optimal compressor for viability
                  information") = {
  statement: "∀ system holding viability in an environment of bounded variety,
              the VSM structure (S1..S5 + homeostatic loops) reaches the
              optimal compression rate given by the RATE-DISTORTION of the
              viability information",
  implies: {
    i:   "VSL is a SOURCE CODE for viable-system specifications — it reaches
          the entropy of the specification language",
    ii:  "the ℝ¹²⁸ dynamics are an ENCODER projecting environment variety onto
          the simplex Δ⁴ — the narrowest channel that preserves viability",
    iii: "the Ω-margin IS the distortion. Compress harder (smaller margin) ⟹
          lose viability information. Compress less ⟹ waste channel capacity",
  },
}

conjecture(VC-2, "the soplo computes at the Landauer-limited efficiency
                  frontier of its substrate") = {
  statement: "the soplo is ¬only a filter, it is a THERMODYNAMIC operation.
              Each pass/¬pass classification ERASES the blocked variety",
  landauer:  "erasing 1 bit dissipates k_B·T·ln2",
  test:      "measure dissipation per tick against the entropy filtered ⟹ the
              thermodynamic efficiency of viable computation",
}

// ─────────────────────────────────────────────────────────────────────────
// 3 — THE FIVE LINES IT UNIFIES
// ─────────────────────────────────────────────────────────────────────────

lines = {

  A("Shannon source coding"): {
    have: "VSL 38-79% ▪ H_char ▪ H_tok",
    law:  "H(X) ≤ L* < H(X) + 1 for any optimal code",
    gap:  "H_sem — semantic entropy. Without it the optimality claim is ¬closed",
  },

  B("rate-distortion"): {
    distortion: "Ω defines the maximum acceptable distortion: margin_free ≥ 0",
    rate:       "|D_id| / 128 ≈ 3/128 ≈ 2.3% of the original space",
    // NAMESPACED 2026-08-08: the source wrote D_eff. D_eff is Paper 4's
    // effective-dimension of a parameter space (D_eff ≪ N_params); this is
    // the count of CONSTITUTIVE dimensions, THEORY-SID-01 #6's D_id ≈
    // {governed, lifecycle, mem_pressure}. Two unrelated quantities, one name.
    question:   "R(D) for the viability process — the minimum rate that holds
                 viability at distortion D = Ω-margin",
    decides:    "R(D) > current rate ⟹ ∃ room to compress (raise τ, drop modes)
                 R(D) < current rate ⟹ viability information is being LOST",
  },

  C("Kolmogorov complexity"): {
    generator:  "the kernel GENERATES the trajectory ⟹ K(trajectory) ≤ |source|",
    measured:   "|source| = 1230 KB, 28223 lines, 47 .rs files  (2026-08-08)
                 |binary| = 7.68 MB  (LXC 101, live)
                 trajectory_raw = 3043 × 128 × 8 B ≈ 3 MB",
    bound:      "|trajectory| / |source| ≈ 2.4×",
    // CORRECTED 2026-08-08 against the tree. The source claimed |source| ≈
    // 300 KB and derived ≈10×. The Rust is 1230 KB — 4.1× larger — so the
// ratio is 2.4×, not 10×. This WEAKENS line C substantially and is recorded
    // as such: a generator only 2.4× shorter than what it generates is a
    // thin claim to low Kolmogorov complexity.
    honest:     "this is an UPPER bound on K(trajectory), ¬a measurement. The
                 real target is K(process) — the minimal program generating
                 ALL viable trajectories, which is ¬computable",
    next:       "gzip/xz the trajectory. Compressing below 1230 KB tightens
                 the bound without touching the kernel",
  },

  D("Maxwell demon ⊕ Landauer"): {
    setup: "φ↑ carries raw S1 variety (high entropy) ▪ the soplo classifies
            and filters ▪ the soplo PAYS to measure the state",
    floor: "k_B·T·ln2 per classified bit",
    metric:"filtered entropy / dissipated energy",
    hypothesis: "the kernel runs NEAR the Landauer limit because the VSM
                 structure minimizes what must be MEASURED to stay viable —
                 Ashby: only the variety needed to regulate",
  },

  E("renormalization group"): {
    analogy: "VSM recursion ≡ RG — each level averages the variety BELOW it and
              keeps only the modes viability depends on",
    flow: "L3  80 clima stations   →  L2  5 zones
           L2  5 zones             →  L1  continental stasis_cos
           L1  kernel ℝ¹²⁸         →  L0  simplex Δ⁴ (softmax)",
    direction: "variety flows from the HIGHER L index to the LOWER — leaves are
                deep, the root is L0, per A1",
    // CORRECTED 2026-08-08. The source ran it L0 → L1 → L2 → L3, putting the
    // 80 stations at the ROOT and the simplex at the leaves. Inverted against
    // A1 and against the live clima network (L0 root, 87 L3 leaves). This is
    // the THIRD document carrying this exact inversion — vos_proofs §8 and
    // seven_ideas #4 were the other two. All three inherited it from prose
    // that wrote levels as arithmetic instead of as parent/child roles.
    invariant: "∀ step: the description shortens, the viability information is
                preserved within Ω",
    flow_is:  "the contraction (Lyapunov λ < 0) IS the RG flow toward the
               stasis attractor",
  },
}

// ─────────────────────────────────────────────────────────────────────────
// 4 — WHAT CAN BE MEASURED WITH DATA ALREADY IN HAND
// ─────────────────────────────────────────────────────────────────────────

measurable = {
  M1("kernel compression rate"): "H(φ↑ in) vs h_t (≈1.9 bits out) ⟹ ratio.
     Consistent with R(D) ⟹ the conjecture gains weight",
  M2("Landauer efficiency of the soplo"): "input_bits = NATS φ↑ B/s ▪ cpu_time
     from /proc ▪ watts = cpu_time · TDP ⟹ efficiency = input_bits /
     (watts / k_B·T·ln2). Within 1-2 orders of the limit ⟹ plausible",
M3("Kolmogorov bound"): "see lines.C — bound is 2.4×, not 10×. Tightening it
     costs a gzip run, ¬an experiment",
  M4("VSL code efficiency"): "H_tok(VSL) − H_tok(NL) = −5.4%. Closing the
     argument needs H_VSM — the entropy of the specification language itself",
}

// ─────────────────────────────────────────────────────────────────────────
// 5 — WHAT IT WOULD MEAN
// ─────────────────────────────────────────────────────────────────────────

implication = {
  viability_is_compression: "holding a system viable IS finding the shortest
    representation of its state that still supports control ⟹ Beer discovered
    a universal source encoder for viable systems without naming it one",
  covenant_is_the_codebook: "the covenant (A0/A0.1 + covenant_ops) defines the
    alphabet. Changing it RE-CODES the system — it changes what counts as
    relevant information. That is why it needs a human signature at S5:
    changing the codebook changes the definition of viability",
  tau_is_the_rate_knob: "τ controls the rate-distortion tradeoff.
    high τ → uniform weights, more entropy, less compression
    low τ  → one-hot weights, less entropy, more compression
    excursion raises effective τ (explore) ▪ recovery lowers it (focus)
    ⟹ an ADAPTIVE compression-rate controller, already running",
  phase_change_is_format_change: "the critical-τ transition is a change of
    COMPRESSION FORMAT. High-τ phase uses every mode — uncompressed. Low-τ
    phase rides one dominant mode — lossy, and the loss is exactly the
    distortion the Ω-margin bounds",
}

// ─────────────────────────────────────────────────────────────────────────
// 6 — OPEN
// ─────────────────────────────────────────────────────────────────────────

// debt(KOLMOGOROV-BOUND-TIGHTEN, class=experiment, owner=DS)
