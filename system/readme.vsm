⟦ readme | SYSTEM-readme-v1 | vsm-1.2.1 | 2026-09-27T23:02:17Z ⟧

@vsm 1.2.1
@status active

// system/readme.vsm — ROLE AND FUNCTION OF system/
// 
// RULE: system/ = immutable system documentation.
// Plans and mutable docs go to docs/.
//
// To navigate: see system/INDEX.vsm

system(readme) {

  synthesis: "system/ := invariant system documentation (no mutable plans)",

  policy: "
    INVARIANT: system/ contains ONLY immutable system documentation
    MUTABLE: plans, proposals, drafts → docs/
    INDEX: consult system/INDEX.vsm for navigation
    FORBIDDEN: no loose files, no plans, no mutable docs
 ",

  structure: [
    dir("boot/",            role="s5 identity",   desc="base canon — minimum to interpret VSL"),
    dir("instance/",        role="metasystem",    desc="specific instance configuration"),
    dir("kernel/",          role="substrate",     desc="n02's substrate"),
    dir("rules/",           role="enforcement",   desc="system rules (R_DOC, etc)"),
    dir("s1-operations/",   role="s1",            desc="S1 systems on n02"),
    dir("s2-coordination/", role="s2",            desc="coordination between units"),
    dir("s3-control/",      role="s3",            desc="control and monitoring"),
    dir("s3star-audit/",    role="s3*",           desc="independent audit"),
    dir("s4-intelligence/", role="s4",            desc="analysis and prediction"),
    dir("s5-policy/",       role="s5",            desc="high-level policies"),
    file("INDEX.vsm",      role="navigation",    desc="index for finding documentation"),
    file("readme.vsm",     role="policy",        desc="this file"),
  ],

  verification: "INDEX.vsm must exist and be current",
}

⟦ /readme ⟧