⟦ readme | SYSTEM-readme-v1 | vsm-1.2.1 | 2026-08-17T02:58:03Z ⟧

@vsm 1.2.1
@status active
// system/readme.vsm — ROLE AND FUNCTION OF system/ (reinforcement policy).
// S5 DECISION rmw3 2026-08-14 (translated from Spanish): formalize system/'s
// role as the cybernetic correspondence with n02 — not the specific, but
// the reinforcement policy that teaches the agent to know its ecosystem so
// it distributes its resources better.
// This readme is the directory's gate: read it before entering.
//
// SYNTHESIS (one line) (translated from Spanish): system/ = the map S3/S5
// use to operate n02 with logical precision and query speed; validated
// against n02 in loop (R7).

system(readme) {

  synthesis: "system/ := map(S3,S5 → operate n02) @ Φ(n02)   // cybernetic
              correspondence: doc ↔ reality validate in loop (R7); the agent
              that knows the map distributes its resources better (A6)",

  loop: "
    system validates n02:   D_system → N      (model ≡ reality)
    n02 validates system:   N → D_system      (reality confirms/refutes; R7: N wins)
    stable ⟺ ∀ d ∈ system/: Φ(d) ≡ reality(N)   // drift(documentation) = 0",

  function: "the set of instructions S3 and S5 require to operate n02 with
             logical precision and query speed — a single source of truth
             with simple access for technical query and conflict resolution",

  structure: [
    dir("boot/",            role="s5 identity",   desc="the base canon — the minimum to interpret VSL (6 docs + manifest)"),
    dir("instance/",        role="metasystem",    desc="the specific instance (Kali-WSL + n02 via n01); infra/ ⊆ instance"),
    dir("kernel/",          role="substrate",     desc="n02's substrate"),
    dir("s1-operations/",   role="s1",            desc="the S1 systems on n02, over LXCs (s1-bbh, s1-clima, s1-econ)"),
    dir("s2-coordination/", role="s2",            desc="coordination — keeps units from stepping on each other"),
    dir("s3-control/",      role="s3",            desc="control — allocates resources, monitors performance"),
    dir("s3star-audit/",    role="s3*",           desc="sporadic audit — sees what S3 does not"),
    dir("s4-intelligence/", role="s4",            desc="intelligence — watches the environment, plans ahead"),
    dir("s5-policy/",       role="s5",            desc="policy — the criteria we always fall back to"),
  ],

  policy: "
    if a doc describes an n02 organ       → lives in that organ's directory
    if it is transversal agent policy     → s5-policy/agent-policy/
    if it is an axis/experiment spec      → spec/
    if it is a proposal under validation  → sandbox/ (nothing canonical here)
    if it is derived theory/formalization → docs/theory/ (outside dir_schema)
    new file without a declared category  → violation (dir-schema-valid BLOCKS)",

  verification: "dir-schema-valid (BLOCKING) + boot-manifest-valid + boot-load-test",
}

⟦ /readme ⟧