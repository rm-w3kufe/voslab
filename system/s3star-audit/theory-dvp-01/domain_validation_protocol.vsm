// domain_validation_protocol.vsm — validation protocol for VSF instantiations in new domains
// domain_context: {target=vsf, env=VSF-session, layer=S4}
//
// Origin:    Critique by Prof. Raúl Fierro Pradenas (Head of Mathematics, UV), ~4h meeting,
//            2026-05-01, on the paper "Geometric Attractor Convergence in a Viable System Kernel".
//            Three formal questions whose answers (VSL-MATH-01 cycle) became the canonical
//            protocol for certifying any VSF instantiation in a new domain.
//
// Reference: @dir_papers attractor_convergence/Revisiones/ (full analysis)
//            ▪ fierro_bridge_to_operations.vsm (bridge to the operational constants)
//            ▪ kernel/vos_proofs §8 — this protocol in recursive deployment.
//              The source cited kernel/recursive_channel_protocol.vsm, which was
//              FUSED into vos_proofs and whose §8 carried an INVERTED level
//              convention, corrected 2026-08-08. Pointing at the pre-fuse
//              original would send a reader to the uncorrected text.
//
// Purpose:   when VSF is instantiated in a new domain (banking, public health, supply chain,
//            …), these three questions must be answered before any viability claim is
//            scientifically defensible. They are the formal prerequisite for Paper 5 onward.
//
// Translated ES→EN 2026-08-07 (D7). THEORY-03 entered the corpus as a `move`, so the
// translation pass that covered the fused documents never reached it.
//
// CERTIFIED 2026-08-08. The header carried the GENERIC id `VSF-THEORY` where
// every sibling carries a specific one — a generic identity is a collision
// waiting for the second document that reuses it. Now THEORY-DVP-01.

// ─── THE Q1-Q3 PROTOCOL ──────────────────────────────────────────────────────

domain_validation_protocol = {

  name:    "Fierro Q1-Q3 Domain Validation Protocol",
  origin:  "Prof. Raúl Fierro Pradenas, UV — critique of Paper 1 (2026-05-01)",
  status:  "RATIFIED — answers formalised in VSL-MATH-01, operational constants in calibration.rs",

  // ── Q1: formal definition of the viable set Ω ─────────────────────────────

  Q1_viable_set: {
    question:
      "Is the viable set Ω formally defined?
       Is it a convex polytope or an ad-hoc heuristic?",

    answer_paper1:
      "Ω = {x ∈ ℝ¹²⁸ | Ax ≤ b} — a convex polytope.
       Every axiom A0..A6 is expressible as a linear or convex inequality.
       Consequence: existence of a minimum guaranteed by Krasnoselskii (compact convex space).",

    operational_embedding:
      "omega_validator.rs → Omega::canonical() — builds the polytope each tick.
       VIABLE_THRESHOLD = 0.70 (calibration.rs) — the stasis_cos bound defining Ω's lower face.",

    question_for_new_domain:
      "In domain D, what are the dimensions of the state vector?
       What constraints define 'viable' in D?
       Are they expressible as Ax ≤ b (linear/convex)?
       If not → what guarantee of attractor existence does the domain have?",

    example_banking:
      "Ω_banking = {transaction pattern | velocity ≤ v_max ∧ dep/wd ratio ∈ [r_min, r_max]
                    ∧ geographic concentration ≤ c_max ∧ …}
       Each constraint must be justified from the domain (Basel III regulation, empirical history).",
  },

  // ── Q2: certification of contractivity L ─────────────────────────────────

  Q2_contractivity: {
    question:
      "Is the dynamics map contractive on Ω?
       Is Lip < 1 (the Lipschitz constant) globally, or only locally?",

    answer_paper1:
      "Lip ≈ 0.85 < 1 on Ω_A (the interior contractive region, cos(x,x̄) ≥ 0.88).
       Lip ≤ 1.0 globally on Ω (conservative bound).
       The separation Ω_A ⊂ Ω is the key point: the attractor lives in Ω_A; Ω is the full
       viable set. Consequence: inside Ω_A the system converges (Banach); on Ω∖Ω_A it
       contracts, but more slowly.",
    // Lip, ¬a bare L: vsl_language declares FIVE L namespaces and states that
    // bare L is none of them. The kernel agrees — events.jsonl emits the field
    // as `lipschitz`, ¬as `L`.

    operational_embedding:
      "lyapunov.rs → RecurrentSetCertifier → regime: InRecurrentSet/ContractingToR/Diverging.
       LYAP_R_CORE = 0.20 (calibration.rs, confirmed by EXP-LYAP-CERT 2026-06-03).
       Telemetry 'lipschitz: op_lip_k / op_tau' in events.jsonl monitors Lip per tick.",

    architecture_implication:
      "The D4-L2 class lyapunov_trust_modulation (session 2026-06-13c) has a precise
       mathematical footing BECAUSE Q2 is certified: Diverging means leaving Ω_A, where Lip<1.
       Without Q2 the class would be intuition; with Q2 it follows from Lyapunov's theorem.",

    question_for_new_domain:
      "In domain D, what is the dynamics f₀?
       Can its Lipschitz constant Lip be computed (or bounded) within Ω?
       Does an analogous Ω_A (strictly contractive region) exist inside Ω?
       If contractivity is not demonstrable → the attractor may be non-unique, or absent.",

    example_banking:
      "Do transaction patterns converge toward stable typical behaviour?
       Can Lip be estimated from historical data (e.g. autocorrelation of the time series)?
       Ω_A_banking might be the 75th percentile of normal operation (dense interior of the
       viable set).",
  },

  // ── Q3: noise bound σ_max ─────────────────────────────────────────────────

  Q3_noise_certification: {
    question:
      "What is the maximum stochastic noise σ under which the system still converges?
       What happens if the perturbation exceeds σ_max?",

    answer_paper1:
      "σ_max = 0.42 — certified empirically (EXP-AB-01, EXP-TC-01).
       ε_frontier = √(2·(1 − θ_viable)) = √0.60 = 0.7746
         — DERIVED, ¬a free constant. main.rs:6701.
       safety margin = ε_frontier / σ_max = 1.84×, over the 1.5× threshold.
       σ > σ_max ⟹ the trajectory exceeds ε_frontier ⟹ leaves Ω ⟹ α.",
    // CORRECTED 2026-08-08. The doc carried ε_frontier = 0.78 and a 1.86×
    // margin; s4_local_lyapunov carried 0.775. Neither is the value — the
    // kernel COMPUTES it from θ_viable and gets 0.7746, so both documents had
    // rounded a derived quantity, differently, and recorded it as a literal.
    // Carrying the formula instead means θ_viable can move without silently
    // staling two documents. The conclusion is unchanged: 1.84× still clears
    // the 1.5× bar.

    operational_embedding:
      "VR_EPSILON_COSINE = 0.30 (calibration.rs) — VR-complex scale within the β₀=1 plateau.
       BASIN_FLOOR = 0.875 (calibration.rs, EXP-AB-01) — worst empirical case observed.
       The anti-capture property rests on Q3: an anomalous input exceeding σ_max produces
       deviation from the attractor → Lyapunov certifies it as Diverging → algedonic.",

    question_for_new_domain:
      "In domain D, what is the normal operating noise level?
       What perturbation size produces measurable deviation from the attractor?
       Can 'operational noise' be separated from 'anomaly signal'?
       Without σ_max → the algedonic channel has no objective threshold.",

    example_banking:
      "σ_max_banking = normal volatility of the financial metrics (estimable from historical
       data). A laundering transaction produces deviation >σ_max in the network metrics (β₁>0),
       and the algedonic channel fires. Separating 'normal noise' from 'structural anomaly'
       requires enough clean historical data to calibrate the baseline.",
  },
}

// ─── RELATION BETWEEN Q1-Q3 AND THE ARCHITECTURE ─────────────────────────────

architecture_grounding = {

  Q1_grounds:  "the definition of Ω → Omega::canonical() → viable/non-viable per tick",
  Q2_grounds:  "the convergence guarantee → Lyapunov certifier → regime classification
                → D4-L2 class lyapunov_trust_modulation (verifiable cause and effect)",
  Q3_grounds:  "the perturbation bound → basin_floor / VR_EPSILON → algedonic threshold
                → anti-capture property (anomalies exceed σ_max → leave the attractor → signal)",

  without_Q1:  "Ω is a heuristic → no guarantee that 'viable' is coherent",
  without_Q2:  "Lyapunov does not certify convergence → the lyapunov_trust_modulation class
                has no footing → the architecture rests on an unverified assumption",
  without_Q3:  "the algedonic channel has no objective threshold → it may fire on normal noise
                (false positives) or stay silent on real anomalies (false negatives)",

  conclusion:  "Q1-Q3 are not questions about the paper. They are the foundation that makes the
                architecture trustworthy. Fierro forced into the open what had been implicit.",
}

// ─── FIERRO AS AN S4 SIGNAL ──────────────────────────────────────────────────

fierro_vsm_role = {

  role_in_vsm:
    "Prof. Fierro acted as an external S4 signal — an observer of the environment who returned
     information about the state of that environment (the academic mathematical community)
     which the system did not hold. His critique is exactly the kind of signal S4 exists to
     process: 'the environment (academic reviewers) has these expectations; the system does
     not meet them'.",

  learning_loop_triggered:
    "The critique triggered a D4-L3 learning cycle (policy change):
     Fierro Q1-Q3 → VSL-MATH-01 (Qwen validation) → formal answers → constant calibration →
     embedding in calibration.rs.
     Result: constants that had been heuristic acquired mathematical and experimental backing.
     The system learned from its environment.",

  ongoing_s4_role:
    "Fierro remains an S4 channel for the paper in progress. When the paper is submitted,
     academic reviewers become the next S4 signal. The Q1-Q3 protocol is the anticipated
     response to that signal — preparing the defence before it arrives.",

  implication_for_paper5:
    "Paper 5 (vsf_anticorruption) needs its own 'Fierro of the financial domain' — an external
     expert who validates Q1-Q3 for banking transaction networks. Not as post-hoc review but as
     co-design of the empirical validation protocol. Without that S4 role, Paper 5 stays at the
     level of theoretical argument.",
}

// ─── TABLE OF KNOWN INSTANTIATIONS ───────────────────────────────────────────

instantiations = {

  vsf_nucleus: {
    domain:  "software kernel (compute system in ℝ¹²⁸)",
    Q1:      "DONE — convex polytope, axioms A0..A6 as Ax≤b",
    Q2:      "DONE — Lip≈0.85 on Ω_A, EXP-LYAP-CERT confirmed 2026-06-03",
    Q3:      "DONE — σ_max=0.42, margin 1.86×, EXP-AB-01+TC-01",
    status:  "VALIDATED — architecture trustworthy, Paper 1 defensible",
  },

  // debt(FIERRO-KRASNOSELSKII-CHECK, class=external, owner=rmw3, gate=fierro)
  // Q1 cites Krasnoselskii for a MINIMUM on a compact convex space.
  // Weierstrass is the usual citation; Krasnoselskii is FIXED-POINT.
  // Both may be meant — a fixed point of f₀ ≢ a minimum of L.
  // Fierro's recorded answer, ¬ours to rewrite. Ask him; a reviewer will.

  // debt(BANKING-Q1Q3, class=external, owner=rmw3, gate=institutional_data)
  // Q1-Q3 unanswered for banking ⟹ P5 (vsf_anticorruption) undefendable.
  // Needs an institutional collaborator with real data — Fierro's S4 role
  // for Paper 1, as CO-DESIGN of the protocol, ¬post-hoc review.

  vsf_banking: {
    domain:  "financial transaction network",
    Q1:      "PENDING — define state vector + Ω_banking constraints",
    Q2:      "PENDING — calibrate Lip from historical transaction data",
    Q3:      "PENDING — EXP-TDA-BANKING (synthetic data with ML patterns)",
    status:  "BLOCKED — requires an institutional collaborator with data (Paper 5 prereq P3)",
    gate:    "prerequisite P3 in @dir_papers vsf_anticorruption/seed.vsm",
  },

  // template for future instantiations:
  template: {
    domain:  "<domain>",
    Q1:      "PENDING — define V(domain) = state + Ω + constraints",
    Q2:      "PENDING — calibrate Lip — empirical or theoretical analysis",
    Q3:      "PENDING — certify σ_max — controlled perturbation experiment",
    status:  "PENDING Q1-Q3",
  },
}

// ─── CERTIFICATION PROTOCOL (EXECUTIVE SUMMARY) ──────────────────────────────

certification_checklist = [
  "Q1 ✓ — Ω formally defined as a convex polytope (or the domain's equivalent)",
  "Q2 ✓ — contractivity Lip<1 on Ω_A certified (empirically or analytically)",
  "Q3 ✓ — σ_max known; safety margin ≥ 1.5× over the minimum threshold",
  "EMBED ✓ — Q1→Omega::canonical(), Q2→Lyapunov certifier, Q3→algedonic threshold",
  "REVIEW ✓ — an external domain expert validated Q1-Q3 (external S4 role)",
]

// Without full certification: viability claims are arguments, not results.
// With full certification: the architecture has mathematical and empirical footing,
// and the papers are defensible under academic review.

⟦ /domain_validation_protocol ⟧
