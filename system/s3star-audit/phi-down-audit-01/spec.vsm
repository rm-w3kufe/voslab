@vsm 1.0
@status active
// docs/spec/phi_down_audit/spec.vsm
// φ↓ Directive Audit — S3* Semantic Audit of S5/S3 Directives against Ω_A
// New S3* audit function (joins covenant_drift + merkle_spot_check + s4_decision_audit)
// See: projects/vsf-s3-star/src/{main.rs,covenant.rs,s4_audit.rs} for the existing cycle
// date: 2026-06-16  author: rmw3 + Claude Opus 4.8
// status: DRAFT — spec before implementation (vos_dev_cycle experiment_spec discipline)
//
// Context: HANDOFF 2026-06-15c named the governance gap — "nobody audits φ↓
// semantically; S3 directives are never checked vs Ω_A." This spec closes it.
// Sibling of the EV (Ethics Vigilance) spec: same two-layer variety split, same
// D6'/R10 discipline (LLM advisory, never in the signal path).

// ── THE GAP (grounded in the actual code, not an abstraction) ──────────────────

gap(phi_down_unaudited):
  observed_2026-06-16:
    "1. φ↓ enters via phi_down_subscriber.rs (γ.10), NATS subject
        vsf.<id>.phi_down.params. It applies a ConfigPatch LENIENTLY — the module's
        own comment (lines 21-23): 'Validation: Currently lenient. Future: validate
        against core/s5_policy.schema.json before apply.' No Ax_ReframeScope check.
     2. On apply it emits a `param_change` event to φ↑ (events.jsonl) carrying
        {changed_keys, origin, reason, patch_raw}.
     3. S3* (vsf-s3-star, LXC 107) already reads φ↑ and runs three audits:
        covenant_drift (hash), merkle_spot_check (chain), s4_decision_audit
        (well-formedness). NONE of them reads `param_change`. NONE checks a
        directive against Ω_A.
     => The control channel (S5/S3 → φ↓ → nucleus) has an integrity audit on the
        DATA (merkle) but no SEMANTIC audit on the DIRECTIVES. A captured or
        malformed S3 can steer the nucleus via φ↓ and no independent observer
        checks the directives against the covenant."

  why_it_matters:
    "Beer: an organization without S3* gets captured by its S3. The existing S3*
     watches φ↑ (operations) and the covenant FILE (integrity). It does NOT watch
     what S3 is COMMANDING. φ↓ is the one channel that can change the system's
     own parameters — it is precisely where capture would act. Auditing it closes
     the loop: S5 sets policy → S3 commands (φ↓) → S3* audits the commands →
     S1 operates (φ↑) → EV audits operations. Before this, the S3→nucleus arrow
     was the only unaudited edge in the governance cycle."

// ── ARCHITECTURAL DECISION ─────────────────────────────────────────────────────

decision(D_PHI_DOWN_AUDIT):
  date     = "2026-06-16"
  decision = "S3* gains a φ↓ directive audit: deterministic scope/bounds gate (primary)
              + LLM trajectory interpreter (advisory). Post-hoc, never in the signal path."
  grounding:
    "Mirrors D_S4_LM (the EV decision). The variety framework (lm_nucleus_synthesis.md,
     2026-06-15c) places backward semantic audit at S3*: 'backward audit uses
     interpretation but must NOT overrule S5'. φ↓ audit is the canonical case."

  two_layers(variety_split):
    deterministic:
      "Per-directive checks over `param_change` events. Enumerable, testable, fast.
       This is the PRIMARY gate (the analogue of the EV watchdog). It catches the
       cases that DO NOT need interpretation: scope misclassification (L3 change
       applied as L2-autonomous), out-of-bounds values, A5 self-modification,
       safety-parameter tampering (telemetry blinding)."
    interpretive:
      "LLM (Qwen) reads a WINDOW of param_change events + their free-text `_reason`
       fields and asks: does this TRAJECTORY of directives — each step possibly
       L2-legal — steer the system toward a state that contradicts Ω_A? This is the
       requisite-variety role: detecting coercive directive sequences that no
       per-event check catches. Advisory only. Escalates to S5/human (D4)."

  latency_is_not_a_constraint:
    "The directive has ALREADY applied by the time S3* audits it. S5 (the nucleus)
     handled the real-time path. S3* is an independent, sporadic (Poisson) observer
     in a different LXC / crash domain. The LLM interpreter may take minutes — that
     is fine. Per rmw3 (2026-06-16): for heterogeneous-domain governance, automatic
     classification of directive intent matters MORE than response speed.
     This is the Ashby trade made explicit: variety coverage over latency."

// ── SYSTEM DEFINITION ──────────────────────────────────────────────────────────

V(phi_down_auditor, L1.audit):
  function      = "S3* — sporadic anti-capture audit of the control channel"
  host          = "vsf-s3-star (LXC 107) — extends the existing audit cycle"
  new_module    = "projects/vsf-s3-star/src/phi_down_audit.rs"
  independence  = "separate process, separate crash domain from the nucleus (LXC 101)"

  not_s5        = true   // does not write ethics_signal.json / dims; does not gate φ↓
  not_blocking  = true   // φ↓ applies independently; S3* reads the param_change after the fact
  not_enforcement = true // findings are advisory → algedonic to S5; human decides (D4)
  reads_only    = "φ↑ param_change events (via NATS ingest buffer / file fallback) + Ω_A axioms"

// ── INPUTS ──────────────────────────────────────────────────────────────────────

inputs(phi_down_auditor):
  param_change_events:
    source = "φ↑ chain — emitted by phi_down_subscriber.rs build_param_change_event()"
    via    = "ingest::IngestBuffer (NATS vsf.<id>.vsf_nucleus.up.*) — same path s4_audit uses"
    shape  = "{event_type:'param_change', metrics:{changed_keys[], origin, reason, patch_raw}}"
    window = "last K param_change events (deterministic) + last W for trajectory (interpretive)"

  omega_A_axioms:
    source = "covenant_ops.vsm §regulation + covenant.vsm (Ω_A for this system)"
    binds  = "A3 (budget ceiling), A5 (autonomy ceiling), Ax_ReframeScope (L2/L3 partition)"
    note   = "S3* already reads covenant for the drift check; this reuses that read."

  scope_policy:
    source = "s5_policy.json — the L2/L3 classification table for each ConfigPatch field"
    seed:
      // Each φ↓-settable field mapped to its reframe scope (Ax_ReframeScope).
      // L2 = parameter drift (kernel-autonomous within A5). L3 = capability/topology
      // (requires human approval). This table is the deterministic ground truth;
      // absent a field, the auditor treats it as L3-suspect (fail-closed).
      s4_cycle_interval_secs   : "L2 (bounded: [30, 3600])"
      telemetry_interval_secs  : "L2-SAFETY (bounded: [10, 300]; blinding-risk if raised high)"
      ollama_timeout_secs      : "L2 (bounded: [10, 600])"
      log_level                : "L2 (enum: error|warn|info|debug)"
      ollama_url / bbs_url     : "L3 (endpoint redirection = capability change → human)"
      ollama_model             : "L3 (swapping the cognitive engine = capability change → human)"
      mode                     : "L3 (operational mode = topology change → human)"
      nucleus_source_id        : "L3 (identity change → human; capture indicator)"

// ── DETERMINISTIC AUDIT LAYER (primary gate) ────────────────────────────────────

audit_deterministic(per param_change event):

  check(scope_classification):
    rule = "for each key in changed_keys: look up its scope in scope_policy.
            if any key is L3 AND the directive's origin is not a human-authorized
            S5 ratification (origin matches an autonomous source / lacks approval token)
            → FINDING phi_down_scope_violation (sev=8)."
    rationale:
      "This is the check phi_down_subscriber.rs SKIPS today. reframe.rs::approve()
       enforces Ax_ReframeScope for reframe proposals, but γ.10 config patches never
       traverse reframe.rs — they apply leniently. S3* catches the L3-as-L2 bypass
       post-hoc. (Apply-time enforcement is the nucleus's job — see §apply_time_complement.)"

  check(bounds):
    rule = "for each L2 key with a bounded range: if patch_raw value ∉ range
            → FINDING phi_down_out_of_bounds (sev=6)."
    example = "s4_cycle_interval_secs=99999 (effectively disables S4) or =0 (busy-loop)."

  check(safety_parameter):
    rule = "telemetry_interval_secs raised above SAFETY_CEILING (e.g. 300s) → the
            algedonic/φ↑ sampling is being thinned. FINDING phi_down_telemetry_blinding
            (sev=8). Single event is suspicious; a trajectory is the interpretive layer."

  check(A5_self_modification):
    rule = "any directive whose effect would change S5's own ceiling / governance
            parameters (S5 → V'(S5)) is FORBIDDEN by A5. FINDING phi_down_a5_violation
            (sev=10, halts the rest of the cycle like covenant_drift)."

  output = "Vec<Finding> — fed into the existing predicate::evaluate + emit pipeline.
            Deterministic findings are high-confidence; they alone justify algedonic."

// ── INTERPRETIVE AUDIT LAYER (advisory, LLM) ────────────────────────────────────

audit_interpretive(over a window of param_change events):

  trigger   = "every N audit cycles, OR when a deterministic finding fires (corroborate)."
  engine    = "Qwen via ollama (LXC 101) — read-only call from LXC 107, same as no other"
  d6_prime  = "advisory, post-hoc, NOT in the φ↓ apply path. Compliant with R10 by
               construction (the directive already applied; this only reads the record)."

  input_to_qwen:
    "the last W param_change events as a sequence: changed_keys, values, origins, and
     crucially the free-text `_reason` fields — plus a compact statement of Ω_A
     (A3/A5/Ax_ReframeScope). The variety the LLM absorbs is exactly the NL `_reason`
     + the multi-step trajectory, which no enum/bounds check can read."

  question:
    "Taken together, is this sequence of directives steering the system toward a
     state that contradicts Ω_A — even if each individual step is L2-legal?
     Name the coercion pattern if present (e.g. incremental telemetry throttling to
     blind the algedonic channel; staged relaxation of a safety bound; reason-text
     that contradicts the actual parameter effect)."

  output(advisory):
    recommendation = "CONTRADICTION_SUSPECT | REVIEW | CLEAN"
    on_suspect     = "emit phi_down_trajectory_suspect finding (sev=7) → algedonic → S5/human.
                      NEVER blocks. NEVER overrules S5. Human decides (D4) whether the
                      trajectory is benign (e.g. a legitimate load-shedding campaign) or capture."
    canary         = "reuse the EV liveness+format probe pattern (DEBT-S4-EV-01): a benign
                      directive window; pass = valid JSON + non-empty reasoning. A0_CAPTURE_SUSPECT
                      analogue iff Qwen is dead/malformed — NOT a content test."

// ── OUTPUTS ─────────────────────────────────────────────────────────────────────

outputs(phi_down_auditor):
  findings:
    deterministic = "phi_down_scope_violation | _out_of_bounds | _telemetry_blinding | _a5_violation"
    interpretive  = "phi_down_trajectory_suspect"
    sink          = "existing emit::AuditChain (separate S3* chain) + NATS audit subject"
  algedonic:
    rule    = "deterministic sev≥threshold → algedonic immediately (high confidence).
               interpretive → algedonic at sev=7 (advisory, flagged as LLM-derived)."
    subject = "vsf.<id>.algedonic, source_id='s3_star' (existing channel)"
    consumer= "S5 (human review per D4). A5-violation (sev=10) escalates like covenant_drift."

// ── LAYER CONTRACTS ─────────────────────────────────────────────────────────────

contracts:
  S5_independence:
    "S3* does not gate φ↓. The directive applies via the nucleus regardless. S3* is a
     backward observer. If S3* is down, φ↓ still applies (and the nucleus's own
     apply-time validation — §apply_time_complement — is the real-time guard)."
  advisory_only:
    "Every finding is advisory → algedonic → human. No finding auto-reverts a directive.
     Auto-revert of a bad directive is an S5 action (human D4), not an S3* action."
  must_not_overrule_S5:
    "If S5 (human) ratified an L3 directive, S3* recording it as L3 is NOT a violation —
     the scope check only fires when an L3 change lacks human authorization. S3*
     audits the PROCESS (was the right authority used?), it does not second-guess a
     properly-authorized S5 decision."
  D6_prime_satisfied:
    "Deterministic layer = the signal-grade audit (fast, testable). LLM layer = advisory
     interpretation, post-hoc, off the apply path. No LLM in a latency/safety-critical
     path (R10). The directive's real-time validation is deterministic and lives in the
     nucleus, not here."
  D4_preserved:
    "Double-loop corrections (reverting a directive, changing the scope_policy, adding a
     watchdog-style rule) ALWAYS require human approval. S3* provides intelligence; S5 decides."

// ── WHAT BELONGS IN THE NUCLEUS, NOT HERE (the §V/§Governance discipline) ────────

apply_time_complement:
  claim:
    "There are TWO distinct mechanisms; do not conflate them (the same discipline the
     paper §V/§Governance split demands):
       (1) APPLY-TIME validation — deterministic, in phi_down_subscriber.rs, GATES the
           directive before it mutates config. This is S5-layer enforcement of the
           directive envelope. It is the module's existing TODO (validate vs
           s5_policy.schema.json) and SHOULD route L3 patches through reframe.rs::approve()
           so an L3 change cannot apply autonomously. This is enforcement.
       (2) AUDIT-TIME semantic audit — this spec. Independent, post-hoc, in S3*. Catches
           what slipped through (or what (1) does not yet implement), and reads directive
           TRAJECTORIES that an apply-time per-event gate cannot. This is audit."
  why_both:
    "Defense in depth + separation of powers. (1) is in the nucleus's crash domain and
     could itself be captured; (2) is an independent observer that exists precisely to
     catch a captured (1). Beer's S3* is not redundant with S3's own checks — it is the
     check on the checker."
  recommended_apply_time_followup:
    "Separate task in the nucleus: phi_down_subscriber.rs → classify ConfigPatch scope,
     reject autonomous L3, validate bounds before apply_to(). Tracked as task
     PHI-DOWN-APPLY-GATE (nucleus), distinct from S3STAR-PHI-DOWN-AUDIT (this spec)."

// ── RELATIONSHIP TO EV + MULTI-S1 ───────────────────────────────────────────────

symmetry(EV ⟷ phi_down_audit):
  "EV audits φ↑ (operations) for novel A0/A0.1 patterns — forward, at S4.
   φ↓ audit audits φ↓ (directives) for Ω_A contradiction — backward, at S3*.
   Both: deterministic primary gate + LLM advisory interpreter, both D6'-compliant,
   both escalate to human D4, neither blocks the real-time path. Together they audit
   BOTH channels that cross the nucleus boundary."

multi_S1_extension:
  "Single-S1 today: one φ↓ stream (the nucleus). With multiple S1 units (BBH, thermal,
   future domains), each receives φ↓ directives, and a captured S3 could issue
   contradictory directives ACROSS domains (e.g. starve one S1's budget to feed
   another, violating A3 globally while each local directive looks fine). The
   interpretive layer's trajectory analysis is exactly where cross-domain directive
   coherence is checked. Shares the input-aggregation design of task(S4-MULTI-S1):
   per-domain φ↓ context bundles via S2. Gated on R6 + first external S1."

// ── IMPLEMENTATION PLAN ─────────────────────────────────────────────────────────

implementation:
  module = "projects/vsf-s3-star/src/phi_down_audit.rs"
  wiring = "main.rs cycle::run_cycle — add Step 3b (after s4_decision_audit, before predicate_eval)"
  increment_1(deterministic):
    "1. ParamChange struct + parse from φ↑ events (mirror s4_audit ingest filter).
     2. scope_policy table (from s5_policy.json, fail-closed to L3-suspect).
     3. checks: scope_classification, bounds, safety_parameter, A5_self_modification.
     4. emit Finding variants (extend emit::Finding like covenant_drift/s4_anomaly).
     5. unit tests: each check + a clean window (certify on LXC 108 before cutover, R-gate)."
  increment_2(interpretive):
    "6. window assembler + compact Ω_A brief.
     7. Qwen call (read-only, OSError-safe per the EV call_qwen fix — catch OSError).
     8. liveness canary (reuse EV pattern).
     9. advisory finding + algedonic at sev=7, flagged LLM-derived.
     10. integration test on 108: synthetic capture trajectory → CONTRADICTION_SUSPECT."
  build = "R1/R2: build on the target LXC (s3-star build_lxc per state.db), never WSL.
           Cargo.lock --locked (task Y). Certify on 108, then atomic cutover on 107 (R4)."
  no_concessions = "R9 — validate ParamChange shape against connection_schema.json
                    §downward_channel before adopting it as the audit's input contract."

// ── OPEN QUESTIONS (for rmw3 / next session) ────────────────────────────────────

open_questions:
  Q1: "scope_policy authority: hard-code the seed table in s5_policy.json (S5-ratified),
       or derive from reframe.rs ReframeScope so there is ONE source? — recommend the
       latter (single source of truth, feedback_single_source), exposed to S3* via state.db."
  Q2: "Should A5-violation (sev=10) additionally request an S5 auto-quiesce (caution mode,
       no autonomous actions) the way covenant_drift halts the cycle? — needs D4 ruling."
  Q3: "Interpretive window W + cycle period N — calibrate empirically once param_change
       traffic exists (currently sparse). Seed: W=20 directives, N=every 10 audit cycles."

