@vsm 1.2.1
@status active
// s3star-audit/s3star_audit.vsm — S3* AUDIT CHANNEL (sporadic direct channel + self-audit
// + epistemic independence + masked-alert RCA + instrument catalogue)
// Fused from (4 source groups, 1364 lines → this file):
//   @src_monitoring_instr                         (catalogue, ~500 lines)
//   + @src_s3star_epistemic                       (von Foerster design)
//   + @src_masked_alerts_rca                      (4 RCAs)
//   + @dir_self_audit/{alg_dedup,autoimmune_test,diverse_verifier,dyn_llm_grant,
//     nucleus_restart_seam,recon_bidirectional,triage_evidence}.spec.vsm
// STATUS note (fuse-level correction): PMC/a 2026-08-04 ratified S3* as a
// CHANNEL — it audits across recursion levels, it is NOT level-1. V(id,L) ::=
// ⟨S1,S2,S3,S4,S5⟩ @ E(L); S3* ∉ that tuple. Any source doc that models S3* as a
// sixth VSM element carries a DEFECT — corrected here, provenance: see A1/P17
// (vos_core_theory.vsm recursion axiom): "S3* is a CHANNEL, ¬a subsystem".
// CERTIFIED 2026-08-09 (claude_review). Three findings — a French word that
// D7 structurally cannot see, a score above S3's own ceiling, and two
// subtractions I had told DS to write WRONG. See the notes at each site.

spec(S3STAR-AUDIT) {

  // ── §1 IDENTITY — canal, ¬subsistema ──
  identity: {
    model:     "S3* = sporadic direct audit channel (Beer). Bypasses S3 routine
                path: sees what φ↑ cannot/will not show. Cross-level by design."
    axiom:     "CITE A1/P17 (¬rewritten): ∀ S ∈ {S1,S2,S3,S4}(V):
                 complexity(S) > variety_ceiling(S) → S → V′(S)
                 ::= ⟨S1′,S2′,S3′,S4′,S5′⟩ @ E′; S3* ∉ tuple."
    correction:"source docs that list S3* among subsystems (sixth element): fuse
                defect, corrected here — provenance A1/P17 line 217."
    recursion: "S3* audits ACROSS levels (parent, child). Per level_direction:
                cite A1 + name ROLES (parent, child); ¬ index rewriting
                (L±1 inverted 3× in prose). parent reads child φ↑; child reads
                parent state ⊥ (R13)."
  }

  // ── §2 INSTRUMENT CATALOGUE (S3* rows of @src_monitoring_instr) ──
  instruments: {
    // FIELDS: trigger · role · algedonic_path · reconcile_ready · status
    topology_reconcile: "timer ~5min n02 · CENSUS: state.db ↔ Proxmox bijection;
                         orphan LXCs, missing svc, flap, payload anomalies ·
                         vf.alpha.algedonic on drift · yes · live"
    vsf_state_populate: "timer · REFRESH: keeps state.db lxcs/services/topology
                         current between deep censuses · none (silent) · yes ·
                         live · gap: refresh failures silent"
    s3star_kpi:         "cron 10min LXC107 · KPI POLLER: stasis_cos/trust/regime
                         vs norm.vsm; out_of_norm, poll_stall, param_change
                         integrity, experiment overdue · algedonic on
                         governance_violation + experiment_overdue · yes · live
                         · gap: out_of_norm local only (¬algedonic)"
    sa_auditor:         "cron 6h LXC107 · SUBJECT AUDITOR (Qwen): NATS subjects
                         vs nats_topic_schema; unregistered + A4 violations →
                         audit_flag.vsm · via s4.store · yes · live · ollama dep"
    s3star_spotcheck:   "cron n02 hourly :17 · SPORADIC PROBE: samples subset of
                         invariants (different each hour) → log + algedonic on
                         anomaly · partial · live · gap: log-only ∉ state.db"
    check_binary_integrity: "cron n02 daily 03:00 · BINARY HASH: SHA256 vs
                         state.db deploys (M6) · algedonic on mismatch · yes ·
                         live · gap: ¬events.jsonl chain (see gaps)"
    vsf_auditd:         "timer n02 (Poisson) · RECOVERY EXERCISE: random gate,
                         execute, record state.db.audits · unknown (verify) ·
                         partial · live · gap: exercise-failure alarm unverified"
    // debt(LOCAL-RESILIENCE-SILENT, class=kernel, owner=DS, gate=system_certified)
    // THREE instruments in this table degrade LOCALLY and say nothing upward:
    // refresh failures silent ▪ out_of_norm local only (¬algedonic) ▪ log-only
    // ∉ state.db. Same pattern the incident record already names as recurring:
    // a local watchdog that works perfectly and never escalates is a detector
    // the system does not have. One fix class, three sites.
    // decommissioned (BBS era): vsf_bbs_poller — history, ∧v deferred 2026-08-02
  }

  // ── §3 EPISTEMIC INDEPENDENCE (von Foerster) ──
  epistemic: {
    problem:   "observer sharing its source with the observed cannot certify it:
                 signal/noise is the observer's construction. S3* reading the
                 SAME events.jsonl as S3 can only re-confirm S3's account.
                 Genuine audit needs ≥1 source the lower level does not control."
    physical: {
      what:   "substrate reality: CPU temp, loadavg, memory (env_sample).",
      source: "host kernel (/sys/class/thermal, /proc/loadavg) read from DIFFERENT
               LXC (107), ¬controlled by nucleus (101).",
      status: "DONE — host_probe.rs (07b9693): divergence > 15°C or 3× load →
               finding. Ceiling: same host (n02) = shared crash domain; true
               external observer needs 2nd host.",
    }
    emission: {
      what:   "did nucleus actually EMIT what local events.jsonl claims? A
               captured nucleus writes self-consistent (Merkle-chained) log
               while emitting zero/different values.",
      source: "NATS broker (LXC 106) records what it really RECEIVED — nucleus
               does not control broker counters.",
      status: "PRIMARY GAP — Merkle proves local consistency, not wire truth.
               Highest-value, fully-independent, cheap.",
      // debt(S3STAR-BROKER-PROBE, class=kernel, owner=DS, gate=system_certified)
      // broker_probe.rs is UNBUILT. Until it exists, S3* can certify that the
      // nucleus is internally consistent while the nucleus emits nothing —
      // the Merkle chain is happy either way. The broker (LXC 106) holds the
      // one count the nucleus does not control. Cheap, fully independent, and
      // the highest-value audit gap open.
      fix:    "broker_probe.rs — compares broker received-count vs nucleus
               claimed count per window + last seq/ts.",
      findings: [
        "emit_silence: log advances, broker received 0 → capture/partition. sev=7",
        "emit_count_divergence: |broker − claimed| / claimed > 0.25, ≥ 2 windows.
         sev=6",
        "emit_stale: broker last-receive older than N ticks while log claims
   recent. sev=7",
      ]
    }
    semantic: {
      what:   "is the MEANING assigned correct (stasis_cos=0.92 actually implied
               by published vector vs ratified Ω)?",
      source: "PARTIAL — re-derive stasis_cos from published vector with Ω held
               independently by S3*, compare.",
      // debt(S3STAR-SHADOW-RECOMPUTE, class=kernel, owner=DS, gate=system_certified)
      // Nothing re-derives stasis_cos from the PUBLISHED vector against an
      // independently held Ω. Without it, a wrong MEANING passes every
      // structural check: the chain is intact, the broker agrees, and the
      // number is still a lie. Sporadic 1-in-K (K~20, jittered) is enough.
      status: "GAP — recompute-and-compare not implemented. fix:
               shadow_recompute (sporadic, 1-in-K ticks K~20 jittered): Ω loaded
               from S5-ratified source ∧ tensor published in φ↑. finding:
               |recomputed − claimed| > ε (ε ~ 0.02) → sev=8 (mis-reporting).",
      honest: "nucleus faking BOTH vector+scalable → recompute agrees → passes.
               Joint (chain+broker+recompute) makes consistent triple-fake the
               residual risk — von Neumann ceiling for self-reporting system.",
    }
    // debt(S3STAR-TIER4-EXTERNAL, class=human, owner=rmw3, gate=key_provisioning)
    // A physically external observer on n01. Blocked on key provisioning, ¬on
    // design. Worth A ≈ 3.5 → 3.8 and explicitly ¬required for the ceiling —
    // declared so "not required" stays a JUDGEMENT on the record rather than
    // quietly becoming "forgotten".
    external:      "tier_4: physically external observer (n01) — DEFERRED
                   (key provisioning; lever A≈3.5 → 3.8; ¬required for ceiling)."
    decision:      "close emission + semantic on LXC 107 (max independence, not a 2nd
                   host). Accept tier_4 as documented honest ceiling. Sporadic
                   semantics per Beer: surprise audit, ¬continuous."
    acceptance: [
      "tier2: inject controlled emission gap (stop NATS pub, keep tick loop) →
       broker_probe raises emit_silence within 2 windows.",
      "tier3: inject hand-altered stasis_cos → shadow_recompute raises
       semantic_divergence next sampled tick (force-sample).",
      "regression: host_probe findings unchanged; suite green on 108.",
      "score: update architecture score S3 A 1.6 → 3.4 post-certify — S3's
       OWN per-system ceiling. The source said 3.5; that is S3*'s ceiling,
       ¬S3's, and S3 is capped at 3.4 because S3/S5 are collapsed on one host.",
    ]
  }

  // ── §4 MASKED-ALERT RCA (4 signals under 2060 rows) ──
  masked_alerts: {
    binding:    "RCA outcome may be 'detector wrong' — legitimate, but REACHED
               by evidence, never assumed. Wrong detector gets FIXED, ¬silenced
               (feedback_dont_blunt_the_audit). Each RCA states both-ways
               falsification."
    A_bastion: {
      P1:       "1440 rows/19 days: 'VSF Bastion API still DOWN (57 failures)
                expected 200, got 200' — self-contradictory message. H_A1: probe
                broken (checks beyond code, cry-wolf). H_A2: probe right, →
                wrong vhost / API not served. DO NOT assume H_A1: both produce
                this exact row. stakes: n01 = bastion = SPOF (R8) — worst
                19-day unread alert."
      method:   "read probe (vsf-peripheral-health.py), reproduce BY HAND (same
                Host, path, timeout), establish the EXPECTED response, adjudicate
                H_A1 vs H_A2 on that evidence. NEVER probe root at n01 — fails
                publickey BY DESIGN, ¬a finding (R8)."
      if_H_A2:  "LIVE OUTAGE on SPOF, 19 days old → STOP, escalate rmw3 via
                VSL. ¬fix under this spec (S5 decision).",
    }
    B_s4_empty: {
      P1:       "15 rows sev 4.0: s4_anomaly with empty first_action — NULL
                decision shipped as decision, 14 days. H_1-4: model eviction /
                ctx overflow (tail dropped) / timeout partial parse / parse
                defect. Test parse defect FIRST (cheap, bit us A week). Fix or
                DETECTOR that rejects empty action at emission. R10.1: enforce
                deterministically, ¬LLM."
    }
    C_temp_divergence: {
      P2:       "≈19°C sustained host-vs-nucleus CPU temp. S3* tier-1 epistemic
                independence WORKING. H_1: different sensors (package vs core);
                H_2: stale/wrong sensor path in LXC; H_3: unit/scaling. Sample
                both sources SIMULTANEOUSLY. PROHIBITED: widen tolerance to
                silence — that is feedback_dont_blunt_the_audit."
    }
    D_emit_divergence: {
      P2:       "buffer/nucleus emit divergence 16800% / 58100% sustained —
                ¬plausible as literal loss; mismatched window/unit OR large
                real gap. If real: φ⁴ broken, downstream sees fraction of
                reality. If metric: tier-2 probe ¬measuring what it claims —
                feeds q16 S3* score review. Instrument window by hand,
                adjudicate."
    }
    ordering: "A,B P1 (SPOF-flavored + intelligence defect); C,D P2 feed
               q16. parallel with q17 (channel readability); q17.phase_3
               blocked on A. reporting: one VSL envelope per RCA (evidence
               + observed value; 'probably fine' without probe = R12 reject)."
  }

  // ── §5 SELF-AUDIT SUITE (8 specs, @dir_self_audit) ──
  self_audit: {
    triage_evidence: {  // then: R12-algedonic closure
      rule:     "decision gains Evidence {question, probe, observed, supports};
                enforcement in review: handle-without-evidence →
                auto-escalated (evidence[] keeps ALL e.observed). 'escalate'
                never requires evidence (escalating is always safe).",
      merkle:   "E1 declared-writer (foreign 2× → NEVER auto-close) ∧ E2
                restart within 300s (services.active_since) ∧ E3 seam-shape
                (prev_hash=None ∧ index<5) — ONLY then close. Evidence mirrored
                to @s5_alerts_db (state.db services_mirror.json push (a)
                preferred; readers: LXC104 ∨ @s5_alerts_db RO).",
      R12:      "'rule' table — narrative-only dismissal prohibited; classifiers
                that attempt are auto-escalated; mirror RULES.md §R12.",
      acceptance: "0 auto-closes without evidence_json after deploy; unit
                handle-without-evidence auto-escalates.",
    }
    alg_dedup:      "fingerprint = sha256(type + '|' + detail_class)[:16];
                    detail_class normalizes hex=H, num=N, ts=T. Dedupe at
                    INSERT in subscriber (open row same fp within 7d → dup_
                    count++, no insert). Attached PROCEDURES runbook per type
                    (checklist in agent_note). Deploy-window inhibition: AX-
                    STATE deploys ±10min → classifier may close as deploy
                    artifact WITH deploy row as evidence. 105 identical breaks
                    → ≤ 3 distinct rows."
    autoimmune:     "weekly + manual post-deploy: pre-register {nonce, direction
                    (must_escalate | must_dismiss), expected, payload_sha} to
                    @exercise_register (fsync, append-only); inject DIRECT into
                    @ledger_db — chain stays virgin (Ax_ChainVirginity); eval
                    2× loop period: must_escalate PENDING_human = PASS /
                    agent-dismiss = FAIL + algedonic; must_dismiss agent-handled
                    = PASS. ALWAYS ack-closed (truthful closure). ≤10 synthetic/
                    mo; quarterly blindness grep nonce in classifier; rotate
                    marker yearly. Covenant-gated (§5, ratified 2026-07-02)."
    diverse_verifier: "reference exists (@diverse_verify_py, tested 60/60 v2_ok);
                DS scope = package/schedule/emit only — NEVER share code with
                vsf-agent crate (independence rule binding). Timer daily 04:30
                (n02): pct exec 101 tail events.jsonl → verify_chain_diverse
                --stdin; rc1 → algedonic cat: content_tamper|link_break → sev9,
                foreign_writer → sev8, restart_seam → sev4 (note: triage closes
                with restart evidence).",
    nucleus_restart_seam: "read_tail_hash reads file (¬full) — seek tail 64KB,
                    lossy decode (bad byte ¬poisons), last non-empty line. On
                    None → LOUD eprintln + first chain event chain_seam
                    {reason, prior_file_len} — seam becomes evidence. Unit: 3
                    file, 100MB reads tail O(64KB), invalid UTF-8 resilient,
                    empty → None+seam. Pyramid 108 → deployed (build only,
                    R4)."
    recon_bidirectional: "census only checks declared→running; missing half =
                    running→declared. sweep_undeclared(): long-lived (running∪
                    etime>1h) \\ declared \\ allowlist(DB). Canon surfaces
                    (fd/cwd under vsf / run/vsf ∪ @dir_algedonic_runtime) →
                    sev8 else 6. allowlist table in state.db (never hardcode).
                    dry-run → report → declare/allowlist (¬silence) → enable.
                    Known seed objects: s4_clima_bridge, s4_markov_bridge
                    (declared as components, feed S4 bundle)."
    dyn_llm_grant:  "S3-bargain extension for LLM memory (Jun-26 8G→1G downsize
                    killed Qwen silently, 6 days dark). SERVICE_FLOORS: while
                    floor condition holds (model loaded via api/ps non-empty),
                    effective min = baseline ∨ floor (clamp grant-revert/shrink).
                    Floor budgeted from declared host headroom
                    (HOST_RESERVE_MB, S5-set), NOT stress pool. Ω/S4-dark
                    trigger: N consecutive s4_ethics_scan failures ∨
                    omega.margin < threshold while api/ps shows load failures
                    → raise-to-floor + algedonic (DETERMINISTIC, R10 clean —
                    LLM is the patient, ¬the doctor). Reclaim below floor only
                    on api/ps empty ∧ ¬trigger 24h ∧ human/S5-initiated.
                    P1 floor clamp (prevents repeat) · P2 trigger · P3 state.db
                    floors + reclaim protocol (gated rmw3)."
  }

  // ── §6 COMPOSITION ──
  composition: {
    a1_cite:   "all recursion statements cite A1/P17 + named roles — §1 axiom,
                §3 dimensions (nucleus(102) parent), §5 recon (substrate
                reader parent)."
    pairs: [
      "triage_evidence ↔ autoimmune_test (harness certifies the evidence rule)",
      "broker_probe ↔ D_emit_divergence (same instrument, different lens)",
      "shadow_recompute ↔ s3_allocation §deciding_auth (deterministic floor)",
      "diverse_verifier ↔ nucleus_restart_seam (seam + restart = benign proof)",
      "monitoring_instruments ↔ s3star_kpi gaps (→ variety_metrics alert OPEN)",
    ]
    walls:      "headers R-..., D7, R4 evidence, R1 locality-deploy L108/L107."
  }

  // ── §7 GATES ──
  open_gates: [
    "epistemic: broker_probe (tier 2) + shadow_recompute (tier 3) — highest-
     value cheap fixes; 3.5 ceiling documented",
    "triage_evidence deploy (certify 108 → 104 → R12 acceptance[0]=0)",
    "autoimmune suite — covenant §5 cleared; build first, run vs known-bad
     (expect FAIL), then after triage deploy (expect PASS)",
    "recon_bidirectional dry-run → declare/allowlist protocol",
    "RCA A (bastion) — must resolve before channel migration (q17.phase3)",
    "RCA D verdict → feeds q16 S3* score review",
  ]
}

