// ─── G2 — ψ inter-system coupling (FULLY_CLOSED) ──────────────

decision(G2, "ψ as bilinear coupling operator with non-symmetric matrix"):
  selection: "B bilinear — ψ(x_A, x_B) = M_ψ · [x_A; x_B]"
  definitions:
    Def_ψ_Bilinear: "ψ: ℝ¹²⁸_A × ℝ¹²⁸_B → ℝ²⁵⁶_AB; M_ψ ∈ ℝ²⁵⁶ˣ²⁵⁶ non-symmetric (encodes VSM asymmetry)"
    Ax_ψ_Preserve:  "ψ(x_A,x_B) ∈ Ω_AB ⟺ x_A∈Ω_A ∧ x_B∈Ω_B ∧ trust_AB ≥ min(trust_A, trust_B)"
  handshake_timing: "PRECONDITION (synchronous bilateral S5.consents before coupling)"

  caveats_for_implementation:
    M_ψ_size:        "65k params; for N-system PSI growth = N²·128² → low-rank decomposition M_ψ = U·V^T necessary"
    projection_back: "ψ output ∈ ℝ²⁵⁶ — need explicit projection rule to update x_A, x_B individually post-coupling"
    suggestion:      "rank-bounded U,V with rank ≤ 16; explicit π_A, π_B back-projection operators"

  unblocks: "task(O) PSI/1.0 protocol spec"

// ─── G3 — Compositional viability theorem (FULLY_CLOSED) ──────

decision(G3, "compositional viability under budget arbitration + contractive coupling"):
  selection: "C — viable(V_A) ∧ viable(V_B) ∧ ∃S3_AB ∧ Σresources≤B_AB ∧ ‖J_ψ‖<1 ⟹ viable(V_AB)"
  arbiter_API:
    Def_ArbiterAPI: "{allocate(V_i, quota), report(V_i, usage), throttle(V_i, factor)}"
    pattern: "stateless function if N≤2; viable system V_arb if N>2 or dynamic topology"

  failure_corollaries:
    Cor_NoCompose_1: "Σ_i quota_i > B_hardware ⟹ ¬viable(⊗_ψ V_i)             (resource contention)"
    Cor_NoCompose_2: "∃ loop φ↑_A→B→A with gain>1 ⟹ ¬viable(⊗_ψ V_i)         (algedonic resonance)"
    Cor_NoCompose_3: "Δt_A/Δt_B ∉ ℚ ∧ no sync protocol ⟹ ¬viable(⊗_ψ V_i)    (phase aliasing)"

  caveats_for_implementation:
    Cor_3_pragmatic: "all real Δt are floats (rationals); replace 'irrational' with 'tolerance':
                      |Δt_A - Δt_B| > tolerance ∧ no sync ⟹ aliasing risk"
    Cor_4_proposed:  "trust mismatch: |trust_A - trust_B| > τ_threshold ⟹ revisit ψ.handshake"

  unblocks: "task(O) PSI multilateral; symbiogenesis_lab stage 2-4 viability claim"

// ─── G4 — Trust dimensionality (PARTIAL) ──────────────────────

decision(G4, "trust as 4-vector with weighted-sum + min-clamp composition"):
  selection: "B — trust ∈ [0,1]^4 = (behavioral, structural, predictive, communicative)"
  definitions:
    Def_TrustVector:  "trust ∈ [0,1]^4; per-axis monitoring + scalar aggregate for Ω-check"
    Def_TrustCompose: "trust_parent = min(Σ w_i·trust_i, min_i(trust_i)+ε); α from S3 allocation"
    Def_TrustUpdate:  "trust(t+1) = (1-λ)·trust(t) + λ·observation; λ = 0.1·(1+|ΔH|/H_max) ∈ [0.05, 0.2]"

  caveats_for_implementation:
    axes_overlap:    "behavioral ↔ predictive may correlate; PCA post-hoc may reveal effective rank < 4"
    ε_value:         "Def_TrustCompose has +ε without specified value; suggest ε = 0.05"
    per_axis_rules:  "EXP-TRUST-01 calibration needed for axis-specific λ_i and observation extractors"

  unblocks: "task(F1) vsf_topo.db schema (nodes.trust_vec column type)"

