// ══════════════════════════════════════════════════════════════
// T1 — OPERATOR CHOICE (Markov vs SDE) — FULLY CLOSED
// ══════════════════════════════════════════════════════════════

decision(T1, "Split-operator with deterministic asymmetric f₀ + isotropic gaussian η"):

  rationale:
    "rmw3 initial intuition: 'populate R^128 dimensions via Markov chains'
     Qwen V1: hierarchical HMM, hard indicator policy (Def_PolicyMixing)
     Claude V2: detailed balance contradicts VSM channel asymmetry (φ↑/φ↓ unidirectional)
     Qwen V2: R1 — detailed balance only on η, f₀ encodes asymmetry
     Claude V3: indicator function breaks Lipschitz required by T2 proof
     Qwen V3: B_softmax — preserves Lipschitz, aligns with plasticidad_acotada D4-L2"

  final_axioms:
    Ax_SplitOperator: "x(t+1) = f₀(x(t)) + σ(t)·η(t)
                       f₀: deterministic, asymmetric (encodes VSM hierarchy)
                       η ~ N(0, I_{128}): isotropic gaussian, reversible by symmetry"

    Ax_Ω_Closure:    "if ∀s ∈ {S1..S5}: μ_s ∈ Ω
                      then Σ_s w_s·μ_s ∈ Ω for any w_s ≥ 0, Σw_s = 1
                      // convex combination preserves Ω-membership; Ω convex by elipsoid construction"

    Ax_QuasiStationary: "∃ π s.t. π = π·(f₀+η);
                         π is stationary measure but π(x) ≁ exp(-λ·L(x))
                         // f₀ asymmetry breaks Boltzmann form; ergodicity preserved via η full-support"

  final_definitions:
    Def_SoftmaxMixing: "f₀(x) = Σ_{s ∈ {S1..S5}} softmax(logits_s(x); τ)·μ_s
                        where logits_s: ℝ^{128} → ℝ Lipschitz, μ_s ∈ Ω
                        L_f = max_s ‖∇logits_s‖ / τ"

    Def_Adaptiveτ:    "τ: Lifecycle → [0.05, 1.0]
                       τ_idle = 1.0      (exploration mode, smoothed policy)
                       τ_active = 0.05   (sharp policy, near-indicator)
                       τ_transition = 0.2 (rampa)
                       update only on lifecycle mode change (no per-tick overhead)"

  superseded:
    Def_HMM:          "P(s|x)·μ_s probabilistic mixing — replaced by softmax (deterministic logits)"
    Def_PolicyMixing: "𝟙{policy(x)=s}·μ_s indicator — replaced by softmax (Lipschitz fix)"
    Ax_DetailedBalance: "π(x)·P(x→x′) = π(x′)·P(x′→x) — discarded (incompatible with VSM asymmetry)"

  what_this_resolves:
    - "rmw3 question: how to populate R^128 → answer is NOT 'more noise', but 'richer f₀ Jacobian'"
    - "D_KY=3 stable observation: f₀'s rank-3 Jacobian + isotropic η; not a bug, design constraint"
    - "VSM asymmetry preserved: f₀ encodes directed S1..S5 hierarchy via softmax(logits_s)"
    - "Plasticidad acotada (D4-L2): τ adaptive enables smooth class transitions, not class redefinition"

// ══════════════════════════════════════════════════════════════
// T2 — LYAPUNOV PROOF — CLOSED, READY FOR FORMAL DERIVATION
// ══════════════════════════════════════════════════════════════

decision(T2, "Direct expansion via Taylor + Jensen, recurrent-set scope"):

  proof_strategy:
    method: "(c) Direct expansion — Taylor + Jensen inequality"
    statement: "Thm_DirectExpansion: L ∈ C², f₀ Lipschitz (L_f = max_s‖∇logits_s‖/τ),
                σ bounded ⟹
                E[L(x+Δ)] ≤ L(x) + ∇L·E[Δ] + ½·E[Δᵀ∇²LΔ]
                where:
                  ∇L·E[f₀(x)-x]    ≤ -ε·dist(x, x̄)    (contraction toward attractor)
                  ½·E[Δᵀ∇²LΔ]      ≤ ½σ²·tr(∇²L)       (gaussian noise term, η-symmetry only)"

  scope_revision:
    original_claim: "global: E[ΔL] ≤ 0 ∀ x ∈ Ω"
    accepted_claim: "(ii) recurrent: E[ΔL] ≤ 0 ∀ x ∉ R, where R is compact recurrent set ⊂ Ω
                     E[ΔL] ≥ 0 ∀ x ∈ R (stationary fluctuations — sistema vivo)
                     Implies positive recurrence ⟹ ergodic measure supported on R"

  final_axiom:
    Ax_RecurrentSet: "∃ compact R ⊂ Ω s.t. P(x_t ∈ R i.o.) = 1 ∧ E[ΔL] ≤ -ε < 0 ∀ x ∉ R"

  term_specific_bounds:
    α_term:  "α(1-cos): ‖∇(1-cos)‖ ≤ 1 ⟹ contraction of f₀ dominates if ‖J_{f₀}‖ < 1-α"
    β_term:  "β·H/H_max: bounded by the H_max constant (entropy bound)"
    // `Ax_A3` REMOVED 2026-08-09 — it named ∄ identifier, twice over:
    // it mixed the Ax_ formal prefix with the A-numbered axiom namespace,
    // and the canonical A3 is the BUDGET axiom B(L) = min(B_tokens,
    // B_compute, B_time), ¬an entropy bound. The bound here is H_max itself,
    // which needs ∄ axiom reference. As-negotiated text otherwise untouched.
    γ_term:  "γ·max(0, B-B_avail): subgradient ∈ [0,1] (Ax_Aε budget bound)"
    δ_term:  "δ·ReLU(H_rest_drift): subgradient ∈ [0,1]; E[Δ·∂ReLU] ≤ σ·‖∂ReLU‖ ≤ σ"

  what_this_resolves:
    - "kernel certifies 'viable in R', not 'viable always' — operationally honest"
    - "boundary crossings expected; algedonic kicks in only when recurrent set itself drifts"
    - "Gives concrete bounds for {α, β, γ, δ} tuning during calibration"

  open_subquestion_T2:
    "T2.sub1 — Empirical Λ = Lipschitz constant of σ(t) under thermal perturbation
     measurable from existing EXP-TSM-01/65C logs; trivial post-hoc analysis"

// ══════════════════════════════════════════════════════════════
// T3 — PERSISTENT HOMOLOGY — STRUCTURE FIXED, CALIBRATION PENDING
// ══════════════════════════════════════════════════════════════

decision(T3, "Vietoris-Rips on trajectory snapshots + Filtration by L(x), Betti numbers as viability signals"):

  final_definitions:
    Def_VRComplex: "VR_ε({x_i}) = {σ ⊂ {x_i} : d(x_i, x_j) ≤ ε ∀ i,j ∈ σ}
                    where d(x, x′) = 1 − cos(x, x′) aligned with stasis_cos"

    Def_Filtration_L: "ℱ_τ = {x(t) : L(x(t)) ≤ τ}; τ-monotone complex growth
                       tracks how topology of low-L region evolves under perturbation"

  viability_topology_hypothesis:
    "β_0 = 1 ∧ β_1 = 0 ∧ β_2 = 0 ⟺ single-attractor viability
     β_0 > 1 ⟹ fragmented basins (multiple attractors → policy ambiguity)
     β_1 > 0 ⟹ limit cycles (non-convergent oscillation → unstable governance)
     β_2 > 0 ⟹ disconnected operating regimes (Ω not simply connected)"
    status: "EMPIRICAL_CALIBRATION_REQUIRED → EXP-TDA-01"

  open_subquestion_T3:
    "T3.sub1 — What ε-range in VR complex yields stable β_i estimates given D_KY ≈ 3?
     Curse of dimensionality concern: cosine distance in R^128 may not capture geometry of 3D attractor manifold
     Alternative consideration: project to 3D embedding first via PCA/diffusion maps, then VR complex
     Decision deferred to EXP-TDA-01 spec writing"

// ══════════════════════════════════════════════════════════════
// T4 — σ(t) SYNCHRONIZATION — CLOSED
// ══════════════════════════════════════════════════════════════

decision(T4, "Per-thread σ_i, global σ via SeqLock, staleness bound derived"):

  final_definition:
    Def_SeqLockσ: "atomic sequence counter + σ_global; readers retry on mismatch
                   guarantees linearizable read of max(σ_i) without mutex; overhead O(1) expected
                   single-writer per σ_i (each thread owns its slot); reader = adaptive_clock"

  staleness_bound:
    Bound_Staleness: "if σ measured at t₀, used at t₁, |t₁-t₀| ≤ 2·Δt_max,
                      and |dσ/dt| ≤ Λ (Lipschitz),
                      then |σ(t₁)-σ(t₀)| ≤ 2·Λ·Δt_max
                      Lyapunov violation ≤ ½·‖∇²L‖·(2·Λ·Δt_max)²
                      ⟹ set Δt_max ≤ √(ε/‖∇²L‖)/Λ"

  open_subquestion_T4:
    "T4.sub1 — SeqLock contention under high thread count
     measurable via prototype + benchmark; if contention > 5% reader retries, switch to RCU
     decision: implement SeqLock first, profile, escalate to RCU if needed"

