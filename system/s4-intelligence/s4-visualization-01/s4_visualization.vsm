// s4-intelligence/s4_visualization.vsm — S4 VISUALIZATION LAYER (the opsroom projection)
// Fused from (6 sources):
//   @src_view_contract (v0.2.2, the view-module contract)
//   + @src_retrofit (the honest RAG-taxonomy retrofit)
//   + opsroom/modules/{cybernetic-rag,
//     system-topology,s3-viz}.module.json
//   + @dir_view_host {host.py,cybernetic_rag_view.py,system_topology_view.py,
//     s3_viz_view.py,qwen_mermaid_view.py}
// Companion: @s4_anticipation = DECISION layer (carries anticipation/CRAG/cognition
// + compressed view_contract block); THIS file = the PROJECTION surface — how S4
// renders itself to the human at the opsroom.
// CERTIFIED 2026-08-09 (claude_review). Two findings — see
// live_modules.cybernetic_rag.source_truth and .silent_fallback.
// R4: every claim cites module file ∨ source contract — nothing
// inferred from naming.

// ─── 1. THE TWO LAWS THE CONTRACT OBEYS ───
laws: {
  validation_loop: "VALID ⟺ (a) conforms @connection_schema @pinned_version
                    (version-checked, reject on drift — G-V1) ∧ (b) UPSTREAM SOURCE
                    AX-STATE-attested ∧ consumer verifies (sig + chain + freshness).
                    Legacy interface never base without loop (R9). View = PROJECTION —
                    certified by verifying source, ¬re-signing frames.",
  modularity:     "opsroom = HOST for modules; integrate/decommission cleanly.
                    Panel scaffold ¬load-bearing — one possible host; canonical =
                    MODULE ABSTRACTION. Cybernetic RAG = module #1, ¬the whole.
                    Enforced in host.py MODULES registry (module_id: () → tick
                    builders; integrate = add row + declare; decommission = remove).",
}

// ─── 2. THE MODULE ABSTRACTION (what is actually canonical) ───
module_abstraction: {
  definition: "module = self-describing, certifiable view unit, explicit lifecycle.
               Declared, ¬assumed.",
  manifest: "opsroom/modules/<module_id>.module.json — fields: module_id, version, title,
             lifecycle (proposed|active|decommissioned), coupling_subject, attest_subject,
             schema_ref (@connection_schema/0.2.1 + view-module/0.2), certifier (ed25519:<key>).
             certifier_status distinguishes REAL keys (C1 custody: kernel-keyring/age +
             offline S5 cert) from ephemeral dogfood keys — 'pending' ≠ 'certified'.",
  integration:   "declare coupling_registry row (kind=phi_channel) + host subscribes.",
  decommission:  "retire row + unsubscribe; host reflows (no dangling panel).",
  model_reality: "ACTIVE module ∧ ¬live verifying feed ⟹ ORPHAN (S3* topology_reconcile
                  catches it). Module ¬declared ∧ emitting ⟹ MISSING. Host renders
                  ONLY declared+certified. certified=False ⟹ degraded, never blindly
                  healthy (host.py /modules error path sets certified: False).",
}

// ─── 3. TRANSPORT — the φ↑ source is the events.jsonl FILE ───
transport: {
  correction: "v0.2.1 wrongly assumed NATS for φ↑. VALIDATED vs reality
               (2026-06-05): canonical φ↑ channel per @connection_schema =
               upward_channel.file = telemetry/{system_id}/events.jsonl — hash-chained
               append-only FILE (prev_hash/hash per line, S3*-validatable). Live source:
               /var/lib/vsf/vsf_nucleus/events.jsonl on LXC 101.",
  nats_role:  "NATS Core = ALGEDONIC carrier only (vsf.{vsf_id}.algedonic, the binary
               urgent signal) — NOT the φ↑ telemetry stream.",
  read:       "view-host reads events.jsonl READ-ONLY (bind-mount into
               view-host LXC — same pattern SCADA used for state_db). No NATS in φ↑ path.",
  integrity:  "verify Merkle chain linkage of tail (prev_hash == previous.hash) — the
               @connection_schema integrity floor. Ed25519 SIGNING of φ↑ = deeper layer
               (nucleus signs events = PROD-A1b / C1 key custody).",
  browser:    "view-host serves projection over minimal SSE (stdlib); browser
               never touches source.",
}

// ─── 4. CERTIFICATION BELONGS TO THE SOURCE, NOT THE PROJECTION ───
certification: {
  principle: "view = DERIVED projection, ¬source of truth — must NOT re-sign /
              re-chain every frame (costly + conceptually wrong: attest SOURCES, not
              projections). Certified, hash-chained surface = nucleus φ↑ telemetry
              itself (@connection_schema upward_channel + AX-STATE attested).",
  live_tick:  "NATS Core, high-frequency, UNSIGNED — drives smooth display only. Carries
               module_id, view body, ts, source_ref → attested upstream
               checkpoint it was projected from.",
  snapshot:   "visualizer verifies UPSTREAM SOURCE attestation (sig + chain +
               freshness, reusing AX-STATE state_verify) at a CADENCE (snapshot, not
               per-frame). UI shows 'certified as of <ts>'; stale/failed/forged →
               degraded/algedonic, never blindly healthy.",
  honesty_flag: "flag implemented: true|partial|false stays in each node. No fabricated
               variety_delta / algedonic_seq / per-tick hash on a projection — those belong to
               the emitting regulator, ¬a read-only projection.",
}

// ─── 5. THE CYBERNETIC RAG VIEW BODY (module #1) ───
view_body: {
  global: "viability, in_omega, lyapunov{L,dL,converging}, last_algedonic.",
  nodes:  "id,label,stage,sublevel(A|B),status,implemented,metrics,
           actions(read-only).",
  edges:  "from,to,kind(flow|feedback),state(active|firing|
           idle|aspirational),guard.",
  stages: "retrieval(A) → gate(Ω) → generation → evaluation → recovery → crosscheck → output.",
  field_map: {   // synthetic stub → real nucleus source (φ↑) — swap never touches visualizer
    "global.viability":    "stasis_cos (operator.rs)",
    "global.in_omega":     "Omega::canonical().violations(state).is_empty() (omega_validator.rs)",
    "global.lyapunov":     "LyapunovTracker per breath cycle (attractor.rs)",
    "global.last_algedonic": "vsf.{id}.algedonic NATS subject (already published)",
    "crosscheck.metrics.reconciled": "topology_reconcile exit (S3*)",
    "trust_score / hash chain": "per @connection_schema upward_channel",
  },
}

// ─── 6. THE VALIDATION GATES (concrete, from the contract) ───
gates: {
  G_V1_version:     "schema_ref pins @connection_schema version; reject on drift vs live file.",
  G_V2_conformance: "live tick carries valid provenance (source_ref + ts + system_id); view
                      = projection, so it needs NO emitter event_schema
                      (variety_delta/algedonic_seq/per-tick hash).",
  G_V3_attestation: "UPSTREAM SOURCE checkpoint verifies (sig + chain + freshness) under the
                      source certifier key (AX-STATE state_verify). View itself is not
                      re-signed.",
  G_V4_declaration: "module = coupling_registry kind=phi_channel row (model≡reality; else
                      ORPHAN).",
  failure:          "module failing any gate = NOT rendered live — shows uncertified.",
}

// ─── 7. φ↓ DEFERRED (human-gated) ───
phi_down: "No directive fields. φ↓ = SEPARATE channel, A5 (double-loop ⟹ human approval) +
           D6 (no LLM at L<2) gated; panel never emits. Read-only φ↑ first.",

// ─── 8. THE HONEST RETROFIT — the cybernetic diagram is a RETROFIT, not a real RAG ───
retrofit_honesty: {
  framing: "VSF has NO document-RAG pipeline in code (grep RAG/embedding/vector/rerank/bm25 →
            empty). Cybernetic loop = RETROFIT mapping: B (homeostatic wrapper: Qwen
            reads state → generates → Ω-gate → measured viability evaluates → algedonic
            recovery) wraps A (retrieval primitive: context-mode/ctx
            FTS5 over .index.db).",
  caveat:  "B retrieves primarily over SYSTEM STATE (@state_db, BBS) — ¬document corpus. The
            thesis is STRUCTURAL: VSF's S4 loop = closed-loop, Ω-gated, homeostatic
            retrieval-augmented-generation cycle — NOT 'a better document RAG'.",
  labels: {
    faithful:    "implemented + structurally equivalent — generation (Ollama qwen2.5-coder:7b @
                  S4, L≥2 per D6); recovery (algedonic channel → degrade-not-halt, C5); logical↔
                  physical cross-check (topology_reconcile S3*, Ax_AttestationSeparation).",
    partial:     "implemented, weaker — ingestion (FTS5 keyword index, NO dense embeddings);
                  retrieval (sparse/BM25 only); Ω gate (mechanism faithful — omega_validator.rs
                  gates state-vector transitions — but RAG-wiring aspirational); output
                  guardrails (governance-level, ¬token-level); viability score (measured
                  stasis_cos/Lyapunov — substrate faithful, RAG coupling aspirational).",
    aspirational:"named in design, ¬wired — re-ranking (cross-encoder);
                  adaptive learning (evaluation → retrieval weight update, G2). Do NOT draw
                  adaptive link solid until eval→weight loop honestly instrumented.",
  },
  genuine_claim: "evaluation signal = MEASURED dynamical-systems viability metric
                  (stasis_cos, Lyapunov dL, attractor convergence — Fierro-validated), NOT LLM
                  self-critique token (Self-RAG) nor learned retrieval-quality classifier
                  (CRAG). Ω gate = viability/coherence boundary + (with AX-STATE-01) a
                  signed, tamper-evident provenance check. Framing = homeostatic/VSM
                  (Beer), ¬pipeline-agentic — licenses recursion A⊂B.",
  priors:        "Self-RAG (Asai 2023), CRAG (Yan 2024), agentic/modular RAG already did
                  evaluation+correction on GENERATION side — NOT claimed novel.
                  VSF loop CONVERGES on structure.",
  open_gaps: {
    G1: "dense retrieval — A sparse-only. Optional for argument, required for product.",
    G2: "adaptive learning link (eval → retrieval weights) aspirational — wire it
         or draw dashed.",
    // debt(VIZ-G2-ADAPTIVE-LINK, class=doc, owner=DS, gate=none)
    // eval → retrieval-weight loop ¬instrumented ⟹ draw the adaptive link
    // DASHED. A solid edge CLAIMS the loop closes. This one does not.
    G3: "be explicit: retrieval over system-state; ctx (A) = document-corpus
         sub-level.",
  },
}

// ─── 9. THE LIVE MODULES (LXC 109 s5-opsroom, view-host) ───
live_modules: {
  host:     "@dir_view_host host.py — stdlib HTTP+SSE host. MODULES registry:
             {cybernetic-rag: make_tick, system-topology: stv.build_tick, s3-viz: s3v.build_tick,
             qwen-mermaid: qmv.build_tick}. Routes: / = formaid studio, /live = modules dashboard,
             /modules = registry, /diagrams + /d/{id} = studio catalog, /mermaid.min.js
             vendored locally (no runtime CDN).",
  cybernetic_rag: "module #1 — homeostatic loop from the REAL nucleus φ↑.
             builder cybernetic_rag_view.py ▪ projects the model-agnostic view
             body (global/nodes/edges) FROM a source ▪ certifies the SOURCE
             (state_verify G-V3) before emitting ▪ certified=False ⟹ degraded
             render ▪ gate suite --gate72.",
  source_truth: "VERIFIED LIVE 2026-08-09.
             The source said BOTH 'REAL nucleus φ↑' AND 'Synthetic-first …
             later increment swaps source', one sentence apart, ∄ statement
             of WHICH was wired.
             It is REAL: host.py:32 EVENTS_PATH → /mnt/telemetry/events.jsonl,
             LXC 109's ro bind-mount, file exists ∧ non-empty.
             'synthetic-first' was true when written, stale since.",
  silent_fallback: "THE FINDING. host.py:44 make_tick():
               if EVENTS_PATH exists ∧ size > 0:
                   try: return build_tick_from_events(...)
                   except Exception: pass        # ← bare, silent
               return _synthetic_tick()
             ∀ failure — parse error, permission change, moved mount, truncated
             line — the panel KEEPS RENDERING, on numbers _synthetic_tick() draws
             from random.uniform(0.88, 0.97).
             The only tell is the tick's `source` field, which ∄ alarm reads.
             ⟹ the corpus's own recurring class: local degradation that works
             perfectly ∧ never escalates.
             Fabricated telemetry rendered as healthy is worse than a blank
             panel — blank is a SIGNAL, plausible is not.
             Also against §4 honesty_flag: the individual fields stay honest
             while the WHOLE TICK may be invented."

  // debt(VIZ-SILENT-SYNTHETIC-FALLBACK, class=kernel, owner=DS, gate=system_certified)
  // make_tick's fallback must be LOUD. Keep serving — the feed must ¬crash,
  // that part is right — AND
  // set certified=False ▪ mark the render degraded
  // ▪ emit α on the transition real → synthetic.
  // Fabricated telemetry rendered as healthy is the exact failure mode §4
  // exists against.

  // debt(VIZ-CERTIFIER-EPHEMERAL, class=kernel, owner=DS, gate=C1_custody)
  // certifier = ed25519:pending — module #1 runs on an EPHEMERAL dogfood key
  // (host.py mkdtemp per boot), ¬a C1-custody
  // key. §2 states the rule itself:
  // 'pending' ≠ 'certified'. Until the C1 track lands, every G-V3 attestation on
  // this module verifies against a
  // key that dies with the process.
  system_topology: "module #2 — DECLARED self-model from @state_db (RO). Builder:
             system_topology_view.py.",
  s3_viz:    "module #3 — S3 resource-bargain surface (stdlib NATS subscriber). Builder:
             s3_viz_view.py.",
  qwen_mermaid: "module — Qwen mermaid generator panel (stdlib Ollama client). Builder:
             qwen_mermaid_view.py. NOTE: Ollama 0.21.2 on LXC 110 crashes on num_ctx > 256 —
             documented; see s4_multi_s1 delta 4.",
  studio:    "@dir_view_host formaid.py + studio.html — formaid diagram studio (templates +
             live generators + saved; mermaid editor + preview + export). Studio = the
             PRODUCT surface; /live = live module dashboard.",
}

// ─── 10. RELATION TO THE ANTICIPATION FUSE ───
relation: {
  to_anticipation: "@s4_anticipation carries DECISION layer (prescriptive projection,
                    reallocator, hardening gate, forecaster, CRAG cognition, kernel boundary,
                    beacon) + compressed view_contract block. THIS file = PROJECTION
                    surface (view body, gates, retrofit, live modules). Both S4; certify
                    together in ONE pass per [O] directive.",
  ownership:       "visualizer = read-only φ↑ — renders, ¬decides. The
                    anticipation fuse decides; visualizer shows decision's context.",
}

// ─── 11. COMPLIANCE MAP (verdicts form) ───
compliance:
  R9  = "v0.1 view contract silently conceded to legacy api.py (HTTP/SSE, unsigned JSON) —
             v0.2+ corrected via validation loop. NO silent concessions: module
             abstraction + G-V1..G-V4 = enforcement. OK."
  R10 = "view-host deterministic (stdlib projection + state_verify) — no LLM in
             signal path; qwen-mermaid generates diagrams on demand (advisory). OK."
  R13 = "visualizer reads φ↑ UPWARD (parent reads child); opsroom never writes state
             downward. OK."
  R4  = "every claim cites its module file (cybernetic_rag_view.py, host.py, the
             .module.json manifests) or source contract — verified vs repo, not
             assumed from naming. OK."

