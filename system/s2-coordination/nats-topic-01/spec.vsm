@vsm 1.2.1
@status active

// nats_topic_schema/spec.vsm — VSI/1.0 L3 extension: the canonical NATS subject grammar
// Status: ratified (2026-06-12 rmw3 S5) — C2.a of cybersyn_convergence.md
// Author: rmw3 (S5) + Claude (VSF session) — 2026-06-11
// origin: Cybernet convergence plan C2.a (docs/reference/cybersyn_convergence.md)
//
// R11 note: this spec FORMALIZES the grammar already live in nats_publisher.rs /
// phi_down_subscriber.rs — it does not invent a new one. Where live usage is
// inconsistent (phi_down.params vs {system_id}.down.*), the inconsistency is
// recorded with a v2 migration target, and v1 stays canonical until C2.c.

// ═══════════════════════════════════════════════════════════════════════════════
// PURPOSE
// ═══════════════════════════════════════════════════════════════════════════════

TopicSchema("vsf-nats-v1") = {
  version: "1.0",
  purpose: "single authoritative grammar for every NATS subject in the vsf.* namespace,
            so that (a) writers cannot invent ad-hoc subjects, (b) sa_auditor can flag
            unregistered subjects as anomalies, (c) A4 access constraints are stated
            per topic family, not per ad-hoc conversation.",
  transport: "NATS core (at-most-once). Delivery-guarantee tier: see delivery_tier block
              below (C2.d — formalised 2026-06-12; JetStream upgrade path documented).",
  binds_to: "vsi_protocol/spec.vsm L3_Channel (a ψ coupling, once established, exchanges
             dialogue over subjects from THIS grammar)",
  source_of_truth_runtime: "coupling_registry rows kind=phi_channel (state.db, n02)"
}

// ═══════════════════════════════════════════════════════════════════════════════
// GRAMMAR  (v1 — canonical, as live today)
// ═══════════════════════════════════════════════════════════════════════════════

grammar(v1) = {
  root: "vsf.{vsf_id}",                       // vsf_id: VSM instance, default "alpha"

  families: [

    family(phi_up) {
      pattern  = "vsf.{vsf_id}.{system_id}.up.{event_type}"
      example  = "vsf.alpha.vsf_nucleus.up.s4_analysis"
      payload  = "JSON event — same object as the events.jsonl line it replicates"
      writers  = "nucleus nats_publisher.rs (tails events.jsonl, republishes)"
      readers  = "S3/S4/S5 services, opsroom view modules"
      a4       = "S1 units publish only their own {system_id} subtree"
      note     = "φ↑ canonical source of truth = events.jsonl (Merkle-chained);
                  NATS is the live REPLICATOR, not the journal"
    },

    family(phi_down) {
      pattern  = "vsf.{vsf_id}.phi_down.params"
      example  = "vsf.alpha.phi_down.params"
      payload  = "partial NucleusConfig JSON (optional field overrides + _origin + _reason)"
      writers  = "S3 control only (governed param changes)"
      readers  = "nucleus phi_down_subscriber.rs"
      a4       = "ONLY S3 may write; S1 units never publish here"
      // C2.c enforcement rule (active 2026-06-12):
      enforcement = "ALL NucleusConfig changes to a running nucleus MUST go via this topic.
                     Direct env-var mutation or file-based config override without a
                     corresponding phi_down.params publish is a governance violation.
                     Payload MUST include _origin (sender id) + _reason; missing _origin
                     is flagged as governance_violation by S3* KPI integrity watch."
      integrity_watch = "param_change events in events.jsonl (audit trail);
                         s3star_kpi.py checks last param_change events for missing _origin"
      v2_migration = "vsf.{vsf_id}.{system_id}.down.params — per-unit addressing;
                      deferred to C2.e (network-layer A4 firewall enforcement)"
    },

    family(algedonic) {
      pattern  = "vsf.{vsf_id}.algedonic"
      example  = "vsf.alpha.algedonic"
      payload  = "JSON {ts, source_id, category, severity, detail}"
      writers  = "any component (algedonic = bypass-all-filters channel by design)"
      readers  = "vsf-s5-algedonic (LXC 104), vsf-g6-algedonic-sink"
      a4       = "exempt — the algedonic channel intentionally bypasses hierarchy (Beer)"
      note     = "categories whitelisted in s5_policy.algedonic.allowed_categories"
    },

    family(s3star_audit) {
      pattern  = "vsf.{vsf_id}.s3_star.audit.{event_type}"
      example  = "vsf.alpha.s3_star.audit.covenant_check"
      payload  = "JSON audit event (separate chain: /var/lib/vsf/s3_star/events.jsonl)"
      writers  = "vsf-s3-star (LXC 107) only"
      readers  = "S5 services, opsroom"
      a4       = "S3* sporadic direct channel — writes findings, never commands"
    },

    family(s4_intelligence) {
      pattern  = "vsf.{vsf_id}.s4.{function}"
      functions = [algedonic, auditor, digest, store.nucleus, store.audit, store.s5]
      example  = "vsf.alpha.s4.digest"
      payload  = "declared per coupling_registry row (alert.vsm / audit_flag.vsm / digest.vsm refs)"
      writers  = "ac_algedonic (101), sa_auditor (107), sd_digest (WSL agent)"
      readers  = "S5 surface, opsroom (future wiring)"
      a4       = "S4 advisory products only — no commands (D6'/R10: LLM at boundary)"
    },

    family(psi_coupling) {
      pattern  = "vsf.{vsf_id}.psi.{peer}.{phase}"
      phases   = [handshake, scoped_payload]
      example  = "vsf.alpha.psi.beta.handshake"
      payload  = "VSI/1.0 L3 handshake objects (P_consent..P_sync preconditions)"
      writers  = "S4 expansion module of each party, post bilateral-S5 consent"
      readers  = "peer S4 + both S3 filters"
      a4       = "D11: ψ is S4_A↔S4_B mediated, never sibling S1s"
      status   = "reserved — no live ψ coupling yet (gated EXP-TRUST-01 + DSN-EVC-01)"
    },

  ],

  reserved_namespaces: [
    "vsf.{vsf_id}.attest.*       — AX-STATE upstream source attestation (live, host agent)",
    "vsf.{vsf_id}.{system_id}.recurse.{L}.up.* — inner-recursion telemetry (declared, info_flow doc)",
    "vsf.{vsf_id}.view.*         — opsroom view-module pulls (declared)",
  ],

  validation: {
    rule_1: "every live subject MUST match a family pattern or reserved namespace above",
    rule_2: "every family MUST have an active coupling_registry row (kind=phi_channel)",
    rule_3: "sa_auditor treats subjects outside this grammar as class-B anomalies",
    enforcement: "advisory until C2.e (network-layer A4); then broker-level allow-list"
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// DELIVERY TIER  (C2.d — formalised 2026-06-12)
// ═══════════════════════════════════════════════════════════════════════════════

delivery_tier {
  // Current operating tier (Tier 0) — live since nats_publisher.rs deployed
  current = {
    tier    = 0
    label   = "at-most-once core"
    qos     = "NATS core: fire-and-forget, no persistence, no replay from broker"
    replay  = "events.jsonl (Merkle-chained, always-append) is the CANONICAL journal;
               any consumer that missed NATS events replays by tailing the file directly
               (LXC 107 has RO bind-mount; other LXCs SSH to 101 or use Motor 2 API)"
    loss_tolerance = "acceptable: φ↑ loss ≤ 1 telemetry_interval_secs (default 5s).
                      S3* KPI poller detects stall via stale ts in poll_state."
    recovery = "reconnect: nats_publisher.rs reconnects on NATS drop and resumes tailing;
                no replay of missed events over NATS (journal is the recovery path)"
  }

  // Tier 1 — upgrade path (not deployed; operator decision required)
  tier_1 = {
    label   = "JetStream persistent stream"
    qos     = "at-least-once; server-side retention + consumer durable subscriptions"
    subjects = "vsf.{vsf_id}.*.up.* (phi_up family only — φ↓ and algedonic excluded)"
    retention = "limits.max_age: 7 days (matches EXP-TRUST-01 phase A window)"
    prerequisite = "nats-server on LXC 106 must have JetStream enabled (--jetstream flag
                    + storage volume); nats_publisher.rs publish path unchanged"
    benefit  = "missed events replayed on reconnect without file-system access;
                multiple S3/S4 consumers can replay independently"
    cost     = "storage on 106; JetStream overhead ~5% CPU; migration requires
                flush of existing nats-server + reconnect of all subscribers"
    status   = "not adopted — operator decision pending (S5)"
  }

  // Decision record
  s5_decision = {
    options  = ["stay Tier 0 (journal replay sufficient)",
                "upgrade to Tier 1 (JetStream, broker-side replay)"]
    decision = "TIER_0 2026-06-12 rmw3 — journal replay sufficient today; Tier 1 adoption deferred to horizontal coupling phase (JetStream adds complexity; evaluate when off-LXC consumer materialises)"
    note     = "Tier 0 is sufficient while consumers (S3*/S4) have filesystem access
                to events.jsonl. Tier 1 becomes relevant when consumers are off-LXC
                (e.g. external peer ψ coupling, cloud S5 observer) or when file-mount
                latency matters. C2.e A4 firewall does not require a tier change."
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// RATIFICATION
// ═══════════════════════════════════════════════════════════════════════════════

ratification {
  status    = "ratified"
  requires  = "rmw3 (S5)"
  decision  = "RATIFIED 2026-06-12 rmw3 (S5)"
  scope     = "grammar v1 families + validation rules; v2 per-unit migration target
               is informational (deferred to C2.e); phi_down enforcement rule added C2.c"
}
⟦ /nats_topic_01_spec ⟧
