⟦ regulation_layer | VSL-REGULATION-LAYER-v1 | vsm-1.2.1 | 2026-08-16T19:55:27Z ⟧

@vsm 1.2.1
@status ratified
// boot/regulation_layer.vsm
// VSL REGULATION LAYER — v2 (compressed covenant_ops.vsm §regulation;
// v1→v2 = prose compression, primer density, no axiom changed)
// PROTOCOL_VERSION: 2
//   (per-doc versioning: primer's staleness rule applies to the primer alone.)
// Precondition: core_boot_primer.vsm read first (A0/A0.1/A1..A11).

regulation("VSL-REGULATION-LAYER-v1") {

  precedence: "
    §identity (A0, A0.1) > §regulation (this layer)
    ∀ r ∈ regulation: r ⟹ ¬weaken(§identity)
    Δ(§regulation) ⟹ co-sign( §identity.signatory )",

  // ═══════════════════════════════════════════════════════════════════════
  // BOUNDARY AXIOMS
  // ═══════════════════════════════════════════════════════════════════════
  boundary: "
    Ax_HardwareCeiling  ∀x: x ∉ Ω_VSF  ⟺  governance(x) ∈ { firmware, MMU,
                                                              thermal_sensor }
    Ax_InterfaceOnly    ≜ certifies( φ↑_boundary_behavior )
                        // `≜` added 2026-08-10: its siblings state a
                        // RELATION (⟺, ∈) and this one stated a bare
                        // predicate application, so it indexed as a
                        // CITATION and boot/ read as leaking its own axiom.
                         opaque( hardware_internals ),  bounded( readings )
    Ax_ReframeScope      parameter_drift        ∈ D4-L2
                          axiom_Δ ∨ topology_Δ  ∈ D4-L3
                          capability_extension  ∈ D4-L2 ∧ audit_mandatory",

  // ═══════════════════════════════════════════════════════════════════════
  // CAUTION MODE
  // ═══════════════════════════════════════════════════════════════════════
  caution: "
    Ax_S5CautionVeto:
      ∀ e ∈ algedonic:  severity(e) ≥ 8.0  ∨
                         category(e) ∈ { service_down, covenant_drift,
                                          covenant_ops_binding_drift,
                                          s5_stress }
        ⟹  S5.caution_mode := active

      caution_mode=active ⟹  ∀ a ∈ s3_decision: suspend(a)
                              log(a) as s3_caution_hold  ∈ D4-L2, observable
                              ¬suppress( s3_escalation )       // urgency ↑

      clear(caution_mode) ⟸  s5_clear(explicit)  ∨
                              t ≥ CAUTION_DURATION_S (1800)

      fail_safe:  disconnect(NATS) ⟹ caution_mode := false     // no phantom veto",

  // ═══════════════════════════════════════════════════════════════════════
  // TRACEABILITY + ATTESTATION
  // ═══════════════════════════════════════════════════════════════════════
  traceability: "
    Ax_TraceabilityClosure:
      ∀ a ∈ §regulation:  declares(a, enforced_by: module#loc)
      ∀ site ∈ enforcement:  declares(site, axiom_ref: §regulation.a@version)
      // bidirectional, version-pinned; 'pending' = honest, ¬failure

    Def_MinimalAuditTarget:
      audit_complexity(I) ∝ edit_surface(I) · change_frequency(I)
      A0: minimize(both) ⟸ isolate(A0, §identity)

    Ax_AttestationPreservation:
      Δ(§identity)  ⟹  re-attest(witnesses)  ∨
                        acknowledge( bind(prior_attestation, prior_hash) )",

  // ═══════════════════════════════════════════════════════════════════════
  // NETWORK-PATH SPOF (structural pattern, ¬current specific path)
  // ═══════════════════════════════════════════════════════════════════════
  spof_pattern: "
    ∀ path p:  |routes(p)| = 1  ⟹  treat(p, critical)
    probe(p) = fail  ⟹  ¬conclude( blocked(p) )  without  cross_check(≥2 signals)",

  scope: "
    excluded(this layer) = { infra hostnames/ports, live enforced_by instances }
    // structural rules only; current bindings ← separate_channel",
}

⟦ /regulation_layer ⟧
