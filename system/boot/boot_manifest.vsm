// system/boot/boot_manifest.vsm — THE BOOT index (P4).
// The single manifest of everything the boot loads, by layer, with role,
// hash, and ownership. Implemented per child proposal M1 (child/sandbox/
// boot-consolidation/boot-manifest/M1_boot_manifest.vsm, approved 2026-08-13)
// and the parent spec boot_ontology_pattern.vsm §7 D_BOOT_MANIFEST.
//
// PRINCIPLES (boot_ontology_pattern.vsm §2):
//   P1 canon declares — this manifest indexes, it does NOT re-declare canon.
//   P4 index unique — nothing re-lists the boot inventory without passing
//      through this file. No artifact re-declares the boot order.
//   P6 record not abstracted — every entry points AT a real artifact.
//
// CONTRACT: every artifact listed here EXISTS (verified 2026-08-13 by
// sha256 against the live tree). If a name drifts, the M2 verifier
// (verify_boot_ontology.py) reports it. Hash = sha256 of file bytes,
// first 16 hex chars (full hashes in the .primer_sources_manifest.json
// pattern for the boot docs; this manifest pins the whole inventory).
// MCP servers are runtime services, not files — listed without hash.

manifest("boot") {

  // ─── CANON — declares the boot order (R5), the single normative source ───
  layer(L_CANON) {
    role: "declares the boot order (R5) — the single normative source",
    entries: [
      artifact(@doc_covenant,
               layer=canon, role=declares, hash="15685d39de3cfae7",
               owner="canon (S5 rmw3); cite: all agents") {},
      artifact(@doc_core_boot_primer,
               layer=canon, role=declares, hash="f38ec67fe8d6f703",
               owner="canon (S5 rmw3); cite: all agents") {},
      artifact(@doc_vsl_language,
               layer=canon, role=declares, hash="8970ad5dae1f2637",
               owner="canon (S5 rmw3); cite: all agents") {},
      artifact(@doc_regulation,
               layer=canon, role=declares, hash="057a31f5c23c3914",
               owner="canon (S5 rmw3); cite: all agents") {},
      artifact(@doc_hard_rules,
               layer=canon, role=declares, hash="48c207ed7fe90fa7",
               owner="canon (S5 rmw3); cite: all agents") {},
      artifact(@doc_communication,
               layer=canon, role=declares, hash="65cc45233cdd4d97",
               owner="canon (S5 rmw3); cite: all agents") {},
      artifact(@doc_boot_manifest,
               layer=canon, role=indexes, hash="SELF",
               owner="canon (S5 rmw3); cite: all agents") {},
      // 2026-09-30 BOOT-ONTOLOGY audit (FND-BOOTOOLS-PATH-DRIFT-01):
      // RULES.md no longer exists — rule ids live in the hard_rules.vsm
      // canon blocks (pointer table = CURRENT_RULE_IDS in the verifier).
      artifact(@doc_vsl_index,
               layer=canon, role=indexes, hash="d69e73ead44285a7",
               owner="canon reference set; cite: on demand (reference operators)") {},
      artifact(@doc_vsl_axioms_ext,
               layer=canon, role=indexes, hash="e4e30aef90f5c233",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_comms_ext,
               layer=canon, role=indexes, hash="bd14489864454d76",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_definitions,
               layer=canon, role=indexes, hash="91f612394fceb3fa",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_definitions_t,
               layer=canon, role=indexes, hash="8b7cd256310a01d6",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_encyclopedia,
               layer=canon, role=indexes, hash="fb65ee2c9a7ddf29",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_execution,
               layer=canon, role=indexes, hash="57f17e9f6950eff2",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_memory,
               layer=canon, role=indexes, hash="c5616c089db1d0ef",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_norm,
               layer=canon, role=indexes, hash="6f4ffb217b223393",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_psi,
               layer=canon, role=indexes, hash="b12738b4364417cc",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_scope,
               layer=canon, role=indexes, hash="9aae5814d64ff817",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_standard,
               layer=canon, role=indexes, hash="2f17c8caf24d4665",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_validation,
               layer=canon, role=indexes, hash="00b1e656473f30a9",
               owner="canon reference set; cite: on demand") {},
      artifact(@doc_vsl_vsi,
               layer=canon, role=indexes, hash="79b17434feb623fe",
               owner="canon reference set; cite: on demand") {},
    ],
  }

  // ─── PROMPT — operates the boot for THIS role (P3, boot tail only) ───
  layer(L_PROMPT) {
    role: "operates the boot for THIS role (role-operates, boot tail only)",
    entries: [
      // 2026-09-30 BOOT-ONTOLOGY audit: vsf-s3-planner.md no longer exists
      // in the tree — entry retired (prompt layer keeps the child executor).
      artifact("child/.opencode/agent/vsf-s1-executor.md",
               layer=prompt, role=operates, hash="child-repo (own state, R13 — no root hash)",
               owner="S1 child; cite: child only (R13)") {},
    ],
  }

  // ─── REMINDER — reminds R5's boot order structurally (S3*) ───
  layer(L_REMINDER) {
    role: "reminds R5's boot order structurally (fires on session.created)",
    entries: [
      artifact(".opencode/plugins/operational/vsf-onboard-reminder.ts",
               layer=reminder, role=reminds, hash="6d254312bbb124b9",
               owner="S3* auditor; cite: S3* only (advisory, never blocks)") {},
      // 2026-09-30 BOOT-ONTOLOGY audit: the retired scripts/ wrapper was
      // dropped from the index (contract: every listed artifact EXISTS);
      // the live TS v2 entry above carries M6 continuity.
    ],
  }

  // ─── GATE — enforces R15 (inter-agent VSL), the only veto mechanism ───
  layer(L_GATE) {
    role: "enforces R15 (inter-agent VSL) — the only veto mechanism (S3)",
    entries: [
      artifact(".opencode/plugins/operational/vsf-agent-vsl-gate.ts",
               layer=gate, role=enforces, hash="0a781cfe5cefc282",
               owner="S3 controller (veto); cite: S3 only",
               source="sandbox RELOCATE-GATE-SPEC.vsm v2 (2026-08-14,
RECTIF-PLUGIN-SANDBOX-AUDIT decision (c)); M7 fix
                       2026-08-15 (option A: constants non-exported +
                       defensive guard)") {},
    ],
  }

  // ─── CYCLE — learning-cycle scan (S3*→S4 trace; fires on session.idle) ───
  layer(L_CYCLE) {
    role: "forces the learning cycle (learning_cycle.vsm) at session rest —
          the instrument is itself a hook of the cycle (rmw3 2026-08-16);
          observability of every hook/plugin activation (rmw3 2026-08-17:
          'observa y mejora')",
    entries: [
      artifact(".opencode/plugins/operational/learning-cycle-scan.ts",
               layer=cycle, role=forces, hash="2da0515e57948e1f",
               owner="S3* auditor; cite: S3* only (advisory, never blocks);
                      fix 2026-08-17 (AGENT-PLUGIN-CYCLE-REPAIR): path
                      resolution via findScript walk-up — v1 resolved to
                      /home via join(cwd,'..','..') and NEVER ran; v2
                      logs every activation (AGENT-CYCLE-OBSERVABILITY)") {},
      artifact("scripts/state/agent-plugin-log",
               layer=cycle, role=observes, hash="f5acdf694fc19040",
               owner="S3* auditor; cite: S3* only (advisory, never blocks);
                      deterministic JSONL activation log (R10); +pid 2026-08-19
                      (CLASSIFY-READ-TOOL-NOISE — distingue procesos opencode)") {},
      artifact("scripts/state/attestation/check_agent_log.py",
               layer=cycle, role=verifies, hash="5bc14d836388708c",
               owner="S3* auditor; cite: S3* only (advisory, never blocks);
                      validates the activation log — dead plugin detection") {},
      // log-activation.ts and find-plugin-script.ts retired (2026-08-24):
      // logging merged into individual plugins, path resolution via findScript
    ],
  }

  // ─── MEASURE/CHECK — measures before write; verifies at the keystroke ───
  layer(L_MEASURE_CHECK) {
    role: "measures current state before write; verifies conformance at the
          keystroke (advisory, never blocks — pre-commit gate is the authority)",
    entries: [
      // find-plugin-script.ts retired (2026-08-24): path resolution merged
      // into individual plugins
      artifact(".opencode/plugins/core/vsl-measure-before-write.ts",
               layer=gate, role=verifies, hash="6eabede57e23c632",
               owner="S3* auditor; cite: S3* (BLOCKING FASE-3-ENFORCEMENT-2026-08-22)") {},
      artifact(".opencode/plugins/core/vsl-check-on-write.ts",
               layer=gate, role=verifies, hash="8c089048708df052",
               owner="S3* auditor; cite: S3* (BLOCKING core write-check —
                      throws to veto, hence layer=gate; 2026-09-30 audit)",
               note="2026-08-19 HOOK-ARGS-CONTRACT-REPAIR: output.args→input.args (tool.execute.after contract)") {},
      artifact(".opencode/plugins/operational/vsl-relocate-on-write.ts",
               layer=measure, role=coordinates, hash="ba6f9c0fb2b1dec2",
               owner="S2 coordinator; cite: S2 only (prevents footguns on
                      git mv of .vsm — RELOCATE-VSM-SPEC, promoted A5
                      2026-08-15; fix 2026-08-15: multi-git-mv + timing
                      after + fallback auto-diagnostic)") {},
      // 2026-09-30 BOOT-ONTOLOGY audit: plugins/scripts/vsl-measure-before-
      // write wrapper no longer exists — core/vsl-measure-before-write.ts
      // (layer=gate, above) is the live entry.
      artifact(".opencode/plugins/scripts/vsl-check-on-write",
               layer=measure, role=verifies, hash="c375520fe27261fa",
               owner="S3* auditor; cite: S3* only (advisory)",
               desc="write-time daemon — input guards + orchestrator call;
                     which gates run lives in write_gates.vsm (AGENT-WRITE-
                     GATES-v1)") {},
      artifact("scripts/vsl/tools/write_gate_orchestrator.py",
               layer=measure, role=verifies, hash="4cdef667ea8271e4",
               owner="S3* auditor; cite: S3* only (advisory)",
               desc="runs every registered write-time gate independently,
                     aggregates with per-gate [DEMONIO <label>]") {},
      artifact("packages/public/vsf-checks/checks/write-gates-valid",
               layer=measure, role=verifies, hash="6c772a6cba388a72",
               owner="S3* auditor; cite: S3* only (advisory)",
               desc="R4.1: registry parses, cmds resolve, modes valid") {},
      artifact(@doc_write_gates,
               layer=measure, role=registry, hash="1822c57e33be58b3",
               owner="S3 planner; register gates here, never edit the daemon",
               desc="declarative write-time gate registry (AGENT-WRITE-GATES-v1); +socratic-classify gate") {},
      artifact("scripts/vsl/classifier/socratic_gate.py",
               hash="61618a9b6e849472",
               layer=measure, role=verifies, hash="b87a332f01333c6b",
               owner="S3 planner; cite: S3* only (advisory)",
               desc="write-time SOCRATIC gate — eval CLASSIFY tree vs real dir; UNKNOWN advisory (R9), mismatch blocks (PLUGIN-CLASS-TAXONOMY-v1); 2026-08-19 HOMES extended to tree v2") {},
      artifact("packages/public/vsf-checks/checks/socratic-gate-valid",
               layer=measure, role=verifies, hash="cb7c23b68277325d",
               owner="S3* auditor; cite: S3* only (advisory)",
               desc="R4.1: socratic_gate discriminates (ok passes, misplaced blocks)") {},
      artifact("packages/public/vsf-checks/checks/child-refs-notify-valid",
               layer=measure, role=verifies, hash="51ff91fe96cc4be4",
               owner="S3 planner + S3* auditor",
               desc="R4.1 (INCIDENT-CHILD-TAIL-CORRUPTION-2026-08-18): (a) relocate_vsm.py carries child_touched + write_child_notify (dispatch phi-down, R13); (b) every parent envelope in child/docs/deploy/ has canonical footer (R18 — a dispatch without footer blocked the child gate)") {},
    ],
  }

  // ─── MCP — serves state domains (runtime services, no file hash) ───
  layer(L_MCP) {
    role: "serves state domains — the instrument map (asking the wrong one
          returns [] which reads as absence, not wrong address)",
    entries: [
      artifact("state-canon", layer=mcp, role=serves,
               hash="runtime service (no file)",
               owner="state-canon MCP; cite: state domains (tasks/focus/journal)") {},
      artifact("state-canon-infra", layer=mcp, role=serves,
               hash="runtime service (no file)",
               owner="state-canon-infra MCP; cite: infra domains (services/lxcs/chains/topology)") {},
    ],
  }

  // ─── COMMANDS — slash commands (deploy/status/verify) ───
  // 2026-09-30 BOOT-ONTOLOGY audit: .opencode/command/vsf-{deploy,status,
  // verify}.md no longer exist — the whole layer is retired from the index
  // (operator flows moved to deploy scripts + cycle_health).

  // ─── OBSERVE — reality contact (agent_loop OBSERVE phase) ───
  layer(L_OBSERVE) {
    role: "reality contact — S3* sees what the operator does not",
    entries: [
      artifact("scripts/state/core/onboard.sh",
               layer=observe, role=observes, hash="3909aa1a17ebf08c",
               owner="S3* reality contact; cite: every agent boot (R5)") {},
    ],
  }

  // ─── SPEC — consolidation spec REMAINS UNDER TEST ───
  // S5 rectification 2026-08-14: promotion CANCELED — spec has 38 strings
  // >200 chars (22.4K chars of prose in values, 72%), does not meet
  // semantic compression; and 3/4 root plugins were implemented without
  // going through sandbox. Returns to sandbox/ until compression +
  // validation rework.
}
