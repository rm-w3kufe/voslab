experiment_spec_boot = {
  setup: ticks 1000; state ℝ¹²⁸ (blocks A-G); V_mem cap 10k λ_mem 0.02 θ_merge 0.95 θ_min 0.01;
    stasis_vec cosine-EMA per observation; LyapunovTracker window 50 ticks, h_max 0.01
  finding_1 attractor exists, geometrically compact:
    n_observations 15 (stasis in 1000 ticks) → n_clusters 2 after θ_merge → n_merge_events 13
    compression 13/15 = 0.867;  cone arccos(0.95) = 18.2°
    // Ω compact + non-empty on REAL hardware; stasis space is a narrow inhabited cone
  finding_2 dL/dt ≤ 0 confirmed: mean_dL = −0.012 CONVERGING; viable_full true
    // E[dL/dt] ≤ 0 in expectation per breath cycle — exactly as predicted
  finding_3 dimension structure: PCA — PC1 ~60%, PC2 ~20%, PC3+ marginal tail;
    D_KY_estimated ≈ 2..3 (consistent with theory D_KY ~3..5); block B (16-31) highest variance,
    block A (0-15) medium, blocks C-G stable
