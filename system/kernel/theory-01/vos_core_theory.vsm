s1_operations = {
  identity: "the units that do the work" — RecursiveKernel instances (main.rs run_*:
    run_pvsnp, run_metamorphosis, run_resilience, run_stress, run_fuzz, run_recursive),
    tool-conductor work units, external workers (BBH, experiment runners)
    // each S1 unit can itself be V′ (Beer) ✓ VERIFIED from main.rs
  interface: {
    φ↑ writer: events.jsonl (canonical) + NATS JetStream (mirror);
      schema_ref @connection_schema §upward_channel;
      subject vsf.{id}.{system}.up.{event_type}; 1-10+ Hz; 0.5-5 KB; loss bounded-100ms
    φ↓ reader: params.json (canonical) + env vars (legacy);
      schema_ref @connection_schema §downward_channel; at tick boundaries; <2 KB; loss full
    φ_algedonic writer: NATS Core; rare (existential threat only); zero loss
    S3* subject: S1 cannot lie — events.jsonl append-only canonical
  }
  not_have: no direct sibling channel (A4), no ψ (only S4 establishes ψ), no write to own params.json
  decisions_single: tick_continuation (<100 ms; in Ω → continue, near boundary → warn+continue)
    | emit_event (<1 ms via tmpfs) | bounded_self_correction (<10 ms; MUST NOT cross hard limits)
  decisions_double: kernel_halt_request (VSL invariant violated; e.g. thermal_c > 80 → halt +
    algedonic, S5 approves resume) | recursive_spawn (variety overflow; S3 approves — resource alloc)
  constraints: inherited A0, A0.1, A4, A5, D6 (L=0/1 NO LLM), D7 (English), D13 (safety blocking)
    S1_C1 no LLM consultation (no ureq to Ollama from S1 modules — Rust boundary)
    S1_C2 φ↓ read-only (fs permissions + review)
    S1_C3 bounded self-correction only (bounds from params.json; crossing = double-loop)
    S1_C4 tick atomicity (kernel_tick OR kernel_halt — never partial; catch_unwind)
  invariants: {
    S1_I1 state ∈ Ω (omega_validator.rs end of tick; violation → algedonic + kernel_halt)
    S1_I2 tick cadence ∈ [0.5×, 2.0×] target (outside → signal_deferred + notify S3)
    S1_I3 stasis_cos ≥ 0.90 over 10 ticks (signal_escalated + algedonic if drop > 0.05 in 1 tick)
    S1_I4 trust > τ_L (0.5 startup / 0.8 governed; violation → halt)
    S1_I5 events.jsonl append-only (SHA256 of prior lines periodic by S3*; mismatch → halt)
  }
  impl: kernel.rs | state_vector.rs (ℝ¹²⁸) | omega_validator.rs | stasis.rs | telemetry.rs
  llm: D6 prohibits LLM at L=0/1 — S1 stays code-only; a CONTROLLER LLM at L≥2 may oversee
    (reads events.jsonl, identifies patterns, proposes double-loop) but runs in S4
  confidence: identity ✓ interface ✓ decisions ◐ constraints ✓ invariants ✓ llm ◯
}

s2_coordination = {
  identity: anti-oscillation regulator between parallel S1 units — detects destructive
    interference (contention, contradictory actions, timing collisions), issues coordination
    signals. NOT a decision-maker (that's S3) — a COORDINATOR.
    // today largely IMPLICIT: tokio mutexes/channels; explicit S2 module = acknowledged debt
    //   (DEBT-13) — this doc specifies what S2 MUST become ◐ PARTIAL
  interface: {
    φ↑ writer coord reports (event_type=coord_signal; subject vsf.{id}.s2.{coord}.signal;
      0.1-1 Hz; <1 KB; loss bounded)
    φ_lateral mediator S1↔S1 (NOT A4 violation — S1_a→S2→S1_b valid 3-hop;
      subject vsf.{id}.s2.coordinator.{a}.{b}; event-driven; <2 KB)
    φ↓ reader from S3 (subject vsf.{id}.s2.down.policy)
  }
  decisions_single: detect_oscillation (<500 ms; coord_signal + TTL-based lock proposal)
    | resource_quanta_arbitration (<100 ms; serialized grants honoring S3 fairness)
    | heartbeat_propagation (5-30 s; aggregate status to S3, nudge silent S1s)
  decisions_double: policy_revision_request (oscillation NOT covered by policy → escalate S3)
  constraints: S2_C1 no policy authorship (reads params, never writes)
    S2_C2 bounded scope (own parent V's S1 set only — V′(L+1) has own S2′)
    S2_C3 idempotent signals (sequence number + intent verb — safe under at-least-once)
    S2_C4 no veto on in-progress S1 work (signal types {grant, delay, throttle, pause};
      cancellation requires S3)
  invariants: {
    S2_I1 oscillation detected within N=3 cycles (3·tick_target; else signal_escalated)
    S2_I2 coordination overhead < 10% of S1 event rate (else signal_deferred — S2 bottleneck)
    S2_I3 no spurious signals (S3* samples 1%; false positive rate < 1%)
    S2_I4 A4 preservation (S3* scans direct S1↔S1 subjects; zero allowed; else algedonic)
  }
  impl: explicit S2 module NOT YET (s2.rs to create); tokio primitives ✓ implicit;
    NATS coord subjects NOT YET; oscillation detector to design
  llm: NO — L=1, mechanical pattern matching + signal routing, pure Rust
  confidence: identity ◐ interface ◯ decisions ◯ constraints ✓ invariants ◯
  action: S2 module = debt — implement before multi-S1 production load increases
}

s3_control = {
  identity: "inside and now" regulator — resource allocation, performance monitoring,
    S4-recommendation application, params.json writer, S2 policy authorization,
    single-loop enforcement (A5 automatable), double-loop escalation
    // today split across telemetry_publisher.rs, operational.rs, cgroup.rs, s4_operational.rs ✓
  interface: {
    φ↑ reader: wildcard vsf.{id}.{system}.up.> (all event types; JetStream replay)
    φ↑ writer to S5: event_type ∈ {phase_complete, param_change, resource_allocation};
