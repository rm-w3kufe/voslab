    cosine heatmap 15×15, angular distances (13 obs < 18.2°, 2 obs > 45°), variance per dim
}

experiment_thermal_stress_v3 = {
  setup: 4 persistent threads (pool Barrier + AtomicU64); quota ramp vectors 1k→500k;
    load cosine_similarity(StateVector, StasisVec) hot loop; target 60°C
  v1: 1 thread, peak 49°C, "ceiling reached, no THROTTLE"
  v2: 4 threads, peak 54°C, "spawn per tick — overhead limits"
  v3: 4 threads, peak 63°C, "TARGET_REACHED + THROTTLE activo"
  finding_4 A_breath empirical: inhale = quota↑→load↑→temp↑; exhale = temp ≥ target → quota↓;
    soplo = temp ≈ target oscillation around the THERMAL ATTRACTOR (63°C).
    // THROTTLE is not a bug — it is the homeostatic regulator; f₀ + σ·η at dynamic equilibrium
  finding_5 viable_full true under max thermal stress: cosine ≥ 0.70 during THROTTLE;
    trust 1.000 undegraded; entropy_phase stasis maintained — axioms hold under real stress
  finding_6 worker pool pattern = recursion model: 4 workers ≈ 4 S1 kernels (own sv_local,
    st_local), coordinator (main thread) controls quota + stop_flag, Barrier(n+1) sync per tick
    → prototype of S3→S1 protocol (cgroup poc task(N): can S3 keep all S1 viable_full with
    shared thermal budget?)
  visualizations: @nucleus_tools plot_telemetry.py --experiment thermal_stress_v3 — temp 20→63→THROTTLE
    →oscillation, cpu_pressure ∝ temp/70, load ramp 1k→500k, stasis_cos stable
}

