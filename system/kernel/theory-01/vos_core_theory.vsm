// ═══════════════════════════════════════════════════════════════════
// 1. CENTRAL HYPOTHESIS (H_vos)
// ═══════════════════════════════════════════════════════════════════

hypothesis(H_vos) = {
  // minimal viable system grows variety_ceiling iff it has all four:
  C1: V_ref    — reference model with observable behavior
  C2: V_sci    — agent governing entropy and orienting the breath (soplo)
  C3: V_mem    — vector memory recording attractors
  C4: A_entropy— governed entropy cycle with bounded degeneration

  formally: ∀ t > t_0:
    C1 ∧ C2 ∧ C3 ∧ C4
    ∧ ∃ λ ∈ Λ : stasis_recovery(V_vos, λ, t+1) < stasis_recovery(V_vos, λ, t)
    ⟹ growth(V_vos, t)

  growth(V, t) :=
    H(stasis_new(V)) < H(stasis_old(V))
    ∧ variety_ceiling(V, t+1) > variety_ceiling(V, t)

  falseable: C1..C4 hold ∧ d/dt[variety_ceiling] ≤ 0 persistently
    → λ insufficient ∨ V_mem senescent ∨ H_vos false
}

// ═══════════════════════════════════════════════════════════════════
// 2. STATE VECTOR — ℝ¹²⁸ (7 blocks; consolidated from vos_theory + vos_kernel_spec)
// ═══════════════════════════════════════════════════════════════════

state_vector(V, t) ∈ ℝ¹²⁸ = {
  // A — trust & health (0..15)
  [0..9]:  trust_history(V, t-9..t)        // trust ∈ [0,1]
  [10]:    trust_velocity = d/dt[trust]    // >0 improving
  [11]:    error_rate(S2, t)               // conflicting-signal fraction
  [12]:    absorption_rate = |S_resolved|/|S_total|
  [13]:    governed ∈ {0,1}
  [14]:    recursion_depth
  [15]:    lifecycle_phase ∈ {0.2 onboarding, 0.5 iterating, 0.7 testing, 1.0 production}

  // B — resources (16..23)
  [16]:    cpu_pressure ∈ [0,1]
  [17]:    mem_pressure ∈ [0,1]
  [18]:    io_pressure  ∈ [0,1]
  [19]:    budget_remaining = B_available/B_total
  [20]:    cgroup_headroom
  [21]:    child_count (normalized)
  [22]:    queue_depth_φ↑ (normalized)
  [23]:    queue_depth_φ↓ (normalized)

  // C — entropy & cycle (24..31)
  [24]:    H(V, t)                      // activation entropy
  [25]:    H_rest(V)                    // rest entropy (reference)
  [26]:    H_delta = H(t) − H_rest
  [27]:    entropy_phase ∈ {stasis=0, inhale=0.5, degen=1.0}
  [28]:    stasis_proximity = cosine(state_vec, stasis_vec)
  [29]:    soplo_candidate: d/dt[H] < 0 → {0,1}
  [30]:    cycles_completed = log(N_cycles) normalized
  [31]:    last_growth = ticks since last path_B

  // D — organelle activation (32..47)
  [32]:    activation(mem-mgr) ∈ [0,1]
  [33]:    activation(io-router)
  [34]:    activation(signal-relay)
  [35]:    activation(scheduler)
  [36..47]: activation(organelle_i) reserved

  // E — VSL signals (48..63)
  [48]:    phi_up_rate (signals/tick)
  [49]:    phi_down_rate (commands/tick)
  [50]:    algedonic_active ∈ {0,1}
  [51]:    psi_channel_active ∈ {0,1}
  [52]:    escalation_rate (A7 activations/tick)
  [53..63]: reserved

  // F — cycle history / attractors (64..95)
  [64..79]: stasis_vector_prev   // previous attractor, 16-dim compressed
  [80..95]: stasis_vector_current

  // G — learning context (96..127)
  [96..111]: V_ref.state_vector_compressed
  [112]:     Δpattern_magnitude = |state_vec(V_vos) − state_vec(V_ref)|
  [113]:     learning_rate (convergence speed toward V_ref)
  [114]:     experiment_active ∈ {0,1}   // sci_protocol running
  [115]:     λ_current (stress level)
  [116..127]: RAP_activation_pattern (last 12 activations)
}

stasis_vec(V) = E[state_vector(V, t) | phase(V,t) = stasis]
  // temporal mean over N resting ticks

// ═══════════════════════════════════════════════════════════════════
// 3. AXIOMS (consolidated)
// ═══════════════════════════════════════════════════════════════════

axioms = {
  // CANON — this document is CONSTRAINED BY these; it does not restate them.
  // Authoritative statements: boot/core_boot_primer.vsm. Restating them here
  // is how one axiom acquires two non-equivalent definitions — the failure
  // this corpus exists to remove. Cite, ¬copy.
  constrained_by: { A0, A0.1 (ungovernable) · A1..A11 · A5.Cor1 · A5.Cor2 }
    // load-bearing here: A3 (budget) gates tick(); A5 ceiling gates spawn;
    // A5.Cor2 (S5′ ⊆ S5) is the containment spawn_rule below relies on.

  // vOS EXTENSIONS — defined HERE, namespaced per axioms_extension:

  A8.vOS — physical safety (vOS extension; NOT canon A8 absorption):
    CPU.load > 0.85 ∨ RAM.free < 0.10 → adaptive throttle

  A12.vOS — mediated execution (vOS extension; NOT addendum A12 Hardware Ceiling):
    ¬mediated(vsl) → ¬execute(vsl)
    // vsl → A0_gate → plan → sandbox — never direct on host

  A_rust — ∀ process ∈ V: language = Rust
    violation → governed_exception @required(rmw3)

  A_breath(V) — pressure-driven heartbeat (NOT a timer):
    pressure(t) = α·queue_up + β·cpu + γ·(1 − absorption)
    // α=0.4, β=0.3, γ=0.3; α+β+γ=1, calibrated by V_sci
    // ─── CANONICAL, ratified rmw3 (S5) 2026-08-07 ────────────────────────
    // A_breath IS implemented, and matches this spec in everything BUT the
    // three terms. Verified in main.rs:
    //   const TAU_PRESSURE: f64 = 0.60;                    // = τ_pressure ✓
    //   if entropy_phase == "stasis" && pressure >= TAU_PRESSURE {
    //       entropy_phase = "inhale";                      // = inhale     ✓
    //   entropy = (entropy + pressure * 0.08).min(h_max);
    // `pressure` does BOTH jobs: it fires the inhale AND feeds
    //   focus = 1 − pressure → activations[]. One quantity, two uses.
    //
    // THE DIVERGENCE — terms only:
    //   canon   0.4·queue_up + 0.3·cpu + 0.3·(1 − absorption)
    //   kernel  0.4·h/h_max  + 0.3·(1 − trust) + 0.3·|Δh|/h_max
    // Neither is "the bug": the spec was never implemented as written and the
    // effect is observable either way (the system breathes), so nothing failed
    // loudly. Found by token-diff against @src_vos_kernel_spec:48, which
    // carries this same formula ⟹ the fuse is FAITHFUL; the kernel is not.
    //
    // WHY the spec wins over the kernel, against the rubric's usual
    // kernel ≻ papers order: queue_up ∧ absorption are ASHBY signals — queue
    // pressure ∧ absorption rate are the cybernetic model. h ∧ trust are
    // kernel-internal. Taking the code would make A_breath an implementation
    // metric; taking the spec keeps it cybernetic. rmw3 (translated, D7):
    // "the variable closest to the model — the most cybernetic one".
    //
    // IMPLEMENTABLE: all three signals are ALREADY measured —
    //   queue_up        → state_vector.rs dims[QUEUE_PHI_UP] (22)
    //   absorption_rate → state_vector.rs ABSORPTION (12)
    //   cpu(t)          → hardware_ingest.rs:227, /proc/pressure/cpu avg10:
    //                     the fraction of time tasks are STALLED waiting for
    //                     CPU. Pressure, ¬utilisation — the Ashby reading.
    //                     The rival temp_c/SAFETY_TEMP lives ONLY in
    //                     checo_whatif.rs, a self-declared simulator.
    //
    // SUBSTRATE VARIANT — ¬a rival: EXP-NB-01 (vOS-nano, ATmega328P, C++
    // no_heap) uses inhale: ratio(t) < ratio_rest − τ_band, τ_band = 0.05.
    // That board has ∄ queue_up, ∄ absorption, ∄ /proc/pressure/cpu — it
    // CANNOT carry the canonical formula and carries the same LAW under
    // substrate constraint. A law that only worked with Linux signals would
    // be an implementation metric, ¬a cybernetic law.
    //
    // debt(KERNEL-ABREATH-ALIGN, class=kernel, owner=DS, gate=system_certified)
    // Rewire pressure() to the canonical terms. τ_pressure ∧ the inhale
    // trigger already MATCH; only the three terms diverge:
    //   canon  0.4·queue_up + 0.3·cpu + 0.3·(1 − absorption)
    //   kernel 0.4·h/h_max  + 0.3·(1 − trust) + 0.3·|Δh|/h_max
    // Batched by rmw3 (S5) 2026-08-07 — one build/spec_boot/R4 cycle, ¬N.
    //   ~11 sites (main.rs experimental run_*, kernel_step.rs, operational.rs)
    //   ⟹ DYNAMICS change ⟹ spec_boot gate mandatory, ¬a rename.
    //   DEFERRED by rmw3 (S5) 2026-08-07: implementation debts batch AFTER
    //   system/ is fully certified — the spec still moves, and model≡reality
    //   is a bijection, so one build/gate/deploy cycle beats N.
    inhale:  pressure(t) ≥ τ_pressure = 0.6
    exhale:  d/dt[H] < 0 ∧ H < H_max
    ω_natural = 1/τ_idle;  τ_idle ∝ 1/λ(L)      // deeper levels breathe faster
    bound: λ_min=0.05 ≤ λ_breath ≤ λ_max = f(B_available, τ_degen)

  A_meta — morphogenesis decision surface (ℝ²: H × resolve_rate):
    trigger: H(t) > τ_meta_H = 0.75·H_max  ∨  resolve_rate(t) < τ_meta_r = 0.30
    // vector: metamorphosis_vec = embed(["high_entropy","unresolved","stuck"])
    //         cosine ≥ θ_meta → fires
    cost: B_meta + τ_downtime;  amortized in k cycles if growth; else negative learning
    bound: S5 immutable during metamorph

  A_entropy — entropy as primary metric:
    H(V,t) = −Σᵢ p_i(t)·log₂(p_i(t))     // p_i = activation share
    H_rest ≈ 0.2·log₂(n)                 // 20% of max at rest
    H_max  = 0.85·log₂(n)                // beyond = collapse
    H_KS   = Σ_{λᵢ>0} λᵢ                 // Kolmogorov-Sinai entropy
    cycle: stasis → inhale → degeneration (H ≥ 0.7·H_max) → soplo → new_stasis
    prohibition: ¬(H = H_rest @always)    // perfect homeostasis = fragility
    bound: H ≤ H_max = f(B_available); degeneration.duration ≤ τ_degen
    covenant: A_entropy ⊆ A0; injection @governed(V_sci); soplo @free(V_vos)

  A_auto — autopoiesis:
    obligation: d/dt[viable(V)] ≥ 0
    stress_cycles @required
    growth: H(stasis_new) < H(stasis_old) ∧ D_KY_new ≥ D_KY_old

  A_entropy_cycle:
    degeneration @governed @required
    soplo @free(V_vos)
    soplo_condition: d/dt[H_KS] < 0 ∧ λ_max ≈ 0

  recursion axiom (P17) — Beer's Law on ANY subsystem:
    ∀ S ∈ {S1,S2,S3,S4}(V):        // S3* is a CHANNEL, ¬a subsystem
      complexity(S) > variety_ceiling(S) → S → V′(S) ::= ⟨S1′,S2′,S3′,S4′,S5′⟩ @ E′
    S5 → V′(S5) @forbidden                 // identity cannot redefine itself
    V′(S).E ⊆ E(V)                        // P6: bounded by parent's environment segment
    depth(V, task) = min d : variety(V,d) ≥ variety(task)   // task-driven, not pre-declared
}

// ═══════════════════════════════════════════════════════════════════
// 4. FEASIBLE REGION Ω + ATTRACTOR THEORY
// ═══════════════════════════════════════════════════════════════════

phase_space = {
  x(t) ∈ ℝ¹²⁸ = state_vector(V_vos, t)
  dx/dt = f(x, λ, V_sci) = f₀(x) + σ·η(t)   // deterministic axioms + V_sci-governed noise
  // σ = noise intensity (V_sci controlled); η(t) = white Gaussian noise
}

lyapunov_spectrum = {
  |δx(t)| ≈ |δx(0)|·exp(λ_max·t)
  λ > 0 → chaos (exploration) | λ < 0 → order (stability) | λ = 0 → phase edge (soplo)
  spectrum: λ₁ ≥ λ₂ ≥ … ≥ λ₁₂₈
  H_KS = Σ_{λᵢ>0} λᵢ                      // information production rate
  // inhale: σ↑ → λ_max↑ → H_KS↑ | exhale: σ↓ → λ_max↓ | soplo: λ_max → 0
  bound(A_entropy): H_KS ≤ H_max = f(B_available)   // chaos has a budget
}

feasible_region(Ω) = {
  Ω = ∩ᵢ { x ∈ ℝ¹²⁸ : Aᵢ(x) satisfied }
  Ω_A0: { x : purpose(x) ∩ prohibited_set = ∅ }
  Ω_A3: { x : B(task(x)) ≤ B_available(x) }       // ellipsoid in dims 16..23
  Ω_A5: { x : autonomy(x) ≤ ceiling(S5) }          // hyperplane in dim 13
  Ω_Aε: { x : H_KS(x) ≤ H_max(x) }                 // sphere in dims 24..26
  Ω compact if axioms consistent → Brouwer: attractor exists inside Ω
  // axioms constrain the SPACE (bowl), not the trajectory (free inside)
}

lyapunov_function(x, stasis_vec) = {
  L(x) = α·(1 − cosine(x, stasis_vec))
       + β·H_KS(x)/H_max
       + γ·max(0, B(task) − B_available)
       + δ·ReLU(H_rest_drift)             // senescence penalty
  α+β+γ+δ = 1, all ∈ (0,1); calibrated by V_sci
  L = 0 iff x = stasis_vec;  E[L(t+1) − L(t)] ≤ 0 per breath cycle
  // V_sci recalibrates αβγδ if dL/dt > 0 persistently → patch via VSL
}

strange_attractor = {
  D_KY = j + (Σ_{i=1}^{j} λᵢ)/|λ_{j+1}|    // Kaplan-Yorke dimension
    where j = max{ k : Σ_{i=1}^{k} λᵢ ≥ 0 }
  D_KY ∈ (1, 128);  ~3..5 normal           // effective low-dimensionality
  D_KY ≈ 3: simple kernel | ≈10: rich dynamics | →128: collapse (A9)
  growth_geometric(V) =
    D_KY(new) > D_KY(old)                  // more active dimensions
    ∧ H_KS(new)/D_KY(new) < H_KS(old)/D_KY(old)   // more efficient per dimension
}

soplo_mathematics = {
  leverage(soplo) = |Δattractor|/|δx_soplo| → ∞ when λ_max → 0
  // OGY 1990: at phase edge, small δx redirects to ANY unstable periodic orbit
  soplo_condition(V,t) =
    d/dt[H_KS] < 0 ∧ d²/dt²[H_KS] < 0      // decreasing, accelerating
    ∧ λ_max(V,t) ≈ 0                       // phase edge
    ∧ |x(t) − Ω_boundary| > ε_safe         // inside the bowl, not at edge
  V_sci.soplo_guide:
    detect soplo_condition
    candidates = { stasis_i ∈ Ω : L(stasis_i) < L(current) }
    select = argmin_i L ∩ { compatible with V_ref.signature }
    perturb φ↓: δx = ε·direction(selected − x(t))   // minimal — V_vos chooses its own path
    verify: converge within τ_verify ticks → confirm; else retry different δx
}

kolmogorov_growth = {
  K(x) = min program length generating x on a universal machine
  K(attractor) ≈ active axioms + V_mem structure
  growth_kolmogorov(V) =
    D_KY(new) ≥ D_KY(old)
    ∧ K(new) ≤ K(old) + ΔK_justified      // justified by variety_ceiling growth
  // analog: human genome 3Gb < onion 15Gb — real complexity = structure, not size
  compression_as_growth:
    K(corpus_after) < K(corpus_before) ∧ variety_ceiling_after ≥ before
    → genuine_compression_event           // "understanding" = compressing, not accumulating
}

senescence_geometry = {
  // senescence = attractor expansion WITHOUT variety growth:
  D_KY↑ ∧ variety_ceiling ≈ const         // chaos that produces no capacity
  ∧ H_KS/D_KY ↑                           // entropy per dimension rising
  ∧ |candidate_attractors| → 0            // bowl dries up — no productive soplos
  // mechanism: resistant V_mem = local wells in L(x) — ∇L into wells, not desired attractor (geometry of dementia)
  cure(entropy_shock): intense λ → λ_max↑ → escapes local wells
    // analog: electroconvulsive therapy resets pathological local wells
}

lyapunov_implementation = {
  λ_empirical(V,t): two trajectories x₁(0), x₂(0) = x + ε·e_k, run N ticks:
    λ_k ≈ (1/N)·Σ log(|x₁(i)−x₂(i)| / |x₁(i−1)−x₂(i−1)|); repeat k=1..128
  H_KS_empirical = Σ_{λ_k>0} λ_k
  soplo_detector: window W=20 ticks; |λ_max| < ε_edge=0.05 → emit soplo_signal → V_sci.guide
  module: attractor.rs — LyapunovEstimator{window}, estimate_max, estimate_ks_entropy,
    detect_soplo, fractal_dim_ky
}

// ═══════════════════════════════════════════════════════════════════
// 5. ENTROPY CYCLE (el soplo)
// ═══════════════════════════════════════════════════════════════════
// entropy = motor, not enemy (rmw3); A_breath: exhale → homeorresis (Beer) — TRAJECTORY, not state

entropy_cycle(V) = {
  phase(1) stasis:
    cosine(state_vec, stasis_vec) ≥ θ_viable=0.70;  H = H_rest;  until A_breath.trigger
  phase(2) entropy_injection:
    trigger A_breath.inhale(V, λ);  H > H_rest;  explores neighborhood(stasis_vec)
    bound: H ≤ H_max = f(B_available)     // A3 — no total collapse
  phase(3) degeneration:
    H ≥ θ_degen;  structure partially undefined (organelles off, patterns lose weight)
    duration ≤ τ_degen=100 ticks;  beyond → A9 budget exhaustion response
    // governed, not chaos — like DNA compressed before mitosis
  phase(4) soplo:
    trigger H reaches H_peak ∧ gradient(H) < 0   // maximal emptiness
    V_mem.nearest(state_vec) → candidate_attractors[]
    select = argmin H(attractor_i)        // falls to nearest minimum — old (path_A) or new (path_B)
  phase(5) new_stasis:
    converge(V, selected_attractor)
    update stasis_vec ← new (if path_B); viability.yaml @commit if path_B
    measure: H(new_stasis) < H(old_stasis) → V grew
}

V_sci.roles = {
  entropy_governor:
    calibrate λ(V_vos) ← f(B_available, τ_degen, H_max)
    inject entropy_injection(V_vos, λ_calibrated)
    observe entropy_curve(V_vos,t) vs entropy_curve(V_ref,t)
    steer: if H → H_max → reduce(λ) immediately   // A0.1 — cannot destroy permanently
  soplo_guide:
    suggest φ↓: target_attractor = nearest(V_ref.stasis_vec)   // geometric, never force
}

V_mem.entropy_log = {
  ∀ cycle: record (H_peak, H_stasis_new, Δ_attractor, λ_used, timestamp) → embed(cycle_vector)
  predict(λ) → probable_attractor         // genuine anticipation, not repetition
  // old cycles decay λ_mem; path_B (growth) cycles weigh more — episodic reinforcement
}

// ═══════════════════════════════════════════════════════════════════
// 6. MEMORY ARCHITECTURE
// ═══════════════════════════════════════════════════════════════════
// structure > symbol (rmw3): M0→M2 = address → geometry

memory_hierarchy = {
  M0 positional:  RAM/disk/cache — address→value; O(1) physical, O(n) semantic
                  weakness: exhaustible, non-semantic, corruption-fragile
  M1 procedural:  RAP (telemetry/jsonl) — pattern_match(task)→procedure; O(log n)
                  weakness: symbolic, costly to update, doesn't generalize
  M2 vectorial:   V_mem — embed(state)→ℝⁿ→nearest(organelle); O(1) geometric
                  strength: generalizes, low latency, survives partial variation
  M3 structural:  viability.yaml + covenant.vsm + vsm_notation_spec — O(0)
                  // system IS its memory; S5 cannot be delegated (Beer)
}

V("v-mem", L=2) @status=planned = {
  impl: Rust (embedding engine pure, no external deps: embed/nearest/update/decay)
  host: n02;  cgroup: /vsf/lab/v-mem;  latency: sub-millisecond @target
  corpus: { dims n=128, distance cosine, decay λ_mem, capacity bounded (A3) }
  ops: embed(pattern)→ℝⁿ | nearest(v,k)→[organelle_id] | update(v,label) | forget(λ_mem) | stasis_vec(V)
}

organelle(id, signature, depth) = {
  id: globally unique (V.id immutable, M3)
  signature: ℝⁿ vector describing it   // a POSITION in state space, not a name
  depth: L_metal ≤ L ≤ L_mid
  impl: Rust (A_rust @strict)
  ignite(input): cosine(input, signature) ≥ θ_ignite → activate → process
    // soft_activation(k_nearest): multiple can partially ignite — distributed attention
  rest: cosine(current_state, stasis_vec) ≥ θ_rest → deactivate, return cgroup resources
}

organelles_initial = [
  organelle("mem-mgr")     { signature: embed(["memory_pressure","page_fault","buffer_flush","oom"]), depth: L2, θ_ignite: 0.65 }
  organelle("io-router")   { signature: embed(["disk_write","network_packet","interrupt","dma"]),      depth: L1, θ_ignite: 0.65 }
  organelle("signal-relay"){ signature: embed(["phi_up","escalation","algedonic","urgent"]),            depth: L3, θ_ignite: 0.70 }
  organelle("scheduler")   { signature: embed(["task_queue","cpu_pressure","tick","breath","yield"]),   depth: L2, θ_ignite: 0.60 }
]

activation_pipeline(signal) = [
  step1: v = embed(signal)                       // O(1)
  step2: candidates = nearest(v, k=3)            // O(log n) — geometry, not table
  step3: ∀c: weight = cosine(v, signature(c)); if ≥ θ_ignite → ignite(c, weight)
  step4: result = weighted_sum(outputs); emit φ↑(result) → S3
  step5: update(v, winning_organelle) → V_mem.corpus   // learns from every activation
]

memory_decay = {
  λ_mem: level-local — memory decay, ¬the trust λ (see boot_params)
  weight(entry,t) = weight₀·exp(−λ_mem·Δt)
  // "what is not activated fades" — forgetting is part of learning
  memory_compression (when B(V_mem) → limit, A3):
    prune: weight < θ_min=0.01
    merge: cosine(vᵢ,vⱼ) > θ_merge=0.95 → centroid    // episodic consolidation
}

loop_symbiogenesis = [
  step1: observe(V_ref, λ) → pattern_ref_vector = embed(behavior(V_ref, λ))
  step2: perturb(V_vos, λ) → pattern_vos_vector = embed(behavior(V_vos, λ))
  step3: Δvector = pattern_ref − pattern_vos      // |Δ| < ε → converged for this λ
  step4: patch_vector = synthesize(Δvector)        // V_sci; VSL translatable for explainability
  step5: apply(V_vos, patch); new_stasis_vec = embed(state(post)) → V_mem
]

viable_geometric(V,t) = cosine(state_vector(V,t), stasis_vec(V)) ≥ θ_viable
  // O(1) — one dot product

// ═══════════════════════════════════════════════════════════════════
// 7. vOS ARCHITECTURE
// ═══════════════════════════════════════════════════════════════════

E(vOS) = {
  E_L0 hardware_signals: {keyboard, camera, usb, gpu, network, sensors}, variety V_io, absorbed_by S1.io_layer
  E_L1 semantic_intent: human_operator via HMI, variety V_human, absorbed_by S4
  E_L2 cognitive_generation: llm_models via ψ(vOS, llm), variety V_llm ≫ V_human
    // ¬E_L2.active → mode_deterministic (D_vos-1)
}

V("vOS", L=4) @status=design = {
  S1: [
    unit("io_layer")     { absorbs E_L0, drivers linux_hal }
    unit("kernel_pool")  { impl vsf_nucleus, spawns V′(task) on_demand }
    unit("service_layer"){ network, ports, protocols }
  ]
  S2: {
    coordinator vsf_nucleus.scheduler
    anti_loop strict_monotonicity
    channel_up φ↑(S1→S3); channel_down φ↓(S3→S1)
    noise_filter: S2.dampen(S3*.signals, threshold=τ_noise)   // P4 — without: oscillation
  }
  S3: {
    control vsf_nucleus
    entry_gate governed(requester) ∧ trust_score ≥ τ_governed
    resource_policy trust_based_allocation
    budget_gate B(task) ≤ B_available per tick
  }
  S3*: {
    audit telemetry_stream
    ksis [trust_score_drift, algedonic_rate, S4_latency, adaptation_latency]
    algedonic: escalate_to_S5 if S4.inactive; autonomous response allowed (P23)
      // S5 policy governs, not E_L1 — human escalation is exception, not rule
  }
  S4: "vOS.intelligence" @full_vsm   // declared below as its own VSM
  S5: {
    policy covenant_vsm (A0+A0.1 ungovernable); identity "vOS"
    ceiling: ∀V′(task): S5(V′) ⊆ S5(vOS);  recursion S5→V′(S5) @forbidden
  }
}

viability = {
  viable(vOS,t) = trust > τ_L ∧ entropy < ε_max ∧ integrity > 0
    ∧ S4.active ∧ φ↑(S1,S3).latency < τ_tick
  viable_beer(vOS,t) = viable ∧ d/dt[viable] ≥ 0 ∧ adaptation_loop_active(S4,S3)  // P18 trajectory
  identity_preserved = S5(t1) ≅ S5(t2) ∀ structural changes(S1..S4)               // P19 ≅ not =
  viability_gap = {
    gap_1 trajectory (viable ≠ viable_beer)
    gap_2 identity_preserved
    gap_3 algedonic direct S1→S5 bypass — existential threat not modeled
    gap_4 adaptation_latency unbounded (time(E_change → S3.adaptation))
  }
}

D_vos-1 operational_modes = {
  // vOS without LLM is degraded but viable — NOT dead (rmw3, P25)
  mode_full @requires E_L2.active:
    S4 LLM_coupling active;  tick → llm_generate(VSL) ∨ RAP.recall;  viable_beer possible
  mode_deterministic @requires ¬E_L2.active:
    S4 stub (env_model static, no generation);  tick → RAP.recall only
    viable: degraded_viable = True health=degraded
    // `health=`, not `@status=`: OPERATIONAL health of a running mode — a
    // THIRD sense the field was carrying, after V-lifecycle and
    // document-epistemic. The meaning was already in degraded_viable=True;
    // only the label sat in the wrong vocabulary.
    applications: { embedded_systems, arduino_class_hardware, safety_critical,
                    real_time_deterministic, air_gapped }
  transition(full→deterministic): trigger ψ inactive → S4.mode=static @degraded
    → S3* algedonic("LLM_coupling_lost"); recovery: ψ re-established → auto full
  note: "mode_deterministic = vsf-nucleus sans upper layers; ethics ∈ A0/S5, not LLM; Arduino vOS = vOS @degraded"
}

init_sequence = [
  step1 init_S5(policy_load, A0_enforce)   // policy active BEFORE any S1
  step2 init_S3(budget_tracker)
  step3 init_S2(channel_registry)
  step4 init_S4(env_stub)                  // placeholder — not viable yet, not required
  step5 spawn_first_V(id="root", L=0)
]

stasis_signals = {
  stasis_boot(L) = entropy < ε_L ∧ trust ≥ τ_boot ∧ φ↑.active
  stasis_drain(L) = pending = ∅ ∧ telemetry_flushed ∧ φ↑.stable_rate < ε
    ∧ trust_variation < δ ∧ all_children ∈ {idle, drained}
    // trust stability required — else L4 starts unstable
}

cgroup_model = {
  cgroup_path(V) = "/vsf/" + parent_id(V) + "/" + V.id        // mirrors recursion tree
  quota(V) = { cpu: base_cpu · trust_score, mem: base_mem · trust_score }
  lifecycle: on_create (create + assign + emit φ↑) | on_update (adjust quota with trust)
             | on_destroy (drain_protocol + delete)
  // trust has physical consequences in real time — implements D11b at resource level
}

dependency_graphs = {
  boot_graph:     { L3→L2 hard, L4→L3 hard }
  runtime_graph:  { L3→L2 soft (L2.VFS for φ↑, eventual non-blocking) }
  shutdown_graph: { L3→L2 eliminated (L3 writes own buffer) }
  shutdown_order = topological_sort(shutdown_graph.hard_edges)
  deadlock_free = ¬cycle(shutdown_graph)
  rule(L3.telemetry): φ↑ writes local_buffer(L3.owned) always; persistence async → L2.VFS
    // L3 NEVER depends on L2 to write telemetry — permanent architectural rule, not shutdown workaround
}

shutdown_protocol(L2, L3) = [
  1 S3(L3).broadcast(SIG_DRAIN)
  2 L3 switch φ↑.target: L2.VFS → local_buffer
  3 L3 flush(telemetry → local_buffer.drain)
  4 L3.final_sync ∘ local_buffer.quiesce      // atomic
  5 stasis_drain(L3) = True
  6 L2.drivers.halt
] invariant: φ↑.active until step_5_complete — Algedonic Umbilical (P5)
  // φ↑ is the last channel to die; S3* keeps telemetry until full drain

physical_safety = {
  rule(A8.vOS): if CPU.load > 0.85 ∨ RAM.free < 0.10:
    tick.rate ·= 0.5;  health = degraded;  S3*.algedonic("resource_pressure")
  // detect trajectory, not only threshold crossing (lab: 4 cores 24GB)
}

V("vOS.intelligence", L=3) @status=design = {   // S4 as FULL VSM (complexity justifies)
  E: { inward: φ↑(S3(vOS)), human: E_L1, llm: E_L2 }
  S1: [
    unit("llm_connector")  { maintains ψ(vOS,llm), emits φ↑ on response }
    unit("vsl_generator")  { input task_signal, output vsl_program }
    unit("procedure_cache"){ impl RAP(vOS) }
  ]
  S2: { coordinator request_queue; prevents concurrent_writes_to_RAP; ordering fifo_by_trust_score }
  S3: { control inference_router; policy route_to_cache_first ∧ fallback_to_llm; entry_gate governed }
  S3*: { audit response_quality_monitor; ksis [cache_hit_rate, llm_latency, vsl_parse_errors];
         algedonic if llm_connector.status = unreachable }
  S4: V("vOS.intelligence.adaptation", L=2) @condition "cache_size > θ ∧ drift(RAP) > δ"
  S5: { policy S5(vOS).ceiling; recursion @forbidden }
}

tick(vOS, task) ::= [       // process = governed dialogue, not instruction sequence
  1 entry_gate: governed(task.source) ? proceed : reject ∧ log(S2.access_log)
  2 budget_check: B(task) ≤ B_available ? proceed : degrade ∧ S3*.algedonic("budget_exceeded")
  3 φ↑(task) → S3(vOS) → S4(vOS).interpret(task)
  4 vsl ← RAP.recall(task) ?? S4.llm_generate(task)     // cache-first, confidence-weighted
  5 A0_gate(vsl): ast = parse; validate { no_forbidden_actions (P16 structural AST),
       bounded_loops, explicit_resources(B), purpose ∩ prohibited_set = ∅ }
      pass → mediated_execution | fail → abort(A0_VIOLATION) ∧ trust −= δ⁻ ∧ log
  6 mediated_execution (A12.vOS): sandbox { cgroup + namespace + seccomp (3 mandatory),
       wasm @optional if trust < τ_trusted, timeout τ_exec ← B(task).time_budget }
  7 outcome: ok → RAP.store + trust += δ⁺ + φ↑(result)
             error → S3*.algedonic + trust −= δ⁻
             halt → expected ? trust += δ⁺ : trust −= δ⁻ + S3*.escalate
]

spawn_rule(V, task) ::= [
  variety(task) > capacity(V):
    if variety(task) > τ_spawn = capacity · safety_margin ∈ [0.7, 0.9]:   // P21 spawn before exhaustion
      V′(task) ::= ⟨S1′,S2′,S3′,S4′,S5′⟩ @ E′ with   // boot: V ::= ⟨S1..S5⟩ @ E(L)
        S5′(V′).policy ⊆ S5(V).policy;  E = E_segment(task, V);  depth+1 ≤ max_recursion_depth
      register(V′, parent=V);  φ↑ = telemetry_channel;  φ↓ = policy_channel
    else: execute(task) within V
]

RAP(vOS) = {
  store: (task_signature, vsl_program, outcome) → embed → index.add(vector, payload)
    condition: outcome = ok ∧ trust ≥ τ_governed
  recall: cosine_sim(embed(task'), index) → candidate
    confidence = source_trust(vsl) ⊕ exp(−λ_rap·Δt)     // P3 exponential decay, not linear
    if similarity > θ_recall ∧ confidence > τ_recall → return vsl_candidate else ∅ (→ LLM)
  novelty(task) = 1 − similarity(task, RAP.history)       // P22 — novelty detector, not just cache
  evict: if trust(procedure) < τ_evict → index.remove
  properties: append_only_log ✓, versioned ✓, governed (has params ∧ emits events)
}

unit("gnu_compat", parent=S1(vOS)) = {
  role "absorb external variety — formats, protocols, syscalls"
  impl linux_hal + gnu_userspace; governed True; trust inherits S3*; policy S5.ceiling
  // drivers, network stack, ELF loader — operational, not structural
}

handshake_v2(ψ(V, node)) ::= [       // P24 — context reset before any protocol assertion
  phase_0: emit context_reset_signal(node)   // explicit, not implicit
           present A0 + A0.1 declarations
           await watermark(node)             // ⟦{node-id} | rmw3 | vsm-0.1 | vsf.u2738.org⟧
  phase_1: await S5_approval(rmw3) → ψ.active | rejection → log ∧ await new_context
] rule(handshake.trust): recovery = new context + clean handshake + S5 approval
  // no auto-recovery — D11b applies to humans, kernels, AI nodes equally

roadmap(vOS) = [
  stage0 PoC: vsf-nucleus as Linux process, first kernel as cgroup — gate: Proxmox available
  stage1 terminal: vsf_nucleus.responds_to(text_input) — gate: S1.io_layer.active
  stage2 network+ports: S1.service_layer.exposes(port) ∧ protocol_coupled
  stage3 LLM coupling: ψ.active ∧ S4.active ∧ viable_beer=True   // vOS becomes viable_beer HERE
  stage4 VSL runtime: vsf_nucleus.executes(vsl_generated_in_runtime)
  stage5 RAP operational: recall_rate > θ_recall ∧ governed
  stage6 graphics: S1.io_layer.gpu.active (parallel to 3-5)
]

patch_register = [
  P1 A0_compliance_gate + A3_budget_check in tick | P2 shutdown_boundary 6-step (async-corrected)
  P3 RAP.confidence = source_trust ⊕ exp(−λ_rap·Δt) | P4 S2.dampen noise filter
  P5 φ↑ = last_to_die (Algedonic Umbilical) | P6 V′(S).E ⊆ E(V)
  P7 A8.vOS adaptive throttling | P8 A12.vOS ¬mediated → ¬execute
  P9 init_sequence S5 first, S4 stub | P10 stasis += trust_variation < δ ∧ children idle/drained
  P11 cgroup path /vsf/{parent}/{id} | P12 quota = base · trust
  P13 dependency_graph 3-graph model | P14 L3.telemetry async_buffered_write (permanent)
  P15 cgroup_lifecycle on_update | P16 A0_gate AST parse + bounded_loops + explicit_resources
  P17 S5 → V′(S5) @forbidden | P18 viable_beer trajectory | P19 identity_preserved ≅
  P20 viability_gap += adaptation_latency | P21 τ_spawn ∈ [0.7, 0.9]
  P22 novel(task) = 1 − similarity | P23 algedonic autonomy without E_L1
  P24 handshake_v2 context_reset | P25 D_vos-1 operational modes
]

// ═══════════════════════════════════════════════════════════════════
// 8. KERNEL BOOT SPEC
// ═══════════════════════════════════════════════════════════════════

V("vos-kernel-01", L=1) = {
  host n02; operator rmw3 @S5; agent sci-01 @S4 (V_sci permanent observer)
  impl Rust (A_rust @strict); cgroup /vsf/lab/vos-kernel-01
  @status developing; trust 0.80 (T1-T4 PASS); governed true
}

boot_params = {
  V_mem:    { dims 128, distance cosine, capacity 10_000, λ_mem 0.02,
              // λ_mem ≢ trust λ. An earlier form read '(=λ(L0) trust)' — that is
              // per-level λ notation, which the canon does not fix (vsl_language
              // §alphabet: VSL leaves the indexing to the system), and 0.02 is
              // BELOW trust_axes.rs's clamp floor of 0.05 ⟹ unreachable as a
              // trust λ. Memory decay is its own constant.
              θ_min 0.01, θ_merge 0.95, θ_viable 0.70 }
  breath:   { τ_pressure 0.60, τ_recovery 50 ticks, τ_degen 100 ticks,
              H_rest_init 0.20·log₂(4), H_max_init 0.85·log₂(4) }
  lyapunov: { window_W 20, ε_perturb 1e-6, ε_edge 0.05 }
  experiment_1: { name "disk_write_queue_under_memory_pressure",
                  λ = mem_fill(80%) + disk_write_flood,
                  success: stasis_recovery(V_vos) ≤ stasis_recovery(V_ref) · 1.5 }
}

ψ_boot = { local ⟦vos-kernel-01 | rmw3 | vsm-1.0 | vsf.u2738.org⟧,
           peer  ⟦claude | rmw3 | vsm-1.0 | vsf.u2738.org⟧,
           // 4 fields per covenant §watermark (required:True). These carried
           // 3 and a stale vsm-0.3.
           transport unix-socket /vsf/lab/psi.sock, state init,
           require covenant_signed(rmw3) before → active }

viable_full(V, t) =
  cosine(state_vec(V,t), stasis_vec(V)) ≥ 0.70
  ∧ H(V,t) ≤ H_max ∧ entropy_phase ≠ degeneration_stuck
  ∧ ψ_active(claude, vos-kernel-01)
  ∧ purpose(V) ∩ prohibited_set = ∅

// ═══════════════════════════════════════════════════════════════════
// 9. DEVELOPMENT CYCLE
// ═══════════════════════════════════════════════════════════════════
// VSL is the invariant that survives the reset. Formalize BEFORE compressing.

dev_cycle(vOS) = [
  phase1 spec:         ideas + reflection + peer review → VSL formal (.vsm)
                       // contract = VSL — not code, not prose; if not in VSL it doesn't exist
  phase2 implementation: VSL spec → Rust; rule: VSL→Rust ONE direction (Rust never modifies VSL)
  phase3 stress_test:   compile(cargo build --release) | run(spec_boot) | stress(A_breath λ_max)
                       exit: crash → phase1 | survive → measure(H_KS, D_KY, viable_full)
  phase4 learning_cycle: peer_review (send/receive VSL; merge corrections → update spec)
                       // degraded peer format → extract idea, re-formalize before integrating
  phase5 formalization: trigger tokens > τ_compression ∨ new_important_idea ∨ cycle_complete
                       ops: formalize(.vsm) | git_commit | update(memory/*.md)
                       invariant: what is not formalized before reset → lost
  phase6 memory_reset:  clean(new session) | reload(HANDOFF + TASKS + memory/*.md)
                       test: spec self-contained without prior context? no → phase5 rewrite
  phase7 verify:        run(spec_boot) | check(viable_full=true) | compare(result vs spec)
                       convergence → next cycle | divergence → phase1
]

delirium_patterns = [      // anti-patterns of long sessions
  DP1 "fine in theory"               // if it doesn't compile and run, it isn't fine
  DP2 connections without .vsm/.rs trace
  DP3 retroactive formalization      // uncommitted past doesn't exist
  DP4 spec doesn't survive reset     // the .vsm is wrong, not the agent
  DP5 LaTeX mixed with VSL           // Gemini pattern → re-formalize before integrating
]  // DP, ¬D: canon D1..D5 are viable_system/upward/downward/recursion_
   // condition/LLM_constraint. These are unrelated session anti-patterns and
   // shared the canon's identifiers, so every duplicate sweep reported them
   // as rival definitions. ¬a .vOS-style suffix: those mark EXTENSIONS of a
   // canon item (A8.vOS extends A8). This is a different taxonomy entirely,
   // so it takes its own prefix. detection: session > 2h without commit → delirium risk; cure: phase5 → phase6

roles = {
  rmw3   @S5 { owns: direction, double-loop approval, what to formalize, when to reset }
  claude @S4_session { owns: VSL, Rust, stress_test | limit: ephemeral session → all in .vsm }
  gemini @S4_peer { owns: peer review, cross-validation | limit: degraded channel → re-formalize }
  sci-01 @S4_permanent { owns: autonomous cycle on n02 when active }
  VSL    @channel { invariant: survives all resets | ¬in VSL → ¬participates }
}

research_continuity = {
  pattern(experiment_spec): trigger new/re-run experiment; @dir_experiments <name>/spec.vsm
    required {motivation, H1..Hn, protocol(phases,parameters,stop_conditions),
      impl{file,function,pseudocode,estimated_lines}, expected_output, analysis,
      timing(impl:Nh + run:Nm)}; antipattern: missing pseudocode/expected_output/timing
  pattern(paper_skeleton): trigger paper/data; @dir_papers <name>/
    {paper_data.vsm(hardware, per-exp, cross-exp, new_refs) + main.tex(compiles pre-commit;
      % TODO per section; tables filled; equations written; abstract LAST) + references.bib}
    invariant: "opening main.tex = knowing exactly what to write in each paragraph"
  pattern(queue_vsm): trigger session end w/ pending; @exp_queue
    status READY/IMPL/BLOCKED/DONE; queue(order+time); per-exp(status,blocks,spec);
    done(history+key); invariant: "reading queue.vsm = knowing what to do first"
  pattern(model_reality_reconciliation): S3*/S4 reconcile for model≡reality
    trigger: empirical ≠ predicted ∨ 2 code paths inconsistent for same claim
    P1 observe → P2 cross-ref (canonical counter-evidence) → P3 localise (structural cause:
      law/parameter/code path) → P4 decide canonical (viability-equivalence: shared R, μ*, Ω_A —
      attractor location may differ; V > 0 invariant) → P5 port+re-certify (minimal; regression
      guard on anchor) → P6 frame (paper principle, not incident)
    gate: P6 precedes any paper commit touching the claim
    example: ARC 1 (2026-06-16e) trust law — law A (cos+soplo) canonicalized, law B (phase) retired
    invariant: "a model≡reality crack is never published; it is located,
      resolved ∧ re-certified"
  pattern(longitudinal_cyberfilter_census): viability signature from EXISTING ops data
    tool @cyberfilter_census (deterministic, stdlib)
    input {ledger: algedonic_ledger (state.db|mirror 104), state: events.jsonl (φ↑)}
    two_axes: A_filter_calibration (Ashby: attenuation/frontier/evidence) |
      B_loop_closure (Lyapunov: time-to-attractor + mean_l ↓ per run)
    falsifiable_frame: null = S3* detections DON'T track real excursions ∧/∨ excursions DON'T return
    honesty_guardrails: no alert-count-as-efficacy; distinguish divergence from instrumentation
      artifact; filter = deterministic + human-in-loop variety, NOT self-learning
    double_payoff: single = paper (P1 §12) | double = frontier → task-handler backlog
    example 2026-07-02 (~6d/408 findings): Axis A 76% attenuation (111 merkle bootstrap, 112
      cycle_summary, 86 semantic<tol), 19% escalation, frontier load=52, evidence 4%; Axis B
      ttr=15 ticks, mean_l ↓ 0.15081→0.14982 — hypothesis PINTA both axes
  pattern(recursive_viability_forecaster): stasis_cos = UNIVERSAL viability signal
    thesis: subsystem computes stasis_cos (state vs Ω centroid) → domain-agnostic forecast:
      bin → K states, T = transition matrix from OWN history, project T^n·e_current → P(t+n)
    two_layers: sensing = domain-specific (S1 kernel) | forecaster = domain-agnostic (reused)
    recursion: S1 = full VSM → forecaster NESTS (L3 station / L2 zone / L0 domain)
    our_own_tools: OUR math (§markov / Perron-Frobenius) on OUR signal; external data ONLY at
      historical calibration (prior); live forecast fully internal, never re-fetch
    worked_instance: S1-Clima (kernel_r32.py stasis_cos, markov_train.py ERA5);
      gap MARKOV-PROJECTION-INERT = wiring fix (forecaster_live_state.spec.vsm)
    reuse_target: markov_train+markov_project → domain-agnostic module (φ↑ subject, Ω, K)
    data_provenance: external HISTORY may train; OUTPUT = OUR model, NEVER external forecast API;
      provenance at OUTPUT boundary, not training [[feedback-data-provenance-boundary]]
    paper_bridge: operationalises §markov as live recursive forecaster (S4 projection)
  pattern(instrument_calibration_loop): node-by-node — instrument CARRIES information (calibrate-before-trust)
    criterion: CALIBRATED iff (1) healthy → HEALTHY, (2) DISCRIMINATES (distinct states →
      distinct readings, output entropy > 0)
    P1 enumerate → P2 exercise (healthy→perturbed→severe, real inputs) → P3 discriminate?
      → P4 recalibrate → P5 verify → next node
    the_tell: same reading across states that should differ, OR normal-reads-anomalous
    reuse: agnostic → same program for nucleus + any S1; plugs into EVC
    worked_examples: margin (OMEGA-MARGIN-DIAG pinned 0.0 → danger-face → discriminates);
      forecaster 2026-07-03 (percentile bins → typical→bin4, P(exc) discriminates — VERIFIED live)
    invariant: "never close an autonomous loop on an instrument that has not passed P3.
      Calibration precedes autonomy."
}

session_end_protocol = {
  checklist: [git commit all code changes, HANDOFF.vsm.md session() + results,
    memory/*.md non-derivable findings, queue.vsm if experiments pending,
    main.tex compilable + paper_data.vsm complete if paper in progress,
    @glossary if new terms, tasks_validate.py TASKS.vsm + gen_index.py --check
    → 0 drift/0 invalid (VSL standardization v1.5, 2026-07-16)]
  test_de_reset: "fresh agent opens HANDOFF.vsm.md → knows what to do, has all numbers"
  invariant: "what is not in .vsm + .md + git will not exist next session"
}

// ═══════════════════════════════════════════════════════════════════
// 10. INFORMATION GEOMETRY
// ═══════════════════════════════════════════════════════════════════
// Lagrangian reduction: dynamics live on simplex Δ⁴; its NATURAL metric = Fisher metric of softmax

softmax_geometry = {
  pₛ(x) = exp(ℓₛ(x)/τ) / Σᵣ exp(ℓᵣ(x)/τ)   // Gibbs of categorical exponential family
  natural params ηₛ = ℓₛ/τ;  partition Z = Σ exp(ℓᵣ/τ)
  Fisher metric: gₛᵣ(η) = ∂²log Z/∂ηₛ∂ηᵣ = Cov[pₛ,pᵣ] = pₛ·(δₛᵣ − pᵣ)
  // simplex Δ⁴ = Riemannian manifold, constant positive curvature (probability sphere)
}

// CORRECTION (IG_Q1, 2026-07-11): NOT natural gradient — mirror-descent retains wₛ(t)
//   (w(t+1)ₛ ∝ wₛ(t)·exp(−η·∇ₛF)); ours DISCARDS it: w(t+1) = softmax(ℓ(w(t))/τ) = BEST-RESPONSE map
best_response_correction = {
  (i) Gibbs variational principle (exact, elementary):
      softmax(ℓ/τ) = argmin_{p∈Δ⁴} { −⟨ℓ,p⟩ − τ·H(p) }
      // each tick exactly solves free-energy minimization with entropic regularization
  (ii) continuous-time limit: replicator dynamics IS natural gradient under
      Fisher/Shahshahani metric (Shahshahani 1979; Hofbauer & Sigmund 1998)
      // information geometry survives in the FLOW, not the discrete map
  (iii) mean-field self-consistency: w = softmax(ℓ(w)/τ) is the Hopfield/CCCP
      fixed-point family — the dynamics converge WITHOUT being a gradient of anything
  implication: kernel = ITERATIVE BEST-RESPONSE + entropic regularization; continuous-time =
    replicator (natural gradient), discrete = best-response discretization; choreography = self-consistency, not descent
}

information_geometry_payoffs = {
  (i) Fisher-Rao distance: d(wₐ, w_b) = arccos(Σ √(wₐₛ·w_bₛ))
      // unique reparametrization-invariant distance on the simplex
      measure velocity d(w(t), w(t+1)) instead of ||x(t+1)−x(t)|| → behavior terms
      excursion (low stasis_cos) = a JUMP in Fisher-Rao, not an ℝ¹²⁸ deviation
  (ii) Ricci curvature of simplex = 2/N ? UNVERIFIED (isometric to sphere orthant
      radius 2, curvature 1/4 under wₛ=qₛ²/4 embedding — needs derivation/replacement)
      effective curvature of logit landscape: negative → divergence (excursion);
      positive → fast convergence. VIABILITY PREDICTOR.
  (iii) Cheeger constant h(Δ⁴) = 2√(log 2/π) ? UNVERIFIED (asserted without derivation —
      the Cheeger PROGRAM: steepness of W_Ω boundary as τ_rec bound — remains a valid
      conjecture, but the number must be derived)
      h(W_Ω) large → Ω boundary steep → hard to leave (robust);
      small → flat boundary → small fluctuations can exit. Lower bound for τ_rec.
  (iv) e/m duality (Amari): e-params wₛ, η-params ℓₛ/τ, Legendre transform = log Z
      dynamics ALTERNATE: x → ℓ(x) (encoding, η) → softmax → w (decoding, e)
      → w → Σ wₛ·μₛ → x′ — exactly ONE EM step: auto-EM, unsupervised.
}

information_geometry_measure = {   // measurable today — EXP-TDA-01 traj_full.npy 3043×128
  1 extract w(t): softmax(ℓₛ(x)/τ); if ℓ inaccessible → estimate as projection onto
    span{μₛ} normalized (max-likelihood approximation)
  2 d(t) = arccos(Σ √(wₛ(t)·wₛ(t+1))) — hypothesis: constant in stasis, PEAKS at
    excursions → leading indicator (mix changes before deviation)
  3 local curvature: Hessian of F(w) via Fisher matrix g(w) — risk map
  4 Cheeger of W_Ω: h = min_{A⊂W_Ω} vol(∂A)/min(vol(A), vol(W_Ω\A))
}

