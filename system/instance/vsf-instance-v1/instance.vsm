  resolution: {
    rule:     "≡ R_ref_resolution — system bodies carry @var only; bind(@var)
               resolves HERE to a concrete path",
    check:    "∀ @var ∈ system/ ∃ bind          — no dangling reference
               ∀ bind ∃ ref ∈ system/         — no orphan binding
               // BOTH directions are gated by @gate_symbols --paths.
               // Until 2026-08-08 only the second was: the first was computed
               // as `v ∉ bound ∧ v ∈ bound`, empty by construction, and then
               // printed nowhere. The block above asserted a check that could
               // ¬fail. An orphan binding is transient while a fuse is being
               // written — the references arrive with the document — so a
               // standing orphan is a finding, a fresh one is work in flight.
               ref = @var OR the document's NAME. Naming covenant_ops or
               state.db in prose is ¬a path and needs ¬substitution; R_ref
               forbids PATHS. A binding exists so that a path CAN be written
               symbolically when one is needed.
               // .primer_sources_manifest.json was bound and referenced
               // nowhere — a gate artifact, ¬a document reference. Removed
               // 2026-08-07 rather than left as a standing check failure.",
    ratify:   "draft → ratified with system/; originals archived in
               docs/archive/agent_protocol_2026-10-30/; production canon
               lives in system/boot/",
  },

  substrate: {
    note:     "concrete values (dim(R), LXC, services) ∉ this draft — they
               belong to per-S1 instance docs; validated once PH-12 runs",
    state:    "VSF@n02: 15 LXC + host pseudo-node ▪ dim(R)=128 (covenant_ops
               calib 2026-05) ▪ nats token-auth ▪ ollama",
    // VERIFIED live 2026-08-08: pct list = 15 running, state.db lxcs = 16
    // rows (15 + the host pseudo-node). The doc said 7 — the count from
    // before clima/econ/SOC. A stale census in the BINDINGS registry is the
    // worst place for one: every doc that cites @state_db inherits it.
  },

  operations: {
    // Operational values of THIS box (moved from RULES.md R8 + annex CA,
    // 2026-08-12 boot compression — R_param_resolution: substrate artifacts
    // live here, ¬in rule documents). NOTE: keys in this block are NOT
    // bindings; symbol_table --paths does not count non-bindings keys as
    // bindings (verified 2026-08-12 before adding — 128 bindings, no new
    // orphan/dangling introduced).
    n01_access:   "ssh n02 ∘ n01  (n02-hop = 127.0.0.1:2290, reverse tunnel)
                   n01 root login: disabled — reach as n01 (rmw3, file-ops
                   only) or n01-vsf (vsf, NOPASSWD only for `systemctl
                   restart vsf-bastion`)
                   never: probe root@n01.u2738.org — fails publickey BY
                   DESIGN, not a block signal
                   (R8 ≡ regulation_layer.spof_pattern; why: 2026-06-03
                   probe-fail ≠ blocked, R5 violation)",
    s5_ca_renewal: "S5 CA root renewal (ITEM_6.4): offline root key
                   (ed25519 624e8d3e…, WSL+USB, memory `project_s5_ca`)
                   expires 2027-06-08 — covenant boot verification fails
                   closed if invalid. Renew before 2027-05-01. Automated
                   guards exist (A1c/A1d/A1e); this entry is the human
                   backstop.",
  },
