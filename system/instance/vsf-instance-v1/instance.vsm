// instance/instance.vsm — bindings registry (DRAFT; ratified w/ system/)
// * = project root CONSTANT (~/vsf/ here); @var→path lives ONLY here
// Per R_ref_resolution: explicit paths in system bodies ⟹ ⊥

instance("VSF-INSTANCE-v1") {

  root: {
    symbol:      "*",
    value:       "~/vsf/",
    role:        "project root — constant, ¬resolved by this doc",
    spec_root:   "system/",          // universal doc tree (publication-safe)
    // THREE roots, and a binding must say which it uses:
    //   *          this repository        — tooling, sources, governance
    //   spec_root  the published spec     — intra-system refs, layout-free
    //   node:      an absolute node path  — live substrate, ¬portable
    // Found 2026-08-08: intra-system refs were bound through *, which puts
    // docs/spec_revision/system/… inside a tree whose whole purpose is to
    // ¬carry this repository's layout.
    instance_dir:"instance/",        // this config
    agent_dir:   "repo root",        // TASKS/ROADMAP/HANDOFF/BRIEFING/RULES
  },

  bindings: {
    // external tooling (outside system/) — @var, never inline
    envelope_validator: "scripts/vsl/tools/envelope.py",
    vsl_parser:         "scripts/vsl/parser/vsl_parser.py",

    // certification gates (§7b conformance in boot/vsl_language)
    gate_closure:       "scripts/vsl/validator/verify_primer_closure.py",
    gate_encoding:      "scripts/vsl/validator/verify_encoding.py",
    gate_staleness:     "scripts/vsl/validator/verify_boot_primer.py",
    gate_covenant_hash: "scripts/state/attestation/verify_covenant_hash.py",
