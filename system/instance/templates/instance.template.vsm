@vsm 1.2.1
@status template
// system/instance/templates/instance.template.vsm — the ROOT instance schema
//
// PUBLICATION-SAFE.
// Carries the SHAPE of an installation's configuration, ∄ value of one.
// Every field is a SLOT: an installer fills it; until then it reads <…>.
// ∄ concrete path ▪ ∄ address ▪ ∄ hostname ▪ ∄ key ▪ ∄ dimension.
//
// This is the artefact R_ref_resolution was FOR.
// The corpus spent this cycle moving 100+ explicit paths out of universal
// documents into @var bindings — so a stranger can take system/ ⊕ this
// template and stand up their own VSM, inheriting ∄ LXC number of ours.
//
// FILL: copy to the instance rail, replace every <…>, delete ∄ field.
// A field that does not apply is declared ∅, never REMOVED:
// validation checks for blanks, and a deleted slot reads as one nobody
// considered.

instance("<INSTALLATION-ID>") {

  // ── ROOT DECLARATION — binds * for this installation ──
  root_decl: {
    symbol:      "*",
    value:       "<spec-doc root for this installation>",
    role:        "the ONE place * becomes concrete.
                  Universal documents write */… and ∄ real path;
                  this line resolves them all.",
    spec_root:   "<universal doc tree>",
    instance_dir:"<this config's own directory>",
    agent_dir:   "<agent-layer root — TASKS/ROADMAP/HANDOFF/RULES>",
    // Three roots exist and a binding must say which it uses:
    //   *          this installation's repository
    //   spec_root  the published spec — intra-system references
    //   node:      an absolute path on a named node — ¬portable
  },

  // ── SPACE — the state vector and its viable set ──
  space: {
    dim:         "<dim(R) — the state-vector dimension>",
    omega:       "Ω = {x ∈ ℝ^dim | A·x ≤ b}",
    omega_form:  "<convex polytope | ellipsoid | box | other.
                  If OTHER: what guarantees attractor existence here?>",
    theta_viable:"<the viability threshold on the viability scalar>",
    basin_floor: "<worst observed value still inside the basin.
                  ∅ until measured>",
    // Q1 of the domain-validation protocol lives here: a domain that cannot
    // state its constraints as a convex set must SAY what it has instead.
  },

  // ── TELEMETRY — the φ↑ substrate ──
  telemetry: {
    channel:     "<the canonical upward channel — the FILE or stream that IS
                  the record, ¬a replica of it>",
    replicator:  "<optional live fan-out. ∅ if the channel is read directly>",
    event_types: "<the typed events this installation emits>",
    integrity:   "<hash chain | signature | ∅.
                  If ∅: what makes the record trustworthy instead?>",
    cadence:     "<emission period>",
    retention:   "<how long the record is kept, and who may prune it>",
  },

  // ── SUBSTRATE — what this installation runs on ──
  substrate: {
    nodes:       "<count and kind of execution units>",
    broker:      "<coordination substrate, ∅ if ∄>",
    state_store: "<the declarative canon.
                  Where model≡reality is adjudicated>",
    cognitive:   "<LLM or other L≥2 facility, ∅ if ∄ — D6 forbids it at L0/L1>",
    // ∄ address ▪ ∄ hostname ▪ ∄ container id.
    // Those belong to the instance rail. An installation that pastes them
    // HERE has published its topology.
  },

  // ── BINDINGS — @var → concrete, the ONLY place paths live ──
  bindings: {
    rule:        "∀ document ∈ spec_root: ∄ explicit path in the body.
                  A document names external things by @var; this block binds
                  @var to something concrete for THIS installation.",
    check:       "∀ @var ∈ spec_root ∃ bind   — ∄ dangling reference
                  ∀ bind ∃ ref ∈ spec_root    — ∄ orphan binding
                  BOTH directions, ∨ the rule is half a rule.",
    tooling:     "<gates, validators, parsers this installation runs>",
    sources:     "<provenance documents cited by the spec tree>",
    runtime:     "<live artefacts: state store, registries, key material>",
    // An orphan binding is TRANSIENT while a document is being written —
    // the references arrive with it. A STANDING orphan is a finding.
  },

  // ── CONTRACTS — couplings at EQUAL or HIGHER hierarchy ──
  contracts: {
    scope:       "couplings ¬tied to one S1: instance ↔ instance,
                  instance → parent, root φ↑/φ↓.",
    placement:   "a contract lives in exactly ONE document.
                  Horizontal couplings of a specific S1 live in THAT S1's
                  contract, ¬here.
                  Duplication is ¬redundancy — it is a divergence with a date.",
    channels:    "<per channel: direction, role, carrier, schema, cadence,
                  payload bound, loss tolerance>",
    peers:       "<other installations this one couples to, ∅ if isolated>",
  },

  // ── AUTONOMY — the ceiling, declared before it is needed ──
  autonomy: {
    ceiling:     "<the highest class this installation may act on alone>",
    single_loop: "<what it may do without asking — parameter movement>",
    double_loop: "<what ALWAYS requires a human — axiom or topology change>",
    kill_scope:  "<may this installation stop a unit? by whose authority?>",
    // Declare this BEFORE an emergency.
    // A priority order invented UNDER contention is a judgement, ¬a policy.
    // The two are told apart by whether it was written down first.
  },

  // ── S1 REGISTRY — one entry per unit that does work ──
  s1_registry: {
    rule:        "∀ S1: a full V, ¬a subsystem.
                  Each gets its own directory with BOTH a contract AND an
                  instance document.",
    units:       "<list. Each expanded in its own S1 directory>",
  },

  validation_ref: "<this installation's validation document>",
}

⟦ /instance.template ⟧
