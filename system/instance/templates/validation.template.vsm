⟦ validation.template | VSF-INST-TPL-VALIDATION  | vsm-1.2.1 | 2026-09-07T22:27:20Z ⟧

@vsm 1.2.1
@status template
// system/instance/templates/validation.template.vsm
// The CHECK schema — what an installation must pass to call itself configured.
//
// PUBLICATION-SAFE. Checks ∄ results.
//
// This document closes the configuration. Filling every template is ¬enough:
// an installation is configured when the filling has been CHECKED, and this
// is the list of checks. Copy it, run it, record the outcomes.
//
// Every check states WHAT IT DOES NOT COVER. That field is ¬modesty — it is
// the difference between a gate and a belief. A check whose blind spots are
// unlisted gets trusted for things it never examined.

validation("<INSTALLATION-ID>") {

  // ── COMPLETENESS ──
  c1_pairs: {
    checks:  "∀ template ∈ instance/templates ∃ an instantiated counterpart",
    fails_if:"a slot is left blank, ∨ a template has ∄ counterpart",
note:    "a field that does not apply is ∅. A DELETED field reads as one
              nobody considered, and this check cannot tell them apart —
              which is why the templates say ∅, never remove.",
    covers_not: "whether the filled value is TRUE. Only that it is present.",
  },

  c2_s1_pairs: {
    checks:  "∀ S1 ∃ BOTH a contract and an instance document",
    fails_if:"an S1 has one of the two",
    covers_not: "whether the two AGREE with each other.",
  },

  // ── THE PUBLICATION BOUNDARY ──
  c3_root_resolves: {
    checks:  "* resolves via root_decl to something concrete,
              ∧ ∀ universal document writes */… and ∄ concrete path",
    fails_if:"a concrete path leaked into a publication-safe document",
    why:     "this is the check the whole @var discipline exists for.
              One leaked path publishes a topology.",
    covers_not: "user-absolute forms unless the gate is taught them —
                 ~/… and /home/… passed a repo-relative check for weeks here.",
  },

  c4_no_secrets: {
    checks:  "∄ credential, key, token ∨ fingerprint in any published document",
    fails_if:"a literal appears where a reference belongs",
    covers_not: "history. A secret removed from the tree stays in the log.",
  },

  // ── COHERENCE ──
  c5_contract_uniqueness: {
    checks:  "∀ contract ∃ exactly ONE document declaring it",
    fails_if:"the same coupling is declared twice",
    why:     "two declarations are two statements that will disagree.",
    covers_not: "a coupling declared NOWHERE. Absence is silent here —
                 that is what the census is for.",
  },

  c6_hierarchy: {
    checks:  "horizontal couplings ∈ the S1 contract
              ▪ equal-or-higher couplings ∈ the root instance document",
    fails_if:"a contract sits at the wrong level",
    covers_not: "whether the coupling is a good idea.",
  },

  c7_bindings: {
    checks:  "∀ @var ∃ bind  ∧  ∀ bind ∃ ref     — BOTH directions",
    fails_if:"a dangling reference ∨ a standing orphan binding",
    note:    "an orphan is TRANSIENT while a document is being written.
              A standing one is a finding.",
    covers_not: "whether the bound target EXISTS on this installation.",
  },

  // ── SUBSTRATE ──
  c8_parse: {
    checks:  "∀ document parses under the reference grammar",
    fails_if:"any document fails",
    covers_not: "meaning. A document can parse and be false.",
  },

  c9_model_reality: {
    checks:  "declared substrate ≡ observed substrate, BOTH directions",
    fails_if:"a declared unit is absent (ORPHAN)
              ∨ an observed unit is undeclared (MISSING)",
    why:     "the second direction is the one installations skip. A process
              nobody declared cannot be reported by a reconciler that only
              walks the declarations — and a process EXEMPTED as noise cannot
              be reported at all.",
    covers_not: "anything on an exemption list. Audit that list separately;
                 it is where undeclared things go to become invisible.",
  },

  c10_gates_current: {
    checks:  "∀ cited gate states its CURRENT closure criterion",
    fails_if:"a satisfied precondition is cited as the blocker",
    why:     "the next reader checks it, finds it green, and starts.",
    covers_not: "whether the gate SHOULD still be closed.",
  },

  // ── DEBT ──
  c11_debt_register: {
    checks:  "∀ deferred finding carries a marker with class, owner, body",
    fails_if:"a finding was deferred in prose",
    why:     "a debt that leaves the document becomes a backlog, and a
              backlog is where findings go to stop being read.",
    covers_not: "whether the debt is being WORKED. Only that it is findable.",
  },

  outcome: "<CONFIGURED ⟺ ∀ check passes.
            ∄ partial credit — an installation with one failing check is
            configured in the parts that pass and unknown in the rest,
            which is ¬the same as configured>",
}

⟦ /validation.template ⟧
