⟦ instance | VOSLAB-INSTANCE-v1 | vsm-1.2.1 | 2026-09-10T22:29:51Z ⟧

@vsm 1.2.1
@status ratified

// instance/voslab-instance-01/instance.vsm — vOSlab bindings registry.
// Root uses <workspace> symbol — resolves to the workspace root directory.
// Clone-portable: set VOSLAB_PATH env var or ensure current_focus.json exists.
// Mandatory per binding policy: boot artifacts + policy docs. Verified by
// test_instance_bindings (every binding resolves; every mandatory bound).
// @status ratified: S5 ratified after verification run (bindings green).
// attestation: rmw3 S5 decision in session (test_instance_bindings 2/2).
instance("VOSLAB-INSTANCE-v1") {

  root: {
    symbol: "*",
    value:  "<workspace>/",
  },

  bindings: {
    doc_boot_manifest: "*/system/boot/boot_manifest.vsm",
    doc_communication_protocol: "*/system/boot/communication_protocol.vsm",
    doc_core_boot_primer: "*/system/boot/core_boot_primer.vsm",
    doc_covenant: "*/system/boot/covenant.vsm",
    doc_hard_rules: "*/system/boot/hard_rules.vsm",
    doc_regulation_layer: "*/system/boot/regulation_layer.vsm",
    doc_vsl_language_primer: "*/system/boot/vsl_language_primer.vsm",
    doc_s5_readme: "*/system/s5-policy/readme.vsm",
    doc_s5_annex: "*/system/s5-policy/s5_policy_annex.vsm",
    doc_s5_core: "*/system/s5-policy/s5_policy_core.vsm",
    doc_write_gates: "*/docs/spec_revision/system/s5-policy/agent-policy/agent-write-gates-v1/write_gates.vsm",
    src_access_policy: "*/system/s5-policy/access_policy.json",
    doc_lifecycle_policy: "*/system/s5-policy/lifecycle-policy-01/lifecycle_policy.vsm",
  },
}
⟦ /instance ⟧
