@vsm 1.2.1
@status template
// system/s1-operations/s1-template/contract.template.vsm
// The S1 CONTRACT schema — what one unit of work is coupled TO.
//
// PUBLICATION-SAFE. Shape ∄ values.
//
// PLACEMENT — the reason each S1 has two documents:
//   contract  → HORIZONTAL couplings: peers, external systems, nested
//               components, coordination. EQUAL or LOWER hierarchy.
//   instance  → what the unit IS: domain, services, topics, ceiling.
// A coupling toward an EQUAL or HIGHER level — parent, root, another
// installation — belongs to the ROOT instance document, ¬here.
//
// A contract lives in exactly ONE place.
// Duplicating it is ¬redundancy: it is two statements that will disagree,
// and the disagreement arrives with a date.

contract("<S1-ID>") {

  identity: {
    unit:        "<the S1 this contract belongs to>",
    is_a:        "a full V — ¬a module, ¬a subsystem, ¬a stack",
    parent:      "<the V whose S1-set contains this one>",
    // A1: S1(parent) = { V_i(child) }, child = parent's level + 1.
    // CITE it. Three documents here inverted the direction by rewriting it.
  },

  // ── HORIZONTAL COUPLINGS — why this document exists ──
  peers: {
    rule:        "A4 — ∄ direct sibling coupling.
                  A peer coupling is ENACTED through the shared parent's S3.",
    note:        "A4 constrains HOW it runs, ¬WHERE it is declared.
                  The contract belongs to this S1.",
    couplings:   "<∀ peer: {peer_id, purpose, direction, mediated_by,
                  what breaks if it stops}>",
  },

  external: {
    rule:        "systems outside the installation.
                  Each needs a stated TRUST basis.
                  'it is internal' is a LOCATION, ¬a warrant.",
    couplings:   "<∀ external: {system, purpose, protocol, trust_basis,
                  failure_mode, blast_radius if compromised}>",
    // blast_radius is ¬optional.
    // A coupling described without its reach reads as safe.
  },

  nested: {
    rule:        "components INSIDE this unit.
                  A nested component that is itself viable is a V,
                  and gets its own pair of documents.",
    components:  "<∀ nested: {name, role, is_viable, own_documents?}>",
  },

  // ── CHANNELS — the contracted shape of every wire ──
  channels: {
    phi_up:      "<child → parent.S3 ▪ telemetry ▪ attenuated>",
    phi_down:    "<parent.S3 → child ▪ parameters ▪ amplified>",
    algedonic:   "<child → parent.S5 ▪ emergency ▪ bypasses S3>",
    s2_lateral:  "<coordination, mediated by the parent's S2>",
    psi:         "<S4 ↔ peer S4 ▪ ∅ unless the preconditions are met>",
    per_channel: "<direction, role, carrier, schema, cadence, payload bound,
                  loss tolerance, WHAT SILENCE MEANS>",
    // Silence is the field people skip and then need.
    // A quiet channel is healthy or dead.
    // The contract is where that ambiguity gets removed in advance.
  },

  // ── OBLIGATIONS — what this unit owes, and is owed ──
  obligations: {
    emits:       "<what the parent may RELY on receiving>",
    consumes:    "<what this unit needs to function>",
    guarantees:  "<invariants held even while degraded>",
degrades_to: "<the reduced but honest mode. not 'fails'>",
    never:       "<what it will ¬do regardless of instruction>",
    // `never` is the unit's refusal surface and it outranks a directive.
    // An empty `never` declares the unit will do anything asked.
  },

  gate: "<the condition under which this contract becomes ACTIVE.
         State the CURRENT closure criterion, ¬the one that applied when it
         was drafted. A satisfied precondition cited as the blocker is how a
         gate gets opened by accident>",
}

⟦ /contract.template ⟧
