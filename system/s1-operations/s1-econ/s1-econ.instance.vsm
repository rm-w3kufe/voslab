// system/s1-operations/s1-econ/s1-econ.instance.vsm
// S1 INSTANCE — what s1-econ IS (per
// s1-operations/s1-template/instance.template.vsm — EVERY field).
// Pairs with s1-econ.contract.vsm.
// Values measured 2026-08-09: @state_db `vsf-q services 2>&1`
// (lxc_113 = 1 service, s1-econ-kernel, active=1) · EXP-LL-01 results
// (Scarf convergence: S3_only false, S3+S4 true).

s1_instance("S1-ECON") {

  identity: {
    unit:    "s1-econ (LXC 113)",
    domain:  "socioeconomic allocation — Lange-Lerner tatonnement as a
              VSM control loop (price update dpᵢ/dt = kᵢ·zᵢ(p), excess
              demand z = qᵈ−qˢ is the φ↑; EXP-LL-01 lineage:
              Lange-Lerner 1936 → Beer VSM → Cybersyn 1971 → VSF)",
    is_a:    "a full V with its own S1..S5 — ¬a subsystem of its parent",
    purpose: "produces the allocation variety the parent S3 needs —
              a central regulator governing prices via negative
              feedback without markets.
              WHAT FAILS IF IT IS ABSENT: the socio-economic domain
              gets ∄ S1 → S3 alloc bargains on climate demand alone;
              the Lange-Lerner empirical line (calculation debate,
              Hayek-as-Ashby variety question) dies un-instantiated",
  },

  substrate: {
    execution: "one LXC (s1-econ, VLAN 10.10.20.113) — kind of unit,
              ¬an address",
    isolation: "own crash domain (kernel ≠ clima's container — a clima
              failure cannot take tatonnement down); VLAN20 boundary;
              copper feed is external (blast radius in contract)",
    services: "1 service — s1-econ-kernel (active=1 measured
              2026-08-09 — the ONLY live S1 service in the census)",
    scale:    "count driven by the reference economy: n=3 goods (Scarf
              reference case), generalizable — one kernel process
              regardless of n; scale ∝ nothing else",
    // Own crash domain enforced — topology matches the model.
  },

  viability: {
    signal:    "stasis_cos + excess_demand_norm + copper_force + regime
               (s1_spec §2 econ instrument set)",
    omega:     "the viable set IN THIS DOMAIN — the price simplex
               Σpᵢ = n, p ∈ ℝⁿ⁺ (EXP-LL-01 model: equilibrium p*
               where z(p*) = 0), NOT the parent's R^128",
    threshold: "stasis_cos < 0.9365 (best-known viable floor from the
               thermal envelope, conservative cross-domain reference
               until econ's own floor is MEASURED under exercise —
               s1_spec §2: econ discrimination is the open work) ∨
               |excess_demand_norm| above the escape band",
    measured_by: "the kernel's own computation → SELF-REPORT, stated as
               such (template: say so). Independent checks available:
               EXP-LL-01 results file (measured d_final per cell)
               + the S1-LIVE-VALUES-UNVERIFIED debt (s1_spec §7:
               0.9986/0.0014/1.0745 carry an unexecuted VERIFY)",
  },

  topics: {
    grammar:   "@dir_nats_topic (vsl-nats-v1)",
    rule:      "a unit writes its OWN subtree, reads ∄ sibling's (A4)",
    phi_up:    "vsf.alpha.vsf_econ.up.<event_type> — excess_demand_norm,
               stasis_cos, copper_force, regime; replicated to
               @events_jsonl",
    algedonic: "vsf.alpha.algedonic — the emergency subject (|z| escape)",
    cadence:   "kernel tick for φ↑; algedonic immediate. A GAP means:
               kernel dead — immediately visible (the only active=1
               S1 service)",
  },

  parameters: {
    declared: [
      { name: "gain_k", value: "0.1",
        unit: "per-tick", source: "derived — EXP-LL-01 results (k=0.1
                 cell)",
        who_may_change: "S3 via phi_down.params (single-loop, within
                 converged bounds)" },
      { name: "price_bounds", value: "p ∈ ℝⁿ⁺, Σpᵢ = n",
        unit: "format", source: "derived — EXP-LL-01 model",
        who_may_change: "S3 (single-loop)" },
      { name: "copper_feed_source", value: "Yahoo Finance HG=F",
        source: "derived — EXP-LL-01-COPPER",
        who_may_change: "S3 (single-loop, blast radius stated)" },
      { name: "converged_config", value: "S3+S4 cell (gamma 0.9)",
        source: "measured — EXP-LL-01 results (S3_only d_final 5.86
                 DIVERGES; S3+S4 1.1e-15 CONVERGES)",
        who_may_change: "S5 only (double-loop — the convergence
                 structure IS the topology)" },
    ],
    source_rule: "∄ source ⟹ a GUESS. All derived from the measured
                 EXP-LL-01 run; none assumed. The Scarf result is the
                 hard case — the converged config is whence the S1
                 earns its keep",
    drift_class: "gain_k, price_bounds, copper_feed_source: single-loop
                 (parameter movement); converged_config (S3-only vs
                 S3+S4 vs other): double-loop — changing it changes
                 the viability structure (topology)",
  },

  autonomy: {
    ceiling:  "L2 — parameter drift (A5; D4: single-loop automatable,
              double-loop requires_human). S3-only/S3+S4 rewire = L3",
    single_loop: "move gain_k within converged bounds; swap feed
              source under gap (degrade, ¬crash); rescale n within
              the reference economy",
    double_loop: "change the control structure (S3-only ↔ S3+S4);
              change the reference economy (Scarf ↔ other generator);
              set a NEW viability floor before the exercise measures it",
    refuses:   "publish fabricated z; move prices with a dead feed;
              overwrite live values without the VERIFY the
              S1-LIVE-VALUES-UNVERIFIED debt demands",
  },

  lifecycle: {
    start:     "preconditions: nucleus (S3/S4) config complete ∧ rmw3
              admits (lifecycle.3 ADMIT — THE TRIGGER; then
              AUTO-COUPLE fires). The kernel RUNNING is ¬the
              precondition — admission is",
    healthy:   "steady state: regime=clearing, stasis_cos high AND
              VARIANT under exercise (the discrimination test:
              surplus/shortage/copper shock must move it — s1_spec
              §2 tell: 'an instrument reading its ideal value
              regardless of state does NOT discriminate')",
    degraded:  "honest reduced mode: regime=clearing report-only —
              the kernel computes but ∄ exercised (no discrimination
              evidence yet — ECON-DISCRIMINATION-EXERCISE debt);
              stops guaranteeing the VERIFY'd live values",
    stop:      "S5 only, double-loop (stopping = TOPOLOGY change; S3
              may RESIZE, ¬ end)",
  },

  gate: "the condition under which this unit may operate. CURRENT
         closure criterion (2026-08-09, rmw3 S5 verbatim): 'NADA EN S1
         ... HASTA TERMINAR DE CONFIGURAR EL NUCLEO!!!' — the S1 gate.
         s1-econ-kernel is the ONE service with active=1 and is STILL
         declared-¬integrated: running ≠ admitted. A precondition
         already MET (kernel active, results measured) is ¬the blocker
         — the S1 gate is; status lives in TASKS.vsm (doc-sync
         discipline). Citing the met precondition opens the gate by
         accident.",

  contract_ref: "s1-econ.contract.vsm (same directory — the pair is
              mandatory; validation c2 checks for BOTH)",
}

