// system/s1-operations/s1-econ/s1-econ.contract.vsm
// S1 CONTRACT — what s1-econ is coupled TO (per
// s1-operations/s1-template/contract.template.vsm — EVERY field).
// Source (measured 2026-08-09): @state_db `vsf-q services 2>&1`
// (lxc_113 = s1-econ-kernel, active=1 — the ONE live S1 service) +
// s1_spec §2 + EXP-LL-01 (Lange-Lerner, Scarf case).

contract("S1-ECON") {

  identity: {
    unit:    "s1-econ (LXC 113, VLAN 10.10.20.113)",
    is_a:    "a full V — ¬a module, ¬a subsystem, ¬a stack (Beer, 1972)",
    parent:  "the nucleus V at L=2 (LXC 101) — A1: S1(parent) = { V_i(child) },
              child = parent's L+1 (kernel.rs, CITED ¬reworded)",
    // A1 CITED. s1_spec §1: econ(113) is a full V, Lange-Lerner domain.
  },

  peers: {
    rule:    "A4 — ∄ direct sibling coupling. A peer coupling is ENACTED
              through the shared parent's S3.",
    note:    "A4 constrains HOW it runs, ¬WHERE it is declared.",
    couplings: [
      { peer_id: "s1-clima (LXC 112)",
        purpose: "multi-S1 contention for S3-PROPORTIONAL-ALLOC — the
                  resource bargain needs BOTH domains' demand signals",
        direction: "bidirectional telemetry, mediated",
        mediated_by: "parent S3 (@src_s3_alloc_py) — ∄ direct wire",
        what_breaks_if_it_stops: "alloc vacuum: S3 sees one domain
                  alone → misallocation across climate/economy" },
      { peer_id: "s4-econ-bridge (101)",
        purpose: "S4 reads econ φ↑ (excess_demand, regime) for horizon",
        direction: "φ↑ relay — child → parent.S3 → S4 (R13)",
        mediated_by: "parent S3 + @dir_nats_topic grammar",
        what_breaks_if_it_stops: "S4 blind to allocation dynamics" },
    ]
  },

  external: {
    rule:    "systems outside the installation. Each needs a stated TRUST
              basis. 'it is internal' is a LOCATION, ¬a warrant.",
    couplings: [
      { system:  "copper price feed (Yahoo Finance HG=F) — EXP-LL-01-COPPER
                  real feed replacing the synthetic sine wave",
        purpose: "the exogenous input the tatonnement reacts to (S4
                  anticipation signal for the economic domain)",
        protocol: "scheduled fetch (data_sources.vsm) → copper_force",
        trust_basis: "public market data; single-source (Yahoo) —
                  stated as the blast-radius driver below",
        failure_mode: "feed gap → copper_force stale → stasis_cos
                  mis-read; the kernel must ¬crash, degrade",
        blast_radius_if_compromised: "HIGH — a poisoned price signal
                  is a poison price vector: tatonnement converges to
                  the WRONG equilibrium (Scarf: regulator success is
                  structurally fragile — EXP-LL-01 results)" },
      { system:  "@state_db (node:n02:/var/lib/vsf-state/state.db)",
        purpose: "the declarative canon — model≡reality adjudication",
        protocol: "sqlite RO reads via vsf-q; reconciled by
                  vsf-s3-star (LXC 107, 5min)",
        trust_basis: "host-owned, verified live 2026-08-08; decoys
                  rejected (instance.vsm)",
        failure_mode: "stale census → econ marked missing/orphan wrong",
        blast_radius_if_compromised: "MEDIUM — canonical lies
                  propagate" },
    ]
  },

  nested: {
    rule:    "components INSIDE this unit. A viable component is a V and
              gets its own documents.",
    components: [
      { name: "s1-econ-kernel (LXC 113, active=1)",
        role: "the Lange-Lerner tatonnement engine — price update
               rule dpᵢ/dt = kᵢ·zᵢ(p), excess demand zᵢ = qᵈ−qˢ (the φ↑)",
        is_viable: false, own_documents: false,
        note: "the kernel is the unit's COMPUTATION, ¬a separate V —
               it carries no S1..S5 of its own" },
      { name: "copper_price_feed.py",
        role: "scheduled HG=F fetch → copper_force input",
        is_viable: false, own_documents: false },
      { name: "omega_doughnut_design.vsm",
        role: "the viable-set design doc for the econ domain (Ω on the
               simplex Σpᵢ = n)",
        is_viable: false, own_documents: false },
    ]
  },

  channels: {
    phi_up:      "child → parent.S3 ▪ telemetry ▪ attenuated. Stream:
                  /var/log/s1-econ/phi_up.jsonl (instance-bound, s1_spec
                  §2), replicated to @events_jsonl → NATS per
                  @dir_nats_topic grammar",
    phi_down:    "parent.S3 → child ▪ parameters ▪ amplified. Topic:
                  vsf.alpha.phi_down.params — S3 writes ONLY (gain kᵢ,
                  price bounds, copper feed cadence)",
    algedonic:   "child → parent.S5 ▪ emergency ▪ bypasses S3. Topic:
                  vsf.alpha.algedonic (disequilibrium alarm:
                  |z| above threshold = excess_demand escape)",
    s2_lateral:  "coordination via parent's S2 (nats-server LXC 106,
                  token-auth) — anti-oscillation",
    psi:         "∅ — S4↔peer S4 preconditions ¬met (ψ fixation gate
                  pending)",
    per_channel: [
      { channel: "phi_up", direction: "↑", role: "excess_demand_norm,
                  stasis_cos, copper_force, regime",
        carrier: "jsonl → @events_jsonl → NATS",
        schema: "vsl-nats-v1 family(phi_up)",
        cadence: "kernel tick",
        payload_bound: "z ∈ ℝⁿ (normalized), stasis_cos ∈ [0,1]",
        loss_tolerance: "at-most-once; jsonl IS the record",
        what_silence_means: "kernel stop = dead S1 — the ONLY live
                  S1 service (active=1), so silence is immediately
                  visible on the census" },
      { channel: "phi_down", direction: "↓", role: "governed params",
        carrier: "NATS", schema: "family(phi_down) — _origin + _reason",
        cadence: "event-driven",
        payload_bound: "partial config overrides (kᵢ, bounds)",
        loss_tolerance: "∄ loss — governance violation if missed",
        what_silence_means: "∄ governance activity — healthy" },
      { channel: "algedonic", direction: "↑", role: "emergency",
        carrier: "NATS", schema: "{ts, source_id, category, severity,
                  detail}",
        cadence: "immediate",
        payload_bound: "severity tiers",
        loss_tolerance: "lowest",
        what_silence_means: "no emergency — healthy" },
    ]
  },

  obligations: {
    emits:     "excess_demand_norm + stasis_cos + copper_force + regime
               per tick (φ↑); algedonic on |z| escape; live census
               truth via @state_db (active=1 measured)",
    consumes:  "phi_down.params (gain kᵢ, price bounds, feed cadence);
               @state_db canon; copper HG=F feed",
    guarantees: "convergence under the S3+S4 configuration (EXP-LL-01
               measured: Scarf S3_only d_final 5.86 DIVERGES;
               S3+S4 d_final 1.1e-15 CONVERGES); stasis_cos reported
               from the kernel's own computation",
    degrades_to: "regime=clearing report-only — the kernel keeps
               computing but ¬exercised (surplus/shortage discrimination
               is the open exercise, s1_spec §2) — honest reduced mode,
               ¬fail",
    never:     "publish fabricated z (a feed gap is a GAP, reported);
               fix kᵢ against convergence (gain is governed, single-loop
               within bounds); move prices without a z signal",
    // `never` outranks a directive.
  },

  gate: "the condition under which this contract becomes ACTIVE. CURRENT
         closure criterion (2026-08-09, rmw3 S5 verbatim): 'NADA EN S1
         ... HASTA TERMINAR DE CONFIGURAR EL NUCLEO!!!' — the S1 gate.
         s1-econ-kernel RUNS (active=1) but is DECLARED-¬INTEGRATED:
         running ≠ admitted. Lifecycle.3 ADMIT (beacon EVC, rmw3
         signed) is the trigger; until then the contract is
         specified, ∄ enacted. Status in TASKS.vsm (doc-sync
         discipline). A running kernel is NOT the blocker — the S1
         gate is.",
}

