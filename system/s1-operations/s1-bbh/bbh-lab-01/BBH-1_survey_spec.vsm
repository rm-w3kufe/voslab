@vsm 0.3
@status active
// BBH-1 — BBH-LAB survey/mapping (PRE-REGISTERED)
// Owner: [S] DS  ·  Design: [O] Claude  ·  2026-07-16
// Part of: SOC_XDR_ROADMAP.offensive_integration (BBH-1..4). This is BBH-1 only.
// Produces the INPUT for BBH-2 ([O] Claude: contract + operation mechanisms under VSF).
// Nature: READ-ONLY survey. No integration, no offensive execution, no changes. R6 respected.

task("BBH-1-SURVEY") = {

  purpose:
    "BBH-LAB is stable but its main deficiency is the agent that governs it (DeepZeek/opencode on
     n02/bbh-lab) — not skilled at hacking, and not under VSF's control/audit/intelligence protocols.
     Before we can standardize it under the VSF paradigm (BBH-2..4), we need an honest MAP of what it
     is, how it operates, and where the seams for VSF governance are. This task produces that map."

  // ── HARD CONSTRAINTS ──
  constraints: {
    read_only: "SURVEY ONLY. Do not modify BBH-LAB, do not run offensive tooling, do not integrate, do
                not attach any φ↑/φ↓ channel. Observe and document. If a step would change state, STOP
                and note it as a finding instead.",
    r6: "R6 internal-first still gates INTEGRATION — this task does not integrate, it maps. Mapping is
         the design input, not the coupling.",
    a0: "the eventual purpose is DEFENSIVE (bring BBH-LAB under governance/audit) and offensive-only on
         authorized/own targets. The survey itself asserts no targets.",
    scope_boundary: "if uncertain whether an action is read-only, treat it as NOT read-only and skip it,
                     recording the question for [O].",
  }

  // ── WHAT TO SURVEY (produce a finding per section) ──
  survey: {
    infrastructure: "what VMs/containers/services constitute BBH-LAB on n02 (start from LXC 105 s1-bbh /
                     bbh-prod, VLAN30 per CLAUDE.md). List each: role, network, state (up/down), resource
                     footprint. Model≡reality: only what actually exists.",
    governing_agent: "the DeepZeek/opencode agent on n02/bbh-lab — where it runs, its config, how it
                      RECEIVES tasks and EMITS results (files? API? stdout?), its current capabilities and
                      observed limitations. This is the load-bearing gap — characterize it precisely.",
    tool_stack: "the tooling: proxy stack, the vuln-class coverage, the operational pipeline/phases (cross-
                 reference the documented 6-phase workflow if present). What is automated vs manual.",
    interfaces: "the SEAMS for VSF governance: where could φ↑ (results/telemetry) be emitted? where could
                 φ↓ (directives/tasking) be received? where could S3* audit observe? what does the agent
                 already log that a typed φ↑ could carry?",
    state_stability: "current state + stability: what runs cleanly, what is fragile, what is dormant. Is
                      it operationally stable (rmw3 says 'bastante estable') — confirm or refute with obs.",
    governance_gaps: "for EACH VSM function, what is missing to bring BBH-LAB under it:
                      S3 (control/tasking) · S3* (independent audit of what it does) · S4 (intelligence:
                      does it consume/produce anything projectable?) · S5 (policy/covenant: what actions
                      need a floor? what must never be autonomous?).",
  }

  // ── DELIVERABLE ──
  deliverable: {
    output: "docs/vsf-bbh/bbh_lab_map.vsm — one section per survey.* above, each a factual finding with
             evidence (path, command output, observed value). Model≡reality: mark anything uncertain as
             uncertain; never assert un-observed structure.",
    open_questions: "a §for_claude block listing the design questions BBH-2 must answer (contract shape,
                     which actions are autonomous vs human, how the covenant floor applies to offensive
                     tooling). These are [O] questions — surface them, don't answer them.",
    marker_discipline: "use the operational-rigor markers (✓ observed / ◐ partial / ◯ inferred / ✗ absent /
                        ? unknown) on every claim.",
  }

  // ── EXIT ──
  exit: {
    done_when: "bbh_lab_map.vsm covers all six survey sections with evidence + the §for_claude questions.",
    unblocks: "BBH-2 ([O] Claude): contract + operation mechanisms under VSF, built ON this map.",
    relay: "report back as bbh_lab_map.vsm (VSL), not prose. Flag anything that felt like it wanted to
            change state (so we know where the read-only line got tested).",
  }
}
