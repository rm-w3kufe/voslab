// system/s1-operations/s1-bbh/s1-bbh.contract.vsm
// S1 CONTRACT — what s1-bbh is coupled TO (per
// s1-operations/s1-template/contract.template.vsm — EVERY field).
// Source (measured 2026-08-09): @state_db `vsf-q services 2>&1` +
// `vsf-q topology` (105 = s1-bbh VLAN30 10.10.30.110 · 111 =
// s1-bbh-lab 10.10.30.111 · bbh-prod declared on 111, active=0) +
// s1_spec §5.1 (R6-STILL-GATED).
// R6 posture: this contract is a DESIGN declaration, ∄ an enacted one.

contract("S1-BBH") {

  identity: {
    unit:    "s1-bbh — two nodes: LXC 105 (s1-bbh) + LXC 111
              (s1-bbh-lab), VLAN30 10.10.30.110/.111",
    is_a:    "a full V — ¬a module, ¬a subsystem, ¬a stack (Beer,
              1972; s1_spec §5.1: 'bbh is a real S1')",
    parent:  "the nucleus V at L=2 (LXC 101) — A1: child = parent's
              L+1 (CITED ¬reworded)",
    // A1 CITED. Integration is R6-gated; the DESIGN is carried here.
  },

  peers: {
    rule:    "A4 — ∄ direct sibling coupling. Enacted through the
              shared parent's S3.",
    note:    "A4 constrains HOW it runs, ¬WHERE it is declared.",
    couplings: [
      { peer_id: "other S1s (clima, econ) via parent S3",
        purpose: "once admitted: multi-S1 contention for
                  S3-PROPORTIONAL-ALLOC (security domain vs thermal
                  vs economic demand)",
        direction: "none until admission — SPECIFIED, ∄ enacted",
        mediated_by: "parent S3 — ∄ direct wire (A4)",
        what_breaks_if_it_stops: "N/A while gated — ∄ coupling to
                  break; a design without an enacted wire" },
    ]
  },

  external: {
    rule:    "systems outside the installation. Each needs a stated TRUST
              basis. 'it is internal' is a LOCATION, ¬a warrant.",
    couplings: [
      { system:  "bug-bounty programs (HackerOne) — RoE/policy pages",
        purpose: "the tested domain: findings validated against each
                  program's OWN severity guide (business-value scoring,
                  s1_spec §5.1 gaps_4 [2])",
        protocol: "HTTPS read of PUBLIC RoE (verified live 2026-07-26 —
                  H1 pages need ∄ auth); canonical capture at the
                  source via playwright → restrictions.json per
                  program (gate_calibration PASSED on Stripe
                  2026-07-25, 5 real targets)",
        trust_basis: "public pages, captured by bbh-lab itself —
                  canonical capture lives at the source; the
                  mechanical consumption gate (check_policy before any
                  tool runs) is DESIGNED, ¬built (s1_spec §5.1
                  intel)",
        failure_mode: "RoE page drift → stale restrictions → prohibited
                  method used → covenant violation (R10/RoE)",
        blast_radius_if_compromised: "CRITICAL — a poisoned RoE canon
                  licenses out-of-scope testing: asset AND vuln-class
                  must be in-scope (finding_gate c1) else HARD BLOCK.
                  Violation = covenant breach + legal exposure" },
      { system:  "the lab's own VLAN30 infra (target practice infra)",
        purpose: "controlled target environment for validation /
                  PoC reproduction",
        protocol: "VLAN30 (10.10.30.0/24) — firewall isolation model:
                  ∄ cross-VLAN routing (s1_spec §5.1 soc note: host
                  FORWARD DROP for inter-VLAN)",
        trust_basis: "declared isolation (R6 gate is precisely about
                  this being PROVEN by empirical exercise before
                  coupling — internal-first)",
        failure_mode: "isolation misconfig → blast radius to other
                  VLANs",
        blast_radius_if_compromised: "HIGH — the isolation claim is
                  the R6 crux; a breach here is why the gate exists" },
      { system:  "@state_db (node:n02:/var/lib/vsf-state/state.db)",
        purpose: "declarative canon — bbh declared on 111 with 0
                  active services measured",
        protocol: "sqlite RO via vsf-q; reconciled by vsf-s3-star",
        trust_basis: "host-owned; verified live 2026-08-08",
        failure_mode: "stale census",
        blast_radius_if_compromised: "MEDIUM" },
    ]
  },

  nested: {
    rule:    "components INSIDE this unit. A viable component is a V and
              gets its own documents.",
    components: [
      { name: "bbh-prod (declared on LXC 111, active=0 measured)",
        role: "the production-facing service row in @state_db —
               declared, ¬ running (R6 posture)", is_viable: false,
        own_documents: false },
      { name: "waf_detect.py", role: "WAF layer detection — writes
               json, ∄ bypass/evasion logic (s1_spec §5.1 gaps_4 [3])",
        is_viable: false, own_documents: false },
      { name: "cve_lookup", role: "NVD/EPSS version-match — ∄
               exploit/PoC verification (gaps_4 [4]: detect-without-
               proof)",
        is_viable: false, own_documents: false },
      { name: "interactsh_manager", role: "real out-of-band callback
               proof — THE counter-example for detection quality
               (gaps_4 [4])",
        is_viable: false, own_documents: false },
      { name: "playwright capture", role: "canonical RoE capture at
               the source (restrictions.json per program)",
        is_viable: false, own_documents: false },
      { name: "policy_atomization pipeline", role: "RoE → atoms, 8
               taxonomy categories, per-rule validation, ONE confidence
               score per program (s1_spec §5.1 atomization)",
        is_viable: false, own_documents: false },
    ]
  },

  channels: {
    phi_up:      "child → parent.S3 ▪ telemetry ▪ attenuated. SPECIFIED:
                  validated findings (finding_gate c1 SCOPE ∧ c2 PoC —
                  both REQUIRED, s1_spec §5.1 finding_gate) + program
                  intel canon. Carrier would be NATS per @dir_nats_topic
                  — ∄ enacted until admission",
    phi_down:    "parent.S3 → child ▪ parameters. SPECIFIED:
                  program-scope directives within RoE (enforcement ←
                  deterministic, R10.1); ∄ enacted (R6)",
    algedonic:   "child → parent.S5 ▪ emergency. SPECIFIED:
                  new-category atoms escalate on the EXISTING
                  algedonic channel (atomization, s1_spec §5.1);
                  ∄ enacted until admission",
    s2_lateral:  "SPECIFIED: coordination via parent S2 (nats-server
                  LXC 106) — ∄ enacted",
    psi:         "∅ — and will stay ∅ past admission until the ψ
                  preconditions hold (external collaborator
                  preconditions, per nats_topic_schema L3_Channel)",
    per_channel: [
      { channel: "phi_up", direction: "↑", role: "validated findings,
                  intel canon",
        carrier: "SPECIFIED NATS — ∄ enacted (R6)",
        schema: "finding_gate-validated v1 (c1 ∧ c2)",
        cadence: "event-driven, post-validation",
        payload_bound: "actionable findings only — NO raw tool spam",
        loss_tolerance: "∄ loss for submissions (outward-facing);
                  internal telemetry at-most-once",
        what_silence_means: "no validated findings — healthy, ∄ dead.
                  Silence is the honest state while gated" },
      { channel: "algedonic", direction: "↑", role: "emergency,
                  new-category atom escalation",
        carrier: "vsf.alpha.algedonic (EXISTING channel — the one thing
                  specified as shared)",
        schema: "s5_policy allowed_categories",
        cadence: "immediate",
        payload_bound: "severity tiers",
        loss_tolerance: "lowest",
        what_silence_means: "no emergency — healthy" },
    ]
  },

  obligations: {
    emits:     "validated findings only (c1 SCOPE ∧ c2 PoC — s1_spec
               §5.1 finding_gate); program intel canon (restrictions.json
               per program); the atomic RoE taxonomy for its programs",
    consumes:  "program-scope directives within RoE (S3-mediated);
               RoE canon from its own capture (∄ external trust);
               S3 allocations once admitted",
    guarantees: "∄ out-of-scope testing (HARD BLOCK, ¬ downgrade);
               ∄ evasion before per-program RoE language verified (C0
               guardrail, gaps_4 [3]); every submitted finding carries
               a reproducible PoC + severity justified by the PoC (the
               12/20 not-a-vuln lesson, s1_spec §5.1 finding_gate)",
    degrades_to: "mapping/read-only mode (BBH-1 survey posture) —
               the honest reduced mode: map + design questions, ∄
               offensive operation; stops guaranteeing new validated
               findings but keeps the lab visible to S3*",
    never:     "run offensive tooling against out-of-scope assets;
               submit an unvalidated finding (validity is the unit's
               refusal surface); execute any evasion WITHOUT verified
               RoE language; let bbh-prod start before R6 clears",
    // `never` outranks a directive — for BBH it also outranks speed.
  },

  gate: "the condition under which this contract becomes ACTIVE. R6
         (vsl_hard_rules): '∀ S1 ∈ BBH: integrate(S1) ⟸ (S2..S5 ∧
         algedonic ∧ covenant) pass empirical_exercise'. CURRENT
         closure criterion: the R6 empirical exercise — still OPEN
         (status in TASKS.vsm, doc-sync discipline; rmw3 2026-07-30:
         firewall isolation on BBH's LXCs 'looks correct, not yet
         clear how to approach reconsidering it' — genuinely
         unresolved, needs thought before any change).
         A cleared internal-viability claim is NOT the blocker — the
         R6 gate is; the contract remains DECLARED-¬INTEGRATED.",
}

